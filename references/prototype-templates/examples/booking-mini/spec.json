       "data-why": "",
       "class": "rw"
      }
     }
    }
   ],
   "logic": {
    "from": "点标签栏“我的”",
    "back": "无（一级页）",
    "done": "无",
    "primary": "查看会员等级",
    "rules": [
     "账户类入口只放这里：会员等级、积分、门店与地址",
     "“会员签到”已经是首页大卡，这里不再放同一目的地的入口",
     "已登录显示昵称与等级，未登录显示登录引导"
