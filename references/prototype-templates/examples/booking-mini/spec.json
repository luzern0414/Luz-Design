     "text": "返回来源页"
    },
    "done": "无",
    "primary": "选定门店",
    "rules": [
     "列表按距离排序，休息中的门店置灰并写明下次营业时间",
     "选定后回到来源页，首页的门店上下文栏同步更新",
     "定位授权用到才请求，拒绝后可手动搜索门店"
    ],
    "states": [
     "空：附近没有门店",
     "失败：定位失败提示手动选择"
    ],
    "backend": [
     "门店、营业时间、可预约状态由后台“门店管理”维护"
