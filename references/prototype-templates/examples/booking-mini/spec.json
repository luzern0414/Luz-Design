     "已登录：显示等级与成长值"
    ],
    "backend": [
     "会员等级与成长值规则由后台“会员管理”维护"
    ],
    "actions": [
     {
      "id": "B-020",
      "label": "门店与地址",
      "when": "始终可用",
      "result": "进入门店选择"
     }
    ]
   },
   "links": [
    "store"
   ]
  },
  {
   "id": "store",
   "name": "选择门店",
   "type": "sub",
   "tab": "home",
   "title": "选择门店",
   "blocks": [
    {
     "cid": "MP-SVC-001",
     "act": {
      ".cd.open .tp": "pickStore"
     },
     "attrs": {
      ".cd.open .tp": {
       "data-toast": null
      }
     }
    }
   ],
   "logic": {
    "from": {
