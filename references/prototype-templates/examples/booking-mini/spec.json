{
 "$schema": "../../schema/prototype.schema.json",
 "schema": "luz-prototype/1",
 "kind": "mini",
 "meta": {
  "title": "到店预约小程序",
  "subtitle": "到店预约与会员",
  "brand": "静安到店服务",
  "version": "0.1",
  "mark": "<rect x='6' y='8' width='20' height='18' rx='4'/><path d='M6 14h20M12 5v5M20 5v5'/>"
 },
 "theme": {
  "id": "purple",
  "appearance": "auto",
  "iconStyle": "flat",
  "iconTile": "ci"
 },
 "tabbar": [
  {
   "id": "home",
   "name": "首页",
   "icon": "home",
   "page": "home"
  },
  {
   "id": "bookings",
   "name": "预约",
   "icon": "calendar",
   "page": "bookings"
  },
  {
   "id": "me",
   "name": "我的",
   "icon": "user",
   "page": "me"
  }
 ],
 "data": {
  "booking": {
   "reason": "该时段已约满"
  }
 },
 "scenes": [
  {
   "id": "booking",
   "label": "预约结果",
   "pages": [
    "confirm",
    "result",
    "result-fail"
   ],
   "default": "ok",
   "options": [
    {
     "v": "ok",
     "label": "成功",
     "kind": "ok"
    },
    {
     "v": "fail-full",
     "label": "失败：时段已约满",
     "kind": "fail"
    },
    {
     "v": "fail-closed",
     "label": "失败：门店已休息",
     "kind": "fail"
    }
   ]
  }
 ],
 "actions": {
  "confirmBooking": [
   {
    "validate": [
     {
      "sel": ".f3 input.in",
      "pattern": "^1\\d{2} ?\\d{4} ?\\d{4}$",
      "msg": "请填写 11 位手机号，门店用它通知你"
     }
    ]
   },
   {
    "net": true
   },
   {
    "branch": {
     "scene": "booking",
     "cases": {
      "fail-full": [
       {
        "set": {
         "path": "booking.reason",
         "value": "该时段刚被约满，请换一个时间"
        }
       },
       {
        "replace": "result-fail"
       }
      ],
      "fail-closed": [
       {
        "set": {
         "path": "booking.reason",
         "value": "门店当天休息，请换一天"
        }
       },
       {
        "replace": "result-fail"
       }
      ]
     },
     "default": [
      {
       "replace": "result"
      }
     ]
    }
   }
  ],
  "finish": [
   {
    "done": "book"
   }
  ],
  "pickStore": [
   {
    "toast": "已切换门店"
   },
   {
    "back": 1
   }
  ],
  "checkin": [
   {
    "toast": "签到成功，积分 +10"
   }
  ]
 },
 "flows": [
  {
   "id": "book",
   "name": "预约到店",
   "start": "slot",
   "steps": [
    "home",
    "slot",
    "confirm",
    "result"
   ],
   "done": "origin",
   "note": "从首页选服务，选人员与时间，确认后回到发起处"
  },
  {
   "id": "queue",
   "name": "现场取号",
   "start": "queue",
   "steps": [
    "home",
    "queue"
   ],
   "done": "origin"
  },
  {
   "id": "checkin",
   "name": "会员签到",
   "start": "checkin",
   "steps": [
    "me",
    "checkin"
   ],
   "done": "origin"
  }
 ],
 "rules": [
  {
   "title": "预约",
   "items": [
    "预约需要选服务、人员（可选“不指定”）、日期与时段，约满的时段置灰并写“约满”",
    "预约成功后生成核销券码，到店出示二维码或券码",
    "开始前 2 小时可免费改期或取消，之后取消扣一次爽约记录"
   ]
  },
  {
   "title": "取号",
   "items": [
    "现场取号只在营业时间内可用，取号后可看前面还有几桌与预计等待",
    "取消排队后号码作废，需要重新取号"
   ]
  },
  {
   "title": "会员",
   "items": [
    "每日签到得积分，连续 7 天额外奖励；会员等级按成长值升级",
    "爽约 3 次后 30 天内不能预约，需要联系门店"
   ]
  }
 ],
 "statuses": [
  {
   "id": "wait",
   "name": "待到店",
   "tone": "info",
   "trigger": "预约成功",
   "ops": "出示券码、改期、取消",
   "to": "已核销（到店核销）、已取消、已过期"
  },
  {
   "id": "used",
   "name": "已核销",
   "tone": "ok",
   "trigger": "店员扫码核销",
   "ops": "再次预约",
   "to": "（终态）"
  },
  {
   "id": "expired",
   "name": "已过期",
   "tone": "mute",
   "trigger": "超过预约时间未到店",
   "ops": "重新预约",
   "to": "（终态，记一次爽约）"
  },
  {
   "id": "cancel",
   "name": "已取消",
   "tone": "mute",
   "trigger": "用户或门店取消",
   "ops": "重新预约",
   "to": "（终态）"
  }
 ],
 "pages": [
  {
   "id": "home",
   "name": "首页",
   "type": "tab",
   "tab": "home",
   "nav": "space",
   "blocks": [
    {
     "cid": "MP-SVC-001",
     "hide": [
      ".cd.closed"
     ],
     "go": {
      ".cd.open .tp": "store"
     },
     "attrs": {
      ".cd.open .tp": {
       "data-toast": null
      }
     },
     "text": {
      ".cd.open h4": "静安寺旗舰店"
     },
     "name": "门店上下文栏"
    },
    {
     "cid": "MP-ENT-003",
     "text": {
      ".c@0 b": "现场取号",
      ".c@0 span": "不用等位",
      ".c@1 b": "会员签到",
      ".c@1 span": "签到领积分"
     },
     "go": {
      ".c@0": "queue",
      ".c@1": "checkin"
     },
     "name": "入口大卡"
    },
    {
     "cid": "MP-SVC-005",
     "text": {
      ".hd b": "选择服务",
      ".hd span": "点一项开始预约"
     },
     "hide": [
      ".adh",
      ".ads",
      ".ft"
     ],
     "go": {
      ".pk@0": "slot:basic",
      ".pk@1": "slot:standard",
      ".pk@2": "slot:premium"
     },
     "name": "预约服务列表"
    }
   ],
   "logic": {
    "from": "启动进入；点标签栏“首页”",
    "back": "无（一级页）",
    "done": "无",
    "primary": "选择服务开始预约",
    "rules": [
     "首页顶部是门店上下文栏（当前门店、营业状态、距离），点它切换门店，只有这一个门店入口",
     "首页没有搜索、没有金刚栅格：入口只有两张大卡（现场取号、会员签到）和一个单列服务列表",
     "服务列表每项一个入口，点进去选人员与时间；价格与时长在行内写清",
     "“我的预约”在标签栏，首页不重复；账户类入口只放“我的”",
     "不放营销轮播，首屏模块不超过 3 个"
    ],
    "states": [
     "加载：骨架屏",
     "空：当前门店没有可约服务时显示空态并给“切换门店”",
     "失败：整页失败态带重试"
    ],
    "backend": [
     "门店信息、服务项目、价格与时长由后台“服务管理”维护",
     "入口大卡的文案由后台“首页装修”维护"
    ],
    "actions": [
     {
      "id": "B-001",
      "label": "门店上下文栏",
      "when": "始终可用",
      "result": "进入门店选择"
     },
     {
      "id": "B-002",
      "label": "服务列表项",
      "when": "服务可约",
      "result": "进入选人员与时间"
     }
    ]
   },
   "links": [
    "store",
    "queue",
    "checkin",
    "slot:standard"
   ]
  },
  {
   "id": "bookings",
   "name": "预约",
   "type": "tab",
   "tab": "bookings",
   "nav": "bar",
   "title": "我的预约",
   "blocks": [
    {
     "cid": "MP-SVC-004"
    }
   ],
   "logic": {
    "from": "点标签栏“预约”；预约成功后可从这里查看券码",
    "back": "无（一级页）",
    "done": "无",
    "primary": "到店出示券码",
    "rules": [
     "按状态分类：待使用、已使用、已过期；待使用的券显示二维码与条形码，60 秒自动刷新",
     "券码到店由店员扫码核销，核销后不可退回",
     "开始前 2 小时可改期或取消"
    ],
    "states": [
     "空：没有预约时引导去首页预约",
     "失败：券码刷新失败可重试"
    ],
    "backend": [
     "券码核销与预约状态由后台“预约管理”维护"
    ],
    "actions": [
     {
      "id": "B-010",
      "label": "刷新券码",
      "when": "待使用",
      "result": "重新生成二维码"
     }
    ]
   }
  },
  {
   "id": "me",
   "name": "我的",
   "type": "tab",
   "tab": "me",
   "headerBg": true,
   "blocks": [
