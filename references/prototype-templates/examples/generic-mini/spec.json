{
 "$schema": "../../schema/prototype.schema.json",
 "schema": "luz-prototype/1",
 "kind": "mini",
 "meta": {
  "title": "通用商品商城小程序",
  "subtitle": "线上百货商城",
  "brand": "优选百货",
  "version": "0.1",
  "mark": "<path d='M7 11h18l-1.6 13H8.600z'/><path d='M12 11V9a4 4 0 0 1 8 0v2'/>"
 },
 "theme": {
  "id": "teal",
  "appearance": "auto",
  "header": "gradient",
  "bgImage": "silk",
  "iconStyle": "3d",
  "iconTile": "sq"
 },
 "tabbar": [
  {
   "id": "home",
   "name": "首页",
   "icon": "home",
   "page": "home"
  },
  {
   "id": "cat",
   "name": "分类",
   "icon": "grid",
   "page": "cat"
  },
  {
   "id": "cart",
   "name": "购物车",
   "icon": "cart",
   "page": "cart",
   "badge": "cart.count"
  },
  {
   "id": "me",
   "name": "我的",
   "icon": "user",
   "page": "me"
  }
 ],
 "roles": [
  {
   "id": "member",
   "name": "会员",
   "note": "已登录，可以下单、查看订单与优惠券"
  },
  {
   "id": "guest",
   "name": "游客",
   "note": "未登录，只能浏览；下单、订单、地址、优惠券、消息需要先登录",
   "deniedGo": "login",
   "deniedLabel": "去登录"
  }
 ],
 "data": {
  "cart": {
   "count": 3
  },
  "pay": {
   "reason": "银行卡余额不足"
  }
 },
 "scenes": [
  {
   "id": "pay",
   "label": "支付结果",
   "pages": [
    "pay",
    "result",
    "result-wait",
    "result-fail"
   ],
   "default": "ok",
   "options": [
    {
     "v": "ok",
     "label": "成功",
     "kind": "ok"
    },
    {
     "v": "processing",
     "label": "处理中",
     "kind": "busy"
    },
    {
     "v": "fail-balance",
     "label": "失败：余额不足",
     "kind": "fail"
    },
    {
     "v": "fail-limit",
     "label": "失败：超出银行限额",
     "kind": "fail"
    },
    {
     "v": "fail-timeout",
     "label": "失败：支付超时",
     "kind": "fail"
    }
   ]
  },
  {
   "id": "search",
   "label": "搜索结果",
   "pages": [
    "list",
    "search-empty",
    "load-fail"
   ],
   "default": "has",
   "options": [
    {
     "v": "has",
     "label": "有结果",
     "kind": "ok"
    },
    {
     "v": "none",
     "label": "无结果",
     "kind": "empty"
    },
    {
     "v": "error",
     "label": "请求失败",
     "kind": "fail"
    }
   ]
  },
  {
   "id": "stock",
   "label": "商品库存",
   "pages": [
    "detail",
    "spec"
   ],
   "default": "in",
   "options": [
    {
     "v": "in",
     "label": "有货",
     "kind": "ok"
    },
    {
     "v": "low",
     "label": "库存紧张",
     "kind": "busy"
    },
    {
     "v": "out",
     "label": "已售罄",
     "kind": "disabled"
    }
   ]
  }
 ],
 "actions": {
  "addCart": [
   {
    "branch": {
     "scene": "stock",
     "cases": {
      "out": [
       {
        "toast": {
         "text": "商品已售罄，暂时无法加入购物车",
         "tone": "warn"
        }
       },
       {
        "stop": true
       }
      ],
      "low": [
       {
        "inc": {
         "path": "cart.count",
         "by": 1,
         "max": 99
        }
       },
       {
        "toast": "已加入购物车，该商品库存紧张"
       }
      ]
     },
     "default": [
      {
       "inc": {
        "path": "cart.count",
        "by": 1,
        "max": 99
       }
      },
      {
       "toast": "已加入购物车"
      }
     ]
    }
   }
  ],
  "confirmCart": [
   {
    "close": true
   },
   {
    "act": "addCart"
   }
  ],
  "buyNow": [
   {
    "branch": {
     "scene": "stock",
     "cases": {
      "out": [
       {
        "toast": {
         "text": "商品已售罄，暂时无法购买",
         "tone": "warn"
        }
       },
       {
        "stop": true
       }
      ]
     },
     "default": []
    }
   },
   {
    "close": true
   },
   {
    "go": "checkout"
   }
  ],
  "search": [
   {
    "net": true
   },
   {
    "branch": {
     "scene": "search",
     "cases": {
      "none": [
       {
        "go": "search-empty"
       }
      ],
      "error": [
       {
        "go": "load-fail"
       }
      ]
     },
     "default": [
      {
       "toast": "已更新搜索结果"
      }
     ]
    }
   }
  ],
  "pay": [
   {
    "net": true
   },
   {
    "branch": {
     "scene": "pay",
     "cases": {
      "ok": [
       {
        "close": true
       },
       {
        "replace": "result"
       }
      ],
      "processing": [
       {
        "close": true
       },
       {
        "replace": "result-wait"
       }
      ],
      "fail-balance": [
       {
        "set": {
         "path": "pay.reason",
         "value": "银行卡余额不足"
        }
       },
       {
        "close": true
       },
       {
        "replace": "result-fail"
       }
      ],
      "fail-limit": [
       {
        "set": {
         "path": "pay.reason",
         "value": "超出银行单笔限额"
        }
       },
       {
        "close": true
       },
       {
        "replace": "result-fail"
       }
      ],
      "fail-timeout": [
       {
        "set": {
         "path": "pay.reason",
         "value": "支付超时，订单已关闭"
        }
       },
       {
        "close": true
       },
       {
        "replace": "result-fail"
       }
      ]
     },
     "default": [
      {
       "close": true
      },
      {
       "replace": "result"
      }
     ]
    }
   }
  ],
  "finishOrder": [
   {
    "done": "order"
   }
  ],
  "login": [
   {
    "validate": [
     {
      "sel": ".mpform004 [data-f=phone] input",
      "pattern": "^1\\d{2} ?\\d{4} ?\\d{4}$",
      "msg": "请输入 11 位手机号"
     },
     {
      "sel": ".mpform004 [data-f=code] input",
      "required": true,
      "msg": "请输入验证码"
     }
    ]
   },
   {
    "role": "member"
   },
   {
    "toast": "登录成功"
   },
   {
    "done": "login"
   }
  ],
  "logout": [
   {
    "role": "guest"
   },
   {
    "toast": "已退出登录"
   },
   {
    "tab": "me"
   }
  ],
  "saveAddress": [
   {
    "validate": [
     {
      "sel": ".mpform005 [data-k=tel] input",
      "pattern": "^\\d{11}$",
      "msg": "请填写 11 位手机号"
     }
    ]
   },
   {
    "toast": "地址已保存"
   },
   {
    "back": 1
   }
  ],
  "submitService": [
   {
    "toast": "售后申请已提交，商家将在 48 小时内处理"
   }
  ]
 },
 "flows": [
  {
   "id": "browse",
   "name": "浏览到加购",
   "start": "list",
   "steps": [
    "home",
    "list",
    "detail",
    "spec"
   ],
   "done": "origin",
   "note": "首页入口进列表，详情里选规格加购"
  },
  {
   "id": "order",
   "name": "结算到支付",
   "start": "checkout",
   "steps": [
    "cart",
    "checkout",
    "pay",
    "result"
   ],
   "done": "origin",
   "note": "支付完成后回到发起结算的页面（购物车）"
  },
  {
   "id": "aftersale",
   "name": "订单到售后",
   "start": "service",
   "steps": [
    "orders",
    "order",
    "service"
   ],
   "done": "origin",
   "note": "提交后回到订单详情"
  },
  {
   "id": "login",
   "name": "登录",
   "start": "login",
   "steps": [
    "login"
   ],
   "done": "origin",
   "note": "游客被拦截后登录，成功回到发起处"
  }
 ],
 "rules": [
  {
   "title": "交易",
   "items": [
    "商品价格以结算页实时价为准，划线价只做参考",
    "库存不足时加购与购买被禁用并写明原因；库存紧张（≤3 件）加购后提示",
    "提交订单后 30 分钟内未支付自动取消，库存同步释放",
    "同一订单只能被支付一次，支付中不可重复提交"
   ]
  },
  {
   "title": "优惠",
   "items": [
    "优惠券与店铺满减按“先满减后券”的顺序叠加，不可叠加的券在选择弹层里置灰并写原因",
    "积分抵扣上限为应付金额的 10%，积分与优惠券可同时使用"
   ]
  },
  {
   "title": "配送",
   "items": [
    "默认当日 18:00 前下单次日送达，偏远地区顺延 1–2 天",
    "收货地址不在配送范围时，结算页提示并禁止提交"
   ]
  },
  {
   "title": "售后",
   "items": [
    "签收后 7 天内可申请售后，退款原路退回，1–3 个工作日到账",
    "售后期内商家未处理超过 48 小时自动同意"
   ]
  },
  {
   "title": "账户与权限",
   "items": [
    "游客可以浏览、搜索、看详情；下单、订单、地址、优惠券、消息需要登录",
    "退出登录后订单与地址在本机不再显示"
   ]
  }
 ],
 "statuses": [
  {
   "id": "pay",
   "name": "待付款",
   "tone": "warn",
   "trigger": "提交订单",
   "ops": "去支付、取消订单",
   "to": "已付款（支付成功）、已取消（超时或手动取消）"
  },
  {
   "id": "ship",
   "name": "待发货",
   "tone": "info",
   "trigger": "支付成功",
   "ops": "提醒发货、申请退款",
   "to": "待收货（商家发货）、售后中"
  },
  {
   "id": "recv",
   "name": "待收货",
   "tone": "info",
   "trigger": "商家发货",
   "ops": "查看物流、确认收货",
   "to": "已完成（确认或 7 天自动确认）"
  },
  {
   "id": "done",
   "name": "已完成",
   "tone": "ok",
   "trigger": "确认收货",
   "ops": "评价、申请售后、再次购买",
   "to": "售后中、已评价"
  },
  {
   "id": "after",
   "name": "售后中",
   "tone": "warn",
   "trigger": "提交售后申请",
   "ops": "查看进度、撤销申请",
   "to": "已退款、已完成（申请被驳回）"
  },
  {
   "id": "cancel",
   "name": "已取消",
   "tone": "mute",
   "trigger": "超时未付或手动取消",
   "ops": "再次购买、删除订单",
   "to": "（终态）"
  }
 ],
 "pages": [
  {
   "id": "home",
   "name": "首页",
   "type": "tab",
   "tab": "home",
   "headerBg": true,
   "blocks": [
    {
     "cid": "MP-NAV-006",
     "text": {
      ".menu [data-o]@0": "望京店 · 30 分钟达",
      ".menu [data-o]@1": "三里屯店 · 45 分钟达",
      ".menu [data-o]@2": "国贸店 · 40 分钟达",
      ".menu [data-o]@3": "中关村店 · 35 分钟达",
      "[data-label]": "望京店 · 30 分钟达"
     },
     "go": {
      ".sr": "list:搜索结果"
     },
     "hide": [
      ".hot@*",
      ".sug",
      ".wx"
     ],
     "name": "顶部：门店与搜索"
    },
    {
     "cid": "MP-HDR-005",
     "name": "轮播活动"
    },
    {
     "cid": "MP-ENT-001",
     "text": {
      ".i1>div@4": "同城"
     },
     "go": {
      ".i1>div@0": "list:新品",
      ".i1>div@1": "list:热销",
      ".i1>div@2": "list:礼品",
      ".i1>div@3": "list:极速达",
      ".i1>div@4": "list:同城",
      ".i1>div@5": "list:礼卡"
     },
     "name": "金刚区"
    },
    {
     "cid": "MP-MKT-002",
     "go": {
      "a": "list:秒杀",
      ".c@0": "detail:1",
      ".c@1": "detail:2",
      ".c@2": "detail:3"
     },
     "name": "限时秒杀"
    },
    {
     "cid": "MP-CARD-001",
     "go": {
      ".c@0": "detail:4",
      ".c@1": "detail:5"
     },
     "act": {
      ".add@0": "addCart",
      ".add@1": "addCart"
     },
     "name": "商品卡（双列）"
    },
    {
     "cid": "MP-CARD-002",
     "go": {
      ".r@0": "detail:6",
      ".r@1": "detail:7"
     },
     "act": {
      ".add@0": "addCart",
      ".add@1": "addCart"
     },
     "name": "商品列表卡"
    }
   ],
   "logic": {
    "from": "启动进入；从任意二级页点标签栏“首页”回到这里",
    "back": "无（一级页，没有返回）",
    "done": "无",
    "primary": "搜索商品（顶部搜索栏）",
    "rules": [
     "门店与配送放在页面顶部，只有一个定位入口",
     "金刚区只放高频的核心业务线（6 个），账户类、订单类入口不放首页，标签栏已有的不重复",
     "首屏营销模块不超过 2 个：轮播活动与限时秒杀；同一活动只占一个位置",
     "整张卡片可点时，卡内不再放指向同一目的地的按钮；商品卡右下角加购按钮只加购，不跳转",
     "商品列表滚动加载，到底显示“没有更多了”"
    ],
    "states": [
     "加载：骨架屏",
     "空：运营位未配置时隐藏该模块",
     "失败：整页失败态带重试",
     "无权限：首页对游客开放"
    ],
    "backend": [
     "轮播活动、金刚区、秒杀商品与场次、推荐位由后台“首页装修”维护",
     "门店与配送范围由后台“门店管理”维护"
    ],
    "actions": [
     {
      "id": "A-001",
      "label": "搜索栏",
      "when": "始终可用",
      "result": "进入商品列表（搜索结果）"
     },
     {
      "id": "A-002",
      "label": "金刚区入口",
      "when": "始终可用",
      "result": "进入对应分类的商品列表"
     },
     {
      "id": "A-003",
      "label": "商品卡加购",
      "when": "有库存",
      "result": "加入购物车并提示"
     }
    ]
   },
   "links": [
    "list:搜索结果",
    "detail:1"
   ]
  },
  {
   "id": "cat",
   "name": "分类",
   "type": "tab",
   "tab": "cat",
   "nav": "space",
   "blocks": [
    {
     "cid": "MP-LIST-001",
     "go": {
      ".sr": "list:搜索结果",
      ".gi@*": "list:分类"
     },
     "attrs": {
      ".gi@*": {
       "data-toast": null
      },
      ".sr": {
       "data-toast": null
      }
     }
    }
   ],
   "logic": {
    "from": "点标签栏“分类”",
    "back": "无（一级页）",
    "done": "无",
    "primary": "选择分类进入商品列表",
    "rules": [
     "左侧一级分类，右侧二级分类与商品入口，滚动联动",
     "分类下无商品时该分类不展示",
     "搜索入口与首页同一目的地，放在页面顶部"
    ],
    "states": [
     "空：分类下没有商品时显示空态",
     "失败：分类加载失败带重试"
    ],
    "backend": [
     "分类树、排序、图标由后台“分类管理”维护"
    ],
    "actions": [
     {
      "id": "A-010",
      "label": "分类宫格",
      "when": "始终可用",
      "result": "进入该分类商品列表"
     }
    ]
   },
   "links": [
    "list:分类"
   ]
  },
  {
   "id": "cart",
   "name": "购物车",
   "type": "tab",
   "tab": "cart",
   "nav": "space",
   "blocks": [
    {
     "cid": "MP-ORD-002",
     "go": {
      ".go2": "checkout"
     },
     "attrs": {
      ".go2": {
       "data-pt-primary": ""
      }
     }
    },
    {
     "cid": "MP-GOODS-009",
     "attrs": {
      ".ad@*": {
       "data-toast": null
      }
     },
     "act": {
      ".ad@*": "addCart"
     }
    }
   ],
   "logic": {
    "from": "点标签栏“购物车”；详情页加购后可再进入",
    "back": "无（一级页）",
    "done": "无",
    "primary": "去结算",
    "rules": [
     "勾选商品后合计实时变化，失效商品不能勾选",
     "满减进度提示还差多少免运费 / 满减",
     "未登录可以加购，去结算时要求登录",
     "数量上限 99，超过提示库存上限"
    ],
    "states": [
     "空：购物车为空时给“去逛逛”",
     "失效商品：置灰并提示原因",
     "无权限：结算需要会员，游客点结算进入登录"
    ],
    "backend": [
     "满减与运费规则由后台“营销规则”维护"
    ],
    "actions": [
     {
      "id": "A-020",
      "label": "去结算",
      "when": "至少勾选 1 件有效商品，否则禁用并提示“请先勾选商品”",
      "result": "进入确认订单"
     }
    ]
   },
   "links": [
    "checkout"
   ]
  },
  {
   "id": "me",
   "name": "我的",
   "type": "tab",
   "tab": "me",
   "headerBg": true,
   "blocks": [
    {
     "cid": "MP-MEM-001",
     "hide": [
      ".dm"
     ],
     "go": {
      "[data-login]": "login"
     }
    },
    {
     "cid": "MP-MEM-007",
     "go": {
      ".all": "orders",
      ".e@0": "orders:pay",
      ".e@1": "orders:ship",
      ".e@2": "orders:recv",
      ".e@3": "orders:rate",
      ".e@4": "orders:after"
     },
     "attrs": {
      ".all": {
       "data-toast": null
      },
      ".e@*": {
       "data-toast": null
      }
     }
    },
    {
     "cid": "MP-ENT-010",
     "text": {
      ".rw@0 .tx b": "收货地址",
      ".rw@0 .tx small": "管理常用收货地址",
      ".rw@1 .tx b": "我的优惠券",
      ".rw@1 .tx small": "查看可用与即将过期的券",
      ".rw@2 .tx b": "消息通知",
