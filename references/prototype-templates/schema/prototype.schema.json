{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luz-prototype/1",
  "title": "Luz 原型规格（luz-prototype/1）",
  "description": "小程序与后台原型的规格：一份 JSON 由 scripts/build_prototype.py 生成单文件 HTML。参考，不是模板：这里只定义结构与引用关系，没有任何必填的页面、模块或入口，页面清单与首页组成由项目的功能说明和行业决定。共用部分见 engine/ENGINE.md，mini 专属字段见 mini/README.md。后台（admin）专属字段由 admin 模板补充到本文件的 $defs 里。",
  "type": "object",
  "required": ["schema", "kind", "meta", "pages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "luz-prototype/1" },
    "kind": { "enum": ["mini", "admin"], "description": "决定用哪个模板" },
    "meta": { "$ref": "#/$defs/meta" },
    "theme": { "$ref": "#/$defs/theme" },
    "config": { "$ref": "#/$defs/config" },
    "assets": { "$ref": "#/$defs/assets" },
    "device": { "$ref": "#/$defs/device" },
    "tabbar": { "type": "array", "items": { "$ref": "#/$defs/tabItem" }, "description": "mini：标签栏" },
    "nav": { "type": "array", "items": { "$ref": "#/$defs/navItem" }, "description": "admin：侧栏菜单" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleGroup" } },
    "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "actions": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/step" } } },
    "data": { "type": "object" },
    "directory": { "type": "array", "items": { "$ref": "#/$defs/dirGroup" } },
    "shell": { "$ref": "#/$defs/shell" },
    "content": { "type": "string", "description": "内容模块文件名（相对规格文件）" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "cid": { "type": "string", "pattern": "^(MP|AD)-[A-Z]+-\\d{3}$", "description": "组件库编号，如 MP-CARD-001" },
    "meta": {
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 }, "subtitle": { "type": "string" }, "brand": { "type": "string" }, "version": { "type": "string" },
        "description": { "type": "string" }, "lang": { "type": "string" },
        "mark": { "type": "string", "description": "页头与标签页图标的 svg 内部图形，32×32 栅格，描边 currentColor" }
      }
    },
    "theme": {
      "type": "object",
      "description": "配置面板各组的默认值；键名 = 配置组 id（id 对应 theme 组）。kind 自己的组（admin）可再加键。",
      "properties": {
        "id": { "enum": ["rose", "coral", "orange", "green", "teal", "blue", "purple", "graphite"] },
        "appearance": { "enum": ["auto", "light", "dark"] },
        "themes": { "type": "array", "items": { "enum": ["rose", "coral", "orange", "green", "teal", "blue", "purple", "graphite"] }, "minItems": 1 },
        "header": { "enum": ["gradient", "light", "image"] },
        "bgImage": { "type": "string" },
        "iconStyle": { "enum": ["3d", "real", "flat", "line"] },
        "iconTile": { "enum": ["sq", "ci", "no"] },
        "sidebar": { "enum": ["light", "dark"], "description": "admin：侧栏深浅" },
        "density": { "enum": ["compact", "standard"], "description": "admin：紧凑（表格行高 44）/ 标准（48），只改行高，字号不变" }
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "groups": { "type": "array", "items": { "type": "string" }, "description": "配置面板里出现哪些组、顺序" },
        "extra": { "type": "array", "items": { "$ref": "#/$defs/configGroup" } }
      }
    },
    "configGroup": {
      "type": "object", "required": ["id", "title", "type", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "type": { "enum": ["swatch", "seg", "cards", "switch", "select"] },
        "options": { "type": "array", "items": { "type": "object", "required": ["v", "label"], "properties": { "v": {}, "label": { "type": "string" }, "css": { "type": "string" }, "swatch": { "type": "string" } } } },
        "default": {}, "cols": { "type": "integer", "minimum": 1, "maximum": 4 }, "note": { "type": "string" },
        "var": { "type": "string", "pattern": "^--" }, "render": { "type": "boolean" }
      }
    },
    "assets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "description": "相对规格文件的素材目录，结构同组件库 assets/（icons/{3d,real,flat}、products/pN、bg）" },
        "bgKeys": { "type": "array", "items": { "type": "string" }, "description": "头部背景图可选的名字（限定集合）" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "背景图名字的显示名" }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "properties": { "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 560 }, "time": { "type": "string" }, "capsule": { "type": "boolean", "description": "是否画微信小程序右上角的菜单胶囊（默认 true）。只对小程序有意义；手机浏览器网页（H5）写 false" } }
    },
    "tabItem": {
      "type": "object", "required": ["id", "name", "icon", "page"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "icon": { "type": "string", "minLength": 1 }, "page": { "$ref": "#/$defs/id" }, "badge": { "type": "string", "description": "K.data 里的路径，数字大于 0 时显示角标" } }
    },
    "navItem": {
      "type": "object", "required": ["id", "name"],
      "description": "侧栏菜单项。带 page 的是标签（一级页）；不带 page 的是分组节点，只管展开收起，必须有 children（可以多级）",
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "page": { "$ref": "#/$defs/id" }, "icon": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/navItem" } },
        "group": { "type": "string", "description": "admin：分组标题，同组的项要连续（扁平写法）" },
        "hidden": { "type": "boolean", "description": "admin：不画在侧栏，但仍是一级页" },
        "badge": { "anyOf": [{ "type": "string" }, { "type": "object" }], "description": "K.data 里的数字路径，或 {count, where}（实时计数）" }
      }
    },
    "shell": {
      "type": "object",
      "description": "admin 外壳用的数据（也可以写在 data.shell 里，生成器会把顶层 shell 合并进 data.shell）：今天、版本、环境、账号、通知……",
      "properties": {
        "today": { "type": "string", "description": "演示用的“今天”，YYYY-MM-DD" }, "now": { "type": "string" }, "version": { "type": "string" },
        "env": { "type": "string", "description": "测试环境标识，生产不写" },
        "account": { "type": "object", "properties": { "name": { "type": "string" }, "av": { "type": ["integer", "string"] }, "store": { "type": "string" } } },
        "notices": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "time": { "type": "string" }, "read": { "type": "boolean" }, "go": { "type": "string" } } } },
        "noticePage": { "$ref": "#/$defs/id" }, "profilePage": { "$ref": "#/$defs/id" },
        "readonlyRoles": { "type": "array", "items": { "type": "string" }, "description": "只读的角色 id（也可以在 roles[] 里写 readonly: true）" },
        "versionInfo": { "type": "array", "items": { "type": "array" }, "description": "[[名, 值], …]" }
      }
    },
    "refText": {
      "description": "字符串，或 {to, text}：to 是页面 id（会做存在性检查并在右栏生成直达链接）、origin（回发起处）或 tab",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "properties": { "to": { "type": "string" }, "text": { "type": "string" }, "pages": { "type": "array", "items": { "type": "string" } } } }
      ]
    },
    "strings": { "type": "array", "items": { "type": "string" } },
    "logic": {
      "type": "object", "additionalProperties": false,
      "description": "本页逻辑，对应 Luz-System 界面功能说明：来源→当前页→返回目标→完成目标、主操作、规则、状态、后台维护",
      "properties": {
        "from": { "$ref": "#/$defs/refText" }, "back": { "$ref": "#/$defs/refText" }, "done": { "$ref": "#/$defs/refText" },
        "primary": { "type": "string", "minLength": 1 },
        "rules": { "$ref": "#/$defs/strings" }, "states": { "$ref": "#/$defs/strings" }, "backend": { "$ref": "#/$defs/strings" }, "data": { "$ref": "#/$defs/strings" },
        "actions": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "when": { "type": "string" }, "result": { "type": "string" } } } }
      }
    },
    "blockItem": {
      "type": "object", "additionalProperties": false,
      "description": "页面内容的一项：cid（库组件）/ custom（内容模块里的渲染函数）/ gap / heading。覆盖键在组件挂载后应用，选择器后缀 @n 取第 n 个匹配、@* 取全部",
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "模块标识（可选）：场景面板“模块显示”里用它做名字，同一页内不能重复；不写就用组件编号" },
        "name": { "type": "string", "description": "模块显示名（可选），优先于 id 与组件编号" },
        "cid": { "$ref": "#/$defs/cid" }, "custom": { "type": "string" }, "args": { "type": "object" }, "gap": { "type": "integer", "minimum": 0 }, "heading": { "type": "string" },
        "text": { "type": "object", "additionalProperties": { "type": "string" } },
        "img": { "type": "object", "additionalProperties": { "type": ["integer", "string"] } },
        "go": { "type": "object", "additionalProperties": { "type": "string" } },
        "back": { "type": "object", "additionalProperties": { "type": ["integer", "string", "boolean"] } },
        "tab": { "type": "object", "additionalProperties": { "type": "string" } },
        "sheet": { "type": "object", "additionalProperties": { "type": "string" } },
        "act": { "type": "object", "additionalProperties": { "type": "string" } },
        "toast": { "type": "object", "additionalProperties": { "type": "string" } },
        "attrs": { "type": "object", "additionalProperties": { "type": "object" }, "description": "{选择器: {属性: 值}}，值为 null 表示移除该属性" },
        "class": { "type": "object", "additionalProperties": { "type": "string" } },
        "hide": { "$ref": "#/$defs/strings" }
      }
    },
    "page": {
      "type": "object", "required": ["id", "name", "type"],
      "description": "页面。共用字段在前，mini 专属字段（title nav light headerBg tabbar blocks header footer custom args layout empty）见 mini/README.md；admin 专属字段由 admin 模板补充。",
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["tab", "sub", "sheet", "result"], "x-enumHints": { "panel": "后台的居中面板写 type: sheet 加 layout: center（schema 里没有 panel 类型）" }, "description": "一级页 / 二级页 / 弹层 / 结果页。后台的居中面板就是 sheet 加 layout: center" },
        "tab": { "$ref": "#/$defs/id" }, "roles": { "type": "array", "items": { "type": "string" } }, "scenes": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "type": "string" }, "description": "自定义渲染里产生的跳转目标（页面 id 或 id:参数），只给可达性检查用" },
        "base": { "$ref": "#/$defs/id" }, "baseArg": { "type": "string" }, "offline": { "type": "boolean" },
        "logic": { "$ref": "#/$defs/logic" },
        "title": { "type": "string", "description": "导航栏标题，可含 {{arg}}（进入参数）与 {{数据路径}}" },
        "nav": { "enum": ["bar", "overlay", "none", "space"], "description": "bar 实色导航栏（有返回与标题）；overlay 透明叠在首屏大图上；none 没有导航栏；space 只留出导航栏那一行高度（让内容躲开右上角的胶囊）" }, "light": { "type": "boolean" }, "headerBg": { "type": "boolean" }, "tabbar": { "type": "boolean" },
        "noBack": { "type": "boolean", "description": "true 时二级页不画导航栏返回键（如支付结果页，用页内按钮离开）" },
        "scroll": { "type": "boolean", "description": "false 时滚动区不滚动，正文铺满（自己管内部滚动，如分类页的左右两栏）" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/blockItem" } },
        "header": { "type": "array", "items": { "$ref": "#/$defs/blockItem" } },
        "footer": { "type": "array", "items": { "$ref": "#/$defs/blockItem" } },
        "custom": { "type": "string" }, "args": { "type": "object" },
        "layout": { "enum": ["bottom", "center"] },
        "maskClose": { "type": "boolean", "description": "仅弹层：false 时点遮罩或面板外不关闭（表单与确认面板用，免得丢已填内容）" },
        "list": { "type": "object", "description": "admin：列表页" }, "dashboard": { "type": "object", "description": "admin：工作台" }, "form": { "type": "object", "description": "admin：表单页" },
        "settings": { "type": "object", "description": "admin：设置页" }, "detail": { "type": "object", "description": "admin：居中详情面板" }, "result": { "type": "object", "description": "admin：结果页" },
        "actions": { "type": "array", "items": { "type": "object" }, "description": "admin：页面顶部操作（最多 1 个主按钮加 2 个次按钮）" },
        "crumb": { "description": "admin：面包屑（二级页用）" }, "titleNew": { "type": "string", "description": "admin：新建时的标题" },
        "empty": { "type": "object", "properties": { "icon": { "type": "string" }, "title": { "type": "string" }, "text": { "type": "string" }, "button": { "type": "string" }, "go": { "type": "string" } } }
      }
    },
    "flow": {
      "type": "object", "required": ["id", "name", "start", "steps"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "start": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "done": { "type": "string", "description": "origin（回发起处）或页面 id" }, "note": { "type": "string" }
      }
    },
    "ruleGroup": { "type": "object", "required": ["title", "items"], "additionalProperties": false, "properties": { "title": { "type": "string" }, "items": { "$ref": "#/$defs/strings" } } },
    "status": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "tone": { "enum": ["ok", "warn", "danger", "info", "mute"] }, "trigger": { "type": "string" }, "ops": { "type": "string" }, "to": { "type": "string" } }
    },
    "scene": {
      "type": "object", "required": ["id", "label", "options"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "pages": { "type": "array", "items": { "type": "string" } }, "default": { "type": "string" },
        "options": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "required": ["v", "label"], "additionalProperties": false, "properties": { "v": { "type": "string" }, "label": { "type": "string" }, "kind": { "enum": ["ok", "busy", "fail", "loading", "empty", "disabled", "denied"] } } }
        }
      }
    },
    "role": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "note": { "type": "string" }, "deniedGo": { "type": "string" }, "deniedLabel": { "type": "string" }, "readonly": { "type": "boolean", "description": "admin：只读角色，改数据的动作置灰并写原因" } }
    },
    "dirGroup": { "type": "object", "required": ["group", "pages"], "additionalProperties": false, "properties": { "group": { "type": "string" }, "pages": { "type": "array", "items": { "type": "string" }, "description": "页面 id，可带进入参数写成 id:参数（如订单详情的不同状态）" } } },
    "step": {
      "type": "object",
      "description": "声明式动作步骤，单键对象：go replace tab sheet back popTo close done toast set inc push role scene branch validate net act stop",
      "properties": {
        "go": { "type": "string" }, "replace": { "type": "string" }, "tab": { "type": "string" }, "sheet": { "type": "string" },
        "back": { "type": ["integer", "boolean"] }, "popTo": { "type": "integer" }, "close": { "type": "boolean" }, "done": { "type": ["string", "boolean"] },
        "toast": { "anyOf": [{ "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "tone": { "enum": ["ok", "info", "warn", "danger"] } } }] },
        "set": { "type": "object", "required": ["path"] }, "inc": { "type": "object", "required": ["path"] }, "push": { "type": "object", "required": ["path", "value"] },
        "role": { "type": "string" }, "scene": { "type": "object", "required": ["id", "value"] },
        "branch": { "type": "object", "properties": { "scene": { "type": "string" }, "path": { "type": "string" }, "cases": { "type": "object" }, "default": { "type": "array" } } },
        "validate": { "type": "array", "items": { "type": "object", "required": ["sel"], "properties": { "sel": { "type": "string" }, "required": { "type": "boolean" }, "pattern": { "type": "string" }, "min": { "type": "integer" }, "msg": { "type": "string" } } } },
        "net": { "type": "boolean" }, "act": { "type": "string" }, "stop": { "type": "boolean" }
      }
    }
  }
}
