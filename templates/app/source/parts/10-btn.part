<!-- cat: BTN | 按钮 -->
<style>
/* 按钮分类：前缀 xbtn-。基础外观来自 kit.css 的 .btn--*，这里只补布局与少量新外观 */
.xbtn-box { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--s-3); min-height: 52px; max-width: 390px; margin: 0 auto; }
.xbtn-box--stack { flex-direction: column; align-items: stretch; }
.xbtn-three { display: grid; grid-template-columns: repeat(3, auto); justify-content: center; align-items: start; gap: var(--s-3); }
.xbtn-three > div { display: grid; justify-items: center; }
.xbtn-three .btn { padding: 0 var(--s-4); }
.xbtn-cap { display: block; margin-top: var(--s-2); text-align: center; font-size: var(--fs-xs); color: var(--ink-2); }
.btn--primary[disabled] { box-shadow: none; }
/* 舞台底色与禁用底色同属浅主色，禁用钮会融进舞台，这里加深一点让按钮轮廓可辨 */
.demo[data-cat="BTN"] .btn[disabled]:not(.btn--text) { background: color-mix(in srgb, var(--ink) 8%, var(--bg)); }
.demo[data-cat="BTN"] .btn--primary:not([disabled]):not(.is-loading) { color: var(--surface); }
.demo[data-cat="BTN"] .btn--soft { background: linear-gradient(135deg, var(--action-press) 0%, var(--action) 100%); }
.demo[data-cat="BTN"] .btn--danger-soft { color: color-mix(in srgb, var(--danger) 80%, var(--ink)); }
.xbtn-pressed { background: var(--action-press); transform: scale(.97); box-shadow: 0 2px 6px color-mix(in srgb, var(--action) 30%, transparent); }
.xbtn-onhero { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); width: 100%; max-width: 390px; margin: 0 auto; padding: var(--s-5); border-radius: var(--r-lg); }
.xbtn-onhero h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }

/* 图标按钮 */
.xbtn-sq { width: 48px; height: 48px; border-radius: 14px; background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
.xbtn-sq img { width: 24px; height: 24px; }
.xbtn-round { width: 48px; height: 48px; box-shadow: var(--elev-2); border: 1px solid var(--line); }
.xbtn-round img { width: 24px; height: 24px; }
.xbtn-photo { position: relative; width: 100%; max-width: 280px; margin: 0 auto; aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; background: var(--zone); }
.xbtn-photo > img { width: 100%; height: 100%; object-fit: cover; }
.xbtn-photo .ibtn { position: absolute; right: var(--s-3); bottom: var(--s-3); width: 48px; height: 48px; box-shadow: var(--elev-3); border: 0; }
.xbtn-photo .ibtn img { width: 26px; height: 26px; filter: grayscale(1) opacity(.5); transition: filter var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xbtn-photo .ibtn[aria-pressed="true"] img { filter: none; transform: scale(1.12); }
.xbtn-cartbtn { width: 52px; height: 52px; }
.xbtn-cartbtn img { width: 30px; height: 30px; }
.xbtn-cartbtn .badge { top: 0; right: 0; }

/* 需要定位的悬浮类：用一块手机底部的框模拟页面 */
.xbtn-mock { position: relative; width: 100%; max-width: 390px; margin: 0 auto; border-radius: var(--r-md); overflow: hidden; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line); }
.xbtn-inlist { margin: var(--s-3); box-shadow: none; }
.xbtn-fab { position: absolute; right: var(--s-4); bottom: var(--s-4); }
.xbtn-mock--fab .xbtn-inlist { margin-bottom: 28px; }
.xbtn-mock--fab .xbtn-fab { right: var(--s-3); bottom: var(--s-3); }
.xbtn-mock--col { display: flex; flex-direction: column; }
.xbtn-kv { display: grid; gap: var(--s-2); padding: 0 var(--s-4) var(--s-4); }
.xbtn-kv span { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); }
.xbtn-kv b { font-weight: 600; color: var(--ink); }

/* 数量步进 */
.xbtn-line { display: flex; align-items: center; gap: var(--s-3); width: 100%; max-width: 390px; margin: 0 auto; }
.xbtn-line img { width: 56px; height: 56px; border-radius: var(--r-md); object-fit: cover; }
.xbtn-line .xbtn-main { flex: 1; min-width: 0; }
.xbtn-line .xbtn-name { font-weight: 600; line-height: var(--lh-tight); }
.xbtn-step { display: inline-flex; align-items: center; padding: 3px; border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); }
.xbtn-step button { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; transition: background var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
.xbtn-step button:active { transform: scale(.9); }
.xbtn-step__plus { background: var(--action-tint); }
.xbtn-step__plus img { width: 16px; height: 16px; }
.xbtn-step__minus::before { content: ""; width: 14px; height: 2px; border-radius: 1px; background: var(--ink); }
.xbtn-step button[disabled] { opacity: .35; pointer-events: none; }
.xbtn-step input { width: 40px; height: 34px; border: 0; background: none; text-align: center; font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; }
.xbtn-step input:focus-visible { outline: none; background: var(--zone); border-radius: var(--r-sm); }

/* 拆分按钮的下拉 */
.xbtn-pop { position: relative; display: inline-block; }
.xbtn-caret { padding: 0 var(--s-3); }
.xbtn-caret .chev::after { border-color: var(--bg); transform: rotate(45deg) translateY(-2px); margin: 0; transition: transform var(--dur-base) var(--ease-out); }
.xbtn-caret[aria-expanded="true"] .chev::after { transform: rotate(225deg) translateY(-2px); }
.xbtn-menu { position: absolute; z-index: 5; top: calc(100% + 6px); left: 0; right: 0; padding: var(--s-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); opacity: 0; transform: translateY(-4px) scale(.97); transform-origin: top center; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
.xbtn-pop[data-open="true"] .xbtn-menu { opacity: 1; transform: none; pointer-events: auto; }
.xbtn-menu button { display: block; width: 100%; min-height: 40px; padding: 0 var(--s-3); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); }
.xbtn-menu button:hover { background: var(--zone); }

/* 底部双按钮栏与悬浮购物车条 */
.xbtn-prod { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-4); }
.xbtn-prod img { width: 64px; height: 64px; border-radius: var(--r-md); object-fit: cover; }
.xbtn-prod b { display: block; font-weight: 600; line-height: var(--lh-tight); }
.xbtn-bar { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3) var(--s-3); background: var(--bg); border-top: 1px solid var(--line); }
.xbtn-bar__ic { display: grid; justify-items: center; gap: 2px; width: 48px; font-size: var(--fs-xs); color: var(--ink-2); }
.xbtn-bar__ic img { width: 24px; height: 24px; }
.xbtn-mock--col .xbtn-bar { position: static; }
.xbtn-bar .btn { flex: 1; }
.xbtn-bar .btn--primary { flex: 1.2; }
.xbtn-cart { position: absolute; left: var(--s-3); right: var(--s-3); bottom: var(--s-3); display: flex; align-items: center; gap: var(--s-3); padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4); border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--elev-3); }
.xbtn-cart__ic { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--action-tint); }
.xbtn-cart__ic img { width: 28px; height: 28px; }
.xbtn-cart__ic .badge { top: -2px; right: -4px; }
.xbtn-cart__sum { flex: 1; font-size: var(--fs-sm); color: var(--ink-3); line-height: var(--lh-tight); }
.xbtn-cart__sum .price { font-size: var(--fs-lg); }
.xbtn-pickrow { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); }
.xbtn-pickrow + .xbtn-pickrow { border-top: 1px solid var(--line); }
.xbtn-pickrow img { width: 44px; height: 44px; border-radius: var(--r-md); object-fit: cover; }
.xbtn-pickrow .xbtn-main { flex: 1; min-width: 0; }
.xbtn-pickrow b { display: block; font-weight: 600; line-height: var(--lh-tight); }

/* 返回顶部 */
.xbtn-scroller { height: 100%; overflow-y: auto; padding: var(--s-3); scrollbar-width: none; }
.xbtn-scroller::-webkit-scrollbar { display: none; }
.xbtn-top { position: absolute; right: var(--s-3); bottom: var(--s-3); width: 48px; height: 48px; opacity: 0; transform: translateY(10px) scale(.9); pointer-events: none; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xbtn-top.is-on { opacity: 1; transform: none; pointer-events: auto; }
.xbtn-top img { width: 22px; height: 22px; transform: rotate(90deg); }

/* 关注、验证码、双色胶囊 */
.xbtn-follow { display: flex; align-items: center; gap: var(--s-3); width: 100%; max-width: 390px; margin: 0 auto; }
.xbtn-follow img { width: 44px; height: 44px; border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); padding: 6px; }
.xbtn-follow .xbtn-main { flex: 1; min-width: 0; }
.xbtn-follow b { display: block; font-weight: 600; line-height: var(--lh-tight); }
.xbtn-follow .btn[aria-pressed="true"] { background: var(--zone); color: var(--ink-3); box-shadow: none; }
.xbtn-code { display: flex; align-items: center; width: 100%; max-width: 330px; margin: 0 auto; padding: 0 var(--s-2) 0 var(--s-4); border-radius: var(--r-md); }
.xbtn-code input { flex: 1; min-width: 0; height: 46px; border: 0; background: none; font-size: var(--fs-md); }
.xbtn-code input:focus-visible { outline: none; }
.xbtn-code input::placeholder { color: var(--ink-3); }
.xbtn-code .btn { min-width: 112px; justify-content: flex-end; font-variant-numeric: tabular-nums; }
.xbtn-code .btn[disabled] { background: none; color: var(--ink-3); }
.xbtn-duo { display: inline-flex; border-radius: var(--r-full); overflow: hidden; box-shadow: 0 8px 18px color-mix(in srgb, var(--action) 22%, transparent); }
.xbtn-duo button { min-height: 48px; padding: 0 var(--s-5); font-size: var(--fs-md); font-weight: 600; transition: filter var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
.xbtn-duo button:active { transform: scale(.97); }
.xbtn-duo__a { padding-left: var(--s-6) !important; background: var(--accent-tint); color: var(--accent); }
.xbtn-duo__b { padding-right: var(--s-6) !important; background: var(--action); color: var(--surface); }
@media (hover: hover) { .xbtn-duo__a:hover { filter: brightness(.97); } .xbtn-duo__b:hover { background: var(--action-press); } }
.xbtn-agree { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); cursor: pointer; }
</style>

<article class="demo" data-cid="AP-BTN-001" data-name="主操作按钮" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">主操作按钮</span></div>
  <p class="demo__note">适合：一屏唯一的主操作</p>
  <div class="demo__stage"><div class="xbtn-box"><button class="btn btn--primary" data-xbtn-t="已提交">立即购买</button></div></div>
</article>

