  <div class="demo__stage is-plain"><div class="xbtn-mock xbtn-sb" data-xbtn-submit>
    <div class="card list xbtn-sb__list">
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="xbtn-main"><b class="one-line">粉芍药花束</b><span class="xbtn-sb__sub">鲜切 11 枝 1 件</span></div><span class="price"><small>¥</small>239</span></div>
      <div role="radiogroup" aria-label="收货地址">
        <button class="xbtn-sb__opt" role="radio" aria-checked="true" data-reach="true"><span class="xbtn-sb__dot"></span><div class="xbtn-main"><b class="one-line">浦东新区世纪大道 88 号</b><span class="xbtn-sb__sub">林晓 138 **** 6620</span></div></button>
        <button class="xbtn-sb__opt" role="radio" aria-checked="false" data-reach="false"><span class="xbtn-sb__dot"></span><div class="xbtn-main"><b class="one-line">崇明区长兴岛 12 号</b><span class="xbtn-sb__sub">林晓 138 **** 6620</span></div></button>
