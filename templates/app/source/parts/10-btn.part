<article class="demo" data-cid="AP-BTN-031" data-name="双色胶囊按钮" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">双色胶囊按钮</span></div>
  <p class="demo__note">适合：商品页同时放加购与购买的紧凑组合</p>
  <div class="demo__stage"><div class="xbtn-box"><div class="xbtn-duo"><button class="xbtn-duo__a" data-xbtn-t="已加入购物车">加入购物车</button><button class="xbtn-duo__b" data-xbtn-t="订单已提交">立即购买</button></div></div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const D = id => $(`[data-cid="${id}"]`);

  $$('[data-xbtn-t]').forEach(b => b.addEventListener('click', () => Lz.toast(b.dataset.xbtnT, 'success')));
  $$('[data-xbtn-confirm]').forEach(b => b.addEventListener('click', async () => {
    const [title, body, ok, tone, done] = b.dataset.xbtnConfirm.split('|');
    if (await Lz.confirm({ title, body, ok, tone })) Lz.toast(done, 'success');
  }));

  /* 收藏浮起钮 */
  $$('[data-xbtn-fav]').forEach(b => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-label', on ? '取消收藏' : '收藏'); b.dataset.tip = on ? '取消收藏' : '收藏';
    Lz.toast(on ? '已收藏' : '已取消收藏', on ? 'success' : 'neutral');
  }));

  /* 数量角标 */
  $$('[data-xbtn-badge]').forEach(b => b.addEventListener('click', () => {
    const g = $('.badge', b); const n = Math.min(99, (parseInt(g.textContent, 10) || 0) + 1);
    g.textContent = n; g.style.animation = 'none'; void g.offsetWidth; g.style.animation = '';
  }));

  /* 加载中 */
  $$('[data-xbtn-load]').forEach(b => b.addEventListener('click', () => {
    b.classList.add('is-loading'); b.setAttribute('aria-busy', 'true');
    setTimeout(() => { b.classList.remove('is-loading'); b.removeAttribute('aria-busy'); Lz.toast('订单已提交', 'success'); }, 1800);
  }));

  /* 禁用后启用 */
  (() => {
    const root = D('AP-BTN-021'), btn = $('[data-xbtn-gate]', root), chk = $('.check', root);
    root.addEventListener('lz:toggle', () => { btn.disabled = chk.getAttribute('aria-checked') !== 'true'; });
    $('[data-xbtn-agree]', root).addEventListener('click', () => chk.click());
  })();

  /* 拆分按钮下拉 */
  $$('[data-xbtn-pop]').forEach(p => {
    const caret = $('.xbtn-caret', p), set = open => { p.dataset.open = String(open); caret.setAttribute('aria-expanded', String(open)); };
    caret.addEventListener('click', e => { e.stopPropagation(); set(p.dataset.open !== 'true'); });
    $$('.xbtn-menu button', p).forEach(b => b.addEventListener('click', () => set(false)));
    document.addEventListener('click', () => set(false));
    p.addEventListener('keydown', e => { if (e.key === 'Escape') { set(false); caret.focus(); } });
  });

  /* 分段按钮组 */
  $$('[data-xbtn-seg]').forEach(g => $$('button', g).forEach(b => b.addEventListener('click', () => $$('button', g).forEach(x => x.setAttribute('aria-pressed', String(x === b))))));

  /* 数量步进 */
  $$('[data-xbtn-step]').forEach(s => {
    const minus = $('.xbtn-step__minus', s), plus = $('.xbtn-step__plus', s), input = $('input', s), price = +s.dataset.price;
    const sum = $('[data-xbtn-sum]', s.closest('.xbtn-line'));
    const set = v => { v = Math.min(99, Math.max(1, v || 1)); input.value = v; minus.disabled = v <= 1; plus.disabled = v >= 99; sum.innerHTML = `<small>¥</small>${(v * price).toLocaleString('zh-CN')}`; };
    minus.addEventListener('click', () => set(+input.value - 1)); plus.addEventListener('click', () => set(+input.value + 1));
    input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 2); });
    input.addEventListener('change', () => set(parseInt(input.value, 10)));
    input.addEventListener('keydown', e => { const d = { ArrowUp: 1, ArrowDown: -1 }[e.key]; if (d) { e.preventDefault(); set((+input.value || 1) + d); } });
  });

  /* 悬浮购物车条 */
  $$('[data-xbtn-cartbar]').forEach(m => {
    const badge = $('.badge', m), sum = $('[data-sum]', m), go = $('[data-go]', m); let n = 0, total = 0;
    $$('[data-price]', m).forEach(b => b.addEventListener('click', () => {
      n += 1; total += +b.dataset.price; badge.hidden = false; badge.textContent = n; badge.style.animation = 'none'; void badge.offsetWidth; badge.style.animation = '';
      sum.innerHTML = `<small>¥</small>${total}`; go.disabled = false;
    }));
    go.addEventListener('click', () => Lz.toast('正在前往结算', 'success'));
  });

  /* 返回顶部 */
  $$('[data-xbtn-top]').forEach(m => {
    const sc = $('.xbtn-scroller', m), top = $('.xbtn-top', m);
    sc.addEventListener('scroll', () => top.classList.toggle('is-on', sc.scrollTop > 60));
    top.addEventListener('click', () => sc.scrollTo({ top: 0, behavior: Lz.reduce ? 'auto' : 'smooth' }));
  });

  /* 关注切换 */
  $$('[data-xbtn-follow]').forEach(b => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); b.textContent = on ? '已关注' : '关注';
    Lz.toast(on ? '已关注' : '已取消关注', on ? 'success' : 'neutral');
  }));

  /* 验证码倒计时 */
  $$('[data-xbtn-code]').forEach(c => {
    const b = $('.btn', c); let t = null;
    b.addEventListener('click', () => {
      let s = 59; b.disabled = true; b.textContent = `${s} 秒后重发`; Lz.toast('验证码已发送', 'success');
      t = setInterval(() => { s -= 1; if (s <= 0) { clearInterval(t); b.disabled = false; b.textContent = '重新获取'; } else b.textContent = `${s} 秒后重发`; }, 1000);
    });
  });
})();
</script>

<style>
/* 新增按钮：批量操作栏 xbtn-bt、结算栏 xbtn-sb、悬浮菜单 xbtn-fm、拖动球 xbtn-fb */
.xbtn-bt .check[aria-checked="mixed"] { background: var(--action); border-color: var(--action); }
.xbtn-bt .check[aria-checked="mixed"]::after { content: ""; width: 10px; height: 2px; border-radius: 1px; background: var(--surface); }

/* 多选批量操作栏 */
.xbtn-bt, .xbtn-sb { box-shadow: none; border: 1px solid var(--line); }
.xbtn-bt { display: flex; flex-direction: column; }
.xbtn-bt__list { margin: var(--s-3) var(--s-3) 0; box-shadow: none; }
.xbtn-bt .xbtn-pickrow { cursor: pointer; transition: background var(--dur-quick) var(--ease-out); }
.xbtn-bt .xbtn-pickrow.is-sel { background: var(--action-tint); }
.xbtn-bt__empty { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 68px; padding: var(--s-3) var(--s-4); font-weight: 600; }
.xbtn-bt__bar { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-3); padding: var(--s-3); background: var(--surface); border-top: 1px solid var(--line); transform: translateY(101%); transition: transform var(--dur-base) var(--ease-out); }
.xbtn-bt__bar[data-on="true"] { transform: none; }
.xbtn-bt__all { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 32px; font-size: var(--fs-sm); cursor: pointer; }
.xbtn-bt__n { margin-left: auto; font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }
.xbtn-bt__n b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

/* 提交订单结算栏 */
.xbtn-sb { display: flex; flex-direction: column; }
.xbtn-sb__list { margin: var(--s-3) var(--s-3) var(--s-4); box-shadow: none; }
.xbtn-sb__sub { display: block; font-size: var(--fs-sm); color: var(--ink-3); }
.xbtn-sb__opt { display: flex; align-items: center; gap: var(--s-3); width: 100%; padding: var(--s-3) var(--s-4); text-align: left; border-top: 1px solid var(--line); transition: background var(--dur-quick) var(--ease-out); }
.xbtn-sb__opt[aria-checked="true"] { background: var(--action-tint); }
.xbtn-sb__opt b { display: block; font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); }
.xbtn-sb__opt .xbtn-main { flex: 1; min-width: 0; }
.xbtn-sb__dot { display: grid; place-items: center; width: 20px; height: 20px; flex: none; border-radius: 50%; border: 1.5px solid var(--line-strong); background: var(--surface); transition: border-color var(--dur-quick) var(--ease-out); }
.xbtn-sb__dot::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--action); transform: scale(0); transition: transform var(--dur-base) var(--ease-spring); }
.xbtn-sb__opt[aria-checked="true"] .xbtn-sb__dot { border-color: var(--action); }
.xbtn-sb__opt[aria-checked="true"] .xbtn-sb__dot::after { transform: scale(1); }
.xbtn-sb__hint { display: flex; align-items: center; gap: var(--s-2); min-height: 36px; padding: 0 var(--s-4); font-size: var(--fs-sm); background: var(--success-tint); color: var(--success); transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.xbtn-sb__hint::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
.xbtn-sb__hint[data-tone="warn"] { background: var(--warning-tint); color: var(--warning); }
.xbtn-sb__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); background: var(--surface); border-top: 1px solid var(--line); }
.xbtn-sb__sum { display: flex; align-items: baseline; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
.xbtn-sb__amt { font-size: var(--fs-xl); }
.xbtn-sb__bar .btn { min-width: 128px; }
.demo[data-cat="BTN"] .xbtn-sb__bar .btn.is-loading { color: transparent; }

/* 展开式悬浮菜单 */
.xbtn-fm { padding: var(--s-3); }
.xbtn-fm__list { box-shadow: none; }
.xbtn-fm__veil { position: absolute; inset: 0; z-index: 2; background: color-mix(in srgb, var(--surface) 74%, transparent); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
.xbtn-fm[data-open="true"] .xbtn-fm__veil { opacity: 1; pointer-events: auto; }
.xbtn-fm__fab { position: absolute; z-index: 4; right: var(--s-3); bottom: var(--s-3); }
.xbtn-fm__fab img { position: absolute; inset: 0; margin: auto; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xbtn-fm__fab .xbtn-fm__x { opacity: 0; transform: rotate(-90deg) scale(.6); }
.xbtn-fm[data-open="true"] .xbtn-fm__fab .xbtn-fm__x { opacity: 1; transform: none; }
.xbtn-fm[data-open="true"] .xbtn-fm__fab .xbtn-fm__m { opacity: 0; transform: rotate(90deg) scale(.6); }
.xbtn-fm__menu { position: absolute; z-index: 3; right: var(--s-3); bottom: 80px; display: flex; flex-direction: column-reverse; align-items: flex-end; gap: 10px; }
.xbtn-fm__it { display: inline-flex; align-items: center; gap: var(--s-3); height: 44px; padding: 0 4px 0 var(--s-4); border-radius: var(--r-full); background: var(--surface); box-shadow: var(--elev-2); font-size: var(--fs-sm); font-weight: 600; white-space: nowrap; opacity: 0; transform: translateY(14px) scale(.92); transform-origin: right bottom; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring), background var(--dur-quick) var(--ease-out); transition-delay: 0ms; }
.xbtn-fm[data-open="true"] .xbtn-fm__it { opacity: 1; transform: none; pointer-events: auto; transition-delay: calc(var(--i) * 35ms); }
.xbtn-fm__it i { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
.xbtn-fm__it i img { width: 20px; height: 20px; }
@media (hover: hover) { .xbtn-fm__it:hover { background: var(--zone); } }

/* 悬浮拖动球 */
.xbtn-fb { padding: var(--s-3); }
.xbtn-fb__list { box-shadow: none; }
.xbtn-fb__ball { position: absolute; z-index: 3; left: 0; top: 0; display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: var(--action); box-shadow: var(--elev-3); touch-action: none; user-select: none; cursor: grab; transition: left var(--dur-slow) var(--ease-out), top var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out); }
.xbtn-fb__ball.is-drag { cursor: grabbing; transition: none; box-shadow: var(--elev-4); }
.xbtn-fb__ball.is-dock-l { transform: translateX(-58%); opacity: .72; }
.xbtn-fb__ball.is-dock-r { transform: translateX(58%); opacity: .72; }
.xbtn-fb__ball img { width: 24px; height: 24px; filter: invert(1); }
.xbtn-fb__ball:active { transform: scale(.94); }
.xbtn-fb__ball .badge { top: 0; right: 0; }
</style>

<article class="demo" data-cid="AP-BTN-032" data-name="多选批量操作栏" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">多选批量操作栏</span></div>
  <p class="demo__note">适合：列表多选后底部出现全选与批量操作按钮</p>
  <div class="demo__stage is-plain"><div class="xbtn-mock xbtn-bt" data-xbtn-batch>
    <div class="card list xbtn-bt__list">
      <div class="xbtn-pickrow"><span class="check" role="checkbox" aria-checked="true" aria-label="选择红玫瑰花束"><img src="../../kit/assets/line/check.webp" alt=""></span><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="xbtn-main"><b class="one-line">红玫瑰花束</b><span class="price"><small>¥</small>199</span></div></div>
      <div class="xbtn-pickrow"><span class="check" role="checkbox" aria-checked="false" aria-label="选择粉芍药花束"><img src="../../kit/assets/line/check.webp" alt=""></span><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="xbtn-main"><b class="one-line">粉芍药花束</b><span class="price"><small>¥</small>239</span></div></div>
      <div class="xbtn-pickrow"><span class="check" role="checkbox" aria-checked="false" aria-label="选择多肉组合盆"><img src="../../kit/assets/line/check.webp" alt=""></span><img src="../../kit/assets/photo/product-succulent.webp" alt=""><div class="xbtn-main"><b class="one-line">多肉组合盆</b><span class="price"><small>¥</small>89</span></div></div>
      <div class="xbtn-bt__empty" hidden><span>购物车已清空</span><button class="btn btn--secondary btn--sm btn--pill" data-bt-reset>恢复商品</button></div>
    </div>
    <div class="xbtn-bt__bar" data-on="true">
      <div class="xbtn-bt__all"><span class="check" role="checkbox" aria-checked="mixed" aria-label="全选"><img src="../../kit/assets/line/check.webp" alt=""></span><span>全选</span></div>
      <span class="xbtn-bt__n">已选 <b>1</b> 件</span>
      <button class="btn btn--secondary btn--sm" data-bt-fav>移入收藏</button>
      <button class="btn btn--danger-soft btn--sm" data-bt-del>删除</button>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="AP-BTN-033" data-name="提交订单结算栏" data-cat="BTN">
