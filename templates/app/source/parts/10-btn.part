    <div class="xbtn-sb__bar"><div class="xbtn-sb__sum"><span>合计</span><span class="price xbtn-sb__amt"><small>¥</small>239</span></div><button class="btn btn--primary btn--pill" data-sb-go>提交订单</button></div>
  </div></div>
</article>

<article class="demo" data-cid="AP-BTN-034" data-name="展开式悬浮菜单" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">展开式悬浮菜单</span></div>
  <p class="demo__note">适合：悬浮钮点开后列出若干相关快捷动作</p>
  <div class="demo__stage is-plain"><div class="xbtn-mock xbtn-fm" data-xbtn-fm data-open="true">
    <div class="card list xbtn-fm__list">
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="xbtn-main"><b>红玫瑰花束</b><span class="price"><small>¥</small>199</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="xbtn-main"><b>粉芍药花束</b><span class="price"><small>¥</small>239</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><div class="xbtn-main"><b>向日葵花束</b><span class="price"><small>¥</small>159</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div class="xbtn-main"><b>白郁金香</b><span class="price"><small>¥</small>179</span></div></div>
    </div>
    <div class="xbtn-fm__veil" data-fm-veil></div>
    <button class="btn btn--primary btn--fab xbtn-fm__fab" aria-label="快捷操作" aria-haspopup="menu" aria-expanded="true" aria-controls="xbtn-fm-menu" data-tip="收起快捷操作" data-fm-fab><img class="xbtn-fm__m" src="../../kit/assets/line/list.webp" alt=""><img class="xbtn-fm__x" src="../../kit/assets/line/close.webp" alt=""></button>
    <div class="xbtn-fm__menu" id="xbtn-fm-menu" role="menu" aria-label="快捷操作">
      <button class="xbtn-fm__it" role="menuitem" style="--i: 0" data-xbtn-t="客服已接入">联系客服<i><img src="../../kit/assets/line/support.webp" alt=""></i></button>
      <button class="xbtn-fm__it" role="menuitem" style="--i: 1" data-xbtn-t="已打开附近门店">附近门店<i><img src="../../kit/assets/line/location.webp" alt=""></i></button>
      <button class="xbtn-fm__it" role="menuitem" style="--i: 2" data-xbtn-t="已打开扫码">扫一扫<i><img src="../../kit/assets/line/scan.webp" alt=""></i></button>
      <button class="xbtn-fm__it" role="menuitem" style="--i: 3" data-xbtn-t="已打开搜索">搜索商品<i><img src="../../kit/assets/line/search.webp" alt=""></i></button>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="AP-BTN-035" data-name="悬浮拖动球" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">悬浮拖动球</span></div>
  <p class="demo__note">适合：可拖动并贴边的客服或快捷入口</p>
  <div class="demo__stage is-plain"><div class="xbtn-mock xbtn-fb" data-xbtn-fb>
    <div class="card list xbtn-fb__list">
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="xbtn-main"><b>红玫瑰花束</b><span class="price"><small>¥</small>199</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="xbtn-main"><b>粉芍药花束</b><span class="price"><small>¥</small>239</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><div class="xbtn-main"><b>向日葵花束</b><span class="price"><small>¥</small>159</span></div></div>
      <div class="xbtn-pickrow"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div class="xbtn-main"><b>白郁金香</b><span class="price"><small>¥</small>179</span></div></div>
    </div>
    <button class="xbtn-fb__ball" aria-label="联系客服" data-tip="联系客服" data-fb-ball><img src="../../kit/assets/line/support.webp" alt=""><span class="badge">2</span></button>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];

  /* 多选批量操作栏：行内勾选，底部栏随选中数出现，全选带半选态 */
  $$('[data-xbtn-batch]').forEach(m => {
    const list = $('.xbtn-bt__list', m), bar = $('.xbtn-bt__bar', m), all = $('.check', bar), num = $('.xbtn-bt__n b', bar), empty = $('.xbtn-bt__empty', m);
    const rows = () => $$('.xbtn-pickrow', list).filter(r => !r.hidden), on = r => $('.check', r).getAttribute('aria-checked') === 'true';
    const sync = () => {
      const rs = rows(), n = rs.filter(on).length;
      rs.forEach(r => r.classList.toggle('is-sel', on(r)));
      all.setAttribute('aria-checked', n === 0 ? 'false' : n === rs.length ? 'true' : 'mixed');
      num.textContent = n; bar.dataset.on = String(n > 0); bar.inert = n === 0; empty.hidden = rs.length > 0;
    };
    m.addEventListener('lz:toggle', e => { if (e.target === all) rows().forEach(r => $('.check', r).setAttribute('aria-checked', all.getAttribute('aria-checked'))); sync(); });
    list.addEventListener('click', e => { const r = e.target.closest('.xbtn-pickrow'); if (r && !e.target.closest('.check')) $('.check', r).click(); });
    $('.xbtn-bt__all', bar).addEventListener('click', e => { if (!e.target.closest('.check')) all.click(); });
    const drop = tip => { const hit = rows().filter(on); hit.forEach(r => { r.hidden = true; $('.check', r).setAttribute('aria-checked', 'false'); }); sync(); Lz.toast(`${tip}${hit.length} 件`, 'success'); };
    $('[data-bt-fav]', bar).addEventListener('click', () => drop('已移入收藏 '));
    $('[data-bt-del]', bar).addEventListener('click', async () => { if (await Lz.confirm({ title: '确认删除所选商品', body: '删除后需重新加入购物车', ok: '确认删除', tone: 'danger' })) drop('已删除 '); });
    $('[data-bt-reset]', m).addEventListener('click', () => { $$('.xbtn-pickrow', list).forEach(r => { r.hidden = false; $('.check', r).setAttribute('aria-checked', 'false'); }); sync(); });
    sync();
  });

  /* 提交订单结算栏：地址可达才能提交，提交时按钮进入加载态 */
  $$('[data-xbtn-submit]').forEach(m => {
    const opts = $$('[role="radio"]', m), hint = $('[data-sb-hint]', m), go = $('[data-sb-go]', m);
    const pick = o => {
      opts.forEach(x => { x.setAttribute('aria-checked', String(x === o)); x.tabIndex = x === o ? 0 : -1; });
      const ok = o.dataset.reach === 'true'; hint.dataset.tone = ok ? 'ok' : 'warn'; hint.textContent = ok ? '该地址可同城急送' : '该地址不在配送范围'; go.disabled = !ok;
    };
    opts.forEach((o, i) => {
      o.addEventListener('click', () => pick(o));
      o.addEventListener('keydown', e => { const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return; e.preventDefault(); const n = opts[(i + d + opts.length) % opts.length]; n.focus(); pick(n); });
    });
    pick(opts[0]);
    go.addEventListener('click', () => {
      go.classList.add('is-loading'); go.setAttribute('aria-busy', 'true');
      setTimeout(() => { go.classList.remove('is-loading'); go.removeAttribute('aria-busy'); Lz.toast('订单已提交', 'success'); }, 1600);
    });
  });

  /* 展开式悬浮菜单：悬浮钮开合，点遮罩、选动作或按 Esc 收起 */
  $$('[data-xbtn-fm]').forEach(m => {
    const fab = $('[data-fm-fab]', m), menu = $('.xbtn-fm__menu', m), items = $$('.xbtn-fm__it', m);
    const set = open => {
      m.dataset.open = String(open); fab.setAttribute('aria-expanded', String(open)); fab.dataset.tip = open ? '收起快捷操作' : '展开快捷操作'; menu.inert = !open;
    };
    fab.addEventListener('click', () => set(m.dataset.open !== 'true'));
    $('[data-fm-veil]', m).addEventListener('click', () => set(false));
    items.forEach(b => b.addEventListener('click', () => { set(false); fab.focus(); }));
    m.addEventListener('keydown', e => {
      if (e.key === 'Escape' && m.dataset.open === 'true') { set(false); fab.focus(); return; }
      const i = items.indexOf(document.activeElement), d = { ArrowUp: 1, ArrowDown: -1 }[e.key];
      if (d && m.dataset.open === 'true') { e.preventDefault(); const n = i < 0 ? (d > 0 ? 0 : items.length - 1) : i + d; if (n >= 0 && n < items.length) items[n].focus(); else fab.focus(); }
    });
    set(true);
  });

  /* 悬浮拖动球：拖动后吸附到左右边缘，闲置半隐，点按进入客服 */
  $$('[data-xbtn-fb]').forEach(m => {
    const ball = $('[data-fb-ball]', m), GAP = 8; let side = 'r', y = null, drag = null, moved = false, idle = 0;
    const size = () => ball.offsetWidth, W = () => m.clientWidth, H = () => m.clientHeight;
    const clampY = v => Math.min(Math.max(GAP, v), H() - size() - GAP);
    const put = (x, yy) => { ball.style.left = x + 'px'; ball.style.top = yy + 'px'; };
    const dock = () => { ball.classList.toggle('is-dock-l', side === 'l'); ball.classList.toggle('is-dock-r', side === 'r'); };
    const wake = () => { clearTimeout(idle); ball.classList.remove('is-dock-l', 'is-dock-r'); };
    const rest = () => { clearTimeout(idle); idle = setTimeout(dock, 2400); };
    const snap = () => { put(side === 'l' ? GAP : W() - size() - GAP, y); };
    y = clampY(H() * .5); put(W() - size() - GAP, y);
    new ResizeObserver(() => { y = clampY(y); snap(); }).observe(m);
    ball.addEventListener('pointerdown', e => {
      wake(); document.querySelectorAll('.tip').forEach(t => t.remove());
      ball.setPointerCapture(e.pointerId); moved = false;
      drag = { sx: e.clientX, sy: e.clientY, x: ball.offsetLeft, y: ball.offsetTop }; ball.classList.add('is-drag');
    });
    ball.addEventListener('pointermove', e => {
      if (!drag) return; const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
      if (Math.hypot(dx, dy) > 5) moved = true;
      if (!moved) return;
      document.querySelectorAll('.tip').forEach(t => t.remove());
      put(Math.min(Math.max(GAP, drag.x + dx), W() - size() - GAP), clampY(drag.y + dy));
    });
    const end = () => {
      if (!drag) return; drag = null; ball.classList.remove('is-drag');
      if (moved) { side = ball.offsetLeft + size() / 2 < W() / 2 ? 'l' : 'r'; y = clampY(ball.offsetTop); snap(); rest(); }
    };
    ball.addEventListener('pointerup', end); ball.addEventListener('pointercancel', end);
    ball.addEventListener('click', () => { if (moved) { moved = false; return; } wake(); Lz.toast('客服已接入', 'success'); rest(); });
    ball.addEventListener('pointerenter', wake); ball.addEventListener('pointerleave', () => { if (!drag) rest(); });
    ball.addEventListener('focus', wake); ball.addEventListener('blur', rest);
    ball.addEventListener('keydown', e => {
      const k = e.key; if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) return; e.preventDefault(); wake();
      if (k === 'ArrowLeft') side = 'l'; else if (k === 'ArrowRight') side = 'r'; else y = clampY(y + (k === 'ArrowUp' ? -24 : 24));
      snap();
    });
  });
})();
</script>
