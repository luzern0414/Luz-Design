<style>
/* 新增背景：安全区垫 xbg-sf、边缘渐隐 xbg-fd、水印层 xbg-wm */
.xbg-sf { display: grid; justify-items: center; gap: var(--s-3); }
.xbg-sf__phone { display: flex; flex-direction: column; width: 100%; max-width: 390px; height: 292px; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line-strong); background: var(--bg); }
.xbg-sf__scroll { flex: 1; min-height: 0; padding: var(--s-3); overflow-y: auto; scrollbar-width: none; }
.xbg-sf__scroll::-webkit-scrollbar { display: none; }
.xbg-sf__scroll .card { box-shadow: none; }
.xbg-sf__bar { flex: none; background: var(--surface); border-top: 1px solid var(--line); }
.xbg-sf__acts { display: flex; gap: var(--s-3); padding: var(--s-3) var(--s-4); }
.xbg-sf__acts .btn { flex: 1; }
.xbg-sf__acts .btn--primary { flex: 1.3; }
.xbg-sf__pad { position: relative; display: grid; place-items: center; height: var(--pad, 34px); overflow: hidden; transition: height var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
.xbg-sf__pad i { width: 120px; height: 4px; border-radius: 2px; background: color-mix(in srgb, var(--ink) 30%, transparent); }
.xbg-sf__pad span { position: absolute; left: var(--s-4); top: 50%; transform: translateY(-50%); font-size: var(--fs-xs); font-weight: 600; color: var(--action-press); opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
.xbg-sf[data-mode="off"] { --pad: 0px; }
.xbg-sf[data-mode="mark"] .xbg-sf__pad { background: var(--action-soft); box-shadow: inset 0 1px 0 var(--action-edge); }
.xbg-sf[data-mode="mark"] .xbg-sf__pad span { opacity: 1; }

/* 横滑边缘渐隐：遮罩随滚动位置显隐 */
@property --xbg-fl { syntax: '<length>'; inherits: false; initial-value: 0px; }
@property --xbg-fr { syntax: '<length>'; inherits: false; initial-value: 0px; }
.xbg-fd { display: grid; gap: var(--s-4); width: 100%; max-width: 390px; margin: 0 auto; padding: var(--s-4) 0; overflow: hidden; }
.xbg-fd__sc { --xbg-fl: 0px; --xbg-fr: 0px; -webkit-mask-image: linear-gradient(90deg, transparent 0, var(--ink) var(--xbg-fl), var(--ink) calc(100% - var(--xbg-fr)), transparent 100%); mask-image: linear-gradient(90deg, transparent 0, var(--ink) var(--xbg-fl), var(--ink) calc(100% - var(--xbg-fr)), transparent 100%); transition: --xbg-fl var(--dur-base) var(--ease-out), --xbg-fr var(--dur-base) var(--ease-out); cursor: grab; }
.xbg-fd__sc.has-l { --xbg-fl: 36px; }
.xbg-fd__sc.has-r { --xbg-fr: 36px; }
.xbg-fd__sc.is-drag { cursor: grabbing; scroll-snap-type: none; }
.xbg-fd .seg { padding: 2px var(--s-4); }
.xbg-fd .seg__item[aria-pressed="true"] { background: var(--action); color: var(--surface); font-weight: 600; }
.xbg-fd__row { display: flex; gap: var(--s-3); padding: 2px var(--s-4); overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: var(--s-4); }
.xbg-fd__row::-webkit-scrollbar { display: none; }
.xbg-fd__it { flex: none; display: grid; gap: 4px; width: 116px; text-align: left; scroll-snap-align: start; }
.xbg-fd__it img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-md); pointer-events: none; }
.xbg-fd__it b { font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); }

/* 页面水印层：画布生成平铺图，叠在内容之上并放行点击 */
.xbg-wm { display: grid; justify-items: center; gap: var(--s-3); }
.xbg-wm__page { position: relative; display: grid; gap: var(--s-3); width: 100%; max-width: 390px; padding: var(--s-4); overflow: hidden; }
.xbg-wm__layer { position: absolute; inset: 0; z-index: 2; pointer-events: none; background-repeat: repeat; transition: opacity var(--dur-base) var(--ease-out); }
.xbg-wm[data-mode="off"] .xbg-wm__layer { opacity: 0; }
.xbg-wm__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xbg-wm__head b { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
.xbg-wm__kv { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 32px; font-size: var(--fs-sm); color: var(--ink-2); }
.xbg-wm__kv b { font-weight: 600; color: var(--ink); text-align: right; }
.xbg-wm__kv .btn--text { min-height: 28px; padding: 0 var(--s-1); }
.xbg-wm__phone { display: inline-flex; align-items: center; gap: var(--s-1); }
.xbg-wm__acts { display: flex; gap: var(--s-2); padding-top: var(--s-1); }
</style>

