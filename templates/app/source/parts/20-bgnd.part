    <div class="xbg-page"><button class="btn btn--secondary" data-open-scrim>取消订单</button></div>
    <div class="xbg-scrim is-on"><div class="card"><b class="dialog__title">确认取消订单</b><div class="btn-group"><button class="btn btn--ghost btn--sm" data-close-scrim>再想想</button><button class="btn btn--danger btn--sm" data-close-scrim>确认取消</button></div></div></div>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  $$('[data-xbg-t]').forEach(b => b.addEventListener('click', () => Lz.toast(b.dataset.xbgT, 'success')));
  $$('[data-xbg-bar] button').forEach(b => b.addEventListener('click', () => $$('[data-xbg-bar] button').forEach(x => x === b ? x.setAttribute('aria-current', 'page') : x.removeAttribute('aria-current'))));
  $$('[data-xbg-scrim]').forEach(m => {
    const scrim = $('.xbg-scrim', m), open = $('[data-open-scrim]', m);
    open.addEventListener('click', () => { scrim.classList.add('is-on'); $('[data-close-scrim]', m).focus(); });
    $$('[data-close-scrim]', m).forEach(b => b.addEventListener('click', () => { scrim.classList.remove('is-on'); open.focus(); }));
    scrim.addEventListener('click', e => { if (e.target === scrim) { scrim.classList.remove('is-on'); open.focus(); } });
    m.addEventListener('keydown', e => { if (e.key === 'Escape') { scrim.classList.remove('is-on'); open.focus(); } });
  });
})();
</script>

