<!-- cat: BGND | 背景 -->
<style>
/* 背景分类：前缀 xbg-。每个小样都是真实排了标题与内容的块，用来检验底色与文字的叠加效果 */
.xbg-s { position: relative; display: grid; align-content: space-between; gap: var(--s-3); width: 100%; max-width: 390px; min-height: 184px; margin: 0 auto; padding: var(--s-5); border-radius: var(--r-lg); overflow: hidden; }
.xbg-s h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
.xbg-edge { box-shadow: inset 0 0 0 1px var(--line-strong); }
.xbg-flush { padding: 0; align-content: stretch; gap: 0; }
.xbg-flush.xbg-edge { box-shadow: none; border: 1px solid var(--line-strong); }
.xbg-s--sm { min-height: 152px; }
.xbg-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xbg-foot .btn--text { margin-right: calc(var(--s-2) * -1); }
.xbg-head { display: flex; align-items: center; gap: var(--s-3); }
.xbg-head img.ic { flex: none; }
.xbg-tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
.xbg-s .tag[data-tone="action"] { background: var(--surface); }
.xbg-light { color: var(--surface); }
.xbg-light .tag { background: color-mix(in srgb, var(--ink) 26%, transparent); color: var(--surface); }
.xbg-light .btn--primary, .xbg-s .btn--primary { color: var(--surface); }
.xbg-veil.veil-tint::before { background: linear-gradient(180deg, color-mix(in srgb, var(--action-press) 88%, transparent) 0%, color-mix(in srgb, var(--action) 58%, transparent) 100%); }
.xbg-chip { display: inline-flex; align-items: baseline; gap: var(--s-1); padding: var(--s-1) var(--s-3); border-radius: var(--r-full); background: var(--surface); box-shadow: var(--elev-1); }
.xbg-chip .t-sub { font-weight: 400; }
.xbg-deep { background: linear-gradient(160deg, var(--action-press) 0%, color-mix(in srgb, var(--action-press) 72%, var(--action)) 100%); }
.xbg-num { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.xbg-num small { margin-left: 2px; font-size: var(--fs-sm); font-weight: 600; }
.xbg-cap { margin-bottom: var(--s-1); font-size: var(--fs-sm); }

/* 小商品卡：用在页底与分区的小样里 */
.xbg-two { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
.xbg-mini { display: grid; gap: 4px; padding: var(--s-2); overflow: hidden; }
.xbg-mini img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-md); }
.xbg-mini b { padding: 0 var(--s-1); font-weight: 600; line-height: var(--lh-tight); }
.xbg-mini .price { padding: 0 var(--s-1) var(--s-1); }

/* 图片类：照片上只放白卡或加遮罩，文字不直接压在花朵上 */
.xbg-plate { display: flex; align-items: center; gap: var(--s-3); width: 64%; padding: var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-2); }
.xbg-plate img { width: 56px; height: 56px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xbg-plate b { display: block; font-weight: 600; line-height: var(--lh-tight); }
.xbg-scene { background-position: 82% center; }
.xbg-scene .xbg-copy { max-width: 56%; }
.xbg-copy { display: grid; gap: var(--s-3); justify-items: start; }

/* 分区带 */
.xbg-band { padding: var(--s-4); }
.xbg-band + .xbg-band { border-top: 1px solid var(--line); }
.xbg-band h3 { font-size: var(--fs-lg); font-weight: 600; margin-bottom: var(--s-3); }
.xbg-ents { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-2); text-align: center; font-size: var(--fs-sm); }
.xbg-ents span { display: grid; justify-items: center; gap: var(--s-1); }
.xbg-ents img { width: 40px; height: 40px; object-fit: contain; }

/* 卡内浅色底 */
.xbg-inset { display: grid; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-radius: var(--r-md); }
.xbg-kv { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); }
.xbg-kv b { font-weight: 600; color: var(--ink); }

/* 底栏与叠卡与遮罩的框 */
.xbg-mock { position: relative; width: 100%; max-width: 390px; height: 232px; margin: 0 auto; border-radius: var(--r-lg); overflow: hidden; }
.xbg-mock--fit { height: auto; }
.xbg-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); padding: var(--s-4); }
.xbg-pad img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-md); }
.xbg-bar { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-1); padding: var(--s-1) var(--s-2) var(--s-2); background: var(--bg); border-top: 1px solid var(--line); }
.xbg-bar button { display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 56px; border-radius: var(--r-lg); font-size: var(--fs-xs); color: var(--ink-2); }
.xbg-bar button img { width: 26px; height: 26px; }
.xbg-bar button[aria-current="page"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; box-shadow: inset 0 0 0 1px var(--action-edge); }
.xbg-over { padding: var(--s-4) var(--s-5) 0; }
.xbg-top { position: relative; height: 128px; padding: var(--s-5) var(--s-5) 0; }
.xbg-top h3 { font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); }
.xbg-lap { position: relative; margin: -30px var(--s-4) var(--s-4); }
.xbg-lap .stats { padding: var(--s-1) 0; }
.xbg-scrim { position: absolute; inset: 0; display: grid; place-items: center; background: var(--scrim); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
.xbg-scrim.is-on { opacity: 1; pointer-events: auto; }
.xbg-scrim .card { display: grid; gap: var(--s-3); justify-items: center; width: 220px; padding: var(--s-5); text-align: center; box-shadow: var(--elev-4); transform: scale(.94); transition: transform var(--dur-base) var(--ease-spring); }
.xbg-scrim.is-on .card { transform: none; }
.xbg-page { display: grid; justify-items: start; gap: var(--s-3); padding: 0 var(--s-4) var(--s-4); }
</style>

<article class="demo" data-cid="AP-BGND-001" data-name="页底米白" data-cat="BGND">
