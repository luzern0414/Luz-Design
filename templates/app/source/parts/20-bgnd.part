<article class="demo" data-cid="AP-BGND-032" data-name="页面水印层" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">页面水印层</span></div>
  <p class="demo__note">适合：员工端防泄露，水印文字为账号尾号</p>
  <div class="demo__stage is-plain"><div class="xbg-wm" data-xbg-wm data-mode="std" data-text="账号尾号 6620">
    <div class="seg seg--box" data-seg="xbg-wm" aria-label="水印密度"><button class="seg__item" data-key="off" aria-selected="false">无</button><button class="seg__item" data-key="std" aria-selected="true">标准</button><button class="seg__item" data-key="dense" aria-selected="false">密集</button></div>
    <div class="card xbg-wm__page">
      <div class="xbg-wm__head"><b>订单 8820</b><span class="tag" data-tone="info">待发货</span></div>
      <div class="xbg-wm__kv"><span>客户</span><b>林**</b></div>
      <div class="xbg-wm__kv"><span>手机号</span><span class="xbg-wm__phone"><b data-wm-phone>138 **** 6620</b> <button class="btn btn--text" aria-pressed="false" data-wm-eye>查看</button></span></div>
      <div class="xbg-wm__kv"><span>收货地址</span><b class="one-line">浦东新区世纪大道 88 号</b></div>
      <div class="xbg-wm__kv"><span>订单金额</span><span class="price"><small>¥</small>288</span></div>
      <div class="xbg-wm__acts"><button class="btn btn--outline btn--sm" data-xbg-t="已打印面单">打印面单</button><button class="btn btn--primary btn--sm" data-wm-export>导出订单</button></div>
      <div class="xbg-wm__layer" aria-hidden="true"></div>
    </div>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];

  /* 底部安全区垫：无 留出 标出 三档，底栏底色一直延伸到屏幕底 */
  $$('[data-xbg-safe]').forEach(w => w.addEventListener('lz:seg', e => { w.dataset.mode = e.detail.key; }));

  /* 横滑边缘渐隐：左右遮罩按滚动位置显隐，鼠标可按住拖动 */
  $$('[data-xbg-fade]').forEach(sc => {
    const sync = () => { sc.classList.toggle('has-l', sc.scrollLeft > 2); sc.classList.toggle('has-r', sc.scrollLeft + sc.clientWidth < sc.scrollWidth - 2); };
    sc.addEventListener('scroll', sync, { passive: true }); new ResizeObserver(sync).observe(sc); sync();
    let d = null, moved = false;
    sc.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse') { d = { x: e.clientX, l: sc.scrollLeft, id: e.pointerId }; moved = false; } });
    sc.addEventListener('pointermove', e => {
      if (!d) return; const dx = e.clientX - d.x;
      if (!moved && Math.abs(dx) > 4) { moved = true; sc.classList.add('is-drag'); sc.setPointerCapture(d.id); }
      if (moved) sc.scrollLeft = d.l - dx;
    });
    const end = () => { d = null; sc.classList.remove('is-drag'); setTimeout(() => { moved = false; }, 0); };
    sc.addEventListener('pointerup', end); sc.addEventListener('pointercancel', end);
    sc.addEventListener('click', e => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    if (sc.hasAttribute('data-xbg-chips')) $$('button', sc).forEach(b => b.addEventListener('click', () => $$('button', sc).forEach(x => x.setAttribute('aria-pressed', String(x === b)))));
  });

  /* 页面水印层：用画布画一块带角度的文字平铺，颜色取令牌，主题变化后重画 */
  $$('[data-xbg-wm]').forEach(w => {
    const layer = $('.xbg-wm__layer', w), text = w.dataset.text, tint = document.createElement('i');
    tint.style.cssText = 'position:absolute;width:0;height:0;color:var(--ink)'; w.appendChild(tint);
    const draw = () => {
      const dense = w.dataset.mode === 'dense', tw = dense ? 124 : 168, th = dense ? 76 : 104, dpr = Math.max(2, devicePixelRatio || 1);
      const c = document.createElement('canvas'); c.width = tw * dpr; c.height = th * dpr; const x = c.getContext('2d');
      x.scale(dpr, dpr); x.translate(tw / 2, th / 2); x.rotate(-Math.PI / 9); x.globalAlpha = .16; x.fillStyle = getComputedStyle(tint).color;
      x.font = `600 ${dense ? 12 : 14}px ${getComputedStyle(document.body).fontFamily}`; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText(text, 0, 0);
      layer.style.backgroundImage = `url(${c.toDataURL()})`; layer.style.backgroundSize = `${tw}px ${th}px`;
    };
    w.addEventListener('lz:seg', e => { w.dataset.mode = e.detail.key; if (e.detail.key !== 'off') draw(); });
    document.addEventListener('lz:skin', draw); draw();
    const eye = $('[data-wm-eye]', w), phone = $('[data-wm-phone]', w);
    eye.addEventListener('click', () => { const on = eye.getAttribute('aria-pressed') !== 'true'; eye.setAttribute('aria-pressed', String(on)); eye.textContent = on ? '隐藏' : '查看'; phone.textContent = on ? '13800006620' : '138 **** 6620'; });
    $('[data-wm-export]', w).addEventListener('click', () => Lz.toast('已记录导出 账号尾号 6620', 'success'));
  });
})();
</script>
