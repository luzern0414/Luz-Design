    act.addEventListener('click', () => {
      if (key === 'v') { copy('8820 0431 6620'); Lz.toast('券码已复制', 'success'); }
      if (key === 'm') { nonce += 1; left = 60; paintNote(); draw(); Lz.toast('会员码已刷新', 'success'); }
    });
    setInterval(() => { if (key !== 'm') return; left -= 1; if (left <= 0) { nonce += 1; left = 60; draw(); } paintNote(); }, 1000);
    document.addEventListener('lz:skin', draw);
    show('v');
  });

  /* 多图横滑浏览卡：居中项放大，两侧缩小露边；点邻图或圆点居中，方向键翻页 */
  $$('[data-xcard-cr]').forEach(c => {
    const tr = $('.xcard-cr__track', c), its = $$('.xcard-cr__it', c), dots = $$('.xcard-cr__dot', c); let cur = 1, raf = 0;
    const centerOf = i => its[i].offsetLeft + its[i].offsetWidth / 2 - tr.clientWidth / 2;
    const paint = () => {
      raf = 0; const mid = tr.scrollLeft + tr.clientWidth / 2; let best = 0, bd = 1e9;
      its.forEach((it, i) => { const dd = Math.abs(it.offsetLeft + it.offsetWidth / 2 - mid), t = Math.min(1, dd / (it.offsetWidth + 8)); it.style.transform = `scale(${(1 - .14 * t).toFixed(3)})`; it.style.opacity = (1 - .22 * t).toFixed(3); if (dd < bd) { bd = dd; best = i; } });
      cur = best; dots.forEach((d, i) => d.setAttribute('aria-current', String(i === best)));
