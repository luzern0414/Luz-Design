    const DUR = +v.dataset.dur, frames = v.dataset.frames.split('|'), RATES = [1, 1.5, 2];
    const img = $('[data-vd-img]', v), big = $('[data-vd-big]', v), pp = $('[data-vd-pp]', v), bar = $('[data-vd-bar]', v), time = $('[data-vd-time]', v), rate = $('[data-vd-rate]', v);
    const ICON = n => `../../kit/assets/line/${n}.webp`; frames.forEach(f => { new Image().src = `../../kit/assets/photo/${f}.webp`; });
    let t = 0, state = 'ready', ri = 0, last = -1;
