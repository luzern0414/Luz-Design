<article class="demo" data-cid="AP-CARD-051" data-name="文章阅读排版" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">文章阅读排版</span></div>
  <p class="demo__note">适合：图文资讯详情的标题、正文与插图排版</p>
  <div class="demo__stage"><div class="card xcard-ar xcard-w" data-xcard-ar data-size="md">
    <div class="xcard-ar__prog"><i></i></div>
    <div class="xcard-ar__sc" tabindex="0" role="region" aria-label="文章正文" data-ar-sc>
      <h3 class="xcard-ar__title">雨季绿植养护要点</h3>
      <div class="xcard-ar__by"><img class="avatar" src="../../kit/assets/marks/mark-005.webp" alt=""><b>花间集编辑部</b><span>阅读 2.3 万</span><span>3 分钟读完</span></div>
      <img class="xcard-ar__cover" src="../../kit/assets/photo/bg-green.webp" alt="">
      <p>雨季空气湿度高，盆土不易变干，绿植最常见的问题不是缺水，而是积水烂根。养护的重点是少浇水、勤通风、多见光。</p>
      <h4>控制浇水量</h4>
      <p>浇水前先用手指探入盆土两厘米，干透再浇。叶片厚实的龟背竹与多肉，一周一次即可。</p>
      <blockquote>雨季养花 少浇水比多浇水更重要</blockquote>
      <figure><img src="../../kit/assets/photo/product-monstera.webp" alt=""><figcaption>放在通风窗边的龟背竹</figcaption></figure>
      <h4>加强通风</h4>
      <p>连续阴雨时，每天开窗通风半小时，避免叶面长期潮湿滋生霉点。</p>
      <ul><li>盆底垫高，保持排水孔通畅</li><li>叶片积水用纸巾轻轻吸干</li><li>发现黄叶及时剪除</li></ul>
      <h4>合理摆放</h4>
      <p>耐阴的绿植放在明亮的散射光处，喜光的多肉在雨停后搬到窗边补光。</p>
    </div>
    <div class="xcard-ar__bar"><div class="xcard-ar__size"><span>字号</span><div class="btn-seg" role="group" aria-label="字号"><button aria-pressed="false" data-k="sm">小</button><button aria-pressed="true" data-k="md">中</button><button aria-pressed="false" data-k="lg">大</button></div></div><button class="xcard-like" aria-label="点赞" aria-pressed="false" data-ar-like><img data-ic="heart" src="../../kit/assets/icons/flat/heart.webp" alt=""><span>328</span></button></div>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];

  /* 二维码：字节模式、纠错等级 M、版本 1 至 3，单块数据；返回模块矩阵（true 为深色） */
  const qrMatrix = text => {
    const bytes = [...new TextEncoder().encode(text)];
    const SPEC = [null, { d: 16, e: 10 }, { d: 28, e: 16 }, { d: 44, e: 26 }];
    const ver = [1, 2, 3].find(v => bytes.length <= SPEC[v].d - 2); if (!ver) throw new Error('内容过长');
    const { d: DATA, e: ECN } = SPEC[ver], size = 17 + 4 * ver;
    const bits = []; const put = (v, n) => { for (let i = n - 1; i >= 0; i--) bits.push((v >>> i) & 1); };
    put(4, 4); put(bytes.length, 8); bytes.forEach(b => put(b, 8));
    for (let i = 0; i < 4 && bits.length < DATA * 8; i++) bits.push(0);
    while (bits.length % 8) bits.push(0);
    const words = []; for (let i = 0; i < bits.length; i += 8) words.push(parseInt(bits.slice(i, i + 8).join(''), 2));
    for (let p = 0xec; words.length < DATA; p ^= 0xec ^ 0x11) words.push(p);
    const EXP = [], LOG = []; let x = 1; for (let i = 0; i < 255; i++) { EXP[i] = x; LOG[x] = i; x <<= 1; if (x & 256) x ^= 0x11d; } for (let i = 255; i < 512; i++) EXP[i] = EXP[i - 255];
    const mul = (a, b) => (a && b ? EXP[LOG[a] + LOG[b]] : 0);
    let g = [1]; for (let i = 0; i < ECN; i++) { const n = new Array(g.length + 1).fill(0); g.forEach((c, j) => { n[j] ^= c; n[j + 1] ^= mul(c, EXP[i]); }); g = n; }
    const rem = new Array(ECN).fill(0); words.forEach(b => { const f = b ^ rem.shift(); rem.push(0); g.slice(1).forEach((c, i) => { rem[i] ^= mul(c, f); }); });
    const all = words.concat(rem);
    const data = []; all.forEach(w => { for (let i = 7; i >= 0; i--) data.push((w >>> i) & 1); });
    const m = Array.from({ length: size }, () => new Array(size).fill(false)), fn = Array.from({ length: size }, () => new Array(size).fill(false));
    const set = (cx, cy, v) => { m[cy][cx] = v; fn[cy][cx] = true; };
    const finder = (cx, cy) => { for (let dy = -4; dy <= 4; dy++) for (let dx = -4; dx <= 4; dx++) { const xx = cx + dx, yy = cy + dy; if (xx < 0 || yy < 0 || xx >= size || yy >= size) continue; const r = Math.max(Math.abs(dx), Math.abs(dy)); set(xx, yy, r !== 2 && r !== 4); } };
    finder(3, 3); finder(size - 4, 3); finder(3, size - 4);
    for (let i = 8; i < size - 8; i++) { set(6, i, i % 2 === 0); set(i, 6, i % 2 === 0); }
    if (ver >= 2) { const c = size - 7; for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) set(c + dx, c + dy, Math.max(Math.abs(dx), Math.abs(dy)) !== 1); }
    for (let i = 0; i < 9; i++) { fn[8][i] = true; fn[i][8] = true; } for (let i = 0; i < 8; i++) { fn[8][size - 1 - i] = true; fn[size - 1 - i][8] = true; }
    set(8, size - 8, true);
    let k = 0;
    for (let right = size - 1; right >= 1; right -= 2) {
      if (right === 6) right = 5;
      for (let v = 0; v < size; v++) for (let j = 0; j < 2; j++) {
        const cx = right - j, up = ((right + 1) & 2) === 0, cy = up ? size - 1 - v : v;
        if (!fn[cy][cx]) { m[cy][cx] = k < data.length ? data[k] === 1 : false; k++; }
      }
    }
    const MASK = [(r, c) => (r + c) % 2 === 0, r => r % 2 === 0, (r, c) => c % 3 === 0, (r, c) => (r + c) % 3 === 0, (r, c) => (Math.floor(r / 2) + Math.floor(c / 3)) % 2 === 0, (r, c) => ((r * c) % 2) + ((r * c) % 3) === 0, (r, c) => (((r * c) % 2) + ((r * c) % 3)) % 2 === 0, (r, c) => (((r + c) % 2) + ((r * c) % 3)) % 2 === 0];
    const formatBits = mask => { const d5 = (0 << 3) | mask; let r = d5 << 10; for (let i = 4; i >= 0; i--) if ((r >>> (i + 10)) & 1) r ^= 0x537 << i; return ((d5 << 10) | r) ^ 0x5412; };
    const build = mask => {
      const q = m.map(row => row.slice()), fb = formatBits(mask), bit = i => ((fb >>> i) & 1) === 1, sf = (cx, cy, v) => { q[cy][cx] = v; };
      for (let r = 0; r < size; r++) for (let c = 0; c < size; c++) if (!fn[r][c] && MASK[mask](r, c)) q[r][c] = !q[r][c];
      for (let i = 0; i <= 5; i++) sf(8, i, bit(i)); sf(8, 7, bit(6)); sf(8, 8, bit(7)); sf(7, 8, bit(8)); for (let i = 9; i < 15; i++) sf(14 - i, 8, bit(i));
      for (let i = 0; i < 8; i++) sf(size - 1 - i, 8, bit(i)); for (let i = 8; i < 15; i++) sf(8, size - 15 + i, bit(i));
      return q;
    };
    const penalty = q => {
      let p = 0; const line = a => { let run = 1; for (let i = 1; i < a.length; i++) { if (a[i] === a[i - 1]) { run++; if (run === 5) p += 3; else if (run > 5) p++; } else run = 1; } const s = a.map(v => (v ? 1 : 0)).join(''); [/10111010000/g, /00001011101/g].forEach(re => { p += 40 * (s.match(re) || []).length; }); };
      for (let i = 0; i < size; i++) { line(q[i]); line(q.map(row => row[i])); }
      for (let r = 0; r < size - 1; r++) for (let c = 0; c < size - 1; c++) if (q[r][c] === q[r][c + 1] && q[r][c] === q[r + 1][c] && q[r][c] === q[r + 1][c + 1]) p += 3;
      const dark = q.flat().filter(Boolean).length; p += Math.floor(Math.abs(dark * 20 - size * size * 10) / (size * size)) * 10; return p;
    };
    let best = null, bp = 1e9; for (let mk = 0; mk < 8; mk++) { const q = build(mk), p = penalty(q); if (p < bp) { bp = p; best = q; } }
    return best;
  };

  const mm = s => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const copy = t => { try { navigator.clipboard.writeText(t).catch(() => {}); } catch (e) { /* 无剪贴板权限时仍给出提示 */ } };
  const cssColor = name => { const t = document.createElement('i'); t.style.color = `var(${name})`; document.body.appendChild(t); const c = getComputedStyle(t).color; t.remove(); return c; };
