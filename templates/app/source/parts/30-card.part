  /* 二维码核销卡：三种码，真实可扫；会员码按秒刷新，取货码已核销时盖章 */
  $$('[data-xcard-qr]').forEach(c => {
    const cv = $('canvas', c), name = $('[data-qr-name]', c), meta = $('[data-qr-meta]', c), tag = $('[data-qr-tag]', c), code = $('[data-qr-code]', c), note = $('[data-qr-note]', c), act = $('[data-qr-act]', c);
    let nonce = 7, left = 60, key = 'v';
    const TABS = {
      v: { name: '春日花束核销券', meta: '建国路店 到店出示', tone: 'success', tag: '未核销', pay: () => 'HJ-V-8820-0431-6620', code: '8820 0431 6620', note: '7 天内有效', act: '复制券码', state: 'ok' },
      m: { name: '金卡会员码', meta: '林晓', tone: 'gold', tag: '金卡会员', pay: () => `HJ-M-3280-6620-${nonce}`, code: '会员号 6620', note: '', act: '立即刷新', state: 'ok' },
      p: { name: '同城急送取货码', meta: '建国路店 红玫瑰花束', tone: 'info', tag: '已核销', pay: () => 'HJ-P-5830-1647', code: '5830 1647', note: '10:32 已取货', act: '已取货', state: 'used' }
    };
    const draw = () => {
      const q = qrMatrix(TABS[key].pay()), n = q.length, quiet = 2, dpr = Math.max(1, devicePixelRatio || 1), ms = Math.max(2, Math.floor(168 * dpr / (n + quiet * 2))), px = ms * (n + quiet * 2);
      cv.width = cv.height = px; cv.style.width = cv.style.height = (px / dpr) + 'px';
      const x = cv.getContext('2d'); x.fillStyle = cssColor('--surface'); x.fillRect(0, 0, px, px); x.fillStyle = cssColor('--ink');
      q.forEach((row, r) => row.forEach((v, cc) => { if (v) x.fillRect((cc + quiet) * ms, (r + quiet) * ms, ms, ms); }));
      cv.setAttribute('aria-label', `${TABS[key].name}二维码`);
    };
