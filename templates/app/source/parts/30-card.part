<!-- cat: CARD | 卡片 -->
<style>
/* 卡片分类：前缀 xcard-。白底大圆角卡为基础，变体来自 kit.css 的 .card--*，这里补各业务卡的内部排版 */
.xcard-w { width: 100%; max-width: 390px; margin: 0 auto; }
.xcard-col { display: grid; gap: var(--s-3); }
.xcard-was { font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); text-decoration: line-through; font-variant-numeric: tabular-nums; }
.xcard-big { font-size: var(--fs-xl); font-weight: 700; line-height: 1; }
.demo[data-cat="CARD"] .btn--primary:not([disabled]) { color: var(--surface); }
.xcard-gap { display: flex; align-items: center; gap: var(--s-2); }
.xcard-between { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xcard-name { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.xcard-meta { font-size: var(--fs-sm); color: var(--ink-3); }

/* 收藏心形：未选为灰，选中为彩色 */
.xcard-fav { width: 36px; height: 36px; border: 0; box-shadow: var(--elev-1); }
.xcard-fav img { width: 20px; height: 20px; filter: grayscale(1) opacity(.5); transition: filter var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xcard-fav[aria-pressed="true"] img { filter: none; transform: scale(1.12); }

/* 数量步进（紧凑） */
.xcard-step { display: inline-flex; align-items: center; padding: 2px; border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); }
.xcard-step button { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; }
.xcard-step__p { background: var(--action-tint); }
.xcard-step__p img { width: 14px; height: 14px; }
.xcard-step__m::before { content: ""; width: 12px; height: 2px; border-radius: 1px; background: var(--ink); }
.xcard-step b { min-width: 28px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }

/* 商品卡 */
.xcard-v { width: 196px; margin: 0 auto; overflow: hidden; }
.xcard-v .card__media { aspect-ratio: 1; }
.xcard-v .card__fav, .xcard-sq .card__fav { top: var(--s-2); right: var(--s-2); }
.xcard-body { display: grid; gap: var(--s-1); padding: var(--s-3); }
.xcard-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: var(--s-1); }
.xcard-h { display: flex; gap: var(--s-3); padding: var(--s-3); }
.xcard-h > img { width: 104px; height: 104px; border-radius: var(--r-md); object-fit: cover; flex: none; background: var(--zone); }
.xcard-h__main { flex: 1; min-width: 0; display: grid; gap: var(--s-1); align-content: space-between; }
.xcard-tags { display: flex; flex-wrap: wrap; gap: var(--s-1); }
.xcard-masonry { columns: 2; column-gap: var(--s-3); }
.xcard-masonry .card { break-inside: avoid; margin-bottom: var(--s-3); overflow: hidden; }
.xcard-masonry img { width: 100%; object-fit: cover; background: var(--zone); }
.xcard-sq { overflow: hidden; width: 232px; margin: 0 auto; }
.xcard-sq .card__media { aspect-ratio: 1; }
.xcard-sq .card__corner { display: flex; gap: var(--s-1); }
.xcard-sq .xcard-bl { position: absolute; left: var(--s-2); bottom: var(--s-2); }
.xcard-chip { display: inline-flex; align-items: center; height: 24px; padding: 0 var(--s-2); border-radius: var(--r-full); background: var(--surface); box-shadow: var(--elev-1); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); }

/* 限时抢购 */
.xcard-flash__head { display: flex; align-items: center; justify-content: space-between; padding: var(--s-2) var(--s-4); background: var(--price-tint); color: var(--price); border-radius: var(--r-lg) var(--r-lg) 0 0; font-size: var(--fs-sm); font-weight: 600; }
.xcard-cd { display: inline-flex; align-items: center; gap: 3px; font-variant-numeric: tabular-nums; }
.xcard-cd b { display: inline-grid; place-items: center; min-width: 24px; height: 22px; border-radius: 6px; background: var(--price); color: var(--surface); font-size: var(--fs-xs); font-weight: 700; }
.xcard-cd i { font-style: normal; font-weight: 700; }
.xcard-prog { height: 8px; background: var(--price-tint); }
.xcard-prog > i { background: linear-gradient(90deg, color-mix(in srgb, var(--price) 62%, var(--surface)), var(--price)); }

/* 拼团 */
.xcard-slot { display: grid; place-items: center; width: 32px; height: 32px; margin-left: -8px; border-radius: 50%; border: 1.5px dashed var(--line-strong); background: var(--surface); }
.xcard-slot img { width: 14px; height: 14px; opacity: .6; }

/* 套餐 */
.xcard-bundle { display: flex; align-items: center; justify-content: center; gap: var(--s-2); padding: var(--s-4) var(--s-4) var(--s-3); }
.xcard-bundle > img:not(.xcard-plus) { flex: 1 1 0; min-width: 0; max-width: 84px; aspect-ratio: 1; height: auto; border-radius: var(--r-md); object-fit: cover; background: var(--zone); }
.xcard-plus { width: 16px; height: 16px; flex: none; opacity: .55; }
.xcard-nw { white-space: nowrap; }
.xcard-bundle__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }

/* 加购条与收藏行 */
.xcard-addbar { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3); }
.xcard-addbar > img { width: 64px; height: 64px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xcard-addbar__main { flex: 1; min-width: 0; display: grid; gap: 2px; }
.xcard-addslot { min-width: 96px; display: flex; justify-content: flex-end; }
.xcard-fl { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3); transition: opacity var(--dur-base) var(--ease-out); }
.xcard-fl > img:first-child { width: 88px; height: 88px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xcard-fl.is-off { opacity: .55; }
.xcard-fl__main { flex: 1; min-width: 0; display: grid; gap: var(--s-1); }

/* 优惠券 */
.xcard-cp { display: grid; grid-template-columns: 104px 1fr auto; align-items: center; column-gap: var(--s-3); padding: var(--s-4) var(--s-4) var(--s-4) 0; overflow: hidden; }
.xcard-cp__l { display: grid; justify-items: center; gap: 2px; align-self: stretch; align-content: center; border-right: 1.5px dashed var(--line-strong); padding: 0 var(--s-2) 0 var(--s-4); }
.xcard-cp__amt { font-size: var(--fs-2xl); font-weight: 700; line-height: 1; }
.xcard-cp__amt small { font-size: var(--fs-sm); font-weight: 600; margin-right: 1px; }
.xcard-cp__cond { font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-cp__main { display: grid; gap: 2px; min-width: 0; }
.xcard-cp2 { display: grid; grid-template-columns: 112px 1fr; overflow: hidden; }
.xcard-cp2__l { display: grid; justify-items: center; align-content: center; gap: 2px; padding: var(--s-4) var(--s-2); background: var(--price-tint); color: var(--price); border-right: 1.5px dashed color-mix(in srgb, var(--price) 30%, transparent); }
.xcard-cp2__l .xcard-cp__cond { color: var(--price); }
.xcard-cp2__r { display: grid; gap: var(--s-2); padding: var(--s-3) var(--s-4); align-content: center; }
.xcard-cp3 { display: grid; grid-template-columns: 112px 1fr auto; align-items: center; column-gap: var(--s-3); padding: var(--s-4) var(--s-4) var(--s-4) 0; }
.xcard-cp3__l { display: grid; justify-items: center; gap: 2px; align-self: stretch; align-content: center; border-right: 1px solid color-mix(in srgb, var(--accent) 24%, transparent); color: var(--accent); }
.xcard-cp3__l .xcard-cp__cond { color: var(--accent); }
.xcard-gift { display: grid; gap: var(--s-4); padding: var(--s-5); }
.xcard-gift__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
.xcard-gift__top img { width: 64px; height: 64px; object-fit: contain; filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--ink) 25%, transparent)); }
.xcard-gift__val { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.xcard-gift__val small { font-size: var(--fs-md); margin-right: 2px; }
.xcard-gift__code { font-size: var(--fs-sm); letter-spacing: .08em; font-variant-numeric: tabular-nums; }
.xcard-gift .btn--text { color: var(--ink); }
.xcard-tri { display: grid; grid-template-columns: 76px 1fr auto; align-items: center; column-gap: var(--s-3); padding: var(--s-3) var(--s-4) var(--s-3) var(--s-4); }
.xcard-tri .xcard-cp__amt { font-size: var(--fs-xl); }
.xcard-tri.is-got .btn { background: var(--zone); color: var(--ink-3); box-shadow: none; }
.xcard-tri.is-old { background: var(--zone); border-color: transparent; box-shadow: none; }
.xcard-tri.is-old .price, .xcard-tri.is-old .xcard-name { color: var(--ink-3); text-decoration: line-through; }

/* 会员 */
.xcard-vip { display: grid; gap: var(--s-4); padding: var(--s-5); }
.xcard-vip__top { display: flex; align-items: center; gap: var(--s-3); }
.xcard-vip__top .avatar { width: 52px; height: 52px; padding: 7px; background: var(--pastel-blue-300); }
.xcard-vip__top b { display: block; font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
.xcard-vip__top .ibtn { margin-left: auto; background: var(--surface); }
.xcard-gold { background: var(--accent-tint); color: var(--accent); }
.xcard-vip .stats > * + * { border-left-color: color-mix(in srgb, var(--surface) 28%, transparent); }
.xcard-vip .stat__label, .xcard-vip .stat__val small { color: var(--ink); }
.xcard-perks { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4) var(--s-1); padding: var(--s-4) var(--s-2); }
.xcard-perk { display: grid; justify-items: center; gap: var(--s-1); font-size: var(--fs-sm); line-height: 1.2; border-radius: var(--r-md); padding: var(--s-1); transition: transform var(--dur-quick) var(--ease-out); }
.xcard-perk:active { transform: scale(.94); }
.xcard-perk img { width: 44px; height: 44px; object-fit: contain; filter: drop-shadow(0 4px 6px color-mix(in srgb, var(--ink) 12%, transparent)); }
.xcard-perk.is-lock img { filter: grayscale(1) opacity(.4); }
.xcard-perk.is-lock { color: var(--ink-3); }
.xcard-perk small { font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-grow { display: grid; gap: var(--s-4); padding: var(--s-4) var(--s-4) var(--s-5); }
.xcard-track { position: relative; padding-top: 2px; }
.xcard-track__bar { position: absolute; left: 20px; right: 20px; top: 12px; height: 6px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
.xcard-track__bar i { display: block; height: 100%; width: var(--v); border-radius: inherit; background: linear-gradient(90deg, var(--action), color-mix(in srgb, var(--action) 62%, var(--surface))); }
.xcard-track ol { position: relative; display: flex; justify-content: space-between; }
.xcard-track li { display: grid; justify-items: center; gap: var(--s-1); width: 40px; font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-track li span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--zone); box-shadow: 0 0 0 3px var(--surface); }
.xcard-track li.is-on { color: var(--ink); font-weight: 600; }
.xcard-track li.is-on span { background: var(--action); }
.xcard-track li.is-on img { width: 12px; height: 12px; filter: invert(1); }
.xcard-sign { display: grid; gap: var(--s-4); padding: var(--s-4); }
.xcard-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--s-1); }
.xcard-day { min-width: 0; display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 72px; padding: var(--s-1) 0; border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-day b { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.xcard-day img { width: 18px; height: 18px; object-fit: contain; }
.xcard-day.is-done { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
.xcard-day.is-done img.xcard-ck { filter: none; }
.xcard-day.is-now { background: var(--surface); box-shadow: inset 0 0 0 1.5px var(--action); color: var(--action-press); }
.xcard-day.is-now b { color: var(--action-press); }
.xcard-wallet { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--s-3); padding: var(--s-5); }
.xcard-wallet > img { width: 88px; height: 88px; object-fit: contain; filter: drop-shadow(0 8px 12px color-mix(in srgb, var(--ink) 16%, transparent)); }
.xcard-wallet__amt { font-size: var(--fs-3xl); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
.xcard-wallet__amt small { font-size: var(--fs-md); font-weight: 600; margin-right: 2px; }
.xcard-wallet__acts { grid-column: 1 / -1; display: flex; gap: var(--s-2); }

/* 订单与物流 */
.xcard-ord__head { display: flex; align-items: center; justify-content: space-between; padding: var(--s-3) var(--s-4); }
.xcard-ord__body { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-1) var(--s-4) var(--s-3); }
.xcard-ord__body img { width: 60px; height: 60px; border-radius: var(--r-md); object-fit: cover; background: var(--zone); }
.xcard-ord__sum { margin-left: auto; display: grid; justify-items: end; gap: 2px; }
.xcard-ord__foot { display: flex; justify-content: flex-end; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
.xcard-ship { padding: var(--s-4); display: grid; gap: var(--s-4); }
.xcard-ship__head { display: flex; align-items: center; gap: var(--s-3); }
.xcard-ship__head > img { width: 52px; height: 52px; object-fit: contain; }
.xcard-ship__head .ibtn { margin-left: auto; background: var(--action-tint); }
.xcard-ship .tl__item { padding-bottom: var(--s-3); }
.xcard-ship .tl__item:last-child { padding-bottom: 0; }
.xcard-addr { display: grid; grid-template-columns: auto 1fr auto; align-items: center; column-gap: var(--s-3); padding: var(--s-4); cursor: pointer; transition: box-shadow var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
.xcard-addr > img { width: 44px; height: 44px; object-fit: contain; }
.xcard-addr[aria-checked="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1.5px var(--action); border-color: transparent; }
.xcard-addr[aria-checked="true"] .tag { background: var(--surface); }
.xcard-addr__main { display: grid; gap: 2px; min-width: 0; }

/* 评价 */
.xcard-rv { display: grid; gap: var(--s-3); padding: var(--s-4); }
.xcard-rv__head { display: flex; align-items: center; gap: var(--s-3); }
.xcard-rv__head .avatar { width: 40px; height: 40px; padding: 5px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-stars { display: inline-flex; gap: 1px; }
.xcard-stars img { width: 16px; height: 16px; }
.xcard-stars img.is-off { filter: grayscale(1) opacity(.28); }
.xcard-rv__pics { display: flex; gap: var(--s-2); }
.xcard-rv__pics img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; }
.xcard-like { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-full); font-size: var(--fs-sm); color: var(--ink-3); }
.xcard-like img { width: 18px; height: 18px; filter: grayscale(1) opacity(.5); transition: filter var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xcard-like[aria-pressed="true"] { color: var(--price); }
.xcard-like[aria-pressed="true"] img { filter: none; transform: scale(1.15); }
.xcard-sum { display: grid; grid-template-columns: auto 1fr; gap: var(--s-5); align-items: center; padding: var(--s-4) var(--s-5); }
.xcard-sum__score { display: grid; justify-items: center; gap: var(--s-1); }
.xcard-sum__score b { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.xcard-rows { display: grid; gap: 2px; }
.xcard-row { display: grid; grid-template-columns: 36px 1fr 40px; align-items: center; gap: var(--s-2); min-height: 28px; padding: 0 var(--s-1); font-size: var(--fs-xs); color: var(--ink-2); border-radius: var(--r-sm); }
.xcard-row .progress { height: 6px; }
.xcard-row[aria-pressed="true"] { color: var(--action-press); font-weight: 600; background: var(--action-tint); }
.xcard-row span:last-child { text-align: right; font-variant-numeric: tabular-nums; }

/* 门店 */
.xcard-shop { display: flex; gap: var(--s-3); padding: var(--s-3); }
.xcard-shop > img { width: 96px; height: 120px; border-radius: var(--r-md); object-fit: cover; flex: none; background: var(--zone); }
.xcard-shop.is-closed > img { filter: grayscale(.85) opacity(.8); }
.xcard-shop__main { flex: 1; min-width: 0; display: grid; gap: var(--s-1); align-content: space-between; }
.xcard-shop__acts { display: flex; gap: var(--s-2); align-items: center; }
.xcard-shop__acts .ibtn { width: 40px; height: 40px; background: var(--action-tint); }

/* 内容卡 */
.xcard-act .card__media { aspect-ratio: 16 / 9; }
.xcard-act .card__corner { top: var(--s-3); left: var(--s-3); }
.xcard-news { display: flex; align-items: stretch; gap: var(--s-3); padding: var(--s-3); }
.xcard-news__main { flex: 1; min-width: 0; display: grid; gap: var(--s-2); align-content: space-between; }
.xcard-news > img { width: 104px; height: 88px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xcard-brand .card__media { aspect-ratio: 16 / 9; }
.xcard-brand .stats { padding: 0; }
.xcard-note { overflow: hidden; width: 224px; margin: 0 auto; }
.xcard-note > img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
.xcard-note__body { display: grid; gap: var(--s-2); padding: var(--s-3); }
.xcard-note__by { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-note__by .avatar { width: 22px; height: 22px; padding: 2px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-note__by .xcard-like { margin-left: auto; padding: 0; min-height: 28px; font-size: var(--fs-xs); }
.xcard-feat { position: relative; isolation: isolate; overflow: hidden; min-height: 300px; display: grid; align-content: end; padding: var(--s-3); background: url(../../kit/assets/photo/scene-hero-pink.webp) 80% center / cover; }
.xcard-feat .card__corner { top: var(--s-3); left: var(--s-3); }
.xcard-feat__plate { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-3); }
.xcard-feat__plate img { width: 64px; height: 64px; border-radius: var(--r-md); object-fit: cover; }
.xcard-feat__plate div { flex: 1; min-width: 0; display: grid; gap: 2px; }

/* 人与任务 */
.xcard-cus { display: grid; grid-template-columns: auto 1fr auto; align-items: center; column-gap: var(--s-3); padding: var(--s-3) var(--s-4); }
.xcard-cus .avatar { width: 52px; height: 52px; padding: 7px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-task { display: grid; gap: var(--s-3); padding: var(--s-4); }
.xcard-task__head { display: flex; align-items: center; gap: var(--s-3); }
.xcard-task__head > img { width: 44px; height: 44px; object-fit: contain; }
.xcard-task__head .tag { margin-left: auto; }
.xcard-task ul { display: grid; gap: var(--s-2); }
.xcard-task li { display: flex; align-items: center; gap: var(--s-3); min-height: 36px; font-size: var(--fs-md); cursor: pointer; }
.xcard-task li.is-done span:last-child { color: var(--ink-3); text-decoration: line-through; }
.xcard-task__foot { display: flex; align-items: center; justify-content: space-between; }
.xcard-av { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-4); }
.xcard-av .avatars .avatar { width: 40px; height: 40px; margin-left: -10px; padding: 5px; background: var(--action-tint); }
.xcard-av .avatars .avatar:first-child { margin-left: 0; }
.xcard-more { display: grid; place-items: center; width: 40px; height: 40px; margin-left: -10px; border-radius: 50%; border: 2px solid var(--surface); background: var(--action-tint); color: var(--action-press); font-size: var(--fs-xs); font-weight: 600; }
.xcard-av__main { flex: 1; min-width: 0; display: grid; gap: 2px; }

/* 通知堆叠 */
.xcard-nstack { position: relative; height: 100px; transition: height var(--dur-slow) var(--ease-out); cursor: pointer; }
.xcard-nstack.is-open { height: 248px; }
.xcard-n { position: absolute; left: 0; right: 0; top: 0; height: 74px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; column-gap: var(--s-3); padding: 0 var(--s-4); transform: translateY(var(--y)) scale(var(--s)); transform-origin: top center; z-index: var(--z); transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-base) var(--ease-out); box-shadow: var(--elev-1); }
.xcard-n:nth-child(1) { --y: 0px; --s: 1; --z: 3; }
.xcard-n:nth-child(2) { --y: 12px; --s: .95; --z: 2; opacity: .96; }
.xcard-n:nth-child(3) { --y: 24px; --s: .9; --z: 1; opacity: .9; }
.xcard-nstack.is-open .xcard-n { --s: 1; opacity: 1; }
.xcard-nstack.is-open .xcard-n:nth-child(2) { --y: 84px; }
.xcard-nstack.is-open .xcard-n:nth-child(3) { --y: 168px; }
.xcard-n > img { width: 40px; height: 40px; object-fit: contain; }
.xcard-n div { min-width: 0; display: grid; gap: 2px; }
.xcard-nbar { display: flex; justify-content: center; margin-top: var(--s-2); }
.xcard-ex__body { display: grid; gap: var(--s-2); }
.xcard-kv { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); }
.xcard-kv b { font-weight: 600; color: var(--ink); }

/* 骨架、空态、订阅、兑换 */
.xcard-skel { display: flex; gap: var(--s-3); padding: var(--s-3); }
.xcard-skel > .skel:first-child { width: 96px; height: 96px; border-radius: var(--r-md); flex: none; }
.xcard-skel__main { flex: 1; display: grid; gap: var(--s-2); align-content: center; }
.xcard-skel__main .skel { height: 14px; }
.xcard-skel__main .skel:nth-child(2) { width: 62%; }
.xcard-skel__main .skel:nth-child(3) { width: 38%; height: 18px; }
.xcard-emp { padding: var(--s-2) var(--s-4) var(--s-4); }
.xcard-emp .empty { padding: var(--s-3) var(--s-4); }
.xcard-emp .empty strong { font-size: var(--fs-lg); font-weight: 600; color: var(--ink); line-height: var(--lh-tight); }
.xcard-sub { display: grid; gap: var(--s-4); padding: var(--s-4); }
.xcard-sub__head { display: flex; align-items: center; gap: var(--s-3); }
.xcard-sub__head > img { width: 56px; height: 56px; object-fit: contain; }
.xcard-sub .btn-seg { display: flex; }
.xcard-sub .btn-seg button { flex: 1; }
.xcard-pts { display: flex; gap: var(--s-3); padding: var(--s-3); }
.xcard-pts > img { width: 96px; height: 96px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xcard-pts__main { flex: 1; min-width: 0; display: grid; gap: var(--s-1); align-content: space-between; }
.xcard-pts__cost { display: inline-flex; align-items: center; gap: var(--s-1); color: var(--accent); font-weight: 700; font-size: var(--fs-lg); font-variant-numeric: tabular-nums; }
.xcard-pts__cost img { width: 20px; height: 20px; }
.xcard-pts__cost small { font-size: var(--fs-sm); font-weight: 400; }
.demo[data-cat="CARD"] .demo__stage { container-type: inline-size; }
.xcard-cp2__r .xcard-between { flex-wrap: wrap; row-gap: var(--s-1); }
@container (max-width: 380px) { .xcard-h > img { width: 84px; height: 84px; } .xcard-cp2 { grid-template-columns: 92px minmax(0, 1fr); } .xcard-cp2__r { padding: var(--s-3); } .xcard-cp2__r .btn--text { padding: 0 var(--s-1); } .xcard-grp { flex-wrap: wrap; row-gap: var(--s-2); } .xcard-av { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; row-gap: var(--s-3); } .xcard-av .avatars { grid-row: 2; grid-column: 1 / -1; } .xcard-av__main { grid-row: 1; grid-column: 1; } .xcard-av > .btn { grid-row: 1; grid-column: 2; } }
</style>

