<article class="demo" data-cid="AP-CARD-041" data-name="积分兑换卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">积分兑换卡</span></div>
  <p class="demo__note">适合：积分商城，所需积分与库存并列，兑换先确认</p>
  <div class="demo__stage"><div class="card xcard-pts xcard-w">
    <img src="../../kit/assets/photo/product-pampas-vase.webp" alt="">
    <div class="xcard-pts__main">
      <div style="display: grid; gap: var(--s-1)"><span class="xcard-name one-line">干花花瓶摆件</span><span class="tag" data-tone="warning" style="width: fit-content">仅剩 12 件</span></div>
      <div class="xcard-between"><span class="xcard-pts__cost"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt="">1200<small>积分</small></span><button class="btn btn--accent btn--sm btn--pill" data-xcard-redeem>兑换</button></div>
    </div>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const D = id => $(`[data-cid="${id}"]`);
  const money = n => n.toLocaleString('zh-CN');

  $$('[data-xcard-t]').forEach(b => {
    b.addEventListener('click', () => Lz.toast(b.dataset.xcardT, 'success'));
    if (b.getAttribute('role') === 'button') b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); b.click(); } });
  });

  /* 收藏心形与收藏行 */
  $$('[data-xcard-fav]').forEach(b => b.addEventListener('click', e => {
    e.preventDefault();
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-label', on ? '取消收藏' : '收藏'); b.dataset.tip = on ? '取消收藏' : '收藏';
    const row = b.closest('[data-xcard-fl]'); if (row) row.classList.toggle('is-off', !on);
    Lz.toast(on ? '已收藏' : '已取消收藏', on ? 'success' : 'neutral');
  }));
  $$('[data-xcard-like]').forEach(b => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true', n = $('span', b);
    b.setAttribute('aria-pressed', String(on)); n.textContent = (+n.textContent) + (on ? 1 : -1);
  }));

  /* 限时抢购：倒计时与进度 */
  $$('[data-cd]').forEach(el => {
    let s = +el.dataset.cd; const cells = $$('b', el), pad = n => String(n).padStart(2, '0');
    const paint = () => { cells[0].textContent = pad(Math.floor(s / 3600)); cells[1].textContent = pad(Math.floor(s % 3600 / 60)); cells[2].textContent = pad(s % 60); };
    setInterval(() => { if (s > 0) { s -= 1; paint(); } }, 1000);
  });
  $$('[data-xcard-flash]').forEach(c => {
    const bar = $('.progress', c), txt = $('[data-flash-pct]', c), go = $('[data-flash-go]', c); let v = 72;
    go.addEventListener('click', () => {
      v = Math.min(100, v + 7); bar.style.setProperty('--v', v + '%'); txt.textContent = v >= 100 ? '已抢光' : `已抢 ${v}%`;
      if (v >= 100) { go.disabled = true; go.textContent = '已抢光'; } else Lz.toast('抢购成功', 'success');
    });
  });

  /* 拼团 */
  $$('[data-xcard-group]').forEach(c => {
    const slot = $('[data-slot]', c), txt = $('[data-group-txt]', c), go = $('[data-group-go]', c);
    go.addEventListener('click', () => {
      const img = document.createElement('img'); img.className = 'avatar'; img.alt = ''; img.src = '../../kit/assets/marks/mark-019.webp';
      slot.replaceWith(img); txt.textContent = '已成团'; go.disabled = true; go.textContent = '已加入'; Lz.toast('拼团成功', 'success');
    });
  });

  /* 加购条：加购后变数量步进 */
  $$('[data-xcard-add]').forEach(c => {
    const slot = $('.xcard-addslot', c); const first = slot.innerHTML;
    const stepper = n => `<div class="xcard-step"><button class="xcard-step__m" aria-label="减少数量" data-tip="减少数量"></button><b>${n}</b><button class="xcard-step__p" aria-label="增加数量" data-tip="增加数量"><img src="../../kit/assets/line/add.webp" alt=""></button></div>`;
    let n = 0; const paint = () => { slot.innerHTML = n ? stepper(n) : first; };
    slot.addEventListener('click', e => {
      if (e.target.closest('[data-add-first]')) { n = 1; paint(); $('.xcard-step__p', slot).focus(); }
      else if (e.target.closest('.xcard-step__p')) { n = Math.min(99, n + 1); paint(); $('.xcard-step__p', slot).focus(); }
      else if (e.target.closest('.xcard-step__m')) { n -= 1; paint(); (n ? $('.xcard-step__m', slot) : $('[data-add-first]', slot)).focus(); }
    });
  });

  /* 三态优惠券 */
  $$('[data-tri-get]').forEach(b => b.addEventListener('click', () => {
    const card = b.closest('.xcard-tri'); card.classList.add('is-got'); b.disabled = true; b.textContent = '已领取'; Lz.toast('已领取', 'success');
  }));

  /* 签到 */
  $$('[data-xcard-sign]').forEach(c => {
    const go = $('[data-sign-go]', c), today = $('[data-sign-today]', c), n = $('[data-sign-n]', c);
    go.addEventListener('click', () => {
      today.classList.remove('is-now'); today.classList.add('is-done'); const im = $('img', today); im.removeAttribute('style'); im.classList.add('xcard-ck');
      n.textContent = '4'; go.disabled = true; go.textContent = '已签到'; Lz.toast('签到成功 积分加 10', 'success');
    });
  });

  /* 钱包余额显隐 */
  $$('[data-xcard-wallet]').forEach(c => {
    const eye = $('[data-wallet-eye]', c), amt = $('[data-wallet-amt]', c); const shown = amt.innerHTML;
    eye.addEventListener('click', () => {
      const hide = eye.getAttribute('aria-pressed') !== 'true'; eye.setAttribute('aria-pressed', String(hide));
      eye.textContent = hide ? '显示' : '隐藏'; amt.innerHTML = hide ? '<small>¥</small>****' : shown;
    });
  });

  /* 收货地址选中 */
  $$('[data-xcard-addr]').forEach(c => {
    const flip = e => { if (e.target.closest('.ibtn')) return; const on = c.getAttribute('aria-checked') !== 'true'; c.setAttribute('aria-checked', String(on)); };
    c.addEventListener('click', flip); c.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); flip(e); } });
  });

  /* 评价分布筛选 */
  $$('[data-xcard-rows]').forEach(g => $$('.xcard-row', g).forEach(b => b.addEventListener('click', () => $$('.xcard-row', g).forEach(x => x.setAttribute('aria-pressed', String(x === b && x.getAttribute('aria-pressed') !== 'true'))))));

  /* 营业提醒 */
  $$('[data-remind]').forEach(b => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); b.textContent = on ? '已设提醒' : '营业提醒';
    Lz.toast(on ? '营业后会通知你' : '已取消提醒', on ? 'success' : 'neutral');
  }));

  /* 任务清单 */
  $$('[data-xcard-task]').forEach(c => {
    const bar = $('[data-task-bar]', c), txt = $('[data-task-txt]', c), tag = $('[data-task-tag]', c), items = $$('li', c);
    const sync = () => {
      const done = items.filter(li => $('.check', li).getAttribute('aria-checked') === 'true').length;
      items.forEach(li => li.classList.toggle('is-done', $('.check', li).getAttribute('aria-checked') === 'true'));
      bar.style.setProperty('--v', Math.round(done / items.length * 100) + '%'); txt.textContent = `已完成 ${done} / ${items.length}`;
      tag.textContent = done === items.length ? '已完成' : '进行中'; tag.dataset.tone = done === items.length ? 'success' : 'info';
    };
    c.addEventListener('lz:toggle', sync);
    items.forEach(li => $('span:last-child', li).addEventListener('click', () => $('.check', li).click()));
    sync();
  });

  /* 通知堆叠 */
  $$('[data-xcard-nstack]').forEach(w => {
    const st = $('.xcard-nstack', w), btn = $('[data-nbtn]', w);
    const set = open => { st.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); btn.textContent = open ? '收起' : '展开全部'; };
    st.addEventListener('click', () => set(!st.classList.contains('is-open'))); btn.addEventListener('click', () => set(!st.classList.contains('is-open')));
  });

  /* 骨架切换 */
  $$('[data-xcard-skel]').forEach(w => {
    const a = $('[data-skel-a]', w), b = $('[data-skel-b]', w), go = $('[data-skel-go]', w); let loaded = false, t;
    go.addEventListener('click', () => {
      if (loaded) { loaded = false; b.hidden = true; a.hidden = false; go.textContent = '加载完成'; return; }
      go.disabled = true; go.textContent = '加载中'; t = setTimeout(() => { loaded = true; a.hidden = true; b.hidden = false; go.disabled = false; go.textContent = '重新加载'; }, 900);
    });
  });

  /* 订阅频率 */
  $$('[data-xcard-sub]').forEach(c => {
    const seg = $('[data-sub-seg]', c), price = $('[data-sub-price]', c);
    $$('button', seg).forEach(b => b.addEventListener('click', () => { $$('button', seg).forEach(x => x.setAttribute('aria-pressed', String(x === b))); price.innerHTML = `<small style="font-size: var(--fs-sm)">¥</small>${b.dataset.price}`; }));
  });

  /* 积分兑换 */
  $$('[data-xcard-redeem]').forEach(b => b.addEventListener('click', async () => {
    if (await Lz.confirm({ title: '确认兑换干花花瓶摆件', body: '将扣除 1200 积分', ok: '确认兑换' })) Lz.toast('兑换成功', 'success');
  }));
})();
</script>

<style>
/* 新增卡片：二维码 qr、多图横滑 cr、手风琴 ac、视频 vd、评论 cm、键值 ds、宫格 gw、音频 au、电子卡 ec、文章 ar */

/* 二维码核销卡 */
.xcard-qr { display: grid; gap: var(--s-4); padding: var(--s-4); }
.xcard-qr .btn-seg { display: flex; }
.xcard-qr .btn-seg button { flex: 1; }
.xcard-qr__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xcard-qr__head > div { display: grid; gap: 2px; min-width: 0; }
.xcard-qr__frame { position: relative; display: grid; place-items: center; justify-self: center; width: 192px; height: 192px; padding: var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); }
.xcard-qr__frame canvas { display: block; transition: opacity var(--dur-base) var(--ease-out); }
.xcard-qr__stamp { position: absolute; inset: 0; display: none; place-items: center; }
.xcard-qr__stamp b { padding: var(--s-1) var(--s-4); border: 2px solid var(--ink-3); border-radius: var(--r-md); background: var(--surface); color: var(--ink-2); font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
.xcard-qr[data-state="used"] canvas { opacity: .1; }
.xcard-qr[data-state="used"] .xcard-qr__stamp { display: grid; }
.xcard-qr__code { text-align: center; font-size: var(--fs-lg); font-weight: 600; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
.xcard-qr[data-state="used"] .xcard-qr__code { color: var(--ink-3); text-decoration: line-through; }
.xcard-qr__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 32px; }

/* 多图横滑浏览卡 */
.xcard-cr { padding: var(--s-3) 0 var(--s-2); overflow: hidden; }
.xcard-cr__track { display: flex; gap: var(--s-2); padding: var(--s-2) calc(50% - 95px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; }
.xcard-cr__track::-webkit-scrollbar { display: none; }
.xcard-cr__track.is-drag { scroll-snap-type: none; cursor: grabbing; }
.xcard-cr__track:focus-visible { outline-offset: -3px; border-radius: var(--r-lg); }
.xcard-cr__it { position: relative; flex: none; width: 190px; height: 236px; border-radius: var(--r-lg); overflow: hidden; background: var(--zone); scroll-snap-align: center; transform: scale(.86); opacity: .78; }
.xcard-cr__it > img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.xcard-cr__cap { position: absolute; left: var(--s-2); right: var(--s-2); bottom: var(--s-2); display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding: var(--s-2) var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); text-align: left; }
.xcard-cr__cap b { min-width: 0; font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); }
.xcard-cr__dots { display: flex; justify-content: center; gap: 2px; }
.xcard-cr__dot { display: grid; place-items: center; width: 28px; height: 24px; }
.xcard-cr__dot::after { content: ""; width: 6px; height: 6px; border-radius: 3px; background: var(--line-strong); transition: width var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
.xcard-cr__dot[aria-current="true"]::after { width: 18px; background: var(--action); }

/* 手风琴折叠组 */
.xcard-ac .row[disabled] { cursor: not-allowed; opacity: .55; }
.xcard-ac .row[disabled]:hover { background: none; }
.xcard-ac__body { display: grid; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); line-height: var(--lh-body); }

/* 视频播放卡 */
.xcard-vd { overflow: hidden; }
.xcard-vd__screen { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--zone); }
.xcard-vd__screen > img { width: 100%; height: 100%; object-fit: cover; }
.xcard-vd__play { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 50%; background: var(--surface); box-shadow: var(--elev-3); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.xcard-vd__play img { width: 24px; height: 24px; }
.xcard-vd__play:active { transform: scale(.94); }
.xcard-vd[data-state="playing"] .xcard-vd__play { opacity: 0; pointer-events: none; transform: scale(.8); }
.xcard-vd__screen .xcard-chip { position: absolute; top: var(--s-2); right: var(--s-2); font-variant-numeric: tabular-nums; }
.xcard-vd__ctl { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-3) var(--s-2); color: var(--surface); background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--ink) 66%, transparent) 100%); transition: opacity var(--dur-base) var(--ease-out); }
.xcard-vd[data-state="ready"] .xcard-vd__ctl { opacity: 0; visibility: hidden; }
.xcard-vd__pp { display: grid; place-items: center; flex: none; width: 32px; height: 32px; }
.xcard-vd__pp img, .xcard-vd__ctl .xcard-chip img { width: 20px; height: 20px; filter: invert(1); }
.xcard-vd__bar { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; height: 28px; cursor: pointer; }
.xcard-vd__bar::before { content: ""; position: absolute; left: 0; right: 0; height: 4px; border-radius: 2px; background: color-mix(in srgb, var(--surface) 38%, transparent); }
.xcard-vd__bar i { position: absolute; left: 0; height: 4px; width: var(--p, 0%); border-radius: 2px; background: var(--surface); }
.xcard-vd__time { font-size: var(--fs-xs); font-variant-numeric: tabular-nums; white-space: nowrap; }
.xcard-vd__rate { flex: none; min-height: 28px; padding: 0 var(--s-2); border-radius: var(--r-full); background: color-mix(in srgb, var(--surface) 24%, transparent); color: var(--surface); font-size: var(--fs-xs); font-weight: 600; white-space: nowrap; }
.xcard-vd__info { display: grid; gap: var(--s-1); padding: var(--s-3) var(--s-4) var(--s-4); }

/* 评论回复卡 */
.xcard-cm { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: var(--s-3); padding: var(--s-4); }
.xcard-cm .avatar { width: 40px; height: 40px; padding: 5px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-cm__main { display: grid; gap: var(--s-2); min-width: 0; }
.xcard-cm__who { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 40px; }
.xcard-cm__acts { display: flex; align-items: center; gap: var(--s-2); }
.xcard-cm__acts .btn--text { min-height: 32px; font-size: var(--fs-sm); color: var(--ink-3); }
.xcard-cm__replies { display: grid; gap: var(--s-3); padding: var(--s-3); border-radius: var(--r-md); background: var(--zone); }
.xcard-cm__rh { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.xcard-cm .btn-seg { padding: 2px; border-radius: var(--r-sm); background: var(--surface); }
.xcard-cm .btn-seg button { min-height: 28px; padding: 0 var(--s-2); border-radius: 6px; font-size: var(--fs-xs); }
.xcard-cm__r { display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: var(--s-2); }
.xcard-cm__r .avatar { width: 28px; height: 28px; padding: 3px; }
.xcard-cm__rb { display: grid; gap: 2px; min-width: 0; }
.xcard-cm__rb p { font-size: var(--fs-sm); line-height: var(--lh-body); }
.xcard-cm__ra { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
.xcard-cm__more { justify-self: start; min-height: 28px; padding: 0; font-size: var(--fs-sm); }

/* 键值描述卡 */
.xcard-ds { display: grid; padding: var(--s-4); }
.xcard-ds__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding-bottom: var(--s-2); }
.xcard-ds__r { display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center; column-gap: var(--s-3); min-height: 44px; border-top: 1px solid var(--line); }
.xcard-ds dt { font-size: var(--fs-sm); color: var(--ink-3); }
.xcard-ds dd { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin: 0; min-width: 0; font-size: var(--fs-md); }
.xcard-ds dd .btn--text { flex: none; min-height: 28px; padding: 0 var(--s-1); font-size: var(--fs-sm); }
.xcard-ds__fold { justify-self: center; margin-top: var(--s-1); }

/* 图片宫格墙 */
.xcard-gw { display: grid; gap: var(--s-3); padding: var(--s-4); }
.xcard-gw__view { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-md); background: var(--zone); }
.xcard-gw__view > img { width: 100%; height: 100%; object-fit: cover; }
.xcard-gw__view .xcard-chip { position: absolute; right: var(--s-2); bottom: var(--s-2); font-variant-numeric: tabular-nums; }
.xcard-gw__nav { position: absolute; top: 50%; margin-top: -20px; }
.xcard-gw__nav[data-dir="prev"] { left: var(--s-2); }
.xcard-gw__nav[data-dir="next"] { right: var(--s-2); }
.xcard-gw__nav[data-dir="next"] img { transform: rotate(180deg); }
.xcard-gw__nav[disabled] { opacity: .35; pointer-events: none; }
.xcard-gw__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-2); }
.xcard-gw__c { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--r-md); background: var(--zone); }
.xcard-gw__c img { width: 100%; height: 100%; object-fit: cover; }
.xcard-gw__c:focus-visible { outline: none; }
.xcard-gw__c:focus-visible img { filter: brightness(.76); }
.xcard-gw__c[aria-pressed="true"]::before { content: ""; position: absolute; inset: 4px 4px auto auto; width: 22px; height: 22px; border-radius: 50%; background: var(--surface); }
.xcard-gw__c[aria-pressed="true"]::after { content: ""; position: absolute; top: 8px; right: 11px; width: 7px; height: 12px; border: solid var(--ink); border-width: 0 2px 2px 0; transform: rotate(45deg); }
.xcard-gw__more { position: absolute; inset: 0; display: grid; place-items: center; background: color-mix(in srgb, var(--ink) 52%, transparent); color: var(--surface); font-size: var(--fs-lg); font-weight: 600; font-variant-numeric: tabular-nums; }
.xcard-gw__fold { justify-self: center; }

/* 音频播放条 */
.xcard-au { display: grid; gap: var(--s-4); padding: var(--s-4); }
.xcard-au__voice { display: flex; align-items: center; gap: var(--s-3); }
.xcard-au__voice .avatar { width: 40px; height: 40px; padding: 5px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-au__pill { display: flex; align-items: center; gap: var(--s-3); flex: 1; min-width: 0; height: 48px; padding: 0 var(--s-4) 0 6px; border-radius: var(--r-full); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
.xcard-au__go { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--action); }
.xcard-au__go img { width: 18px; height: 18px; filter: invert(1); }
.xcard-au__wave { display: flex; align-items: center; justify-content: space-between; flex: 1; min-width: 0; height: 28px; }
.xcard-au__wave i { width: 3px; height: var(--h); border-radius: 2px; background: color-mix(in srgb, var(--action) 30%, var(--surface)); transition: background var(--dur-quick) var(--ease-out); }
.xcard-au__wave i.is-on { background: var(--action); }
.xcard-au__sec { font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; color: var(--action-press); white-space: nowrap; }
.xcard-au__unread { width: 8px; height: 8px; border-radius: 50%; background: var(--danger); flex: none; }
.xcard-au__course { display: grid; gap: var(--s-3); }
.xcard-au__course::before { content: ""; height: 1px; margin-bottom: var(--s-1); background: var(--line); }
.xcard-au__meta { display: flex; align-items: center; gap: var(--s-3); }
.xcard-au__meta > img { width: 56px; height: 56px; border-radius: var(--r-md); object-fit: cover; flex: none; }
.xcard-au__meta > div { flex: 1; min-width: 0; display: grid; gap: 2px; }
.xcard-au__rate { flex: none; min-height: 32px; padding: 0 var(--s-3); border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); font-weight: 600; color: var(--action-press); }
.xcard-au__bar { position: relative; display: flex; align-items: center; height: 24px; cursor: pointer; }
.xcard-au__bar::before { content: ""; position: absolute; left: 0; right: 0; height: 6px; border-radius: 3px; background: var(--zone); }
.xcard-au__bar i { position: absolute; left: 0; height: 6px; width: var(--p, 0%); border-radius: 3px; background: var(--action); }
.xcard-au__times { display: flex; justify-content: space-between; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.xcard-au__ctl { display: flex; align-items: center; justify-content: center; gap: var(--s-6); }
.xcard-au__pp { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--action); box-shadow: var(--elev-2); }
.xcard-au__pp img { width: 24px; height: 24px; filter: invert(1); }
.xcard-au__skip img { width: 24px; height: 24px; }
.xcard-au__skip[data-dir="fwd"] img { transform: scaleX(-1); }

/* 虚拟电子卡 */
.xcard-ec { display: grid; gap: var(--s-4); padding: var(--s-4); }
.xcard-ec .btn-seg { display: flex; }
.xcard-ec .btn-seg button { flex: 1; }
.xcard-ec__face { display: grid; gap: var(--s-5); padding: var(--s-5); border-radius: var(--r-lg); color: var(--surface); background: linear-gradient(150deg, var(--action-press) 0%, color-mix(in srgb, var(--action-press) 88%, var(--action)) 100%); transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.xcard-ec__top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xcard-ec__kind { font-size: var(--fs-md); font-weight: 600; }
.xcard-ec__top img { width: 48px; height: 48px; object-fit: contain; filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--ink) 25%, transparent)); }
.xcard-ec__amtbox { display: grid; gap: var(--s-1); }
.xcard-ec__cap { font-size: var(--fs-sm); color: color-mix(in srgb, var(--surface) 84%, transparent); }
.xcard-ec__amt { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.xcard-ec__amt small { margin-right: 2px; font-size: var(--fs-md); font-weight: 600; }
.xcard-ec__bot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.xcard-ec__no { font-size: var(--fs-sm); letter-spacing: .08em; font-variant-numeric: tabular-nums; }
.xcard-ec__bot .tag { background: color-mix(in srgb, var(--surface) 24%, transparent); color: var(--surface); }
.xcard-ec[data-state="used"] .xcard-ec__face { background: var(--zone); color: var(--ink-3); }
.xcard-ec[data-state="used"] .xcard-ec__cap { color: var(--ink-3); }
.xcard-ec[data-state="used"] .xcard-ec__top img { filter: grayscale(1) opacity(.45); }
.xcard-ec[data-state="used"] .xcard-ec__bot .tag { background: var(--surface); color: var(--ink-3); }
.xcard-ec__row { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; column-gap: var(--s-3); min-height: 44px; border-top: 1px solid var(--line); }
.xcard-ec__row > span { font-size: var(--fs-sm); color: var(--ink-3); }
.xcard-ec__row > b { font-size: var(--fs-md); font-weight: 600; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
.xcard-ec__row .btn--text { min-height: 28px; padding: 0 var(--s-1); font-size: var(--fs-sm); }

/* 文章阅读排版 */
.xcard-ar { --ar-fs: var(--fs-md); display: grid; overflow: hidden; }
.xcard-ar[data-size="sm"] { --ar-fs: var(--fs-sm); }
.xcard-ar[data-size="lg"] { --ar-fs: var(--fs-lg); }
.xcard-ar__prog { height: 3px; background: var(--zone); }
.xcard-ar__prog i { display: block; width: var(--v, 0%); height: 100%; background: var(--action); transition: width var(--dur-quick) linear; }
.xcard-ar__sc { display: grid; align-content: start; gap: var(--s-3); height: 400px; padding: var(--s-4); overflow-y: auto; scrollbar-width: none; }
.xcard-ar__sc::-webkit-scrollbar { display: none; }
.xcard-ar__title { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
.xcard-ar__by { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-ar__by .avatar { width: 28px; height: 28px; padding: 3px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.xcard-ar__by b { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.xcard-ar__cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--r-md); }
.xcard-ar__sc p, .xcard-ar__sc li { font-size: var(--ar-fs); line-height: 1.75; }
.xcard-ar__sc h4 { margin-top: var(--s-2); font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
.xcard-ar__sc blockquote { margin: 0; padding: var(--s-2) var(--s-4); border-left: 3px solid var(--action); border-radius: 0 var(--r-md) var(--r-md) 0; background: var(--action-tint); color: var(--action-press); font-size: var(--ar-fs); line-height: 1.75; }
.xcard-ar__sc ul { display: grid; gap: var(--s-2); }
.xcard-ar__sc li { position: relative; padding-left: var(--s-4); }
.xcard-ar__sc li::before { content: ""; position: absolute; left: 2px; top: .8em; width: 6px; height: 6px; border-radius: 50%; background: var(--action); }
.xcard-ar__sc figure { display: grid; gap: var(--s-2); }
.xcard-ar__sc figure img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-md); }
.xcard-ar__sc figcaption { text-align: center; font-size: var(--fs-xs); color: var(--ink-3); }
.xcard-ar__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-2) var(--s-4); border-top: 1px solid var(--line); }
.xcard-ar__size { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); }
.xcard-ar__size .btn-seg button { min-height: 32px; padding: 0 var(--s-3); }
</style>

<!-- ══ 新增：码、浏览、折叠、媒体、评论、描述、宫格、电子卡、文章 ══ -->
<article class="demo" data-cid="AP-CARD-042" data-name="二维码核销卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">二维码核销卡</span></div>
  <p class="demo__note">适合：到店核销、会员码与取货码展示二维码及有效状态</p>
  <div class="demo__stage"><div class="card xcard-qr xcard-w" data-xcard-qr data-state="ok">
    <div class="btn-seg" role="group" aria-label="码类型"><button aria-pressed="true" data-k="v">核销码</button><button aria-pressed="false" data-k="m">会员码</button><button aria-pressed="false" data-k="p">取货码</button></div>
    <div class="xcard-qr__head"><div><span class="xcard-name one-line" data-qr-name>春日花束核销券</span><span class="xcard-meta one-line" data-qr-meta>建国路店 到店出示</span></div><span class="tag" data-tone="success" data-qr-tag>未核销</span></div>
    <div class="xcard-qr__frame"><canvas role="img" aria-label="春日花束核销券二维码"></canvas><span class="xcard-qr__stamp" aria-hidden="true"><b>已核销</b></span></div>
    <p class="xcard-qr__code" data-qr-code>8820 0431 6620</p>
    <div class="xcard-qr__foot"><span class="xcard-meta" data-qr-note>7 天内有效</span><button class="btn btn--outline btn--sm btn--pill" data-qr-act>复制券码</button></div>
  </div></div>
</article>

<article class="demo" data-cid="AP-CARD-043" data-name="多图横滑浏览卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">多图横滑浏览卡</span></div>
  <p class="demo__note">适合：横滑浏览多张主图，居中项放大两侧露边</p>
  <div class="demo__stage"><div class="card xcard-cr xcard-w" data-xcard-cr>
    <div class="xcard-cr__track" tabindex="0" role="group" aria-label="商品图横滑浏览">
      <button class="xcard-cr__it" aria-label="红玫瑰花束 199 元"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><span class="xcard-cr__cap"><b class="one-line">红玫瑰花束</b><span class="price"><small>¥</small>199</span></span></button>
      <button class="xcard-cr__it" aria-label="粉芍药花束 239 元"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><span class="xcard-cr__cap"><b class="one-line">粉芍药花束</b><span class="price"><small>¥</small>239</span></span></button>
      <button class="xcard-cr__it" aria-label="向日葵花束 159 元"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><span class="xcard-cr__cap"><b class="one-line">向日葵花束</b><span class="price"><small>¥</small>159</span></span></button>
      <button class="xcard-cr__it" aria-label="白郁金香 179 元"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><span class="xcard-cr__cap"><b class="one-line">白郁金香</b><span class="price"><small>¥</small>179</span></span></button>
      <button class="xcard-cr__it" aria-label="蓝绣球盆栽 129 元"><img src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><span class="xcard-cr__cap"><b class="one-line">蓝绣球盆栽</b><span class="price"><small>¥</small>129</span></span></button>
    </div>
    <div class="xcard-cr__dots"><button class="xcard-cr__dot" aria-label="第 1 张" data-tip="第 1 张" aria-current="false"></button><button class="xcard-cr__dot" aria-label="第 2 张" data-tip="第 2 张" aria-current="true"></button><button class="xcard-cr__dot" aria-label="第 3 张" data-tip="第 3 张" aria-current="false"></button><button class="xcard-cr__dot" aria-label="第 4 张" data-tip="第 4 张" aria-current="false"></button><button class="xcard-cr__dot" aria-label="第 5 张" data-tip="第 5 张" aria-current="false"></button></div>
  </div></div>
</article>

<article class="demo" data-cid="AP-CARD-044" data-name="手风琴折叠组" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">手风琴折叠组</span></div>
  <p class="demo__note">适合：常见问题与规格说明同组只展开一项</p>
  <div class="demo__stage"><div class="card list xcard-ac xcard-w" data-xcard-ac>
    <button class="row row--link" id="xcard-ac-h1" aria-expanded="true" aria-controls="xcard-ac-p1"><div class="row__main"><p class="row__title">鲜花保鲜期</p></div><span class="row__trail chev"></span></button>
    <div class="expand" id="xcard-ac-p1" role="region" aria-labelledby="xcard-ac-h1" data-open="true"><div><div class="expand__body xcard-ac__body"><p>玫瑰与芍药在清水中可保持 5 至 7 天 向日葵约 10 天</p><p>每两天换水并剪去根部 1 厘米 花期更长</p></div></div></div>
    <button class="row row--link" id="xcard-ac-h2" aria-expanded="false" aria-controls="xcard-ac-p2"><div class="row__main"><p class="row__title">同城急送范围</p></div><span class="row__trail chev"></span></button>
    <div class="expand" id="xcard-ac-p2" role="region" aria-labelledby="xcard-ac-h2" data-open="false"><div><div class="expand__body xcard-ac__body"><div class="xcard-tags"><span class="tag" data-tone="success">5 公里内 2 小时达</span><span class="tag">超出范围次日达</span></div><p>雨雪天气可能延迟 以订单页预计送达时间为准</p></div></div></div>
    <button class="row row--link" id="xcard-ac-h3" aria-expanded="false" aria-controls="xcard-ac-p3"><div class="row__main"><p class="row__title">修改配送时间</p></div><span class="row__trail chev"></span></button>
    <div class="expand" id="xcard-ac-p3" role="region" aria-labelledby="xcard-ac-h3" data-open="false"><div><div class="expand__body xcard-ac__body"><p>发货前可在订单详情自助改约 已发货后请联系门店客服处理</p></div></div></div>
    <button class="row row--link" id="xcard-ac-h4" aria-expanded="false" aria-controls="xcard-ac-p4"><div class="row__main"><p class="row__title">售后与退款</p></div><span class="row__trail chev"></span></button>
