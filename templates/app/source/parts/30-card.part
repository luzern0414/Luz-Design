    paint();
  });

  /* 文章阅读排版：滚动进度、三档字号、点赞 */
  $$('[data-xcard-ar]').forEach(c => {
    const sc = $('[data-ar-sc]', c), bar = $('.xcard-ar__prog', c), like = $('[data-ar-like]', c);
    const sync = () => { const max = sc.scrollHeight - sc.clientHeight; bar.style.setProperty('--v', (max > 0 ? sc.scrollTop / max * 100 : 0) + '%'); };
    sc.addEventListener('scroll', sync, { passive: true }); sync();
    seg($('.xcard-ar__size .btn-seg', c), k => { c.dataset.size = k; sync(); });
    like.addEventListener('click', () => { const on = like.getAttribute('aria-pressed') !== 'true', n = $('span', like); like.setAttribute('aria-pressed', String(on)); n.textContent = (+n.textContent) + (on ? 1 : -1); });
  });
})();
</script>
