      gift: { kind: '花间集礼品卡', cap: '卡面金额', amt: '200', tag: '未使用', no: '8820 0000 0517', sec: '7416 2093 5588', term: '自激活起 12 个月', icon: 'giftcard' },
      used: { kind: '花间集储值卡', cap: '当前余额', amt: '0', tag: '已用完', no: '8820 0000 0388', sec: '', term: '已失效', icon: 'wallet' }
    };
