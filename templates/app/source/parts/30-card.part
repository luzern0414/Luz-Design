      const t = T[k]; c.dataset.state = k;
      el('kind').textContent = t.kind; el('cap').textContent = t.cap; el('amt').innerHTML = `<small>¥</small>${t.amt}`; el('tag').textContent = t.tag; el('no').textContent = t.no; el('no2').textContent = t.no; el('term').textContent = t.term;
      ic.dataset.ic = t.icon; ic.src = `${document.documentElement.dataset.icBase || '../../kit/assets/icons'}/${Lz.iconSet()}/${t.icon}.webp`;
