    const R = [
      { who: '花间集客服', mark: '005', tag: '商家', text: '感谢支持 欢迎再次光临', age: '2 小时前', mins: 120, n: 12, on: false },
      { who: '小周', mark: '012', text: '同款已下单 期待收到', age: '1 小时前', mins: 60, n: 5, on: false },
      { who: '老陈', mark: '003', text: '上次买的绣球养了一个月 状态很好', age: '45 分钟前', mins: 45, n: 18, on: false },
      { who: '苏苏', mark: '015', text: '请问有白色款吗', age: '20 分钟前', mins: 20, n: 2, on: false },
      { who: '阿林', mark: '021', text: '配送很准时', age: '刚刚', mins: 1, n: 0, on: false }
