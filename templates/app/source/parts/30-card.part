    const bar = $('[data-au-bar]', c), now = $('[data-au-now]', c), pp = $('[data-au-pp]', c), rate = $('[data-au-rate]', c), RATES = [1, 1.5, 2];
    wave.innerHTML = H.map(h => `<i style="--h: ${h}px"></i>`).join(''); const bars = $$('i', wave);
