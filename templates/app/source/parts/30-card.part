    const show = k => {
      key = k; const t = TABS[k]; c.dataset.state = t.state; left = 60;
      name.textContent = t.name; meta.textContent = t.meta; code.textContent = t.code; act.textContent = t.act; act.disabled = !!t.act.startsWith('已');
      tag.textContent = t.tag; if (t.tone === 'gold') { tag.removeAttribute('data-tone'); tag.classList.add('xcard-gold'); } else { tag.classList.remove('xcard-gold'); tag.dataset.tone = t.tone; }
      paintNote(); draw();
    };
