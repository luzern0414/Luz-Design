    <ul>
      <li class="is-done"><span class="check" role="checkbox" aria-checked="true" aria-label="核对订单"><img src="../../kit/assets/line/check.webp" alt=""></span><span>核对订单</span></li>
      <li><span class="check" role="checkbox" aria-checked="false" aria-label="挑选花材"><img src="../../kit/assets/line/check.webp" alt=""></span><span>挑选花材</span></li>
      <li><span class="check" role="checkbox" aria-checked="false" aria-label="包装封箱"><img src="../../kit/assets/line/check.webp" alt=""></span><span>包装封箱</span></li>
    </ul>
    <div class="xcard-task__foot"><div class="avatars"><img class="avatar" src="../../kit/assets/marks/mark-003.webp" alt=""><img class="avatar" src="../../kit/assets/marks/mark-015.webp" alt=""></div><span class="xcard-meta">老陈 苏苏</span></div>
  </div></div>
</article>

