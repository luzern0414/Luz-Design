        <div class="en-cr__s" role="group" aria-roledescription="幻灯片" aria-label="第 1 张 共 3 张"><img src="../../kit/assets/photo/scene-hero-pink.webp" alt=""><div class="en-cr__ov"><span class="en-cr__txt"><span class="tag">限时</span><b>春日花礼专场</b><span>满 199 减 30</span></span><button class="btn btn--white btn--sm btn--pill" type="button" data-go="春日花礼专场">去看看</button></div></div>
        <div class="en-cr__s" role="group" aria-roledescription="幻灯片" aria-label="第 2 张 共 3 张"><img src="../../kit/assets/photo/bg-floral.webp" alt=""><div class="en-cr__ov"><span class="en-cr__txt"><span class="tag">新品</span><b>周期订花上新</b><span>每周一束 按期送达</span></span><button class="btn btn--white btn--sm btn--pill" type="button" data-go="周期订花上新">去看看</button></div></div>
        <div class="en-cr__s" role="group" aria-roledescription="幻灯片" aria-label="第 3 张 共 3 张"><img src="../../kit/assets/photo/bg-green.webp" alt=""><div class="en-cr__ov"><span class="en-cr__txt"><span class="tag">热销</span><b>绿植焕新季</b><span>第二件半价</span></span><button class="btn btn--white btn--sm btn--pill" type="button" data-go="绿植焕新季">去看看</button></div></div>
