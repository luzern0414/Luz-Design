        <button class="en-cell" data-go="节日礼盒"><img data-ic="giftbox" src="../../kit/assets/icons/flat/giftbox.webp" alt=""><span>节日礼盒</span></button>
        <button class="en-cell" data-go="绿植盆栽"><img data-ic="plant" src="../../kit/assets/icons/flat/plant.webp" alt=""><span>绿植盆栽</span></button>
        <button class="en-cell" data-go="周期订花"><img data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""><span>周期订花</span></button>
        <button class="en-cell" data-go="花艺定制"><img data-ic="shears" src="../../kit/assets/icons/flat/shears.webp" alt=""><span>花艺定制</span></button>
        <button class="en-cell" data-go="种苗花籽"><img data-ic="seedling" src="../../kit/assets/icons/flat/seedling.webp" alt=""><span>种苗花籽</span></button>
        <button class="en-cell" data-go="养护用品"><img data-ic="watering" src="../../kit/assets/icons/flat/watering.webp" alt=""><span>养护用品</span></button>
        <button class="en-cell" data-go="极速配送"><img data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""><span>极速配送</span></button>
        <button class="en-cell" data-go="优惠券"><img data-ic="coupon" src="../../kit/assets/icons/flat/coupon.webp" alt=""><span>优惠券</span></button>
        <button class="en-cell" data-go="礼品卡"><img data-ic="giftcard" src="../../kit/assets/icons/flat/giftcard.webp" alt=""><span>礼品卡</span></button>
        <button class="en-cell" data-go="钱包"><img data-ic="wallet" src="../../kit/assets/icons/flat/wallet.webp" alt=""><span>钱包</span></button>
        <button class="en-cell" data-go="收藏"><img data-ic="heart" src="../../kit/assets/icons/flat/heart.webp" alt=""><span>收藏</span></button>
        <button class="en-cell" data-go="购物车"><img data-ic="cart" src="../../kit/assets/icons/flat/cart.webp" alt=""><span>购物车</span></button>
        <button class="en-cell" data-go="评价"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""><span>评价</span></button>
      </div>
      <div class="en-track"><i></i></div>
    </nav>
  </div>
</article>

<article class="demo" data-cid="AP-ENTR-004" data-name="一大两小图文入口" data-cat="ENTR">
  <div class="demo__head"><span class="demo__name">一大两小图文入口</span></div>
  <p class="demo__note">适合：首页主推业务线配两个次推入口</p>
  <div class="demo__stage">
    <div class="en-mosaic">
      <button class="en-big" data-go="同城鲜花"><img src="../../kit/assets/photo/bouquet-rose.webp" alt=""><span class="tag">热卖第一</span><b>同城鲜花</b><span>2 小时送达</span></button>
      <button class="en-small" data-go="节日礼盒"><b>节日礼盒</b><span>满 199 减 20</span><img data-ic="giftbox" src="../../kit/assets/icons/flat/giftbox.webp" alt=""></button>
      <button class="en-small" data-go="周期订花"><b>周期订花</b><span>每周一束</span><img data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""></button>
    </div>
  </div>
