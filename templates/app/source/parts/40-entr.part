<!-- cat: ENTR | 入口 -->
<style>
/* 入口：上图下字，紧凑图标和整格触控 */
.en-card { padding: var(--s-4) var(--s-2); }
.en-grid { display: grid; gap: var(--s-4) 0; }
.en-grid--4 { grid-template-columns: repeat(4, 1fr); }
.en-grid--5 { grid-template-columns: repeat(5, 1fr); }
.en-cell { position: relative; display: grid; justify-items: center; align-content: center; gap: var(--s-1); min-height: 48px; padding: 2px 0; font-size: var(--fs-sm); line-height: 1.25; color: var(--ink); white-space: nowrap; border-radius: var(--r-md); }
.en-cell:active { background: var(--zone); }
@media (hover: hover) { .en-cell:hover { background: var(--zone); } }

[data-preserve-icons] .en-cell { align-content: start; gap: var(--s-2); min-height: auto; }
[data-preserve-icons] .en-cell img { width: 52px; height: 52px; object-fit: contain; filter: drop-shadow(0 6px 8px color-mix(in srgb, var(--ink) 14%, transparent)); transition: transform var(--dur-base) var(--ease-spring); }
[data-preserve-icons] .en-cell--sm img { width: 44px; height: 44px; }
[data-preserve-icons] .en-cell:is(:hover, :active) { background: transparent; }
[data-preserve-icons] .en-cell:active img { transform: scale(.9); }
@media (hover: hover) { [data-preserve-icons] .en-cell:hover img { transform: translateY(-3px) scale(1.05); } }

/* 横滑入口：两行多列，下方进度条随滚动移动 */
.en-scroll { display: grid; grid-auto-flow: column; grid-template-rows: repeat(2, auto); grid-auto-columns: 76px; gap: var(--s-4) 0; padding: var(--s-4) var(--s-2) var(--s-3); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
.en-scroll::-webkit-scrollbar { display: none; }
.en-scroll > * { scroll-snap-align: start; }
.en-track { position: relative; width: 36px; height: 4px; margin: 0 auto var(--s-3); border-radius: var(--r-full); background: var(--line-strong); }
.en-track i { position: absolute; top: 0; left: 0; height: 100%; width: 40%; border-radius: inherit; background: var(--action); }

/* 一大两小：大块实拍加渐变，小块白底配彩色图标 */
.en-mosaic { display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: 1fr 1fr; gap: var(--s-3); height: 232px; }
.en-big { position: relative; isolation: isolate; grid-row: 1 / 3; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: var(--s-1); padding: var(--s-4); overflow: hidden; border-radius: var(--r-lg); color: var(--surface); text-align: left; box-shadow: var(--elev-2); }
.en-big > img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
.en-big::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--ink) 66%, transparent) 100%); }
.en-big .tag { background: var(--accent-tint); color: var(--accent); }
.en-big b { font-size: var(--fs-xl); line-height: var(--lh-tight); font-weight: 700; }
.en-big span:last-child { font-size: var(--fs-sm); opacity: .92; }
.en-big:active > img { transform: scale(1.05); }
@media (hover: hover) { .en-big:hover > img { transform: scale(1.05); } }
.en-small { position: relative; display: grid; grid-template-rows: auto auto 1fr; gap: 2px; padding: var(--s-4) var(--s-3) var(--s-2) var(--s-4); overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); text-align: left; transition: transform var(--dur-quick) var(--ease-out); }
.en-small b { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.en-small span { font-size: var(--fs-sm); line-height: 1.3; color: var(--ink-3); }
.en-small img { justify-self: end; align-self: end; width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; filter: drop-shadow(0 6px 8px color-mix(in srgb, var(--ink) 14%, transparent)); }
.en-small:active { transform: scale(.97); }

/* 图文入口条 */
.en-strip { display: grid; grid-template-columns: var(--ui-icon-max) 1fr auto; align-items: center; column-gap: var(--s-3); width: 100%; padding: var(--s-3) var(--s-4) var(--s-3) var(--s-3); border-radius: var(--r-lg); text-align: left; transition: transform var(--dur-quick) var(--ease-out); }
.en-strip + .en-strip { margin-top: var(--s-3); }
.en-strip--rose { background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.en-strip--gold { background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
.en-strip img { width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; filter: drop-shadow(0 6px 8px color-mix(in srgb, var(--ink) 14%, transparent)); }
.en-strip b { display: block; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.en-strip small { display: block; margin-top: 2px; font-size: var(--fs-sm); color: var(--ink-2); }
.en-strip:active { transform: scale(.98); }

/* 分类宫格入口：左栏分类，右侧实拍宫格 */
.en-side { display: grid; grid-template-columns: 84px 1fr; height: 268px; overflow: hidden; }
.en-rail { display: grid; grid-auto-rows: 1fr; background: var(--zone); }
.en-rail button { position: relative; min-height: 52px; padding: 0 var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); text-align: left; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.en-rail button[aria-selected="true"] { background: var(--surface); color: var(--ink); font-weight: 600; }
.en-rail button[aria-selected="true"]::before { content: ""; position: absolute; left: 0; top: 16px; bottom: 16px; width: 3px; border-radius: 0 3px 3px 0; background: var(--action); }
.en-pane { padding: var(--s-4) var(--s-3); overflow-y: auto; scrollbar-width: none; }
.en-pane::-webkit-scrollbar { display: none; }
.en-pane__h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--s-3); }
.en-pane__h b { font-size: var(--fs-md); font-weight: 600; }
.en-pane__h span { font-size: var(--fs-sm); color: var(--ink-3); }
.en-pane__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4) var(--s-2); animation: lz-fade var(--dur-base) var(--ease-out) both; }
.en-pic { display: grid; justify-items: center; gap: var(--s-2); font-size: var(--fs-sm); line-height: 1.25; white-space: nowrap; }
.en-pic__i { display: grid; place-items: center; width: 64px; height: 64px; overflow: hidden; border-radius: var(--r-md); background: var(--zone); transition: transform var(--dur-base) var(--ease-out); }
.en-pic img { width: 100%; height: 100%; object-fit: cover; }
.en-pic--ic .en-pic__i { width: var(--ui-icon-max); height: var(--ui-icon-max); border-radius: 6px; background: var(--ui-icon-mint); }
.en-pic--ic img { width: 18px; height: 18px; object-fit: contain; }
.en-pic:active .en-pic__i { transform: scale(.92); }
@media (hover: hover) { .en-pic:hover .en-pic__i { transform: translateY(-2px); } }

/* 图标加文字行 */
.en-line .row__lead { width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; border-radius: 0; filter: drop-shadow(0 4px 6px color-mix(in srgb, var(--ink) 14%, transparent)); }
.en-line .row__title { font-weight: 500; }

/* 带角标入口 */
.en-wrap { position: relative; display: block; }
.en-wrap .badge { top: -4px; right: -10px; }
.en-dot { position: absolute; top: -2px; right: -4px; width: 12px; height: 12px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 2px var(--surface); animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.en-wrap .tag-new { position: absolute; top: -6px; right: -14px; height: 18px; padding: 0 5px; border-radius: 9px 9px 9px 2px; background: var(--accent); color: var(--surface); font-size: 10px; font-weight: 600; line-height: 18px; animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.en-gone { opacity: 0; transform: scale(.4); transition: opacity var(--dur-quick), transform var(--dur-quick); pointer-events: none; }

/* 标签式入口 */
.en-chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(136px, 1fr)); gap: var(--s-3) var(--s-2); }
.en-chip { display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-3); border: 1px solid var(--line); border-radius: var(--r-full); background: var(--surface); box-shadow: var(--elev-1); font-size: var(--fs-sm); font-weight: 500; transition: transform var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
.en-chip img { width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; filter: drop-shadow(0 3px 4px color-mix(in srgb, var(--ink) 16%, transparent)); }
.en-chip:active { transform: scale(.96); }
@media (hover: hover) { .en-chip:hover { box-shadow: var(--elev-2); } }

/* 悬浮入口 */
.en-phone { position: relative; padding-bottom: var(--s-3); overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg); }
.en-phone__top { height: 72px; background: linear-gradient(165deg, var(--action) 0%, color-mix(in srgb, var(--action) 62%, var(--surface)) 100%); }
.en-phone__body { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin: calc(var(--s-6) * -1) var(--s-3) 0; }
.en-phone__card { padding-bottom: var(--s-3); border-radius: var(--r-lg); overflow: hidden; background: var(--surface); box-shadow: var(--elev-1); }
.en-phone__card img { width: 100%; height: 80px; object-fit: cover; }
.en-phone__card i { display: block; height: 8px; margin: var(--s-3) var(--s-3) 0; border-radius: var(--r-full); background: var(--zone); }
.en-phone__card i + i { width: 40%; }
.en-float { position: absolute; right: var(--s-3); top: 96px; display: grid; justify-items: center; transition: transform var(--dur-slow) var(--ease-spring); }
.en-float__btn { position: relative; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--surface); box-shadow: var(--elev-3); transition: transform var(--dur-quick) var(--ease-out); }
.en-float__btn img { width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; filter: drop-shadow(0 4px 5px color-mix(in srgb, var(--ink) 16%, transparent)); }
.en-float__btn:active { transform: scale(.92); }
.en-float__tag { position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); height: 18px; padding: 0 7px; border-radius: var(--r-full); background: var(--accent); color: var(--surface); font-size: 10px; font-weight: 600; line-height: 18px; white-space: nowrap; }
.en-float__x { position: absolute; top: -8px; right: -8px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ink); transition: opacity var(--dur-quick) var(--ease-out); }
.en-float__x img { width: 12px; height: 12px; filter: invert(1); }
.en-float[data-state="dock"] { transform: translateX(44px); }
.en-float[data-state="dock"] .en-float__x { opacity: 0; pointer-events: none; }

/* 大图入口卡 */
.en-banner { position: relative; isolation: isolate; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-3); width: 100%; aspect-ratio: 16 / 9; padding: var(--s-4); overflow: hidden; border-radius: var(--r-lg); color: var(--surface); text-align: left; box-shadow: var(--elev-2); }
.en-banner > img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
.en-banner::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 28%, color-mix(in srgb, var(--ink) 64%, transparent) 100%); }
.en-banner__txt { display: grid; justify-items: start; gap: var(--s-1); }
.en-banner__txt .tag { background: var(--accent-tint); color: var(--accent); }
.en-banner__txt b { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
@media (hover: hover) { .en-banner:hover > img { transform: scale(1.04); } }

/* 服务入口格：文字在左上，大图标压在右下角 */
.en-svc { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
.en-svc__t { position: relative; display: grid; grid-template-rows: auto auto 1fr; gap: 2px; min-height: 112px; padding: var(--s-4) var(--s-2) var(--s-2) var(--s-4); overflow: hidden; border-radius: var(--r-lg); text-align: left; transition: transform var(--dur-quick) var(--ease-out); }
.en-svc__t:nth-child(1), .en-svc__t:nth-child(4) { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
.en-svc__t:nth-child(2), .en-svc__t:nth-child(3) { background: var(--accent-tint); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent); }
.en-svc__t b { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.en-svc__t span { font-size: var(--fs-sm); line-height: 1.3; color: var(--ink-2); }
.en-svc__t img { justify-self: end; align-self: end; width: var(--ui-icon-max); height: var(--ui-icon-max); object-fit: contain; filter: drop-shadow(0 8px 10px color-mix(in srgb, var(--ink) 16%, transparent)); transition: transform var(--dur-base) var(--ease-spring); }
.en-svc__t:active { transform: scale(.97); }
@media (hover: hover) { .en-svc__t:hover img { transform: translateY(-3px) scale(1.06); } }

/* 图片分类入口 */
.en-photo { display: grid; justify-items: center; gap: var(--s-2); font-size: var(--fs-sm); line-height: 1.25; white-space: nowrap; }
.en-photo img { width: 68px; height: 68px; object-fit: cover; border-radius: 50%; border: 2px solid var(--surface); box-shadow: var(--elev-2); transition: transform var(--dur-base) var(--ease-out); }
.en-photo:active img { transform: scale(.92); }
@media (hover: hover) { .en-photo:hover img { transform: translateY(-3px); } }

/* 会员权益入口 */
.en-perk { padding: var(--s-4) var(--s-3) var(--s-4); }
.en-perk__h { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--s-2) var(--s-3); }
.en-perk__h b { font-size: var(--fs-md); font-weight: 600; color: var(--accent); }
.en-perk__h button { display: inline-flex; align-items: center; gap: var(--s-1); font-size: var(--fs-sm); color: var(--ink-2); }
.en-perk__h .chev { margin-left: -2px; }
</style>

<article class="demo" data-preserve-icons data-cid="AP-ENTR-001" data-name="八宫格入口" data-cat="ENTR">
  <div class="demo__head"><span class="demo__name">八宫格入口</span></div>
  <p class="demo__note">适合：首页主业务线分发，每格一个目的地</p>
  <div class="demo__stage">
    <nav class="card en-card en-grid en-grid--4" aria-label="业务入口">
      <button class="en-cell" data-go="同城鲜花"><img data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><span>同城鲜花</span></button>
      <button class="en-cell" data-go="节日礼盒"><img data-ic="giftbox" src="../../kit/assets/icons/flat/giftbox.webp" alt=""><span>节日礼盒</span></button>
      <button class="en-cell" data-go="绿植盆栽"><img data-ic="plant" src="../../kit/assets/icons/flat/plant.webp" alt=""><span>绿植盆栽</span></button>
      <button class="en-cell" data-go="周期订花"><img data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""><span>周期订花</span></button>
      <button class="en-cell" data-go="花艺定制"><img data-ic="shears" src="../../kit/assets/icons/flat/shears.webp" alt=""><span>花艺定制</span></button>
      <button class="en-cell" data-go="种苗花籽"><img data-ic="seedling" src="../../kit/assets/icons/flat/seedling.webp" alt=""><span>种苗花籽</span></button>
      <button class="en-cell" data-go="养护用品"><img data-ic="watering" src="../../kit/assets/icons/flat/watering.webp" alt=""><span>养护用品</span></button>
      <button class="en-cell" data-go="极速配送"><img data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""><span>极速配送</span></button>
    </nav>
  </div>
</article>

<article class="demo" data-cid="AP-ENTR-002" data-name="五宫格入口" data-cat="ENTR">
  <div class="demo__head"><span class="demo__name">五宫格入口</span></div>
  <p class="demo__note">适合：我的页资产与账户常用入口</p>
  <div class="demo__stage">
    <nav class="card en-card en-grid en-grid--5" aria-label="账户入口">
      <button class="en-cell en-cell--sm" data-go="优惠券"><img class="compact-icon" src="../../kit/assets/line/archive.webp" alt=""><span>优惠券</span></button>
      <button class="en-cell en-cell--sm" data-go="礼品卡"><img class="compact-icon" src="../../kit/assets/line/check.webp" alt=""><span>礼品卡</span></button>
      <button class="en-cell en-cell--sm" data-go="钱包"><img class="compact-icon" src="../../kit/assets/line/folder.webp" alt=""><span>钱包</span></button>
      <button class="en-cell en-cell--sm" data-go="收藏"><img class="compact-icon" src="../../kit/assets/line/book.webp" alt=""><span>收藏</span></button>
      <button class="en-cell en-cell--sm" data-go="地址"><img class="compact-icon" src="../../kit/assets/line/location.webp" alt=""><span>地址</span></button>
    </nav>
  </div>
</article>

<article class="demo" data-preserve-icons data-cid="AP-ENTR-003" data-name="横滑入口" data-cat="ENTR">
