</article>

<article class="demo" data-preserve-icons data-cid="AP-ENTR-016" data-name="多页宫格入口" data-cat="ENTR">
  <div class="demo__head"><span class="demo__name">多页宫格入口</span></div>
  <p class="demo__note">适合：入口超过两行时左右翻页，带分页点</p>
  <div class="demo__stage">
    <section class="card en-pg" id="en-pg" role="region" aria-roledescription="轮播" aria-label="全部入口">
      <div class="en-pg__track">
        <nav class="en-grid en-grid--4 en-pg__p" aria-label="业务入口 第 1 页">
          <button class="en-cell" data-go="同城鲜花"><img data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><span>同城鲜花</span></button>
          <button class="en-cell" data-go="节日礼盒"><img data-ic="giftbox" src="../../kit/assets/icons/flat/giftbox.webp" alt=""><span>节日礼盒</span></button>
          <button class="en-cell" data-go="绿植盆栽"><img data-ic="plant" src="../../kit/assets/icons/flat/plant.webp" alt=""><span>绿植盆栽</span></button>
          <button class="en-cell" data-go="周期订花"><img data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""><span>周期订花</span></button>
          <button class="en-cell" data-go="花艺定制"><img data-ic="shears" src="../../kit/assets/icons/flat/shears.webp" alt=""><span>花艺定制</span></button>
          <button class="en-cell" data-go="种苗花籽"><img data-ic="seedling" src="../../kit/assets/icons/flat/seedling.webp" alt=""><span>种苗花籽</span></button>
          <button class="en-cell" data-go="养护用品"><img data-ic="watering" src="../../kit/assets/icons/flat/watering.webp" alt=""><span>养护用品</span></button>
          <button class="en-cell" data-go="极速配送"><img data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""><span>极速配送</span></button>
        </nav>
        <nav class="en-grid en-grid--4 en-pg__p" aria-label="账户入口 第 2 页">
          <button class="en-cell" data-go="优惠券"><img data-ic="coupon" src="../../kit/assets/icons/flat/coupon.webp" alt=""><span>优惠券</span></button>
          <button class="en-cell" data-go="礼品卡"><img data-ic="giftcard" src="../../kit/assets/icons/flat/giftcard.webp" alt=""><span>礼品卡</span></button>
          <button class="en-cell" data-go="钱包"><img data-ic="wallet" src="../../kit/assets/icons/flat/wallet.webp" alt=""><span>钱包</span></button>
          <button class="en-cell" data-go="收藏"><img data-ic="heart" src="../../kit/assets/icons/flat/heart.webp" alt=""><span>收藏</span></button>
          <button class="en-cell" data-go="收货地址"><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""><span>收货地址</span></button>
          <button class="en-cell" data-go="购物车"><img data-ic="cart" src="../../kit/assets/icons/flat/cart.webp" alt=""><span>购物车</span></button>
          <button class="en-cell" data-go="评价"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""><span>评价</span></button>
          <button class="en-cell" data-go="全部订单"><img data-ic="bag" src="../../kit/assets/icons/flat/bag.webp" alt=""><span>全部订单</span></button>
        </nav>
      </div>
      <div class="en-dots" role="tablist" aria-label="入口页码">
        <button type="button" role="tab" aria-selected="true" aria-label="第 1 页" data-tip="第 1 页"></button>
        <button type="button" role="tab" aria-selected="false" aria-label="第 2 页" data-tip="第 2 页"></button>
      </div>
    </section>
  </div>
</article>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };

  // 横向分页：滚动吸附加鼠标拖动，页码点随之同步；触屏与触控板用原生滑动
  function paged(track, tabs, hooks) {
    hooks = hooks || {};
    var cur = 0, lock = 0, drag = null, swallow = false, n = tabs.length;
    var width = function () { return track.clientWidth || 1; };
    function mark(i) {
      cur = i;
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      if (hooks.page) hooks.page(i);
    }
    function go(i, instant) {
      i = clamp(i, 0, n - 1); lock = Date.now() + 520; mark(i);
      track.scrollTo({ left: i * width(), behavior: instant || Lz.reduce ? 'auto' : 'smooth' });
    }
    track.addEventListener('scroll', function () {
      if (Date.now() < lock) return;
      var i = clamp(Math.round(track.scrollLeft / width()), 0, n - 1); if (i !== cur) mark(i);
    }, { passive: true });
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { go(i); });
      t.addEventListener('keydown', function (e) {
        var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return;
        var k = (i + d + n) % n; go(k); tabs[k].focus(); e.preventDefault();
      });
    });
    track.addEventListener('pointerdown', function (e) { if (e.pointerType === 'mouse' && e.button === 0) drag = { x: e.clientX, l: track.scrollLeft, on: false }; });
    track.addEventListener('pointermove', function (e) {
      if (!drag) return; var dx = e.clientX - drag.x;
      if (!drag.on) {
        if (Math.abs(dx) < 5) return;
        drag.on = true; track.setPointerCapture(e.pointerId); track.classList.add('is-drag'); track.style.scrollSnapType = 'none'; if (hooks.drag) hooks.drag(true);
      }
      track.scrollLeft = drag.l - dx;
    });
    function end(e) {
      if (!drag) return; var d = drag; drag = null; if (!d.on) return;
      var dx = e.clientX - d.x, w = width(), from = Math.round(d.l / w), to = Math.round((d.l - dx) / w);
      if (to === from && Math.abs(dx) > 40) to = from + (dx < 0 ? 1 : -1);
      track.classList.remove('is-drag'); track.style.scrollSnapType = ''; swallow = true; setTimeout(function () { swallow = false; }, 0);
      go(to); if (hooks.drag) hooks.drag(false);
    }
    track.addEventListener('pointerup', end); track.addEventListener('pointercancel', end);
    track.addEventListener('click', function (e) { if (swallow) { e.stopPropagation(); e.preventDefault(); } }, true);
    new ResizeObserver(function () { track.scrollLeft = cur * width(); }).observe(track);
    mark(0);
    return { go: go, cur: function () { return cur; }, size: n };
  }

  // 轮播图横幅：自动轮播，悬停、聚焦、拖动、离开视野或用户暂停时停住
  (function () {
    var host = $('#en-cr'); if (!host) return;
    var track = $('.en-cr__track', host), slides = $$('.en-cr__s', host), btn = $('.en-cr__play', host);
    var playing = !Lz.reduce, hover = false, focus = false, drag = false, seen = true;
    var pg = paged(track, $$('.en-dots button', host), {
      page: function (i) { slides.forEach(function (s, j) { $$('button', s).forEach(function (b) { b.tabIndex = j === i ? 0 : -1; }); }); },
      drag: function (on) { drag = on; }
    });
    function setPlay(on) {
      playing = on; var im = $('img', btn);
      btn.setAttribute('aria-label', on ? '暂停轮播' : '播放轮播'); btn.dataset.tip = on ? '暂停' : '播放';
      im.src = '../../kit/assets/line/' + (on ? 'pause' : 'play') + '.webp';
      track.setAttribute('aria-live', on ? 'off' : 'polite');
    }
    btn.addEventListener('click', function () { setPlay(!playing); });
    host.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') hover = true; });
    host.addEventListener('pointerleave', function () { hover = false; });
    host.addEventListener('focusin', function () { focus = true; });
    host.addEventListener('focusout', function () { focus = false; });
    host.addEventListener('keydown', function (e) {
      var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d || e.target.closest('.en-dots')) return;
      var k = clamp(pg.cur() + d, 0, slides.length - 1); pg.go(k); var b = $('button', slides[k]); if (b) b.focus({ preventScroll: true }); e.preventDefault();
    });
    new IntersectionObserver(function (es) { seen = es[0].isIntersecting; }).observe(host);
    setPlay(playing);
    setInterval(function () {
      if (!playing || hover || focus || drag || !seen) return;
      var k = pg.cur() + 1; pg.go(k >= slides.length ? 0 : k, k >= slides.length);
    }, 3600);
  })();

  // 多页宫格入口：左右滑动或点分页点翻页
  (function () {
    var host = $('#en-pg'); if (!host) return;
    paged($('.en-pg__track', host), $$('.en-dots button', host), {
      page: function (i) { $$('.en-pg__p', host).forEach(function (p, j) { p.setAttribute('aria-hidden', String(j !== i)); $$('button', p).forEach(function (b) { b.tabIndex = j === i ? 0 : -1; }); }); }
    });
  })();
})();
</script>
