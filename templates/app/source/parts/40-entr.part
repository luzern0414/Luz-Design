<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  // 通用：点按入口给出轻提示
  $$('[data-cid^="AP-ENTR-"] [data-go]').forEach(function (el) {
    el.addEventListener('click', function () { Lz.toast('已打开' + el.dataset.go); });
  });

  // 横滑入口：进度条随滚动
  (function () {
    var host = $('#en-hs'); if (!host) return;
    var sc = $('.en-scroll', host), tr = $('.en-track', host), th = $('i', tr);
    function sync() {
      var max = sc.scrollWidth - sc.clientWidth, ratio = sc.clientWidth / sc.scrollWidth;
      var w = Math.max(.25, ratio) * tr.clientWidth; th.style.width = w + 'px';
      th.style.transform = 'translateX(' + (max > 0 ? sc.scrollLeft / max : 0) * (tr.clientWidth - w) + 'px)';
    }
    sc.addEventListener('scroll', sync, { passive: true }); new ResizeObserver(sync).observe(sc); sync();
  })();

  // 分类宫格入口：左栏切换右侧宫格
  (function () {
    var host = $('#en-side'); if (!host) return;
    var P = '../../kit/assets/photo/', I = '../../kit/assets/icons/';
    var data = {
      flower: { n: '鲜花', items: [['红玫瑰', 'p', 'product-rose-red'], ['粉芍药', 'p', 'product-peony-pink'], ['向日葵', 'p', 'product-sunflower'], ['白郁金香', 'p', 'product-tulip-white'], ['玫瑰礼束', 'p', 'bouquet-rose'], ['白花束', 'p', 'bouquet-white']] },
      plant: { n: '绿植', items: [['蓝绣球', 'p', 'product-hydrangea-blue'], ['龟背竹', 'p', 'product-monstera'], ['多肉盆栽', 'p', 'product-succulent'], ['种苗花籽', 'i', 'seedling']] },
      gift: { n: '礼盒', items: [['花礼盒', 'p', 'product-giftbox'], ['郁金香束', 'p', 'bouquet-tulip'], ['礼品卡', 'i', 'giftcard'], ['节日礼盒', 'i', 'giftbox']] },
      ware: { n: '花器', items: [['干花摆件', 'p', 'product-pampas-vase'], ['玻璃花瓶', 'i', 'vase'], ['花艺剪刀', 'i', 'shears'], ['浇水壶', 'i', 'watering']] }
    };
    var pane = $('.en-pane', host), h = $('.en-pane__h b', host), c = $('.en-pane__h span', host), g = $('.en-pane__grid', host);
    function show(k) {
      var d = data[k]; h.textContent = d.n; c.textContent = d.items.length + ' 个系列';
      g.replaceChildren(); void g.offsetWidth;
      d.items.forEach(function (it) {
        var b = document.createElement('button'); b.className = 'en-pic' + (it[1] === 'i' ? ' en-pic--ic' : '');
        var im = it[1] === 'p' ? '<img src="' + P + it[2] + '.webp" alt="">' : '<img data-ic="' + it[2] + '" src="' + I + Lz.iconSet() + '/' + it[2] + '.webp" alt="">';
        b.innerHTML = '<span class="en-pic__i">' + im + '</span><span>' + it[0] + '</span>';
        b.addEventListener('click', function () { Lz.toast('已打开' + it[0]); });
        g.appendChild(b);
      });
      pane.scrollTop = 0;
    }
    $$('.en-rail button', host).forEach(function (b) {
      b.addEventListener('click', function () {
        $$('.en-rail button', host).forEach(function (x) { x.setAttribute('aria-selected', String(x === b)); });
        show(b.dataset.k);
      });
    });
    show('flower');
  })();

  // 带角标入口：点按即视为已读，角标消失
  $$('[data-read]').forEach(function (el) {
    el.addEventListener('click', function () {
      var b = $('[data-b]', el);
      if (b) { b.classList.add('en-gone'); setTimeout(function () { b.remove(); }, 160); Lz.toast('已查看' + el.dataset.read); }
    });
  });

  // 悬浮入口：收起到边缘，再点展开
  (function () {
    var host = $('#en-ph'); if (!host) return;
    var f = $('.en-float', host), btn = $('[data-act]', host), fold = $('[data-fold]', host);
    fold.addEventListener('click', function () { f.dataset.state = 'dock'; btn.setAttribute('aria-label', '展开入口'); });
    btn.addEventListener('click', function () {
      if (f.dataset.state === 'dock') { f.dataset.state = 'open'; btn.setAttribute('aria-label', '领券'); } else Lz.toast('已打开券包');
    });
  })();
})();
</script>

<style>
/* 新增：轮播图横幅与多页宫格入口，共用分页点；类名带 en-cr- / en-pg- / en-dots */
.en-dots { display: flex; align-items: center; justify-content: center; }
.en-dots button { display: grid; place-items: center; width: 22px; height: 24px; border-radius: var(--r-full); }
.en-dots button::before { content: ""; width: 6px; height: 6px; border-radius: var(--r-full); background: var(--dot, var(--line-strong)); transition: width var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
.en-dots button[aria-selected="true"]::before { width: 18px; background: var(--dot-on, var(--action)); }
@media (hover: hover) { .en-dots button:not([aria-selected="true"]):hover::before { background: var(--ink-3); } }

.en-cr { position: relative; overflow: hidden; border-radius: var(--r-lg); background: var(--zone); box-shadow: var(--elev-2); }
.en-cr__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.en-cr__track::-webkit-scrollbar { display: none; }
.en-cr__track.is-drag { cursor: grabbing; user-select: none; }
.en-cr__s { position: relative; flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; color: var(--surface); text-align: left; }
.en-cr__s > img { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
.en-cr__s::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 22%, color-mix(in srgb, var(--ink) 70%, transparent) 100%); pointer-events: none; }
.en-cr__ov { position: absolute; inset: 0; z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-3); padding: var(--s-4) var(--s-4) 36px; }
.en-cr__txt { display: grid; justify-items: start; gap: var(--s-1); min-width: 0; }
.en-cr__txt .tag { background: var(--accent-tint); color: var(--accent); }
.en-cr__txt b { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); white-space: nowrap; }
.en-cr__txt > span:last-child { font-size: var(--fs-sm); opacity: .92; white-space: nowrap; }
.en-cr .en-dots { position: absolute; z-index: 2; left: 0; right: 0; bottom: 8px; --dot: color-mix(in srgb, var(--surface) 55%, transparent); --dot-on: var(--surface); pointer-events: none; }
.en-cr .en-dots button { pointer-events: auto; }
.en-cr :focus-visible { outline-color: var(--surface); }
.en-cr__play { position: absolute; z-index: 2; right: var(--s-3); bottom: 6px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: color-mix(in srgb, var(--ink) 44%, transparent); transition: transform var(--dur-instant) var(--ease-out); }
.en-cr__play img { width: 14px; height: 14px; filter: invert(1); }
.en-cr__play:active { transform: scale(.9); }

.en-pg { overflow: hidden; }
.en-pg__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.en-pg__track::-webkit-scrollbar { display: none; }
.en-pg__track.is-drag { cursor: grabbing; user-select: none; }
.en-pg__p { flex: 0 0 100%; padding: var(--s-4) var(--s-2) var(--s-1); scroll-snap-align: start; scroll-snap-stop: always; }
.en-pg .en-dots { padding-bottom: var(--s-2); }
</style>

<article class="demo" data-cid="AP-ENTR-015" data-name="轮播图横幅" data-cat="ENTR">
