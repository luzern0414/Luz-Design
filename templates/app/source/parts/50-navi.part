        <button class="seg__item" data-key="after" aria-selected="false">售后流程</button>
      </div>
      <ol class="nv-vs__list" aria-label="订单进度"></ol>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-023" data-name="页码指示点" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">页码指示点</span></div>
  <p class="demo__note">适合：轮播与分页内容底部的当前页指示，含四种样式</p>
  <div class="demo__stage">
    <div class="card nv-pd" id="nv-pd">
      <div class="nv-pd__view">
        <img class="nv-pd__img" src="../../kit/assets/photo/product-rose-red.webp" alt="">
        <span class="nv-pd__cap">红玫瑰花束</span>
        <button type="button" class="nv-pd__nav nv-pd__nav--l" aria-label="上一张" data-tip="上一张"><span class="chev"></span></button>
        <button type="button" class="nv-pd__nav nv-pd__nav--r" aria-label="下一张" data-tip="下一张"><span class="chev"></span></button>
      </div>
      <div class="nv-pd__rows">
        <div class="nv-pd__r"><span>圆点</span><div class="nv-pd__i nv-pd__i--dots" role="tablist" aria-label="圆点页码"></div></div>
        <div class="nv-pd__r"><span>长条</span><div class="nv-pd__i nv-pd__i--bar" role="tablist" aria-label="长条页码"></div></div>
        <div class="nv-pd__r"><span>数字</span><div class="nv-pd__i"><span class="nv-pd__num" role="status">1 / 5</span></div></div>
        <div class="nv-pd__r"><span>分段</span><div class="nv-pd__i nv-pd__i--seg" role="tablist" aria-label="分段页码"></div></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-024" data-name="底部翻页器" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">底部翻页器</span></div>
  <p class="demo__note">适合：对账与记录类长列表用上一页下一页翻页</p>
  <div class="demo__stage">
    <div class="card nv-pn" id="nv-pn">
      <div class="nv-pn__list list" aria-live="polite"></div>
      <div class="nv-pn__bar">
        <button type="button" class="btn btn--ghost" data-d="-1">上一页</button>
        <span class="nv-pn__mid"><b>1</b> / 4</span>
        <button type="button" class="btn btn--secondary" data-d="1">下一页</button>
      </div>
    </div>
  </div>
</article>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var PHOTO = '../../kit/assets/photo/', LINE = '../../kit/assets/line/';
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };
  var CHK = '<img src="' + LINE + 'check.webp" alt="">', XIC = '<img src="' + LINE + 'close.webp" alt="">';
  function prodRow(p, meta) {
    return '<div class="row"><img class="row__lead" src="' + PHOTO + p.img + '.webp" alt=""><div class="row__main"><p class="row__title one-line">' + p.name + '</p><p class="row__meta">' + meta + '</p></div><span class="price"><small>¥</small>' + p.price + '</span></div>';
  }

  // 019 下拉筛选菜单：选项层贴着筛选条展开，选中条件常显在条上
  (function () {
    var host = $('#nv-dd'); if (!host) return;
    var trig = $$('.nv-dd__t', host), mask = $('.nv-dd__mask', host), layer = $('.nv-dd__layer', host), list = $('.nv-dd__list', host);
    var SORT = [['comp', '综合排序'], ['sales', '销量优先'], ['low', '价格最低'], ['high', '价格最高']];
    var CATS = ['全部品类', '鲜花', '绿植', '礼盒'], SCENES = ['生日', '纪念日', '探望', '开业'];
    var PRODS = [
      { name: '红玫瑰花束', price: 199, sold: 2860, cat: '鲜花', scene: ['纪念日', '生日'], img: 'product-rose-red' },
      { name: '粉芍药花束', price: 239, sold: 1890, cat: '鲜花', scene: ['生日', '探望'], img: 'product-peony-pink' },
      { name: '蓝绣球盆栽', price: 129, sold: 760, cat: '绿植', scene: ['开业', '探望'], img: 'product-hydrangea-blue' },
      { name: '花礼盒', price: 259, sold: 980, cat: '礼盒', scene: ['生日', '开业', '纪念日'], img: 'product-giftbox' }
    ];
    var st = { sort: 'sales', cat: '全部品类', scenes: [] }, tmp = [], open = '';
    function view() {
      var a = PRODS.filter(function (p) { return (st.cat === '全部品类' || p.cat === st.cat) && (!st.scenes.length || st.scenes.some(function (s) { return p.scene.indexOf(s) >= 0; })); });
      if (st.sort === 'sales') a.sort(function (x, y) { return y.sold - x.sold; });
      else if (st.sort === 'low') a.sort(function (x, y) { return x.price - y.price; });
      else if (st.sort === 'high') a.sort(function (x, y) { return y.price - x.price; });
      return a;
    }
    function sync() {
      var name = SORT.filter(function (o) { return o[0] === st.sort; })[0][1];
      var lab = [name, st.cat, st.scenes.length ? (st.scenes.length === 1 ? st.scenes[0] : '场景 ' + st.scenes.length + ' 项') : '适用场景'];
      var on = [st.sort !== 'comp', st.cat !== '全部品类', st.scenes.length > 0];
      trig.forEach(function (t, i) { $('span', t).textContent = lab[i]; t.toggleAttribute('data-on', on[i]); });
      var a = view();
      list.innerHTML = a.length ? a.map(function (p) { return prodRow(p, '已售 ' + p.sold + ' ' + p.cat); }).join('') : '<div class="nv-dd__none"><span>没有符合条件的商品</span><button type="button" class="btn btn--secondary btn--sm" data-reset>清除条件</button></div>';
    }
    function build(k) {
      if (k === 'sort') return '<div role="listbox" aria-label="排序方式">' + SORT.map(function (o) { return '<button type="button" role="option" class="nv-dd__opt" data-v="' + o[0] + '" aria-selected="' + (st.sort === o[0]) + '">' + o[1] + CHK + '</button>'; }).join('') + '</div>';
      if (k === 'cat') return '<div class="nv-dd__grid" role="listbox" aria-label="商品品类">' + CATS.map(function (c) { return '<button type="button" role="option" class="nv-dd__chip" aria-selected="' + (st.cat === c) + '">' + c + '</button>'; }).join('') + '</div>';
      return '<div class="nv-dd__grid" role="group" aria-label="适用场景">' + SCENES.map(function (c) { return '<button type="button" class="nv-dd__chip" aria-pressed="' + (tmp.indexOf(c) >= 0) + '">' + c + '</button>'; }).join('') + '</div><div class="nv-dd__foot"><button type="button" class="btn btn--ghost" data-reset>重置</button><button type="button" class="btn btn--primary" data-ok>确定</button></div>';
    }
    function show(k, quiet) {
      open = k; if (k === 'scene') tmp = st.scenes.slice();
      layer.innerHTML = build(k); mask.hidden = false; layer.hidden = false;
      trig.forEach(function (t) { t.setAttribute('aria-expanded', String(t.dataset.k === k)); });
      if (!quiet) { var f = $('[aria-selected="true"], [aria-pressed="true"], button', layer); if (f) f.focus(); }
    }
    function hide(back) {
      var k = open; open = ''; mask.hidden = true; layer.hidden = true;
      trig.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
      if (back) { var t = trig.filter(function (x) { return x.dataset.k === k; })[0]; if (t) t.focus(); }
    }
    trig.forEach(function (t) { t.addEventListener('click', function () { if (open === t.dataset.k) hide(); else show(t.dataset.k); }); });
    layer.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      if (open === 'sort') { st.sort = b.dataset.v; hide(true); sync(); }
      else if (open === 'cat') { st.cat = b.textContent; hide(true); sync(); }
      else if (b.hasAttribute('data-reset')) { tmp = []; layer.innerHTML = build('scene'); $('[data-reset]', layer).focus(); }
      else if (b.hasAttribute('data-ok')) { st.scenes = tmp.slice(); hide(true); sync(); }
      else { var s = b.textContent, i = tmp.indexOf(s); if (i >= 0) tmp.splice(i, 1); else tmp.push(s); b.setAttribute('aria-pressed', String(i < 0)); }
    });
    layer.addEventListener('keydown', function (e) {
      var d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return;
      var items = $$('button', layer), i = items.indexOf(document.activeElement); if (i < 0) return;
      items[(i + d + items.length) % items.length].focus(); e.preventDefault();
    });
    mask.addEventListener('click', function () { hide(true); });
    host.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) { hide(true); e.preventDefault(); } });
    document.addEventListener('click', function (e) { if (open && !host.contains(e.target)) hide(false); });
    list.addEventListener('click', function (e) { if (e.target.closest('[data-reset]')) { st = { sort: 'comp', cat: '全部品类', scenes: [] }; sync(); } });
    sync(); show('cat', true);
  })();

  // 020 吸顶分类标签栏：滚过头图后贴顶，点按定位，滚动时高亮跟随
  (function () {
    var host = $('#nv-sk'); if (!host) return;
    var sc = $('.nv-sk__sc', host), cover = $('.nv-sk__cover', host), bar = $('.nv-sk__tabs', host), tabs = $$('[role="tab"]', bar), secs = $$('.nv-sk__sec', host), lock = 0;
    function mark(i) { tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; }); }
    function spy() {
      bar.classList.toggle('is-stuck', sc.scrollTop >= cover.offsetHeight - 1);
      if (Date.now() < lock) return;
      var cur = 0; secs.forEach(function (s, i) { if (s.offsetTop - bar.offsetHeight - 8 <= sc.scrollTop) cur = i; }); mark(cur);
    }
    function go(i) { lock = Date.now() + 600; mark(i); sc.scrollTo({ top: secs[i].offsetTop - bar.offsetHeight, behavior: Lz.reduce ? 'auto' : 'smooth' }); }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { go(i); });
      t.addEventListener('keydown', function (e) { var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; var k = clamp(i + d, 0, tabs.length - 1); go(k); tabs[k].focus(); e.preventDefault(); });
    });
    sc.addEventListener('scroll', spy, { passive: true }); spy();
  })();

  // 021 已选条件标签条：逐个移除，放不下的收进更多
  (function () {
    var host = $('#nv-ct'); if (!host) return;
    var box = $('.nv-ct__chips', host), clear = $('.nv-ct__clear', host), pop = $('.nv-ct__pop', host), list = $('.nv-ct__list', host);
    var DEF = [{ k: 'cat', t: '鲜花' }, { k: 'price', t: '100 至 200 元' }, { k: 'fast', t: '2 小时达' }];
    var P = [
      { name: '红玫瑰花束', cat: '鲜花', price: 199, fast: true, img: 'product-rose-red' },
      { name: '粉芍药花束', cat: '鲜花', price: 239, fast: true, img: 'product-peony-pink' },
      { name: '向日葵花束', cat: '鲜花', price: 159, fast: true, img: 'product-sunflower' },
      { name: '白郁金香', cat: '鲜花', price: 179, fast: false, img: 'product-tulip-white' },
      { name: '龟背竹盆栽', cat: '绿植', price: 159, fast: false, img: 'product-monstera' }
    ];
    var conds = DEF.slice(), shown = 0;
    function has(k) { return conds.some(function (c) { return c.k === k; }); }
    function renderList() {
      var a = P.filter(function (p) { return (!has('cat') || p.cat === '鲜花') && (!has('price') || (p.price >= 100 && p.price <= 200)) && (!has('fast') || p.fast); });
      list.innerHTML = '<div class="nv-ct__sum">共 ' + a.length + ' 件</div>' + a.map(function (p) { return prodRow(p, p.fast ? '同城 2 小时达' : '次日达'); }).join('');
    }
    function chip(c) { return '<span class="nv-ct__chip" data-k="' + c.k + '">' + c.t + '<button type="button" class="nv-ct__x" aria-label="移除 ' + c.t + '" data-tip="移除">' + XIC + '</button></span>'; }
    function closePop(back) { if (pop.hidden) return; pop.hidden = true; var m = $('.nv-ct__more', box); if (m) { m.setAttribute('aria-expanded', 'false'); if (back) m.focus(); } }
    function renderPop() {
      pop.innerHTML = conds.slice(shown).map(function (c) { return '<div class="nv-ct__pr" data-k="' + c.k + '"><span>' + c.t + '</span><button type="button" class="nv-ct__x" aria-label="移除 ' + c.t + '" data-tip="移除">' + XIC + '</button></div>'; }).join('');
    }
    function fit() {
      var chips = $$('.nv-ct__chip', box), mb = $('.nv-ct__more', box), n = chips.length;
      if (!mb) { closePop(); return; }
      var gap = 8, avail = box.clientWidth;
      var wid = function (l) { return l.reduce(function (a, c) { return a + c.offsetWidth; }, 0) + gap * Math.max(0, l.length - 1); };
      chips.forEach(function (c) { c.hidden = false; }); mb.hidden = true;
      var k = n;
      if (wid(chips) > avail) {
        for (k = n - 1; k >= 0; k--) {
          mb.innerHTML = '更多 ' + (n - k) + '<span class="chev"></span>'; mb.hidden = false;
          if (wid(chips.slice(0, k)) + (k ? gap : 0) + mb.offsetWidth <= avail) break;
        }
        k = Math.max(0, k);
      }
      chips.forEach(function (c, i) { c.hidden = i >= k; });
      mb.hidden = k >= n; shown = k;
      if (k >= n) closePop(); else if (!pop.hidden) renderPop();
    }
    function render() {
      closePop();
      box.innerHTML = conds.length ? conds.map(chip).join('') + '<button type="button" class="nv-ct__more" hidden aria-haspopup="true" aria-expanded="false" aria-controls="nv-ct-pop"></button>' : '<span class="nv-ct__none">未选条件</span>';
      clear.textContent = conds.length ? '清空' : '重选';
      fit(); renderList();
    }
    function drop(k) { conds = conds.filter(function (c) { return c.k !== k; }); render(); }
    pop.id = 'nv-ct-pop';
    box.addEventListener('click', function (e) {
      var x = e.target.closest('.nv-ct__x'), m = e.target.closest('.nv-ct__more');
      if (x) { var c = x.closest('.nv-ct__chip'); c.classList.add('is-out'); setTimeout(function () { drop(c.dataset.k); }, Lz.reduce ? 0 : 140); }
      else if (m) { if (pop.hidden) { renderPop(); pop.hidden = false; m.setAttribute('aria-expanded', 'true'); } else closePop(); }
    });
    pop.addEventListener('click', function (e) {
      var x = e.target.closest('.nv-ct__x'); if (!x) return;
      drop(x.closest('.nv-ct__pr').dataset.k);
      var m = $('.nv-ct__more', box); if (m && !m.hidden) { renderPop(); pop.hidden = false; m.setAttribute('aria-expanded', 'true'); }
    });
    clear.addEventListener('click', function () { conds = conds.length ? [] : DEF.slice(); render(); });
    document.addEventListener('click', function (e) { if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.nv-ct__more')) closePop(); });
    host.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) { closePop(true); e.preventDefault(); } });
    new ResizeObserver(fit).observe(box);
    render();
  })();

  // 022 纵向步骤条：点按设为当前步，之前的为已完成
  (function () {
    var host = $('#nv-vs'); if (!host) return;
    var list = $('.nv-vs__list', host);
    var FLOWS = {
      order: ['订单进度', [['已下单', '11-09 09:12', '订单已提交 等待商家接单'], ['商家接单', '11-09 09:20', '花艺师正在包扎'], ['配送中', '11-09 10:05', '骑手已取货 预计 10:40 送达'], ['已签收', '', '']]],
      after: ['售后进度', [['提交申请', '11-09 11:30', '已选择退货退款'], ['商家审核', '11-09 14:02', '审核通过 请寄回商品'], ['商品寄回', '11-09 16:45', '等待快递揽收'], ['退款到账', '', '原路退回']]]
    };
    var key = 'order', now = { order: 2, after: 1 };
    function render() {
      var f = FLOWS[key], cur = now[key];
      list.setAttribute('aria-label', f[0]);
      list.innerHTML = f[1].map(function (s, i) {
        var t = i < cur ? 'done' : i === cur ? 'now' : 'todo';
        return '<li><button type="button" class="nv-vs__it" data-s="' + t + '" data-i="' + i + '"' + (t === 'now' ? ' aria-current="step"' : '') + '><span class="nv-vs__dot"><img src="' + LINE + 'check.webp" alt=""><b>' + (i + 1) + '</b></span><span class="nv-vs__t"><b>' + s[0] + '</b>' + (t !== 'todo' && s[2] ? '<small>' + s[2] + '</small>' : '') + '</span><span class="nv-vs__tm">' + (t === 'done' ? s[1] : t === 'now' ? '进行中' : '') + '</span></button></li>';
      }).join('');
    }
    list.addEventListener('click', function (e) {
      var b = e.target.closest('.nv-vs__it'); if (!b) return;
      now[key] = +b.dataset.i; render(); $('[data-i="' + b.dataset.i + '"]', list).focus({ preventScroll: true });
    });
    host.addEventListener('lz:seg', function (e) { key = e.detail.key; render(); });
    render();
  })();

  // 023 页码指示点：一个页码驱动圆点、长条、数字与分段
  (function () {
    var host = $('#nv-pd'); if (!host) return;
    var PAGES = [['红玫瑰花束', 'product-rose-red'], ['粉芍药花束', 'product-peony-pink'], ['向日葵花束', 'product-sunflower'], ['白郁金香', 'product-tulip-white'], ['蓝绣球盆栽', 'product-hydrangea-blue']];
    var n = PAGES.length, cur = 0;
    var img = $('.nv-pd__img', host), cap = $('.nv-pd__cap', host), num = $('.nv-pd__num', host), groups = $$('[role="tablist"]', host);
    groups.forEach(function (g) {
      g.innerHTML = PAGES.map(function (p, i) { return '<button type="button" role="tab" aria-selected="false" aria-label="第 ' + (i + 1) + ' 页" data-tip="第 ' + (i + 1) + ' 页" data-i="' + i + '"></button>'; }).join('');
      g.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) set(+b.dataset.i); });
      g.addEventListener('keydown', function (e) {
        var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return;
        var k = clamp(cur + d, 0, n - 1); set(k); $('[data-i="' + k + '"]', g).focus(); e.preventDefault();
      });
    });
    function set(i) {
      cur = (i + n) % n;
      img.src = PHOTO + PAGES[cur][1] + '.webp'; cap.textContent = PAGES[cur][0]; num.textContent = (cur + 1) + ' / ' + n;
      img.style.animation = 'none'; void img.offsetWidth; img.style.animation = '';
      groups.forEach(function (g) { $$('button', g).forEach(function (b, j) { b.setAttribute('aria-selected', String(j === cur)); b.tabIndex = j === cur ? 0 : -1; b.dataset.s = j < cur ? 'done' : j === cur ? 'now' : 'todo'; }); });
    }
    $('.nv-pd__nav--l', host).addEventListener('click', function () { set(cur - 1); });
    $('.nv-pd__nav--r', host).addEventListener('click', function () { set(cur + 1); });
    set(0);
  })();

  // 024 底部翻页器：上一页下一页，首末页对应按钮禁用
  (function () {
    var host = $('#nv-pn'); if (!host) return;
    var list = $('.nv-pn__list', host), prev = $('[data-d="-1"]', host), next = $('[data-d="1"]', host), mid = $('.nv-pn__mid', host);
    var R = [['11-08 19:16', '订单消费', -159, 151], ['11-08 14:32', '储值充值', 200, 310], ['11-07 21:03', '订单退款', 89, 110], ['11-07 09:27', '订单消费', -89, 21], ['11-06 18:44', '订单消费', -239, 110], ['11-05 12:51', '储值充值', 300, 349], ['11-04 16:09', '订单消费', -199, 49], ['11-03 10:40', '储值充值', 200, 248], ['11-02 13:22', '订单消费', -159, 48], ['11-01 17:36', '订单消费', -179, 207], ['10-30 09:58', '订单消费', -259, 386], ['10-28 14:15', '储值充值', 500, 645], ['10-26 19:07', '订单消费', -89, 145], ['10-24 11:26', '订单消费', -128, 234], ['10-22 15:48', '储值充值', 300, 362], ['10-20 10:12', '订单消费', -239, 62], ['10-18 20:33', '订单退款', 159, 301], ['10-16 12:05', '订单消费', -159, 142], ['10-13 18:20', '订单消费', -199, 301], ['10-12 09:41', '储值充值', 500, 500]];
    var SIZE = 5, pages = Math.ceil(R.length / SIZE), cur = 0;
    function render(keep) {
      list.innerHTML = R.slice(cur * SIZE, cur * SIZE + SIZE).map(function (r) {
        return '<div class="row"><div class="row__main"><p class="row__title">' + r[1] + '</p><p class="row__meta">' + r[0] + '</p></div><div class="row__trail"><span class="nv-pn__amt"' + (r[2] > 0 ? ' data-up' : '') + '>' + (r[2] > 0 ? '+' : '-') + '¥' + Math.abs(r[2]).toFixed(2) + '</span><small>余额 ¥' + r[3].toFixed(2) + '</small></div></div>';
      }).join('');
      mid.innerHTML = '<b>' + (cur + 1) + '</b> / ' + pages;
      var focused = document.activeElement;
      prev.disabled = cur === 0; next.disabled = cur === pages - 1;
      if ((prev.disabled && focused === prev) || (next.disabled && focused === next)) (prev.disabled ? next : prev).focus();
    }
    [prev, next].forEach(function (b) { b.addEventListener('click', function () { cur = clamp(cur + +b.dataset.d, 0, pages - 1); render(); }); });
    render();
  })();
})();
</script>
