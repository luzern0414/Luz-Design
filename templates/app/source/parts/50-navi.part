      <div class="nv-up__sc">
        <div class="nv-mock"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-monstera.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-succulent.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-pampas-vase.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-giftbox.webp" alt=""><div><i></i><i></i></div></div>
        <div class="nv-mock"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><i></i><i></i></div></div>
      </div>
      <button class="nv-up" aria-label="返回顶部" data-tip="返回顶部"><img src="../../kit/assets/line/back.webp" alt=""></button>
    </div>
  </div>
</article>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var PH = ['product-rose-red', 'product-peony-pink', 'product-sunflower', 'product-tulip-white', 'product-hydrangea-blue', 'product-monstera'];
  var PHOTO = '../../kit/assets/photo/';
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };
  function icon(img, name) { img.dataset.ic = name; img.src = '../../kit/assets/icons/' + Lz.iconSet() + '/' + name + '.webp'; }

  // 底栏：切换选中项，页面示意随之换图；带角标的项进入后清除角标
  $$('.nv-screen[data-tabs]').forEach(function (sc) {
    var tabs = $$('.tabbar__item', sc), imgs = $$('.nv-mock img', sc), body = $('.nv-body', sc), pos = 0;
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () {
        if (t.hasAttribute('data-fab')) { Lz.toast('开始订花'); return; }
        tabs.forEach(function (x) { if (x === t) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current'); });
        var k = tabs.filter(function (x) { return !x.hasAttribute('data-fab'); }).indexOf(t);
        sc.dataset.i = k;
        imgs.forEach(function (im, j) { im.src = PHOTO + PH[(k * 2 + j + 1) % PH.length] + '.webp'; });
        body.classList.remove('nv-swap'); void body.offsetWidth; body.classList.add('nv-swap');
        if (sc.hasAttribute('data-clear')) $$('[data-b]', t).forEach(function (b) { b.classList.add('nv-gone'); setTimeout(function () { b.remove(); }, 160); });
      });
    });
  });

  // 顶栏图标：给出轻提示
  $$('[data-nv-toast]').forEach(function (b) { b.addEventListener('click', function () { Lz.toast(b.dataset.nvToast); }); });

  // 搜索顶栏：清除与提交
  (function () {
    var host = $('#nv-sb'); if (!host) return;
    var inp = $('input', host), clr = $('.search button', host), go = $('.btn--text', host);
    inp.addEventListener('input', function () { clr.hidden = !inp.value; });
    clr.addEventListener('click', function () { inp.value = ''; clr.hidden = true; inp.focus(); });
    function submit() { var v = inp.value.trim(); Lz.toast(v ? '搜索 ' + v : '请输入关键词', v ? 'success' : 'danger'); }
    go.addEventListener('click', submit);
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.isComposing) submit(); });
  })();

  // 定位顶栏：选门店
  (function () {
    var host = $('#nv-lb'); if (!host) return;
    var loc = $('.loc', host), menu = $('.nv-menu', host), label = $('.loc span', host);
    var toggle = function (open) { menu.hidden = !open; loc.setAttribute('aria-expanded', String(open)); };
    loc.addEventListener('click', function (e) { e.stopPropagation(); toggle(menu.hidden); });
    $$('button', menu).forEach(function (b) {
      b.addEventListener('click', function () {
        $$('button', menu).forEach(function (x) { x.setAttribute('aria-selected', String(x === b)); });
        label.textContent = b.firstChild.textContent; toggle(false); loc.focus();
      });
    });
    document.addEventListener('click', function (e) { if (!menu.hidden && !menu.contains(e.target)) toggle(false); });
    host.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hidden) { toggle(false); loc.focus(); } });
  })();

  // 透明叠图顶栏
  (function () {
    var host = $('#nv-ov'); if (!host) return;
    var sc = $('.nv-ov__sc', host), bar = $('.nv-ov__bar', host);
    function sync() { var p = clamp((sc.scrollTop - 60) / 70, 0, 1); bar.style.setProperty('--p', p); host.classList.toggle('is-solid', p > .6); }
    sc.addEventListener('scroll', sync, { passive: true }); sync();
  })();

  // 大标题顶栏
  (function () {
    var host = $('#nv-lg'); if (!host) return;
    var sc = $('.nv-lg__sc', host);
    function sync() { host.style.setProperty('--p', clamp(sc.scrollTop / 34, 0, 1)); }
    sc.addEventListener('scroll', sync, { passive: true }); sync();
  })();

  // 滑块分段切换
  (function () {
    var host = $('#nv-sw'); if (!host) return;
    var tabs = $$('[role="tab"]', host), card = host.parentElement.querySelector('.nv-sw__info');
    var data = [['scooter', '同城配送', '2 小时内送达', '8'], ['pin', '到店自提', '建国路店', '0'], ['bag', '全国快递', '次日达', '12']];
    function set(i) {
      host.dataset.i = i; tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      var d = data[i]; icon($('img', card), d[0]); $('b', card).textContent = d[1]; $('div span', card).textContent = d[2];
      $('.price', card).innerHTML = d[3] === '0' ? '免费' : '<small>¥</small>' + d[3];
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { set(i); });
      t.addEventListener('keydown', function (e) { var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; var n = (i + d + tabs.length) % tabs.length; set(n); tabs[n].focus(); e.preventDefault(); });
    });
    set(0);
  })();

  // 下划线标签栏
  (function () {
    var host = $('#nv-ul'); if (!host) return;
    var tabs = $$('[role="tab"]', host), bar = $('.nv-ul__bar', host), panel = $('.nv-ulp', host);
    var views = [
      '<div class="row"><img class="row__lead" src="' + PHOTO + 'product-rose-red.webp" alt=""><div class="row__main"><p class="row__title">红玫瑰花束</p><p class="row__meta">19 枝 牛皮纸包装</p></div><span class="price"><small>¥</small>199</span></div>',
      '<div class="nv-ulp__kv"><span>好评率</span><b>98%</b></div><div class="nv-ulp__kv"><span>带图评价</span><b>128 条</b></div><div class="nv-ulp__kv"><span>追加评价</span><b>41 条</b></div>',
      '<div class="nv-ulp__kv"><span>花材</span><b>红玫瑰 配尤加利</b></div><div class="nv-ulp__kv"><span>花期</span><b>5 至 7 天</b></div><div class="nv-ulp__kv"><span>配送</span><b>同城 2 小时</b></div>',
      '<div class="nv-ulp__tn"><img src="' + PHOTO + 'product-peony-pink.webp" alt=""><img src="' + PHOTO + 'product-sunflower.webp" alt=""><img src="' + PHOTO + 'product-tulip-white.webp" alt=""></div>'
    ];
    function place(btn) { var t = $('span', btn); bar.style.width = t.offsetWidth + 'px'; bar.style.transform = 'translateX(' + (btn.offsetLeft + (btn.offsetWidth - t.offsetWidth) / 2) + 'px)'; }
    function set(i, instant) {
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      if (instant) bar.style.transition = 'none'; place(tabs[i]); if (instant) { void bar.offsetWidth; bar.style.transition = ''; }
      panel.style.animation = 'none'; void panel.offsetWidth; panel.style.animation = ''; panel.innerHTML = views[i];
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { set(i); });
      t.addEventListener('keydown', function (e) { var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; var n = clamp(i + d, 0, tabs.length - 1); set(n); tabs[n].focus(); e.preventDefault(); });
    });
    set(0, true); new ResizeObserver(function () { place(tabs.filter(function (t) { return t.getAttribute('aria-selected') === 'true'; })[0]); }).observe(host);
  })();

  // 步骤条：点按设为当前步，之前的为已完成
  (function () {
    var host = $('#nv-steps'); if (!host) return;
    var items = $$('li', host);
    items.forEach(function (li, i) {
      $('.nv-step', li).addEventListener('click', function () {
        items.forEach(function (x, j) {
          x.dataset.s = j < i ? 'done' : j === i ? 'now' : 'todo';
          var b = $('.nv-step', x); if (j === i) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
        });
      });
    });
  })();

  // 锚点分类侧栏：点按定位，滚动时高亮
  (function () {
    var host = $('#nv-anc'); if (!host) return;
    var sc = $('.nv-anc__sc', host), tabs = $$('.nv-anc__rail button', host), secs = $$('.nv-anc__sec', host), lock = 0;
    function mark(i) { tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(j === i)); }); }
    tabs.forEach(function (t, i) { t.addEventListener('click', function () { lock = Date.now() + 600; mark(i); sc.scrollTo({ top: secs[i].offsetTop, behavior: Lz.reduce ? 'auto' : 'smooth' }); }); });
    sc.addEventListener('scroll', function () {
      if (Date.now() < lock) return;
      var cur = 0; secs.forEach(function (s, i) { if (s.offsetTop - 12 <= sc.scrollTop) cur = i; }); mark(cur);
    }, { passive: true });
  })();

  // 单行筛选条：排序真实改变下方列表
  (function () {
    var host = $('#nv-flt'); if (!host) return;
    var list = $('#nv-plist'), drop = $('.drop', host), sales = $('[data-sales]', host), price = $('[data-price]', host), more = $('[data-more]', host);
    var all = [['红玫瑰花束', 199, 2860, 98, 1.2, 'product-rose-red'], ['粉芍药花束', 239, 1890, 99, 2.4, 'product-peony-pink'], ['向日葵花束', 159, 2214, 96, .8, 'product-sunflower'], ['白郁金香', 179, 1530, 97, 3.1, 'product-tulip-white']];
    var st = { base: 'comp', sales: false, price: '' };
    function render() {
      var a = all.slice();
      if (st.price) a.sort(function (x, y) { return st.price === 'asc' ? x[1] - y[1] : y[1] - x[1]; });
      else if (st.sales) a.sort(function (x, y) { return y[2] - x[2]; });
      else if (st.base === 'rate') a.sort(function (x, y) { return y[3] - x[3]; });
      else if (st.base === 'near') a.sort(function (x, y) { return x[4] - y[4]; });
      list.innerHTML = a.map(function (p, i) {
        return '<div class="row" style="animation-delay:' + i * 40 + 'ms"><img class="row__lead" src="' + PHOTO + p[5] + '.webp" alt=""><div class="row__main"><p class="row__title one-line">' + p[0] + '</p><p class="row__meta">已售 ' + p[2] + ' 好评 ' + p[3] + '%</p></div><span class="price"><small>¥</small>' + p[1] + '</span></div>';
      }).join('');
      sales.toggleAttribute('data-on', st.sales && !st.price); price.toggleAttribute('data-on', !!st.price); price.dataset.s = st.price;
      $('.drop__btn', drop).toggleAttribute('data-on', st.base !== 'comp' && !st.sales && !st.price);
    }
    drop.addEventListener('lz:drop', function (e) { var k = $('[aria-selected="true"]', drop); st.base = k ? k.dataset.k : 'comp'; st.sales = false; st.price = ''; render(); });
    sales.addEventListener('click', function () { st.sales = !st.sales; st.price = ''; render(); });
    price.addEventListener('click', function () { st.price = st.price === '' ? 'asc' : st.price === 'asc' ? 'desc' : ''; st.sales = false; render(); });
    more.addEventListener('click', function () { var on = more.hasAttribute('data-on'); more.toggleAttribute('data-on', !on); Lz.toast(on ? '已清除筛选' : '已打开筛选页'); });
    render();
  })();

  // 返回顶部
  (function () {
    var host = $('#nv-up'); if (!host) return;
    var sc = $('.nv-up__sc', host), btn = $('.nv-up', host);
    function sync() { var max = sc.scrollHeight - sc.clientHeight; btn.style.setProperty('--p', max > 0 ? sc.scrollTop / max * 100 : 0); btn.classList.toggle('is-on', sc.scrollTop > 90); }
    sc.addEventListener('scroll', sync, { passive: true }); sync();
    btn.addEventListener('click', function () { sc.scrollTo({ top: 0, behavior: Lz.reduce ? 'auto' : 'smooth' }); });
  })();
})();
</script>

<style>
/* 新增：下拉筛选、吸顶标签、已选条件、纵向步骤、页码点、翻页器；类名带 nv-dd- nv-sk- nv-ct- nv-vs- nv-pd- nv-pn- */
@keyframes nv-drop { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

/* 下拉筛选菜单：选项层贴着筛选条展开，下方列表压暗但不移动 */
.nv-dd { position: relative; overflow: hidden; }
.nv-dd__bar { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); background: var(--surface); }
.nv-dd__t { display: inline-flex; align-items: center; justify-content: center; gap: var(--s-1); min-height: 48px; padding: 0 var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; transition: color var(--dur-quick) var(--ease-out); }
.nv-dd__t::after { content: ""; width: 6px; height: 6px; border: solid var(--ink-3); border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translate(-1px, -1px); transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-quick) var(--ease-out); }
.nv-dd__t[aria-expanded="true"] { color: var(--ink); font-weight: 600; }
.nv-dd__t[aria-expanded="true"]::after { transform: rotate(225deg) translate(-1px, -1px); border-color: var(--ink); }
.nv-dd__t[data-on] { color: var(--action-press); font-weight: 600; }
.nv-dd__t[data-on]::after { border-color: var(--action); }
.nv-dd__list { min-height: 240px; }
.nv-dd__list .row { min-height: 60px; padding: var(--s-2) var(--s-4); animation: lz-rise var(--dur-base) var(--ease-out) both; }
.nv-dd__none { display: grid; justify-items: center; align-content: center; gap: var(--s-3); min-height: 240px; font-size: var(--fs-sm); color: var(--ink-3); }
.nv-dd__mask { position: absolute; z-index: 4; left: 0; right: 0; top: 49px; bottom: 0; background: color-mix(in srgb, var(--ink) 34%, transparent); animation: lz-fade var(--dur-quick) var(--ease-out) both; }
.nv-dd__layer { position: absolute; z-index: 5; left: 0; right: 0; top: 49px; overflow: hidden; border-radius: 0 0 var(--r-md) var(--r-md); background: var(--surface); box-shadow: var(--elev-2); animation: nv-drop var(--dur-base) var(--ease-out) both; }
.nv-dd__opt { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 48px; padding: 0 var(--s-4); font-size: var(--fs-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.nv-dd__opt + .nv-dd__opt { border-top: 1px solid var(--line); }
.nv-dd__opt img { width: 18px; height: 18px; opacity: 0; }
.nv-dd__opt[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
.nv-dd__opt[aria-selected="true"] img { opacity: 1; }
@media (hover: hover) { .nv-dd__opt:not([aria-selected="true"]):hover { background: var(--zone); } }
.nv-dd__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); padding: var(--s-4); }
.nv-dd__chip { min-height: 40px; padding: 0 var(--s-2); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
.nv-dd__chip[aria-selected="true"], .nv-dd__chip[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1.5px var(--action); color: var(--action-press); font-weight: 600; }
.nv-dd__chip:active { transform: scale(.96); }
.nv-dd__foot { display: flex; gap: var(--s-2); padding: 0 var(--s-4) var(--s-4); }
.nv-dd__foot .btn { flex: 1; }

/* 吸顶分类标签栏：滚过头图后标签贴住顶部，滚动时高亮跟随 */
.nv-sk__sc { position: relative; flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; }
.nv-sk__sc::-webkit-scrollbar { display: none; }
.nv-sk__cover { display: block; width: 100%; height: 104px; object-fit: cover; }
.nv-sk__tabs { position: sticky; top: 0; z-index: 3; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--bg); border-bottom: 1px solid transparent; transition: box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
.nv-sk__tabs.is-stuck { border-bottom-color: var(--line); box-shadow: var(--elev-1); }
.nv-sk__tabs button { position: relative; min-height: 48px; font-size: var(--fs-md); color: var(--ink-2); transition: color var(--dur-quick) var(--ease-out); }
.nv-sk__tabs button[aria-selected="true"] { color: var(--ink); font-weight: 600; }
.nv-sk__tabs button[aria-selected="true"]::after { content: ""; position: absolute; left: 50%; bottom: 6px; width: 20px; height: 3px; margin-left: -10px; border-radius: 3px; background: var(--action); }
.nv-sk__sec { padding: var(--s-3) var(--s-4) 0; }
.nv-sk__sec h3 { padding: 0 0 var(--s-2) var(--s-1); font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.nv-sk__sec .row { min-height: 64px; padding: var(--s-2) var(--s-3); }
.nv-sk__sec .row__lead { width: 48px; height: 48px; }
.nv-sk__pad { height: 120px; }

/* 已选条件标签条：单行，放不下的收进“更多”下拉 */
.nv-ct { position: relative; }
.nv-ct__bar { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-3); }
.nv-ct__chips { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--s-2); overflow: hidden; }
.nv-ct__chip, .nv-ct__more { flex: none; display: inline-flex; align-items: center; gap: 2px; min-height: 32px; border-radius: var(--r-full); font-size: var(--fs-sm); font-weight: 500; white-space: nowrap; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
.nv-ct__chip { padding: 0 4px 0 var(--s-3); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); color: var(--action-press); }
.nv-ct__chip.is-out { opacity: 0; transform: scale(.8); }
.nv-ct__x { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; transition: background var(--dur-quick) var(--ease-out); }
.nv-ct__x img { width: 12px; height: 12px; }
@media (hover: hover) { .nv-ct__x:hover { background: var(--action-soft); } }
.nv-ct__more { padding: 0 var(--s-3); background: var(--zone); color: var(--ink-2); }
.nv-ct__more[aria-expanded="true"] { background: var(--action-soft); color: var(--action-press); }
.nv-ct__none { padding-left: var(--s-1); font-size: var(--fs-sm); color: var(--ink-3); }
.nv-ct__clear { flex: none; min-height: 32px; }
.nv-ct__sum { display: flex; align-items: center; min-height: 36px; padding: 0 var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.nv-ct__list { min-height: 112px; }
.nv-ct__list .row { min-height: 56px; padding: var(--s-2) var(--s-4); animation: lz-rise var(--dur-base) var(--ease-out) both; }
.nv-ct__list .row__lead { width: 40px; height: 40px; }
.nv-ct__pop { position: absolute; z-index: 6; top: 52px; left: var(--s-3); width: 208px; padding: var(--s-1); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-3); animation: nv-drop var(--dur-quick) var(--ease-out) both; }
.nv-ct__pr { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 0 var(--s-1) 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); }

/* 纵向步骤条 */
.nv-vs { padding: var(--s-4); }
.nv-vs .seg { padding: 0; margin-bottom: var(--s-4); }
.nv-vs__list { display: grid; }
.nv-vs__it { position: relative; display: grid; grid-template-columns: 28px 1fr auto; column-gap: var(--s-3); width: 100%; padding-bottom: var(--s-5); text-align: left; border-radius: var(--r-md); }
li:last-child > .nv-vs__it { padding-bottom: 0; }
.nv-vs__it::before { content: ""; position: absolute; left: 13px; top: 32px; bottom: 4px; width: 2px; border-radius: 2px; background: var(--line-strong); transition: background var(--dur-slow) var(--ease-out); }
li:last-child > .nv-vs__it::before { display: none; }
.nv-vs__it[data-s="done"]::before { background: var(--action); }
.nv-vs__dot { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--zone); transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
.nv-vs__dot b { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-3); }
.nv-vs__dot img { display: none; width: 14px; height: 14px; filter: invert(1); }
.nv-vs__it[data-s="done"] .nv-vs__dot { background: var(--action); }
.nv-vs__it[data-s="done"] .nv-vs__dot img { display: block; }
.nv-vs__it[data-s="done"] .nv-vs__dot b { display: none; }
.nv-vs__it[data-s="now"] .nv-vs__dot { background: var(--surface); box-shadow: inset 0 0 0 2px var(--action), 0 0 0 5px var(--action-tint); }
.nv-vs__it[data-s="now"] .nv-vs__dot b { color: var(--action-press); }
.nv-vs__t { min-width: 0; }
.nv-vs__t b { display: block; font-size: var(--fs-md); font-weight: 600; line-height: 28px; }
.nv-vs__it[data-s="todo"] .nv-vs__t b { font-weight: 500; color: var(--ink-3); }
.nv-vs__t small { display: block; font-size: var(--fs-sm); line-height: 1.45; color: var(--ink-3); }
.nv-vs__tm { font-size: var(--fs-sm); line-height: 28px; color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
.nv-vs__it[data-s="now"] .nv-vs__tm { color: var(--action-press); font-weight: 600; }

/* 页码指示点：同一页码驱动四种样式 */
.nv-pd { display: grid; gap: var(--s-3); padding: var(--s-4); }
.nv-pd__view { position: relative; overflow: hidden; border-radius: var(--r-md); background: var(--zone); }
.nv-pd__img { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; object-position: center 42%; animation: lz-fade var(--dur-base) var(--ease-out) both; }
.nv-pd__cap { position: absolute; left: var(--s-3); bottom: var(--s-3); height: 28px; padding: 0 var(--s-3); border-radius: var(--r-full); background: color-mix(in srgb, var(--ink) 56%, transparent); color: var(--surface); font-size: var(--fs-sm); line-height: 28px; }
.nv-pd__nav { position: absolute; top: 50%; display: grid; place-items: center; width: 32px; height: 32px; margin-top: -16px; border-radius: 50%; background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--elev-1); transition: transform var(--dur-instant) var(--ease-out); }
.nv-pd__nav--l { left: var(--s-2); }
.nv-pd__nav--r { right: var(--s-2); }
.nv-pd__nav .chev::after { margin: 0; }
.nv-pd__nav--l .chev::after { transform: rotate(135deg); }
.nv-pd__nav:active { transform: scale(.92); }
.nv-pd__rows { display: grid; }
.nv-pd__r { display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; min-height: 44px; }
.nv-pd__r + .nv-pd__r { border-top: 1px solid var(--line); }
.nv-pd__r > span { font-size: var(--fs-sm); color: var(--ink-3); }
.nv-pd__i { display: flex; align-items: center; justify-content: center; }
.nv-pd__i button { display: grid; place-items: center; height: 32px; }
.nv-pd__i--dots button { width: 22px; }
.nv-pd__i--dots button::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); transition: background var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.nv-pd__i--dots button[aria-selected="true"]::before { background: var(--action); transform: scale(1.25); }
.nv-pd__i--bar button { width: 26px; }
.nv-pd__i--bar button::before { content: ""; width: 18px; height: 4px; border-radius: var(--r-full); background: var(--line-strong); transition: width var(--dur-base) var(--ease-out), background var(--dur-quick) var(--ease-out); }
.nv-pd__i--bar button[aria-selected="true"]::before { width: 26px; background: var(--action); }
.nv-pd__i--seg { gap: var(--s-1); }
.nv-pd__i--seg button { width: 40px; }
.nv-pd__i--seg button::before { content: ""; width: 100%; height: 4px; border-radius: var(--r-full); background: var(--line-strong); transition: background var(--dur-base) var(--ease-out); }
.nv-pd__i--seg button[data-s="done"]::before { background: var(--action-edge); }
.nv-pd__i--seg button[data-s="now"]::before { background: var(--action); }
.nv-pd__num { height: 28px; padding: 0 var(--s-3); border-radius: var(--r-full); background: color-mix(in srgb, var(--ink) 56%, transparent); color: var(--surface); font-size: var(--fs-sm); line-height: 28px; font-variant-numeric: tabular-nums; }

/* 底部翻页器 */
.nv-pn { overflow: hidden; }
.nv-pn__list { min-height: 280px; }
.nv-pn__list .row { min-height: 56px; padding: var(--s-2) var(--s-4); animation: lz-fade var(--dur-base) var(--ease-out) both; }
.nv-pn__amt { font-weight: 600; font-variant-numeric: tabular-nums; }
.nv-pn__amt[data-up] { color: var(--success); }
.nv-pn__list .row__trail small { font-size: var(--fs-xs); color: var(--ink-3); }
.nv-pn__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
.nv-pn__bar .btn:first-child { justify-self: start; }
.nv-pn__bar .btn:last-child { justify-self: end; }
.nv-pn__bar .btn { padding: 0 var(--s-4); }
.nv-pn__mid { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.nv-pn__mid b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
</style>

<article class="demo" data-cid="AP-NAVI-019" data-name="下拉筛选菜单" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">下拉筛选菜单</span></div>
  <p class="demo__note">适合：筛选条点击后在条下就近展开选项层，选中条件常显</p>
  <div class="demo__stage">
    <div class="card nv-dd" id="nv-dd">
      <div class="nv-dd__bar" role="toolbar" aria-label="筛选条件">
        <button type="button" class="nv-dd__t" data-k="sort" aria-haspopup="listbox" aria-expanded="false" aria-controls="nv-dd-layer"><span>综合排序</span></button>
        <button type="button" class="nv-dd__t" data-k="cat" aria-haspopup="listbox" aria-expanded="false" aria-controls="nv-dd-layer"><span>全部品类</span></button>
        <button type="button" class="nv-dd__t" data-k="scene" aria-haspopup="true" aria-expanded="false" aria-controls="nv-dd-layer"><span>适用场景</span></button>
      </div>
      <div class="nv-dd__list" aria-live="polite"></div>
      <div class="nv-dd__mask" hidden></div>
      <div class="nv-dd__layer" id="nv-dd-layer" hidden></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-020" data-name="吸顶分类标签栏" data-cat="NAVI">
