<article class="demo" data-cid="AP-NAVI-013" data-name="胶囊标签栏" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">胶囊标签栏</span></div>
  <p class="demo__note">适合：订单状态等六个以内的类别，单行横滑，只筛选下方内容</p>
  <div class="demo__stage">
    <div class="seg" data-seg="nv-ol" data-seg-for="#nv-ol" role="tablist" aria-label="订单状态">
      <button class="seg__item" data-key="all" aria-selected="true">全部</button>
      <button class="seg__item" data-key="pay" aria-selected="false">待付款<small>1</small></button>
      <button class="seg__item" data-key="ship" aria-selected="false">待发货<small>1</small></button>
      <button class="seg__item" data-key="recv" aria-selected="false">待收货<small>1</small></button>
      <button class="seg__item" data-key="done" aria-selected="false">已完成</button>
      <button class="seg__item" data-key="after" aria-selected="false">售后</button>
    </div>
    <div class="card list nv-ol" id="nv-ol">
      <div class="row" data-cat="pay"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title one-line">红玫瑰花束</p><p class="row__meta">¥199</p></div><span class="tag" data-tone="warning">待付款</span></div>
      <div class="row" data-cat="ship"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="row__main"><p class="row__title one-line">粉芍药花束</p><p class="row__meta">¥239</p></div><span class="tag" data-tone="info">待发货</span></div>
      <div class="row" data-cat="recv"><img class="row__lead" src="../../kit/assets/photo/product-monstera.webp" alt=""><div class="row__main"><p class="row__title one-line">龟背竹盆栽</p><p class="row__meta">¥159</p></div><span class="tag" data-tone="action">待收货</span></div>
      <div class="row" data-cat="done"><img class="row__lead" src="../../kit/assets/photo/product-giftbox.webp" alt=""><div class="row__main"><p class="row__title one-line">花礼盒</p><p class="row__meta">¥259</p></div><span class="tag" data-tone="success">已完成</span></div>
      <div class="row" data-cat="after"><img class="row__lead" src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><div class="row__main"><p class="row__title one-line">蓝绣球盆栽</p><p class="row__meta">¥129</p></div><span class="tag" data-tone="danger">售后</span></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-014" data-name="下划线标签栏" data-cat="NAVI">
