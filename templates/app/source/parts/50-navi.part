  <div class="demo__stage is-plain nv-st">
    <div class="nv-screen nv-screen--tall" id="nv-sk">
      <div class="nv-sk__sc">
        <img class="nv-sk__cover" src="../../kit/assets/photo/bg-floral.webp" alt="">
        <div class="nv-sk__tabs" role="tablist" aria-label="商品分类">
          <button type="button" role="tab" aria-selected="true">鲜花</button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1">绿植</button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1">礼盒</button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1">花器</button>
        </div>
        <section class="nv-sk__sec"><h3>鲜花</h3>
          <div class="card list">
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title one-line">红玫瑰花束</p><p class="row__meta">同城 2 小时达</p></div><span class="price"><small>¥</small>199</span></div>
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="row__main"><p class="row__title one-line">粉芍药花束</p><p class="row__meta">同城 2 小时达</p></div><span class="price"><small>¥</small>239</span></div>
          </div>
        </section>
        <section class="nv-sk__sec"><h3>绿植</h3>
          <div class="card list">
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-monstera.webp" alt=""><div class="row__main"><p class="row__title one-line">龟背竹盆栽</p><p class="row__meta">次日达</p></div><span class="price"><small>¥</small>159</span></div>
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-succulent.webp" alt=""><div class="row__main"><p class="row__title one-line">多肉组合盆</p><p class="row__meta">次日达</p></div><span class="price"><small>¥</small>89</span></div>
          </div>
        </section>
        <section class="nv-sk__sec"><h3>礼盒</h3>
          <div class="card list">
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-giftbox.webp" alt=""><div class="row__main"><p class="row__title one-line">花礼盒</p><p class="row__meta">同城 2 小时达</p></div><span class="price"><small>¥</small>259</span></div>
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/bouquet-rose.webp" alt=""><div class="row__main"><p class="row__title one-line">玫瑰礼束</p><p class="row__meta">同城 2 小时达</p></div><span class="price"><small>¥</small>219</span></div>
          </div>
        </section>
        <section class="nv-sk__sec"><h3>花器</h3>
          <div class="card list">
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-pampas-vase.webp" alt=""><div class="row__main"><p class="row__title one-line">干花花瓶摆件</p><p class="row__meta">次日达</p></div><span class="price"><small>¥</small>129</span></div>
          </div>
        </section>
        <div class="nv-sk__pad"></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-021" data-name="已选条件标签条" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">已选条件标签条</span></div>
