<!-- cat: NAVI | 导航 -->
<style>
/* 导航：手机屏框内展示，底栏全宽贴框底、不透明；所有类名带 nv- 前缀 */
.demo__stage.nv-st { border: 0; }
.nv-screen { position: relative; display: flex; flex-direction: column; overflow: hidden; outline: 1px solid var(--line); outline-offset: -1px; border-radius: var(--r-md); background: var(--bg); }
.nv-screen--tall { height: 280px; }
.nv-screen .tabbar { position: relative; left: auto; bottom: auto; width: 100%; transform: none; flex: none; }
.nv-body { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: max-content; align-content: start; gap: var(--s-3); padding: var(--s-4); overflow: hidden; }
.nv-mock { display: grid; align-content: start; gap: var(--s-2); padding-bottom: var(--s-3); overflow: hidden; border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); }
.nv-mock img { width: 100%; height: 76px; object-fit: cover; background: var(--zone); }
.nv-mock > div { padding: 0 var(--s-3); }
.nv-mock i { display: block; height: 8px; border-radius: var(--r-full); background: var(--zone); }
.nv-mock i + i { width: 50%; margin-top: 8px; }
.nv-swap .nv-mock { animation: lz-fade var(--dur-base) var(--ease-out) both; }
.tabbar button.tabbar__item { font-family: inherit; }
.nv-dot { position: absolute; top: 6px; right: calc(50% - 20px); width: 10px; height: 10px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 2px var(--bg); animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.nv-gone { opacity: 0; transform: scale(.4); transition: opacity var(--dur-quick), transform var(--dur-quick); }

/* 三项顶线底栏：选中项上方一条主色线滑动 */
.nv-top3 .tabbar__item[aria-current="page"] { background: none; box-shadow: none; }
.nv-line { position: absolute; top: -1px; left: var(--s-2); width: calc((100% - 6 * var(--s-1)) / 3); height: 3px; border-radius: 0 0 3px 3px; background: var(--action); transition: transform var(--dur-slow) var(--ease-spring); }
.nv-screen[data-i="1"] .nv-line { transform: translateX(calc(100% + var(--s-1))); }
.nv-screen[data-i="2"] .nv-line { transform: translateX(calc(200% + 2 * var(--s-1))); }

/* 中间凸起底栏 */
.nv-fabitem { gap: 2px; }
.nv-fab { display: grid; place-items: center; width: 56px; height: 56px; margin-top: -30px; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 5px var(--bg), var(--elev-3); transition: transform var(--dur-base) var(--ease-spring); }
.nv-fab img { width: 38px; height: 38px; object-fit: contain; filter: drop-shadow(0 4px 5px color-mix(in srgb, var(--ink) 18%, transparent)); }
.nv-fabitem:active { transform: none; }
.nv-fabitem:active .nv-fab { transform: scale(.9); }
.nv-fabitem span:last-child { color: var(--action-press); font-weight: 600; }

/* 顶栏 */
.nv-head { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 var(--s-2) 0 var(--s-4); background: var(--bg); border-bottom: 1px solid var(--line); }
.nv-head h2 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
.nv-head__a { display: flex; }
.nv-nav { display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; min-height: 52px; padding: 0 var(--s-2); background: var(--bg); border-bottom: 1px solid var(--line); }
.nv-nav h2 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); text-align: center; }
.nv-sbar { display: flex; align-items: center; gap: var(--s-1); min-height: 56px; padding: 0 var(--s-2); background: var(--bg); border-bottom: 1px solid var(--line); }
.nv-sbar .search { flex: 1; min-width: 0; }
.nv-sbar .search input::-webkit-search-cancel-button, .nv-lbar .search input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
.nv-sbar .search button { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; }
.nv-sbar .search button img { width: 16px; height: 16px; }
.nv-sbar .btn--text { flex: none; min-height: 40px; font-size: var(--fs-md); font-weight: 600; }
.nv-lbar { position: relative; display: flex; align-items: center; gap: var(--s-2); min-height: 56px; padding: 0 var(--s-2) 0 var(--s-3); background: var(--bg); border-bottom: 1px solid var(--line); }
.nv-lbar .loc { max-width: 124px; flex: none; font-size: var(--fs-md); }
.nv-lbar .loc .chev::after { margin-left: 2px; transform: rotate(45deg) translateY(-2px); }
.nv-lbar .loc[aria-expanded="true"] .chev::after { transform: rotate(225deg); }
.nv-lbar .search { flex: 1; min-width: 0; }
.nv-menu { position: absolute; z-index: 8; top: calc(100% - 2px); left: var(--s-3); width: 216px; padding: var(--s-1); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-3); transform-origin: top left; animation: lz-dialog var(--dur-quick) var(--ease-out) both; }
.nv-menu button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); text-align: left; }
.nv-menu button img { width: 16px; height: 16px; opacity: 0; }
.nv-menu button[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
.nv-menu button[aria-selected="true"] img { opacity: 1; }
@media (hover: hover) { .nv-menu button:hover { background: var(--zone); } }

/* 透明叠图顶栏：随滚动由透明过渡为实底 */
.nv-ov__bar { position: absolute; z-index: 3; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 56px; padding: 0 var(--s-3); isolation: isolate; }
.nv-ov__bar::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--bg); border-bottom: 1px solid var(--line); opacity: var(--p, 0); }
.nv-ov__b { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: color-mix(in srgb, var(--surface) 86%, transparent); box-shadow: var(--elev-1); transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
.nv-ov__b img { width: 20px; height: 20px; }
.nv-ov__t { flex: 1; font-size: var(--fs-md); font-weight: 600; text-align: center; opacity: var(--p, 0); }
.nv-ov.is-solid .nv-ov__b { background: transparent; box-shadow: none; }
.nv-ov__sc { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; }
.nv-ov__sc::-webkit-scrollbar { display: none; }
.nv-ov__cover { width: 100%; height: 168px; object-fit: cover; }
.nv-ov__info { position: relative; display: grid; gap: var(--s-2); margin-top: -18px; padding: var(--s-4); border-radius: var(--r-lg) var(--r-lg) 0 0; background: var(--bg); }
.nv-ov__info b { font-size: var(--fs-lg); font-weight: 700; line-height: var(--lh-tight); }
.nv-ov__tags { display: flex; gap: var(--s-2); }
.nv-ov__lines { display: grid; gap: var(--s-3); padding: var(--s-2) var(--s-4) var(--s-6); }
.nv-ov__lines i { display: block; height: 10px; border-radius: var(--r-full); background: var(--zone); }

/* 大标题顶栏：折叠为居中小标题 */
.nv-lg__bar { position: relative; z-index: 3; display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; min-height: 48px; padding: 0 var(--s-2); background: var(--bg); isolation: isolate; }
.nv-lg__bar::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 1px solid var(--line); opacity: var(--p, 0); }
.nv-lg__bar h2 { font-size: var(--fs-md); font-weight: 600; text-align: center; opacity: var(--p, 0); }
.nv-lg__sc { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; padding: 0 var(--s-4) var(--s-4); }
.nv-lg__sc::-webkit-scrollbar { display: none; }
.nv-lg__t { padding: 0 0 var(--s-3) var(--s-1); font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); opacity: calc(1 - var(--p, 0)); transform: translateY(calc(var(--p, 0) * -6px)); transform-origin: left center; }
.nv-lg__sc .row__lead { width: 48px; height: 48px; }

/* 滑块分段切换 */
.nv-sw { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); padding: 3px; border-radius: var(--r-md); background: var(--zone); }
.nv-sw__t { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / 3); border-radius: 9px; background: var(--surface); box-shadow: var(--elev-1); transition: transform var(--dur-slow) var(--ease-spring); }
.nv-sw[data-i="1"] .nv-sw__t { transform: translateX(100%); }
.nv-sw[data-i="2"] .nv-sw__t { transform: translateX(200%); }
.nv-sw button { position: relative; min-height: 40px; font-size: var(--fs-sm); color: var(--ink-2); border-radius: 9px; transition: color var(--dur-quick) var(--ease-out); }
.nv-sw button[aria-selected="true"] { color: var(--action-press); font-weight: 600; }
.nv-sw__info { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; column-gap: var(--s-3); margin-top: var(--s-3); padding: var(--s-3) var(--s-4); }
.nv-sw__info img { width: 44px; height: 44px; object-fit: contain; filter: drop-shadow(0 4px 6px color-mix(in srgb, var(--ink) 14%, transparent)); }
.nv-sw__info b { display: block; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.nv-sw__info div span { font-size: var(--fs-sm); color: var(--ink-3); }

/* 胶囊标签栏下的订单示意 */
.nv-ol { display: grid; margin-top: var(--s-3); }
.nv-ol .row { min-height: 60px; padding: var(--s-2) var(--s-4); }
.nv-ol .row__lead { width: 44px; height: 44px; }

/* 下划线标签栏 */
.nv-ul { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); }
.nv-ul button { min-height: 48px; font-size: var(--fs-md); color: var(--ink-2); transition: color var(--dur-quick) var(--ease-out); }
.nv-ul button[aria-selected="true"] { color: var(--ink); font-weight: 600; }
.nv-ul small { margin-left: 2px; font-size: var(--fs-xs); color: var(--ink-3); font-weight: 400; }
.nv-ul__bar { position: absolute; left: 0; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: var(--action); transition: transform var(--dur-slow) var(--ease-out), width var(--dur-slow) var(--ease-out); }
.nv-ulp { min-height: 76px; padding: var(--s-4); animation: lz-fade var(--dur-base) var(--ease-out) both; }
.nv-ulp .row { padding: 0; min-height: 0; }
.nv-ulp__kv { display: flex; justify-content: space-between; font-size: var(--fs-sm); color: var(--ink-2); }
.nv-ulp__kv + .nv-ulp__kv { margin-top: var(--s-2); }
.nv-ulp__kv b { color: var(--ink); font-weight: 600; }
.nv-ulp__tn { display: flex; gap: var(--s-3); }
.nv-ulp__tn img { width: 64px; height: 64px; border-radius: var(--r-md); object-fit: cover; }

/* 步骤条 */
.nv-steps { display: grid; grid-template-columns: repeat(4, 1fr); padding: var(--s-4) var(--s-2) var(--s-3); }
.nv-steps li { position: relative; display: grid; justify-items: center; }
.nv-steps li + li::before { content: ""; position: absolute; top: 15px; left: -50%; width: 100%; height: 3px; border-radius: 3px; background: var(--zone); transition: background var(--dur-slow) var(--ease-out); }
.nv-steps li[data-s="done"]::before, .nv-steps li[data-s="now"]::before { background: var(--action); }
.nv-step { position: relative; display: grid; justify-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); }
.nv-step i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--zone); font-style: normal; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-3); transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.nv-step i img { display: none; width: 16px; height: 16px; filter: invert(1); }
li[data-s="done"] .nv-step i { background: var(--action); }
li[data-s="done"] .nv-step i img { display: block; }
li[data-s="done"] .nv-step i b { display: none; }
li[data-s="now"] .nv-step i { background: var(--surface); color: var(--action-press); box-shadow: inset 0 0 0 2px var(--action), 0 0 0 5px var(--action-tint); }
li[data-s="now"] .nv-step, li[data-s="done"] .nv-step { color: var(--ink); }
li[data-s="now"] .nv-step span { font-weight: 600; }

/* 锚点分类侧栏 */
.nv-anc { display: grid; grid-template-columns: 88px 1fr; height: 300px; overflow: hidden; }
.nv-anc__rail { display: grid; align-content: start; gap: var(--s-1); padding: var(--s-2); border-right: 1px solid var(--line); }
.nv-anc__rail button { min-height: 48px; padding: 0 var(--s-1); border-radius: var(--r-md); font-size: var(--fs-sm); color: var(--ink-2); text-align: center; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.nv-anc__rail button[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; box-shadow: inset 0 0 0 1px var(--action-edge); }
.nv-anc__sc { overflow-y: auto; scrollbar-width: none; scroll-behavior: smooth; }
.nv-anc__sc::-webkit-scrollbar { display: none; }
.nv-anc__sec h3 { position: sticky; top: 0; z-index: 1; padding: var(--s-3) var(--s-4) var(--s-2); background: var(--surface); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-3); }
.nv-anc__sec .row { min-height: 64px; padding: var(--s-2) var(--s-3); }
.nv-anc__sec .row__lead { width: 48px; height: 48px; }
.nv-anc__sec .row__title { font-size: var(--fs-sm); }
.nv-anc__pad { height: 220px; }

/* 筛选条 */
.nv-flt { display: flex; align-items: center; justify-content: space-between; gap: var(--s-1); padding: 0 var(--s-1); }
.nv-flt > button, .nv-flt .drop__btn { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 48px; padding: 0 var(--s-3); border-radius: var(--r-md); background: none; font-size: var(--fs-sm); color: var(--ink-2); }
.nv-flt .drop__btn b { font-weight: 400; color: inherit; }
.nv-flt [data-on] { color: var(--action-press); font-weight: 600; }
.nv-flt .drop__btn[data-on] b { font-weight: 600; }
.nv-flt .drop__menu { left: var(--s-1); min-width: 132px; }
.nv-flt img { width: 18px; height: 18px; }
.nv-sort { display: inline-grid; gap: 3px; }
.nv-sort i { width: 6px; height: 6px; border: solid var(--line-strong); border-width: 1.6px 0 0 1.6px; transform: rotate(45deg); }
.nv-sort i + i { transform: rotate(225deg); }
[data-s="asc"] .nv-sort i:first-child, [data-s="desc"] .nv-sort i:last-child { border-color: var(--action); }
.nv-plist { display: grid; margin-top: var(--s-3); }
.nv-plist .row { min-height: 64px; padding: var(--s-2) var(--s-4); animation: lz-rise var(--dur-base) var(--ease-out) both; }
.nv-plist .row__lead { width: 48px; height: 48px; }

/* 返回顶部 */
.nv-up__sc { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: max-content; align-content: start; gap: var(--s-3); padding: var(--s-4); }
.nv-up__sc::-webkit-scrollbar { display: none; }
.nv-up { position: absolute; right: var(--s-4); bottom: var(--s-4); display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: conic-gradient(var(--action) calc(var(--p, 0) * 1%), var(--line-strong) 0); box-shadow: var(--elev-2); opacity: 0; transform: scale(.6); pointer-events: none; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.nv-up::before { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--surface); }
.nv-up img { position: relative; width: 22px; height: 22px; transform: rotate(90deg); }
.nv-up.is-on { opacity: 1; transform: none; pointer-events: auto; }
.nv-up:active { transform: scale(.92); }
</style>

<!-- 底栏 -->
<article class="demo" data-cid="AP-NAVI-001" data-name="五项底栏" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">五项底栏</span></div>
  <p class="demo__note">适合：主导航五个目的地，外层全宽贴底，选中项圆角浅底</p>
  <div class="demo__stage is-plain nv-st">
    <div class="nv-screen" data-tabs>
      <div class="nv-body"><div class="nv-mock"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><i></i><i></i></div></div><div class="nv-mock"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div><i></i><i></i></div></div></div>
      <nav class="tabbar" aria-label="主导航">
        <button class="tabbar__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>首页</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/list.webp" alt=""><span>分类</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/archive.webp" alt=""><span>订单</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/message.webp" alt=""><span>助手</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/user.webp" alt=""><span>我的</span></button>
      </nav>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-002" data-name="四项底栏" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">四项底栏</span></div>
  <p class="demo__note">适合：内容型应用，四个主目的地，每项更宽松</p>
  <div class="demo__stage is-plain nv-st">
    <div class="nv-screen" data-tabs>
      <div class="nv-body"><div class="nv-mock"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><div><i></i><i></i></div></div><div class="nv-mock"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div><i></i><i></i></div></div></div>
      <nav class="tabbar" aria-label="主导航">
        <button class="tabbar__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>首页</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/list.webp" alt=""><span>分类</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/archive.webp" alt=""><span>订单</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/user.webp" alt=""><span>我的</span></button>
      </nav>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-003" data-name="三项顶线底栏" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">三项顶线底栏</span></div>
  <p class="demo__note">适合：目的地很少的轻量应用，选中项上方主色线滑动</p>
  <div class="demo__stage is-plain nv-st">
    <div class="nv-screen nv-top3" data-tabs data-i="0">
      <div class="nv-body"><div class="nv-mock"><img src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><div><i></i><i></i></div></div><div class="nv-mock"><img src="../../kit/assets/photo/product-monstera.webp" alt=""><div><i></i><i></i></div></div></div>
      <nav class="tabbar" aria-label="主导航">
        <i class="nv-line"></i>
        <button class="tabbar__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>首页</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/message.webp" alt=""><span>消息</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/user.webp" alt=""><span>我的</span></button>
      </nav>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-004" data-name="带角标底栏" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">带角标底栏</span></div>
  <p class="demo__note">适合：有未读与待办的主导航，数字、红点、新标，进入后清除</p>
  <div class="demo__stage is-plain nv-st">
    <div class="nv-screen" data-tabs data-clear>
      <div class="nv-body"><div class="nv-mock"><img src="../../kit/assets/photo/product-succulent.webp" alt=""><div><i></i><i></i></div></div><div class="nv-mock"><img src="../../kit/assets/photo/product-giftbox.webp" alt=""><div><i></i><i></i></div></div></div>
      <nav class="tabbar" aria-label="主导航">
        <button class="tabbar__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>首页</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/list.webp" alt=""><span>分类</span><span class="badge" data-b>新</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/archive.webp" alt=""><span>订单</span><i class="nv-dot" data-b></i></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/message.webp" alt=""><span>消息</span><span class="badge" data-b>3</span></button>
        <button class="tabbar__item"><img src="../../kit/assets/line/user.webp" alt=""><span>我的</span></button>
      </nav>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-NAVI-005" data-name="中间凸起底栏" data-cat="NAVI">
