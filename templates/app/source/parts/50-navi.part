<article class="demo" data-cid="AP-NAVI-015" data-name="横向步骤条" data-cat="NAVI">
  <div class="demo__head"><span class="demo__name">横向步骤条</span></div>
  <p class="demo__note">适合：订单与售后进度，已完成、进行中、未开始三态，可点按切换</p>
  <div class="demo__stage">
    <div class="card">
      <ol class="nv-steps" id="nv-steps" aria-label="订单进度">
        <li data-s="done"><button class="nv-step"><i><img src="../../kit/assets/line/check.webp" alt=""><b>1</b></i><span>下单</span></button></li>
        <li data-s="done"><button class="nv-step"><i><img src="../../kit/assets/line/check.webp" alt=""><b>2</b></i><span>支付</span></button></li>
        <li data-s="now"><button class="nv-step" aria-current="step"><i><img src="../../kit/assets/line/check.webp" alt=""><b>3</b></i><span>配送</span></button></li>
        <li data-s="todo"><button class="nv-step"><i><img src="../../kit/assets/line/check.webp" alt=""><b>4</b></i><span>签收</span></button></li>
      </ol>
    </div>
  </div>
</article>

