<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };
  var PHONE = /^1\d{10}$/;
  var P = '../../kit/assets/photo/';
  function digits(el, max) { var v = el.value.replace(/\D/g, '').slice(0, max); if (v !== el.value) el.value = v; }
  function shake(el) { el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake'); }

  // 003 错误输入框
  (function () {
    var host = $('#fm-err'); if (!host) return;
    var inp = $('input', host), msg = $('.field__err', host);
    function check() { var v = inp.value, ok = PHONE.test(v); inp.setAttribute('aria-invalid', String(!ok)); msg.hidden = ok; msg.textContent = v ? '手机号需为 11 位数字' : '请输入手机号'; return ok; }
    inp.addEventListener('input', function () { digits(inp, 11); check(); });
    inp.addEventListener('blur', function () { if (!check()) shake(inp); });
  })();

  // 004 只读复制
  (function () {
    var b = $('#fm-copy'); if (!b) return;
    b.addEventListener('click', function () {
      var v = $('#fm-i4b').value;
      try { navigator.clipboard.writeText(v).then(function () { Lz.toast('已复制订单编号', 'success'); }, function () { Lz.toast('已复制订单编号', 'success'); }); } catch (e) { Lz.toast('已复制订单编号', 'success'); }
    });
  })();

  // 005 图标输入框清除
  $$('[data-cid="AP-FORM-005"] .fm-ico').forEach(function (box) {
    var inp = $('input', box), x = $('.fm-ico__x', box);
    var sync = function () { x.hidden = !inp.value; };
    inp.addEventListener('input', sync); x.addEventListener('click', function () { inp.value = ''; sync(); inp.focus(); }); sync();
  });

  // 006 数字过滤
  $$('[data-num]').forEach(function (inp) {
    inp.addEventListener('input', function () {
      var d = +inp.dataset.num; if (inp.isComposing) return;
      var v = inp.value.replace(d ? /[^\d.]/g : /\D/g, '');
      if (d) { var i = v.indexOf('.'); if (i >= 0) v = v.slice(0, i + 1) + v.slice(i + 1).replace(/\./g, '').slice(0, d); }
      if (v !== inp.value) inp.value = v;
    });
  });

  // 007 验证码倒计时
  (function () {
    var host = $('#fm-vc'); if (!host) return;
    var ph = $('[data-ph]', host), code = $('[data-code]', host), btn = $('[data-send]', host), t;
    ph.addEventListener('input', function () { digits(ph, 11); ph.closest('.fm-ico').removeAttribute('data-invalid'); });
    code.addEventListener('input', function () { digits(code, 6); });
    btn.addEventListener('click', function () {
      if (!PHONE.test(ph.value)) { var box = ph.closest('.fm-ico'); box.dataset.invalid = ''; shake(box); Lz.toast('请输入 11 位手机号', 'danger'); ph.focus(); return; }
      var n = 60; btn.disabled = true; btn.textContent = n + ' 秒后重发'; Lz.toast('验证码已发送', 'success'); code.focus();
      clearInterval(t); t = setInterval(function () { n--; if (n <= 0) { clearInterval(t); btn.disabled = false; btn.textContent = '重新获取'; } else btn.textContent = n + ' 秒后重发'; }, 1000);
    });
  })();

  // 008 六格验证码
  (function () {
    var host = $('#fm-otp'); if (!host) return;
    var boxes = $$('input', host);
    function done() { boxes.forEach(function (x) { x.classList.toggle('is-filled', !!x.value); }); if (boxes.every(function (x) { return x.value; })) Lz.toast('验证码已填写', 'success'); }
    boxes.forEach(function (b, i) {
      b.addEventListener('focus', function () { b.select(); });
      b.addEventListener('input', function () { b.value = b.value.replace(/\D/g, '').slice(-1); if (b.value && boxes[i + 1]) boxes[i + 1].focus(); done(); });
      b.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !b.value && boxes[i - 1]) { boxes[i - 1].value = ''; boxes[i - 1].focus(); done(); e.preventDefault(); }
        if (e.key === 'ArrowLeft' && boxes[i - 1]) { boxes[i - 1].focus(); e.preventDefault(); }
        if (e.key === 'ArrowRight' && boxes[i + 1]) { boxes[i + 1].focus(); e.preventDefault(); }
      });
      b.addEventListener('paste', function (e) {
        var t = ((e.clipboardData || window.clipboardData).getData('text') || '').replace(/\D/g, '').slice(0, boxes.length - i); if (!t) return; e.preventDefault();
        t.split('').forEach(function (c, k) { boxes[i + k].value = c; }); boxes[Math.min(boxes.length - 1, i + t.length)].focus(); done();
      });
    });
  })();

  // 009 密码显隐
  (function () {
    var b = $('#fm-eye'), i = $('#fm-i9'); if (!b) return;
    b.addEventListener('click', function () { var show = i.type === 'password'; i.type = show ? 'text' : 'password'; b.textContent = show ? '隐藏' : '显示'; b.setAttribute('aria-pressed', String(show)); });
  })();

  // 010 密码强度
  (function () {
    var host = $('#fm-pw'); if (!host) return;
    var inp = $('input', host), meter = $('.fm-meter', host), lab = $('.fm-meter span', host);
    inp.addEventListener('input', function () {
      var v = inp.value, ok = { len: v.length >= 8, num: /\d/.test(v), abc: /[a-zA-Z]/.test(v) }, n = 0;
      Object.keys(ok).forEach(function (k) { $('[data-r="' + k + '"]', host).toggleAttribute('data-ok', ok[k]); if (ok[k]) n++; });
      var lv = !v ? 0 : n === 3 ? (v.length >= 12 || /[^\w]/.test(v) ? 3 : 2) : 1; if (!v) lv = 0;
      if (lv === 2 && n === 3 && v.length >= 10) lv = 3;
      meter.dataset.lv = lv; lab.textContent = ['', '弱', '中', '强'][lv];
    });
  })();

  // 011 兑换
  (function () {
    var host = $('#fm-cp'); if (!host) return;
    var inp = $('input', host), btn = $('.btn', host), err = $('.field__err', host), box = $('.fm-ico', host);
    function submit() {
      var v = inp.value.trim();
      if (v.length !== 8) { err.hidden = false; box.dataset.invalid = ''; shake(box); inp.focus(); return; }
      err.hidden = true; box.removeAttribute('data-invalid'); btn.classList.add('is-loading');
      setTimeout(function () { btn.classList.remove('is-loading'); inp.value = ''; Lz.toast('已兑换 20 元优惠券', 'success'); }, 900);
    }
    inp.addEventListener('input', function () { if (!err.hidden && inp.value.trim().length === 8) { err.hidden = true; box.removeAttribute('data-invalid'); } });
    btn.addEventListener('click', submit);
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.isComposing) submit(); });
  })();

  // 012 胶囊搜索 / 014 扫码
  function bindSearch(host) {
    var inp = $('input', host), x = $('.fm-x', host);
    if (x) { inp.addEventListener('input', function () { x.hidden = !inp.value; }); x.addEventListener('click', function () { inp.value = ''; x.hidden = true; inp.focus(); }); }
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.isComposing && inp.value.trim()) Lz.toast('搜索 ' + inp.value.trim()); });
  }
  bindSearch($('#fm-s1')); bindSearch($('#fm-s3'));
  $('#fm-s3 .fm-scan') && $('#fm-s3 .fm-scan').addEventListener('click', function () { Lz.toast('已打开扫码'); });

  // 013 展开搜索
  (function () {
    var host = $('#fm-xs'); if (!host) return;
    var w = $('.fm-xs', host), inp = $('input', host), ok = $('.fm-xs__ok', host), cancel = $('.fm-xs__c', host);
    function open(o) { w.dataset.open = String(o); inp.tabIndex = o ? 0 : -1; cancel.tabIndex = o ? 0 : -1; if (o) setTimeout(function () { inp.focus(); }, 160); else { inp.value = ''; ok.focus(); } }
    ok.addEventListener('click', function () { open(true); });
    cancel.addEventListener('click', function () { open(false); });
    inp.addEventListener('keydown', function (e) { if (e.key === 'Escape') open(false); if (e.key === 'Enter' && !e.isComposing && inp.value.trim()) Lz.toast('搜索 ' + inp.value.trim()); });
  })();

  // 015 历史词
  (function () {
    var host = $('#fm-s4'); if (!host) return;
    var inp = $('input', host), box = $('.fm-hist', host);
    var hist = ['红玫瑰', '多肉', '生日花束', '龟背竹', '百合'], hot = ['母亲节花束', '向日葵', '绿萝', '节日礼盒'];
    function chips(list, cls) { return list.map(function (t) { return '<button type="button" class="' + (cls || '') + '">' + t + '</button>'; }).join(''); }
    function render() {
      box.innerHTML = (hist.length ? '<div><div class="fm-hist__h">历史搜索<button type="button" data-clear>清空</button></div><div class="fm-tags" data-h>' + chips(hist) + '</div></div>' : '') +
        '<div><div class="fm-hist__h">热门搜索</div><div class="fm-tags" data-t>' + chips(hot, 'is-hot') + '</div></div>';
    }
    function run(t) { inp.value = t; hist = [t].concat(hist.filter(function (x) { return x !== t; })).slice(0, 8); render(); Lz.toast('搜索 ' + t); }
    box.addEventListener('click', function (e) {
      var c = e.target.closest('[data-clear]');
      if (c) { Lz.confirm({ title: '清空历史搜索', body: '清空后无法恢复', ok: '清空', tone: 'danger' }).then(function (y) { if (y) { hist = []; render(); Lz.toast('已清空'); } }); return; }
      var b = e.target.closest('.fm-tags button'); if (b) run(b.textContent);
    });
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.isComposing && inp.value.trim()) run(inp.value.trim()); });
    render();
  })();

  // 016 联想词
  (function () {
    var host = $('#fm-s5'); if (!host) return;
    var inp = $('input', host), box = $('#fm-sug'), act = -1, cur = [];
    var all = ['红玫瑰花束', '玫瑰礼盒', '玫瑰干花摆件', '粉芍药花束', '白郁金香', '向日葵花束', '蓝绣球盆栽', '龟背竹盆栽', '多肉组合盆', '花礼盒', '干花花瓶摆件'];
    function render() {
      var q = inp.value.trim(); cur = q ? all.filter(function (t) { return t.indexOf(q) >= 0; }) : []; act = -1;
      box.hidden = !q; inp.setAttribute('aria-expanded', String(!!q));
      if (!q) { box.innerHTML = ''; return; }
      box.innerHTML = cur.length ? cur.map(function (t, i) {
        var k = t.indexOf(q); return '<button type="button" role="option" aria-selected="false" data-i="' + i + '"><img src="../../kit/assets/line/search.webp" alt=""><span>' + t.slice(0, k) + '<mark>' + q + '</mark>' + t.slice(k + q.length) + '</span></button>';
      }).join('') : '<p>没有相关商品</p>';
    }
    function mark(n) { $$('button', box).forEach(function (b, i) { b.setAttribute('aria-selected', String(i === n)); }); act = n; }
    function pick(i) { inp.value = cur[i]; Lz.toast('搜索 ' + cur[i]); render(); }
    inp.addEventListener('input', render);
    inp.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown' && cur.length) { mark((act + 1) % cur.length); e.preventDefault(); }
      else if (e.key === 'ArrowUp' && cur.length) { mark((act - 1 + cur.length) % cur.length); e.preventDefault(); }
      else if (e.key === 'Enter' && !e.isComposing) { if (act >= 0) pick(act); else if (inp.value.trim()) Lz.toast('搜索 ' + inp.value.trim()); }
      else if (e.key === 'Escape') { inp.value = ''; render(); }
    });
    box.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) pick(+b.dataset.i); });
    render();
  })();

  // 018 单选卡 / 025 单选列表：同一套单选行为，方向键移动
  function radios(host, sel) {
    var items = $$(sel, host);
    function set(i) { items.forEach(function (x, j) { x.setAttribute('aria-checked', String(j === i)); x.tabIndex = j === i ? 0 : -1; }); }
    items.forEach(function (x, i) {
      x.addEventListener('click', function () { set(i); });
      x.addEventListener('keydown', function (e) { var d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return; var n = (i + d + items.length) % items.length; set(n); items[n].focus(); e.preventDefault(); });
    });
  }
  radios($('#fm-rc'), '.fm-rc'); radios($('#fm-pay'), '.fm-pay');

  // 019 多选标签
  (function () {
    var host = $('#fm-mt'); if (!host) return;
    var tags = $$('.fm-mt', host), cnt = $('.fm-multi__h span', host), MAX = 3;
    function n() { return tags.filter(function (t) { return t.getAttribute('aria-pressed') === 'true'; }).length; }
    function sync() { cnt.textContent = '已选 ' + n() + ' 项 最多 ' + MAX + ' 项'; }
    tags.forEach(function (t) {
      t.addEventListener('click', function () {
        var on = t.getAttribute('aria-pressed') === 'true';
        if (!on && n() >= MAX) { Lz.toast('最多选 ' + MAX + ' 项', 'danger'); shake(t); return; }
        t.setAttribute('aria-pressed', String(!on)); sync();
      });
    }); sync();
  })();

  // 020 滚轮合计
  (function () {
    var host = $('#fm-wh'); if (!host) return;
    var tot = $('#fm-tot');
    host.addEventListener('lz:wheel', function (e) { tot.innerHTML = '<small>¥</small>' + (e.detail.value * 199); });
    host.addEventListener('input', function (e) { if (!e.target.matches('.wheel .input')) return; var n = parseInt(e.target.value, 10); if (!isNaN(n)) tot.innerHTML = '<small>¥</small>' + (n * 199); });
  })();

  // 021 时间滚轮
  (function () {
    var host = $('#fm-2w'); if (!host) return;
    var sum = $('b', host), h = 9, m = 30, two = function (n) { return (n < 10 ? '0' : '') + n; };
    host.addEventListener('lz:wheel', function (e) { var w = e.target.closest('.wheel'); if (w.dataset.name === 'h') h = e.detail.value; else m = e.detail.value; sum.textContent = two(h) + ':' + two(m); });
  })();

  // 022 数量步进
  $$('.fm-step').forEach(function (st) {
    var inp = $('input', st), minus = $('[data-d="-1"]', st), plus = $('[data-d="1"]', st), min = +st.dataset.min, max = +st.dataset.max, hold, rep;
    function set(v, quiet) { var n = clamp(v, min, max); if (!quiet && v > max) { Lz.toast('最多 ' + max + ' 件', 'danger'); } inp.value = n; minus.disabled = n <= min; plus.disabled = n >= max; }
    function bump(d) { set((parseInt(inp.value, 10) || min) + d); }
    [minus, plus].forEach(function (b) {
      var d = +b.dataset.d;
      b.addEventListener('click', function (e) { if (e.detail === 0 || !b._held) bump(d); b._held = false; });
      b.addEventListener('pointerdown', function () { b._held = false; hold = setTimeout(function () { b._held = true; rep = setInterval(function () { bump(d); }, 90); }, 420); });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) { b.addEventListener(ev, function () { clearTimeout(hold); clearInterval(rep); }); });
    });
    inp.addEventListener('change', function () { var n = parseInt(inp.value, 10); set(isNaN(n) ? min : n); });
    inp.addEventListener('input', function () { digits(inp, 3); });
    inp.addEventListener('keydown', function (e) { if (e.key === 'ArrowUp') { bump(1); e.preventDefault(); } if (e.key === 'ArrowDown') { bump(-1); e.preventDefault(); } });
    set(parseInt(inp.value, 10) || min, true);
  });

  // 023 开关文字随状态
  $$('[data-cid="AP-FORM-023"] .fm-sw').forEach(function (row) {
    var sw = $('.switch', row), s = $('small', row); if (sw.disabled) return;
    sw.addEventListener('lz:toggle', function () { s.textContent = sw.getAttribute('aria-checked') === 'true' ? '已开启' : '已关闭'; });
  });

  // 024 勾选与全选
  (function () {
    var host = $('#fm-ck'); if (!host) return;
    var allRow = $('[data-all]', host), all = $('.check', allRow), rows = $$('.fm-ck[data-p]', host), sum = $('.fm-ck__sum', allRow);
    var cb = function (r) { return $('.check', r); };
    function sync() {
      var on = rows.filter(function (r) { return cb(r).getAttribute('aria-checked') === 'true'; });
      all.setAttribute('aria-checked', on.length === 0 ? 'false' : on.length === rows.length ? 'true' : 'mixed');
      var t = on.reduce(function (a, r) { return a + +r.dataset.p; }, 0);
      sum.innerHTML = on.length ? '已选 ' + on.length + ' 件 <b>¥' + t + '</b>' : '未选择';
    }
    all.addEventListener('lz:toggle', function () { var v = all.getAttribute('aria-checked'); rows.forEach(function (r) { cb(r).setAttribute('aria-checked', v); }); sync(); });
    rows.forEach(function (r) { cb(r).addEventListener('lz:toggle', function (e) { e.stopPropagation(); sync(); }); });
    host.addEventListener('click', function (e) { var r = e.target.closest('.fm-ck'); if (!r || e.target.closest('.check')) return; $('.check', r).click(); });
    sync();
  })();

  // 026 星级
  (function () {
    var host = $('#fm-star'); if (!host) return;
    var btns = $$('button', host), t = $('.fm-star__t', host), words = ['很差', '较差', '一般', '满意', '惊喜'], val = 0;
    function paint(n) { btns.forEach(function (b, i) { b.toggleAttribute('data-on', i < n); }); }
    btns.forEach(function (b, i) {
      b.addEventListener('pointerenter', function () { paint(i + 1); t.textContent = words[i]; });
      b.addEventListener('click', function () { val = i + 1; btns.forEach(function (x, j) { x.setAttribute('aria-checked', String(j === i)); x.removeAttribute('data-pop'); }); void b.offsetWidth; btns.slice(0, val).forEach(function (x, j) { x.dataset.pop = ''; x.style.animationDelay = j * 40 + 'ms'; }); paint(val); t.textContent = words[i]; });
      b.addEventListener('keydown', function (e) { var d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d && btns[i + d]) { btns[i + d].focus(); e.preventDefault(); } });
    });
    $('.fm-star__row', host).addEventListener('pointerleave', function () { paint(val); t.textContent = val ? words[val - 1] : '请选择'; });
  })();

  // 027 图片上传
  (function () {
    var host = $('#fm-up'); if (!host) return;
    var grid = $('.fm-up', host), add = $('.fm-up__add', host), file = $('input[type=file]', host), cnt = $('.fm-up__h span', host), MAX = 4;
    function n() { return $$('.fm-up__i', grid).length; }
    function sync() { cnt.textContent = n() + '/' + MAX; add.hidden = n() >= MAX; }
    function mk(src) {
      var d = document.createElement('div'); d.className = 'fm-up__i';
      d.innerHTML = '<img class="ph" alt=""><div class="fm-up__ov"><span>0%</span><i style="--v:0%"></i></div>';
      $('.ph', d).src = src; grid.insertBefore(d, add); sync();
      var p = 0, ov = $('.fm-up__ov', d), tx = $('span', ov), bar = $('i', ov);
      var t = setInterval(function () { p = Math.min(100, p + 14 + Math.random() * 10); tx.textContent = Math.round(p) + '%'; bar.style.setProperty('--v', p + '%'); if (p >= 100) { clearInterval(t); ov.remove(); d.insertAdjacentHTML('beforeend', '<button type="button" class="fm-up__x" aria-label="删除图片" data-tip="删除"><img src="../../kit/assets/line/close.webp" alt=""></button>'); Lz.toast('上传完成', 'success'); } }, 160);
    }
    add.addEventListener('click', function () { file.click(); });
    file.addEventListener('change', function () { Array.prototype.slice.call(file.files).slice(0, MAX - n()).forEach(function (f) { mk(URL.createObjectURL(f)); }); file.value = ''; });
    grid.addEventListener('click', function (e) {
      var x = e.target.closest('.fm-up__x'); if (!x) return;
      var it = x.closest('.fm-up__i'); it.style.transition = 'opacity .15s, transform .15s'; it.style.opacity = '0'; it.style.transform = 'scale(.8)';
      setTimeout(function () { it.remove(); sync(); add.focus(); }, 160); Lz.toast('已移除');
    });
  })();

  // 028 文本域计数
  (function () {
    var host = $('#fm-ta'); if (!host) return;
    var ta = $('textarea', host), c = $('.fm-ta__n', host), max = +ta.maxLength;
    ta.addEventListener('input', function () { var n = ta.value.length; c.textContent = n + '/' + max; c.dataset.lv = n >= max ? 'full' : n >= max - 20 ? 'warn' : ''; });
  })();

  // 029 分组行：整行点按聚焦
  $$('#fm-gr .fm-gr').forEach(function (r) { var d = $('.drop', r); if (d) r.addEventListener('click', function (e) { if (!e.target.closest('.drop')) $('.drop__btn', d).click(); }); });
  (function () { var p = $('#fm-gr input[inputmode]'); p && p.addEventListener('input', function () { digits(p, 11); }); })();

  // 030 快捷金额
  (function () {
    var host = $('#fm-amt'); if (!host) return;
    var btns = $$('.fm-amt button', host), out = $('.fm-amt__top i', host), cust = $('.fm-amt__c', host);
    function cur() { var i = $('.wheel .input', cust), n = i ? parseInt(i.value, 10) : NaN; return isNaN(n) ? '0' : String(n); }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        btns.forEach(function (x) { x.setAttribute('aria-checked', String(x === b)); });
        if (b.dataset.v === 'custom') { cust.hidden = false; var w = $('.wheel', cust); if (w && w._lzSync) w._lzSync(); out.textContent = cur(); } else { cust.hidden = true; out.textContent = b.dataset.v; }
      });
    });
    cust.addEventListener('lz:wheel', function (e) { if (cust.hidden) return; out.textContent = String(e.detail.value); });
    cust.addEventListener('input', function (e) { if (!cust.hidden && e.target.matches('.wheel .input')) out.textContent = cur(); });
  })();

  // 031 校验汇总
  (function () {
    var host = $('#fm-val'); if (!host) return;
    var sum = $('.fm-sum', host), fields = $$('.field', host), btn = $('.btn', host);
    function rule(f) { var v = $('input', f).value.trim(); return f.dataset.f === '手机号' ? PHONE.test(v) : !!v; }
    function mark(f, bad) { $('input', f).setAttribute('aria-invalid', String(bad)); $('.field__err', f).hidden = !bad; }
    function refresh() {
      var bad = fields.filter(function (f) { return $('.field__err', f).hidden === false; });
      sum.hidden = !bad.length;
      sum.innerHTML = bad.length ? bad.length + ' 项待修改' + bad.map(function (f) { return '<button type="button" data-f="' + f.dataset.f + '">' + f.dataset.f + '</button>'; }).join('') : '';
    }
    btn.addEventListener('click', function () {
      var first = null; fields.forEach(function (f) { var bad = !rule(f); mark(f, bad); if (bad && !first) first = f; if (bad) shake($('input', f)); });
      refresh();
      if (first) $('input', first).focus(); else Lz.toast('已通过校验', 'success');
    });
    fields.forEach(function (f) { $('input', f).addEventListener('input', function () { if (f.dataset.f === '手机号') digits($('input', f), 11); if ($('.field__err', f).hidden === false && rule(f)) { mark(f, false); refresh(); } }); });
    sum.addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; var f = fields.filter(function (x) { return x.dataset.f === b.dataset.f; })[0]; if (f) $('input', f).focus(); });
    // 初始即展示一次错误态
    $('input', fields[0]).value = '林晓'; fields.forEach(function (f) { if (!rule(f)) mark(f, true); }); refresh();
  })();

  // 032 必填标记
  (function () {
    var host = $('#fm-req'); if (!host) return;
    $$('[data-req]', host).forEach(function (inp) {
      var m = $('.fm-req', inp.closest('.field'));
      function sync() { if (inp.inputMode === 'numeric') digits(inp, 11); var ok = inp.inputMode === 'numeric' ? PHONE.test(inp.value) : !!inp.value.trim(); m.toggleAttribute('data-done', ok); m.textContent = ok ? '已填' : '必填'; }
      inp.addEventListener('input', sync);
    });
  })();

  // 033 提交条
  (function () {
    var host = $('#fm-sb'); if (!host) return;
    var ck = $('.check', host), btn = $('.btn', host), row = $('[data-agree]', host);
    function sync() { btn.disabled = ck.getAttribute('aria-checked') !== 'true'; }
    ck.addEventListener('lz:toggle', sync);
    row.addEventListener('click', function (e) { if (!e.target.closest('.check')) ck.click(); });
    btn.addEventListener('click', function () { btn.classList.add('is-loading'); setTimeout(function () { btn.classList.remove('is-loading'); Lz.toast('订单已提交', 'success'); }, 1100); });
  })();
})();
</script>

<style>
/* 新增：日历、省市区、时段、标签输入、支付密码、日期滚轮、分类树、头像裁剪、签名板、数字键盘；类名带 fm-tg- fm-cal- fm-ar- fm-ts- fm-tk- fm-pc- fm-dw- fm-tr- fm-cr- fm-sg- fm-nk- */

/* 就近展开的选择触发条：日历与省市区共用 */
.fm-tg { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); width: 100%; min-height: 48px; padding: 0 var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); text-align: left; font-size: var(--fs-md); transition: box-shadow var(--dur-quick) var(--ease-out); }
.fm-tg[aria-expanded="true"] { box-shadow: inset 0 0 0 1px var(--ink-2); }
.fm-tg b { font-weight: 400; }
.fm-tg:not([data-done]) b { color: var(--ink-2); }
.fm-tg .chev { flex: none; }
.fm-pnl > div > .card { margin-top: var(--s-2); }

/* 日历日期选择 */
.fm-cal { padding: var(--s-2) var(--s-2) var(--s-3); }
.fm-cal__h { display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; }
.fm-cal__ttl { text-align: center; font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; }
.fm-cal__h .ibtn { width: 44px; height: 44px; }
.fm-cal__h .ibtn[disabled] { opacity: .3; pointer-events: none; }
.fm-cal__h .chev::after { margin: 0; }
.fm-cal__l::after { transform: rotate(135deg); }
.fm-cal__w, .fm-cal__g { display: grid; grid-template-columns: repeat(7, 1fr); }
.fm-cal__w span { display: grid; place-items: center; min-height: 28px; font-size: var(--fs-sm); color: var(--ink-3); }
.fm-cal__d { display: grid; justify-items: center; align-content: center; min-height: 48px; }
.fm-cal__n { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; font-size: var(--fs-md); font-weight: 500; font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.fm-cal__m { display: grid; place-items: center; height: 12px; font-size: 10px; font-style: normal; line-height: 12px; color: var(--ink-3); }
.fm-cal__d[data-s="ok"] .fm-cal__m::before { content: ""; width: 4px; height: 4px; border-radius: 50%; background: var(--action); }
.fm-cal__d:disabled { cursor: not-allowed; }
.fm-cal__d[data-s="past"] .fm-cal__n, .fm-cal__d[data-s="far"] .fm-cal__n { color: color-mix(in srgb, var(--ink-3) 55%, transparent); font-weight: 400; }
.fm-cal__d[data-s="full"] .fm-cal__n { color: var(--ink-3); font-weight: 400; }
.fm-cal__d[aria-pressed="true"] .fm-cal__n { background: var(--action); color: var(--surface); font-weight: 600; }
.fm-cal__d[aria-pressed="true"] .fm-cal__m::before { background: var(--action); }
@media (hover: hover) { .fm-cal__d:not(:disabled):not([aria-pressed="true"]):hover .fm-cal__n { background: var(--zone); } }
.fm-cal__d:not(:disabled):active .fm-cal__n { transform: scale(.92); }
.fm-cal__lg { display: flex; align-items: center; justify-content: center; gap: var(--s-6); margin: var(--s-2) var(--s-2) 0; padding-top: var(--s-3); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
.fm-cal__lg span { display: inline-flex; align-items: center; gap: var(--s-2); }
.fm-cal__lg i { display: grid; place-items: center; min-width: 8px; font-size: 10px; font-style: normal; line-height: 1; color: var(--ink-3); }
.fm-cal__lg i.is-ok { width: 5px; height: 5px; min-width: 0; border-radius: 50%; background: var(--action); }

/* 省市区联动选择 */
.fm-ar__tabs { display: flex; gap: var(--s-5); padding: 0 var(--s-4); border-bottom: 1px solid var(--line); overflow: hidden; }
.fm-ar__tabs button { position: relative; flex: none; min-height: 48px; font-size: var(--fs-md); color: var(--ink-2); white-space: nowrap; }
.fm-ar__tabs button[aria-selected="true"] { color: var(--ink); font-weight: 600; }
.fm-ar__tabs button[aria-selected="true"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: var(--action); }
.fm-ar__list { height: 240px; padding: var(--s-1) 0; overflow-y: auto; scrollbar-width: none; animation: lz-fade var(--dur-base) var(--ease-out) both; }
.fm-ar__list::-webkit-scrollbar { display: none; }
.fm-ar__list button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 48px; padding: 0 var(--s-4); font-size: var(--fs-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.fm-ar__list button img { width: 18px; height: 18px; opacity: 0; }
.fm-ar__list button[aria-selected="true"] { color: var(--action-press); font-weight: 600; background: var(--action-tint); }
.fm-ar__list button[aria-selected="true"] img { opacity: 1; }
.fm-ar__list button + button { border-top: 1px solid var(--line); }
@media (hover: hover) { .fm-ar__list button:not([aria-selected="true"]):hover { background: var(--zone); } }

/* 配送时段选择格 */
.fm-ts { display: grid; gap: var(--s-3); padding: var(--s-4); }
.fm-ts__days { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--s-2); }
.fm-ts__d { display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 56px; border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.fm-ts__d small { font-size: var(--fs-xs); font-variant-numeric: tabular-nums; opacity: .85; }
.fm-ts__d[aria-checked="true"] { background: var(--action); color: var(--surface); font-weight: 600; }
.fm-ts__d:active { transform: scale(.96); }
.fm-ts__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); }
.fm-ts__s { display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 56px; padding: 0 4px; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
.fm-ts__s small { font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); }
.fm-ts__s[data-s="few"] small { color: var(--warning); font-weight: 600; }
.fm-ts__s[data-s="full"] { background: var(--zone); box-shadow: none; color: var(--ink-3); font-weight: 400; cursor: not-allowed; }
.fm-ts__s[data-s="full"] b { text-decoration: line-through; font-weight: 400; }
.fm-ts__s[aria-checked="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1.5px var(--action); color: var(--action-press); }
.fm-ts__s[aria-checked="true"] small { color: var(--action-press); font-weight: 600; }
.fm-ts__s:not(:disabled):active { transform: scale(.96); }
.fm-ts__sum { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
.fm-ts__sum b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

/* 可删除标签输入 */
.fm-tk__h { display: flex; align-items: baseline; justify-content: space-between; }
.fm-tk__n { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.fm-tk__n[data-full] { color: var(--warning); font-weight: 600; }
.fm-tk__box { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); min-height: 52px; padding: 9px var(--s-2); border-radius: var(--r-md); cursor: text; }
.fm-tk__box[data-invalid] { --field-fill: var(--danger-tint); --field-active: var(--danger-tint); }
.fm-tk__t { display: inline-flex; align-items: center; gap: 2px; min-height: 32px; padding: 0 2px 0 var(--s-3); border-radius: var(--r-full); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); color: var(--action-press); font-size: var(--fs-sm); font-weight: 500; white-space: nowrap; animation: lz-pop var(--dur-base) var(--ease-spring) both; }
.fm-tk__t.is-out { opacity: 0; transform: scale(.8); transition: opacity var(--dur-quick), transform var(--dur-quick); }
.fm-tk__x { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; transition: background var(--dur-quick) var(--ease-out); }
.fm-tk__x img { width: 12px; height: 12px; }
@media (hover: hover) { .fm-tk__x:hover { background: var(--action-soft); } }
.fm-tk__in { flex: 1; min-width: 120px; height: 32px; border: 0; background: none; font-size: var(--fs-md); }
.fm-tk__in:focus-visible { outline: none; }
.fm-tk__in::placeholder { color: var(--ink-3); }
.fm-tk__in:disabled { cursor: not-allowed; }
.fm-tk__sug { margin-top: var(--s-4); }
.fm-tk__sug .fm-tags button:disabled { opacity: .4; cursor: not-allowed; }

/* 支付密码输入框 */
.fm-pc { display: grid; gap: var(--s-3); }
.fm-pc__h { display: flex; align-items: center; justify-content: space-between; min-height: 36px; }
.fm-pc__h b { font-size: var(--fs-md); font-weight: 600; }
.fm-pc__boxes { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--s-2); }
.fm-pc__b { position: relative; display: grid; place-items: center; height: 52px; border-radius: var(--r-md); background: var(--field-fill); }
.fm-pc__b.is-on::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--ink); animation: lz-pop var(--dur-base) var(--ease-spring) both; }
.fm-pc__boxes[data-show] .fm-pc__b.is-on::before { content: attr(data-c); width: auto; height: auto; border-radius: 0; background: none; font-size: var(--fs-xl); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
.fm-pc__boxes:focus-within .fm-pc__b.is-cur { background-color: var(--field-active); }
.fm-pc__boxes:focus-within .fm-pc__b.is-cur::after { content: ""; position: absolute; width: 2px; height: 22px; border-radius: 2px; background: var(--action); animation: lz-blink 1s steps(2) infinite; }
.fm-pc__in { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: 0; font-size: var(--fs-md); cursor: text; }
.fm-pc__in:disabled { cursor: not-allowed; }
.fm-pc[data-st="err"] .fm-pc__b { --field-fill: var(--danger-tint); }
.fm-pc[data-st="ok"] .fm-pc__b { --field-fill: var(--success-tint); }
.fm-pc__msg { font-size: var(--fs-sm); color: var(--ink-3); }
.fm-pc__msg:empty { display: none; }
.fm-pc[data-st="err"] .fm-pc__msg { color: var(--danger); }
.fm-pc[data-st="ok"] .fm-pc__msg { color: var(--success); font-weight: 600; }

/* 日期滚轮选择 */
.fm-dw { padding: var(--s-4); }
.fm-dw__h { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-3); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.fm-dw__h b { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.fm-dw__wrap { position: relative; display: grid; grid-template-columns: 1.25fr 1fr 1fr; border-radius: var(--r-md); background: var(--zone); }
.fm-dw__c { width: 100%; border-radius: 0; background: none; outline-offset: -2px; }
.fm-dw__c .wheel__item { cursor: pointer; }
.fm-dw__c:focus-visible { outline: 2px solid var(--ink-2); border-radius: var(--r-md); }

/* 分类树选择 */
.fm-tr { overflow: hidden; }
.fm-tr__body { display: grid; grid-template-columns: 92px 1fr; height: 264px; }
.fm-tr__rail { display: grid; grid-auto-rows: 56px; align-content: start; background: var(--zone); }
.fm-tr__rail button { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--s-1); padding: 0 var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); text-align: left; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.fm-tr__rail button[aria-selected="true"] { background: var(--surface); color: var(--ink); font-weight: 600; }
.fm-tr__rail button[aria-selected="true"]::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 0 3px 3px 0; background: var(--action); }
.fm-tr__rail i { display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: var(--r-full); background: var(--action); color: var(--surface); font-size: var(--fs-xs); font-style: normal; font-weight: 600; line-height: 1; animation: lz-pop var(--dur-base) var(--ease-spring) both; }
.fm-tr__pane { display: flex; flex-direction: column; min-height: 0; }
.fm-tr__ph { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 0 var(--s-2) 0 var(--s-4); }
.fm-tr__ph b { font-size: var(--fs-md); font-weight: 600; }
.fm-tr__ph .btn { min-height: 32px; }
.fm-tr__list { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; animation: lz-fade var(--dur-base) var(--ease-out) both; }
.fm-tr__list::-webkit-scrollbar { display: none; }
.fm-tr__it { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 48px; padding: 0 var(--s-4); font-size: var(--fs-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.fm-tr__it .check { pointer-events: none; }
.fm-tr__it[aria-checked="true"] { color: var(--action-press); font-weight: 600; }
@media (hover: hover) { .fm-tr__it:hover { background: var(--zone); } }
.fm-tr__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-2) var(--s-3) var(--s-2) var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
.fm-tr__bar b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
.fm-tr__acts { display: flex; align-items: center; gap: var(--s-2); }
.fm-tr__acts .btn { min-height: 40px; padding: 0 var(--s-4); }
.fm-tr__acts .btn--text { padding: 0 var(--s-2); }

/* 头像裁剪框 */
.fm-cr { display: grid; gap: var(--s-3); padding: var(--s-3); }
.fm-cr__box { position: relative; height: 248px; overflow: hidden; border-radius: var(--r-md); background: var(--ink); touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
.fm-cr__box.is-drag { cursor: grabbing; }
.fm-cr__box:focus-visible { outline: 2px solid var(--ink-2); outline-offset: 2px; }
.fm-cr__img { position: absolute; max-width: none; pointer-events: none; -webkit-user-drag: none; }
.fm-cr__mask { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 50% 50%, transparent calc(var(--cr, 100px) - .5px), color-mix(in srgb, var(--ink) 58%, transparent) var(--cr, 100px)); }
.fm-cr__ring { position: absolute; left: 50%; top: 50%; width: calc(var(--cr, 100px) * 2); height: calc(var(--cr, 100px) * 2); transform: translate(-50%, -50%); border: 2px solid var(--surface); border-radius: 50%; pointer-events: none; }
.fm-cr__zoom { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.fm-cr__zoom .btn { min-width: 88px; min-height: 40px; }
.fm-cr__pc { font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; }
.fm-cr__bar { display: flex; align-items: center; gap: var(--s-3); }
.fm-cr__pv { flex: none; width: 56px; height: 56px; border-radius: 50%; background: var(--zone); box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px var(--line-strong); }
.fm-cr__pt { font-size: var(--fs-sm); color: var(--ink-3); }
.fm-cr__acts { display: flex; gap: var(--s-2); margin-left: auto; }

/* 手写签名板 */
.fm-sg__pad { position: relative; height: 176px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface); color: var(--ink); touch-action: none; cursor: crosshair; }
.fm-sg__pad canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.fm-sg__line { position: absolute; left: var(--s-4); right: var(--s-4); bottom: 44px; border-top: 1.5px dashed var(--line-strong); pointer-events: none; }
.fm-sg__ph { position: absolute; inset: 0 0 44px; display: grid; place-items: center; font-size: var(--fs-md); color: var(--ink-3); pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
.fm-sg__pad[data-on] .fm-sg__ph { opacity: 0; }
.fm-sg__acts { display: flex; align-items: center; gap: var(--s-2); }
.fm-sg__acts .btn:last-child { margin-left: auto; }
.fm-sg__done { display: grid; gap: var(--s-3); padding: var(--s-3); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); animation: lz-fade var(--dur-base) var(--ease-out) both; }
.fm-sg__done canvas { display: block; width: 100%; height: 120px; border-radius: var(--r-sm); background: var(--zone); }
.fm-sg__done div { display: flex; align-items: center; justify-content: space-between; }

/* 数字键盘 */
.fm-nk__body { gap: var(--s-4); }
.fm-nk__top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
.fm-nk__top .seg { flex: none; padding: 0; }
.fm-nk__top .btn { min-height: 36px; padding: 0 var(--s-3); font-size: var(--fs-sm); }
.fm-nk__top .btn[aria-pressed="true"] { background: var(--action-tint); }
.fm-nk__cells { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--s-2); }
.fm-nk__c { position: relative; display: grid; place-items: center; height: 52px; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface); font-size: var(--fs-2xl); font-weight: 600; font-variant-numeric: tabular-nums; transition: border-color var(--dur-quick) var(--ease-out); }
.fm-nk__c.is-on { border-color: var(--action); }
.fm-nk__c.is-cur { border-color: var(--ink-2); }
.fm-nk__c.is-cur::after { content: ""; position: absolute; width: 2px; height: 22px; border-radius: 2px; background: var(--action); animation: lz-blink 1s steps(2) infinite; }
.fm-nk__cells[data-mode="pwd"] .fm-nk__c.is-on { font-size: 0; }
.fm-nk__cells[data-mode="pwd"] .fm-nk__c.is-on::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--ink); }
.fm-nk__pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border-top: 1px solid var(--line); background: var(--line); }
.fm-nk__k { display: grid; place-items: center; height: 52px; background: var(--surface); font-size: var(--fs-xl); font-weight: 500; font-variant-numeric: tabular-nums; transition: background var(--dur-instant) var(--ease-out); }
.fm-nk__k--fn { background: var(--zone); font-size: var(--fs-md); color: var(--ink-2); }
.fm-nk__k:active { background: var(--action-soft); }
.fm-nk__k:disabled { color: var(--ink-3); background: var(--zone); cursor: not-allowed; opacity: .6; }
.fm-nk__k:focus-visible { outline-offset: -3px; border-radius: 0; }
</style>

<article class="demo" data-cid="AP-FORM-034" data-name="日历日期选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">日历日期选择</span></div>
  <p class="demo__note">适合：预约与配送选单日，月历内嵌展开并标出可选日</p>
  <div class="demo__stage" id="fm-cal">
    <div class="field">
      <span class="field__label" id="fm-cal-l">配送日期</span>
      <button type="button" class="fm-tg" id="fm-cal-t" data-done data-expand="fm-cal-p" aria-labelledby="fm-cal-l fm-cal-v"><b id="fm-cal-v">11 月 12 日 周四</b><span class="chev"></span></button>
    </div>
    <div class="expand fm-pnl" id="fm-cal-p" data-open="true"><div>
      <div class="card fm-cal">
        <div class="fm-cal__h">
          <button type="button" class="ibtn" data-m="-1" aria-label="上个月" data-tip="上个月"><span class="chev fm-cal__l"></span></button>
          <b class="fm-cal__ttl" aria-live="polite">2026 年 11 月</b>
          <button type="button" class="ibtn" data-m="1" aria-label="下个月" data-tip="下个月"><span class="chev"></span></button>
        </div>
        <div class="fm-cal__w" aria-hidden="true"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div>
        <div class="fm-cal__g" role="group" aria-label="选择日期"></div>
        <div class="fm-cal__lg"><span><i class="is-ok"></i>可约</span><span><i>满</i>已约满</span></div>
      </div>
    </div></div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-035" data-name="省市区联动选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">省市区联动选择</span></div>
