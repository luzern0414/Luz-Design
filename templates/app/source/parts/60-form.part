<!-- cat: FORM | 表单 -->
<style>
/* 表单：文本框用色底反馈，错误用提示文字。 */
.fm-stack { display: grid; gap: var(--s-4); }
[data-cid^="AP-FORM-"] .input:focus-visible, [data-cid^="AP-FORM-"] .textarea:focus-visible { outline: none; }
[data-cid^="AP-FORM-"] input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
[data-cid^="AP-FORM-"] input::-ms-reveal, [data-cid^="AP-FORM-"] input::-ms-clear { display: none; }
.fm-stack > * { min-width: 0; }
.fm-vis { overflow: visible !important; }
[data-cid^="AP-FORM-"] .input:disabled, [data-cid^="AP-FORM-"] .input[readonly] { background: var(--zone); color: var(--ink-3); border-color: var(--line); cursor: not-allowed; }
[data-cid^="AP-FORM-"] .input[readonly] { cursor: default; color: var(--ink-2); }
[data-cid^="AP-FORM-"] .field__err[hidden] { display: none; }
.fm-lab { display: flex; align-items: center; gap: var(--s-2); }
.fm-req { padding: 0 6px; border-radius: 6px; background: var(--danger-tint); color: var(--danger); font-size: var(--fs-xs); font-style: normal; font-weight: 600; line-height: 20px; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.fm-req[data-done] { background: var(--success-tint); color: var(--success); }
.fm-opt { font-size: var(--fs-xs); font-style: normal; font-weight: 400; color: var(--ink-3); }

/* 悬浮标签 */
.fm-float { position: relative; display: block; }
.fm-float .input { min-height: 56px; padding: 22px var(--s-3) 4px; }
.fm-float span { position: absolute; left: var(--s-3); top: 16px; font-size: var(--fs-md); color: var(--ink-3); pointer-events: none; transition: top var(--dur-base) var(--ease-out), font-size var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.fm-float .input:focus + span, .fm-float .input:not(:placeholder-shown) + span { top: 7px; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); }

/* 带图标、单位和操作的组合输入。 */
.fm-ico { display: flex; align-items: center; gap: var(--s-2); min-height: 48px; padding: 0 var(--s-3); border-radius: var(--r-md); }
.fm-ico[data-invalid] { --field-fill: var(--danger-tint); --field-active: var(--danger-tint); }
.fm-ico > img { width: 20px; height: 20px; flex: none; }
.fm-ico input { flex: 1; width: 0; min-width: 0; height: 46px; border: 0; background: none; font-size: var(--fs-md); }
.fm-ico input:focus-visible { outline: none; }
.fm-ico input::placeholder { color: var(--ink-3); }
.fm-ico__u { flex: none; font-size: var(--fs-md); color: var(--ink-2); font-variant-numeric: tabular-nums; }
.fm-ico__x { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--zone); }
.fm-ico__x img { width: 12px; height: 12px; }
.fm-ico__x[hidden] { display: none; }
.fm-ico .btn--text { flex: none; min-height: 32px; padding: 0 var(--s-2); font-size: var(--fs-sm); font-weight: 600; }
.fm-ico .btn--text[disabled] { background: none; color: var(--ink-3); }
.fm-ico__sep { flex: none; width: 1px; height: 20px; background: var(--line-strong); }
.fm-join { display: flex; }
.fm-join .fm-ico { flex: 1; min-width: 0; border-radius: var(--r-md) 0 0 var(--r-md); border-right: 0; }
.fm-join .btn { border-radius: 0 var(--r-md) var(--r-md) 0; min-height: 48px; }
.fm-ro { display: flex; align-items: center; gap: var(--s-2); }
.fm-ro .input { flex: 1; }

/* 六格验证码 */
.fm-otp { display: flex; justify-content: space-between; gap: var(--s-2); }
.fm-otp input { width: 100%; max-width: 52px; height: 60px; padding: 0; border-radius: var(--r-md); text-align: center; font-size: var(--fs-2xl); font-weight: 600; font-variant-numeric: tabular-nums; }
.fm-otp input.is-filled { --field-fill: var(--action-tint); }

/* 密码强度 */
.fm-meter { display: grid; grid-template-columns: repeat(3, 1fr) auto; align-items: center; gap: var(--s-1); margin-top: var(--s-2); }
.fm-meter i { height: 4px; border-radius: var(--r-full); background: var(--zone); transition: background var(--dur-base) var(--ease-out); }
.fm-meter[data-lv="1"] i:nth-child(1) { background: var(--danger); }
.fm-meter[data-lv="2"] i:nth-child(-n+2) { background: var(--warning); }
.fm-meter[data-lv="3"] i { background: var(--success); }
.fm-meter span { min-width: 20px; margin-left: var(--s-2); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); text-align: right; }
.fm-rules { display: flex; gap: var(--s-4); margin-top: var(--s-3); font-size: var(--fs-sm); color: var(--ink-3); }
.fm-rules li { display: inline-flex; align-items: center; gap: var(--s-1); transition: color var(--dur-base) var(--ease-out); }
.fm-rules i { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--line-strong); transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
.fm-rules i img { width: 10px; height: 10px; filter: invert(1); opacity: 0; }
.fm-rules li[data-ok] { color: var(--ink); }
.fm-rules li[data-ok] i { background: var(--success); border-color: var(--success); }
.fm-rules li[data-ok] i img { opacity: 1; }

/* 搜索 */
.fm-sbox { position: relative; }
.search .fm-x { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--zone); flex: none; }
.search .fm-x img { width: 12px; height: 12px; }
.search .fm-x[hidden] { display: none; }
.search .fm-scan { display: grid; place-items: center; width: 32px; height: 32px; margin-right: -6px; border-radius: 50%; flex: none; transition: background var(--dur-quick) var(--ease-out); }
.search .fm-scan img { width: 22px; height: 22px; }
@media (hover: hover) { .search .fm-scan:hover { background: var(--zone); } }
.fm-xs { position: relative; height: 44px; }
.fm-xs__t { position: absolute; left: var(--s-1); top: 0; line-height: 44px; font-size: var(--fs-xl); font-weight: 700; transition: opacity var(--dur-base) var(--ease-out); }
.fm-xs__box { position: absolute; top: 0; right: 0; width: 44px; height: 44px; overflow: hidden; border-radius: var(--r-full); transition: width var(--dur-slow) var(--ease-out), right var(--dur-slow) var(--ease-out); }
.fm-xs__box > label { position: absolute; inset: 0; display: flex; align-items: center; gap: var(--s-2); padding: 0 var(--s-3) 0 11px; }
.fm-xs__box img { width: 20px; height: 20px; flex: none; }
.fm-xs__box input { flex: 1; min-width: 0; height: 42px; border: 0; background: none; font-size: var(--fs-md); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out) var(--dur-quick); }
.fm-xs__box input:focus-visible { outline: none; }
.fm-xs__box input::placeholder { color: var(--ink-3); }
.fm-xs__ok { position: absolute; inset: 0; border-radius: inherit; }
.fm-xs__c { position: absolute; top: 0; right: 0; min-height: 44px; padding: 0 var(--s-2); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
.fm-xs[data-open="true"] .fm-xs__box { right: 56px; width: calc(100% - 56px); }
.fm-xs[data-open="true"] .fm-xs__box input { opacity: 1; pointer-events: auto; }
.fm-xs[data-open="true"] .fm-xs__ok { display: none; }
.fm-xs[data-open="true"] .fm-xs__t { opacity: 0; }
.fm-xs[data-open="true"] .fm-xs__c { opacity: 1; pointer-events: auto; }
.fm-hist { margin-top: var(--s-3); display: grid; gap: var(--s-4); }
.fm-hist__h { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--s-2); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.fm-hist__h button { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); min-height: 32px; padding: 0 var(--s-1); }
.fm-tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
.fm-tags button { min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out); }
.fm-tags button.is-hot { box-shadow: inset 0 0 0 1px var(--action-edge); background: var(--action-tint); color: var(--action-press); }
@media (hover: hover) { .fm-tags button:hover { background: var(--zone); } }
.fm-sug { margin-top: var(--s-2); overflow: hidden; }
.fm-sug button { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 48px; padding: 0 var(--s-4); position: relative; text-align: left; font-size: var(--fs-md); }
.fm-sug button + button::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.fm-sug button img { width: 18px; height: 18px; opacity: .55; }
.fm-sug button[aria-selected="true"], .fm-sug button:active { background: var(--zone); }
.fm-sug mark { background: none; color: var(--action-press); font-weight: 600; }
.fm-sug p { min-height: 48px; display: grid; place-items: center; font-size: var(--fs-sm); color: var(--ink-3); }

/* 下拉选择 */
.fm-sel { display: block; width: 100%; }
.fm-sel .drop__btn { display: flex; width: 100%; min-height: 48px; padding: 0 var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); gap: var(--s-3); }
.fm-sel .drop__btn[aria-expanded="true"] { box-shadow: inset 0 0 0 1px var(--ink-2); }
.fm-sel .drop__btn span { font-size: var(--fs-sm); color: var(--ink-3); }
.fm-sel .drop__btn b { margin-left: auto; font-size: var(--fs-md); }
.fm-sel .drop__menu { right: 0; }
.fm-sel .drop__opt { min-height: 44px; font-size: var(--fs-md); }

/* 单选卡与单选列表 */
.fm-cards { display: grid; gap: var(--s-3); }
.fm-rc { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; column-gap: var(--s-3); width: 100%; padding: var(--s-3) var(--s-4) var(--s-3) var(--s-3); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); text-align: left; box-shadow: var(--elev-1); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
.fm-rc img { width: 44px; height: 44px; object-fit: contain; filter: drop-shadow(0 4px 6px color-mix(in srgb, var(--ink) 14%, transparent)); }
.fm-rc b { display: block; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.fm-rc small { display: block; margin-top: 2px; font-size: var(--fs-sm); color: var(--ink-3); }
.fm-rc:active { transform: scale(.98); }
.fm-rc[aria-checked="true"] { border-color: var(--action); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action); }
.fm-ring { display: grid; place-items: center; width: 22px; height: 22px; border: 1.5px solid var(--line-strong); border-radius: 50%; background: var(--surface); flex: none; transition: border-color var(--dur-quick) var(--ease-out); }
.fm-ring::after { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--action); transform: scale(0); transition: transform var(--dur-base) var(--ease-spring); }
[aria-checked="true"] > .fm-ring, [aria-checked="true"] .fm-ring { border-color: var(--action); }
[aria-checked="true"] > .fm-ring::after, [aria-checked="true"] .fm-ring::after { transform: scale(1); }

/* 多选标签 */
.fm-multi__h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--s-3); }
.fm-multi__h b { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.fm-multi__h span { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.fm-mt { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 40px; padding: 0 var(--s-4); border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out), padding var(--dur-quick) var(--ease-out); }
.fm-mt img { width: 0; height: 14px; opacity: 0; transition: width var(--dur-quick) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
.fm-mt[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1.5px var(--action); color: var(--action-press); font-weight: 600; }
.fm-mt[aria-pressed="true"] img { width: 14px; opacity: 1; }
.fm-mt:active { transform: scale(.96); }

/* 滚轮 */
.fm-wh { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-4); }
.fm-wh .stat { padding: 0; }
.fm-2w { display: flex; align-items: center; justify-content: space-around; gap: var(--s-2); padding: var(--s-4) var(--s-3); }
.fm-2w .wheel { gap: var(--s-1); }
.fm-2w .wheel__col { width: 56px; }
.fm-2w .wheel .input { width: 46px; padding: 0; }
.fm-2w__sum { margin-top: var(--s-3); text-align: center; font-size: var(--fs-md); color: var(--ink-2); }
.fm-2w__sum b { color: var(--ink); font-size: var(--fs-xl); font-variant-numeric: tabular-nums; }

/* 数量步进 */
.fm-step { display: inline-flex; align-items: center; border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); overflow: hidden; }
.fm-step button { display: grid; place-items: center; width: 44px; height: 44px; transition: background var(--dur-quick) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
.fm-step button img { width: 18px; height: 18px; }
.fm-step button .fm-minus { clip-path: inset(44% 0 44% 0); }
.fm-step button:disabled { opacity: .3; cursor: not-allowed; }
.fm-step button:not(:disabled):active { background: var(--zone); }
.fm-step input { width: 44px; height: 44px; border: 0; background: none; text-align: center; font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; }
.fm-step input:focus-visible { outline: none; }
.fm-step--sm button, .fm-step--sm input { width: 36px; height: 36px; }
.fm-step--sm button img { width: 16px; height: 16px; }
.fm-step__list { padding: var(--s-1) var(--s-4); }
.fm-step__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) 0; }
.fm-step__row + .fm-step__row { border-top: 1px solid var(--line); }
.fm-step__row b { display: block; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
.fm-step__row small { font-size: var(--fs-sm); color: var(--ink-3); }

/* 开关与勾选 */
.fm-sw { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 64px; padding: var(--s-2) var(--s-4); }
.fm-sw + .fm-sw { border-top: 1px solid var(--line); }
.fm-sw b { display: block; font-size: var(--fs-md); font-weight: 500; line-height: var(--lh-tight); }
.fm-sw small { font-size: var(--fs-sm); color: var(--ink-3); }
[data-cid^="AP-FORM-"] .switch:disabled { opacity: .45; cursor: not-allowed; }
[data-cid^="AP-FORM-"] .check[aria-checked="mixed"] { background: var(--action); border-color: var(--action); }
[data-cid^="AP-FORM-"] .check .fm-dash { position: absolute; display: none; width: 14px; height: 14px; filter: invert(1); clip-path: inset(44% 0 44% 0); }
[data-cid^="AP-FORM-"] .check[aria-checked="mixed"] .fm-dash { display: block; opacity: 1; transform: none; }
[data-cid^="AP-FORM-"] .check { position: relative; cursor: pointer; }
[data-cid^="AP-FORM-"] .check[aria-checked="mixed"] img:not(.fm-dash) { opacity: 0; }
.fm-ck { display: flex; align-items: center; gap: var(--s-3); min-height: 60px; padding: var(--s-2) var(--s-4); position: relative; cursor: pointer; }
.fm-ck + .fm-ck::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.fm-ck img.row__lead { width: 44px; height: 44px; }
.fm-ck--all { min-height: 52px; background: var(--zone); font-size: var(--fs-md); font-weight: 600; }
.fm-ck--all + .fm-ck::before { display: none; }
.fm-ck__sum { margin-left: auto; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
.fm-ck__sum b { color: var(--price); font-weight: 600; }
.fm-pay { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 64px; padding: var(--s-2) var(--s-4); position: relative; text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.fm-pay + .fm-pay::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.fm-pay b { display: block; font-size: var(--fs-md); font-weight: 500; line-height: var(--lh-tight); }
.fm-pay small { font-size: var(--fs-sm); color: var(--ink-3); }
.fm-pay[aria-checked="true"] { background: var(--action-tint); }
.fm-pay .fm-ring { margin-left: auto; }

/* 星级 */
.fm-star { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-4); }
.fm-star__row { display: flex; justify-content: center; gap: var(--s-1); width: 100%; }
.fm-star__row button { display: grid; place-items: center; flex: 1; min-width: 0; max-width: 52px; height: 52px; border-radius: var(--r-md); }
.fm-star__row img { width: 40px; height: 40px; object-fit: contain; filter: grayscale(1) opacity(.28); transition: filter var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
.fm-star__row button[data-on] img { filter: drop-shadow(0 4px 5px color-mix(in srgb, var(--ink) 18%, transparent)); }
.fm-star__row button:active img { transform: scale(.82); }
.fm-star__row button[data-pop] img { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.fm-star__t { min-height: 24px; font-size: var(--fs-md); font-weight: 600; color: var(--ink-2); }

/* 图片上传 */
.fm-up { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-2); }
.fm-up__i, .fm-up__add { position: relative; aspect-ratio: 1; border-radius: var(--r-md); overflow: hidden; }
.fm-up__i img.ph { width: 100%; height: 100%; object-fit: cover; }
.fm-up__i { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.fm-up__x { position: absolute; top: 4px; right: 4px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: color-mix(in srgb, var(--ink) 70%, transparent); }
.fm-up__x img { width: 12px; height: 12px; filter: invert(1); }
.fm-up__ov { position: absolute; inset: 0; display: grid; place-items: center; background: color-mix(in srgb, var(--ink) 50%, transparent); color: var(--surface); font-size: var(--fs-xs); font-weight: 600; }
.fm-up__ov i { position: absolute; left: 10px; right: 10px; bottom: 12px; height: 4px; border-radius: 4px; background: color-mix(in srgb, var(--surface) 35%, transparent); overflow: hidden; }
.fm-up__ov i::after { content: ""; display: block; height: 100%; width: var(--v, 0%); background: var(--surface); transition: width var(--dur-quick) linear; }
.fm-up__add { display: grid; place-items: center; align-content: center; gap: 2px; border: 1.5px dashed var(--line-strong); background: var(--surface); font-size: var(--fs-xs); color: var(--ink-3); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
.fm-up__add img { width: 24px; height: 24px; opacity: .7; }
@media (hover: hover) { .fm-up__add:hover { border-color: var(--action); background: var(--action-tint); } }
.fm-up__add:active { background: var(--action-tint); }
.fm-up__h { display: flex; justify-content: space-between; margin-bottom: var(--s-3); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.fm-up__h span { font-weight: 400; color: var(--ink-3); font-variant-numeric: tabular-nums; }

/* 文本域计数 */
.fm-ta { position: relative; }
.fm-ta .textarea { min-height: 112px; padding-bottom: 32px; resize: none; }
.fm-ta__n { position: absolute; right: var(--s-3); bottom: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
.fm-ta__n[data-lv="warn"] { color: var(--warning); font-weight: 600; }
.fm-ta__n[data-lv="full"] { color: var(--danger); font-weight: 600; }

/* 表单分组行 */
.fm-gr { display: grid; grid-template-columns: 76px 1fr; align-items: center; column-gap: var(--s-3); min-height: 56px; padding: 0 var(--s-4); position: relative; }
.fm-gr + .fm-gr::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.fm-gr > span { font-size: var(--fs-md); font-weight: 500; }
.fm-gr input { width: 100%; height: 54px; border: 0; background: none; font-size: var(--fs-md); }
.fm-gr input:focus-visible { outline: none; }
.fm-gr input::placeholder { color: var(--ink-3); }
.fm-gr:focus-within > span { color: var(--action-press); }
.fm-gr .drop { width: 100%; }
.fm-gr .drop__btn { display: flex; width: 100%; min-height: 54px; padding: 0; border-radius: 0; background: none; font-size: var(--fs-md); }
.fm-gr .drop__btn b { font-weight: 400; color: var(--ink); }
.fm-gr .drop:not([data-value]) .drop__btn b { color: var(--ink-3); }
.fm-gr .drop__btn::after { margin-left: auto; }
.fm-gr .drop__menu { right: 0; left: auto; min-width: 180px; }
.fm-gr .switch { justify-self: end; }

/* 快捷金额 */
.fm-amt__top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--s-3); }
.fm-amt__top span { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.fm-amt__top b { font-size: var(--fs-2xl); font-weight: 700; color: var(--price); font-variant-numeric: tabular-nums; }
.fm-amt__top b small { font-size: var(--fs-md); font-weight: 600; margin-right: 2px; }
.fm-amt { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); }
.fm-amt button { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-lg); font-weight: 600; font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
.fm-amt button small { font-size: var(--fs-xs); font-weight: 500; color: var(--ink-3); }
.fm-amt button[aria-checked="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1.5px var(--action); color: var(--action-press); }
.fm-amt button[aria-checked="true"] small { color: var(--action-press); }
.fm-amt button:active { transform: scale(.97); }
.fm-amt__c { display: flex; justify-content: center; margin-top: var(--s-3); padding: var(--s-4); }

/* 校验汇总 */
.fm-sum { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2); padding: var(--s-3) var(--s-4); margin-bottom: var(--s-4); border-radius: var(--r-md); background: var(--danger-tint); color: var(--danger); font-size: var(--fs-sm); font-weight: 600; animation: lz-fade var(--dur-base) var(--ease-out) both; }
.fm-sum button { min-height: 28px; padding: 0 var(--s-2); border-radius: var(--r-full); background: var(--surface); font-size: var(--fs-xs); font-weight: 600; color: var(--danger); }
.fm-sum[hidden] { display: none; }

/* 提交条 */
.demo__stage.fm-st { border: 0; }
.fm-screen { position: relative; display: flex; flex-direction: column; overflow: hidden; outline: 1px solid var(--line); outline-offset: -1px; border-radius: var(--r-md); background: var(--bg); }
.fm-screen__body { flex: 1; min-height: 0; padding: var(--s-4); display: grid; align-content: start; gap: var(--s-3); }
.fm-ck2 { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); cursor: pointer; }
.fm-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); background: var(--bg); border-top: 1px solid var(--line); }
.fm-bar__t { display: grid; line-height: 1.2; }
.fm-bar__t small { font-size: var(--fs-sm); color: var(--ink-3); }
.fm-bar__t b { font-size: var(--fs-xl); font-weight: 700; color: var(--price); font-variant-numeric: tabular-nums; }
.fm-bar__t b small { margin-right: 2px; font-size: var(--fs-sm); color: var(--price); font-weight: 600; }
.fm-bar .btn { min-width: 132px; }
.fm-bar .btn[disabled] { box-shadow: none; }
</style>

<!-- 输入框 -->
