      <div class="fm-pc__h"><b>设置支付密码</b><button type="button" class="btn btn--text" aria-pressed="false">显示</button></div>
      <div class="fm-pc__boxes">
        <span class="fm-pc__b"></span><span class="fm-pc__b"></span><span class="fm-pc__b"></span><span class="fm-pc__b"></span><span class="fm-pc__b"></span><span class="fm-pc__b"></span>
        <input class="fm-pc__in" type="text" inputmode="numeric" maxlength="6" autocomplete="off" aria-label="支付密码 共 6 位" aria-describedby="fm-pc-m">
      </div>
      <p class="fm-pc__msg" id="fm-pc-m" role="status"></p>
    </div>
