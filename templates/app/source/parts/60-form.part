</article>

<article class="demo" data-cid="AP-FORM-039" data-name="日期滚轮选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">日期滚轮选择</span></div>
  <p class="demo__note">适合：生日等年月日用三列滚轮就近选择，天数随月份变化</p>
  <div class="demo__stage" id="fm-dw">
    <div class="card fm-dw">
      <div class="fm-dw__h"><span>出生日期</span><b class="fm-dw__v" role="status"></b></div>
      <div class="fm-dw__wrap">
        <div class="wheel__col fm-dw__c" data-u="y" role="spinbutton" tabindex="0" aria-label="年"></div>
        <div class="wheel__col fm-dw__c" data-u="m" role="spinbutton" tabindex="0" aria-label="月"></div>
        <div class="wheel__col fm-dw__c" data-u="d" role="spinbutton" tabindex="0" aria-label="日"></div>
        <div class="wheel__band"></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-040" data-name="分类树选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">分类树选择</span></div>
  <p class="demo__note">适合：左侧选类目、右侧勾选子项的多级选择</p>
  <div class="demo__stage">
    <div class="card fm-tr" id="fm-tr">
      <div class="fm-tr__body">
        <div class="fm-tr__rail" role="tablist" aria-label="花材类目" aria-orientation="vertical"></div>
        <div class="fm-tr__pane" role="tabpanel">
          <div class="fm-tr__ph"><b></b><button type="button" class="btn btn--text btn--sm" data-all>全选</button></div>
          <div class="fm-tr__list" role="group"></div>
        </div>
      </div>
      <div class="fm-tr__bar"><span>已选 <b>0</b> 项</span><div class="fm-tr__acts"><button type="button" class="btn btn--text" data-clear>清空</button><button type="button" class="btn btn--primary" data-ok>确定</button></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-041" data-name="头像裁剪框" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">头像裁剪框</span></div>
  <p class="demo__note">适合：上传头像后拖动并缩放，圆形框内即为裁剪结果</p>
  <div class="demo__stage" id="fm-cr">
    <div class="card fm-cr">
      <div class="fm-cr__box" tabindex="0" role="group" aria-label="头像裁剪区 方向键移动 加减号缩放">
        <img class="fm-cr__img" src="../../kit/assets/photo/bouquet-white.webp" alt="" draggable="false">
        <i class="fm-cr__mask"></i><i class="fm-cr__ring"></i>
      </div>
      <div class="fm-cr__zoom">
        <button type="button" class="btn btn--ghost" data-z="-1" disabled>缩小</button>
        <span class="fm-cr__pc" role="status" aria-label="缩放比例">100%</span>
        <button type="button" class="btn btn--ghost" data-z="1">放大</button>
      </div>
      <div class="fm-cr__bar">
        <canvas class="fm-cr__pv" width="112" height="112" role="img" aria-label="头像预览"></canvas><span class="fm-cr__pt">预览</span>
        <div class="fm-cr__acts"><button type="button" class="btn btn--ghost" data-pick>重选</button><button type="button" class="btn btn--primary" data-ok>确定</button></div>
      </div>
      <input type="file" accept="image/*" hidden>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-042" data-name="手写签名板" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">手写签名板</span></div>
  <p class="demo__note">适合：合同与领取确认的手写签名，可撤销与清除重签</p>
  <div class="demo__stage" id="fm-sg">
    <div class="field" data-view="pad">
      <span class="field__label">领取人签名</span>
      <div class="fm-sg__pad"><canvas role="img" aria-label="手写签名板"></canvas><i class="fm-sg__line"></i><p class="fm-sg__ph">请在此处签名</p></div>
      <div class="fm-sg__acts"><button type="button" class="btn btn--ghost" data-undo disabled>撤销</button><button type="button" class="btn btn--ghost" data-clear disabled>清除</button><button type="button" class="btn btn--primary" data-ok disabled>确认</button></div>
    </div>
    <div class="field" data-view="done" hidden>
      <span class="field__label">领取人签名</span>
      <div class="fm-sg__done"><canvas role="img" aria-label="已确认的签名"></canvas><div><span class="tag" data-tone="success">已签名</span><button type="button" class="btn btn--text" data-redo>重新签名</button></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-043" data-name="数字键盘" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">数字键盘</span></div>
  <p class="demo__note">适合：支付密码与验证码输入时的数字键，可乱序防窥</p>
  <div class="demo__stage is-plain fm-st">
    <div class="fm-screen" id="fm-nk">
      <div class="fm-screen__body fm-nk__body">
        <div class="fm-nk__top">
          <div class="seg" data-seg="fm-nk" aria-label="输入类型"><button class="seg__item" data-key="code" aria-selected="true">验证码</button><button class="seg__item" data-key="pwd" aria-selected="false">支付密码</button></div>
          <button type="button" class="btn btn--text" data-shuffle aria-pressed="false">乱序</button>
        </div>
        <div class="fm-nk__cells" data-mode="code" role="group" aria-label="已输入 0 位 共 6 位"><span class="fm-nk__c"></span><span class="fm-nk__c"></span><span class="fm-nk__c"></span><span class="fm-nk__c"></span><span class="fm-nk__c"></span><span class="fm-nk__c"></span></div>
      </div>
      <div class="fm-nk__pad" role="group" aria-label="数字键盘"></div>
    </div>
  </div>
</article>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };
  var LINE = '../../kit/assets/line/', CHK = '<img src="' + LINE + 'check.webp" alt="">', XIC = '<img src="' + LINE + 'close.webp" alt="">';
  var WD = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  var two = function (n) { return (n < 10 ? '0' : '') + n; };
  function shake(el) { el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake'); }
  function collapse(trig) { if (trig.getAttribute('aria-expanded') === 'true') trig.click(); }

  // 034 日历日期选择：月历内嵌展开，过去与约满的日期不可选
  (function () {
    var host = $('#fm-cal'); if (!host) return;
    var trig = $('#fm-cal-t'), val = $('#fm-cal-v'), ttl = $('.fm-cal__ttl', host), grid = $('.fm-cal__g', host), prev = $('[data-m="-1"]', host), next = $('[data-m="1"]', host);
    var REF = new Date(2026, 10, 9), LAST = new Date(2027, 0, 8);
    var FULL = { '2026-11-13': 1, '2026-11-14': 1, '2026-11-21': 1, '2026-11-22': 1, '2026-11-28': 1, '2026-12-05': 1, '2026-12-06': 1, '2026-12-12': 1, '2026-12-19': 1, '2026-12-20': 1 };
    var sel = new Date(2026, 10, 12), view = new Date(2026, 10, 1);
    var key = function (d) { return d.getFullYear() + '-' + two(d.getMonth() + 1) + '-' + two(d.getDate()); };
    var fmt = function (d) { return (d.getMonth() + 1) + ' 月 ' + d.getDate() + ' 日 ' + WD[d.getDay()]; };
    function state(d) { if (d <= REF) return 'past'; if (d > LAST) return 'far'; return FULL[key(d)] ? 'full' : 'ok'; }
    function render() {
      var y = view.getFullYear(), m = view.getMonth(), first = new Date(y, m, 1).getDay(), n = new Date(y, m + 1, 0).getDate(), h = '';
      ttl.textContent = y + ' 年 ' + (m + 1) + ' 月';
      for (var i = 0; i < first; i++) h += '<span></span>';
      for (var d = 1; d <= n; d++) {
        var dt = new Date(y, m, d), s = state(dt), on = key(dt) === key(sel);
        var lab = (m + 1) + ' 月 ' + d + ' 日 ' + WD[dt.getDay()] + (s === 'ok' ? ' 可约' : s === 'full' ? ' 已约满' : ' 不可选');
        h += '<button type="button" class="fm-cal__d" data-d="' + d + '" data-s="' + s + '" aria-label="' + lab + '" aria-pressed="' + on + '"' + (s === 'ok' ? '' : ' disabled') + ' tabindex="' + (on ? 0 : -1) + '"><span class="fm-cal__n">' + d + '</span><i class="fm-cal__m">' + (s === 'full' ? '满' : '') + '</i></button>';
      }
      grid.innerHTML = h;
      if (!$('[tabindex="0"]', grid)) { var f = $('.fm-cal__d:not(:disabled)', grid); if (f) f.tabIndex = 0; }
      prev.disabled = y === REF.getFullYear() && m === REF.getMonth();
      next.disabled = y * 12 + m >= LAST.getFullYear() * 12 + LAST.getMonth();
    }
    prev.addEventListener('click', function () { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); render(); });
    next.addEventListener('click', function () { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); render(); });
    grid.addEventListener('click', function (e) {
      var b = e.target.closest('.fm-cal__d'); if (!b || b.disabled) return;
      sel = new Date(view.getFullYear(), view.getMonth(), +b.dataset.d); val.textContent = fmt(sel); render();
      setTimeout(function () { collapse(trig); }, 220);
    });
    grid.addEventListener('keydown', function (e) {
      var d = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key]; if (!d) return;
      var days = $$('.fm-cal__d', grid), i = days.indexOf(e.target.closest('.fm-cal__d')), j = i + d;
      while (j >= 0 && j < days.length && days[j].disabled) j += d;
      if (days[j]) { days.forEach(function (x) { x.tabIndex = -1; }); days[j].tabIndex = 0; days[j].focus(); }
      e.preventDefault();
    });
    trig.addEventListener('click', function () { view = new Date(sel.getFullYear(), sel.getMonth(), 1); render(); });
    render();
  })();

  // 035 省市区联动选择：逐级选择，选完最后一级收起
  (function () {
    var host = $('#fm-ar'); if (!host) return;
    var trig = $('#fm-ar-t'), val = $('#fm-ar-v'), tabs = $('.fm-ar__tabs', host), list = $('.fm-ar__list', host);
    var AREA = {
      '浙江省': { '杭州市': ['西湖区', '上城区', '滨江区', '余杭区', '萧山区'], '宁波市': ['海曙区', '江北区', '鄞州区', '北仑区'], '温州市': ['鹿城区', '龙湾区', '瓯海区'] },
      '江苏省': { '南京市': ['玄武区', '鼓楼区', '秦淮区', '建邺区'], '苏州市': ['姑苏区', '虎丘区', '吴中区', '相城区'], '无锡市': ['梁溪区', '滨湖区', '新吴区'] },
      '广东省': { '广州市': ['天河区', '越秀区', '海珠区', '番禺区'], '深圳市': ['南山区', '福田区', '罗湖区', '宝安区'], '佛山市': ['禅城区', '南海区', '顺德区'] },
      '四川省': { '成都市': ['锦江区', '武侯区', '青羊区', '成华区'], '绵阳市': ['涪城区', '游仙区', '安州区'] }
    };
    var sel = ['浙江省', '杭州市', ''], level = 2;
    function options(l) { return l === 0 ? Object.keys(AREA) : l === 1 ? Object.keys(AREA[sel[0]]) : AREA[sel[0]][sel[1]]; }
    function render() {
      var n = sel.filter(Boolean).length, shown = Math.min(3, n + 1);
      tabs.innerHTML = [0, 1, 2].slice(0, shown).map(function (i) { return '<button type="button" role="tab" aria-selected="' + (i === level) + '" data-l="' + i + '">' + (sel[i] || '请选择') + '</button>'; }).join('');
      list.innerHTML = options(level).map(function (o) { return '<button type="button" role="option" aria-selected="' + (sel[level] === o) + '" data-v="' + o + '">' + o + CHK + '</button>'; }).join('');
      val.textContent = n ? sel.filter(Boolean).join(' ') : '请选择'; trig.toggleAttribute('data-done', !!sel[2]);
    }
    list.addEventListener('click', function (e) {
      var b = e.target.closest('[data-v]'); if (!b) return;
      sel[level] = b.dataset.v; for (var j = level + 1; j < 3; j++) sel[j] = '';
      if (level < 2) level++;
      render(); list.scrollTop = 0;
      if (sel[2]) setTimeout(function () { collapse(trig); }, 220); else if (e.detail === 0) $('[data-v]', list).focus();
    });
    tabs.addEventListener('click', function (e) { var b = e.target.closest('[data-l]'); if (!b) return; level = +b.dataset.l; render(); $('[data-l="' + level + '"]', tabs).focus(); });
    render();
  })();

  // 036 配送时段选择格：先选日再选时段，已满的格子不可选
  (function () {
    var host = $('#fm-ts'); if (!host) return;
    var days = $('.fm-ts__days', host), grid = $('.fm-ts__grid', host), sum = $('.fm-ts__sum b', host);
    var D = [12, 13, 14, 15, 16].map(function (n) { return new Date(2026, 10, n); });
    var SLOTS = ['09:00-11:00', '11:00-13:00', '13:00-15:00', '15:00-17:00', '17:00-19:00', '19:00-21:00'];
    var M = [['x', 'x', 'o', 2, 'o', 'o'], ['o', 'o', 'o', 'o', 'x', 'o'], ['o', 'x', 'o', 'o', 'o', 3], ['o', 'o', 'x', 'x', 'o', 'o'], ['o', 'o', 'o', 'o', 'o', 'o']];
    var cur = { d: 0, s: 3 };
    function slotState(d, s) { var v = M[d][s]; return v === 'x' ? 'full' : v === 'o' ? 'ok' : 'few'; }
    function render() {
      days.innerHTML = D.map(function (d, i) { return '<button type="button" class="fm-ts__d" role="radio" aria-checked="' + (i === cur.d) + '" tabindex="' + (i === cur.d ? 0 : -1) + '" data-i="' + i + '"><span>' + WD[d.getDay()] + '</span><small>' + (d.getMonth() + 1) + '/' + d.getDate() + '</small></button>'; }).join('');
      grid.innerHTML = SLOTS.map(function (t, i) {
        var s = slotState(cur.d, i), v = M[cur.d][i];
        return '<button type="button" class="fm-ts__s" role="radio" aria-checked="' + (i === cur.s) + '" tabindex="' + (i === cur.s ? 0 : -1) + '" data-i="' + i + '" data-s="' + s + '"' + (s === 'full' ? ' disabled' : '') + ' aria-label="' + t + (s === 'full' ? ' 已满' : s === 'few' ? ' 仅剩 ' + v + ' 单' : ' 可约') + '"><b>' + t + '</b><small>' + (s === 'full' ? '已满' : s === 'few' ? '仅剩 ' + v + ' 单' : '可约') + '</small></button>';
      }).join('');
      var d = D[cur.d]; sum.textContent = WD[d.getDay()] + ' ' + (d.getMonth() + 1) + '/' + d.getDate() + ' ' + SLOTS[cur.s];
    }
    days.addEventListener('click', function (e) {
      var b = e.target.closest('[data-i]'); if (!b) return; cur.d = +b.dataset.i;
      if (slotState(cur.d, cur.s) === 'full') for (var i = 0; i < SLOTS.length; i++) if (slotState(cur.d, i) !== 'full') { cur.s = i; break; }
      render(); $('[data-i="' + cur.d + '"]', days).focus();
    });
    grid.addEventListener('click', function (e) { var b = e.target.closest('[data-i]'); if (!b || b.disabled) return; cur.s = +b.dataset.i; render(); $('[data-i="' + cur.s + '"]', grid).focus(); });
    function arrows(box, dim, get, set) {
      box.addEventListener('keydown', function (e) {
        var d = { ArrowRight: 1, ArrowDown: dim, ArrowLeft: -1, ArrowUp: -dim }[e.key]; if (!d) return;
        var i = get(), n = $$('[data-i]', box).length, j = i + d;
        while (j >= 0 && j < n && $('[data-i="' + j + '"]', box).disabled) j += d > 0 ? 1 : -1;
        if (j >= 0 && j < n) { set(j); } e.preventDefault();
      });
    }
    arrows(days, 1, function () { return cur.d; }, function (j) { days.querySelector('[data-i="' + j + '"]').click(); });
    arrows(grid, 3, function () { return cur.s; }, function (j) { grid.querySelector('[data-i="' + j + '"]').click(); });
    render();
  })();

  // 037 可删除标签输入：回车或逗号生成，退格删除最后一个
  (function () {
    var host = $('#fm-tk'); if (!host) return;
    var box = $('.fm-tk__box', host), inp = $('.fm-tk__in', host), err = $('.field__err', host), cnt = $('.fm-tk__n', host), sug = $('.fm-tags', host);
    var tags = ['花粉过敏', '香味敏感', '不要百合'], MAX = 6, COMMON = ['对花粉过敏', '猫狗同住', '怕刺激气味', '不要带刺', '少用满天星', '婴儿同住'];
    function msg(t) { err.hidden = !t; err.textContent = t || ''; if (t) box.setAttribute('data-invalid', ''); else box.removeAttribute('data-invalid'); }
    function render() {
      $$('.fm-tk__t', box).forEach(function (t) { t.remove(); });
      tags.forEach(function (t) {
        var s = document.createElement('span'); s.className = 'fm-tk__t';
        s.innerHTML = '<span></span><button type="button" class="fm-tk__x" aria-label="移除 ' + t + '" data-tip="移除">' + XIC + '</button>'; $('span', s).textContent = t; s.dataset.t = t;
        box.insertBefore(s, inp);
      });
      var full = tags.length >= MAX;
      cnt.textContent = tags.length + '/' + MAX; cnt.toggleAttribute('data-full', full);
      inp.disabled = full; inp.placeholder = full ? '已达上限' : '输入后按回车添加';
      sug.innerHTML = COMMON.map(function (c) { return '<button type="button"' + (tags.indexOf(c) >= 0 || full ? ' disabled' : '') + '>' + c + '</button>'; }).join('');
    }
    function add(raw) {
      var t = raw.trim(); if (!t) return false;
      if (tags.length >= MAX) { msg('最多添加 ' + MAX + ' 项'); return false; }
      if (t.length > 8) { msg('单项最多 8 个字'); shake(box); return false; }
      if (tags.indexOf(t) >= 0) { msg('已经添加过'); shake(box); return false; }
      tags.push(t); msg(''); render(); return true;
    }
    function drop(t, refocus) { var s = $('[data-t="' + t + '"]', box); var go = function () { tags = tags.filter(function (x) { return x !== t; }); msg(''); render(); if (refocus !== false) inp.focus(); }; if (s && !Lz.reduce) { s.classList.add('is-out'); setTimeout(go, 150); } else go(); }
    box.addEventListener('click', function (e) { var x = e.target.closest('.fm-tk__x'); if (x) drop(x.closest('.fm-tk__t').dataset.t); else inp.focus(); });
    inp.addEventListener('keydown', function (e) {
      if (e.isComposing) return;
      if (e.key === 'Enter') { e.preventDefault(); if (add(inp.value)) inp.value = ''; }
      else if (e.key === 'Backspace' && !inp.value && tags.length) { e.preventDefault(); drop(tags[tags.length - 1]); }
    });
    inp.addEventListener('input', function (e) {
      if (e.isComposing) return;
      var v = inp.value; if (/[,，、]$/.test(v)) { if (add(v.slice(0, -1))) inp.value = ''; else inp.value = v.slice(0, -1); } else if (!err.hidden) msg('');
    });
    sug.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b && !b.disabled) { add(b.textContent); } });
    render();
  })();

  // 038 支付密码输入框：设置后再确认，两次一致才通过
  (function () {
    var host = $('#fm-pc'); if (!host) return;
    var root = $('.fm-pc', host), title = $('.fm-pc__h b', host), eye = $('.fm-pc__h .btn', host), boxes = $('.fm-pc__boxes', host), cells = $$('.fm-pc__b', host), inp = $('.fm-pc__in', host), msg = $('.fm-pc__msg', host);
    var step = 1, first = '', busy = false;
    function paint() {
      var v = inp.value; boxes.setAttribute('aria-label', '已输入 ' + v.length + ' 位');
      cells.forEach(function (c, i) { c.classList.toggle('is-on', i < v.length); c.dataset.c = v[i] || ''; c.classList.toggle('is-cur', i === Math.min(v.length, 5) && root.dataset.st !== 'ok'); });
    }
    function reset(t, m, st) { inp.value = ''; inp.disabled = false; step = t; title.textContent = t === 1 ? '设置支付密码' : '确认支付密码'; msg.textContent = m || ''; root.dataset.st = st || ''; eye.textContent = '显示'; eye.setAttribute('aria-pressed', 'false'); boxes.removeAttribute('data-show'); paint(); }
    inp.addEventListener('input', function () {
      if (busy) return; var v = inp.value.replace(/\D/g, '').slice(0, 6); inp.value = v;
      if (root.dataset.st === 'err') { root.dataset.st = ''; msg.textContent = ''; }
      paint();
      if (v.length < 6) return;
      busy = true;
      setTimeout(function () {
        busy = false;
        if (step === 1) { first = v; reset(2, '请再输入一次'); inp.focus(); }
        else if (v === first) { inp.disabled = true; root.dataset.st = 'ok'; msg.textContent = '支付密码已设置'; title.textContent = '设置成功'; eye.textContent = '重新设置'; eye.setAttribute('aria-pressed', 'false'); paint(); Lz.toast('支付密码已设置', 'success'); }
        else { shake(boxes); reset(1, '两次输入不一致 请重新设置', 'err'); inp.focus(); }
      }, 220);
    });
    eye.addEventListener('click', function () {
      if (root.dataset.st === 'ok') { reset(1, ''); inp.focus(); return; }
      var on = !boxes.hasAttribute('data-show'); boxes.toggleAttribute('data-show', on); eye.setAttribute('aria-pressed', String(on)); eye.textContent = on ? '隐藏' : '显示';
    });
    inp.addEventListener('focus', paint); inp.addEventListener('blur', paint);
    reset(1, '');
  })();

  // 039 日期滚轮选择：年月日三列，天数随年月变化，不晚于当前日期
  (function () {
    var host = $('#fm-dw'); if (!host) return;
    var cols = { y: $('[data-u="y"]', host), m: $('[data-u="m"]', host), d: $('[data-u="d"]', host) }, out = $('.fm-dw__v', host);
    var MAXD = { y: 2026, m: 11, d: 9 }, MINY = 1940, UNIT = { y: '年', m: '月', d: '日' };
    var v = { y: 1995, m: 5, d: 18 }, timers = {};
    function maxM() { return v.y === MAXD.y ? MAXD.m : 12; }
    function maxDay() { var n = new Date(v.y, v.m, 0).getDate(); return v.y === MAXD.y && v.m === MAXD.m ? Math.min(n, MAXD.d) : n; }
    function range(u) { return u === 'y' ? [MINY, MAXD.y] : u === 'm' ? [1, maxM()] : [1, maxDay()]; }
    function fill(u) {
      var r = range(u), h = '<div class="wheel__pad"></div>';
      for (var i = r[0]; i <= r[1]; i++) h += '<div class="wheel__item" data-v="' + i + '" aria-hidden="true">' + i + UNIT[u] + '</div>';
      cols[u].innerHTML = h + '<div class="wheel__pad"></div>';
      v[u] = clamp(v[u], r[0], r[1]); place(u);
    }
    function place(u) {
      var c = cols[u], r = range(u); c.scrollTop = (v[u] - r[0]) * 44; c._pos = c.scrollTop;
      $$('.wheel__item', c).forEach(function (it) { it.setAttribute('aria-selected', String(+it.dataset.v === v[u])); });
      c.setAttribute('aria-valuemin', r[0]); c.setAttribute('aria-valuemax', r[1]); c.setAttribute('aria-valuenow', v[u]); c.setAttribute('aria-valuetext', v[u] + ' ' + UNIT[u]);
    }
    function show() { out.textContent = v.y + ' 年 ' + v.m + ' 月 ' + v.d + ' 日'; }
    function set(u, n) {
      var r = range(u); n = clamp(n, r[0], r[1]); var changed = n !== v[u]; v[u] = n; place(u);
      if (changed && u === 'y') { fill('m'); fill('d'); } else if (changed && u === 'm') fill('d');
      show();
    }
    ['y', 'm', 'd'].forEach(function (u) {
      var c = cols[u];
      c.addEventListener('scroll', function () {
        if (Math.abs(c.scrollTop - (c._pos || 0)) < 1.5) return; clearTimeout(timers[u]);
        timers[u] = setTimeout(function () { var r = range(u); set(u, r[0] + Math.round(c.scrollTop / 44)); }, 90);
      }, { passive: true });
      c.addEventListener('click', function (e) { var it = e.target.closest('.wheel__item'); if (it) set(u, +it.dataset.v); });
      c.addEventListener('keydown', function (e) {
        var r = range(u), d = { ArrowUp: -1, ArrowDown: 1, PageUp: -5, PageDown: 5 }[e.key];
        if (e.key === 'Home') set(u, r[0]); else if (e.key === 'End') set(u, r[1]); else if (d) set(u, v[u] + d); else return;
        e.preventDefault();
      });
    });
    fill('y'); fill('m'); fill('d'); show();
    new ResizeObserver(function () { ['y', 'm', 'd'].forEach(place); }).observe(cols.y);
  })();

  // 040 分类树选择：左侧选类目，右侧勾选子项，类目上显示已选数量
  (function () {
    var host = $('#fm-tr'); if (!host) return;
    var rail = $('.fm-tr__rail', host), pane = $('.fm-tr__pane', host), head = $('.fm-tr__ph b', host), allBtn = $('[data-all]', host), list = $('.fm-tr__list', host), cnt = $('.fm-tr__bar b', host);
    var T = [['鲜花', ['玫瑰', '芍药', '向日葵', '郁金香', '康乃馨', '百合']], ['绿植', ['龟背竹', '绿萝', '多肉', '琴叶榕', '绣球']], ['干花', ['满天星', '尤加利', '蒲苇', '棉花']], ['花器', ['玻璃瓶', '陶瓷瓶', '藤编篮']]];
    var on = { '玫瑰': 1, '尤加利': 1 }, cur = 0, MAX = 6;
    function nOf(i) { return T[i][1].filter(function (x) { return on[x]; }).length; }
    function total() { return Object.keys(on).length; }
    function render() {
      rail.innerHTML = T.map(function (t, i) { var n = nOf(i); return '<button type="button" role="tab" aria-selected="' + (i === cur) + '" tabindex="' + (i === cur ? 0 : -1) + '" data-i="' + i + '"><span>' + t[0] + '</span>' + (n ? '<i>' + n + '</i>' : '') + '</button>'; }).join('');
      head.textContent = T[cur][0]; pane.setAttribute('aria-label', T[cur][0]);
      var all = nOf(cur) === T[cur][1].length; allBtn.textContent = all ? '取消全选' : '全选';
      list.innerHTML = T[cur][1].map(function (x) { return '<button type="button" class="fm-tr__it" role="checkbox" aria-checked="' + !!on[x] + '" data-v="' + x + '"><span class="check" aria-hidden="true" aria-checked="' + !!on[x] + '">' + CHK + '</span>' + x + '</button>'; }).join('');
      cnt.textContent = total();
    }
    function refresh() { var top = list.scrollTop; var keep = document.activeElement && document.activeElement.dataset ? document.activeElement.dataset.v : null; render(); list.scrollTop = top; list.style.animation = 'none'; if (keep) { var b = $('[data-v="' + keep + '"]', list); if (b) b.focus({ preventScroll: true }); } }
    rail.addEventListener('click', function (e) { var b = e.target.closest('[data-i]'); if (!b) return; cur = +b.dataset.i; render(); list.scrollTop = 0; $('[data-i="' + cur + '"]', rail).focus(); });
    rail.addEventListener('keydown', function (e) { var d = { ArrowDown: 1, ArrowUp: -1 }[e.key]; if (!d) return; cur = clamp(cur + d, 0, T.length - 1); render(); $('[data-i="' + cur + '"]', rail).focus(); e.preventDefault(); });
    list.addEventListener('click', function (e) {
      var b = e.target.closest('[data-v]'); if (!b) return; var x = b.dataset.v;
      if (on[x]) delete on[x]; else if (total() >= MAX) { Lz.toast('最多选 ' + MAX + ' 项', 'danger'); shake(b); return; } else on[x] = 1;
      refresh();
    });
    allBtn.addEventListener('click', function () {
      var items = T[cur][1], all = nOf(cur) === items.length;
      if (all) items.forEach(function (x) { delete on[x]; });
      else { var need = items.filter(function (x) { return !on[x]; }).length; if (total() + need > MAX) { Lz.toast('最多选 ' + MAX + ' 项', 'danger'); return; } items.forEach(function (x) { on[x] = 1; }); }
      refresh();
    });
    $('[data-clear]', host).addEventListener('click', function () { on = {}; refresh(); });
    $('[data-ok]', host).addEventListener('click', function () { Lz.toast(total() ? '已选 ' + total() + ' 项花材' : '请先勾选花材', total() ? 'success' : 'danger'); });
    render();
  })();

  // 041 头像裁剪框：拖动移动，滑块与按钮缩放，预览实时绘制
  (function () {
    var host = $('#fm-cr'); if (!host) return;
    var box = $('.fm-cr__box', host), img = $('.fm-cr__img', host), pc = $('.fm-cr__pc', host), zo = $('[data-z="-1"]', host), zi = $('[data-z="1"]', host), pv = $('.fm-cr__pv', host), file = $('input[type=file]', host);
    var ctx = pv.getContext('2d'), nat = { w: 1, h: 1 }, st = { z: 1, x: 0, y: 0 }, D = 200, base = 1, url = null;
    function layout() {
      var w = box.clientWidth, h = box.clientHeight; if (!w || !nat.w) return;
      D = Math.round(Math.min(w, h) * .8); base = Math.max(w / nat.w, h / nat.h);
      box.style.setProperty('--cr', D / 2 + 'px'); apply();
    }
    function apply() {
      var w = box.clientWidth, h = box.clientHeight, s = base * st.z, dw = nat.w * s, dh = nat.h * s;
      st.x = clamp(st.x, -(dw - w) / 2, (dw - w) / 2); st.y = clamp(st.y, -(dh - h) / 2, (dh - h) / 2);
      img.style.width = dw + 'px'; img.style.height = dh + 'px'; img.style.left = (w / 2 + st.x - dw / 2) + 'px'; img.style.top = (h / 2 + st.y - dh / 2) + 'px';
      pc.textContent = Math.round(st.z * 100) + '%'; zo.disabled = st.z <= 1.001; zi.disabled = st.z >= 2.999;
      var sw = D / s, sx = (dw / 2 - st.x - D / 2) / s, sy = (dh / 2 - st.y - D / 2) / s;
      try { ctx.clearRect(0, 0, pv.width, pv.height); ctx.drawImage(img, sx, sy, sw, sw, 0, 0, pv.width, pv.height); } catch (e) { /* 图片未就绪时跳过 */ }
    }
    function zoom(z) { st.z = clamp(z, 1, 3); apply(); }
    function load() { nat = { w: img.naturalWidth || 1, h: img.naturalHeight || 1 }; st = { z: 1, x: 0, y: 0 }; layout(); }
    if (img.complete && img.naturalWidth) load(); img.addEventListener('load', load);
    var drag = null, pts = {}, pin = null;
    box.addEventListener('pointerdown', function (e) {
      if (e.button) return; pts[e.pointerId] = { x: e.clientX, y: e.clientY }; try { box.setPointerCapture(e.pointerId); } catch (err) { /* 合成事件无法捕获 */ }
      var ids = Object.keys(pts);
      if (ids.length === 2) { var a = pts[ids[0]], b = pts[ids[1]]; pin = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, z: st.z }; drag = null; }
      else { drag = { x: e.clientX, y: e.clientY, ox: st.x, oy: st.y }; box.classList.add('is-drag'); }
    });
    box.addEventListener('pointermove', function (e) {
      if (!pts[e.pointerId]) return; pts[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pts);
      if (pin && ids.length === 2) { var a = pts[ids[0]], b = pts[ids[1]]; zoom(pin.z * Math.hypot(a.x - b.x, a.y - b.y) / pin.d); return; }
      if (!drag) return; st.x = drag.ox + e.clientX - drag.x; st.y = drag.oy + e.clientY - drag.y; apply();
    });
    function end(e) {
      delete pts[e.pointerId]; pin = null; var ids = Object.keys(pts);
      if (ids.length === 1) { var p = pts[ids[0]]; drag = { x: p.x, y: p.y, ox: st.x, oy: st.y }; } else { drag = null; box.classList.remove('is-drag'); }
    }
    box.addEventListener('pointerup', end); box.addEventListener('pointercancel', end);
    box.addEventListener('wheel', function (e) { if (!e.ctrlKey) return; e.preventDefault(); zoom(st.z - e.deltaY * .01); }, { passive: false });
    box.addEventListener('keydown', function (e) {
      var m = { ArrowLeft: [-8, 0], ArrowRight: [8, 0], ArrowUp: [0, -8], ArrowDown: [0, 8] }[e.key];
      if (m) { st.x += m[0]; st.y += m[1]; apply(); e.preventDefault(); }
      else if (e.key === '+' || e.key === '=') { zoom(st.z + .1); e.preventDefault(); } else if (e.key === '-') { zoom(st.z - .1); e.preventDefault(); }
    });
    $$('[data-z]', host).forEach(function (b) { b.addEventListener('click', function () { zoom(st.z + .2 * +b.dataset.z); }); });
    $('[data-pick]', host).addEventListener('click', function () { file.click(); });
    file.addEventListener('change', function () { var f = file.files[0]; if (!f) return; if (url) URL.revokeObjectURL(url); url = URL.createObjectURL(f); img.src = url; file.value = ''; });
    $('[data-ok]', host).addEventListener('click', function () { Lz.toast('头像已更新', 'success'); });
    new ResizeObserver(layout).observe(box);
  })();

  // 042 手写签名板：指针书写，撤销、清除与确认
  (function () {
    var host = $('#fm-sg'); if (!host) return;
    var pad = $('.fm-sg__pad', host), cv = $('canvas', pad);
    var viewPad = $('[data-view="pad"]', host), viewDone = $('[data-view="done"]', host);
    var undo = $('[data-undo]', host), clear = $('[data-clear]', host), ok = $('[data-ok]', host);
    var strokes = [], cur = null;
    function ink() { return getComputedStyle(pad).color; }
    function draw(c, k, list, tx, ty) {
      var x = c.getContext('2d'), dpr = devicePixelRatio || 1, w = c.clientWidth, h = c.clientHeight;
      if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
      x.setTransform(1, 0, 0, 1, 0, 0); x.clearRect(0, 0, c.width, c.height);
      x.setTransform(dpr * k, 0, 0, dpr * k, dpr * (tx || 0), dpr * (ty || 0));
      x.strokeStyle = x.fillStyle = ink(); x.lineWidth = 2.6 / k; x.lineCap = x.lineJoin = 'round';
      list.forEach(function (s) {
        if (s.length === 1) { x.beginPath(); x.arc(s[0].x, s[0].y, 1.5 / k, 0, 7); x.fill(); return; }
        x.beginPath(); x.moveTo(s[0].x, s[0].y);
        for (var i = 1; i < s.length - 1; i++) x.quadraticCurveTo(s[i].x, s[i].y, (s[i].x + s[i + 1].x) / 2, (s[i].y + s[i + 1].y) / 2);
        x.lineTo(s[s.length - 1].x, s[s.length - 1].y); x.stroke();
      });
    }
    function sync() {
      var n = strokes.length; pad.toggleAttribute('data-on', n > 0);
      undo.disabled = clear.disabled = ok.disabled = n === 0; cv.setAttribute('aria-label', n ? '手写签名板 已书写 ' + n + ' 笔' : '手写签名板 尚未签名');
      draw(cv, 1, strokes);
    }
    function pt(e) { var r = cv.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
    cv.addEventListener('pointerdown', function (e) { if (e.button) return; cv.setPointerCapture(e.pointerId); cur = [pt(e)]; strokes.push(cur); sync(); });
    cv.addEventListener('pointermove', function (e) { if (!cur) return; cur.push(pt(e)); draw(cv, 1, strokes); });
    function end() { if (cur) { cur = null; sync(); } }
    cv.addEventListener('pointerup', end); cv.addEventListener('pointercancel', end);
    undo.addEventListener('click', function () { strokes.pop(); sync(); });
    clear.addEventListener('click', function () { strokes = []; sync(); });
    ok.addEventListener('click', function () {
      viewPad.hidden = true; viewDone.hidden = false;
      var dc = $('canvas', viewDone), xs = [], ys = [];
      strokes.forEach(function (q) { q.forEach(function (p) { xs.push(p.x); ys.push(p.y); }); });
      var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs), y0 = Math.min.apply(null, ys), y1 = Math.max.apply(null, ys);
      var bw = Math.max(x1 - x0, 1), bh = Math.max(y1 - y0, 1), k = Math.min(1, (dc.clientWidth - 32) / bw, (dc.clientHeight - 32) / bh);
      draw(dc, k, strokes, (dc.clientWidth - bw * k) / 2 - x0 * k, (dc.clientHeight - bh * k) / 2 - y0 * k);
      Lz.toast('签名已确认', 'success');
    });
    $('[data-redo]', host).addEventListener('click', function () { strokes = []; viewDone.hidden = true; viewPad.hidden = false; sync(); });
    new ResizeObserver(function () { draw(cv, 1, strokes); }).observe(cv);
    document.addEventListener('lz:skin', function () { draw(cv, 1, strokes); });
    sync();
  })();

  // 043 数字键盘：验证码显示数字，支付密码显示圆点，可乱序
  (function () {
    var host = $('#fm-nk'); if (!host) return;
    var cells = $('.fm-nk__cells', host), cs = $$('.fm-nk__c', host), pad = $('.fm-nk__pad', host), shuf = $('[data-shuffle]', host);
    var val = '', mode = 'code', order = [1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
    function paint() {
      cells.setAttribute('aria-label', '已输入 ' + val.length + ' 位 共 6 位');
      cs.forEach(function (c, i) { c.textContent = val[i] || ''; c.classList.toggle('is-on', i < val.length); c.classList.toggle('is-cur', i === val.length); });
      $$('[data-k]', pad).forEach(function (k) { k.disabled = val.length >= 6; });
    }
    function build() {
      var o = order, fn = function (c, t, a) { return '<button type="button" class="fm-nk__k fm-nk__k--fn" data-a="' + a + '" aria-label="' + t + '">' + t + '</button>'; };
      var key = function (n) { return '<button type="button" class="fm-nk__k" data-k="' + n + '">' + n + '</button>'; };
      pad.innerHTML = o.slice(0, 9).map(key).join('') + fn('', '清空', 'clear') + key(o[9]) + fn('', '删除', 'del');
      paint();
    }
    function done() { Lz.toast(mode === 'code' ? '验证码已填写' : '支付密码已输入', 'success'); }
    function put(n) { if (val.length >= 6) return; val += n; paint(); if (val.length === 6) done(); }
    pad.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b || b.disabled && !b.dataset.a) return;
      if (b.dataset.k !== undefined) put(b.dataset.k); else if (b.dataset.a === 'del') { val = val.slice(0, -1); paint(); } else { val = ''; paint(); }
    });
    host.addEventListener('keydown', function (e) {
      if (/^[0-9]$/.test(e.key)) { put(e.key); e.preventDefault(); } else if (e.key === 'Backspace') { val = val.slice(0, -1); paint(); e.preventDefault(); }
    });
    host.addEventListener('lz:seg', function (e) { mode = e.detail.key; cells.dataset.mode = mode; val = ''; paint(); });
    shuf.addEventListener('click', function () {
      var on = shuf.getAttribute('aria-pressed') !== 'true'; shuf.setAttribute('aria-pressed', String(on));
      order = [1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
      if (on) for (var i = order.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)), t = order[i]; order[i] = order[j]; order[j] = t; }
      build();
    });
    build();
  })();
})();
</script>
