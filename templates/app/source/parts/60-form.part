      <span class="field__label" id="fm-ar-l">所在地区</span>
      <button type="button" class="fm-tg" id="fm-ar-t" data-expand="fm-ar-p" aria-labelledby="fm-ar-l fm-ar-v"><b id="fm-ar-v">请选择</b><span class="chev"></span></button>
    </div>
    <div class="expand fm-pnl" id="fm-ar-p" data-open="true"><div>
      <div class="card">
        <div class="fm-ar__tabs" role="tablist" aria-label="地区级别"></div>
        <div class="fm-ar__list" role="listbox" aria-label="选择地区"></div>
      </div>
    </div></div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-036" data-name="配送时段选择格" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">配送时段选择格</span></div>
  <p class="demo__note">适合：预约与配送先选日再选时段，格子标出可约与已满</p>
  <div class="demo__stage">
    <div class="card fm-ts" id="fm-ts">
      <div class="fm-ts__days" role="radiogroup" aria-label="配送日期"></div>
      <div class="fm-ts__grid" role="radiogroup" aria-label="配送时段"></div>
      <div class="fm-ts__sum"><span>已选时段</span><b></b></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FORM-037" data-name="可删除标签输入" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">可删除标签输入</span></div>
  <p class="demo__note">适合：输入后生成可删除的标签，如偏好与过敏原</p>
  <div class="demo__stage" id="fm-tk">
    <div class="field">
      <div class="fm-tk__h"><label class="field__label" for="fm-tk-i">过敏原与禁忌</label><span class="fm-tk__n" role="status">3/6</span></div>
      <div class="fm-tk__box field-shell"><input class="fm-tk__in" id="fm-tk-i" placeholder="输入后按回车添加" autocomplete="off" maxlength="12" aria-describedby="fm-tk-e"></div>
      <p class="field__err" id="fm-tk-e" role="alert" hidden></p>
