        <div class="btn-group"><button class="btn btn--secondary btn--sm" data-q="玫瑰">玫瑰</button><button class="btn btn--secondary btn--sm" data-q="花束">花束</button><button class="btn btn--secondary btn--sm" data-q="盆栽">盆栽</button></div>
