<style>
/* 新增列表行：文本展开 te、关键词高亮 hl、头像兜底 avs、分割线 dvl、相对时间 rt、拖拽排序 dr、虚拟列表 vl */
/* 020 文本展开收起 */
.rw-te__it { display: grid; gap: var(--s-2); padding: var(--s-4); }
.rw-te__it + .rw-te__it { border-top: 1px solid var(--line); }
.rw-te__h { display: flex; align-items: center; gap: var(--s-3); }
.rw-te__h .rw-av { width: 40px; height: 40px; padding: 6px; }
.rw-te__h .rw-av--sq { padding: 0; object-fit: cover; }
.rw-te__t { font-size: var(--fs-md); line-height: var(--lh-body); color: var(--ink-2); }
.rw-te__t.is-clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--n, 3); overflow: hidden; }
.rw-te__b { justify-self: start; min-height: 32px; margin: -2px 0 -6px calc(var(--s-2) * -1); }

/* 021 关键词高亮文本 */
.rw-hl { overflow: hidden; }
.rw-hl__bar { display: grid; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
.rw-hl__n { padding: var(--s-2) var(--s-4) 0; font-size: var(--fs-sm); color: var(--ink-3); min-height: 30px; }
.rw-hl__k { padding: 0 1px; background: linear-gradient(transparent 52%, var(--action-edge) 52%); color: var(--action-press); font-weight: 600; }
.rw-hl__l .row { min-height: 64px; }
.rw-hl__e { padding: var(--s-5) var(--s-4); }
.rw-hl__e img { width: 64px; height: 64px; }

/* 022 头像尺寸兜底 */
.rw-avs { overflow: hidden; }
.rw-avs__bar { padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
.rw-avs .seg__item { padding: 0 var(--s-3); }
.rw-avs__a { --sz: 40px; display: grid; place-items: center; flex: none; width: var(--sz); height: var(--sz); border-radius: 50%; overflow: hidden; background: var(--zone); box-shadow: inset 0 0 0 1px var(--line); transition: width var(--dur-base) var(--ease-out), height var(--dur-base) var(--ease-out); }
.rw-avs__a img { width: 100%; height: 100%; object-fit: cover; }
.rw-avs__a[data-kind="mark"] { background: var(--surface); }
.rw-avs__a[data-kind="mark"] img { width: 68%; height: 68%; object-fit: contain; }
.rw-avs__a[data-kind="line"] img { width: 58%; height: 58%; object-fit: contain; opacity: .55; }
.rw-avs .row { min-height: 72px; }

/* 023 带文字分割线 */
.rw-dvl__bar { padding: var(--s-3) var(--s-4); }
.rw-dvl__bar .seg__item { padding: 0 var(--s-4); }
.rw-dv { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 44px; padding: 0 var(--s-4); font-size: var(--fs-sm); color: var(--ink-3); background: var(--surface); }
.rw-dv::before, .rw-dv::after { content: ""; flex: 1; border-top: 1px solid var(--line-strong); }
.rw-dv__t { display: inline-flex; align-items: center; gap: var(--s-1); font-weight: 600; color: var(--ink-2); }
.rw-dv__t small { min-width: 20px; padding: 0 6px; border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-xs); font-weight: 600; line-height: 20px; text-align: center; color: var(--ink-3); }
[data-s="left"] > .rw-dv::before { display: none; }
[data-s="dash"] > .rw-dv::before, [data-s="dash"] > .rw-dv::after { border-top-style: dashed; }
.rw-dvl__off { opacity: .6; }

/* 024 相对时间文本 */
.rw-rt__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
.rw-rt .row { align-items: flex-start; min-height: 64px; }
.rw-rt .rw-av { width: 40px; height: 40px; padding: 6px; }
.rw-rt .row__trail { padding-top: 2px; }
.rw-rt__t { padding: 4px 6px; margin: -4px -6px; border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
@media (hover: hover) { .rw-rt__t:hover { background: var(--zone); } }
.rw-rt .row[data-new] { animation: lz-rise var(--dur-slow) var(--ease-out) both; }

/* 025 拖拽排序行 */
.rw-dr { overflow: hidden; }
.rw-dr__l { position: relative; transition: background var(--dur-quick) var(--ease-out); }
.rw-dr__l.is-dragging { background: var(--zone); }
.rw-dr__r { background: var(--surface); }
.rw-dr__r.is-drag { z-index: 2; box-shadow: var(--elev-2); }
.rw-dr__h { display: inline-flex; align-items: center; justify-content: center; flex: none; min-width: 52px; height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); background: var(--zone); color: var(--ink-2); font-size: var(--fs-sm); font-weight: 600; touch-action: none; cursor: grab; transition: background var(--dur-quick) var(--ease-out); }
.rw-dr__r.is-drag .rw-dr__h { cursor: grabbing; background: var(--action-soft); color: var(--action-press); }
.rw-dr__h[disabled] { background: none; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-3); cursor: not-allowed; }
.rw-dr__n { min-width: 20px; text-align: center; font-size: var(--fs-md); font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.rw-dr__f { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
.rw-dr__s { min-width: 0; font-size: var(--fs-sm); color: var(--ink-2); }

/* 026 虚拟滚动列表 */
.rw-vl { overflow: hidden; }
.rw-vl__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
.rw-vl__r { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
.rw-vl__sc { height: 360px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
.rw-vl__sc:focus-visible { outline-offset: -2px; border-radius: 0; }
.rw-vl__pad { position: relative; }
.rw-vl__win { position: absolute; top: 0; left: 0; right: 0; will-change: transform; }
.rw-vl .row { height: 72px; min-height: 72px; padding-block: 0; }
.rw-vl .row::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.rw-vl .row[data-i="0"]::before { display: none; }
.rw-vl .row__trail { align-items: flex-end; }
.rw-vl__f { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
</style>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var D = function (cid) { return document.querySelector('[data-cid="' + cid + '"]'); };
  var pad = function (n) { return String(n).padStart(2, '0'); };

  /* 020 文本展开收起：超过行数才出按钮，展开后按钮变为收起 */
  (function () {
    var root = D('AP-ROWS-020'); if (!root) return;
    $$('.rw-te__it', root).forEach(function (it) {
      var t = $('.rw-te__t', it), b = $('.rw-te__b', it);
      t.style.setProperty('--n', t.dataset.lines || 3); t.classList.add('is-clamp');
      function measure() {
        if (b.getAttribute('aria-expanded') === 'true') return;
        t.classList.add('is-clamp'); b.hidden = !(t.scrollHeight > t.clientHeight + 1);
      }
      b.addEventListener('click', function () {
        var open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(open)); t.classList.toggle('is-clamp', !open); b.textContent = open ? '收起' : '展开全文';
      });
      new ResizeObserver(measure).observe(t); measure();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    });
  })();

  /* 021 关键词高亮：空格分隔多个词，名称与说明里命中的字都高亮，输入法组字时不过滤 */
  (function () {
    var root = D('AP-ROWS-021'); if (!root) return;
    var input = $('input', root), list = $('[data-list]', root), n = $('[data-n]', root), empty = $('[data-empty]', root);
    var P = [
      ['product-rose-red', '红玫瑰花束', '19 枝 牛皮纸包装', 199], ['product-sunflower', '向日葵花束', '9 枝 麻绳束扎', 159], ['product-succulent', '多肉组合盆', '四种多肉 白色陶盆', 89],
      ['product-monstera', '龟背竹盆栽', '中盆 白色陶瓷', 159], ['product-pampas-vase', '干花花瓶摆件', '蒲苇 玻璃花瓶', 129], ['product-peony-pink', '粉芍药花束', '11 枝 雾粉包装纸', 239],
      ['product-tulip-white', '白郁金香花束', '15 枝 透明纸包装', 179], ['product-hydrangea-blue', '蓝绣球盆栽', '大盆 陶土盆', 129], ['product-giftbox', '花礼盒', '含红玫瑰 3 枝 附贺卡', 268]
    ];
    var esc = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); };
    function mark(host, text, words) {
      host.textContent = '';
      if (!words.length) { host.textContent = text; return; }
      var re = new RegExp('(' + words.map(esc).join('|') + ')', 'g'), last = 0, m;
      while ((m = re.exec(text))) {
        if (m.index > last) host.append(text.slice(last, m.index));
        var k = document.createElement('mark'); k.className = 'rw-hl__k'; k.textContent = m[0]; host.append(k); last = m.index + m[0].length;
      }
      if (last < text.length) host.append(text.slice(last));
    }
    function render() {
      var words = input.value.trim().split(/\s+/).filter(Boolean);
      var hit = P.filter(function (p) { return words.every(function (w) { return (p[1] + p[2]).indexOf(w) >= 0; }); });
      list.textContent = '';
      hit.forEach(function (p) {
        var row = document.createElement('div'); row.className = 'row';
        row.innerHTML = '<img class="row__lead" alt=""><div class="row__main"><p class="row__title one-line"></p><p class="row__meta one-line"></p></div><span class="price"><small>¥</small>' + p[3] + '</span>';
        $('.row__lead', row).src = '../../kit/assets/photo/' + p[0] + '.webp';
        mark($('.row__title', row), p[1], words); mark($('.row__meta', row), p[2], words); list.append(row);
      });
      list.hidden = !hit.length; empty.hidden = !!hit.length;
      n.textContent = words.length ? '找到 ' + hit.length + ' 个商品' : '全部 ' + P.length + ' 个商品';
    }
    var composing = false;
    input.addEventListener('compositionstart', function () { composing = true; });
    input.addEventListener('compositionend', function () { composing = false; render(); });
    input.addEventListener('input', function () { if (!composing) render(); });
    $$('[data-q]', root).forEach(function (b) { b.addEventListener('click', function () { input.value = b.dataset.q; render(); }); });
    render();
  })();

  /* 022 头像尺寸兜底：照片失效时换成按用户固定的对象标识；没有标识的用线性图标 */
  (function () {
    var root = D('AP-ROWS-022'); if (!root) return;
    var boxes = $$('.rw-avs__a', root), fail = $('[data-fail]', root), meta = $('[data-m]', root);
    var photo = boxes[0], img = $('img', photo);
    function toFallback() { img.src = photo.dataset.fb; photo.dataset.kind = 'mark'; meta.textContent = '照片失效 固定对象标识'; fail.textContent = '恢复'; fail.setAttribute('aria-pressed', 'true'); }
    function toPhoto() { img.src = photo.dataset.src; photo.dataset.kind = 'photo'; meta.textContent = '已上传照片'; fail.textContent = '模拟失效'; fail.setAttribute('aria-pressed', 'false'); }
    img.addEventListener('error', function () { if (photo.dataset.kind === 'photo') toFallback(); });
    fail.addEventListener('click', function () { if (fail.getAttribute('aria-pressed') === 'true') toPhoto(); else toFallback(); });
    root.addEventListener('lz:seg', function (e) { boxes.forEach(function (b) { b.style.setProperty('--sz', e.detail.key + 'px'); }); });
    boxes.forEach(function (b) { b.style.setProperty('--sz', '40px'); });
  })();

  /* 023 分割线样式：居中、靠左、虚线，三种共用同一个可折叠的分组名 */
  (function () {
    var root = D('AP-ROWS-023'); if (!root) return;
    var host = $('.rw-dvl', root);
    root.addEventListener('lz:seg', function (e) { host.dataset.s = e.detail.key; });
  })();

  /* 024 相对时间：每十五秒刷新，点时间在相对与完整时刻之间切换 */
  (function () {
    var root = D('AP-ROWS-024'); if (!root) return;
    var list = $('[data-list]', root), WK = ['日', '一', '二', '三', '四', '五', '六'];
    var day0 = function (d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); };
    var hm = function (d) { return pad(d.getHours()) + ':' + pad(d.getMinutes()); };
    var dateOnly = function (d) { return d.getFullYear() + '年' + (d.getMonth() + 1) + '月' + d.getDate() + '日'; };
    var abs = function (d) { return dateOnly(d) + ' ' + hm(d); };
    function rel(d, now) {
      var s = Math.floor((now - d) / 1000);
      if (s < 60) return '刚刚';
      if (s < 3600) return Math.floor(s / 60) + ' 分钟前';
      var dd = Math.round((day0(now) - day0(d)) / 864e5);
      if (dd === 0) return Math.floor(s / 3600) + ' 小时前';
      if (dd === 1) return '昨天 ' + hm(d);
      if (dd === 2) return '前天 ' + hm(d);
      if (dd < 7) return '周' + WK[d.getDay()] + ' ' + hm(d);
      if (d.getFullYear() === now.getFullYear()) return (d.getMonth() + 1) + '月' + d.getDate() + '日';
      return dateOnly(d);
    }
    var M = [['林晓', 'mark-001', '花束收到了 非常漂亮', 8], ['陈琳', 'mark-002', '明天的花艺课程已经安排好', 260], ['周明', 'mark-003', '已到达楼下 请取花', 11400], ['吴悦', 'mark-004', '想预订周六的生日花篮', 100800],
      ['郑雅', 'mark-005', '上次的绣球开得很好', 259200], ['赵宁', 'mark-006', '请问可以开具发票吗', 1728000], ['孙乐', 'mark-008', '会员积分已经到账', 34560000]];
    function addRow(name, mark, text, d, isNew) {
      var row = document.createElement('div'); row.className = 'row'; if (isNew) row.dataset.new = '';
      row.innerHTML = '<img class="rw-av" alt=""><div class="row__main"><p class="row__title one-line"></p><p class="row__meta one-line"></p></div><span class="row__trail"><button class="rw-rt__t"><time></time></button></span>';
      $('.rw-av', row).src = '../../kit/assets/marks/' + mark + '.webp';
      $('.row__title', row).textContent = name; $('.row__meta', row).textContent = text;
      var b = $('.rw-rt__t', row); b._d = d; b._abs = false; b.addEventListener('click', function () { b._abs = !b._abs; paint(b); });
      if (isNew) list.insertBefore(row, list.firstChild); else list.append(row);
      paint(b);
    }
    function paint(b) {
      var now = new Date(), t = $('time', b); t.dateTime = b._d.toISOString();
      t.textContent = b._abs ? abs(b._d) : rel(b._d, now); b.dataset.tip = b._abs ? rel(b._d, now) : abs(b._d); b.setAttribute('aria-label', abs(b._d));
    }
    var t0 = Date.now();
    M.forEach(function (m) { addRow(m[0], m[1], m[2], new Date(t0 - m[3] * 1000)); });
    setInterval(function () { $$('.rw-rt__t', root).forEach(paint); }, 15000);
    var cnt = 0, S = [['客服', '订单已确认 马上备货'], ['客服', '花材已备好'], ['客服', '骑手已取货']];
    $('[data-send]', root).addEventListener('click', function () {
      var s = S[cnt++ % S.length]; addRow(s[0], 'mark-007', s[1], new Date(), true);
      var rows = $$('.row', list); if (rows.length > 8) rows[rows.length - 1].remove();
    });
  })();

  /* 025 拖拽排序：手柄指针拖动，上下方向键也能移动；末位固定不可动 */
  (function () {
    var root = D('AP-ROWS-025'); if (!root) return;
    var list = $('.rw-dr__l', root), stat = $('[data-s]', root), bReset = $('[data-reset]', root), bSave = $('[data-save]', root);
    var all = function () { return $$('.rw-dr__r', list); }, mov = function () { return all().filter(function (r) { return !r.hasAttribute('data-lock'); }); };
    var ids = function () { return all().map(function (r) { return r.dataset.id; }).join(); };
    var nm = function (r) { return $('.row__title', r).textContent; };
    var base = ids(), orig = all(), drag = null;
    function number() { all().forEach(function (r, i) { $('.rw-dr__n', r).textContent = i + 1; }); bReset.disabled = bSave.disabled = ids() === base; }
    function place(row, idx) {
      var others = mov().filter(function (r) { return r !== row; }); idx = Math.max(0, Math.min(others.length, idx));
      if (mov().indexOf(row) === idx) return false;
      var ref = others[idx] || $('[data-lock]', list) || null, rows = all(), before = new Map(rows.map(function (r) { return [r, r.offsetTop]; }));
      list.insertBefore(row, ref);
      rows.forEach(function (r) { if (r === row) return; var dy = before.get(r) - r.offsetTop; if (dy && !Lz.reduce) r.animate([{ transform: 'translateY(' + dy + 'px)' }, { transform: 'none' }], { duration: 200, easing: 'cubic-bezier(.22,1,.36,1)' }); });
      number(); return true;
    }
    function said(row) { stat.textContent = '已将' + nm(row) + '放到第 ' + (all().indexOf(row) + 1) + ' 位'; }
    all().forEach(function (row) {
      var h = $('.rw-dr__h', row); if (h.disabled) return;
      h.addEventListener('pointerdown', function (e) {
        if (e.button) return; e.preventDefault();
        drag = { row: row, y: e.clientY, top: row.offsetTop }; row.classList.add('is-drag'); list.classList.add('is-dragging'); row.style.transition = 'none';
      });
      h.addEventListener('keydown', function (e) {
        var d = { ArrowUp: -1, ArrowDown: 1 }[e.key]; if (!d) return; e.preventDefault();
        if (place(row, mov().indexOf(row) + d)) { h.focus(); said(row); }
      });
    });
    document.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var row = drag.row, hh = row.offsetHeight, last = mov().length * hh, top = Math.max(0, Math.min(last - hh, drag.top + e.clientY - drag.y)), center = top + hh / 2;
      var idx = 0; mov().forEach(function (r) { if (r !== row && r.offsetTop + hh / 2 < center) idx++; });
      place(row, idx); row.style.transform = 'translateY(' + (top - row.offsetTop) + 'px)';
    });
    function drop() {
      if (!drag) return; var row = drag.row; drag = null; row.classList.remove('is-drag'); list.classList.remove('is-dragging');
      row.style.transition = 'transform var(--dur-base) var(--ease-out)'; row.style.transform = '';
      setTimeout(function () { row.style.transition = ''; }, 240); said(row);
    }
    document.addEventListener('pointerup', drop); document.addEventListener('pointercancel', drop);
    bReset.addEventListener('click', function () { orig.forEach(function (r) { list.append(r); }); number(); stat.textContent = '顺序已还原'; });
    bSave.addEventListener('click', function () { base = ids(); number(); stat.textContent = '顺序已保存'; Lz.toast('分类顺序已保存', 'success'); });
  })();

  /* 026 虚拟滚动：两千条只渲染窗口内的行，滚动时按位置换行 */
  (function () {
    var root = D('AP-ROWS-026'); if (!root) return;
    var sc = $('.rw-vl__sc', root), pad2 = $('[data-pad]', root), win = $('[data-win]', root), rd = $('[data-r]', root);
    var N = 2000, H = 72, BUF = 4, G = ['红玫瑰花束', '向日葵花束', '粉芍药花束', '白郁金香花束', '蓝绣球盆栽', '多肉组合盆', '龟背竹盆栽', '花礼盒'], PR = [199, 159, 239, 179, 129, 89, 159, 268], ST = ['建国路店', '徐汇滨江店', '浦东世纪店'];
    var fmt = function (n) { return n.toLocaleString('zh-CN'); };
    function status(i) { return i < 3 ? ['配送中', 'info'] : (i % 13 === 5 ? ['已关闭', ''] : ['已完成', 'success']); }
    pad2.style.height = N * H + 'px';
    var from = -1, to = -1, raf = 0;
    function row(i) {
      var s = status(i), g = i % G.length;
      return '<div class="row" role="listitem" aria-posinset="' + (i + 1) + '" aria-setsize="' + N + '" data-i="' + i + '"><div class="row__main"><p class="row__title one-line">' + G[g] + '</p><p class="row__meta one-line">订单 ' + fmt(N - i) + ' ' + ST[i % ST.length] + '</p></div><span class="row__trail"><span class="price"><small>¥</small>' + PR[g] + '</span><span class="tag"' + (s[1] ? ' data-tone="' + s[1] + '"' : '') + '>' + s[0] + '</span></span></div>';
    }
    function paint() {
      raf = 0; var top = sc.scrollTop, vh = sc.clientHeight;
      var a = Math.max(0, Math.floor(top / H) - BUF), b = Math.min(N - 1, Math.ceil((top + vh) / H) + BUF);
      if (a !== from || b !== to) { from = a; to = b; var h = ''; for (var i = a; i <= b; i++) h += row(i); win.innerHTML = h; win.style.transform = 'translateY(' + a * H + 'px)'; }
      rd.textContent = '第 ' + fmt(Math.floor(top / H) + 1) + ' 至 ' + fmt(Math.min(N, Math.ceil((top + vh) / H))) + ' 条 共 ' + fmt(N) + ' 条';
    }
    sc.addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    $('[data-top]', root).addEventListener('click', function () { sc.scrollTo({ top: 0 }); });
    $('[data-mid]', root).addEventListener('click', function () { sc.scrollTo({ top: 999 * H }); });
    paint();
  })();
})();
</script>
