<!-- cat: ROWS | 列表行 -->
<style>
/* 列表行：基于 .row 与 .list，行内状态与动作各有位置；所有类名带 rw- 前缀 */
.rw-ed__f .input:focus-visible { outline: none; }
.rw-ic { width: 24px; height: 24px; flex: none; }
.rw-av { width: 48px; height: 48px; flex: none; border-radius: 50%; background: var(--zone); object-fit: contain; padding: 8px; }
.rw-av--sq { border-radius: var(--r-md); }
.rw-3d { width: 44px; height: 44px; flex: none; object-fit: contain; }
.rw-wrap { position: relative; flex: none; }
.rw-wrap .badge { top: -4px; right: -8px; }
.rw-dot { position: absolute; top: -2px; right: -2px; width: 12px; height: 12px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 2px var(--surface); animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
.rw-gone { opacity: 0; transform: scale(.4); transition: opacity var(--dur-quick), transform var(--dur-quick); }
.rw-gold { background: var(--accent-tint); color: var(--accent); }
.rw-grow { flex: 1; min-width: 0; }
.rw-chev { margin-left: auto; }
.rw-val { color: var(--ink-3); font-size: var(--fs-sm); }

/* 订单行 */
.rw-ord { padding: var(--s-4); }
.rw-ord__h { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--s-3); }
.rw-ord__h b { font-size: var(--fs-md); font-weight: 600; }
.rw-ord__b { display: flex; align-items: center; gap: var(--s-2); }
.rw-ord__b img { width: 60px; height: 60px; border-radius: var(--r-md); object-fit: cover; background: var(--zone); }
.rw-ord__sum { margin-left: auto; display: grid; justify-items: end; gap: 2px; text-align: right; font-size: var(--fs-sm); color: var(--ink-3); }
.rw-ord__sum b { font-size: var(--fs-lg); color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
.rw-ord__sum b small { font-size: var(--fs-xs); font-weight: 600; margin-right: 1px; }
.rw-ord__f { display: flex; justify-content: flex-end; gap: var(--s-2); margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--line); }
.rw-ord__f .btn[hidden] { display: none; }

/* 消息行 */
.rw-msg { align-items: flex-start; }
.rw-msg .row__title { font-weight: 400; color: var(--ink-2); }
.rw-msg[data-unread] .row__title { font-weight: 600; color: var(--ink); }
.rw-msg .row__meta { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.rw-msg[data-unread] .row__meta { color: var(--ink-2); }
.rw-msg .row__trail { align-self: flex-start; padding-top: 2px; min-width: 40px; }
.rw-msg .badge { position: static; animation: none; }

/* 地址行 */
.rw-addr { align-items: flex-start; }
.rw-addr .fm-ring2 { margin-top: 3px; }
.rw-ring { display: grid; place-items: center; width: 22px; height: 22px; margin-top: 2px; border: 1.5px solid var(--line-strong); border-radius: 50%; background: var(--surface); flex: none; transition: border-color var(--dur-quick) var(--ease-out); }
.rw-ring::after { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--action); transform: scale(0); transition: transform var(--dur-base) var(--ease-spring); }
[aria-checked="true"] > .rw-ring { border-color: var(--action); }
[aria-checked="true"] > .rw-ring::after { transform: scale(1); }
.rw-addr__n { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-md); font-weight: 600; }
.rw-addr__n span { font-weight: 400; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.rw-addr .row__meta { margin-top: 4px; line-height: 1.5; }
.rw-addr[aria-checked="true"] { background: var(--action-tint); }

/* 联系人行 */
.rw-ct .row__main { display: grid; gap: 4px; }
.rw-ct__m { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); }
.rw-ct .ibtn { flex: none; background: var(--zone); border-radius: 50%; }

/* 带开关行 */
.rw-sw .row__main { padding-right: var(--s-2); }

/* 可展开行与价格明细 */
.rw-kv { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); padding: 3px 0; font-size: var(--fs-sm); color: var(--ink-2); }
.rw-kv b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
.rw-kv--em { margin-top: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); font-size: var(--fs-md); color: var(--ink); font-weight: 600; }
.rw-kv--em b { font-size: var(--fs-xl); color: var(--price); font-weight: 700; }
.rw-kv--em b small { font-size: var(--fs-sm); margin-right: 1px; }
.rw-kv .neg { color: var(--price); }
.rw-kv .free { color: var(--success); }
.rw-pr { padding: var(--s-4); }
.rw-pr .rw-kv { padding: 5px 0; font-size: var(--fs-md); }
.rw-pr__sw { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-2); padding: var(--s-3); border-radius: var(--r-md); background: var(--action-tint); font-size: var(--fs-sm); color: var(--action-press); font-weight: 600; }

/* 分组标题 */
.rw-gh { display: flex; align-items: center; gap: var(--s-2); width: 100%; min-height: 44px; padding: 0 var(--s-4); background: var(--zone); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); text-align: left; }
.rw-gh small { min-width: 20px; padding: 0 6px; border-radius: var(--r-full); background: var(--surface); font-size: var(--fs-xs); font-weight: 600; line-height: 20px; text-align: center; color: var(--ink-3); }
.rw-gh .chev { margin-left: auto; }
.rw-gh[aria-expanded="true"] .chev::after { transform: rotate(45deg); }
.rw-xl .expand:not([data-open="true"]) + .row::before { content: ""; position: absolute; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.rw-sub { padding: var(--s-3) var(--s-4); display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-md); }
.rw-sub + .rw-sub { border-top: 1px solid var(--line); }
.rw-sub span { font-size: var(--fs-sm); color: var(--ink-3); }

/* 索引列表 */
.rw-idx { position: relative; height: 312px; overflow: hidden; }
.rw-idx__sc { height: 100%; overflow-y: auto; scrollbar-width: none; scroll-behavior: smooth; }
.rw-idx__sc::-webkit-scrollbar { display: none; }
.rw-idx__h { position: sticky; top: 0; z-index: 1; padding: 6px var(--s-4); background: var(--zone); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
.rw-idx .row { min-height: 56px; padding-right: 40px; }
.rw-idx__pad { height: 200px; }
.rw-idx__rail { position: absolute; z-index: 2; top: 50%; right: 4px; transform: translateY(-50%); display: grid; gap: 2px; padding: 6px 2px; border-radius: var(--r-full); background: var(--zone); touch-action: none; }
.rw-idx__rail button { display: grid; place-items: center; width: 22px; height: 28px; border-radius: 50%; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
.rw-idx__rail button[aria-current="true"] { background: var(--action); color: var(--surface); }
.rw-idx__bub { position: absolute; z-index: 2; top: 50%; right: 44px; transform: translateY(-50%) scale(.8); display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--r-lg); background: var(--action); color: var(--surface); font-size: var(--fs-2xl); font-weight: 700; opacity: 0; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
.rw-idx__bub.is-on { opacity: 1; transform: translateY(-50%) scale(1); }

/* 缩略图行与标签行 */
.rw-th .row__lead { width: 64px; height: 64px; }
.rw-th .row { min-height: 88px; }
.rw-th .row__meta { margin-top: 4px; }
.rw-th .row__trail { align-self: center; gap: 4px; text-align: right; }
.rw-th .row__trail b { font-weight: 400; color: var(--ink-3); font-size: var(--fs-sm); }
.rw-tg .row__lead { width: 56px; height: 56px; }
.rw-tg__t { display: flex; gap: var(--s-1); margin-top: 6px; }
.rw-old { margin-left: 4px; font-size: var(--fs-xs); color: var(--ink-3); text-decoration: line-through; font-weight: 400; }

/* 任务进度行 */
.rw-task { align-items: center; }
.rw-task .progress { height: 6px; margin-top: 8px; }
.rw-task__n { font-size: var(--fs-sm); font-variant-numeric: tabular-nums; color: var(--ink-3); margin-left: var(--s-2); font-weight: 400; }
.rw-task .btn { min-width: 72px; }
.rw-task .btn[disabled] { opacity: 1; }

/* 排行行 */
.rw-rk { font-variant-numeric: tabular-nums; }
.rw-rk__n { display: grid; place-items: center; width: 28px; height: 28px; flex: none; border-radius: 9px; font-size: var(--fs-md); font-weight: 600; color: var(--ink-3); }
.rw-rk__n[data-t="1"] { background: var(--accent-tint); color: var(--accent); }
.rw-rk__n[data-t="2"] { background: var(--zone); color: var(--ink-2); }
.rw-rk__n[data-t="3"] { background: var(--warning-tint); color: var(--warning); }
.rw-rk .row__lead { width: 52px; height: 52px; }
.rw-rk .progress { height: 4px; margin-top: 8px; }
.rw-rk .btn { min-width: 56px; }
.rw-rk .btn[disabled] { opacity: 1; }

/* 带头像行 */
.rw-pe { position: relative; flex: none; }
.rw-pe i { position: absolute; right: 1px; bottom: 1px; width: 12px; height: 12px; border-radius: 50%; background: var(--ink-3); box-shadow: 0 0 0 2px var(--surface); }
.rw-pe i[data-s="on"] { background: var(--success); }
.rw-pe i[data-s="busy"] { background: var(--warning); }
.rw-st { font-size: var(--fs-sm); color: var(--ink-3); }
.rw-st[data-s="on"] { color: var(--success); }
.rw-st[data-s="busy"] { color: var(--warning); }

/* 原位改名 */
.rw-ed { min-height: 64px; }
.rw-ed__v { display: flex; align-items: center; gap: var(--s-2); margin: -5px 0; }
.rw-ed__v .row__title { max-width: 160px; }
.rw-ed__f { display: flex; align-items: center; gap: var(--s-2); margin-bottom: 2px; }
.rw-ed__f .input { min-height: 40px; padding: 0 var(--s-3); flex: 1; min-width: 0; border-radius: var(--r-sm); }
.rw-ed__f .btn { min-height: 40px; padding: 0 var(--s-3); font-size: var(--fs-sm); }
.rw-ed .ibtn { width: 36px; height: 36px; }
.rw-ed .ibtn img { width: 18px; height: 18px; }
.rw-ed [hidden] { display: none !important; }

/* 左滑操作行 */
.rw-sl { position: relative; overflow: hidden; touch-action: pan-y; background: var(--surface); transition: height var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
.rw-sl + .rw-sl::before { content: ""; position: absolute; z-index: 2; top: 0; left: var(--s-4); right: 0; border-top: 1px solid var(--line); }
.rw-sl__acts { position: absolute; top: 0; right: 0; bottom: 0; display: flex; }
.rw-sl__acts button { width: 72px; font-size: var(--fs-sm); font-weight: 600; color: var(--surface); }
.rw-sl__acts button[data-a="pin"] { background: var(--action); }
.rw-sl__acts button[data-a="del"] { background: var(--danger); }
.rw-sl__f { position: relative; z-index: 1; display: flex; align-items: center; gap: var(--s-3); min-height: 64px; padding: var(--s-2) var(--s-4); background: var(--surface); transition: transform var(--dur-base) var(--ease-out); will-change: transform; }
.rw-sl__f.is-drag { transition: none; }
.rw-sl__f .row__title { font-weight: 600; }
</style>

<article class="demo" data-cid="AP-ROWS-001" data-name="设置功能行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">设置功能行</span></div>
  <p class="demo__note">适合：设置页的功能入口，线性图标在左，当前值与箭头在右</p>
  <div class="demo__stage">
    <div class="card list" id="rw-set">
      <button class="row row--link" data-go="通用设置"><img class="rw-ic" src="../../kit/assets/line/settings.webp" alt=""><div class="row__main"><p class="row__title">通用设置</p></div><span class="row__trail"></span></button>
      <button class="row row--link" data-go="账号与安全"><img class="rw-ic" src="../../kit/assets/line/shield.webp" alt=""><div class="row__main"><p class="row__title">账号与安全</p></div><span class="row__trail"><span class="rw-val">已验证</span></span></button>
      <button class="row row--link" data-go="消息通知"><img class="rw-ic" src="../../kit/assets/line/message.webp" alt=""><div class="row__main"><p class="row__title">消息通知</p></div><span class="row__trail"><span class="rw-val">已开启</span></span></button>
      <button class="row row--link" data-clear><img class="rw-ic" src="../../kit/assets/line/archive.webp" alt=""><div class="row__main"><p class="row__title">清除缓存</p></div><span class="row__trail"><span class="rw-val" data-size>12.4 兆</span></span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-002" data-name="订单卡片行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">订单卡片行</span></div>
  <p class="demo__note">适合：订单列表，状态在右上，操作在底部，随状态流转</p>
  <div class="demo__stage">
    <section class="card rw-ord" id="rw-ord">
      <div class="rw-ord__h"><b>建国路店</b><span class="tag" data-tone="warning" data-st>待付款</span></div>
      <div class="rw-ord__b">
        <img src="../../kit/assets/photo/product-rose-red.webp" alt=""><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><img src="../../kit/assets/photo/product-succulent.webp" alt="">
        <div class="rw-ord__sum"><span>共 3 件</span><b><small>¥</small>447</b></div>
      </div>
      <div class="rw-ord__f"><button class="btn btn--ghost btn--sm" data-a="cancel">取消订单</button><button class="btn btn--primary btn--sm" data-a="pay">去支付</button><button class="btn btn--secondary btn--sm" data-a="urge" hidden>提醒发货</button><button class="btn btn--secondary btn--sm" data-a="again" hidden>再次购买</button></div>
    </section>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-003" data-name="会话消息行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">会话消息行</span></div>
  <p class="demo__note">适合：会话列表，未读加粗并带数字，点开后转为已读</p>
  <div class="demo__stage">
    <div class="card list" id="rw-msg">
      <button class="row rw-msg" data-unread><img class="rw-av" src="../../kit/assets/marks/mark-001.webp" alt=""><div class="row__main"><p class="row__title one-line">林晓</p><p class="row__meta">花束收到了 非常漂亮</p></div><span class="row__trail"><span>刚刚</span><span class="badge" data-b>2</span></span></button>
      <button class="row rw-msg" data-unread><img class="rw-av" src="../../kit/assets/marks/mark-002.webp" alt=""><div class="row__main"><p class="row__title one-line">陈琳</p><p class="row__meta">明天的花艺课程已经安排好</p></div><span class="row__trail"><span>5 分钟前</span><span class="rw-dot" data-b style="position: static; box-shadow: none"></span></span></button>
      <button class="row rw-msg"><img class="rw-av" src="../../kit/assets/marks/mark-003.webp" alt=""><div class="row__main"><p class="row__title one-line">周明</p><p class="row__meta">已到达楼下 请取花</p></div><span class="row__trail"><span>昨天</span></span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-004" data-name="收货地址行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">收货地址行</span></div>
  <p class="demo__note">适合：选择收货地址，整行单选，右侧进入编辑页</p>
  <div class="demo__stage">
    <div class="card list" id="rw-addr" role="radiogroup" aria-label="收货地址">
      <div class="row rw-addr" role="radio" aria-checked="true" tabindex="0"><span class="rw-ring"></span><div class="row__main"><p class="rw-addr__n">林晓<span>138 0013 8000</span><span class="tag" data-tone="action">默认</span></p><p class="row__meta">黄浦区建国路 88 号 1502</p></div><button class="ibtn" aria-label="编辑地址" data-tip="编辑"><img src="../../kit/assets/line/edit.webp" alt=""></button></div>
      <div class="row rw-addr" role="radio" aria-checked="false" tabindex="-1"><span class="rw-ring"></span><div class="row__main"><p class="rw-addr__n">林晓<span>138 0013 8000</span><span class="tag">公司</span></p><p class="row__meta">徐汇区滨江大道 1200 号</p></div><button class="ibtn" aria-label="编辑地址" data-tip="编辑"><img src="../../kit/assets/line/edit.webp" alt=""></button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-005" data-name="联系人行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">联系人行</span></div>
  <p class="demo__note">适合：客户与会员名单，图像标识加身份标签，右侧发起沟通</p>
  <div class="demo__stage">
    <div class="card list">
      <div class="row rw-ct"><img class="rw-av" src="../../kit/assets/marks/mark-001.webp" alt=""><div class="row__main"><p class="row__title">林晓</p><div class="rw-ct__m"><span class="tag rw-gold">金卡会员</span><span>建国路店</span></div></div><button class="ibtn" aria-label="发消息" data-tip="发消息" data-say="林晓"><img src="../../kit/assets/line/message.webp" alt=""></button></div>
      <div class="row rw-ct"><img class="rw-av" src="../../kit/assets/marks/mark-004.webp" alt=""><div class="row__main"><p class="row__title">吴悦</p><div class="rw-ct__m"><span class="tag">普通会员</span><span>浦东世纪店</span></div></div><button class="ibtn" aria-label="发消息" data-tip="发消息" data-say="吴悦"><img src="../../kit/assets/line/message.webp" alt=""></button></div>
      <div class="row rw-ct"><img class="rw-av" src="../../kit/assets/marks/mark-005.webp" alt=""><div class="row__main"><p class="row__title">郑雅</p><div class="rw-ct__m"><span class="tag rw-gold">金卡会员</span><span>徐汇滨江店</span></div></div><button class="ibtn" aria-label="发消息" data-tip="发消息" data-say="郑雅"><img src="../../kit/assets/line/message.webp" alt=""></button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-006" data-name="带开关行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">带开关行</span></div>
  <p class="demo__note">适合：通知偏好等即时生效的选项，说明随开关变化</p>
  <div class="demo__stage">
    <div class="card list" id="rw-sw">
      <div class="row rw-sw"><div class="row__main"><p class="row__title">订单提醒</p><p class="row__meta" data-m>下单与配送进度已开启</p></div><button class="switch" role="switch" aria-checked="true" aria-label="订单提醒" data-on="下单与配送进度已开启" data-off="已关闭"></button></div>
      <div class="row rw-sw"><div class="row__main"><p class="row__title">活动通知</p><p class="row__meta" data-m>已关闭</p></div><button class="switch" role="switch" aria-checked="false" aria-label="活动通知" data-on="优惠与新品已开启" data-off="已关闭"></button></div>
      <div class="row rw-sw"><div class="row__main"><p class="row__title">周期订花提醒</p><p class="row__meta" data-m>每期送达前一天提醒</p></div><button class="switch" role="switch" aria-checked="true" aria-label="周期订花提醒" data-on="每期送达前一天提醒" data-off="已关闭"></button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-007" data-name="带箭头行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">带箭头行</span></div>
  <p class="demo__note">适合：进入下级页面，左侧名称、右侧当前值与箭头</p>
  <div class="demo__stage">
    <div class="card list">
      <button class="row row--link" data-go="收货地址"><div class="row__main"><p class="row__title">收货地址</p></div><span class="row__trail"><span class="rw-val">上海 徐汇</span></span></button>
      <button class="row row--link" data-go="发票抬头"><div class="row__main"><p class="row__title">发票抬头</p></div><span class="row__trail"><span class="rw-val">未设置</span></span></button>
      <button class="row row--link" data-go="配送时间"><div class="row__main"><p class="row__title">配送时间</p></div><span class="row__trail"><span class="rw-val">尽快送达</span></span></button>
      <button class="row row--link" data-go="优惠券"><div class="row__main"><p class="row__title">优惠券</p></div><span class="row__trail"><span class="tag" data-tone="price">3 张可用</span></span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-008" data-name="带角标行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">带角标行</span></div>
  <p class="demo__note">适合：通知中心分类，角标挂在图标上，进入后清除</p>
  <div class="demo__stage">
    <div class="card list" id="rw-bd">
      <button class="row row--link" data-go="订单通知" data-read><span class="rw-wrap"><img class="rw-3d" data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""><span class="badge" data-b>3</span></span><div class="row__main"><p class="row__title">订单通知</p><p class="row__meta">骑手已取货</p></div><span class="row__trail"><span class="rw-val">刚刚</span></span></button>
      <button class="row row--link" data-go="活动消息" data-read><span class="rw-wrap"><img class="rw-3d" data-ic="coupon" src="../../kit/assets/icons/flat/coupon.webp" alt=""><i class="rw-dot" data-b></i></span><div class="row__main"><p class="row__title">活动消息</p><p class="row__meta">新人礼券即将到期</p></div><span class="row__trail"><span class="rw-val">昨天</span></span></button>
      <button class="row row--link" data-go="会员通知" data-read><span class="rw-wrap"><img class="rw-3d" data-ic="giftcard" src="../../kit/assets/icons/flat/giftcard.webp" alt=""></span><div class="row__main"><p class="row__title">会员通知</p><p class="row__meta">积分已到账</p></div><span class="row__trail"><span class="rw-val">周一</span></span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-ROWS-009" data-name="带标签行" data-cat="ROWS">
