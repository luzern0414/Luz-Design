<article class="demo" data-cid="AP-ROWS-019" data-name="左滑操作行" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">左滑操作行</span></div>
  <p class="demo__note">适合：消息与收藏的快捷操作，左滑露出置顶与删除</p>
  <div class="demo__stage">
    <div class="card list" id="rw-sl">
      <div class="rw-sl"><div class="rw-sl__acts"><button data-a="pin">置顶</button><button data-a="del">删除</button></div><div class="rw-sl__f" tabindex="0"><img class="rw-av" src="../../kit/assets/marks/mark-001.webp" alt=""><div class="row__main"><p class="row__title one-line">林晓</p><p class="row__meta">花束收到了 非常漂亮</p></div><span class="row__trail">刚刚</span></div></div>
      <div class="rw-sl"><div class="rw-sl__acts"><button data-a="pin">置顶</button><button data-a="del">删除</button></div><div class="rw-sl__f" tabindex="0"><img class="rw-av" src="../../kit/assets/marks/mark-002.webp" alt=""><div class="row__main"><p class="row__title one-line">陈琳</p><p class="row__meta">明天的花艺课程已经安排好</p></div><span class="row__trail">5 分钟前</span></div></div>
      <div class="rw-sl"><div class="rw-sl__acts"><button data-a="pin">置顶</button><button data-a="del">删除</button></div><div class="rw-sl__f" tabindex="0"><img class="rw-av" src="../../kit/assets/marks/mark-003.webp" alt=""><div class="row__main"><p class="row__title one-line">周明</p><p class="row__meta">已到达楼下 请取花</p></div><span class="row__trail">昨天</span></div></div>
    </div>
  </div>
</article>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };

  // 通用入口提示
  $$('[data-cid^="AP-ROWS-"] [data-go]').forEach(function (el) { el.addEventListener('click', function () { Lz.toast('已打开' + el.dataset.go); }); });

  // 001 清除缓存
  (function () {
    var b = $('#rw-set [data-clear]'); if (!b) return;
    b.addEventListener('click', function () {
      var v = $('[data-size]', b); if (v.textContent === '0 兆') { Lz.toast('缓存已为空'); return; }
      Lz.confirm({ title: '清除缓存', body: '将释放 ' + v.textContent, ok: '清除' }).then(function (y) { if (y) { v.textContent = '0 兆'; Lz.toast('已清除缓存', 'success'); } });
    });
  })();

  // 002 订单状态流转
  (function () {
    var host = $('#rw-ord'); if (!host) return;
    var st = $('[data-st]', host), a = function (k) { return $('[data-a="' + k + '"]', host); };
    function state(s) {
      st.textContent = { pay: '待付款', ship: '待发货', closed: '已关闭' }[s]; st.dataset.tone = { pay: 'warning', ship: 'info', closed: '' }[s];
      a('cancel').hidden = a('pay').hidden = s !== 'pay'; a('urge').hidden = s !== 'ship'; a('again').hidden = s !== 'closed';
    }
    a('pay').addEventListener('click', function () { var b = a('pay'); b.classList.add('is-loading'); setTimeout(function () { b.classList.remove('is-loading'); state('ship'); Lz.toast('支付成功', 'success'); }, 800); });
    a('cancel').addEventListener('click', function () { Lz.confirm({ title: '取消订单', body: '取消后商品将释放库存', ok: '取消订单', tone: 'danger', cancel: '再想想' }).then(function (y) { if (y) { state('closed'); Lz.toast('订单已关闭'); } }); });
    a('urge').addEventListener('click', function () { Lz.toast('已提醒商家发货', 'success'); });
    a('again').addEventListener('click', function () { state('pay'); Lz.toast('已重新下单'); });
    state('pay');
  })();

  // 003 消息已读
  $$('#rw-msg .row').forEach(function (r) {
    r.addEventListener('click', function () { r.removeAttribute('data-unread'); var b = $('[data-b]', r); if (b) { b.classList.add('rw-gone'); setTimeout(function () { b.remove(); }, 160); } });
  });

  // 004 地址单选
  (function () {
    var host = $('#rw-addr'); if (!host) return;
    var rows = $$('.row', host);
    function set(i) { rows.forEach(function (r, j) { r.setAttribute('aria-checked', String(j === i)); r.tabIndex = j === i ? 0 : -1; }); }
    rows.forEach(function (r, i) {
      r.addEventListener('click', function (e) { if (e.target.closest('.ibtn')) { Lz.toast('已打开编辑页'); return; } set(i); });
      r.addEventListener('keydown', function (e) { if (e.target !== r) return; var d = { ArrowDown: 1, ArrowUp: -1 }[e.key]; if (e.key === ' ' || e.key === 'Enter') { set(i); e.preventDefault(); } if (!d) return; var n = (i + d + rows.length) % rows.length; set(n); rows[n].focus(); e.preventDefault(); });
    });
  })();

  // 005 联系人
  $$('[data-say]').forEach(function (b) { b.addEventListener('click', function () { Lz.toast('已打开与' + b.dataset.say + '的会话'); }); });

  // 006 开关说明
  $$('#rw-sw .switch').forEach(function (sw) {
    var m = $('[data-m]', sw.closest('.row'));
    sw.addEventListener('lz:toggle', function () { m.textContent = sw.getAttribute('aria-checked') === 'true' ? sw.dataset.on : sw.dataset.off; });
  });

  // 008 角标清除
  $$('#rw-bd [data-read]').forEach(function (r) {
    r.addEventListener('click', function () { var b = $('[data-b]', r); if (b) { b.classList.add('rw-gone'); setTimeout(function () { b.remove(); }, 160); } });
  });

  // 012 索引列表
  (function () {
    var host = $('#rw-idx'); if (!host) return;
    var sc = $('.rw-idx__sc', host), secs = $$('section', sc), btns = $$('.rw-idx__rail button', host), bub = $('.rw-idx__bub', host), lock = 0, tm;
    function mark(i) { btns.forEach(function (b, j) { if (j === i) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); }); }
    function go(i, smooth) { lock = Date.now() + 500; mark(i); sc.style.scrollBehavior = smooth ? 'smooth' : 'auto'; sc.scrollTo({ top: secs[i].offsetTop }); bub.textContent = btns[i].dataset.k; bub.classList.add('is-on'); clearTimeout(tm); tm = setTimeout(function () { bub.classList.remove('is-on'); }, 700); }
    btns.forEach(function (b, i) { b.addEventListener('click', function () { go(i, true); }); });
    var rail = $('.rw-idx__rail', host), drag = false;
    function at(e) { var y = e.clientY, hit = btns.findIndex(function (b) { var r = b.getBoundingClientRect(); return y >= r.top && y <= r.bottom; }); if (hit >= 0) go(hit, false); }
    rail.addEventListener('pointerdown', function (e) { drag = true; rail.setPointerCapture(e.pointerId); at(e); });
    rail.addEventListener('pointermove', function (e) { if (drag) at(e); });
    ['pointerup', 'pointercancel'].forEach(function (ev) { rail.addEventListener(ev, function () { drag = false; }); });
    sc.addEventListener('scroll', function () { if (Date.now() < lock) return; var cur = 0; secs.forEach(function (s, i) { if (s.offsetTop - 4 <= sc.scrollTop) cur = i; }); mark(cur); }, { passive: true });
  })();

  // 014 积分抵现
  (function () {
    var host = $('#rw-pr'); if (!host) return;
    var sw = $('.switch', host), pt = $('[data-pt]', host), tot = $('[data-total]', host);
    sw.addEventListener('lz:toggle', function () { var on = sw.getAttribute('aria-checked') === 'true'; pt.hidden = !on; tot.innerHTML = '<small>¥</small>' + (on ? 368 : 378); });
  })();

  // 015 任务领取
  (function () {
    var b = $('#rw-task [data-claim]'); if (!b) return;
    b.addEventListener('click', function () { b.textContent = '已领取'; b.disabled = true; b.className = 'btn btn--secondary btn--sm'; Lz.toast('已领取 20 积分', 'success'); });
  })();

  // 016 加购
  $$('[data-cart]').forEach(function (b) { b.addEventListener('click', function () { b.textContent = '已加购'; b.disabled = true; Lz.toast('已加入购物车', 'success'); }); });

  // 018 原位改名
  $$('#rw-ed .rw-ed').forEach(function (row) {
    var v = $('.rw-ed__v', row), f = $('.rw-ed__f', row), t = $('[data-t]', row), inp = $('input', f), edit = $('[data-e]', row);
    function open() { inp.value = t.textContent; v.hidden = true; f.hidden = false; inp.focus(); inp.select(); }
    function close(keep) { f.hidden = true; v.hidden = false; if (keep) edit.focus(); }
    function save() { var n = inp.value.trim(); if (!n) { inp.setAttribute('aria-invalid', 'true'); inp.classList.remove('shake'); void inp.offsetWidth; inp.classList.add('shake'); return; } inp.removeAttribute('aria-invalid'); t.textContent = n; close(true); Lz.toast('备注名已更新', 'success'); }
    edit.addEventListener('click', open);
    $('[data-save]', f).addEventListener('click', save);
    $('[data-cancel]', f).addEventListener('click', function () { inp.removeAttribute('aria-invalid'); close(true); });
    inp.addEventListener('keydown', function (e) { if (e.isComposing) return; if (e.key === 'Enter') { e.preventDefault(); save(); } if (e.key === 'Escape') { close(true); } });
  });

  // 019 左滑操作
  (function () {
    var host = $('#rw-sl'); if (!host) return;
    var W = 144, open = null;
    function setX(f, x, anim) { f.classList.toggle('is-drag', !anim); f.style.transform = 'translateX(' + x + 'px)'; f._x = x; }
    function close(f) { if (f) setX(f, 0, true); if (open === f) open = null; }
    $$('.rw-sl', host).forEach(function (row) {
      var f = $('.rw-sl__f', row), x0 = 0, sx = 0, sy = 0, down = false, moved = false, lockDir = '';
      f._x = 0;
      f.addEventListener('pointerdown', function (e) { down = true; moved = false; lockDir = ''; sx = e.clientX; sy = e.clientY; x0 = f._x; if (open && open !== f) close(open); });
      f.addEventListener('pointermove', function (e) {
        if (!down) return; var dx = e.clientX - sx, dy = e.clientY - sy;
        if (!lockDir && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) lockDir = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if (lockDir !== 'x') return; moved = true; if (!f.hasPointerCapture(e.pointerId)) f.setPointerCapture(e.pointerId);
        setX(f, clamp(x0 + dx, -W - 24, 0), false);
      });
      function end() { if (!down) return; down = false; if (!moved) return; var o = f._x < -W / 2; setX(f, o ? -W : 0, true); open = o ? f : (open === f ? null : open); }
      f.addEventListener('pointerup', end); f.addEventListener('pointercancel', end);
      f.addEventListener('click', function (e) { if (moved) { e.preventDefault(); moved = false; return; } if (f._x < 0) close(f); });
      f.addEventListener('keydown', function (e) { if (e.key === 'ArrowLeft') { if (open && open !== f) close(open); setX(f, -W, true); open = f; e.preventDefault(); } if (e.key === 'ArrowRight' || e.key === 'Escape') { close(f); e.preventDefault(); } });
      $('[data-a="pin"]', row).addEventListener('click', function () { close(f); host.insertBefore(row, host.firstChild); Lz.toast('已置顶'); });
      $('[data-a="del"]', row).addEventListener('click', function () {
        Lz.confirm({ title: '删除会话', body: '删除后无法恢复', ok: '删除', tone: 'danger' }).then(function (y) {
          if (!y) { close(f); return; } var h = row.offsetHeight; row.style.height = h + 'px'; void row.offsetWidth; row.style.height = '0px'; row.style.opacity = '0';
          setTimeout(function () { row.remove(); Lz.toast('已删除'); }, 240);
        });
      });
    });
  })();
})();
</script>

<article class="demo" data-cid="AP-ROWS-020" data-name="文本展开收起" data-cat="ROWS">
  <div class="demo__head"><span class="demo__name">文本展开收起</span></div>
  <p class="demo__note">适合：评价与商品描述超过行数时省略，可展开全文</p>
  <div class="demo__stage">
    <div class="card list rw-te">
      <div class="rw-te__it">
        <div class="rw-te__h"><img class="rw-av" src="../../kit/assets/marks/mark-001.webp" alt=""><div class="row__main"><p class="row__title">林晓</p><p class="row__meta">金卡会员 已购红玫瑰花束</p></div></div>
        <p class="rw-te__t" id="rw-te-a" data-lines="3">花束收到的时候还带着水珠，玫瑰开得很饱满，外层是牛皮纸，里面附了一张保鲜说明。配送的小哥提前电话确认了时间，准时送到公司前台，同事们都说好看。放在办公桌上一周了，花瓣依然挺括，下次朋友过生日还会再来买。</p>
        <button class="btn btn--text btn--sm rw-te__b" aria-controls="rw-te-a" aria-expanded="false" hidden>展开全文</button>
      </div>
      <div class="rw-te__it">
        <div class="rw-te__h"><img class="rw-av" src="../../kit/assets/marks/mark-004.webp" alt=""><div class="row__main"><p class="row__title">吴悦</p><p class="row__meta">普通会员 已购多肉组合盆</p></div></div>
        <p class="rw-te__t" id="rw-te-b" data-lines="3">多肉很精神，包装也很用心。</p>
        <button class="btn btn--text btn--sm rw-te__b" aria-controls="rw-te-b" aria-expanded="false" hidden>展开全文</button>
      </div>
      <div class="rw-te__it">
        <div class="rw-te__h"><img class="rw-av rw-av--sq" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="row__main"><p class="row__title">粉芍药花束</p><p class="row__meta">商品描述</p></div></div>
        <p class="rw-te__t" id="rw-te-c" data-lines="2">精选当季粉芍药，花苞饱满，到手后斜剪根部并浸水，三到五天完全绽放。搭配尤加利叶与满天星，外层使用雾粉色包装纸，适合生日与纪念日赠送。</p>
        <button class="btn btn--text btn--sm rw-te__b" aria-controls="rw-te-c" aria-expanded="false" hidden>展开全文</button>
      </div>
    </div>
  </div>
</article>

