        <div class="row rw-dr__r" data-id="plant"><button class="rw-dr__h" aria-label="拖动排序 绿植">拖动</button><div class="row__main"><p class="row__title one-line">绿植</p><p class="row__meta">在售 18 件</p></div><span class="rw-dr__n">2</span></div>
        <div class="row rw-dr__r" data-id="gift"><button class="rw-dr__h" aria-label="拖动排序 礼盒">拖动</button><div class="row__main"><p class="row__title one-line">礼盒</p><p class="row__meta">在售 9 件</p></div><span class="rw-dr__n">3</span></div>
        <div class="row rw-dr__r" data-id="vase"><button class="rw-dr__h" aria-label="拖动排序 花器">拖动</button><div class="row__main"><p class="row__title one-line">花器</p><p class="row__meta">在售 15 件</p></div><span class="rw-dr__n">4</span></div>
        <div class="row rw-dr__r" data-id="seed" data-lock><button class="rw-dr__h" disabled aria-label="种苗固定在末位">固定</button><div class="row__main"><p class="row__title one-line">种苗</p><p class="row__meta">在售 12 件</p></div><span class="rw-dr__n">5</span></div>
      </div>
      <div class="rw-dr__f"><span class="rw-dr__s" role="status" data-s>顺序未调整</span><div class="btn-group"><button class="btn btn--ghost btn--sm" data-reset disabled>还原</button><button class="btn btn--primary btn--sm" data-save disabled>保存</button></div></div>
    </div>
