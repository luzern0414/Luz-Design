          <div class="row"><div class="row__main"><p class="row__title">洋桔梗</p><p class="row__meta">花期 4 至 6 月</p></div></div>
        </section>
        <section data-k="夏"><div class="rw-idx__h">夏</div>
          <div class="row"><div class="row__main"><p class="row__title">向日葵</p><p class="row__meta">花期 6 至 8 月</p></div></div>
          <div class="row"><div class="row__main"><p class="row__title">绣球</p><p class="row__meta">花期 6 至 7 月</p></div></div>
          <div class="row"><div class="row__main"><p class="row__title">百合</p><p class="row__meta">花期 6 至 8 月</p></div></div>
        </section>
        <section data-k="秋"><div class="rw-idx__h">秋</div>
          <div class="row"><div class="row__main"><p class="row__title">菊花</p><p class="row__meta">花期 9 至 11 月</p></div></div>
          <div class="row"><div class="row__main"><p class="row__title">桂花</p><p class="row__meta">花期 9 至 10 月</p></div></div>
        </section>
        <section data-k="冬"><div class="rw-idx__h">冬</div>
          <div class="row"><div class="row__main"><p class="row__title">腊梅</p><p class="row__meta">花期 12 至 2 月</p></div></div>
          <div class="row"><div class="row__main"><p class="row__title">水仙</p><p class="row__meta">花期 1 至 2 月</p></div></div>
        </section>
        <div class="rw-idx__pad"></div>
      </div>
      <div class="rw-idx__rail" role="tablist" aria-label="花期索引"><button aria-current="true" data-k="春" aria-label="春">春</button><button data-k="夏" aria-label="夏">夏</button><button data-k="秋" aria-label="秋">秋</button><button data-k="冬" aria-label="冬">冬</button></div>
      <div class="rw-idx__bub" aria-hidden="true">春</div>
    </div>
  </div>
</article>

