  <p class="demo__note">适合：同一指标两个周期的并排比较</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><span class="dat-title">周期对比</span><span class="tag" data-tone="success" data-delta>增长 8%</span></div>
      <div class="seg" data-seg="dat-cmp" aria-label="指标">
        <button class="seg__item" data-key="orders" aria-selected="true">订单量</button>
        <button class="seg__item" data-key="sales" aria-selected="false">销售额</button>
        <button class="seg__item" data-key="avg" aria-selected="false">客单价</button>
      </div>
      <div class="dat-cmp">
        <div class="dat-cmp__row"><span>本周</span><div class="dat-cmp__track"><i data-bar="now" style="--v:0%"></i></div><b data-vnow>1,286</b></div>
        <div class="dat-cmp__row" data-prev><span>上周</span><div class="dat-cmp__track"><i data-bar="prev" style="--v:0%"></i></div><b data-vprev>1,190</b></div>
      </div>
      <p class="dat-read" role="status"></p>
    </div>
  </div>
</article>

