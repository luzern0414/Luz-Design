  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-sched">
        <div class="dat-mini" style="--dat-p:60%" role="img" aria-label="完成度 60%"><span data-pct>60%</span></div>
        <div><p class="dat-title">营业前准备</p><p class="dat-unit" role="status">已完成 <span data-n>3</span> 项 共 5 项</p></div>
      </div>
      <div class="dat-sched__list" role="group" aria-label="营业前清单">
        <div class="row" role="checkbox" aria-checked="true"><span class="check" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><div class="row__main"><p class="row__title one-line">擦拭花桶</p></div></div>
        <div class="row" role="checkbox" aria-checked="true"><span class="check" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><div class="row__main"><p class="row__title one-line">补充鲜花</p></div></div>
        <div class="row" role="checkbox" aria-checked="true"><span class="check" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><div class="row__main"><p class="row__title one-line">核对库存</p></div></div>
        <div class="row" role="checkbox" aria-checked="false"><span class="check" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><div class="row__main"><p class="row__title one-line">摆放价签</p></div></div>
        <div class="row" role="checkbox" aria-checked="false"><span class="check" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><div class="row__main"><p class="row__title one-line">开启收银</p></div></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-016" data-name="库存水位条" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">库存水位条</span></div>
  <p class="demo__note">适合：库存与安全线的对照，低于安全线转红</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><span class="dat-title">红玫瑰花束</span><span class="tag" data-tone="danger" data-tag>低于安全线</span></div>
      <div class="dat-num"><b data-n>18</b><span>件 满仓 60 件</span></div>
      <div class="dat-stock" style="--m:50%;--v:30%" role="progressbar" aria-label="库存水位" aria-valuemin="0" aria-valuemax="60" aria-valuenow="18"><i></i><span class="dat-stock__line"><span>安全线 30</span></span></div>
      <div class="dat-row"><span class="dat-read" role="status" data-read>还差 12 件到安全线</span><div class="btn-group"><button class="btn btn--secondary btn--sm" data-in>补货 12 件</button><button class="btn btn--ghost btn--sm" data-out>出库 6 件</button></div></div>
    </div>
  </div>
</article>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const nf = n => Math.round(n).toLocaleString('zh-CN');
  const nf2 = n => n.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const onTheme = fn => new MutationObserver(fn).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  const seg = (root, fn) => root.addEventListener('lz:seg', e => fn(e.detail.key));
  /* 从旧值滚到新值；系统要求减少动态时直接给终值 */
  const tween = (el, from, to, fmt = nf, ms = 600) => {
    if (Lz.reduce) { el.textContent = fmt(to); return; }
    const t0 = performance.now();
    const step = t => { const p = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - p, 3); el.textContent = fmt(from + (to - from) * e); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  };

  /* 001 三栏指标：选中的指标重新计数 */
  (() => {
    const stats = $$('.stat', D('AP-DATA-001'));
    stats.forEach(s => s.addEventListener('click', () => { stats.forEach(x => x.setAttribute('aria-pressed', String(x === s))); Lz.count($('[data-to]', s)); }));
  })();

  /* 002 折线图：缺口断开，点选与方向键读数；换指标时重建画布，换主题时重绘 */
  (() => {
    const root = D('AP-DATA-002'), L = ['一', '二', '三', '四', '五', '六', '日'], RL = L.map(x => '周' + x);
    const S = { orders: { name: '订单量', u: '单', v: [128, 142, 135, null, 181, 176, 204] }, sales: { name: '销售额', u: '元', v: [3580, 3920, 3760, null, 5240, 5030, 5860] } };
    let key = 'orders', canvas = $('canvas', root);
    const mount = () => {
      const s = S[key], n = canvas.cloneNode(false); canvas.replaceWith(n); canvas = n; canvas.setAttribute('aria-label', `近七天${s.name}折线图`);
      $('[data-unit]', root).textContent = `${s.name} 单位 ${s.u}`;
      $('[data-dom]', root).innerHTML = s.v.map((v, i) => `<li>${RL[i]} ${v == null ? '暂无数据' : nf(v) + ' ' + s.u}</li>`).join('');
      Lz.line(canvas, { labels: L, readLabels: RL, values: s.v, unit: ' ' + s.u, read: $('.dat-read', root) });
    };
    seg(root, k => { key = k; mount(); });
    onTheme(mount); mount();
  })();

  /* 003 条形图：悬浮与点选都在同区显示明细 */
  (() => {
    const root = D('AP-DATA-003'), cols = $$('.bars__col', root), read = $('.dat-read', root), total = cols.reduce((a, c) => a + +c.dataset.v, 0);
    const pick = c => { cols.forEach(x => x.removeAttribute('aria-current')); c.setAttribute('aria-current', 'true'); read.innerHTML = `<b>${c.dataset.name}</b> 销量 ${c.dataset.v} 件 占 ${Math.round(c.dataset.v / total * 100)}%`; };
    cols.forEach(c => { c.addEventListener('click', () => pick(c)); c.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') pick(c); }); c.addEventListener('focus', () => pick(c)); });
    pick(cols[0]);
  })();

  /* 004 环形占比：点图例，其余扇区变浅，中心显示该项 */
  (() => {
    const root = D('AP-DATA-004'), donut = $('.dat-donut', root), bs = $$('.dat-legend button', root);
    bs.forEach(b => b.addEventListener('click', () => {
      bs.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      donut.dataset.sel = b.dataset.k; $('[data-val]', root).textContent = b.dataset.v; $('[data-lab]', root).textContent = b.dataset.l;
    }));
  })();

  /* 005 线性进度 */
  (() => {
    const root = D('AP-DATA-005'), n = $('[data-n]', root), bar = $('.progress', root), tag = $('[data-tag]', root), read = $('[data-read]', root), add = $('[data-add]', root), MAX = 48, START = 36;
    let v = START;
    const paint = () => {
      const p = Math.round(v / MAX * 100); n.textContent = v; bar.firstElementChild.style.setProperty('--v', p + '%'); bar.setAttribute('aria-valuenow', v);
      read.textContent = `已备 ${p}%`; const done = v >= MAX; tag.textContent = done ? '已备齐' : '进行中'; tag.dataset.tone = done ? 'success' : 'action'; add.disabled = done;
    };
    add.addEventListener('click', () => { v = Math.min(MAX, v + 1); paint(); });
    $('[data-reset]', root).addEventListener('click', () => { v = START; paint(); });
  })();

  /* 006 圆环进度：切换门店，百分比平滑过渡 */
  (() => {
    const root = D('AP-DATA-006'), ring = $('.dat-ring', root), data = [[38, 50], [29, 40], [45, 45]];
    seg(root, k => {
      const [d, t] = data[+k], p = Math.round(d / t * 100);
      ring.style.setProperty('--dat-p', p + '%'); ring.toggleAttribute('data-full', p >= 100); ring.setAttribute('aria-label', `配送完成率 ${p}%`);
      $('[data-val]', root).textContent = p + '%'; $('[data-sub]', root).textContent = `已送达 ${d} 单 共 ${t} 单`;
    });
  })();

  /* 007 目标进度：进度条封顶，数字与百分比保持真实值 */
  (() => {
    const root = D('AP-DATA-007'), GOAL = 90000, START = 68400, done = $('[data-done]', root), pct = $('[data-pct]', root), bar = $('.dat-goal', root), read = $('[data-read]', root);
    let v = START;
    const paint = (from, to) => {
      tween(done, from, to); const p = Math.round(to / GOAL * 100), over = to >= GOAL;
      pct.textContent = (over ? '已超额 ' : '达成 ') + p + '%'; pct.dataset.tone = over ? 'success' : 'action';
      bar.firstElementChild.style.setProperty('--v', Math.min(100, p) + '%'); bar.toggleAttribute('data-over', over); bar.setAttribute('aria-valuenow', Math.min(100, p));
      read.textContent = over ? `超出目标 ${nf(to - GOAL)} 元` : `距目标还差 ${nf(GOAL - to)} 元`;
    };
    $('[data-add]', root).addEventListener('click', () => { const nv = v + 8000; paint(v, nv); v = nv; if (v >= GOAL && v - 8000 < GOAL) Lz.toast('目标已达成', 'success'); });
    $('[data-reset]', root).addEventListener('click', () => { paint(v, START); v = START; });
  })();

  /* 008 热度格：null 表示暂无数据，不画成零 */
  (() => {
    const root = D('AP-DATA-008'), grid = $('[data-grid]', root), read = $('.dat-read', root);
    const days = ['一', '二', '三', '四', '五', '六', '日'], bands = ['上午', '下午', '晚上'];
    const V = [[12, 14, 11, 15, 22, 38, 41], [18, 21, 19, 24, 31, 52, 57], [9, 13, 10, null, 27, 44, 36]], MAX = 57;
    let html = '<span></span>' + days.map(d => `<span class="dat-heat__h">${d}</span>`).join('');
    bands.forEach((b, r) => { html += `<span class="dat-heat__r">${b}</span>`; V[r].forEach((v, c) => { html += v == null ? `<button class="dat-cell" data-none data-r="${r}" data-c="${c}" aria-pressed="false" aria-label="周${days[c]} ${b} 暂无数据"></button>` : `<button class="dat-cell" style="--l:${Math.max(1, Math.ceil(v / MAX * 5))}" data-r="${r}" data-c="${c}" aria-pressed="false" aria-label="周${days[c]} ${b} ${v} 单"></button>`; }); });
    grid.innerHTML = html;
    const cells = $$('.dat-cell', grid);
    const pick = el => { cells.forEach(x => x.setAttribute('aria-pressed', String(x === el))); const r = +el.dataset.r, c = +el.dataset.c, v = V[r][c]; read.innerHTML = `<b>周${days[c]} ${bands[r]}</b> ${v == null ? '暂无数据' : v + ' 单'}`; };
    cells.forEach(c => { c.addEventListener('click', () => pick(c)); c.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') pick(c); }); c.addEventListener('focus', () => pick(c)); });
    pick(cells[cells.length - 2]);
  })();

  /* 009 排行条：切换指标后重新排序，行位移用 FLIP 过渡 */
  (() => {
    const root = D('AP-DATA-009'), list = $('[data-list]', root), read = $('.dat-read', root);
    const P = [
      { n: '向日葵花束', img: 'product-sunflower', q: 268, p: 159 }, { n: '红玫瑰花束', img: 'product-rose-red', q: 210, p: 199 },
      { n: '粉芍药花束', img: 'product-peony-pink', q: 186, p: 239 }, { n: '白郁金香', img: 'product-tulip-white', q: 142, p: 179 }, { n: '蓝绣球盆栽', img: 'product-hydrangea-blue', q: 96, p: 129 }
    ];
    let metric = 'qty', sel = P[0].n;
    const val = p => metric === 'qty' ? p.q : p.q * p.p, txt = p => metric === 'qty' ? `${nf(p.q)} 件` : `${nf(p.q * p.p)} 元`;
    const rows = new Map();
    P.forEach(p => { const b = document.createElement('button'); b.className = 'dat-rank__row'; b.setAttribute('aria-pressed', 'false'); b.innerHTML = `<span class="dat-rank__n"></span><img class="dat-rank__img" src="../../kit/assets/photo/${p.img}.webp" alt=""><div><div class="dat-rank__top"><span class="one-line">${p.n}</span><b></b></div><div class="progress"><i></i></div></div>`; b.addEventListener('click', () => { sel = p.n; paint(false); }); rows.set(p.n, b); list.append(b); });
    function paint(animate) {
      const sorted = [...P].sort((a, b) => val(b) - val(a)), max = val(sorted[0]), total = P.reduce((a, p) => a + val(p), 0);
      const before = new Map([...rows].map(([k, el]) => [k, el.getBoundingClientRect().top]));
      sorted.forEach((p, i) => { const el = rows.get(p.n); list.append(el); el.toggleAttribute('data-top', i < 3); $('.dat-rank__n', el).textContent = i + 1; $('b', el).textContent = txt(p); $('.progress i', el).style.setProperty('--v', (val(p) / max * 100) + '%'); el.setAttribute('aria-pressed', String(p.n === sel)); });
      if (animate && !Lz.reduce) rows.forEach((el, k) => { const dy = before.get(k) - el.getBoundingClientRect().top; if (dy) el.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)' }); });
      const p = P.find(x => x.n === sel); read.innerHTML = `<b>${p.n}</b> ${metric === 'qty' ? '销量' : '销售额'} ${txt(p)} 占 ${Math.round(val(p) / total * 100)}%`;
    }
    seg(root, k => { metric = k; paint(true); }); paint(false);
  })();

  /* 010 迷你趋势：自绘画布，指针与方向键读取单日值 */
  (() => {
    const root = D('AP-DATA-010'), canvas = $('canvas', root), read = $('.dat-read', root);
    const prev = [3800, 3900, 4100, 4000, 4350, 4500, 4650], cur = [4200, 4680, 5120, 4890, 5360, 5800, 6370], ALL = prev.concat(cur);
    let range = 7, active = 6;
    const vals = () => range === 7 ? cur : ALL;
    const draw = () => {
      const v = vals(), ctx = canvas.getContext('2d'), dpr = devicePixelRatio || 1, w = canvas.clientWidth, h = canvas.clientHeight; canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
      const max = Math.max(...v), min = Math.min(...v), x = i => 6 + (w - 12) * i / (v.length - 1), y = n => 8 + (h - 16) * (1 - (n - min * .94) / (max - min * .94));
      const g = ctx.createLinearGradient(0, 0, 0, h); g.addColorStop(0, css('--action-edge')); g.addColorStop(1, css('--surface'));
      ctx.beginPath(); v.forEach((n, i) => i ? ctx.lineTo(x(i), y(n)) : ctx.moveTo(x(i), y(n))); ctx.lineTo(x(v.length - 1), h); ctx.lineTo(x(0), h); ctx.closePath(); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); v.forEach((n, i) => i ? ctx.lineTo(x(i), y(n)) : ctx.moveTo(x(i), y(n))); ctx.strokeStyle = css('--action'); ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke();
      ctx.beginPath(); ctx.arc(x(active), y(v[active]), 4.5, 0, 7); ctx.fillStyle = css('--surface'); ctx.fill(); ctx.lineWidth = 2; ctx.stroke();
      const back = v.length - 1 - active; read.innerHTML = `<b>${back === 0 ? '最近一天' : '前 ' + back + ' 天'}</b> ${nf(v[active])} 元`;
    };
    const pick = cx => { const r = canvas.getBoundingClientRect(), n = vals().length; active = Math.min(n - 1, Math.max(0, Math.round((cx - r.left - 6) / (r.width - 12) * (n - 1)))); draw(); };
    canvas.addEventListener('pointermove', e => pick(e.clientX)); canvas.addEventListener('pointerdown', e => pick(e.clientX));
    canvas.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; e.preventDefault(); active = Math.min(vals().length - 1, Math.max(0, active + d)); draw(); });
    const dom = () => { const v = vals(); $('[data-dom]', root).innerHTML = v.map((n, i) => `<li>${i === v.length - 1 ? '最近一天' : '前 ' + (v.length - 1 - i) + ' 天'} ${nf(n)} 元</li>`).join(''); };
    seg(root, k => {
      range = +k; dom(); active = vals().length - 1; const sum = vals().reduce((a, n) => a + n, 0); tween($('[data-total]', root), 0, sum, nf, 500);
      const d = $('[data-delta]', root); d.hidden = range !== 7; draw();
    });
    new ResizeObserver(draw).observe(canvas); onTheme(draw); dom(); draw();
  })();

  /* 011 漏斗：点选阶段，读取占上一步的转化 */
  (() => {
    const root = D('AP-DATA-011'), box = $('[data-fun]', root), read = $('.dat-read', root);
    const S = [['浏览商品', 5200], ['加入购物车', 1820], ['提交订单', 640], ['完成支付', 512]];
    box.innerHTML = S.map(([n, v], i) => `<button class="dat-fun__row" aria-pressed="${i === 0}" data-i="${i}" aria-label="${n} ${nf(v)} 人"><span>${n}</span><span class="dat-fun__bar" style="--w:${Math.max(10, v / S[0][1] * 100)}%;--k:${i}"></span><span class="dat-fun__v">${nf(v)}${i ? `<small>${(v / S[i - 1][1] * 100).toFixed(1)}%</small>` : ''}</span></button>`).join('');
    const rows = $$('.dat-fun__row', box);
    const pick = i => { rows.forEach((r, j) => r.setAttribute('aria-pressed', String(i === j))); const [n, v] = S[i]; read.innerHTML = i ? `<b>${n}</b> ${nf(v)} 人 占上一步 ${(v / S[i - 1][1] * 100).toFixed(1)}% 占浏览 ${(v / S[0][1] * 100).toFixed(1)}%` : `<b>${n}</b> ${nf(v)} 人 全部访客`; };
    rows.forEach((r, i) => { r.addEventListener('click', () => pick(i)); r.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') pick(i); }); });
    pick(3);
  })();

  /* 012 对比条：两个周期的值按同一比例尺画条 */
  (() => {
    const root = D('AP-DATA-012'), read = $('.dat-read', root);
    const M = { orders: { n: '订单量', now: 1286, prev: 1190, u: '单', f: nf }, sales: { n: '销售额', now: 36420, prev: 34680, u: '元', f: nf }, avg: { n: '客单价', now: 28.3, prev: 29.1, u: '元', f: n => n.toFixed(1) } };
    const bars = { now: $('[data-bar="now"]', root), prev: $('[data-bar="prev"]', root) };
    seg(root, k => {
      const m = M[k], max = Math.max(m.now, m.prev), d = (m.now - m.prev) / m.prev * 100, up = d >= 0;
      bars.now.style.setProperty('--v', m.now / max * 100 + '%'); bars.prev.style.setProperty('--v', m.prev / max * 100 + '%');
      $('[data-vnow]', root).textContent = m.f(m.now) + ' ' + m.u; $('[data-vprev]', root).textContent = m.f(m.prev) + ' ' + m.u;
      const t = $('.tag[data-delta]', root); t.textContent = (up ? '增长 ' : '下降 ') + Math.abs(Math.round(d)) + '%'; t.dataset.tone = up ? 'success' : 'danger';
      read.innerHTML = `<b>${m.n}</b> 本周比上周${up ? '多' : '少'} ${m.f(Math.abs(m.now - m.prev))} ${m.u}`;
    });
  })();

  /* 013 数字翻牌：每位数字一列滚轴，进位时先滚到第二圈再无动画归位 */
  (() => {
    const root = D('AP-DATA-013'), flip = $('[data-flip]', root), DIGITS = 5; let n = 12860;
    const cols = [];
    for (let i = 0; i < DIGITS; i++) {
      if (i === 2) flip.insertAdjacentHTML('beforeend', '<span class="dat-flip__sep">,</span>');
      const d = document.createElement('span'); d.className = 'dat-flip__d'; d.innerHTML = '<span class="dat-flip__s">' + Array.from({ length: 20 }, (_, k) => `<span>${k % 10}</span>`).join('') + '</span>'; flip.append(d); cols.push($('.dat-flip__s', d));
    }
    const digits = v => String(v).padStart(DIGITS, '0').split('').map(Number);
    const go = (v, prevV) => {
      const nd = digits(v), od = prevV == null ? nd : digits(prevV);
      cols.forEach((c, i) => {
        const wrap = nd[i] < od[i], target = wrap ? 10 + nd[i] : nd[i], em = 1.4;
        const set = pos => { c.style.transform = `translateY(${-pos * em}em)`; };
        if (prevV == null) { c.style.transition = 'none'; set(nd[i]); requestAnimationFrame(() => { c.style.transition = ''; }); return; }
        c.style.transition = ''; set(target);
        if (wrap) { const snap = () => { c.style.transition = 'none'; set(nd[i]); requestAnimationFrame(() => { c.style.transition = ''; }); }; Lz.reduce ? snap() : c.addEventListener('transitionend', snap, { once: true }); }
      });
      flip.setAttribute('aria-label', `累计订单 ${nf(v)} 单`);
    };
    go(n);
    $$('[data-step]', root).forEach(b => b.addEventListener('click', () => { const o = n; n = Math.min(99999, n + +b.dataset.step); go(n, o); }));
  })();

  /* 014 余额：入场时从 0 滚到当前值，充值滚到新值，可隐藏 */
  (() => {
    const root = D('AP-DATA-014'), el = $('[data-bal]', root), hide = $('[data-hide]', root); let bal = 2860.5, hidden = false;
    $('[data-topup]', root).addEventListener('click', () => { const o = bal; bal += 100; if (!hidden) tween(el, o, bal, nf2); Lz.toast('已充值 100 元', 'success'); });
    hide.addEventListener('click', () => { hidden = !hidden; hide.setAttribute('aria-pressed', String(hidden)); hide.textContent = hidden ? '显示' : '隐藏'; el.textContent = hidden ? '****' : nf2(bal); });
    $('[data-replay]', root).addEventListener('click', () => { if (hidden) hide.click(); tween(el, 0, bal, nf2, 800); });
    const o = new IntersectionObserver(es => { if (es[0].isIntersecting) { o.disconnect(); tween(el, 0, bal, nf2, 800); } }); o.observe(el);
  })();

  /* 015 日程完成度：勾选后环与计数同步 */
  (() => {
    const root = D('AP-DATA-015'), rows = $$('.row', root), ring = $('.dat-mini', root);
    const paint = () => { const n = rows.filter(r => r.getAttribute('aria-checked') === 'true').length, p = Math.round(n / rows.length * 100); ring.style.setProperty('--dat-p', p + '%'); $('[data-pct]', root).textContent = p + '%'; $('[data-n]', root).textContent = n; ring.setAttribute('aria-label', `完成度 ${p}%`); };
    root.addEventListener('lz:toggle', paint);
  })();

  /* 016 库存水位：安全线固定，水位变化时颜色与标签跟着变 */
  (() => {
    const root = D('AP-DATA-016'), MAXV = 60, SAFE = 30, bar = $('.dat-stock', root), n = $('[data-n]', root), tag = $('[data-tag]', root), read = $('[data-read]', root), inb = $('[data-in]', root), outb = $('[data-out]', root); let v = 18;
    const paint = () => {
      n.textContent = v; bar.style.setProperty('--v', v / MAXV * 100 + '%'); bar.setAttribute('aria-valuenow', v); const ok = v >= SAFE; bar.toggleAttribute('data-ok', ok);
      tag.textContent = ok ? '库存充足' : '低于安全线'; tag.dataset.tone = ok ? 'success' : 'danger'; read.textContent = ok ? `高出安全线 ${v - SAFE} 件` : `还差 ${SAFE - v} 件到安全线`;
      inb.disabled = v >= MAXV; outb.disabled = v <= 0;
    };
    inb.addEventListener('click', () => { v = Math.min(MAXV, v + 12); paint(); }); outb.addEventListener('click', () => { v = Math.max(0, v - 6); paint(); });
  })();
})();
</script>

