    addB.addEventListener('click', () => { R[0].v += 1; R[1].v += 190; text(); draw(); });
    $('[data-reset]', root).addEventListener('click', () => { R.forEach((r, i) => { r.v = START[i][2]; }); k = 1; text(); draw(); });
    new ResizeObserver(draw).observe(cv); onTheme(draw); text(); run(0, 1, 800, v => { k = v; draw(); });
  })();
})();
</script>
