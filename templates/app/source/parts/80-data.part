    <div class="card dat-card">
      <div class="dat-head"><span class="dat-title">销售额</span>
        <div class="seg" data-seg="dat-spark" aria-label="范围">
          <button class="seg__item" data-key="7" aria-selected="true">近七天</button>
          <button class="seg__item" data-key="14" aria-selected="false">近十四天</button>
        </div>
      </div>
      <div class="dat-spark">
        <div><p class="dat-big"><span data-total>36,420</span><small>元</small></p><p class="stat__delta" data-tone="up" data-delta>较前七天 增长 24%</p></div>
        <canvas role="img" aria-label="销售额迷你趋势" tabindex="0"></canvas>
      </div>
      <ul class="sr-only" data-dom></ul>
      <p class="dat-read" role="status"></p>
    </div>
  </div>
</article>

