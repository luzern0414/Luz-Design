<!-- cat: DATA | 数据 -->
<style>
  /* 数据类组件专属样式：前缀 dat-。颜色只取令牌，字号只取字阶 */
  .dat-card { display: grid; gap: var(--s-3); padding: var(--s-4); }
  .dat-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 32px; }
  .dat-title { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .dat-unit { margin-top: 2px; font-size: var(--fs-sm); color: var(--ink-3); }
  .dat-read { min-height: 22px; font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .dat-read b { font-weight: 600; color: var(--ink); }
  .dat-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2) var(--s-3); }
  .dat-num { display: flex; align-items: baseline; gap: var(--s-1); font-variant-numeric: tabular-nums; }
  .dat-num b { font-size: var(--fs-2xl); font-weight: 700; line-height: 1; }
  .dat-num span { font-size: var(--fs-sm); color: var(--ink-3); }
  /* 分段切换自带阴影留白：上下左右对称，再用负外距收回，行内居中才准 */
  .dat-card .seg { padding: 14px 12px; margin: -14px -12px; }
  .dat-card .dat-seg--c { justify-content: safe center; }
  .dat-card .seg__item { min-height: 32px; padding: 0 var(--s-3); }

  /* 001 三栏指标面板 */
  .dat-panel { overflow: hidden; }
  .dat-panel .stat { position: relative; padding: var(--s-4) var(--s-1); transition: background var(--dur-quick) var(--ease-out); }
  .dat-panel .stat__val { white-space: nowrap; }
  .dat-panel .stat::after { content: ""; position: absolute; left: 28%; right: 28%; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: var(--action); transform: scaleX(0); transition: transform var(--dur-base) var(--ease-spring); }
  .dat-panel .stat[aria-pressed="true"] { background: var(--action-tint); }
  .dat-panel .stat[aria-pressed="true"]::after { transform: scaleX(1); }

  /* 003 条形图 */
  .dat-bars.bars { height: 172px; padding-top: var(--s-2); }
  .dat-bars .bars__bar { flex: none; height: calc(var(--h, 0%) * .69); width: min(30px, 72%); background: color-mix(in srgb, var(--action) 18%, var(--surface)); box-shadow: none; border-radius: 8px 8px 3px 3px; transition: background var(--dur-quick) var(--ease-out); }
  .dat-bars .bars__col { cursor: pointer; gap: 6px; }
  .dat-bars .bars__col[aria-current="true"] .bars__bar { background: var(--action); }
  .dat-bars .bars__col[aria-current="true"] { color: var(--ink); font-weight: 600; }
  .dat-v { font-size: var(--fs-xs); font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .dat-bars .bars__col[aria-current="true"] .dat-v { color: var(--action-press); font-weight: 600; }

  /* 004 环形占比 */
  .dat-donut-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-5); }
  .dat-donut { --c1: var(--action); --c2: var(--accent); --c3: var(--info); position: relative; flex: none; width: 128px; height: 128px; border-radius: 50%; background: conic-gradient(var(--k1, var(--c1)) 0 var(--p1), var(--k2, var(--c2)) var(--p1) var(--p2), var(--k3, var(--c3)) var(--p2) 100%); transition: background var(--dur-base) var(--ease-out); }
  .dat-donut::after { content: ""; position: absolute; inset: 22%; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 1px var(--line); }
  .dat-donut__c { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; text-align: center; }
  .dat-donut__c b { font-size: var(--fs-xl); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .dat-donut__c span { font-size: var(--fs-xs); color: var(--ink-3); }
  .dat-donut[data-sel="1"] { --k2: color-mix(in srgb, var(--c2) 22%, var(--surface)); --k3: color-mix(in srgb, var(--c3) 22%, var(--surface)); }
  .dat-donut[data-sel="2"] { --k1: color-mix(in srgb, var(--c1) 22%, var(--surface)); --k3: color-mix(in srgb, var(--c3) 22%, var(--surface)); }
  .dat-donut[data-sel="3"] { --k1: color-mix(in srgb, var(--c1) 22%, var(--surface)); --k2: color-mix(in srgb, var(--c2) 22%, var(--surface)); }
  .dat-legend { display: grid; flex: 1 1 150px; min-width: 150px; gap: var(--s-1); }
  .dat-legend button { display: flex; align-items: center; gap: var(--s-2); width: 100%; min-height: 40px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--ink-2); text-align: left; white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
  .dat-legend button[aria-pressed="true"] { background: var(--zone); color: var(--ink); font-weight: 600; }
  .dat-legend i { width: 10px; height: 10px; border-radius: 3px; background: var(--c); flex: none; }
  .dat-legend em { margin-left: auto; font-style: normal; font-variant-numeric: tabular-nums; }

  /* 006 进度环：自定义属性做过渡，百分比平滑增长 */
  @property --dat-p { syntax: "<percentage>"; inherits: false; initial-value: 0%; }
  .dat-ring-wrap { display: flex; align-items: center; justify-content: center; gap: var(--s-5); }
  .dat-ring { position: relative; flex: none; display: grid; place-items: center; width: 116px; height: 116px; border-radius: 50%; background: conic-gradient(var(--action) var(--dat-p), var(--zone) 0); transition: --dat-p var(--dur-slow) var(--ease-out); }
  .dat-ring::before { content: ""; position: absolute; inset: 11px; border-radius: 50%; background: var(--surface); }
  .dat-ring__c { position: relative; font-size: var(--fs-xl); font-weight: 700; font-variant-numeric: tabular-nums; }
  .dat-ring[data-full] { background: conic-gradient(var(--success) var(--dat-p), var(--zone) 0); }

  /* 007 目标进度：超过 100% 仍显示真实值 */
  .dat-goal { position: relative; height: 12px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
  .dat-goal > i { display: block; height: 100%; width: var(--v, 0%); border-radius: inherit; background: var(--action); transition: width var(--dur-slow) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .dat-goal[data-over] > i { background: var(--success); }
  .dat-goal__scale { display: flex; justify-content: space-between; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* 008 热度格 */
  .dat-heat { display: grid; grid-template-columns: 36px repeat(7, 1fr); gap: 6px; align-items: center; }
  .dat-heat__h, .dat-heat__r { font-size: var(--fs-xs); color: var(--ink-3); text-align: center; }
  .dat-cell { height: 38px; border-radius: 8px; background: color-mix(in srgb, var(--action) calc(var(--l, 0) * 17% + 6%), var(--surface)); box-shadow: inset 0 0 0 1px var(--line); transition: transform var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  .dat-cell[data-none] { background: transparent; box-shadow: inset 0 0 0 1.5px var(--line-strong); background-image: repeating-linear-gradient(135deg, transparent 0 5px, var(--line) 5px 6px); }
  .dat-cell[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--action); }
  .dat-scale { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); }
  .dat-scale span { white-space: nowrap; }
  .dat-scale i { width: 20px; height: 10px; border-radius: 3px; background: color-mix(in srgb, var(--action) calc(var(--l) * 17% + 6%), var(--surface)); box-shadow: inset 0 0 0 1px var(--line); }
  .dat-scale i[data-none] { background-image: repeating-linear-gradient(135deg, transparent 0 3px, var(--line-strong) 3px 4px); }

  /* 009 排行条 */
  .dat-rank { display: grid; gap: var(--s-1); }
  .dat-rank__row { display: grid; grid-template-columns: 20px 40px 1fr; align-items: center; column-gap: var(--s-3); width: 100%; padding: var(--s-2); border-radius: var(--r-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  .dat-rank__row[aria-pressed="true"] { background: var(--action-tint); }
  .dat-rank__n { font-size: var(--fs-md); font-weight: 600; text-align: center; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dat-rank__row[data-top] .dat-rank__n { color: var(--accent); }
  .dat-rank__img { width: 40px; height: 40px; border-radius: var(--r-sm); object-fit: cover; background: var(--zone); }
  .dat-rank__top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); margin-bottom: 6px; font-size: var(--fs-sm); }
  .dat-rank__top b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .dat-rank .progress { height: 6px; }

  /* 010 迷你趋势 */
  .dat-spark { display: grid; grid-template-columns: repeat(auto-fit, minmax(124px, 1fr)); align-items: end; gap: var(--s-3); }
  .dat-spark canvas { display: block; width: 100%; height: 56px; touch-action: none; cursor: crosshair; }
  .dat-big { white-space: nowrap; font-size: var(--fs-2xl); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .dat-big small { margin-left: 2px; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }

  /* 011 漏斗 */
  .dat-fun { display: grid; gap: 6px; }
  .dat-fun__row { display: grid; grid-template-columns: 76px 1fr 56px; align-items: center; column-gap: var(--s-2); min-height: 44px; width: 100%; padding: 0 var(--s-1); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); }
  .dat-fun__bar { justify-self: center; width: var(--w); height: 36px; border-radius: 8px; background: color-mix(in srgb, var(--action) calc(100% - var(--k) * 17%), var(--surface)); transition: width var(--dur-slow) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  .dat-fun__row[aria-pressed="true"] .dat-fun__bar { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--action); }
  .dat-fun__v { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dat-fun__v small { display: block; font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); }

  /* 012 对比条 */
  .dat-cmp { display: grid; gap: var(--s-3); }
  .dat-cmp__row { display: grid; grid-template-columns: 44px 1fr 72px; align-items: center; column-gap: var(--s-3); font-size: var(--fs-sm); }
  .dat-cmp__row b { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dat-cmp__track { height: 14px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
  .dat-cmp__track i { display: block; height: 100%; width: var(--v, 0%); border-radius: inherit; background: var(--action); transition: width var(--dur-slow) var(--ease-out); }
  .dat-cmp__row[data-prev] .dat-cmp__track i { background: color-mix(in srgb, var(--action) 34%, var(--surface)); }
  .dat-cmp__row[data-prev] { color: var(--ink-3); }

  /* 013 数字翻牌 */
  .dat-flip { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-3xl); font-weight: 700; font-variant-numeric: tabular-nums; }
  .dat-flip__d { position: relative; width: .76em; height: 1.4em; overflow: hidden; border-radius: 8px; background: var(--surface); box-shadow: var(--elev-1), inset 0 0 0 1px var(--line); }
  .dat-flip__d::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 1px solid var(--line); }
  .dat-flip__s { display: block; transition: transform var(--dur-slow) var(--ease-spring); }
  .dat-flip__s span { display: block; height: 1.4em; line-height: 1.4em; text-align: center; }
  .dat-flip__sep { color: var(--ink-3); }
  .dat-center { display: grid; justify-items: center; gap: var(--s-2); padding: var(--s-3) 0 var(--s-1); }

  /* 014 余额 */
  .dat-bal { display: flex; align-items: baseline; gap: var(--s-1); font-size: var(--fs-3xl); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .dat-bal small { font-size: var(--fs-md); font-weight: 400; color: var(--ink-3); }

  /* 015 日程完成度 */
  .dat-sched { display: grid; grid-template-columns: 64px 1fr; align-items: center; column-gap: var(--s-4); }
  .dat-mini { position: relative; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: conic-gradient(var(--action) var(--dat-p), var(--zone) 0); transition: --dat-p var(--dur-slow) var(--ease-out); }
  .dat-mini::before { content: ""; position: absolute; inset: 7px; border-radius: 50%; background: var(--surface); }
  .dat-mini span { position: relative; font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; }
  .dat-sched__list { margin: 0 calc(var(--s-4) * -1) calc(var(--s-4) * -1); border-top: 1px solid var(--line); }
  .dat-sched__list .row { min-height: 48px; padding-block: var(--s-2); cursor: pointer; }
  .dat-sched__list .row[aria-checked="true"] .row__title { color: var(--ink-3); text-decoration: line-through; }
  .dat-sched__list .row[aria-checked="true"] .check { background: var(--action); border-color: var(--action); }
  .dat-sched__list .row[aria-checked="true"] .check img { opacity: 1; transform: none; }

  /* 016 库存水位 */
  .dat-stock { position: relative; height: 14px; margin: var(--s-4) 0 var(--s-1); border-radius: var(--r-full); background: var(--zone); }
  .dat-stock > i { display: block; height: 100%; width: var(--v, 0%); border-radius: inherit; background: var(--danger); transition: width var(--dur-slow) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .dat-stock[data-ok] > i { background: var(--success); }
  .dat-stock__line { position: absolute; top: -6px; bottom: -6px; left: var(--m); width: 2px; background: var(--ink); border-radius: 2px; }
  .dat-stock__line span { position: absolute; bottom: calc(100% + 2px); left: 50%; transform: translateX(-50%); font-size: var(--fs-xs); color: var(--ink-2); white-space: nowrap; }
</style>

<article class="demo" data-cid="AP-DATA-001" data-name="三栏指标面板" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">三栏指标面板</span></div>
  <p class="demo__note">适合：首页与经营页顶部的核心指标</p>
  <div class="demo__stage">
    <div class="card stats dat-panel" role="group" aria-label="经营指标">
      <button class="stat" aria-pressed="true"><span class="stat__label">订单量</span><span class="stat__val"><span data-to="1286">1,286</span><small>单</small></span><span class="stat__delta" data-tone="up">增长 8%</span></button>
      <button class="stat" aria-pressed="false"><span class="stat__label">销售额</span><span class="stat__val"><span data-to="36420">36,420</span><small>元</small></span><span class="stat__delta" data-tone="up">增长 5%</span></button>
      <button class="stat" aria-pressed="false"><span class="stat__label">客单价</span><span class="stat__val"><span data-to="28.3">28.3</span><small>元</small></span><span class="stat__delta" data-tone="down">下降 3%</span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-002" data-name="折线趋势图" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">折线趋势图</span></div>
  <p class="demo__note">适合：按日期看走势，缺失日保持断开</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head">
        <div><p class="dat-title">近七天走势</p><p class="dat-unit" data-unit>订单量 单位 单</p></div>
        <div class="seg" data-seg="dat-line" aria-label="指标">
          <button class="seg__item" data-key="orders" aria-selected="true">订单量</button>
          <button class="seg__item" data-key="sales" aria-selected="false">销售额</button>
        </div>
      </div>
      <div class="chart"><canvas role="img" aria-label="近七天订单量折线图"></canvas></div>
      <p class="dat-read" role="status"></p>
      <ul class="sr-only" data-dom></ul>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-003" data-name="条形对比图" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">条形对比图</span></div>
  <p class="demo__note">适合：品类、门店之间的数量比较，点选看明细</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><div><p class="dat-title">品类销量</p><p class="dat-unit">单位 件</p></div></div>
      <div class="bars dat-bars" role="group" aria-label="品类销量">
        <button class="bars__col" style="--h:100%;--i:0" data-name="鲜花" data-v="412" aria-current="true" aria-label="鲜花 412 件"><span class="dat-v">412</span><span class="bars__bar"></span><span>鲜花</span></button>
        <button class="bars__col" style="--h:65%;--i:1" data-name="绿植" data-v="268" aria-label="绿植 268 件"><span class="dat-v">268</span><span class="bars__bar"></span><span>绿植</span></button>
        <button class="bars__col" style="--h:48%;--i:2" data-name="礼盒" data-v="196" aria-label="礼盒 196 件"><span class="dat-v">196</span><span class="bars__bar"></span><span>礼盒</span></button>
        <button class="bars__col" style="--h:30%;--i:3" data-name="花器" data-v="124" aria-label="花器 124 件"><span class="dat-v">124</span><span class="bars__bar"></span><span>花器</span></button>
        <button class="bars__col" style="--h:21%;--i:4" data-name="种苗" data-v="86" aria-label="种苗 86 件"><span class="dat-v">86</span><span class="bars__bar"></span><span>种苗</span></button>
      </div>
      <p class="dat-read" role="status"></p>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-004" data-name="环形占比图" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">环形占比图</span></div>
  <p class="demo__note">适合：同一总体下互斥项目的构成</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><div><p class="dat-title">订单渠道</p><p class="dat-unit">共 1,286 单</p></div></div>
      <div class="dat-donut-wrap">
        <div class="dat-donut" style="--p1:45%;--p2:80%" data-sel="1" role="img" aria-label="订单渠道占比 线上 45% 门店 35% 到家 20%"><div class="dat-donut__c"><b data-val>45%</b><span data-lab>线上</span></div></div>
        <div class="dat-legend" role="group" aria-label="渠道">
          <button aria-pressed="true" data-k="1" data-v="45%" data-l="线上"><i style="--c:var(--action)"></i>线上<em>579 单</em></button>
          <button aria-pressed="false" data-k="2" data-v="35%" data-l="门店"><i style="--c:var(--accent)"></i>门店<em>450 单</em></button>
          <button aria-pressed="false" data-k="3" data-v="20%" data-l="到家"><i style="--c:var(--info)"></i>到家<em>257 单</em></button>
        </div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-005" data-name="线性进度条" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">线性进度条</span></div>
  <p class="demo__note">适合：备货、履约这类单项任务的推进</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><span class="dat-title">备货进度</span><span class="tag" data-tone="action" data-tag>进行中</span></div>
      <div class="dat-num"><b data-n>36</b><span>/ 48 件</span></div>
      <div class="progress" role="progressbar" aria-label="备货进度" aria-valuemin="0" aria-valuemax="48" aria-valuenow="36"><i style="--v:75%"></i></div>
      <div class="dat-row"><span class="dat-read" role="status" data-read>已备 75%</span><div class="btn-group"><button class="btn btn--secondary btn--sm" data-add>备一件</button><button class="btn btn--ghost btn--sm" data-reset>重置</button></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-006" data-name="圆环进度" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">圆环进度</span></div>
  <p class="demo__note">适合：各门店配送完成率这类百分比</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-ring-wrap">
        <div class="dat-ring" style="--dat-p:76%" role="img" aria-label="配送完成率 76%"><span class="dat-ring__c" data-val>76%</span></div>
        <div><p class="dat-title">配送完成率</p><p class="dat-unit" data-sub>已送达 38 单 共 50 单</p></div>
      </div>
      <div class="seg dat-seg--c" data-seg="dat-ring" aria-label="门店">
        <button class="seg__item" data-key="0" aria-selected="true">建国路店</button>
        <button class="seg__item" data-key="1" aria-selected="false">徐汇滨江店</button>
        <button class="seg__item" data-key="2" aria-selected="false">浦东世纪店</button>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-007" data-name="目标达成进度" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">目标达成进度</span></div>
  <p class="demo__note">适合：销售目标，超过百分之百显示真实达成值</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><span class="dat-title">月度销售目标</span><span class="tag" data-tone="action" data-pct>达成 76%</span></div>
      <div class="dat-num"><b data-done>68,400</b><span>元 目标 90,000 元</span></div>
      <div class="dat-goal" role="progressbar" aria-label="目标达成" aria-valuemin="0" aria-valuemax="100" aria-valuenow="76"><i style="--v:76%"></i></div>
      <div class="dat-goal__scale"><span>0</span><span>90,000 元</span></div>
      <div class="dat-row"><span class="dat-read" role="status" data-read>距目标还差 21,600 元</span><div class="btn-group"><button class="btn btn--secondary btn--sm" data-add>记一笔</button><button class="btn btn--ghost btn--sm" data-reset>重置</button></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-008" data-name="热度格图" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">热度格图</span></div>
  <p class="demo__note">适合：按星期与时段看订单密度，缺失格留空</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><div><p class="dat-title">时段订单</p><p class="dat-unit">单位 单</p></div></div>
      <div class="dat-heat" role="group" aria-label="星期与时段订单热度" data-grid></div>
      <div class="dat-scale"><span>少</span><i style="--l:0"></i><i style="--l:1"></i><i style="--l:2"></i><i style="--l:3"></i><i style="--l:4"></i><i style="--l:5"></i><span>多</span><i data-none style="--l:0"></i><span>暂无数据</span></div>
      <p class="dat-read" role="status"></p>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-009" data-name="商品排行条" data-cat="DATA">
