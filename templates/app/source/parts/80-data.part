        if (f > 1) { ctx.beginPath(); ctx.arc(cx, cy, rad[i], a0, a0 + Math.min(f - 1, 1) * 2 * Math.PI); ctx.strokeStyle = mixc(r.c, 62, 'black'); ctx.lineWidth = lw; ctx.stroke(); }
      });
      ctx.globalAlpha = 1; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = css('--ink'); ctx.font = font(14, 700); ctx.fillText(Math.round(pc(R[sel]) * 100) + '%', cx, cy + 1);
    };
