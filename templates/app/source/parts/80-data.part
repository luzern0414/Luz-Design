<article class="demo" data-cid="AP-DATA-027" data-name="周日历条" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">周日历条</span></div>
  <p class="demo__note">适合：横向一周日期条切换当天排期</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-cal__nav">
        <button class="ibtn dat-flipx" aria-label="上一周" data-tip="上一周" data-prev><span class="chev"></span></button>
        <p class="dat-title" data-title>11月9日至11月15日</p>
        <button class="ibtn" aria-label="下一周" data-tip="下一周" data-next><span class="chev"></span></button>
      </div>
      <div class="dat-wk" role="group" aria-label="一周日期" data-strip></div>
      <p class="dat-read" role="status"></p>
      <div class="dat-cal__l" data-list></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-028" data-name="活动圆环" data-cat="DATA">
  <div class="demo__head"><span class="demo__name">活动圆环</span></div>
  <p class="demo__note">适合：多项目标以同心圆环展示完成度</p>
  <div class="demo__stage">
    <div class="card dat-card">
      <div class="dat-head"><div><p class="dat-title">门店日目标</p><p class="dat-unit">建国路店</p></div></div>
      <div class="dat-act">
        <canvas class="dat-act__c" role="img" aria-label="门店日目标同心圆环" tabindex="0"></canvas>
        <div class="dat-act__l" role="group" aria-label="目标项目" data-lg></div>
      </div>
      <p class="dat-read" role="status"></p>
      <div class="dat-row" style="justify-content:flex-end"><div class="btn-group"><button class="btn btn--secondary btn--sm" data-add>记一单</button><button class="btn btn--ghost btn--sm" data-reset>重置</button></div></div>
    </div>
  </div>
</article>

<style>
/* 新增数据组件（二批）：017 倒计时 cd、018 半环仪表 gg、019 月历 cal、020 面积 ar、021 表格 tb、022 雷达 rd、023 价格 pc、024 堆叠条 sb、025 迷你柱 mb、026 趋势箭头 ta、027 周条 wk、028 圆环 act */
.dat-flipx { transform: scaleX(-1); }
.dat-flipx:active { transform: scaleX(-1) scale(.92); }
.dat-card .ibtn[disabled] { opacity: .35; pointer-events: none; }
.dat-card canvas { display: block; width: 100%; touch-action: pan-y; }

/* 017 倒计时数字块 */
.dat-cd { display: flex; align-items: flex-start; justify-content: center; gap: var(--s-2); padding: var(--s-1) 0; }
.dat-cd__g { display: grid; justify-items: center; gap: 6px; }
.dat-cd__n { display: grid; place-items: center; width: 52px; height: 56px; border-radius: var(--r-md); background: var(--action-tint); color: var(--action-press); font-size: var(--fs-2xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; box-shadow: inset 0 0 0 1px var(--action-edge); transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
.dat-cd__u { font-size: var(--fs-xs); color: var(--ink-3); }
.dat-cd__c { flex: none; width: 8px; height: 56px; background: radial-gradient(circle 2.5px at 50% 36%, var(--ink-3) 98%, transparent), radial-gradient(circle 2.5px at 50% 64%, var(--ink-3) 98%, transparent); }
.dat-cd[data-st="urgent"] .dat-cd__n { background: var(--danger-tint); color: color-mix(in srgb, var(--danger) 80%, black); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--danger) 24%, transparent); }
.dat-cd[data-st="end"] .dat-cd__n { background: var(--zone); color: var(--ink-3); box-shadow: none; }
.dat-card .seg.dat-seg--c .seg__item { padding: 0 var(--s-3); }

/* 018 半环仪表盘 */
.dat-gg { height: 176px; cursor: pointer; }
.dat-read--kv { display: flex; gap: 6px; }
.dat-read--kv b { flex: none; }

/* 019 月历日程标记 与 027 周日历条共用的导航、明细 */
.dat-cal__nav { display: grid; grid-template-columns: 40px 1fr 40px; align-items: center; }
.dat-cal__nav .dat-title { text-align: center; font-variant-numeric: tabular-nums; }
.dat-cal__w, .dat-cal__g { display: grid; grid-template-columns: repeat(7, 1fr); }
.dat-cal__w { font-size: var(--fs-xs); color: var(--ink-3); text-align: center; }
.dat-cal__d { display: grid; align-content: center; justify-items: center; gap: 3px; height: 46px; border-radius: var(--r-md); transition: background var(--dur-quick) var(--ease-out); }
.dat-cal__n { display: grid; place-items: center; width: 30px; height: 26px; border-radius: 9px; font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1; }
.dat-cal__d[aria-current="date"] .dat-cal__n { box-shadow: inset 0 0 0 1.5px var(--action); }
.dat-cal__d[aria-pressed="true"] .dat-cal__n { background: var(--action); color: var(--surface); box-shadow: none; }
@media (hover: hover) { .dat-cal__d:hover:not([aria-pressed="true"]) { background: var(--zone); } }
.dat-cal__dots { display: flex; gap: 3px; height: 6px; }
.dat-cal__dots i, .dat-cal__lg i { flex: none; width: 6px; height: 6px; border-radius: 50%; }
.dat-cal__dots i[data-t="a"], .dat-cal__lg i[data-t="a"], .dat-cal__r i[data-t="a"] { background: var(--action); }
.dat-cal__dots i[data-t="s"], .dat-cal__lg i[data-t="s"], .dat-cal__r i[data-t="s"] { background: var(--surface); box-shadow: inset 0 0 0 1.5px var(--accent); }
.dat-cal__lg { display: flex; justify-content: center; gap: var(--s-5); font-size: var(--fs-xs); color: var(--ink-3); }
.dat-cal__lg span { display: inline-flex; align-items: center; gap: 6px; }
.dat-cal__l { display: grid; margin: 0 calc(var(--s-4) * -1) calc(var(--s-4) * -1); border-top: 1px solid var(--line); }
.dat-cal__r { display: flex; align-items: center; gap: var(--s-3); min-height: 48px; padding: var(--s-2) var(--s-4); font-size: var(--fs-sm); }
.dat-cal__r + .dat-cal__r { border-top: 1px solid var(--line); }
.dat-cal__r i[data-t] { flex: none; width: 8px; height: 8px; border-radius: 50%; }
.dat-cal__r i[data-t="s"] { box-shadow: inset 0 0 0 2px var(--accent); }
.dat-cal__r .tag { margin-left: auto; }
.dat-cal__r .dat-cal__s { margin-left: auto; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); }
.dat-cal__t { min-width: 42px; font-weight: 600; font-variant-numeric: tabular-nums; }
.dat-cal__e { padding: var(--s-4); text-align: center; font-size: var(--fs-sm); color: var(--ink-3); }

/* 020 渐变面积趋势图 */
.dat-ar { height: 172px; cursor: crosshair; }

/* 021 窄屏数据表格 */
.dat-tbc { overflow: hidden; }
.dat-tbc__h { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-4) var(--s-4) var(--s-3); }
.dat-tb { position: relative; }
.dat-tb::after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 28px; pointer-events: none; background: linear-gradient(to left, color-mix(in srgb, var(--ink) 9%, transparent), transparent); opacity: 1; transition: opacity var(--dur-base) var(--ease-out); }
.dat-tb[data-s="end"]::after { opacity: 0; }
.dat-tb__sc { overflow-x: auto; scrollbar-width: thin; }
.dat-tb__sc:focus-visible { outline-offset: -2px; border-radius: 0; }
.dat-tb__t { width: 100%; min-width: 660px; border-collapse: separate; border-spacing: 0; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
.dat-tb__t th, .dat-tb__t td { height: 48px; padding: 0 var(--s-3); border-top: 1px solid var(--line); text-align: center; white-space: nowrap; }
.dat-tb__t th { height: 40px; background: var(--zone); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); }
.dat-tb__t td.r { text-align: right; padding-right: var(--s-5); }
.dat-tb__t tfoot td { background: var(--action-tint); font-weight: 600; }
.dat-tb__t td:first-child, .dat-tb__t th:first-child { position: sticky; left: 0; z-index: 1; min-width: 104px; background: var(--surface); font-weight: 600; }
.dat-tb__t th:first-child { background: var(--zone); }
.dat-tb__t tfoot td:first-child { background: var(--action-tint); }
.dat-tb__t td:first-child::after, .dat-tb__t th:first-child::after { content: ""; position: absolute; top: 0; bottom: 0; right: -10px; width: 10px; pointer-events: none; background: linear-gradient(to right, color-mix(in srgb, var(--ink) 9%, transparent), transparent); opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
.dat-tb:not([data-s="start"]) .dat-tb__t td:first-child::after, .dat-tb:not([data-s="start"]) .dat-tb__t th:first-child::after { opacity: 1; }
.dat-tb__b { display: inline-flex; align-items: center; gap: 4px; min-height: 32px; font-size: inherit; font-weight: inherit; color: inherit; }
.dat-tb__b .chev::after { width: 6px; height: 6px; margin: 0; border-width: 0 1.6px 1.6px 0; opacity: 0; transform: rotate(45deg) translateY(-2px); transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-out); }
th[aria-sort="descending"] .chev::after { opacity: 1; }
th[aria-sort="ascending"] .chev::after { opacity: 1; transform: rotate(-135deg) translateY(-2px); }
@media (hover: hover) { th[aria-sort="none"] .dat-tb__b:hover .chev::after { opacity: .5; } }

/* 022 能力雷达图 */
.dat-rd { height: 288px; cursor: pointer; }
.dat-rd__lg { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-1) var(--s-2); }
.dat-rd__lg button { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
.dat-rd__lg button[aria-pressed="true"] { background: var(--zone); color: var(--ink); font-weight: 600; }
.dat-rd__lg i { flex: none; width: 22px; height: 0; border-top: 3px solid var(--c); }
.dat-rd__lg i[data-d="dash"] { border-top-style: dashed; }
.dat-rd__lg i[data-d="dot"] { border-top-style: dotted; }
.dat-rd__lg button[aria-pressed="false"] i { opacity: .35; }

/* 023 价格数字展示 */
.dat-pc__top { display: flex; align-items: center; gap: var(--s-3); }
.dat-pc__img { width: 48px; height: 48px; flex: none; border-radius: var(--r-md); object-fit: cover; background: var(--zone); }
.dat-pc__main { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-1); }
.dat-pc__line { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-1) var(--s-2); min-width: 0; }
.dat-pc__v { display: inline-flex; align-items: baseline; color: var(--price); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; white-space: nowrap; }
.dat-pc__v[data-sz="lg"] { font-size: var(--fs-3xl); }
.dat-pc__v[data-sz="sm"] { font-size: var(--fs-md); }
.dat-pc__v > small { font-weight: 600; }
.dat-pc__s { margin-right: 2px; font-size: max(.5em, var(--fs-xs)); }
.dat-pc__d { font-size: max(.55em, var(--fs-xs)); }
.dat-pc__q { margin-left: 3px; font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); }
.dat-pc__o { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; text-decoration: line-through; }
.dat-pc__sw { display: flex; align-items: center; gap: var(--s-2); flex: none; font-size: var(--fs-sm); color: var(--ink-2); }
.dat-pc__mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); margin: 0 calc(var(--s-4) * -1) calc(var(--s-4) * -1); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
.dat-pc__c { display: grid; align-content: start; justify-items: center; gap: 4px; text-align: center; }
.dat-pc__c .dat-unit { margin: 0; white-space: nowrap; }
.dat-pc__na { font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.6; }

/* 024 堆叠条形图 */
.dat-sb__lg { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); }
.dat-sb__lg button { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
.dat-sb__lg button[aria-pressed="true"] { background: var(--zone); color: var(--ink); font-weight: 600; }
.dat-sb__lg button[aria-pressed="false"] i { opacity: .35; }
.dat-sb__lg i { flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--c); }
.dat-sb { display: grid; gap: var(--s-3); }
.dat-sb__r { display: grid; gap: 6px; }
.dat-sb__h { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); font-size: var(--fs-sm); }
.dat-sb__h b { font-weight: 600; font-variant-numeric: tabular-nums; }
.dat-sb__bar { display: flex; height: 30px; border-radius: 8px; overflow: hidden; background: var(--zone); }
.dat-sb__s { flex: none; width: var(--w, 0%); height: 100%; background: var(--c); border-right: 2px solid var(--surface); transition: width var(--dur-slow) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
.dat-sb__s:last-child { border-right: 0; }
.dat-sb__s[aria-pressed="true"] { box-shadow: inset 0 0 0 2px var(--ink); }

/* 025 迷你柱形图 */
.dat-mb { display: grid; margin: 0 calc(var(--s-4) * -1); }
.dat-mb__r { display: grid; grid-template-columns: minmax(0, 1fr) 128px; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-4); }
.dat-mb__r + .dat-mb__r { border-top: 1px solid var(--line); }
.dat-mb__n { font-size: var(--fs-sm); color: var(--ink-3); }
.dat-mb__v { display: flex; align-items: baseline; gap: 2px; font-size: var(--fs-xl); font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
.dat-mb__v small { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
.dat-mb canvas { height: 56px; cursor: crosshair; }

/* 026 趋势箭头标记 */
.dat-ta { display: grid; margin: 0 calc(var(--s-4) * -1); }
.dat-ta__r { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: var(--s-3); min-height: 52px; padding: var(--s-2) var(--s-4); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.dat-ta__r + .dat-ta__r { border-top: 1px solid var(--line); }
.dat-ta__r[aria-pressed="true"] { background: var(--action-tint); }
.dat-ta__n { font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }
.dat-ta__v { font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
.dat-ta__v small { margin-left: 2px; font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); }
.dat-ta__m { --c: var(--ink-2); --t: var(--zone); display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 88px; height: 24px; padding: 0 var(--s-2); border-radius: 7px; background: var(--t); color: var(--c); font-size: var(--fs-xs); font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
.dat-ta__m[data-t="good"] { --c: var(--success); --t: var(--success-tint); }
.dat-ta__m[data-t="bad"] { --c: color-mix(in srgb, var(--danger) 80%, black); --t: var(--danger-tint); }
.dat-ta__a { flex: none; display: grid; place-items: center; width: 10px; height: 10px; }
.dat-ta__a::after { content: ""; width: 6px; height: 6px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg) translate(-1px, -1px); transition: transform var(--dur-base) var(--ease-spring); }
.dat-ta__a[data-d="up"]::after { transform: rotate(-135deg) translate(-1px, -1px); }
.dat-ta__a[data-d="flat"]::after { width: 8px; height: 0; border-width: 0 0 2px 0; transform: none; }

/* 027 周日历条 */
.dat-wk { display: grid; grid-template-columns: repeat(7, 1fr); touch-action: pan-y; }
.dat-wk__d { display: grid; align-content: center; justify-items: center; gap: 2px; height: 70px; border-radius: var(--r-md); transition: background var(--dur-quick) var(--ease-out); }
.dat-wk__w { font-size: var(--fs-xs); color: var(--ink-3); }
.dat-wk__d[aria-pressed="true"] { background: var(--action); color: var(--surface); }
.dat-wk__d[aria-pressed="true"] .dat-wk__w { color: var(--surface); opacity: .85; }
.dat-wk__d[aria-pressed="true"] .dat-cal__n { background: none; box-shadow: none; }
.dat-wk__d .dat-cal__n { width: 32px; height: 28px; font-size: var(--fs-md); }
.dat-wk__d[aria-current="date"]:not([aria-pressed="true"]) .dat-cal__n { box-shadow: inset 0 0 0 1.5px var(--action); }
.dat-wk__d[data-past] .dat-cal__n { color: var(--ink-3); }
.dat-wk__d[aria-pressed="true"][data-past] .dat-cal__n { color: var(--surface); }
.dat-wk__d[aria-pressed="true"] .dat-cal__dots i[data-t="a"] { background: var(--surface); }
.dat-wk__rest { height: 6px; font-size: var(--fs-xs); line-height: 6px; color: var(--ink-3); }
.dat-wk__d[aria-pressed="true"] .dat-wk__rest { color: var(--surface); }
@media (hover: hover) { .dat-wk__d:hover:not([aria-pressed="true"]) { background: var(--zone); } }
.dat-cal__r .dat-cal__s[data-s="done"] { color: var(--success); }

/* 028 活动圆环 */
.dat-act { display: flex; align-items: center; gap: var(--s-3); }
.dat-act .dat-act__c { flex: none; width: 140px; height: 140px; cursor: pointer; }
.dat-act__l { display: grid; flex: 1; min-width: 0; gap: var(--s-1); }
.dat-act__l button { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: var(--s-2); min-height: 44px; padding: 2px var(--s-2); border-radius: var(--r-sm); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
.dat-act__l button[aria-pressed="true"] { background: var(--zone); }
.dat-act__k { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }
.dat-act__k i { flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--c); }
.dat-act__l b { font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; }
.dat-act__l small { grid-column: 1 / -1; padding-left: 18px; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const nf = n => Math.round(n).toLocaleString('zh-CN');
  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const mixc = (token, pct, base = 'transparent') => `color-mix(in srgb, ${css(token)} ${pct}%, ${base})`;
  const pad = n => String(n).padStart(2, '0');
  const onTheme = fn => new MutationObserver(fn).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  const seg = (root, fn) => root.addEventListener('lz:seg', e => fn(e.detail.key));
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const WKN = ['日', '一', '二', '三', '四', '五', '六'];
  /* 按设备像素比准备画布并清空，返回上下文与逻辑尺寸 */
  const fit = cv => {
    const dpr = devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight, W = Math.round(w * dpr), H = Math.round(h * dpr);
    if (cv.width !== W || cv.height !== H) { cv.width = W; cv.height = H; }
    const ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h); return { ctx, w, h };
  };
  const font = (px, wt = 400) => `${wt} ${px}px ${css('--font')}`;
  const ease = t => 1 - Math.pow(1 - t, 3);
  /* 把 from 缓动到 to，每帧回调当前值；系统要求减少动态时直接给终值 */
  const run = (from, to, ms, fn) => { if (Lz.reduce) { fn(to); return; } const t0 = performance.now(); const step = t => { const p = Math.min(1, (t - t0) / ms); fn(from + (to - from) * ease(p)); if (p < 1) requestAnimationFrame(step); }; requestAnimationFrame(step); };

  /* 017 倒计时：按结束时刻计时，快进只改结束时刻；剩余不足五分钟转红，归零后按钮停用 */
  (() => {
    const root = D('AP-DATA-017'), box = $('[data-box]', root), tag = $('[data-tag]', root), ff = $('[data-ff]', root);
    const SC = {
      rush: { t: '红玫瑰限时价', s: '距结束', ms: ((2 * 60 + 15) * 60 + 30) * 1000, tags: ['进行中', '即将结束', '已结束'], step: 600000, lab: '快进十分钟', u: ['h', 'm', 's'] },
      pay: { t: '订单待支付', s: '订单 1286', ms: (14 * 60 + 59) * 1000, tags: ['待支付', '即将关闭', '已关闭'], step: 120000, lab: '快进两分钟', u: ['h', 'm', 's'] },
      pre: { t: '新品预售', s: '距开售', ms: (((2 * 24 + 5) * 60 + 20) * 60 + 10) * 1000, tags: ['预热中', '即将开售', '已开售'], step: 86400000, lab: '快进一天', u: ['d', 'h', 'm', 's'] }
    };
    const UN = { d: '天', h: '时', m: '分', s: '秒' };
    let key = 'rush', end = 0;
    const build = () => {
      const sc = SC[key]; $('[data-title]', root).textContent = sc.t; $('[data-sub]', root).textContent = sc.s; ff.textContent = sc.lab;
      box.innerHTML = sc.u.map((u, i) => `${i ? '<i class="dat-cd__c"></i>' : ''}<div class="dat-cd__g"><b class="dat-cd__n" data-u="${u}">00</b><span class="dat-cd__u">${UN[u]}</span></div>`).join('');
      box.dataset.st = '';
    };
    const paint = () => {
      const sc = SC[key], ms = Math.max(0, end - Date.now()), s = Math.ceil(ms / 1000), v = { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600), m: Math.floor(s % 3600 / 60), s: s % 60 };
      sc.u.forEach(u => { const el = $(`[data-u="${u}"]`, box), t = pad(v[u]); if (el.textContent !== t) el.textContent = t; });
      const st = ms === 0 ? 'end' : ms < 300000 ? 'urgent' : 'go';
      if (box.dataset.st !== st) { box.dataset.st = st; const i = { go: 0, urgent: 1, end: 2 }[st]; tag.textContent = sc.tags[i]; tag.dataset.tone = ['action', 'danger', ''][i]; ff.disabled = st === 'end'; }
      box.setAttribute('aria-label', st === 'end' ? sc.tags[2] : `剩余${v.d ? v.d + '天' : ''}${v.h}时${v.m}分${v.s}秒`);
    };
    const start = () => { end = Date.now() + SC[key].ms; build(); paint(); };
    seg(root, k => { key = k; start(); });
    ff.addEventListener('click', () => { end -= SC[key].step; paint(); });
    $('[data-reset]', root).addEventListener('click', start);
    setInterval(paint, 250); start();
  })();

  /* 018 半环仪表盘：指针靠近目标线或键盘左右键切换读取当前值与目标线，换指标时弧线扫过去 */
  (() => {
    const root = D('AP-DATA-018'), cv = $('canvas', root), read = $('.dat-read', root);
    const M = {
      score: { n: '服务评分', s: '服务评分', u: '分', lo: 0, hi: 5, v: 4.8, t: 4.5, f: n => n.toFixed(1), rng: '服务评分 范围 0 至 5 分', gap: d => Math.abs(d).toFixed(1) + ' 分' },
      ontime: { n: '配送准时率', s: '准时率', u: '%', lo: 0, hi: 100, v: 91, t: 96, f: n => String(Math.round(n)), rng: '配送准时率 范围 0 至 100%', gap: d => Math.abs(Math.round(d)) + ' 个百分点' },
      sales: { n: '日销目标完成度', s: '完成度', u: '%', lo: 0, hi: 100, v: 76, t: 70, f: n => String(Math.round(n)), rng: '日销售额 已售 6,840 元 目标 9,000 元', gap: d => Math.abs(Math.round(d)) + ' 个百分点', extra: ' 已售 6,840 元' }
    };
    let key = 'score', sel = 'value', shown = M.score.v;
    const text = () => {
      const m = M[key], d = m.v - m.t;
      return sel === 'value'
        ? `<b>${m.s}</b> <span>${m.f(m.v)}${m.u} ${d === 0 ? '与目标持平' : (d > 0 ? '高出目标 ' : '低于目标 ') + m.gap(d)}</span>`
        : `<b>目标线</b> <span>${m.f(m.t)}${m.u} ${d >= 0 ? '已达成' : '未达成 还差 ' + m.gap(d)}</span>`;
    };
    const draw = () => {
      const { ctx, w, h } = fit(cv), m = M[key], cx = w / 2, cy = h - 28, lw = 18, R = Math.min(w / 2 - 30, h - 62), frac = v => (v - m.lo) / (m.hi - m.lo), ang = f => Math.PI + f * Math.PI;
      if (R <= 0) return;
      ctx.lineCap = 'round';
      ctx.beginPath(); ctx.arc(cx, cy, R, Math.PI, 2 * Math.PI); ctx.strokeStyle = css('--zone'); ctx.lineWidth = lw; ctx.stroke();
      for (let i = 0; i <= 10; i++) { const a = ang(i / 10), r1 = R - lw / 2 - 5, r2 = r1 - (i % 5 ? 4 : 8); ctx.beginPath(); ctx.moveTo(cx + Math.cos(a) * r1, cy + Math.sin(a) * r1); ctx.lineTo(cx + Math.cos(a) * r2, cy + Math.sin(a) * r2); ctx.strokeStyle = css('--line-strong'); ctx.lineWidth = 1.5; ctx.stroke(); }
      const ok = m.v >= m.t, col = css(ok ? '--action' : '--warning'), fv = clamp(frac(shown), 0, 1);
      if (fv > 0) { ctx.beginPath(); ctx.arc(cx, cy, R, Math.PI, ang(fv)); ctx.strokeStyle = col; ctx.lineWidth = lw; ctx.stroke(); }
      const ta = ang(frac(m.t)), tw = sel === 'target' ? 4 : 2.5, t1 = R - lw / 2 - 3, t2 = R + lw / 2 + 5;
      ctx.beginPath(); ctx.moveTo(cx + Math.cos(ta) * t1, cy + Math.sin(ta) * t1); ctx.lineTo(cx + Math.cos(ta) * t2, cy + Math.sin(ta) * t2); ctx.strokeStyle = css('--ink'); ctx.lineWidth = tw; ctx.lineCap = 'butt'; ctx.stroke(); ctx.lineCap = 'round';
      const ka = ang(fv); ctx.beginPath(); ctx.arc(cx + Math.cos(ka) * R, cy + Math.sin(ka) * R, sel === 'value' ? 8 : 6, 0, 7); ctx.fillStyle = css('--surface'); ctx.fill(); ctx.lineWidth = 3; ctx.strokeStyle = col; ctx.stroke();
      ctx.textAlign = 'center'; ctx.fillStyle = css('--ink');
      const num = m.f(shown), unit = m.u; ctx.font = font(28, 700); const w1 = ctx.measureText(num).width; ctx.font = font(14); const w2 = ctx.measureText(unit).width;
      const x0 = cx - (w1 + w2 + 2) / 2; ctx.textAlign = 'left'; ctx.font = font(28, 700); ctx.fillText(num, x0, cy - 6); ctx.font = font(14); ctx.fillStyle = css('--ink-3'); ctx.fillText(unit, x0 + w1 + 2, cy - 6);
      ctx.textAlign = 'center'; ctx.font = font(14); ctx.fillText(m.n, cx, cy + 18);
      ctx.font = font(12); ctx.fillStyle = css('--ink-3'); ctx.textAlign = 'center'; ctx.fillText(String(m.lo), cx - R, cy + 22); ctx.fillText(String(m.hi), cx + R, cy + 22);
    };
    const info = () => {
      const m = M[key]; $('[data-unit]', root).textContent = m.rng; cv.setAttribute('aria-label', `${m.n}半环仪表盘 当前 ${m.f(m.v)}${m.u} 目标 ${m.f(m.t)}${m.u} 范围 ${m.lo} 至 ${m.hi}`);
      $('[data-dom]', root).innerHTML = `<li>${m.n} 当前 ${m.f(m.v)}${m.u}${m.extra || ''}</li><li>目标 ${m.f(m.t)}${m.u}</li>`; read.innerHTML = text();
    };
    const pick = (x, y) => {
      const r = cv.getBoundingClientRect(), m = M[key], px = x - r.left - r.width / 2, py = y - r.top - (r.height - 28), a = Math.atan2(py, px), ta = Math.PI + (m.t - m.lo) / (m.hi - m.lo) * Math.PI;
      const near = Math.abs(((a - ta + 3 * Math.PI) % (2 * Math.PI)) - Math.PI) < .12 && Math.hypot(px, py) > 40; sel = near ? 'target' : 'value'; read.innerHTML = text(); draw();
    };
    cv.addEventListener('pointermove', e => pick(e.clientX, e.clientY)); cv.addEventListener('pointerdown', e => pick(e.clientX, e.clientY));
    cv.addEventListener('keydown', e => { if (!['ArrowLeft', 'ArrowRight'].includes(e.key)) return; e.preventDefault(); sel = sel === 'value' ? 'target' : 'value'; read.innerHTML = text(); draw(); });
    seg(root, k => { const from = shown; key = k; sel = 'value'; info(); run(from, M[k].v, 520, v => { shown = v; draw(); }); });
    new ResizeObserver(draw).observe(cv); onTheme(draw); info(); run(M.score.lo, M.score.v, 700, v => { shown = v; draw(); });
  })();

  /* 019 月历日程标记：预约为实心点，签到为空心点；方向键移动日期，翻月停在第一个或同号日 */
  (() => {
    const root = D('AP-DATA-019'), grid = $('[data-grid]', root), title = $('[data-title]', root), list = $('[data-list]', root), read = $('.dat-read', root), prev = $('[data-prev]', root), next = $('[data-next]', root);
    const NOW = '2026-11-09', MIN = 10, MAX = 12;
    const key = (y, m, d) => `${y}-${pad(m)}-${pad(d)}`;
    const EV = {
      '2026-10-08': [['10:00', '花艺沙龙', 6]], '2026-10-15': [['10:00', '花艺沙龙', 7]], '2026-10-22': [['10:00', '花艺沙龙', 6]], '2026-10-24': [['14:00', '上门花艺布置', 2]], '2026-10-29': [['10:00', '花艺沙龙', 8]],
      '2026-11-05': [['10:00', '花艺沙龙', 6]], '2026-11-12': [['10:00', '花艺沙龙', 6], ['14:30', '鲜花订阅配送', 3]], '2026-11-14': [['11:00', '婚礼花艺试做', 2]], '2026-11-19': [['10:00', '花艺沙龙', 5]], '2026-11-21': [['15:00', '生日花束定制', 1]], '2026-11-26': [['10:00', '花艺沙龙', 6]],
      '2026-12-03': [['10:00', '花艺沙龙', 4]], '2026-12-10': [['10:00', '花艺沙龙', 3]], '2026-12-17': [['10:00', '花艺沙龙', 2]], '2026-12-24': [['10:00', '花艺沙龙', 8], ['14:00', '圣诞花环课', 8]]
    };
    const SIGN = new Set([...[1, 2, 3, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 26, 27, 28, 29, 30].map(d => key(2026, 10, d)), ...[1, 2, 4, 5, 6, 7, 8, 9].map(d => key(2026, 11, d))]);
    let y = 2026, m = 11, sel = '2026-11-12';
    const dayN = () => new Date(y, m, 0).getDate(), wdOf = d => (new Date(y, m - 1, d).getDay() + 6) % 7;
    const detail = () => {
      const [, mm, dd] = sel.split('-').map(Number), ev = EV[sel] || [], s = SIGN.has(sel), wd = WKN[new Date(y, mm - 1, dd).getDay()];
      read.innerHTML = `<b>${mm}月${dd}日 周${wd}</b> 预约 ${ev.length} 个${sel <= NOW ? (s ? ' 已签到' : ' 未签到') : ''}`;
      const html = ev.map(([t, n, p]) => `<div class="dat-cal__r"><i data-t="a"></i><span class="dat-cal__t">${t}</span><span class="one-line">${n}</span><span class="tag">${p} 人</span></div>`).join('') + (s ? '<div class="dat-cal__r"><i data-t="s"></i><span>签到</span><span class="dat-cal__s" data-s="done">已完成</span></div>' : '');
      list.innerHTML = html || '<p class="dat-cal__e">当日没有预约与签到</p>';
    };
    const render = () => {
      title.textContent = `${y}年${m}月`; prev.disabled = m <= MIN; next.disabled = m >= MAX;
      let h = '<span></span>'.repeat(wdOf(1));
      for (let d = 1; d <= dayN(); d++) {
        const k = key(y, m, d), a = (EV[k] || []).length, s = SIGN.has(k);
        h += `<button class="dat-cal__d" data-k="${k}" aria-pressed="${k === sel}" tabindex="${k === sel ? 0 : -1}"${k === NOW ? ' aria-current="date"' : ''} aria-label="${m}月${d}日 周${WKN[(wdOf(d) + 1) % 7]}${a ? ' 预约 ' + a + ' 个' : ''}${s ? ' 已签到' : ''}"><span class="dat-cal__n">${d}</span><span class="dat-cal__dots">${a ? '<i data-t="a"></i>' : ''}${s ? '<i data-t="s"></i>' : ''}</span></button>`;
      }
      grid.innerHTML = h; detail();
    };
    const pick = (k, focus) => {
      sel = k; $$('.dat-cal__d', grid).forEach(b => { const on = b.dataset.k === k; b.setAttribute('aria-pressed', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); }); detail();
    };
    const go = d => { m += d; const day = Math.min(+sel.slice(-2), dayN()); sel = key(y, m, day); render(); };
    grid.addEventListener('click', e => { const b = e.target.closest('.dat-cal__d'); if (b) pick(b.dataset.k); });
    grid.addEventListener('keydown', e => {
      const d = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key]; if (!d) return; e.preventDefault();
      const n = clamp(+sel.slice(-2) + d, 1, dayN()); pick(key(y, m, n), true);
    });
    prev.addEventListener('click', () => go(-1)); next.addEventListener('click', () => go(1)); render();
  })();

  /* 020 渐变面积：缺失日断开，指针与方向键读取单日并给出较前一日的变化 */
  (() => {
    const root = D('AP-DATA-020'), cv = $('canvas', root), read = $('.dat-read', root);
    const days = Array.from({ length: 14 }, (_, i) => new Date(2026, 9, 27 + i)), LB = days.map(d => `${d.getMonth() + 1}月${d.getDate()}日`), WK = days.map(d => '周' + WKN[d.getDay()]);
    const S = {
      sales: { n: '营收', u: '元', v: [5120, 5480, 5360, 6190, 7840, 8260, 5240, null, 5410, 5630, 6320, 8080, 8520, 5460] },
      flow: { n: '客流', u: '人', v: [212, 230, 224, 262, 331, 352, 218, null, 226, 239, 268, 339, 361, 229] }
    };
    let key = 'sales', active = 13;
    const niceStep = r => { const p = Math.pow(10, Math.floor(Math.log10(r))), f = r / p; return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * p; };
    const text = () => {
      const s = S[key], v = s.v[active], p = active ? s.v[active - 1] : null;
      if (v == null) return `<b>${LB[active]} ${WK[active]}</b> 当日休息 暂无数据`;
      const dl = !active ? '' : p == null ? '前一日暂无数据' : `较前一日 ${v >= p ? '增长 ' : '下降 '}${Math.abs(Math.round((v - p) / p * 100))}%`;
      return `<b>${LB[active]} ${WK[active]}</b> ${nf(v)} ${s.u} ${dl}`.trim();
    };
    const draw = () => {
      const { ctx, w, h } = fit(cv), s = S[key], v = s.v, pd = { l: 42, r: 12, t: 10, b: 24 }, nums = v.filter(x => x != null), max = Math.max(...nums), step = niceStep(max / 4), top = step * Math.ceil(max / step);
      const X = i => pd.l + (w - pd.l - pd.r) * i / (v.length - 1), Y = n => pd.t + (h - pd.t - pd.b) * (1 - n / top), base = h - pd.b;
      ctx.font = font(12); ctx.textBaseline = 'middle';
      for (let k = 0; k * step <= top; k++) { const y = Y(k * step); ctx.beginPath(); ctx.moveTo(pd.l, y); ctx.lineTo(w - pd.r, y); ctx.strokeStyle = css(k ? '--line' : '--line-strong'); ctx.lineWidth = 1; ctx.stroke(); ctx.fillStyle = css('--ink-3'); ctx.textAlign = 'right'; ctx.fillText(nf(k * step), pd.l - 6, y); }
      ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'center';
      [0, 6, 13].forEach(i => { ctx.textAlign = i === 0 ? 'left' : i === 13 ? 'right' : 'center'; ctx.fillStyle = css('--ink-3'); ctx.fillText(LB[i], i === 0 ? pd.l : X(i), h - 6); });
      const runs = []; let cur = null; v.forEach((n, i) => { if (n == null) { cur = null; return; } if (!cur) { cur = []; runs.push(cur); } cur.push(i); });
      const g = ctx.createLinearGradient(0, pd.t, 0, base); g.addColorStop(0, mixc('--action', 36)); g.addColorStop(1, mixc('--action', 2));
      runs.forEach(r => {
        if (r.length < 2) return;
        ctx.beginPath(); ctx.moveTo(X(r[0]), base); r.forEach(i => ctx.lineTo(X(i), Y(v[i]))); ctx.lineTo(X(r[r.length - 1]), base); ctx.closePath(); ctx.fillStyle = g; ctx.fill();
        ctx.beginPath(); r.forEach((i, k) => k ? ctx.lineTo(X(i), Y(v[i])) : ctx.moveTo(X(i), Y(v[i]))); ctx.strokeStyle = css('--action'); ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke();
      });
      ctx.setLineDash([3, 3]); ctx.beginPath(); ctx.moveTo(X(active), pd.t); ctx.lineTo(X(active), base); ctx.strokeStyle = css('--line-strong'); ctx.lineWidth = 1; ctx.stroke(); ctx.setLineDash([]);
      v.forEach((n, i) => { if (n == null) return; ctx.beginPath(); ctx.arc(X(i), Y(n), i === active ? 5 : 2.5, 0, 7); ctx.fillStyle = i === active ? css('--action') : css('--surface'); ctx.fill(); ctx.lineWidth = i === active ? 2.5 : 1.5; ctx.strokeStyle = i === active ? css('--surface') : css('--action'); ctx.stroke(); });
      read.innerHTML = text();
    };
    const info = () => {
      const s = S[key], nums = s.v.filter(x => x != null);
      $('[data-title]', root).textContent = `近十四天${s.n}`; $('[data-unit]', root).textContent = `单位 ${s.u}`; $('[data-total]', root).textContent = nf(nums.reduce((a, n) => a + n, 0)); $('[data-sum]', root).textContent = `${s.u} 合计 ${nums.length} 个营业日`;
      cv.setAttribute('aria-label', `近十四天${s.n}面积图 单位${s.u}`);
      $('[data-dom]', root).innerHTML = s.v.map((n, i) => `<li>${LB[i]} ${WK[i]} ${n == null ? '暂无数据' : nf(n) + ' ' + s.u}</li>`).join('');
    };
    const pick = x => { const r = cv.getBoundingClientRect(); active = clamp(Math.round((x - r.left - 42) / (r.width - 54) * 13), 0, 13); draw(); };
    cv.addEventListener('pointermove', e => pick(e.clientX)); cv.addEventListener('pointerdown', e => pick(e.clientX));
    cv.addEventListener('keydown', e => { const d = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (!d) return; e.preventDefault(); active = clamp(active + d, 0, 13); draw(); });
    seg(root, k => { key = k; info(); draw(); });
    new ResizeObserver(draw).observe(cv); onTheme(draw); info(); draw();
  })();

  /* 021 窄屏表格：首列固定，横滑时左右出现阴影；表头点按排序，再点反向，第三次还原 */
  (() => {
    const root = D('AP-DATA-021'), body = $('[data-body]', root), foot = $('[data-foot]', root), wrap = $('.dat-tb', root), sc = $('.dat-tb__sc', root), ths = $$('th[aria-sort]', root);
    const R = [
      { n: '建国路店', orders: 486, sales: 13860, refund: 320, margin: 62, st: ['已对平', 'success'] },
      { n: '徐汇滨江店', orders: 372, sales: 10990, refund: 180, margin: 60, st: ['已对平', 'success'] },
      { n: '浦东世纪店', orders: 428, sales: 12150, refund: 560, margin: 58, st: ['差异 20 元', 'danger'] },
      { n: '静安嘉里店', orders: 276, sales: 8420, refund: 0, margin: 63, st: ['待核对', 'warning'] }
    ];
    R.forEach(r => { r.avg = r.sales / r.orders; });
    const tot = { orders: 0, sales: 0, refund: 0, mw: 0 }; R.forEach(r => { tot.orders += r.orders; tot.sales += r.sales; tot.refund += r.refund; tot.mw += r.margin * r.sales; });
    let sort = { k: '', dir: 0 };
    const cell = r => `<tr><td>${r.n}</td><td>${nf(r.orders)}</td><td class="r">${nf(r.sales)}</td><td class="r">${nf(r.refund)}</td><td class="r">${r.avg.toFixed(1)}</td><td>${r.margin}%</td><td><span class="tag" data-tone="${r.st[1]}">${r.st[0]}</span></td></tr>`;
    const paint = () => {
      const rows = R.slice(); if (sort.dir) rows.sort((a, b) => (a[sort.k] - b[sort.k]) * sort.dir);
      body.innerHTML = rows.map(cell).join('');
      foot.innerHTML = `<tr><td>合计</td><td>${nf(tot.orders)}</td><td class="r">${nf(tot.sales)}</td><td class="r">${nf(tot.refund)}</td><td class="r">${(tot.sales / tot.orders).toFixed(1)}</td><td>${Math.round(tot.mw / tot.sales)}%</td><td></td></tr>`;
      ths.forEach(th => { const k = $('[data-k]', th).dataset.k; th.setAttribute('aria-sort', sort.k === k && sort.dir ? (sort.dir > 0 ? 'ascending' : 'descending') : 'none'); });
    };
    ths.forEach(th => $('[data-k]', th).addEventListener('click', () => {
      const k = $('[data-k]', th).dataset.k; if (sort.k !== k) sort = { k, dir: -1 }; else sort.dir = sort.dir === -1 ? 1 : sort.dir === 1 ? 0 : -1; paint();
    }));
    const edge = () => { wrap.dataset.s = sc.scrollLeft <= 1 ? 'start' : sc.scrollLeft + sc.clientWidth >= sc.scrollWidth - 1 ? 'end' : 'mid'; };
    sc.addEventListener('scroll', edge, { passive: true }); new ResizeObserver(edge).observe(sc);
    $('[data-n]', root).textContent = `${R.filter(r => r.st[1] !== 'success').length} 家待处理`; paint(); edge();
  })();

  /* 022 能力雷达：指针或方向键选中维度，读数列出当前显示的各店；图例可显示隐藏，至少留一家 */
  (() => {
    const root = D('AP-DATA-022'), cv = $('canvas', root), read = $('.dat-read', root), lg = $('[data-lg]', root);
    const DIM = ['鲜度', '包装', '配送', '服务', '价格', '售后'];
    const S = [
      { n: '建国路店', c: '--action', d: '', mk: 'circle', v: [4.9, 4.2, 3.6, 4.8, 3.4, 4.5] },
      { n: '徐汇滨江店', c: '--accent', d: 'dash', mk: 'square', v: [4.3, 4.8, 4.7, 3.9, 3.8, 3.6] },
      { n: '浦东世纪店', c: '--info', d: 'dot', mk: 'diamond', v: [3.9, 3.7, 4.1, 4.4, 4.6, 4.2] }
    ];
    const on = [true, true, true]; let ax = 0;
    lg.innerHTML = S.map((s, i) => `<button aria-pressed="true" data-i="${i}"><i style="--c:var(${s.c})" data-d="${s.d}"></i>${s.n}</button>`).join('');
    const text = () => `<b>${DIM[ax]}</b> <span>${S.map((s, i) => on[i] ? `${s.n} ${s.v[ax].toFixed(1)}` : '').filter(Boolean).join(' ')} 分</span>`;
    const marker = (ctx, mk, x, y, r) => { ctx.beginPath(); if (mk === 'circle') ctx.arc(x, y, r, 0, 7); else if (mk === 'square') ctx.rect(x - r, y - r, 2 * r, 2 * r); else { ctx.moveTo(x, y - r - 1); ctx.lineTo(x + r + 1, y); ctx.lineTo(x, y + r + 1); ctx.lineTo(x - r - 1, y); ctx.closePath(); } };
    const draw = () => {
      const { ctx, w, h } = fit(cv), cx = w / 2, cy = h / 2 + 2, R = Math.min(w / 2 - 50, h / 2 - 34), n = DIM.length, ang = i => -Math.PI / 2 + i * 2 * Math.PI / n, pt = (i, v) => [cx + Math.cos(ang(i)) * R * v / 5, cy + Math.sin(ang(i)) * R * v / 5];
      for (let k = 1; k <= 5; k++) { ctx.beginPath(); for (let i = 0; i < n; i++) { const [x, y] = pt(i, k); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); } ctx.closePath(); ctx.strokeStyle = css(k === 5 ? '--line-strong' : '--line'); ctx.lineWidth = 1; ctx.setLineDash([]); ctx.stroke(); }
      for (let i = 0; i < n; i++) { const [x, y] = pt(i, 5); ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, y); ctx.strokeStyle = css(i === ax ? '--ink-3' : '--line'); ctx.lineWidth = i === ax ? 1.5 : 1; ctx.stroke(); }
            S.forEach((s, si) => {
        if (!on[si]) return; const col = css(s.c);
        ctx.beginPath(); s.v.forEach((v, i) => { const [x, y] = pt(i, v); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.closePath();
        ctx.globalAlpha = .09; ctx.fillStyle = col; ctx.fill(); ctx.globalAlpha = 1; ctx.setLineDash(s.d === 'dash' ? [7, 4] : s.d === 'dot' ? [2, 3] : []); ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke(); ctx.setLineDash([]);
        s.v.forEach((v, i) => { const [x, y] = pt(i, v); marker(ctx, s.mk, x, y, i === ax ? 5 : 3.4); ctx.fillStyle = i === ax ? col : css('--surface'); ctx.fill(); ctx.lineWidth = 2; ctx.strokeStyle = col; ctx.stroke(); });
      });
      ctx.textBaseline = 'middle'; DIM.forEach((d, i) => { const a = ang(i), x = cx + Math.cos(a) * (R + 20), y = cy + Math.sin(a) * (R + 18); ctx.font = font(14, i === ax ? 700 : 400); ctx.fillStyle = css(i === ax ? '--ink' : '--ink-2'); ctx.textAlign = Math.abs(Math.cos(a)) < .2 ? 'center' : Math.cos(a) > 0 ? 'left' : 'right'; ctx.fillText(d, x + (Math.abs(Math.cos(a)) < .2 ? 0 : Math.cos(a) > 0 ? -6 : 6), y); });
      read.innerHTML = text();
    };
    const info = () => { $('[data-dom]', root).innerHTML = DIM.map((d, i) => `<li>${d} ${S.map(s => `${s.n} ${s.v[i].toFixed(1)}`).join(' ')} 分</li>`).join(''); cv.setAttribute('aria-label', `三家门店服务评分雷达图 ${DIM.join(' ')} 满分 5 分`); };
    const pick = (x, y) => { const r = cv.getBoundingClientRect(), dx = x - r.left - r.width / 2, dy = y - r.top - r.height / 2 - 2; if (Math.hypot(dx, dy) < 16) return; const a = (Math.atan2(dy, dx) + Math.PI / 2 + 2 * Math.PI) % (2 * Math.PI); ax = Math.round(a / (2 * Math.PI / DIM.length)) % DIM.length; draw(); };
    cv.addEventListener('pointermove', e => pick(e.clientX, e.clientY)); cv.addEventListener('pointerdown', e => pick(e.clientX, e.clientY));
    cv.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key]; if (!d) return; e.preventDefault(); ax = (ax + d + DIM.length) % DIM.length; draw(); });
    lg.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; const i = +b.dataset.i; if (on[i] && on.filter(Boolean).length === 1) return; on[i] = !on[i]; b.setAttribute('aria-pressed', String(on[i])); draw(); });
    new ResizeObserver(draw).observe(cv); onTheme(draw); info(); draw();
  })();

  /* 023 价格数字：整数大、符号与小数小，千分位；选规格或切会员价时价格与划线价一起变 */
  (() => {
    const root = D('AP-DATA-023'), big = $('[data-v]', root), old = $('[data-o]', root), read = $('[data-read]', root), sw = $('.switch', root);
    const SP = [{ n: '9 枝', p: 159, o: 199 }, { n: '19 枝', p: 239, o: 299 }, { n: '33 枝', p: 398, o: 498 }];
    const fmt2 = v => v.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const html = v => { const [i, d] = fmt2(v).split('.'); return `<small class="dat-pc__s">¥</small><b class="dat-pc__i">${i}</b><small class="dat-pc__d">.${d}</small>`; };
    let k = 1;
    const paint = () => {
      const s = SP[k], member = sw.getAttribute('aria-checked') === 'true', p = member ? Math.round(s.p * 90) / 100 : s.p;
      big.innerHTML = html(p); old.textContent = '¥' + fmt2(s.o); read.innerHTML = `<b>${s.n}${member ? ' 会员价' : ''}</b> ¥${fmt2(p)} 比原价省 ¥${fmt2(s.o - p)}`;
    };
    seg(root, key => { k = +key; paint(); }); sw.addEventListener('lz:toggle', paint); paint();
  })();

  /* 024 堆叠条形：金额与占比两种显示，图例可关某个品类；悬浮、焦点、点按都在下方读数 */
  (() => {
    const root = D('AP-DATA-024'), chart = $('[data-chart]', root), lg = $('[data-lg]', root), read = $('.dat-read', root);
    const CAT = [['鲜花', 'var(--action)'], ['绿植', 'var(--accent)'], ['礼盒', 'var(--info)'], ['花器', 'color-mix(in srgb, var(--ink-3) 70%, var(--surface))']];
    const ST = [['建国路店', [42600, 15800, 11200, 6400]], ['徐汇滨江店', [31500, 18900, 8300, 5300]], ['浦东世纪店', [35400, 12100, 15800, 4700]]];
    const on = [true, true, true, true]; let mode = 'abs', sel = [0, 0];
    lg.innerHTML = CAT.map((c, i) => `<button aria-pressed="true" data-i="${i}"><i style="--c:${c[1]}"></i>${c[0]}</button>`).join('');
    chart.innerHTML = ST.map((s, r) => `<div class="dat-sb__r"><div class="dat-sb__h"><span>${s[0]}</span><b data-t></b></div><div class="dat-sb__bar">${CAT.map((c, i) => `<button class="dat-sb__s" style="--c:${c[1]}" data-r="${r}" data-i="${i}" aria-pressed="false"></button>`).join('')}</div></div>`).join('');
    const segs = $$('.dat-sb__s', chart), tot = r => ST[r][1].reduce((a, v, i) => a + (on[i] ? v : 0), 0);
    const txt = (r, i) => `${ST[r][0]} ${CAT[i][0]} ${nf(ST[r][1][i])} 元 占该店 ${Math.round(ST[r][1][i] / ST[r][1].reduce((a, v) => a + v, 0) * 100)}%`;
    const paint = () => {
      const max = Math.max(...ST.map((_, r) => tot(r)));
      segs.forEach(b => { const r = +b.dataset.r, i = +b.dataset.i, v = on[i] ? ST[r][1][i] : 0; b.style.setProperty('--w', (mode === 'abs' ? v / max : v / tot(r)) * 100 + '%'); b.disabled = !on[i]; b.setAttribute('aria-label', txt(r, i)); b.setAttribute('aria-pressed', String(r === sel[0] && i === sel[1])); });
      $$('[data-t]', chart).forEach((el, r) => { el.textContent = `${nf(tot(r))} 元`; });
      read.innerHTML = `<b>${ST[sel[0]][0]} ${CAT[sel[1]][0]}</b> ${nf(ST[sel[0]][1][sel[1]])} 元 占该店 ${Math.round(ST[sel[0]][1][sel[1]] / ST[sel[0]][1].reduce((a, v) => a + v, 0) * 100)}%`;
    };
    const pick = b => { sel = [+b.dataset.r, +b.dataset.i]; paint(); };
    segs.forEach(b => { b.addEventListener('click', () => pick(b)); b.addEventListener('focus', () => pick(b)); b.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse' && !b.disabled) pick(b); }); });
    lg.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; const i = +b.dataset.i; if (on[i] && on.filter(Boolean).length === 1) return; on[i] = !on[i]; b.setAttribute('aria-pressed', String(on[i])); if (!on[sel[1]]) sel[1] = on.indexOf(true); paint(); });
    seg(root, k => { mode = k; paint(); }); paint();
  })();

  /* 025 迷你柱形：每行一个画布，指针或方向键选某一天，共用下方读数 */
  (() => {
    const root = D('AP-DATA-025'), list = $('[data-list]', root), read = $('.dat-read', root);
    const days = Array.from({ length: 7 }, (_, i) => '周' + WKN[new Date(2026, 10, 3 + i).getDay()]);
    const MS = [
      { n: '订单量', u: '单', v: [158, 171, 166, 182, 205, 236, 168], prev: 1190 },
      { n: '销售额', u: '元', v: [4120, 4380, 4260, 5090, 6040, 7140, 5390], prev: 34680 },
      { n: '新增会员', u: '人', v: [6, 7, 5, 8, 10, 13, 9], prev: 62 }
    ];
    list.innerHTML = MS.map(m => { const s = m.v.reduce((a, n) => a + n, 0), d = Math.round((s - m.prev) / m.prev * 100); return `<div class="dat-mb__r"><div><p class="dat-mb__n">${m.n}</p><p class="dat-mb__v"><span>${nf(s)}</span><small>${m.u}</small></p><p class="stat__delta" data-tone="${d >= 0 ? 'up' : 'down'}">较前七天 ${d >= 0 ? '增长 ' : '下降 '}${Math.abs(d)}%</p></div><canvas role="img" tabindex="0" aria-label="${m.n}近七天柱形图 单位${m.u}"></canvas><ul class="sr-only">${m.v.map((n, i) => `<li>${days[i]} ${nf(n)} ${m.u}</li>`).join('')}</ul></div>`; }).join('');
    const cvs = $$('canvas', list), act = MS.map(m => m.v.length - 1);
    const draw = i => {
      const { ctx, w, h } = fit(cvs[i]), v = MS[i].v, max = Math.max(...v), gap = 5, bw = (w - gap * (v.length - 1)) / v.length;
      v.forEach((n, k) => { const bh = Math.max(3, (h - 4) * n / max), x = k * (bw + gap), y = h - bh; ctx.beginPath(); ctx.roundRect(x, y, bw, bh, [4, 4, 1, 1]); ctx.fillStyle = k === act[i] ? css('--action') : mixc('--action', 22, css('--surface')); ctx.fill(); });
    };
    const say = i => { read.innerHTML = `<b>${MS[i].n} ${days[act[i]]}</b> ${nf(MS[i].v[act[i]])} ${MS[i].u}`; };
    const set = (i, k) => { MS.forEach((_, j) => { if (j !== i) { act[j] = MS[j].v.length - 1; draw(j); } }); act[i] = clamp(k, 0, 6); draw(i); say(i); };
    cvs.forEach((cv, i) => {
      const pick = x => { const r = cv.getBoundingClientRect(); set(i, Math.floor((x - r.left) / r.width * 7)); };
      cv.addEventListener('pointermove', e => pick(e.clientX)); cv.addEventListener('pointerdown', e => pick(e.clientX));
      cv.addEventListener('keydown', e => { const d = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (!d) return; e.preventDefault(); set(i, act[i] + d); });
      new ResizeObserver(() => draw(i)).observe(cv);
    });
    onTheme(() => cvs.forEach((_, i) => draw(i))); cvs.forEach((_, i) => draw(i)); say(0);
  })();

  /* 026 趋势箭头：好坏看指标性质，退款率下降是好事；持平用横线，箭头翻转带过渡 */
  (() => {
    const root = D('AP-DATA-026'), list = $('[data-list]', root), read = $('.dat-read', root);
    const M = [
      { n: '订单量', u: '单', v: 1286, f: nf, p: { mom: 1190, yoy: 1090 }, good: 1 },
      { n: '销售额', u: '元', v: 36420, f: nf, p: { mom: 34680, yoy: 32500 }, good: 1 },
      { n: '客单价', u: '元', v: 28.3, f: n => n.toFixed(1), p: { mom: 29.1, yoy: 29.8 }, good: 1 },
      { n: '退款率', u: '%', v: 2.1, f: n => n.toFixed(1), p: { mom: 2.6, yoy: 1.8 }, good: -1, rate: 1 },
      { n: '会员评分', u: '分', v: 4.8, f: n => n.toFixed(1), p: { mom: 4.8, yoy: 4.7 }, good: 1 }
    ];
    let k = 'mom', sel = 0;
    const calc = m => { const p = m.p[k], d = m.v - p, pc = d / p * 100, flat = m.rate ? Math.abs(d) < .05 : Math.abs(pc) < .5, dir = flat ? 'flat' : d > 0 ? 'up' : 'down'; return { d, pc, dir, tone: flat ? '' : (d * m.good > 0 ? 'good' : 'bad'), txt: flat ? '持平' : m.rate ? `${d > 0 ? '上升' : '下降'} ${Math.abs(d).toFixed(1)} 个百分点` : `${d > 0 ? '增长' : '下降'} ${Math.abs(Math.round(pc))}%` }; };
    list.innerHTML = M.map((m, i) => `<button class="dat-ta__r" data-i="${i}" aria-pressed="false"><span class="dat-ta__n">${m.n}</span><span class="dat-ta__v">${m.f(m.v)}<small>${m.u}</small></span><span class="dat-ta__m"><i class="dat-ta__a"></i><span></span></span></button>`).join('');
    const rows = $$('.dat-ta__r', list);
    const paint = () => {
      M.forEach((m, i) => { const c = calc(m), r = rows[i], mk = $('.dat-ta__m', r); mk.dataset.t = c.tone; $('.dat-ta__a', mk).dataset.d = c.dir; $('span', mk).textContent = c.txt; r.setAttribute('aria-label', `${m.n} ${m.f(m.v)}${m.u} ${c.txt}`); r.setAttribute('aria-pressed', String(i === sel)); });
      const m = M[sel], c = calc(m), lab = k === 'mom' ? '上周' : '去年同期', dd = m.rate ? Math.abs(c.d).toFixed(1) + ' 个百分点' : m.f(Math.abs(c.d)) + ' ' + m.u;
      read.innerHTML = `<b>${m.n}</b> 本期 ${m.f(m.v)} ${m.u} ${lab} ${m.f(m.p[k])} ${m.u} ${c.dir === 'flat' ? '无变化' : (c.d > 0 ? '多 ' : '少 ') + dd}`;
    };
    rows.forEach((r, i) => r.addEventListener('click', () => { sel = i; paint(); }));
    seg(root, key => { k = key; paint(); }); paint();
  })();

  /* 027 周日历条：横向滑动或点两侧箭头换周，方向键逐日移动；休息日不带圆点 */
  (() => {
    const root = D('AP-DATA-027'), strip = $('[data-strip]', root), title = $('[data-title]', root), list = $('[data-list]', root), read = $('.dat-read', root), prev = $('[data-prev]', root), next = $('[data-next]', root);
    const NOW = new Date(2026, 10, 9, 14, 0), WEEKS = 3, addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
    const kk = d => `${d.getMonth() + 1}-${d.getDate()}`;
    const EV = {
      '11-2': [['09:00', '花材到货验收']], '11-3': [['14:00', '绿植养护上门']], '11-5': [['10:00', '花艺沙龙', 6]], '11-7': [['11:00', '婚礼花艺试做', 2]],
      '11-9': [['09:30', '花材到货验收'], ['15:00', '会员花束定制', 1]], '11-10': [['14:00', '企业订花配送', 4]], '11-12': [['10:00', '花艺沙龙', 6], ['14:30', '鲜花订阅配送', 3]], '11-14': [['11:00', '婚礼花艺试做', 2]], '11-15': [['10:00', '亲子插花课', 8]],
      '11-16': [['09:00', '花材到货验收']], '11-18': [['14:00', '绿植养护上门']], '11-19': [['10:00', '花艺沙龙', 5]], '11-21': [['15:00', '生日花束定制', 1]], '11-22': [['10:00', '亲子插花课', 8]]
    };
    const REST = new Set(['11-11', '11-17']);
    let wk = 1, sel = new Date(2026, 10, 12);
    const days = () => Array.from({ length: 7 }, (_, i) => new Date(2026, 10, 2 + wk * 7 + i));
    const detail = () => {
      const ev = EV[kk(sel)] || [], rest = REST.has(kk(sel));
      read.innerHTML = `<b>${sel.getMonth() + 1}月${sel.getDate()}日 周${WKN[sel.getDay()]}</b> ${rest ? '休息日' : '排期 ' + ev.length + ' 项'}`;
      list.innerHTML = rest ? '<p class="dat-cal__e">休息日没有排期</p>' : ev.map(([t, n, p]) => { const at = new Date(sel.getFullYear(), sel.getMonth(), sel.getDate(), +t.slice(0, 2), +t.slice(3)), done = at < NOW; return `<div class="dat-cal__r"><i data-t="a"></i><span class="dat-cal__t">${t}</span><span class="one-line">${n}${p ? ' ' + p + ' 人' : ''}</span><span class="dat-cal__s"${done ? ' data-s="done"' : ''}>${done ? '已完成' : '待开始'}</span></div>`; }).join('') || '<p class="dat-cal__e">当日没有排期</p>';
    };
    const render = () => {
      const ds = days(); title.textContent = `${ds[0].getMonth() + 1}月${ds[0].getDate()}日至${ds[6].getMonth() + 1}月${ds[6].getDate()}日`; prev.disabled = wk <= 0; next.disabled = wk >= WEEKS - 1;
      strip.innerHTML = ds.map(d => { const k = kk(d), n = (EV[k] || []).length, on = d.toDateString() === sel.toDateString(), past = d < new Date(NOW.getFullYear(), NOW.getMonth(), NOW.getDate()), rest = REST.has(k);
        return `<button class="dat-wk__d" data-t="${d.getTime()}" aria-pressed="${on}" tabindex="${on ? 0 : -1}"${d.toDateString() === NOW.toDateString() ? ' aria-current="date"' : ''}${past ? ' data-past' : ''} aria-label="${d.getMonth() + 1}月${d.getDate()}日 周${WKN[d.getDay()]}${rest ? ' 休息日' : n ? ' 排期 ' + n + ' 项' : ' 无排期'}"><span class="dat-wk__w">${WKN[d.getDay()]}</span><span class="dat-cal__n">${d.getDate()}</span>${rest ? '<span class="dat-wk__rest">休</span>' : `<span class="dat-cal__dots">${'<i data-t="a"></i>'.repeat(Math.min(n, 3))}</span>`}</button>`; }).join('');
      detail();
    };
    const move = (dir, anim) => { const nw = clamp(wk + dir, 0, WEEKS - 1); if (nw === wk) return; wk = nw; sel = addDays(sel, dir * 7); render(); if (anim && !Lz.reduce) strip.animate([{ transform: `translateX(${dir * 28}px)`, opacity: .2 }, { transform: 'none', opacity: 1 }], { duration: 220, easing: 'cubic-bezier(.22,1,.36,1)' }); };
    const choose = (t, focus) => { sel = new Date(+t); $$('.dat-wk__d', strip).forEach(b => { const on = +b.dataset.t === +t; b.setAttribute('aria-pressed', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); }); detail(); };
    let sx = 0, sy = 0, swiped = false;
    strip.addEventListener('pointerdown', e => { sx = e.clientX; sy = e.clientY; swiped = false; });
    strip.addEventListener('pointerup', e => { const dx = e.clientX - sx, dy = e.clientY - sy; if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) { swiped = true; move(dx < 0 ? 1 : -1, true); } });
    strip.addEventListener('click', e => { if (swiped) { swiped = false; return; } const b = e.target.closest('.dat-wk__d'); if (b) choose(b.dataset.t); });
    strip.addEventListener('keydown', e => {
      const d = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (!d) return; e.preventDefault();
      const t = addDays(sel, d), w2 = Math.floor(Math.round((t - new Date(2026, 10, 2)) / 864e5) / 7); if (w2 < 0 || w2 > WEEKS - 1) return;
      if (w2 !== wk) { wk = w2; sel = t; render(); $('[aria-pressed="true"]', strip).focus(); } else choose(t.getTime(), true);
    });
    prev.addEventListener('click', () => move(-1, true)); next.addEventListener('click', () => move(1, true)); render();
  })();

  /* 028 活动圆环：三圈同心，满一圈后继续绕第二圈并显示真实百分比；点圈、图例或方向键选中一项 */
  (() => {
    const root = D('AP-DATA-028'), cv = $('canvas', root), read = $('.dat-read', root), lg = $('[data-lg]', root), addB = $('[data-add]', root);
    const START = [['订单量', '单', 36, 50, '--action'], ['销售额', '元', 6840, 9000, '--accent'], ['新增会员', '人', 12, 10, '--info']];
    const R = START.map(s => ({ n: s[0], u: s[1], v: s[2], g: s[3], c: s[4] })); let sel = 0, k = 0;
    lg.innerHTML = R.map((r, i) => `<button aria-pressed="${i === 0}" data-i="${i}"><span class="dat-act__k"><i style="--c:var(${r.c})"></i>${r.n}</span><b></b><small></small></button>`).join('');
    const bs = $$('button', lg), pc = r => r.v / r.g;
    const say = () => { const r = R[sel], p = Math.round(pc(r) * 100); read.innerHTML = `<b>${r.n}</b> ${nf(r.v)} ${r.u} 目标 ${nf(r.g)} ${r.u} ${r.v >= r.g ? (r.v > r.g ? '超出 ' + nf(r.v - r.g) + ' ' + r.u + ' ' : '') + '达成 ' + p + '%' : '完成 ' + p + '% 还差 ' + nf(r.g - r.v) + ' ' + r.u}`; };
    const text = () => { R.forEach((r, i) => { $('b', bs[i]).textContent = Math.round(pc(r) * 100) + '%'; $('small', bs[i]).textContent = `${nf(r.v)} / ${nf(r.g)} ${r.u}`; bs[i].setAttribute('aria-pressed', String(i === sel)); }); cv.setAttribute('aria-label', '门店日目标同心圆环 ' + R.map(r => `${r.n} ${nf(r.v)} ${r.u} 目标 ${nf(r.g)} ${r.u} 完成 ${Math.round(pc(r) * 100)}%`).join(' ')); addB.disabled = R[0].v >= 99; say(); };
    const draw = () => {
      const { ctx, w, h } = fit(cv), cx = w / 2, cy = h / 2, lw = 13, rad = [62, 45, 28]; ctx.lineCap = 'round';
      R.forEach((r, i) => {
        const col = css(r.c), f = k * pc(r), dim = i !== sel ? .38 : 1;
