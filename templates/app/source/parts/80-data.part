        <div class="seg" data-seg="dat-rank" aria-label="排序指标">
          <button class="seg__item" data-key="qty" aria-selected="true">销量</button>
          <button class="seg__item" data-key="amt" aria-selected="false">销售额</button>
        </div>
      </div>
      <div class="dat-rank" data-list></div>
      <p class="dat-read" role="status"></p>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-DATA-010" data-name="迷你趋势卡" data-cat="DATA">
