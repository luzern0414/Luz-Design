<article class="demo" data-cid="AP-FEED-026" data-name="按钮成功态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">按钮成功态</span></div>
  <p class="demo__note">适合：保存、提交按钮从加载到完成的原位反馈</p>
  <div class="demo__stage">
    <div class="fed-center">
      <button class="btn btn--primary btn--lg fed-save"><img src="../../kit/assets/line/check.webp" alt=""><span data-txt>保存修改</span></button>
    </div>
  </div>
</article>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const el = html => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };
  const root = document;

  /* 001 至 003 轻提示：点按钮弹出真实提示 */
  ['AP-FEED-001', 'AP-FEED-002', 'AP-FEED-003'].forEach(c => { const b = $('[data-fire]', D(c)); b.addEventListener('click', () => Lz.toast(b.dataset.fire, b.dataset.tone)); });

  /* 004、005 确认框：真实对话框与样张的按钮都写回结果 */
  const CONF = { 'AP-FEED-004': { title: '确认删除订单', ok: '删除', cancel: '取消', tone: 'danger' }, 'AP-FEED-005': { title: '确认提交订单', ok: '提交', cancel: '再看看', tone: 'primary' } };
  Object.entries(CONF).forEach(([cid, opts]) => {
    const r = D(cid), res = $('[data-res]', r);
    const set = ok => { res.textContent = ok ? '已确认' : '已取消'; res.dataset.tone = ok ? 'success' : ''; };
    $('[data-open]', r).addEventListener('click', async () => set(await Lz.confirm(opts)));
    $$('[data-pick]', r).forEach(b => b.addEventListener('click', () => set(b.dataset.pick === 'yes')));
  });

  /* 通用：带 data-toast 的按钮点击即提示 */
  document.addEventListener('click', e => { const t = e.target.closest('[data-cid^="AP-FEED"] [data-toast]'); if (t) Lz.toast(t.dataset.toast, 'success'); });

  /* 006 成功结果页：重播入场 */
  (() => { const r = D('AP-FEED-006'), ring = $('.fed-ring', r); $('[data-replay]', r).addEventListener('click', () => { ring.removeAttribute('data-play'); void ring.offsetWidth; ring.setAttribute('data-play', ''); }); })();

  /* 007 失败结果页：重新支付，成功后整页转为成功 */
  (() => {
    const r = D('AP-FEED-007'), card = $('.fed-result', r), ring = $('.fed-ring', r), btn = $('[data-retry]', r);
    btn.addEventListener('click', async () => {
      btn.classList.add('is-loading'); await sleep(1100); btn.classList.remove('is-loading');
      ring.dataset.tone = 'success'; $('img', ring).src = '../../kit/assets/line/check.webp'; ring.setAttribute('aria-label', '支付成功');
      $('h3', card).textContent = '支付成功'; $('[data-why]', card).previousElementSibling.textContent = '支付方式'; $('[data-why]', card).textContent = '微信支付';
      ring.removeAttribute('data-play'); void ring.offsetWidth; ring.setAttribute('data-play', ''); btn.hidden = true; $('.btn--ghost', card).textContent = '查看订单'; Lz.toast('支付成功', 'success');
    });
  })();

  /* 010 搜索无结果：输入即过滤，没有匹配才出现空态 */
  (() => {
    const r = D('AP-FEED-010'), inp = $('input', r), rows = $$('[data-w]', r), list = $('[data-list]', r), none = $('[data-none]', r);
    const run = () => { const q = inp.value.trim(); let n = 0; rows.forEach(x => { const ok = !q || x.dataset.w.includes(q) || x.textContent.includes(q); x.hidden = !ok; if (ok) n++; }); list.hidden = n === 0; none.hidden = n > 0; };
    inp.addEventListener('input', run); $('[data-clear]', r).addEventListener('click', () => { inp.value = ''; run(); inp.focus(); }); run();
  })();

  /* 011 网络异常：重新加载仍失败时给失败提示 */
  (() => { const b = $('[data-reload]', D('AP-FEED-011')); b.addEventListener('click', async () => { b.classList.add('is-loading'); await sleep(1100); b.classList.remove('is-loading'); Lz.toast('仍无法连接网络', 'danger'); }); })();

  /* 012 无权限：申请后按钮变为已申请 */
  (() => { const b = $('[data-ask]', D('AP-FEED-012')); b.addEventListener('click', () => { b.textContent = '已申请'; b.disabled = true; Lz.toast('申请已提交', 'success'); }); })();

  /* 015 加载中：到时间后切换为对勾 */
  (() => {
    const r = D('AP-FEED-015'), box = $('.fed-load', r), txt = $('[data-txt]', r); let t;
    const start = () => { clearTimeout(t); box.removeAttribute('data-done'); txt.textContent = '加载中'; t = setTimeout(() => { box.setAttribute('data-done', ''); txt.textContent = '已加载'; }, Lz.reduce ? 0 : 2200); };
    $('[data-replay]', r).addEventListener('click', start); start();
  })();

  /* 016 顶部进度条：分段推进到 100% 后淡出 */
  (() => {
    const r = D('AP-FEED-016'), bar = $('.fed-frame__bar', r), pct = $('[data-pct]', r), btn = $('[data-start]', r);
    const set = v => { bar.style.width = v + '%'; bar.setAttribute('aria-valuenow', v); pct.textContent = v >= 100 ? '加载完成' : `已加载 ${v}%`; };
    btn.addEventListener('click', async () => {
      btn.disabled = true; bar.style.transition = 'none'; set(0); void bar.offsetWidth; bar.style.transition = ''; bar.setAttribute('data-on', '');
      for (const v of [18, 42, 67, 85, 100]) { await sleep(420); set(v); }
      await sleep(520); bar.removeAttribute('data-on'); await sleep(260); bar.style.transition = 'none'; bar.style.width = '0%'; void bar.offsetWidth; bar.style.transition = ''; btn.disabled = false; btn.textContent = '再次加载';
    });
  })();

  /* 017 下拉刷新：拖动超过阈值松手刷新，也可点按钮 */
  (() => {
    const r = D('AP-FEED-017'), box = $('[data-ptr]', r), body = $('.fed-ptr__body', box), label = $('[data-label]', box), list = $('[data-list]', box), TH = 56;
    let y0 = null, pull = 0, busy = false, n = 0;
    const NEW = [['白郁金香', 'product-tulip-white', 179], ['向日葵花束', 'product-sunflower', 159], ['干花花瓶摆件', 'product-pampas-vase', 129]];
    const setY = v => body.style.setProperty('--y', v + 'px');
    async function refresh() {
      if (busy) return; busy = true; box.setAttribute('data-busy', ''); label.textContent = '正在刷新'; setY(TH);
      await sleep(1100);
      const [name, img, price] = NEW[n++ % NEW.length];
      const row = el(`<div class="row fed-ord fed-new"><img class="row__lead" src="../../kit/assets/photo/${img}.webp" alt=""><div class="row__main"><p class="row__title one-line">${name}</p><p class="row__meta">待付款</p></div><div class="row__trail"><span class="price"><small>¥</small>${price}</span><span>刚刚</span></div></div>`);
      list.prepend(row); if (list.children.length > 5) list.lastElementChild.remove();
      box.removeAttribute('data-busy'); label.textContent = '刷新完成'; await sleep(600); setY(0); busy = false; await sleep(300); label.textContent = '下拉刷新';
    }
    body.addEventListener('pointerdown', e => { if (busy) return; y0 = e.clientY; box.setAttribute('data-drag', ''); body.setPointerCapture(e.pointerId); });
    body.addEventListener('pointermove', e => { if (y0 == null) return; pull = Math.max(0, Math.min(88, (e.clientY - y0) * .55)); setY(pull); label.textContent = pull >= TH ? '松开刷新' : '下拉刷新'; });
    const end = () => { if (y0 == null) return; y0 = null; box.removeAttribute('data-drag'); if (pull >= TH) refresh(); else { setY(0); label.textContent = '下拉刷新'; } pull = 0; };
    body.addEventListener('pointerup', end); body.addEventListener('pointercancel', end);
    $('[data-refresh]', r).addEventListener('click', refresh);
  })();

  /* 018 加载更多：点按钮加载一页，到第二页后提示没有更多 */
  (() => {
    const r = D('AP-FEED-018'), list = $('[data-list]', r), more = $('[data-more]', r); let page = 0;
    const PAGES = [[['干花花瓶摆件', 'product-pampas-vase', '已完成', 129], ['多肉组合盆', 'product-succulent', '已完成', 89]], [['花礼盒', 'product-giftbox', '售后', 259]]];
    const btnHtml = '<button class="btn btn--text btn--sm" data-load>加载更多</button>';
    const bind = () => $('[data-load]', more).addEventListener('click', load);
    async function load() {
      more.innerHTML = '<span class="fed-spin fed-spin--sm"></span><span>加载中</span>'; more.classList.add('fed-more--busy'); await sleep(900);
      PAGES[page].forEach(([n, img, st, p]) => list.append(el(`<div class="row fed-ord fed-new"><img class="row__lead" src="../../kit/assets/photo/${img}.webp" alt=""><div class="row__main"><p class="row__title one-line">${n}</p><p class="row__meta">${st}</p></div><div class="row__trail"><span class="price"><small>¥</small>${p}</span></div></div>`)));
      page++; more.classList.remove('fed-more--busy');
      if (page >= PAGES.length) more.textContent = '没有更多了'; else { more.innerHTML = btnHtml; bind(); }
    }
    bind();
  })();

  /* 019 红点：点开后红点消失 */
  (() => {
    const r = D('AP-FEED-019'), items = $$('.fed-ico', r);
    items.forEach(b => b.addEventListener('click', () => { const d = $('.fed-dot', b); if (d && !d.hasAttribute('data-off')) { d.setAttribute('data-off', ''); b.setAttribute('aria-label', b.dataset.tip + ' 无新内容'); } }));
    $('[data-reset]', r).addEventListener('click', () => items.slice(0, 2).forEach(b => { const d = $('.fed-dot', b); d.removeAttribute('data-off'); b.setAttribute('aria-label', b.dataset.tip + ' 有新内容'); }));
  })();

  /* 020 数字角标：增减后重新弹入，零则隐藏，超过 99 显示 99+ */
  (() => {
    const r = D('AP-FEED-020'), items = $$('.fed-ico', r);
    const paint = (b, pop) => {
      const n = +b.dataset.n; let bd = $('.badge', b);
      if (n <= 0) { if (bd) bd.remove(); b.setAttribute('aria-label', b.dataset.tip + ' 无未读'); return; }
      if (!bd) { bd = el('<span class="badge"></span>'); b.append(bd); }
      bd.textContent = n > 99 ? '99+' : n; b.setAttribute('aria-label', `${b.dataset.tip} ${n} 条未读`);
      if (pop) { bd.style.animation = 'none'; void bd.offsetWidth; bd.style.animation = ''; }
    };
    $('[data-add]', r).addEventListener('click', () => items.forEach(b => { b.dataset.n = +b.dataset.n + 1; paint(b, true); }));
    $('[data-clear]', r).addEventListener('click', () => items.forEach(b => { b.dataset.n = 0; paint(b); }));
  })();

  /* 021 状态标签：推进订单状态，颜色跟着语义走 */
  (() => {
    const r = D('AP-FEED-021'), tag = $('[data-state]', r), S = [['待付款', 'warning'], ['待发货', 'info'], ['待收货', 'action'], ['已完成', 'success'], ['售后', 'danger']]; let i = 0;
    $('[data-next]', r).addEventListener('click', () => { i = (i + 1) % S.length; tag.textContent = S[i][0]; tag.dataset.tone = S[i][1]; });
  })();

  /* 022 状态点：点一行轮换状态 */
  (() => {
    const S = [['营业中', 'var(--success)'], ['备货中', 'var(--warning)'], ['已打烊', 'var(--ink-3)']];
    $$('.row', D('AP-FEED-022')).forEach(row => { row.tabIndex = 0; row.style.cursor = 'pointer'; const st = $('[data-st]', row); const go = () => { const i = (S.findIndex(s => s[0] === st.textContent) + 1) % S.length; st.textContent = S[i][0]; st.style.setProperty('--c', S[i][1]); }; row.addEventListener('click', go); row.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } }); });
  })();

  /* 023 状态条：切换类型，可关闭并重新显示 */
  (() => {
    const r = D('AP-FEED-023'), strip = $('.fed-strip', r), txt = $('[data-txt]', strip), act = $('[data-act]', strip), back = $('[data-back]', r);
    const T = { info: ['有 2 笔订单待付款', '去支付'], success: ['订单已提交成功', '查看'], warning: ['网络不稳定 部分内容较慢', '检查'], danger: ['网络已断开', '重试'] };
    r.addEventListener('lz:seg', e => { const k = e.detail.key; strip.dataset.tone = k; txt.textContent = T[k][0]; act.textContent = T[k][1]; strip.removeAttribute('data-gone'); back.hidden = true; });
    act.addEventListener('click', () => Lz.toast(act.textContent + '已处理', 'success'));
    $('[data-close]', strip).addEventListener('click', () => { strip.setAttribute('data-gone', ''); back.hidden = false; });
    $('[data-show]', back).addEventListener('click', () => { strip.removeAttribute('data-gone'); back.hidden = true; });
  })();

  /* 025 错误重试：失败 → 骨架 → 内容 */
  (() => {
    const r = D('AP-FEED-025'), fail = $('[data-fail]', r), load = $('[data-load]', r), ok = $('[data-ok]', r), back = $('[data-back]', r), reset = $('[data-reset]', r), btn = $('[data-retry]', r);
    btn.addEventListener('click', async () => { fail.hidden = true; load.hidden = false; await sleep(1200); load.hidden = true; ok.hidden = false; back.hidden = false; });
    reset.addEventListener('click', () => { ok.hidden = true; fail.hidden = false; back.hidden = true; });
  })();

  /* 026 按钮成功态：加载 → 已保存 → 复原 */
  (() => {
    const b = $('.fed-save', D('AP-FEED-026')), txt = $('[data-txt]', b);
    b.addEventListener('click', async () => {
      if (b.classList.contains('is-loading') || b.hasAttribute('data-ok')) return;
      b.classList.add('is-loading'); await sleep(1000); b.classList.remove('is-loading'); b.setAttribute('data-ok', ''); txt.textContent = '已保存'; await sleep(1800); b.removeAttribute('data-ok'); txt.textContent = '保存修改';
    });
  })();
})();
</script>

