<!-- cat: FEED | 反馈与状态 -->
<style>
  /* 反馈与状态组件专属样式：前缀 fed-。颜色只取令牌，字号只取字阶 */
  .fed-card { display: grid; gap: var(--s-3); padding: var(--s-4); }
  .fed-center { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-4) 0 var(--s-2); }
  .fed-bar { display: flex; align-items: center; justify-content: center; gap: var(--s-2); }
  .fed-after { margin-top: var(--s-3); }
  .fed-res .tag { background: var(--surface); }
  .fed-res .tag[data-tone] { background: var(--success-tint); }
  .fed-res { display: flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 28px; font-size: var(--fs-sm); color: var(--ink-2); }

  /* 轻提示样张：与真实提示同一套类，静态居中 */
  .fed-toast-sample { display: grid; justify-items: center; padding: var(--s-5) 0 var(--s-4); }
  .fed-toast-sample .toast { animation: none; }

  /* 确认框样张 */
  .fed-dlg { width: min(100%, 320px); padding: var(--s-5); background: var(--surface); border-radius: var(--r-xl); box-shadow: var(--elev-3); }
  .fed-dlg .dialog__acts { margin-top: var(--s-4); }

  /* 结果页 */
  .fed-result { display: grid; justify-items: center; gap: var(--s-2); padding: var(--s-4); text-align: center; }
  .fed-ring { display: grid; place-items: center; width: 76px; height: 76px; margin-bottom: var(--s-2); border-radius: 50%; background: var(--success); box-shadow: 0 0 0 8px var(--success-tint); transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .fed-ring img { width: 38px; height: 38px; filter: invert(1); }
  .fed-ring[data-tone="danger"] { background: var(--danger); box-shadow: 0 0 0 8px var(--danger-tint); }
  .fed-ring[data-play] { animation: fed-ring 640ms var(--ease-out) both; }
  .fed-ring[data-play] img { animation: lz-pop var(--dur-slow) var(--ease-spring) 140ms both; }
  @keyframes fed-ring { 0% { transform: scale(.5); opacity: 0; } 60% { transform: scale(1.06); opacity: 1; } 100% { transform: scale(1); } }
  .fed-result h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .fed-result .price { font-size: var(--fs-2xl); font-weight: 700; line-height: 1.2; }
  .fed-result__rows { width: 100%; margin-top: var(--s-3); padding: var(--s-1) var(--s-4); border-radius: var(--r-md); background: var(--zone); }
  .fed-result__rows div { display: flex; justify-content: space-between; gap: var(--s-3); min-height: 40px; align-items: center; font-size: var(--fs-sm); color: var(--ink-2); }
  .fed-result__rows div + div { border-top: 1px solid var(--line); }
  .fed-result__rows b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .fed-result .btn-group { flex-wrap: wrap; justify-content: center; margin-top: var(--s-3); }

  /* 空态：3D 图标加柔光底，标题加一个动作 */
  .fed-empty { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-5) var(--s-4) var(--s-4); text-align: center; }
  .fed-empty__art { position: relative; display: grid; place-items: center; width: 132px; height: 120px; }
  .fed-empty__art::before { content: ""; position: absolute; inset: 6px 10px 0; border-radius: 50%; background: radial-gradient(closest-side, var(--action-tint) 55%, transparent 100%); }
  .fed-empty__art::after { content: ""; position: absolute; bottom: 4px; width: 64px; height: 10px; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--ink) 16%, transparent), transparent); }
  .fed-empty__art img { position: relative; z-index: 1; width: 92px; height: 92px; object-fit: contain; filter: drop-shadow(0 8px 10px color-mix(in srgb, var(--ink) 14%, transparent)); }
  .fed-empty h3 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .fed-empty .search { width: 100%; text-align: left; }
  .fed-empty .btn { margin-top: var(--s-1); }
  .fed-list { width: 100%; text-align: left; }
  .fed-list.card { border: 0; border-radius: 0; background: none; box-shadow: none; }
  .fed-list .row { padding-inline: 0; }
  .fed-list .row + .row::before { left: 0; }

  /* 骨架：共用骨架在白卡上对比太弱，这里加深一档 */
  [data-cid^="AP-FEED"] .skel { background: linear-gradient(100deg, color-mix(in srgb, var(--action) 11%, var(--surface)) 30%, color-mix(in srgb, var(--action) 4%, var(--surface)) 50%, color-mix(in srgb, var(--action) 11%, var(--surface)) 70%) 0 0 / 200% 100%; animation: lz-shimmer 1.4s linear infinite; }
  /* 骨架 */
  .fed-skel-card { overflow: hidden; }
  .fed-skel-card .skel { border-radius: 0; }
  .fed-skel-card__body { display: grid; gap: var(--s-2); padding: var(--s-3); }
  .fed-skel-row { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; column-gap: var(--s-3); min-height: 72px; padding: var(--s-3) var(--s-4); }
  .fed-skel-row__main { display: grid; gap: var(--s-2); }

  /* 加载中 */
  .fed-spin { width: 36px; height: 36px; border-radius: 50%; border: 3px solid var(--action-edge); border-top-color: var(--action); animation: lz-spin .8s linear infinite; }
  .fed-spin--sm { width: 18px; height: 18px; border-width: 2px; }
  .fed-load { display: grid; justify-items: center; align-content: center; gap: var(--s-3); min-height: 96px; font-size: var(--fs-sm); color: var(--ink-2); }
  .fed-load__ok { display: none; width: 36px; height: 36px; place-items: center; border-radius: 50%; background: var(--success); }
  .fed-load__ok img { width: 20px; height: 20px; filter: invert(1); animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .fed-load[data-done] .fed-spin { display: none; }
  .fed-load[data-done] .fed-load__ok { display: grid; }

  /* 顶部进度条：贴着页面顶边 */
  .fed-frame { position: relative; overflow: hidden; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--elev-1); }
  .fed-frame__bar { position: absolute; z-index: 2; left: 0; top: 0; height: 3px; width: 0; border-radius: 0 3px 3px 0; background: var(--action); box-shadow: 0 0 8px color-mix(in srgb, var(--action) 60%, transparent); opacity: 0; transition: width var(--dur-slow) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .fed-frame__bar[data-on] { opacity: 1; }
  .fed-frame__body { display: grid; gap: var(--s-3); padding: var(--s-4); }

  /* 下拉刷新 */
  .fed-ptr { position: relative; overflow: hidden; border-radius: var(--r-lg); touch-action: none; user-select: none; -webkit-user-select: none; }
  .fed-ptr__hint { position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: center; justify-content: center; gap: var(--s-2); height: 56px; font-size: var(--fs-sm); color: var(--ink-2); }
  .fed-ptr__hint .fed-spin { display: none; }
  .fed-ptr[data-busy] .fed-spin { display: block; }
  .fed-ptr__body { position: relative; transform: translateY(var(--y, 0px)); transition: transform var(--dur-base) var(--ease-out); cursor: grab; }
  .fed-ptr[data-drag] .fed-ptr__body { transition: none; cursor: grabbing; }
  .fed-grip { width: 36px; height: 4px; margin: 0 auto var(--s-2); border-radius: 4px; background: var(--line-strong); }
  .fed-ord { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; column-gap: var(--s-3); }
  .fed-ord .row__lead { width: 44px; height: 44px; }
  .fed-new { animation: lz-rise var(--dur-slow) var(--ease-out) both; }
  .fed-more--busy { grid-auto-flow: column; justify-content: center; gap: var(--s-2); }

  /* 角标 */
  .fed-icons { display: flex; align-items: center; justify-content: center; gap: var(--s-6); padding: var(--s-4) 0; }
  .fed-ico { position: relative; display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); transition: transform var(--dur-instant) var(--ease-out); }
  .fed-ico:active { transform: scale(.94); }
  .fed-ico img { width: 28px; height: 28px; }
  .fed-ico .badge { top: -6px; right: -6px; border: 2px solid var(--bg); box-sizing: content-box; }
  .fed-dot { position: absolute; top: 6px; right: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 2px var(--surface); transition: transform var(--dur-base) var(--ease-spring), opacity var(--dur-base) var(--ease-out); }
  .fed-dot[data-off] { transform: scale(0); opacity: 0; }

  /* 状态标签 */
  .fed-tags { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-1); }
  .fed-tags .tag { justify-content: center; height: 28px; padding: 0 var(--s-1); font-size: var(--fs-sm); border-radius: 9px; }
  .fed-tags .tag[data-tone="action"], .fed-ord2 .tag[data-tone="action"] { background: var(--action-edge); }
  .fed-ord2 { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); }
  .fed-ord2 .tag { height: 28px; padding: 0 var(--s-3); font-size: var(--fs-sm); border-radius: 9px; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  .fed-dotline { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .fed-dotline::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--ink-3)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c, var(--ink-3)) 18%, transparent); }

  /* 状态条 */
  .fed-strip { display: grid; grid-template-columns: 1fr auto auto; align-items: center; column-gap: var(--s-2); min-height: 48px; padding: 0 var(--s-2) 0 var(--s-4); border-radius: var(--r-md); font-size: var(--fs-sm); font-weight: 600; background: var(--info-tint); color: var(--info); transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  .fed-strip[data-tone="success"] { background: var(--success-tint); color: var(--success); }
  .fed-strip[data-tone="warning"] { background: var(--warning-tint); color: var(--warning); }
  .fed-strip[data-tone="danger"] { background: var(--danger-tint); color: var(--danger); }
  .fed-strip .btn--text { color: inherit; font-size: var(--fs-sm); }
  .fed-strip .ibtn { width: 36px; height: 36px; }
  .fed-strip .ibtn img { width: 18px; height: 18px; }
  .fed-strip[data-gone] { display: none; }

  /* 错误重试 */
  .fed-err { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-5) var(--s-4); text-align: center; }
  .fed-err h3 { font-size: var(--fs-md); font-weight: 600; }
  .fed-err__mark { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--danger-tint); }
  .fed-err__mark img { width: 24px; height: 24px; }

  /* 按钮成功态 */
  .fed-save { min-width: 148px; transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
  .fed-save[data-ok] { background: var(--success); box-shadow: 0 6px 16px color-mix(in srgb, var(--success) 28%, transparent); pointer-events: none; }
  .fed-save [data-txt] { display: contents; }
  .fed-save img { display: none; width: 20px; height: 20px; filter: invert(1); }
  .fed-save[data-ok] img { display: block; animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
</style>

<article class="demo" data-cid="AP-FEED-001" data-name="成功轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">成功轻提示</span></div>
  <p class="demo__note">适合：保存、领取、加购后的即时反馈</p>
  <div class="demo__stage is-tint">
    <div class="fed-toast-sample"><div class="toast" data-tone="success">已加入购物车</div></div>
    <div class="fed-bar"><button class="btn btn--primary btn--sm" data-fire="已加入购物车" data-tone="success">弹出提示</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-002" data-name="失败轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">失败轻提示</span></div>
  <p class="demo__note">适合：网络与提交失败，不抢焦点不挡操作</p>
  <div class="demo__stage is-tint">
    <div class="fed-toast-sample"><div class="toast" data-tone="danger">网络异常 请稍后重试</div></div>
    <div class="fed-bar"><button class="btn btn--primary btn--sm" data-fire="网络异常 请稍后重试" data-tone="danger">弹出提示</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-003" data-name="普通轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">普通轻提示</span></div>
  <p class="demo__note">适合：复制、切换等中性的轻量结果</p>
  <div class="demo__stage is-tint">
    <div class="fed-toast-sample"><div class="toast">已复制订单号</div></div>
    <div class="fed-bar"><button class="btn btn--primary btn--sm" data-fire="已复制订单号" data-tone="neutral">弹出提示</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-004" data-name="危险确认框" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">危险确认框</span></div>
  <p class="demo__note">适合：删除、取消订单等不可撤回的操作</p>
  <div class="demo__stage is-tint">
    <div class="fed-center">
      <div class="fed-dlg"><h4 class="dialog__title">确认删除订单</h4><div class="dialog__acts"><button class="btn btn--ghost" data-pick="no">取消</button><button class="btn btn--danger" data-pick="yes">删除</button></div></div>
      <div class="fed-res" role="status">结果<span class="tag" data-res>待确认</span></div>
      <button class="btn btn--secondary btn--sm" data-open>弹出确认框</button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-005" data-name="普通确认框" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">普通确认框</span></div>
  <p class="demo__note">适合：提交订单等需要二次确认的操作</p>
  <div class="demo__stage is-tint">
    <div class="fed-center">
      <div class="fed-dlg"><h4 class="dialog__title">确认提交订单</h4><div class="dialog__acts"><button class="btn btn--ghost" data-pick="no">再看看</button><button class="btn btn--primary" data-pick="yes">提交</button></div></div>
      <div class="fed-res" role="status">结果<span class="tag" data-res>待确认</span></div>
      <button class="btn btn--secondary btn--sm" data-open>弹出确认框</button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-006" data-name="成功结果页" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">成功结果页</span></div>
  <p class="demo__note">适合：支付、提交完成后的独立结果页</p>
  <div class="demo__stage">
    <div class="card fed-result">
      <div class="fed-ring" data-play role="img" aria-label="支付成功"><img src="../../kit/assets/line/check.webp" alt=""></div>
      <h3>支付成功</h3>
      <p class="price"><small>¥</small>199.00</p>
      <div class="fed-result__rows"><div><span>订单编号</span><b>20817365</b></div><div><span>配送门店</span><b>建国路店</b></div></div>
      <div class="btn-group"><button class="btn btn--primary" data-toast="已打开订单">查看订单</button><button class="btn btn--ghost" data-toast="已返回首页">返回首页</button></div>
    </div>
    <div class="fed-bar fed-after"><button class="btn btn--text btn--sm" data-replay>重播</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-007" data-name="失败结果页" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">失败结果页</span></div>
  <p class="demo__note">适合：支付、提交失败后，保留订单并可重试</p>
  <div class="demo__stage">
    <div class="card fed-result" data-fail>
      <div class="fed-ring" data-tone="danger" data-play role="img" aria-label="支付失败"><img src="../../kit/assets/line/close.webp" alt=""></div>
      <h3>支付失败</h3>
      <p class="price"><small>¥</small>199.00</p>
      <div class="fed-result__rows"><div><span>订单编号</span><b>20817365</b></div><div><span>失败原因</span><b data-why>银行卡余额不足</b></div></div>
      <div class="btn-group"><button class="btn btn--primary" data-retry>重新支付</button><button class="btn btn--ghost" data-toast="订单已保留">稍后再付</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-008" data-name="订单空态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">订单空态</span></div>
  <p class="demo__note">适合：订单列表没有记录时，给出去选花的动作</p>
  <div class="demo__stage">
    <div class="card fed-empty"><div class="fed-empty__art"><img data-ic="bag" src="../../kit/assets/icons/flat/bag.webp" alt=""></div><h3>暂无订单</h3><button class="btn btn--primary btn--pill" data-toast="已前往挑选">去选花</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-009" data-name="购物车空态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">购物车空态</span></div>
  <p class="demo__note">适合：购物车清空后，引导回到商品</p>
  <div class="demo__stage">
    <div class="card fed-empty"><div class="fed-empty__art"><img data-ic="cart" src="../../kit/assets/icons/flat/cart.webp" alt=""></div><h3>购物车是空的</h3><button class="btn btn--primary btn--pill" data-toast="已前往商品">去逛逛</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-010" data-name="搜索无结果" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">搜索无结果</span></div>
  <p class="demo__note">适合：关键词没有匹配商品，可一键清除搜索</p>
  <div class="demo__stage">
    <div class="card fed-empty" data-search>
      <label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" value="百合" placeholder="搜索商品" aria-label="搜索商品" autocomplete="off"></label>
      <div class="fed-list card list" data-list hidden>
        <div class="row" data-w="红玫瑰 花束"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title one-line">红玫瑰花束</p></div><span class="price"><small>¥</small>199</span></div>
        <div class="row" data-w="粉芍药 花束"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="row__main"><p class="row__title one-line">粉芍药花束</p></div><span class="price"><small>¥</small>239</span></div>
        <div class="row" data-w="向日葵 花束"><img class="row__lead" src="../../kit/assets/photo/product-sunflower.webp" alt=""><div class="row__main"><p class="row__title one-line">向日葵花束</p></div><span class="price"><small>¥</small>159</span></div>
        <div class="row" data-w="多肉 盆栽"><img class="row__lead" src="../../kit/assets/photo/product-succulent.webp" alt=""><div class="row__main"><p class="row__title one-line">多肉组合盆</p></div><span class="price"><small>¥</small>89</span></div>
      </div>
      <div data-none class="fed-empty" style="padding:var(--s-2) 0 0"><div class="fed-empty__art"><img data-ic="seedling" src="../../kit/assets/icons/flat/seedling.webp" alt=""></div><h3>没有找到相关商品</h3><button class="btn btn--secondary btn--pill" data-clear>清除搜索</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-011" data-name="网络异常态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">网络异常态</span></div>
  <p class="demo__note">适合：整页或整块内容因断网无法加载</p>
  <div class="demo__stage">
    <div class="card fed-empty"><div class="fed-empty__art"><img data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""></div><h3>网络连接失败</h3><button class="btn btn--primary btn--pill" data-reload>重新加载</button></div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-012" data-name="无权限态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">无权限态</span></div>
  <p class="demo__note">适合：账号没有查看或操作该内容的权限</p>
  <div class="demo__stage">
    <div class="card fed-empty"><div class="fed-empty__art"><img data-ic="giftcard" src="../../kit/assets/icons/flat/giftcard.webp" alt=""></div><h3>暂无访问权限</h3><button class="btn btn--primary btn--pill" data-ask>申请权限</button></div>
