<article class="demo" data-cid="AP-FEED-032" data-name="浮动面板" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">浮动面板</span></div>
  <p class="demo__note">适合：地图或列表页底部可拖动停靠的信息面板</p>
  <div class="demo__stage">
    <div class="fedx-dock bg-leaves" data-dock>
      <button class="fedx-pin" data-k="0" style="left:24%;top:22%" aria-label="徐汇滨江店" aria-pressed="false" data-tip="徐汇滨江店"><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""></button>
      <button class="fedx-pin" data-k="1" style="left:62%;top:15%" aria-label="浦东世纪店" aria-pressed="false" data-tip="浦东世纪店"><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""></button>
      <button class="fedx-pin" data-k="2" style="left:42%;top:34%" aria-label="静安寺店" aria-pressed="false" data-tip="静安寺店"><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""></button>
      <button class="fedx-pin" data-k="3" style="left:80%;top:33%" aria-label="虹桥天地店" aria-pressed="false" data-tip="虹桥天地店"><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""></button>
      <section class="fedx-dock__panel" data-panel aria-label="附近门店">
        <div class="fedx-dock__top" data-top>
          <div class="fedx-dock__grip" role="slider" tabindex="0" aria-label="调整面板高度" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1" aria-valuetext="半屏" data-grip data-tip="拖动调整高度"><i></i></div>
          <div class="fedx-dock__head"><h3 class="card__title">附近门店</h3><span class="tag">4 家</span></div>
        </div>
        <div class="fedx-dock__list" data-list>
          <button class="row" data-k="0"><img class="avatar avatar--mark" src="../../kit/assets/marks/mark-004.webp" alt=""><div class="row__main"><p class="row__title one-line">徐汇滨江店</p><p class="row__meta one-line">距离 0.8 公里</p></div><span class="tag" data-tone="success">营业中</span></button>
          <button class="row" data-k="1"><img class="avatar avatar--mark" src="../../kit/assets/marks/mark-005.webp" alt=""><div class="row__main"><p class="row__title one-line">浦东世纪店</p><p class="row__meta one-line">距离 2.4 公里</p></div><span class="tag" data-tone="warning">备货中</span></button>
          <button class="row" data-k="2"><img class="avatar avatar--mark" src="../../kit/assets/marks/mark-006.webp" alt=""><div class="row__main"><p class="row__title one-line">静安寺店</p><p class="row__meta one-line">距离 3.1 公里</p></div><span class="tag" data-tone="success">营业中</span></button>
          <button class="row" data-k="3"><img class="avatar avatar--mark" src="../../kit/assets/marks/mark-007.webp" alt=""><div class="row__main"><p class="row__title one-line">虹桥天地店</p><p class="row__meta one-line">距离 5.6 公里</p></div><span class="tag">已打烊</span></button>
        </div>
      </section>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-033" data-name="滚动公告栏" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">滚动公告栏</span></div>
  <p class="demo__note">适合：首页顶部横向滚动的店铺公告，可暂停与关闭</p>
  <div class="demo__stage">
    <div class="fedx-nbw" data-nb>
      <div class="fedx-nb" role="region" aria-label="店铺公告" data-bar>
        <span class="tag">公告</span>
        <div class="fedx-nb__view" role="button" tabindex="0" aria-label="查看公告 春日鲜花节全场花束满 199 减 30 元" data-view>
          <div class="fedx-nb__track" data-track>
            <div class="fedx-nb__grp"><span>春日鲜花节 全场花束满 199 减 30 元</span><span>建国路店 20:00 提前打烊</span><span>荷兰郁金香已到店 限量 200 束</span></div>
            <div class="fedx-nb__grp" aria-hidden="true"><span>春日鲜花节 全场花束满 199 减 30 元</span><span>建国路店 20:00 提前打烊</span><span>荷兰郁金香已到店 限量 200 束</span></div>
          </div>
        </div>
        <button class="ibtn" data-pause aria-label="暂停滚动" data-tip="暂停滚动"><img src="../../kit/assets/line/pause.webp" alt=""></button>
        <button class="ibtn" data-close aria-label="关闭公告" data-tip="关闭公告"><img src="../../kit/assets/line/close.webp" alt=""></button>
      </div>
      <div class="seg seg--chips" data-seg="fedx-nsp" aria-label="滚动速度">
        <button class="seg__item" data-key="slow" aria-selected="false">慢速</button>
        <button class="seg__item" data-key="normal" aria-selected="true">常速</button>
        <button class="seg__item" data-key="fast" aria-selected="false">快速</button>
      </div>
      <div class="fed-bar" data-back hidden><button class="btn btn--secondary btn--sm" data-show>重新显示</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-034" data-name="图片失败占位" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">图片失败占位</span></div>
  <p class="demo__note">适合：图片未加载或失败时显示统一占位</p>
  <div class="demo__stage">
    <div class="card fed-card" data-ph>
      <div class="fedx-phs">
        <div class="fedx-ph" data-st="ok">
          <i class="fedx-ph__bg"></i>
          <img class="fedx-ph__pic" src="../../kit/assets/photo/product-rose-red.webp" alt="红玫瑰花束">
          <div class="fedx-ph__s" data-for="load"><span class="fed-spin fed-spin--sm"></span><span>加载中</span></div>
          <div class="fedx-ph__s" data-for="fail"><img class="fedx-ph__art" data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><span>加载失败</span><button class="btn btn--secondary btn--xs" data-retry>重新加载</button></div>
        </div>
        <div class="fedx-ph" data-st="load">
          <i class="fedx-ph__bg"></i>
          <img class="fedx-ph__pic" src="../../kit/assets/photo/product-peony-pink.webp" alt="粉芍药花束">
          <div class="fedx-ph__s" data-for="load"><span class="fed-spin fed-spin--sm"></span><span>加载中</span></div>
          <div class="fedx-ph__s" data-for="fail"><img class="fedx-ph__art" data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><span>加载失败</span><button class="btn btn--secondary btn--xs" data-retry>重新加载</button></div>
        </div>
        <div class="fedx-ph" data-st="fail">
          <i class="fedx-ph__bg"></i>
          <img class="fedx-ph__pic" src="../../kit/assets/photo/product-sunflower.webp" alt="向日葵花束">
          <div class="fedx-ph__s" data-for="load"><span class="fed-spin fed-spin--sm"></span><span>加载中</span></div>
          <div class="fedx-ph__s" data-for="fail"><img class="fedx-ph__art" data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><span>加载失败</span><button class="btn btn--secondary btn--xs" data-retry>重新加载</button></div>
        </div>
        <div class="fedx-ph" data-st="none">
          <i class="fedx-ph__bg"></i>
          <div class="fedx-ph__s" data-for="none"><img class="fedx-ph__art" data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""><span>暂无图片</span></div>
        </div>
      </div>
      <div class="fed-bar"><button class="btn btn--secondary btn--sm" data-all>重新加载全部</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-FEED-035" data-name="顶部消息通知条" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">顶部消息通知条</span></div>
  <p class="demo__note">适合：订单状态变化时从顶部短暂出现的通知条</p>
  <div class="demo__stage">
    <div class="fedx-nf" data-nf>
      <div class="card list">
        <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-sunflower.webp" alt=""><div class="row__main"><p class="row__title one-line">向日葵花束</p><p class="row__meta">订单 20817360</p></div><span class="tag" data-tone="success">已完成</span></div>
        <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title one-line">红玫瑰花束</p><p class="row__meta">订单 20817365</p></div><span class="tag" data-tone="warning" data-state>待付款</span></div>
        <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-succulent.webp" alt=""><div class="row__main"><p class="row__title one-line">多肉组合盆</p><p class="row__meta">订单 20817352</p></div><span class="tag" data-tone="success">已完成</span></div>
      </div>
      <div class="fedx-nf__slot" role="status" aria-live="polite" data-slot></div>
    </div>
    <div class="fed-bar fed-after fedx-wrap"><button class="btn btn--secondary btn--sm" data-fire="paid">付款成功</button><button class="btn btn--secondary btn--sm" data-fire="ship">商家发货</button><button class="btn btn--secondary btn--sm" data-fire="done">确认送达</button><button class="btn btn--text btn--sm" data-reset>重置</button></div>
  </div>
</article>

<style>
  /* 新增 027 至 035：前缀 fedx-。颜色只取令牌，字号只取字阶 */
  .fedx-wrap { flex-wrap: wrap; }

  /* 027 图片预览：缩略图九宫格，点开后在舞台内全屏浏览 */
  .fedx-gv { position: relative; display: grid; gap: var(--s-1); }
  .fedx-gv__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); }
  .fedx-gv__th { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--r-md); background: var(--zone); transition: transform var(--dur-quick) var(--ease-out); }
  .fedx-gv__th img { width: 100%; height: 100%; object-fit: cover; }
  .fedx-gv__th:active { transform: scale(.96); }
  .fedx-vw { display: grid; grid-template-rows: auto minmax(180px, 1fr) auto; background: white; color: var(--ink); }
  .fedx-vw :focus-visible { outline-color: var(--surface); }
  .fedx-vw__top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 48px; padding: 0 var(--s-2) 0 var(--s-4); }
  .fedx-vw__page { font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; }
  .fedx-vw__x { justify-self: end; min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 600; color: var(--surface); background: color-mix(in srgb, var(--surface) 14%, transparent); }
  .fedx-vw__stage { position: relative; min-height: 0; overflow: hidden; touch-action: pan-y; cursor: grab; }
  .fedx-vw__stage[data-drag] { cursor: grabbing; }
  .fedx-vw__stage:focus-visible { outline-offset: -3px; border-radius: var(--r-md); }
  .fedx-vw__track { display: flex; height: 100%; transform: translateX(calc(var(--i, 0) * -100% + var(--dx, 0px))); transition: transform var(--dur-slow) var(--ease-out); }
  .fedx-vw__stage[data-drag] .fedx-vw__track { transition: none; }
  .fedx-vw__track figure { flex: none; width: 100%; height: 100%; padding: 0 var(--s-3); }
  .fedx-vw__track img { width: 100%; height: 100%; object-fit: contain; border-radius: var(--r-md); user-select: none; -webkit-user-drag: none; }
  .fedx-vw__bar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-2); min-height: 56px; padding: var(--s-2) var(--s-3); }
  .fedx-vw__b { min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 600; color: var(--surface); background: color-mix(in srgb, var(--surface) 14%, transparent); transition: opacity var(--dur-quick) var(--ease-out); }
  .fedx-vw__b[aria-disabled="true"] { opacity: .35; pointer-events: none; }
  .fedx-vw__cap { text-align: center; font-size: var(--fs-sm); color: color-mix(in srgb, var(--surface) 80%, transparent); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  /* 028 商品详情页：由列表切换至商品详情页 */
  .fedx-pv { position: relative; border-radius: var(--r-lg); overflow: hidden; }
  .fedx-pv__scrim { display: block; background: white; }
  .fedx-pv__dlg { width: 100%; background: white; }
  .fedx-pv__media { position: relative; aspect-ratio: 16 / 9; background: var(--zone); }
  .fedx-pv__media > img { width: 100%; height: 100%; object-fit: cover; }
  .fedx-pv__x { position: absolute; top: var(--s-2); right: var(--s-2); }
  .fedx-pv__body { display: grid; gap: var(--s-1); padding: var(--s-3) var(--s-4) var(--s-3); }
  .fedx-pv__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .fedx-pv__head h3 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .fedx-pv__head .price { font-size: var(--fs-lg); }
  .fedx-pv__rows div { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 36px; font-size: var(--fs-sm); color: var(--ink-2); }
  .fedx-pv__rows div + div { border-top: 1px solid var(--line); }
  .fedx-pv__rows b { font-weight: 600; color: var(--ink); }

  /* 029 动作面板：就近展开在对象下方，成组的动作行加单独的取消 */
  .fedx-ac { overflow: hidden; }
  .fedx-more { display: inline-flex; align-items: center; gap: 2px; font-size: var(--fs-sm); color: var(--ink-2); }
  .fedx-acts { display: grid; gap: var(--s-2); padding: var(--s-3); background: var(--zone); border-top: 1px solid var(--line); }
  .fedx-acts__grp { overflow: hidden; border-radius: var(--r-md); background: var(--surface); }
  .fedx-act { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; padding: 0 var(--s-4); font-size: var(--fs-md); color: var(--ink); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .fedx-act + .fedx-act { border-top: 1px solid var(--line); }
  .fedx-act:focus-visible { outline-offset: -3px; }
  @media (hover: hover) { .fedx-act:hover { background: var(--action-tint); } }
  .fedx-act:active { background: var(--action-soft); }
  .fedx-act[data-tone="danger"] { color: var(--danger); }
  .fedx-act[aria-checked="true"] { color: var(--action-press); font-weight: 600; }
  .fedx-act[aria-disabled="true"] { color: var(--ink-3); pointer-events: none; }
  .fedx-act--cancel { font-weight: 600; }

  /* 030 分享面板：渠道上图下字，复制链接与取消相邻 */
  .fedx-share { display: grid; gap: var(--s-4); padding: var(--s-4) var(--s-3) var(--s-3); background: var(--zone); border-top: 1px solid var(--line); }
  .fedx-share__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-2); }
  .fedx-chan { display: grid; justify-items: center; align-content: start; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .fedx-chan__ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); transition: transform var(--dur-instant) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .fedx-chan__ic img { width: 26px; height: 26px; }
  .fedx-chan:active .fedx-chan__ic { transform: scale(.92); }
  .fedx-chan[data-done] { pointer-events: none; color: var(--success); font-weight: 600; }
  .fedx-chan[data-done] .fedx-chan__ic { background: var(--success-tint); }
  .fedx-share__foot { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); }

  /* 031 气泡操作菜单：在对象旁就近弹出，空间不足时翻到上方，箭头指向点按处 */
  .fedx-pop { position: relative; }
  .fedx-pop .row { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; transition: background var(--dur-quick) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .fedx-pop .row[aria-expanded="true"], .fedx-pop .row[data-pin] { background: var(--zone); }
  .fedx-pop .row[data-gone] { opacity: 0; }
  .fedx-pop__t { display: flex; align-items: center; gap: var(--s-2); min-width: 0; }
  .fedx-pop__unread { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: var(--r-full); background: var(--danger); color: var(--surface); font-size: var(--fs-xs); font-weight: 600; line-height: 1; }
  .fedx-pop__menu { position: absolute; z-index: 6; display: flex; align-items: stretch; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-3); animation: lz-toast var(--dur-quick) var(--ease-out) both; }
  .fedx-pop__menu button { min-height: 44px; padding: 0 var(--s-4); font-size: var(--fs-sm); font-weight: 600; white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
  .fedx-pop__menu button:first-of-type { border-radius: calc(var(--r-md) - 1px) 0 0 calc(var(--r-md) - 1px); }
  .fedx-pop__menu button:last-of-type { border-radius: 0 calc(var(--r-md) - 1px) calc(var(--r-md) - 1px) 0; }
  .fedx-pop__menu button + button { border-left: 1px solid var(--line); }
  .fedx-pop__menu button[data-tone="danger"] { color: var(--danger); }
  @media (hover: hover) { .fedx-pop__menu button:hover { background: var(--zone); } }
  .fedx-pop__arrow { position: absolute; left: var(--ax, 24px); width: 12px; height: 12px; background: var(--surface); border: 0 solid var(--line); transform: translateX(-50%) rotate(45deg); }
  .fedx-pop__menu[data-side="below"] .fedx-pop__arrow { top: -7px; border-width: 1px 0 0 1px; }
  .fedx-pop__menu[data-side="above"] .fedx-pop__arrow { bottom: -7px; border-width: 0 1px 1px 0; }

  /* 032 浮动面板：底部信息面板停靠在收起、半屏、展开三档 */
  .fedx-dock { position: relative; height: 380px; overflow: hidden; border-radius: var(--r-lg); box-shadow: inset 0 0 0 1px var(--line); }
  .fedx-pin { position: absolute; display: grid; place-items: center; width: 40px; height: 44px; transform: translate(-50%, -100%); transform-origin: bottom center; transition: transform var(--dur-base) var(--ease-spring); }
  .fedx-pin img { width: 34px; height: 34px; object-fit: contain; }
  .fedx-pin[aria-pressed="true"] { transform: translate(-50%, -100%) scale(1.3); z-index: 2; }
  .fedx-dock__panel { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; display: grid; grid-template-rows: auto minmax(0, 1fr); height: var(--h, 200px); border-radius: var(--r-xl) var(--r-xl) 0 0; background: var(--surface); box-shadow: var(--elev-3); transition: height var(--dur-slow) var(--ease-spring); }
  .fedx-dock[data-drag] .fedx-dock__panel { transition: none; }
  .fedx-dock__top { padding: 0 var(--s-4) var(--s-3); touch-action: none; user-select: none; -webkit-user-select: none; cursor: grab; }
  .fedx-dock[data-drag] .fedx-dock__top { cursor: grabbing; }
  .fedx-dock__grip { display: grid; place-items: center; width: 88px; height: 24px; margin: 0 auto; border-radius: var(--r-sm); }
  .fedx-dock__grip i { display: block; width: 36px; height: 4px; border-radius: 4px; background: var(--line-strong); }
  .fedx-dock__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .fedx-dock__list { position: relative; min-height: 0; overflow: hidden; }
  .fedx-dock[data-at="2"] .fedx-dock__list { overflow-y: auto; }
  .fedx-dock__list .row { min-height: 64px; }
  .fedx-dock__list .row[aria-current="true"] { background: var(--action-tint); }

  /* 033 滚动公告栏：文字横向无缝滚动，可暂停、变速、关闭 */
  .fedx-nbw { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  .fedx-nb { display: flex; align-items: center; gap: var(--s-2); min-height: 48px; padding: 0 var(--s-1) 0 var(--s-3); border-radius: var(--r-md); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); font-size: var(--fs-sm); color: var(--action-press); }
  .fedx-nb .tag { flex: none; background: var(--action); color: var(--surface); }
  .fedx-nb__view { flex: 1; min-width: 0; align-self: stretch; display: flex; align-items: center; -webkit-mask-image: linear-gradient(90deg, transparent, var(--ink) 6%, var(--ink) 94%, transparent); mask-image: linear-gradient(90deg, transparent, var(--ink) 6%, var(--ink) 94%, transparent); overflow: hidden; cursor: pointer; border-radius: var(--r-sm); }
  .fedx-nb__track { display: flex; width: max-content; animation: fedx-marq var(--dur, 14s) linear infinite; }
  .fedx-nb[data-paused] .fedx-nb__track { animation-play-state: paused; }
  .fedx-nb__grp { display: flex; flex: none; }
  .fedx-nb__grp span { flex: none; padding-right: var(--s-12); white-space: nowrap; }
  @keyframes fedx-marq { to { transform: translateX(-50%); } }
  .fedx-nb .ibtn { width: 36px; height: 36px; flex: none; }
  .fedx-nb .ibtn img { width: 18px; height: 18px; }
  @media (prefers-reduced-motion: reduce) { .fedx-nb__track { animation: none; } }

  /* 034 图片失败占位：加载中、失败可重试、无图片、已加载 */
  .fedx-phs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .fedx-ph { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--r-md); font-size: var(--fs-sm); color: var(--ink-3); text-align: center; }
  .fedx-ph__bg { display: block; width: 100%; height: 100%; background: var(--zone); }
  .fedx-ph__pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: lz-fade var(--dur-slow) var(--ease-out) both; }
  .fedx-ph:not([data-st="ok"]) .fedx-ph__pic { display: none; }
  .fedx-ph__s { position: absolute; inset: 0; display: none; place-content: center; justify-items: center; gap: var(--s-2); }
  .fedx-ph[data-st="load"] [data-for="load"], .fedx-ph[data-st="fail"] [data-for="fail"], .fedx-ph[data-st="none"] [data-for="none"] { display: grid; }
  .fedx-ph__art { width: 56px; height: 56px; object-fit: contain; opacity: .6; }
  .fedx-ph[data-st="load"] .fedx-ph__bg { background: linear-gradient(100deg, color-mix(in srgb, var(--action) 11%, var(--surface)) 30%, color-mix(in srgb, var(--action) 4%, var(--surface)) 50%, color-mix(in srgb, var(--action) 11%, var(--surface)) 70%) 0 0 / 200% 100%; animation: lz-shimmer 1.4s linear infinite; }

  /* 035 顶部消息通知条：从顶部落下，几秒后自动收起，悬停时暂停 */
  .fedx-nf { position: relative; border-radius: var(--r-lg); overflow: hidden; }
  .fedx-nf__slot { position: absolute; z-index: 4; top: var(--s-2); left: var(--s-2); right: var(--s-2); pointer-events: none; }
  .fedx-nf__bar { --c: var(--info); position: relative; display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: 0 var(--s-1) 0 var(--s-4); overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-3); pointer-events: auto; animation: fedx-drop var(--dur-base) var(--ease-out) both; }
  .fedx-nf__bar[data-tone="success"] { --c: var(--success); }
  .fedx-nf__bar[data-tone="warning"] { --c: var(--warning); }
  .fedx-nf__bar[data-tone="action"] { --c: var(--action); }
  .fedx-nf__bar[data-leave] { animation: fedx-lift var(--dur-quick) var(--ease-out) both; }
  .fedx-nf__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent); }
  .fedx-nf__t { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--fs-sm); font-weight: 600; }
  .fedx-nf__timer { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--c); transform-origin: left center; animation: fedx-timer var(--ms, 3200ms) linear both; }
  .fedx-nf__bar:hover .fedx-nf__timer, .fedx-nf__bar:focus-within .fedx-nf__timer { animation-play-state: paused; }
  @keyframes fedx-drop { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: none; } }
  @keyframes fedx-lift { to { opacity: 0; transform: translateY(-10px); } }
  @keyframes fedx-timer { to { transform: scaleX(0); } }
</style>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const LINE = '../../kit/assets/line/';

  /* 横向拖动：以横向位移为准，竖向滚动让给页面；拖动结束后短暂标记，便于忽略随后的点击 */
  function drag(host, { move, end, guard }) {
    let id = null, x0 = 0, y0 = 0, lx = 0, lt = 0, vx = 0, on = false;
    host.addEventListener('pointerdown', e => { if (e.button > 0 || (guard && guard())) return; id = e.pointerId; x0 = lx = e.clientX; y0 = e.clientY; lt = performance.now(); vx = 0; on = false; });
    host.addEventListener('pointermove', e => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!on) { if (Math.abs(dx) < 6) return; if (Math.abs(dy) > Math.abs(dx)) { id = null; return; } on = true; host.setPointerCapture(e.pointerId); host.setAttribute('data-drag', ''); }
      const t = performance.now(); vx = .7 * vx + .3 * ((e.clientX - lx) / Math.max(1, t - lt)); lx = e.clientX; lt = t; move(dx);
    });
    const up = e => { if (e.pointerId !== id) return; id = null; if (!on) return; on = false; host.removeAttribute('data-drag'); host._dragged = true; setTimeout(() => { host._dragged = false; }, 0); end(e.clientX - x0, vx); };
    host.addEventListener('pointerup', up); host.addEventListener('pointercancel', up);
  }

  /* 027 图片预览浏览：点缩略图进入全屏，左右滑动或按键切换，页码实时更新 */
  (() => {
    const r = D('AP-FEED-027'), box = $('[data-gv]', r), card = $('.fed-card', box), vw = $('.fedx-vw', box), track = $('[data-track]', vw), stage = $('[data-stage]', vw), page = $('[data-page]', vw), cap = $('[data-cap]', vw), prev = $('[data-prev]', vw), next = $('[data-next]', vw);
    const ths = $$('.fedx-gv__th', box), N = ths.length; let cur = 0, opener = null;
    track.innerHTML = ths.map(t => `<figure><img src="${$('img', t).getAttribute('src')}" alt="${t.dataset.name}" draggable="false"></figure>`).join('');
    const show = i => {
      cur = clamp(i, 0, N - 1); track.style.setProperty('--i', cur); track.style.setProperty('--dx', '0px');
      page.textContent = `${cur + 1} / ${N}`; cap.textContent = ths[cur].dataset.name;
      prev.setAttribute('aria-disabled', String(cur === 0)); next.setAttribute('aria-disabled', String(cur === N - 1));
    };
    const open = (i, from) => { opener = from; show(i); vw.hidden = false; card.hidden = true; stage.focus({ preventScroll: true }); };
    const close = () => { vw.hidden = true; card.hidden = false; if (opener) opener.focus({ preventScroll: true }); };
    ths.forEach((t, i) => t.addEventListener('click', () => open(i, t)));
    $('[data-x]', vw).addEventListener('click', close);
    prev.addEventListener('click', () => show(cur - 1)); next.addEventListener('click', () => show(cur + 1));
    vw.addEventListener('keydown', e => {
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
      else if (e.key === 'Home') { e.preventDefault(); show(0); }
      else if (e.key === 'End') { e.preventDefault(); show(N - 1); }
    });
    drag(stage, {
      move: dx => { const edge = (cur === 0 && dx > 0) || (cur === N - 1 && dx < 0); track.style.setProperty('--dx', (edge ? dx * .3 : dx) + 'px'); },
      end: (dx, v) => { const w = stage.clientWidth; show(cur + (dx < -w * .2 || v < -.4 ? 1 : dx > w * .2 || v > .4 ? -1 : 0)); }
    });
  })();

  /* 028 商品详情页：点击商品行进入详情，返回列表后恢复焦点 */
  (() => {
    const r = D('AP-FEED-028'), box = $('[data-pv]', r), list = $('[data-list]', box), scrim = $('[data-scrim]', box), rows = $$('[data-k]', list);
    const DATA = [
      ['红玫瑰花束', 'product-rose-red', 199, '红玫瑰 19 枝', '同城 2 小时送达', '建国路店'],
      ['粉芍药花束', 'product-peony-pink', 239, '粉芍药 9 枝', '同城 2 小时送达', '徐汇滨江店'],
      ['向日葵花束', 'product-sunflower', 159, '向日葵 6 枝', '同城 2 小时送达', '浦东世纪店'],
      ['白郁金香', 'product-tulip-white', 179, '郁金香 10 枝', '同城 2 小时送达', '建国路店'],
      ['蓝绣球盆栽', 'product-hydrangea-blue', 129, '绣球 1 盆', '快递 次日达', '徐汇滨江店']
    ];
    let opener = null;
    const fill = k => { const d = DATA[k]; $('[data-img]', scrim).src = `../../kit/assets/photo/${d[1]}.webp`; $('[data-name]', scrim).textContent = d[0]; $('[data-price]', scrim).textContent = d[2]; $('[data-f1]', scrim).textContent = d[3]; $('[data-f2]', scrim).textContent = d[4]; $('[data-f3]', scrim).textContent = d[5]; };
    const open = (k, from) => { opener = from; fill(k); scrim.hidden = false; list.hidden = true; $('[data-x]', scrim).focus({ preventScroll: true }); };
    const close = () => { scrim.hidden = true; list.hidden = false; if (opener) opener.focus({ preventScroll: true }); };
    rows.forEach(b => b.addEventListener('click', () => open(+b.dataset.k, b)));
    $('[data-x]', scrim).addEventListener('click', close);
    scrim.addEventListener('click', e => { if (e.target === scrim) close(); });
    box.addEventListener('keydown', e => { if (e.key === 'Escape' && !scrim.hidden) { e.preventDefault(); close(); } });
    scrim.hidden = true; list.hidden = false;
  })();

  /* 029 动作面板：就近展开的动作行；收藏可切换，举报先居中确认再变为已举报，取消收起 */
  (() => {
    const r = D('AP-FEED-029'), panel = $('.fedx-acts', r), trig = $('[data-expand]', r), fav = $('[data-act="fav"]', r), rep = $('[data-act="report"]', r);
    const items = () => $$('.fedx-act', panel).filter(b => b.getAttribute('aria-disabled') !== 'true');
    const paintFav = on => { fav.setAttribute('aria-checked', String(on)); fav.textContent = on ? '已收藏' : '收藏商品'; };
    panel.addEventListener('click', async e => {
      const b = e.target.closest('[data-act]'); if (!b || b.getAttribute('aria-disabled') === 'true') return;
      switch (b.dataset.act) {
        case 'share': Lz.toast('已分享给好友', 'success'); break;
        case 'fav': { const on = fav.getAttribute('aria-checked') !== 'true'; paintFav(on); Lz.toast(on ? '已收藏' : '已取消收藏', 'success'); break; }
        case 'copy': Lz.toast('已复制商品链接', 'success'); break;
        case 'report': if (await Lz.confirm({ title: '确认举报该商品', ok: '举报', cancel: '取消', tone: 'danger' })) { rep.textContent = '已举报'; rep.setAttribute('aria-disabled', 'true'); Lz.toast('举报已提交', 'success'); } break;
        case 'cancel': trig.click(); trig.focus(); break;
      }
    });
    panel.addEventListener('keydown', e => {
      const d = { ArrowDown: 1, ArrowUp: -1 }[e.key]; if (!d) return;
      e.preventDefault(); const list = items(), i = list.indexOf(document.activeElement); list[(i + d + list.length) % list.length].focus();
    });
    $('[data-reset]', r).addEventListener('click', () => { paintFav(false); rep.textContent = '举报商品'; rep.removeAttribute('aria-disabled'); if (trig.getAttribute('aria-expanded') !== 'true') trig.click(); });
  })();

  /* 030 分享面板：点渠道原位变为已完成，几秒后复原；复制链接给出提示，取消收起 */
  (() => {
    const r = D('AP-FEED-030'), trig = $('[data-expand]', r);
    $$('.fedx-chan', r).forEach(b => {
      const t = $('.fedx-chan__t', b), img = $('img', b), name = t.textContent, src = img.getAttribute('src');
      b.addEventListener('click', async () => {
        if (b.hasAttribute('data-done')) return;
        b.setAttribute('data-done', ''); t.textContent = b.dataset.ok; img.src = LINE + 'check.webp'; Lz.toast(b.dataset.msg, 'success');
        await sleep(1600); b.removeAttribute('data-done'); t.textContent = name; img.src = src;
      });
    });
    $('[data-act="copy"]', r).addEventListener('click', () => Lz.toast('已复制链接', 'success'));
    $('[data-act="cancel"]', r).addEventListener('click', () => { trig.click(); trig.focus(); });
  })();

  /* 031 气泡操作菜单：点击、右键或长按会话行，在点按处旁弹出菜单；置顶、已读、删除都会改变列表 */
  (() => {
    const r = D('AP-FEED-031'), pop = $('[data-pop]', r), list = $('[data-list]', pop), menu = $('.fedx-pop__menu', pop), back = $('[data-back]', r);
    const initial = list.innerHTML; let cur = null, timer = 0, pressed = false;
    const rows = () => $$('.fedx-pop__row', list);
    const rowOf = t => t.closest && t.closest('.fedx-pop__row');
    const paint = row => {
      const pin = row.hasAttribute('data-pin'); $('.tag', row).hidden = !pin;
      const un = $('.fedx-pop__unread', row); const has = !!un && !un.hidden;
      row.dataset.has = has ? '1' : '0';
    };
    const sort = () => rows().sort((a, b) => (b.hasAttribute('data-pin') - a.hasAttribute('data-pin')) || (a.dataset.o - b.dataset.o)).forEach(x => list.append(x));
    const labels = row => { $('[data-do="pin"]', menu).textContent = row.hasAttribute('data-pin') ? '取消置顶' : '置顶'; const un = $('.fedx-pop__unread', row); $('[data-do="read"]', menu).hidden = !un; $('[data-do="read"]', menu).textContent = un && un.hidden ? '标为未读' : '标为已读'; };
    function place(row, x) {
      menu.hidden = false; menu.style.visibility = 'hidden';
      const p = pop.getBoundingClientRect(), rr = row.getBoundingClientRect(), mw = menu.offsetWidth, mh = menu.offsetHeight;
      let side = 'below', top = rr.bottom - p.top + 10;
      if (top + mh > p.height) { side = 'above'; top = rr.top - p.top - mh - 10; }
      if (top < 0) { side = 'below'; top = clamp(rr.bottom - p.top + 10, 0, Math.max(0, p.height - mh)); }
      const left = clamp(x - p.left - mw / 2, 4, p.width - mw - 4);
      menu.style.left = left + 'px'; menu.style.top = top + 'px'; menu.dataset.side = side; menu.style.setProperty('--ax', clamp(x - p.left - left, 18, mw - 18) + 'px');
      menu.style.visibility = ''; menu.style.animation = 'none'; void menu.offsetWidth; menu.style.animation = '';
    }
    function close(focus) { if (!cur) return; const row = cur; cur = null; row.setAttribute('aria-expanded', 'false'); menu.hidden = true; if (focus) row.focus({ preventScroll: true }); }
    function openFor(row, x, byKey) {
      if (cur && cur !== row) cur.setAttribute('aria-expanded', 'false');
      cur = row; row.setAttribute('aria-expanded', 'true'); labels(row); place(row, x);
      if (byKey) $$('button', menu).find(b => !b.hidden).focus();
    }
    list.addEventListener('click', e => {
      const row = rowOf(e.target); if (!row) return;
      if (pressed) { pressed = false; return; }
      if (cur === row) { close(); return; }
      const rc = row.getBoundingClientRect(); openFor(row, e.detail === 0 ? rc.left + rc.width * .5 : e.clientX, e.detail === 0);
    });
    list.addEventListener('pointerdown', e => { const row = rowOf(e.target); if (!row || e.button > 0) return; const x = e.clientX; clearTimeout(timer); timer = setTimeout(() => { pressed = true; openFor(row, x, false); }, 450); });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(t => list.addEventListener(t, () => clearTimeout(timer)));
    list.addEventListener('contextmenu', e => { const row = rowOf(e.target); if (!row) return; e.preventDefault(); clearTimeout(timer); if (cur !== row) openFor(row, e.clientX, false); });
    document.addEventListener('click', e => { if (cur && !menu.contains(e.target) && !rowOf(e.target)) close(); });
    pop.addEventListener('keydown', e => {
      if (e.key === 'Escape' && cur) { e.preventDefault(); close(true); }
      const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d && menu.contains(document.activeElement)) { e.preventDefault(); const bs = $$('button', menu).filter(b => !b.hidden), i = bs.indexOf(document.activeElement); bs[(i + d + bs.length) % bs.length].focus(); }
    });
    addEventListener('resize', () => close());
    menu.addEventListener('click', async e => {
      const b = e.target.closest('[data-do]'); if (!b || !cur) return; const row = cur, a = b.dataset.do; close(true);
      if (a === 'pin') { const on = !row.hasAttribute('data-pin'); row.toggleAttribute('data-pin', on); paint(row); sort(); Lz.toast(on ? '已置顶' : '已取消置顶', 'success'); }
      else if (a === 'read') { const un = $('.fedx-pop__unread', row); if (un) { un.hidden = !un.hidden; Lz.toast(un.hidden ? '已标为已读' : '已标为未读', 'success'); } }
      else if (a === 'del') {
        row.setAttribute('data-gone', ''); await sleep(tok('--dur-base')); row.remove(); back.hidden = false; Lz.toast('已删除会话', 'success');
        if (!rows().length) list.innerHTML = '<div class="empty" style="padding:var(--s-6) var(--s-4)">没有更多会话</div>';
      }
    });
    $('[data-reset]', r).addEventListener('click', () => { close(); list.innerHTML = initial; back.hidden = true; });
    function tok(n) { return parseFloat(getComputedStyle(document.documentElement).getPropertyValue(n)); }
  })();

  /* 032 浮动面板：拖动顶部手柄，松手停靠到最近一档；点手柄或按上下键逐档切换；点图钉与列表联动 */
  (() => {
    const r = D('AP-FEED-032'), box = $('[data-dock]', r), panel = $('[data-panel]', box), top = $('[data-top]', box), grip = $('[data-grip]', box), list = $('[data-list]', box), pins = $$('.fedx-pin', box), rows = $$('[data-k]', list);
    const LAB = ['收起', '半屏', '展开']; let A = [], at = 1, sel = -1;
    const calc = () => { const H = box.clientHeight; A = [top.offsetHeight + 4, top.offsetHeight + rows[0].offsetHeight * 2, H - 40]; };
    const set = i => { at = clamp(i, 0, 2); panel.style.setProperty('--h', A[at] + 'px'); box.dataset.at = at; grip.setAttribute('aria-valuenow', at); grip.setAttribute('aria-valuetext', LAB[at]); };
    const pick = k => {
      sel = k; pins.forEach(p => p.setAttribute('aria-pressed', String(+p.dataset.k === k))); rows.forEach(w => w.setAttribute('aria-current', String(+w.dataset.k === k)));
      set(k >= 2 ? 2 : Math.max(at, 1)); const w = rows[k]; list.scrollTop = Math.max(0, w.offsetTop - 8);
    };
    pins.forEach(p => p.addEventListener('click', () => pick(+p.dataset.k)));
    rows.forEach(w => w.addEventListener('click', () => pick(+w.dataset.k)));
    let id = null, y0 = 0, h0 = 0, ly = 0, lt = 0, vy = 0, moved = false;
    top.addEventListener('pointerdown', e => { if (e.button > 0) return; id = e.pointerId; top.setPointerCapture(id); y0 = ly = e.clientY; h0 = panel.offsetHeight; lt = performance.now(); vy = 0; moved = false; });
    top.addEventListener('pointermove', e => {
      if (e.pointerId !== id) return; const dy = e.clientY - y0;
      if (!moved) { if (Math.abs(dy) < 5) return; moved = true; box.setAttribute('data-drag', ''); document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })); }
      const t = performance.now(); vy = .7 * vy + .3 * ((e.clientY - ly) / Math.max(1, t - lt)); ly = e.clientY; lt = t;
      let h = h0 - dy; if (h < A[0]) h = A[0] - (A[0] - h) * .3; if (h > A[2]) h = A[2] + (h - A[2]) * .3; panel.style.setProperty('--h', h + 'px');
    });
    const up = e => {
      if (e.pointerId !== id) return; id = null;
      if (!moved) { set(at < 2 ? at + 1 : 0); return; }
      box.removeAttribute('data-drag'); const proj = panel.offsetHeight - vy * 160;
      set(A.reduce((b, v, i) => (Math.abs(v - proj) < Math.abs(A[b] - proj) ? i : b), 0));
    };
    top.addEventListener('pointerup', up); top.addEventListener('pointercancel', up);
    grip.addEventListener('keydown', e => { const d = { ArrowUp: 1, ArrowDown: -1 }[e.key]; if (d) { e.preventDefault(); set(at + d); } else if (e.key === 'Home') { e.preventDefault(); set(0); } else if (e.key === 'End') { e.preventDefault(); set(2); } else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(at < 2 ? at + 1 : 0); } });
    new ResizeObserver(() => { calc(); set(at); }).observe(box); calc(); set(1);
  })();

  /* 033 滚动公告栏：文字无缝横向滚动；悬停或点暂停会停住，可调速，关闭后可重新显示 */
  (() => {
    const r = D('AP-FEED-033'), bar = $('[data-bar]', r), view = $('[data-view]', bar), track = $('[data-track]', bar), pause = $('[data-pause]', bar), pimg = $('img', pause), back = $('[data-back]', r);
    const SPD = { slow: 36, normal: 60, fast: 100 }; let speed = SPD.normal, manual = false, hover = false;
    const fit = () => track.style.setProperty('--dur', (track.scrollWidth / 2 / speed).toFixed(1) + 's');
    const paint = () => {
      bar.toggleAttribute('data-paused', manual || hover);
      pimg.src = LINE + (manual ? 'play' : 'pause') + '.webp'; pause.setAttribute('aria-label', manual ? '继续滚动' : '暂停滚动'); pause.dataset.tip = manual ? '继续滚动' : '暂停滚动';
    };
    pause.addEventListener('click', () => { manual = !manual; paint(); });
    view.addEventListener('pointerenter', () => { hover = true; paint(); }); view.addEventListener('pointerleave', () => { hover = false; paint(); });
    view.addEventListener('focus', () => { hover = true; paint(); }); view.addEventListener('blur', () => { hover = false; paint(); });
    const open = () => Lz.toast('已打开公告', 'success');
    view.addEventListener('click', open); view.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    r.addEventListener('lz:seg', e => { speed = SPD[e.detail.key] || SPD.normal; fit(); });
    $('[data-close]', bar).addEventListener('click', () => { bar.hidden = true; back.hidden = false; $('[data-show]', back).focus(); });
    $('[data-show]', back).addEventListener('click', () => { bar.hidden = false; back.hidden = true; fit(); });
    new ResizeObserver(fit).observe(view); fit();
  })();

  /* 034 图片失败占位：失败的位置点重新加载，转为加载中，再成功显示；重新加载全部会按顺序重试 */
  (() => {
    const r = D('AP-FEED-034'), tiles = $$('.fedx-ph', r);
    const st = (t, s) => { t.dataset.st = s; };
    const retry = async (t, ok = true) => { st(t, 'load'); await sleep(1100); st(t, ok ? 'ok' : 'fail'); };
    tiles.forEach(t => { const b = $('[data-retry]', t); if (b) b.addEventListener('click', () => retry(t)); });
    $('[data-all]', r).addEventListener('click', async () => {
      const b = $('[data-all]', r); b.disabled = true;
      const pics = tiles.filter(t => $('.fedx-ph__pic', t)); pics.forEach(t => st(t, 'load'));
      await sleep(700); st(pics[0], 'ok'); await sleep(450); st(pics[1], 'ok'); await sleep(450); st(pics[2], 'fail'); b.disabled = false;
    });
  })();

  /* 035 顶部消息通知条：订单状态变化时从顶部落下，几秒后自动收起；悬停暂停计时，新通知替换旧通知 */
  (() => {
    const r = D('AP-FEED-035'), slot = $('[data-slot]', r), tag = $('[data-state]', r);
    const EV = {
      paid: ['订单 20817365 已付款', 'success', ['待发货', 'info']],
      ship: ['订单 20817365 已发货', 'info', ['待收货', 'action']],
      done: ['订单 20817365 已送达', 'success', ['已完成', 'success']]
    };
    const MS = 3200; let cur = null, t = 0;
    const hide = async () => { const b = cur; if (!b) return; cur = null; clearTimeout(t); b.setAttribute('data-leave', ''); await sleep(160); b.remove(); };
    const arm = () => { clearTimeout(t); t = setTimeout(hide, Lz.reduce ? 600 : MS); };
    async function fire(k) {
      const [text, tone, state] = EV[k]; await hide();
      const b = document.createElement('div'); b.className = 'fedx-nf__bar'; b.dataset.tone = tone; b.style.setProperty('--ms', MS + 'ms');
      b.innerHTML = `<span class="fedx-nf__dot"></span><span class="fedx-nf__t">${text}</span><button class="btn btn--text btn--sm" data-see>查看</button><i class="fedx-nf__timer"></i>`;
      slot.append(b); cur = b; tag.textContent = state[0]; tag.dataset.tone = state[1]; arm();
      b.addEventListener('pointerenter', () => clearTimeout(t)); b.addEventListener('pointerleave', () => { if (cur === b) { const tm = $('.fedx-nf__timer', b); tm.style.animation = 'none'; void tm.offsetWidth; tm.style.animation = ''; arm(); } });
      b.addEventListener('focusin', () => clearTimeout(t)); b.addEventListener('focusout', () => { if (cur === b) arm(); });
      $('[data-see]', b).addEventListener('click', () => { Lz.toast('已打开订单', 'success'); hide(); });
    }
    $$('[data-fire]', r).forEach(b => b.addEventListener('click', () => fire(b.dataset.fire)));
    $('[data-reset]', r).addEventListener('click', async () => { await hide(); tag.textContent = '待付款'; tag.dataset.tone = 'warning'; });
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { io.disconnect(); fire('paid'); } }), { threshold: .6 }); io.observe(r);
  })();
})();
</script>
