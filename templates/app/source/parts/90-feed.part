        <div class="fedx-vw__stage" tabindex="0" aria-label="图片区域 左右滑动切换" data-stage><div class="fedx-vw__track" data-track></div></div>
        <div class="fedx-vw__bar"><button class="fedx-vw__b" data-prev>上一张</button><span class="fedx-vw__cap" data-cap></span><button class="fedx-vw__b" data-next>下一张</button></div>
