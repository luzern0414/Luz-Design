        <div class="cht-empty__art"><img data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""></div>
        <div class="suggest"><button data-q="核对上周三家门店的对账差异">核对对账差异</button><button data-q="汇总本周退款金额">汇总退款金额</button></div>
      </div>
      <div class="chat cht-chat" data-chat hidden></div>
      <div class="cht-bar cht-bar--end" data-reset hidden><button class="btn btn--text btn--sm">新会话</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-014" data-name="失败重试气泡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">失败重试气泡</span></div>
  <p class="demo__note">适合：回答中断后保留已生成内容，一键继续</p>
