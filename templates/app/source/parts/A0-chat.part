              <button type="button" class="cht-md__opt" role="option" aria-selected="false" data-i="1"><span class="cht-md__name">花间一号</span><span class="cht-md__meta">均衡</span><img src="../../kit/assets/line/check.webp" alt=""></button>
              <button type="button" class="cht-md__opt" role="option" aria-selected="true" data-i="2"><span class="cht-md__name">花间二号</span><span class="cht-md__meta">推理强</span><img src="../../kit/assets/line/check.webp" alt=""></button>
            </div>
            <div class="cht-md__menu cht-md__menu--row" role="listbox" aria-label="选择思考强度" data-menu="effort" hidden>
              <button type="button" class="cht-md__eff" role="option" aria-selected="false" data-i="0">关闭</button>
              <button type="button" class="cht-md__eff" role="option" aria-selected="false" data-i="1">低</button>
              <button type="button" class="cht-md__eff" role="option" aria-selected="true" data-i="2">中</button>
              <button type="button" class="cht-md__eff" role="option" aria-selected="false" data-i="3">高</button>
            </div>
          </div></div>
        </div>
      </form>
    </div>
  </div>
</article>

