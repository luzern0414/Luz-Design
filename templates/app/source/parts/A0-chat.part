<article class="demo" data-cid="AP-CHAT-030" data-name="系统通知条" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">系统通知条</span></div>
  <p class="demo__note">适合：对话中的系统级提示，如额度与连接状态</p>
  <div class="demo__stage">
    <div class="cht-wrap">
      <div class="cht-nts" data-list role="region" aria-label="系统通知">
        <div class="cht-nt" data-tone="warning" data-kind="quota" role="status"><span class="cht-nt__dot" aria-hidden="true"></span><div class="cht-nt__t"><p class="row__title one-line" data-t>额度已用 92%</p><p class="row__meta one-line" data-m>剩余 8 次调用</p></div><button class="btn btn--white btn--sm" data-do>申请额度</button><button class="ibtn" data-close data-tip="关闭通知" aria-label="关闭通知"><img src="../../kit/assets/line/close.webp" alt=""></button></div>
        <div class="cht-nt" data-tone="danger" data-kind="conn" role="status"><span class="cht-nt__dot" aria-hidden="true"></span><div class="cht-nt__t"><p class="row__title one-line" data-t>连接已断开</p><p class="row__meta one-line" data-m>回答暂时无法送达</p></div><button class="btn btn--white btn--sm" data-do>重连</button><button class="ibtn" data-close data-tip="关闭通知" aria-label="关闭通知"><img src="../../kit/assets/line/close.webp" alt=""></button></div>
        <div class="cht-nt" data-tone="info" data-kind="model" role="status"><span class="cht-nt__dot" aria-hidden="true"></span><div class="cht-nt__t"><p class="row__title one-line" data-t>已切换到花间一号</p><p class="row__meta one-line" data-m>后续回答使用新模型</p></div><button class="ibtn" data-close data-tip="关闭通知" aria-label="关闭通知"><img src="../../kit/assets/line/close.webp" alt=""></button></div>
      </div>
      <p class="cht-note" data-empty hidden>暂无系统通知</p>
      <div class="cht-bar cht-bar--end"><button class="btn btn--secondary btn--sm" data-reset>重置通知</button></div>
    </div>
  </div>
</article>


<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const el = html => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };
  const AVATAR = '../../kit/assets/marks/mark-007.webp';
  const copy = async text => { try { await navigator.clipboard.writeText(text); Lz.toast('已复制', 'success'); } catch (e) { Lz.toast('复制失败', 'danger'); } };
  const userBubble = text => { const m = el('<div class="msg msg--user cht-in"><div class="bubble"><p></p></div></div>'); $('p', m).textContent = text; return m; };
  const agentBubble = () => el(`<article class="msg cht-in"><img class="msg__avatar" src="${AVATAR}" alt=""><div class="msg__body"><p class="bubble"></p></div></article>`);
  const setOpen = (btn, open) => { const p = document.getElementById(btn.getAttribute('aria-controls')); p.dataset.open = String(open); p.inert = !open; btn.setAttribute('aria-expanded', String(open)); };
  const chipEl = (name, remove) => { const c = el('<span class="cht-chip"><span class="one-line"></span><button type="button" class="ibtn"><img src="../../kit/assets/line/close.webp" alt=""></button></span>'); $('.one-line', c).textContent = name; const x = $('.ibtn', c); x.setAttribute('aria-label', '移除附件 ' + name); x.dataset.tip = '移除附件'; x.addEventListener('click', () => remove(c)); return c; };

  /* 001 用户气泡：复制，原位编辑，保存后原位更新 */
  (() => {
    const r = D('AP-CHAT-001'), bubble = $('[data-bubble]', r), p = $('p', bubble), box = $('[data-editbox]', r), ta = $('textarea', box), acts = $('[data-acts]', r);
    const user = bubble.parentElement, close = () => { box.hidden = true; bubble.hidden = false; acts.hidden = false; user.removeAttribute('data-editing'); };
    $('[data-copy]', r).addEventListener('click', () => copy(p.textContent));
    $('[data-edit]', r).addEventListener('click', () => { ta.value = p.textContent; bubble.hidden = true; acts.hidden = true; box.hidden = false; user.setAttribute('data-editing', ''); ta.focus(); });
    $('[data-cancel]', r).addEventListener('click', close);
    $('[data-save]', r).addEventListener('click', () => { const v = ta.value.trim(); if (v) p.textContent = v; close(); Lz.toast('已修改', 'success'); });
  })();

  /* 002 智能体气泡：重新生成会重新流式输出 */
  (() => {
    const r = D('AP-CHAT-002'), b = $('[data-bubble]', r), text = b.textContent, regen = $('[data-regen]', r);
    $('[data-copy]', r).addEventListener('click', () => copy(b.textContent));
    regen.addEventListener('click', async () => { regen.disabled = true; b.textContent = ''; await Lz.stream(b, text, 40); regen.disabled = false; });
  })();

  /* 003 思考：逐步从进行中变为完成，结束后收起 */
  (() => {
    const r = D('AP-CHAT-003'), head = $('.think__head', r), label = $('[data-head]', r), steps = $$('.think__steps li', r), btn = $('[data-play]', r);
    const dots = '<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>';
    btn.addEventListener('click', async () => {
      btn.disabled = true; setOpen(head, true); label.innerHTML = dots + '<span> 思考中</span>'; steps.forEach(li => { li.dataset.state = ''; }); const t0 = performance.now();
      for (const li of steps) { li.dataset.state = 'now'; await sleep(650); li.dataset.state = 'done'; }
      label.textContent = '已思考 ' + Math.max(1, Math.round((performance.now() - t0) / 1000)) + ' 秒'; await sleep(500); setOpen(head, false); btn.disabled = false;
    });
  })();

  /* 004 工具：点开看输入输出；继续运行推进状态 */
  (() => {
    const r = D('AP-CHAT-004'), tools = $$('.tool', r), NAMES = { done: '已完成', run: '进行中', fail: '失败', wait: '等待中' };
    const label = b => b.setAttribute('aria-label', b.textContent + ' ' + NAMES[b.dataset.state]);
    const set = (b, st, out) => { b.dataset.state = st; label(b); const o = $('[data-out]', document.getElementById(b.getAttribute('aria-controls'))); if (out) o.textContent = out; };
    tools.forEach(b => { label(b); b.addEventListener('click', () => { const io = document.getElementById(b.getAttribute('aria-controls')), open = io.hidden; io.hidden = !open; b.setAttribute('aria-expanded', String(open)); }); });
    const run = $('[data-run]', r);
    run.addEventListener('click', async () => {
      run.disabled = true;
      if (tools[1].dataset.state === 'run') { await sleep(800); set(tools[1], 'done', '差额合计 286.50 元'); }
      set(tools[2], 'run', '进行中'); await sleep(1000); set(tools[2], 'fail', '接口超时'); Lz.toast('导出文件失败', 'danger'); run.disabled = false;
    });
    $('[data-reset]', r).addEventListener('click', () => { set(tools[0], 'done'); set(tools[1], 'run', '进行中'); set(tools[2], 'wait', '等待中'); run.disabled = false; });
  })();

  /* 005 流式文字：播放与停止 */
  (() => {
    const r = D('AP-CHAT-005'), b = $('[data-bubble]', r), full = b.textContent, tag = $('[data-tag]', r), play = $('[data-play]', r), stop = $('[data-stop]', r); let job = null;
    const state = (txt, tone) => { tag.textContent = txt; tag.dataset.tone = tone; };
    play.addEventListener('click', async () => {
      if (job) job.cancel(); b.textContent = ''; state('生成中', 'action'); play.disabled = true; stop.disabled = false;
      const mine = job = Lz.stream(b, full, 28); await mine; if (job === mine) { state(stop.dataset.stopped ? '已停止' : '已完成', stop.dataset.stopped ? 'warning' : 'success'); delete stop.dataset.stopped; job = null; play.disabled = false; stop.disabled = true; }
    });
    stop.addEventListener('click', () => { if (job) { stop.dataset.stopped = '1'; job.cancel(); } });
  })();

  /* 006 审批：选方案，批准或拒绝后原位出结果 */
  (() => {
    const r = D('AP-CHAT-006'), card = $('.approval', r), opts = $$('.opt', r);
    opts.forEach(o => o.addEventListener('click', () => opts.forEach(x => { const on = x === o; x.setAttribute('aria-checked', String(on)); $('.check', x).setAttribute('aria-checked', String(on)); })));
    $$('[data-act]', r).forEach(b => b.addEventListener('click', () => {
      const ok = b.dataset.act === 'approve', pick = opts.find(o => o.getAttribute('aria-checked') === 'true'), tag = $('[data-tag]', r);
      tag.textContent = ok ? '已批准' : '已拒绝'; tag.dataset.tone = ok ? 'success' : 'danger'; $('[data-res]', r).textContent = ok ? pick.textContent : ''; card.dataset.state = 'done'; Lz.toast(ok ? '已批准' : '已拒绝', ok ? 'success' : 'neutral');
    }));
    $('[data-reset]', r).addEventListener('click', () => { card.removeAttribute('data-state'); });
  })();

  /* 007 任务行：点一行在三种状态间轮换 */
  (() => {
    const S = [['待处理', ''], ['进行中', 'action'], ['已完成', 'success']];
    $$('.cht-task', D('AP-CHAT-007')).forEach(row => row.addEventListener('click', () => { const i = (+row.dataset.s + 1) % 3, t = $('.tag', row); row.dataset.s = i; t.textContent = S[i][0]; if (S[i][1]) t.dataset.tone = S[i][1]; else t.removeAttribute('data-tone'); }));
  })();

  /* 008 产物：展开后按钮文字跟着变 */
  (() => { const b = $('[data-expand]', D('AP-CHAT-008')); b.addEventListener('click', () => setTimeout(() => { b.textContent = b.getAttribute('aria-expanded') === 'true' ? '收起' : '打开'; }, 0)); })();

  /* 009 引用：点角标在气泡下方就近显示出处，再点收起 */
  (() => {
    const r = D('AP-CHAT-009'), cites = $$('.cite', r), box = $('.cht-src', r), SRC = [['对账单', '第 3 页 三家门店汇总'], ['订单明细', '第 12 行 重复扣款两笔']];
    cites.forEach(c => c.addEventListener('click', () => {
      const on = c.getAttribute('aria-pressed') !== 'true'; cites.forEach(x => x.setAttribute('aria-pressed', 'false'));
      if (on) { c.setAttribute('aria-pressed', 'true'); const s = SRC[+c.dataset.i]; $('[data-name]', box).textContent = s[0]; $('[data-where]', box).textContent = s[1]; }
      box.hidden = !on;
    }));
  })();

  /* 010 输入栏：自动增高，空内容不可发，回车发送；附件与语音 */
  (() => {
    const r = D('AP-CHAT-010'), form = $('[data-form]', r), ta = $('textarea', r), send = $('[data-send]', r), log = $('[data-log]', r), files = $('[data-files]', r), mic = $('[data-mic]', r), dots = $('[data-dots]', r); let n = 0, timer;
    const sync = () => { send.disabled = ta.value.trim() === '' && files.children.length === 0; };
    const submit = () => { const t = ta.value.trim(); if (!t && !files.children.length) return; log.append(userBubble(t || '已发送附件')); while (log.children.length > 2) log.firstElementChild.remove(); ta.value = ''; ta.style.height = ''; files.replaceChildren(); files.hidden = true; sync(); };
    ta.addEventListener('input', () => { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; sync(); });
    ta.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); submit(); } });
    form.addEventListener('submit', e => { e.preventDefault(); submit(); });
    $('[data-attach]', r).addEventListener('click', () => { files.hidden = false; files.append(chipEl(['对账单表格', '退款明细文档', '库存数据表'][n++ % 3], c => { c.remove(); files.hidden = !files.children.length; sync(); })); sync(); });
    mic.addEventListener('click', () => { const on = mic.getAttribute('aria-pressed') !== 'true'; mic.setAttribute('aria-pressed', String(on)); dots.hidden = !on; clearTimeout(timer); if (on) timer = setTimeout(() => { mic.setAttribute('aria-pressed', 'false'); dots.hidden = true; ta.value = (ta.value ? ta.value + ' ' : '') + '汇总本周退款金额'; ta.dispatchEvent(new Event('input')); ta.focus(); }, Lz.reduce ? 0 : 1600); });
    sync();
  })();

  /* 011 建议问法：点一条，问法进入气泡 */
  (() => {
    const r = D('AP-CHAT-011'), log = $('[data-log]', r), bs = $$('.suggest button', r);
    bs.forEach(b => b.addEventListener('click', () => { bs.forEach(x => x.setAttribute('aria-pressed', String(x === b))); log.replaceChildren(userBubble(b.dataset.q)); }));
    const strip = $('.suggest', r), edge = () => strip.toggleAttribute('data-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 2);
    strip.addEventListener('scroll', edge, { passive: true }); window.addEventListener('resize', edge); edge();
  })();

  /* 012 排队：追加与清空，序号跟着变 */
  (() => {
    const r = D('AP-CHAT-012'), list = $('[data-list]', r), tag = $('[data-tag]', r), POOL = ['导出对账结果', '核对库存缺口', '汇总门店销量', '查看退款进度'];
    const paint = () => { const rows = $$('.cht-q__row', list); rows.forEach((row, i) => { $('.tag', row).textContent = `第 ${i + 1} 位`; }); tag.textContent = rows.length ? `排队 ${rows.length} 条` : '队列为空'; tag.dataset.tone = rows.length ? 'warning' : ''; if (!rows.length) tag.removeAttribute('data-tone'); };
    $('[data-add]', r).addEventListener('click', () => { if (list.children.length >= 5) { Lz.toast('最多排队 5 条'); return; } const row = el('<div class="cht-q__row cht-in"><span class="one-line"></span><span class="tag"></span></div>'); $('.one-line', row).textContent = POOL[list.children.length % POOL.length]; list.append(row); paint(); });
    $('[data-clear]', r).addEventListener('click', () => { list.replaceChildren(); paint(); Lz.toast('已清空排队'); });
  })();

  /* 013 空会话：点问法进入对话，新会话回到空态 */
  (() => {
    const r = D('AP-CHAT-013'), empty = $('[data-empty]', r), chat = $('[data-chat]', r), reset = $('[data-reset]', r);
    $$('.suggest button', r).forEach(b => b.addEventListener('click', async () => {
      empty.hidden = true; chat.hidden = false; reset.hidden = false; chat.replaceChildren(userBubble(b.dataset.q)); const a = agentBubble(); chat.append(a); await Lz.stream($('.bubble', a), '好的，已开始处理。', 40);
    }));
    $('.btn', reset).addEventListener('click', () => { empty.hidden = false; chat.hidden = true; reset.hidden = true; chat.replaceChildren(); });
  })();

  /* 014 失败重试：继续把中断的回答生成完 */
  (() => {
    const r = D('AP-CHAT-014'), b = $('[data-bubble]', r), fail = $('[data-fail]', r), btn = $('[data-retry]', r), rest = '，另 2 笔金额待确认。';
    btn.addEventListener('click', async () => { btn.classList.add('is-loading'); await sleep(900); btn.classList.remove('is-loading'); fail.hidden = true; await Lz.stream(b, rest, 30); Lz.toast('已重新生成', 'success'); });
  })();

  /* 015 历史会话：点选或回车切换当前会话 */
  (() => {
    const rows = $$('.row', D('AP-CHAT-015'));
    const pick = row => { rows.forEach(x => { const on = x === row; on ? x.setAttribute('aria-current', 'true') : x.removeAttribute('aria-current'); x.setAttribute('aria-selected', String(on)); }); };
    rows.forEach(row => { row.addEventListener('click', () => pick(row)); row.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(row); } }); });
  })();

  /* 016 上下文用量：追加对话占用上升，接近上限转警告，压缩后回落 */
  (() => {
    const r = D('AP-CHAT-016'), segs = $$('.cht-ctx i', r), vals = $$('[data-v]', r), total = $('[data-total]', r), tag = $('[data-tag]', r), bar = $('.cht-ctx', r), add = $('[data-add]', r); let v = [38, 16, 8];
    const paint = () => {
      const sum = v.reduce((a, n) => a + n, 0); segs.forEach((s, i) => s.style.setProperty('--w', v[i] + '%')); vals.forEach((e, i) => { e.textContent = v[i] + '%'; }); total.textContent = sum + '%'; bar.setAttribute('aria-label', `上下文用量 ${sum}%`);
      const st = sum >= 90 ? ['接近上限', 'danger'] : sum >= 75 ? ['建议压缩', 'warning'] : ['空间充足', 'success']; tag.textContent = st[0]; tag.dataset.tone = st[1]; add.disabled = sum >= 98;
    };
    add.addEventListener('click', () => { v[0] = Math.min(v[0] + 12, 98 - v[1] - v[2]); paint(); });
    $('[data-zip]', r).addEventListener('click', () => { v = [12, 10, 4]; paint(); Lz.toast('已压缩上下文', 'success'); });
  })();

  /* 017 停止钮：发送后变停止，点停止或自然结束后复原 */
  (() => {
    const r = D('AP-CHAT-017'), form = $('[data-form]', r), ta = $('textarea', form), btn = $('.cht-stop', r), reply = $('[data-reply]', r), ask = $('[data-ask]', reply), bubble = $('.msg:not(.msg--user) .bubble', reply), run = $('[data-run]', r), tag = $('[data-tag]', r), TEXT = '本周共 14 笔退款申请，12 笔与支付流水一致，另 2 笔金额待确认，已记入待办。'; let job = null, stopped = false;
    async function start() {
      stopped = false; ask.textContent = ta.value.trim() || '汇总本周退款金额'; ta.value = ''; reply.hidden = false; bubble.textContent = ''; tag.hidden = true; run.setAttribute('data-on', ''); btn.dataset.mode = 'stop'; btn.textContent = '停止'; btn.classList.remove('btn--primary');
      const mine = job = Lz.stream(bubble, TEXT, 16); await mine;
      run.removeAttribute('data-on'); btn.dataset.mode = 'send'; btn.textContent = '发送'; btn.classList.add('btn--primary'); tag.hidden = false; tag.textContent = stopped ? '已停止' : '已完成'; tag.dataset.tone = stopped ? 'warning' : 'success'; job = null;
    }
    form.addEventListener('submit', e => { e.preventDefault(); if (job) { stopped = true; job.cancel(); } else start(); });
    ta.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); if (!job) start(); } });
  })();

  /* 018 对话骨架：载入后骨架让位给真实消息 */
  (() => {
    const r = D('AP-CHAT-018'), skel = $('[data-skel]', r), real = $('[data-real]', r), btn = $('[data-toggle]', r); let loaded = false;
    btn.addEventListener('click', async () => {
      if (loaded) { loaded = false; real.hidden = true; skel.hidden = false; btn.textContent = '载入消息'; return; }
      btn.disabled = true; await sleep(900); skel.hidden = true; real.hidden = false; loaded = true; btn.disabled = false; btn.textContent = '重新加载';
    });
  })();

  /* 019 附件：添加与逐个移除，空时给空状态 */
  (() => {
    const r = D('AP-CHAT-019'), box = $('[data-files]', r), empty = $('[data-empty]', r), NAMES = ['对账单表格', '退款明细文档', '库存数据表', '门店照片']; let n = 0;
    const paint = () => { empty.hidden = box.children.length > 0; };
    const add = () => box.append(chipEl(NAMES[n++ % NAMES.length], c => { c.remove(); paint(); }));
    add(); add(); paint();
    $('[data-add]', r).addEventListener('click', () => { if (box.children.length >= 4) { Lz.toast('最多添加 4 个附件'); return; } add(); paint(); });
  })();
})();
</script>

<style>
  /* 新增组件的专属样式：前缀 cht-，每个组件一个子前缀 */

  /* 020 消息操作条 */
  .cht-ac-wrap { margin-left: calc(var(--s-2) * -1); }
  .cht-ac { display: flex; align-items: center; gap: 2px; }
  .cht-ac__sep { flex: none; width: 1px; height: 16px; margin: 0 var(--s-1); background: var(--line-strong); }
  .cht-ac__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); line-height: 1; white-space: nowrap; color: var(--ink-3); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .cht-ac__btn[data-cp] { min-width: 58px; }
  @media (hover: hover) { .cht-ac__btn:hover { background: var(--zone); color: var(--action-press); } }
  .cht-ac__btn[aria-pressed="true"] { background: var(--action-soft); color: var(--action-press); font-weight: 600; }
  .cht-ac__btn[data-done] { color: var(--success); font-weight: 600; }
  .cht-ac__btn:disabled { opacity: .45; pointer-events: none; }
  .cht-ac__why { display: flex; gap: var(--s-2); padding: var(--s-2) var(--s-2) 2px; }
  .cht-ac__why button { flex: none; min-height: 32px; padding: 0 var(--s-3); border: 1px solid var(--line); border-radius: var(--r-full); background: var(--surface); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .cht-ac__why button:hover { background: var(--zone); } }
  .cht-ac__why button[aria-pressed="true"] { background: var(--action-tint); color: var(--action-press); border-color: var(--action-edge); font-weight: 600; }

  /* 021 来源引用列表 */
  .cht-ref-wrap .cite { background: var(--action-edge); cursor: pointer; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .cht-ref-wrap .cite[aria-pressed="true"] { background: var(--action); color: var(--surface); }
  .cht-ref { border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; }
  .cht-ref__head { display: flex; align-items: center; gap: var(--s-2); width: 100%; min-height: 44px; padding: 0 var(--s-3); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .cht-ref__head:hover, .cht-ref__row:hover { background: var(--zone); } }
  .cht-ref__head .chev { margin-left: auto; }
  .cht-ref__stack { display: flex; }
  .cht-ref__stack img { width: 24px; height: 24px; padding: 3px; margin-left: -8px; border-radius: 50%; object-fit: contain; background: var(--surface); box-shadow: 0 0 0 2px var(--surface), inset 0 0 0 1px var(--line); }
  .cht-ref__stack img:first-child { margin-left: 0; }
  .cht-ref__list { border-top: 1px solid var(--line); }
  .cht-ref__list li + li { border-top: 1px solid var(--line); }
  .cht-ref__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: var(--s-3); width: 100%; min-height: 52px; padding: var(--s-2) var(--s-3); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  .cht-ref__row .cite { margin: 0; vertical-align: baseline; }
  .cht-ref__row[aria-current="true"] { background: var(--action-tint); }
  .cht-ref__row[aria-current="true"] .cite { background: var(--action); color: var(--surface); }
  .cht-ref__main { display: grid; min-width: 0; }
  .cht-ref__main .row__meta { margin-top: 2px; }
  .cht-ref__quote { margin: 0 var(--s-3) var(--s-3); padding: var(--s-2) var(--s-3); border-radius: var(--r-sm); background: var(--zone); font-size: var(--fs-sm); line-height: var(--lh-body); color: var(--ink-2); animation: lz-fade var(--dur-base) var(--ease-out) both; }

  /* 022 计划步骤卡 */
  .cht-pl__sum { display: flex; align-items: center; gap: var(--s-3); }
  .cht-pl__sum .progress { flex: 1; }
  .cht-pl__cnt { flex: none; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .cht-pl__list { display: grid; }
  .cht-pl__step { position: relative; display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: start; column-gap: var(--s-3); padding-bottom: var(--s-4); }
  .cht-pl__step:last-child { padding-bottom: 0; }
  .cht-pl__step::before { content: ""; position: absolute; left: 10px; top: 24px; bottom: 2px; border-left: 2px solid var(--line-strong); }
  .cht-pl__step:last-child::before { display: none; }
  .cht-pl__step[data-state="done"]::before { border-left-color: var(--success); }
  .cht-pl__dot { display: grid; place-items: center; width: 22px; height: 22px; border: 2px solid var(--line-strong); border-radius: 50%; background: var(--surface); }
  .cht-pl__dot img { grid-area: 1 / 1; width: 12px; height: 12px; filter: invert(1); opacity: 0; transition: opacity var(--dur-quick) var(--ease-out); }
  .cht-pl__step[data-state="done"] .cht-pl__dot { background: var(--success); border-color: var(--success); }
  .cht-pl__step[data-state="done"] .cht-pl__ok, .cht-pl__step[data-state="fail"] .cht-pl__no { opacity: 1; }
  .cht-pl__step[data-state="now"] .cht-pl__dot { border-color: var(--action-edge); border-top-color: var(--action); animation: lz-spin .9s linear infinite; }
  .cht-pl__step[data-state="fail"] .cht-pl__dot { background: var(--danger); border-color: var(--danger); }
  .cht-pl__step[data-state="fail"]::before { border-left-color: var(--danger); }
  .cht-pl__name { font-size: var(--fs-md); font-weight: 600; line-height: 22px; }
  .cht-pl__step[data-state="wait"] .cht-pl__name { font-weight: 400; color: var(--ink-3); }
  .cht-pl__meta { margin-top: 2px; font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-pl__step[data-state="fail"] .cht-pl__meta { color: var(--danger); }

  /* 023 澄清问答卡 */
  .cht-qa { gap: var(--s-4); }
  .cht-qa__prog { display: flex; gap: var(--s-1); }
  .cht-qa__prog i { flex: 1; height: 4px; border-radius: var(--r-full); background: var(--line-strong); transition: background var(--dur-base) var(--ease-out); }
  .cht-qa__prog i[data-s="done"] { background: var(--action); }
  .cht-qa__prog i[data-s="now"] { background: var(--action-edge); }
  .cht-qa__prog i[data-s="skip"] { background: var(--ink-3); opacity: .45; }
  .cht-qa__body { display: grid; gap: var(--s-4); }
  .cht-qa__body section { display: grid; gap: var(--s-3); }
  .cht-qa__pos { font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-qa .opt { width: 100%; cursor: pointer; font-size: var(--fs-md); }
  @media (hover: hover) { .cht-qa .opt:not([aria-checked="true"]):hover { background: var(--zone); } }
  .cht-qa .opt[role="checkbox"] .check { border-radius: 6px; }
  .cht-qa .opt[aria-checked="true"] .check { background: var(--action); border-color: var(--action); }
  .cht-qa .opt[aria-checked="true"] .check img { opacity: 1; transform: none; }
  .cht-qa .textarea { min-height: 88px; }
  .cht-qa__foot { display: flex; align-items: center; gap: var(--s-2); }
  .cht-qa__sp { flex: 1; }
  .cht-qa__done { display: grid; gap: var(--s-3); }
  .cht-qa__list { display: grid; }
  .cht-qa__list div { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: baseline; column-gap: var(--s-3); padding: var(--s-2) 0; border-top: 1px solid var(--line); }
  .cht-qa__list dt { font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-qa__list dd { font-size: var(--fs-md); font-weight: 600; overflow-wrap: anywhere; }
  .cht-qa__list dd[data-skip] { font-weight: 400; color: var(--ink-3); }

  /* 024 对话代码块 */
  .cht-cd { border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--elev-1); overflow: hidden; }
  .cht-cd__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-2) 0 var(--s-4); background: var(--zone); border-bottom: 1px solid var(--line); }
  .cht-cd__name { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .cht-cd__bar .btn--text[data-done] { color: var(--success); }
  .cht-cd__pre { margin: 0; overflow-x: auto; overflow-y: hidden; max-height: calc(22px * 8 + var(--s-3) + 4px); font-size: var(--fs-sm); line-height: 22px; white-space: normal; counter-reset: ln; scrollbar-width: thin; transition: max-height var(--dur-slow) var(--ease-out); }
  .cht-cd__pre[data-open="true"] { max-height: calc(22px * var(--n, 13) + var(--s-6)); }
  .cht-cd__pre code { display: block; width: max-content; min-width: 100%; padding: var(--s-3) 0; font: inherit; }
  .cht-cd__ln { display: block; white-space: pre; counter-increment: ln; }
  .cht-cd__ln::before { content: counter(ln); position: sticky; left: 0; display: inline-block; width: 40px; margin-right: var(--s-3); padding-right: var(--s-3); text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-3); background: var(--surface); }
  .cht-cd__t { padding: 0 var(--s-4) 0 calc(var(--d, 0) * 1.4em); }
  .cht-cd__t .k { font-weight: 600; color: var(--action-press); }
  .cht-cd__t .n { color: var(--info); }
  .cht-cd__t .d { color: var(--ink-3); }
  .cht-cd__more { display: block; width: 100%; min-height: 40px; border-top: 1px solid var(--line); font-size: var(--fs-sm); font-weight: 600; color: var(--action-press); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .cht-cd__more:hover { background: var(--zone); } }

  /* 025 文件树结构卡 */
  .cht-ft__tree, .cht-ft__tree ul { display: grid; gap: 2px; }
  .cht-ft__tree ul[role="group"] { animation: lz-fade var(--dur-base) var(--ease-out) both; }
  .cht-ft__row { display: flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-2) 0 calc(var(--s-2) + (var(--d, 1) - 1) * 20px); border-radius: var(--r-sm); font-size: var(--fs-md); cursor: pointer; transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .cht-ft__row:hover { background: var(--zone); } }
  .cht-ft__row img { flex: none; width: 20px; height: 20px; object-fit: contain; }
  .cht-ft__row .chev, .cht-ft__sp { flex: none; width: 9px; }
  .cht-ft__name { flex: 1; min-width: 0; }
  .cht-ft__row[aria-expanded] .cht-ft__name { font-weight: 600; }
  .cht-ft__row[aria-selected="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .cht-ft__row[aria-selected="true"] .cht-ft__name { font-weight: 600; color: var(--action-press); }
  .cht-ft__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 44px; padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .cht-ft__sel { min-width: 0; }
  .cht-ft__sel .row__title[data-name]:not([data-picked]) { font-weight: 400; color: var(--ink-3); }

  /* 026 对话检查点 */
  .cht-cp__mark { display: flex; align-items: center; gap: var(--s-2); min-height: 32px; }
  .cht-cp__mark::before, .cht-cp__mark::after { content: ""; flex: 1; border-top: 1px dashed var(--line-strong); }
  .cht-cp__mark .tag { flex: none; }
  .cht-cp__cur { display: none; font-size: var(--fs-sm); font-weight: 600; color: var(--action-press); white-space: nowrap; }
  .cht-cp__mark[data-cur] .cht-cp__cur { display: inline; }
  .cht-cp__mark[data-cur] [data-restore] { display: none; }
  .cht-cp__note { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-2) 0 var(--s-3); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-2); }

  /* 027 模型选择条 */
  .cht-md__foot { display: grid; }
  .cht-md__bar { display: flex; align-items: center; gap: var(--s-2); }
  .drop__btn[aria-expanded="true"]::after { transform: rotate(225deg) translateY(2px); }
  .cht-md .drop__btn[aria-expanded="true"] { background: var(--action-soft); }
  .cht-md .drop__btn { flex: none; white-space: nowrap; }
  .cht-md .drop__btn[disabled] { opacity: .5; pointer-events: none; }
  .cht-md__menu { display: grid; gap: 2px; margin-top: var(--s-2); padding-top: var(--s-2); border-top: 1px solid var(--line); animation: lz-fade var(--dur-base) var(--ease-out) both; }
  .cht-md__menu--row { grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-2); }
  .cht-md__opt { display: grid; grid-template-columns: minmax(0, 1fr) auto 18px; align-items: center; column-gap: var(--s-3); min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .cht-md__opt:hover, .cht-md__eff:hover { background: var(--zone); } }
  .cht-md__name { font-size: var(--fs-md); font-weight: 600; }
  .cht-md__meta { font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-md__opt img { width: 18px; height: 18px; opacity: 0; }
  .cht-md__opt[aria-selected="true"], .cht-md__eff[aria-selected="true"] { background: var(--action-tint); }
  .cht-md__opt[aria-selected="true"] img { opacity: 1; }
  .cht-md__opt[aria-selected="true"] .cht-md__name, .cht-md__eff[aria-selected="true"] { color: var(--action-press); }
  .cht-md__eff { min-height: 40px; border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out); }
  .cht-md__eff[aria-selected="true"] { background: var(--action); color: var(--surface); font-weight: 600; }

  /* 028 子智能体卡片 */
  .cht-sa__head { display: flex; align-items: center; gap: var(--s-3); }
  .cht-sa__who { flex: 1; min-width: 0; }
  .cht-sa__main { display: grid; }
  .cht-sa__res { padding: var(--s-3); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); line-height: var(--lh-body); color: var(--ink-2); }
  .cht-sa[data-state="fail"] .cht-sa__res { background: var(--danger-tint); color: color-mix(in srgb, var(--danger) 80%, black); }
  .cht-sa__prog { display: grid; gap: var(--s-2); padding: var(--s-3); border-radius: var(--r-md); background: var(--zone); }
  .cht-sa__prog .progress { background: var(--surface); }
  .cht-sa__now { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .cht-sa__now::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--action); animation: lz-blink 1s infinite; }
  .cht-sa__steps { padding: var(--s-3) var(--s-1) 0; }
  .cht-sa__steps li[data-state="fail"]::before { background: var(--danger); }
  .cht-sa__meta { font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }

  /* 029 回到最新消息钮 */
  .cht-bt__box { position: relative; }
  .cht-bt__view { height: 264px; padding: var(--s-4) var(--s-3); overflow-y: auto; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); scrollbar-width: thin; overscroll-behavior: contain; }
  .cht-bt__view .chat { padding: 0; gap: var(--s-4); }
  .cht-bt__jump { position: absolute; left: 50%; bottom: var(--s-3); transform: translateX(-50%); display: inline-flex; align-items: center; gap: var(--s-2); min-height: 36px; padding: 0 var(--s-4); border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong), var(--elev-2); font-size: var(--fs-sm); font-weight: 600; color: var(--action-press); white-space: nowrap; animation: lz-fade var(--dur-quick) var(--ease-out) both; }
  @media (hover: hover) { .cht-bt__jump:hover { background: var(--action-tint); } }
  .cht-bt__arr { width: 7px; height: 7px; border: solid currentColor; border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translateY(-2px); }

  /* 030 系统通知条 */
  .cht-nts { display: grid; gap: var(--s-2); }
  .cht-nts:empty { display: none; }
  .cht-nt { --c: var(--ink-3); --c-bg: var(--zone); display: flex; align-items: center; gap: var(--s-3); min-height: 60px; padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4); border-radius: var(--r-md); background: var(--c-bg); animation: lz-rise var(--dur-slow) var(--ease-out) both; }
  .cht-nt[data-tone="warning"] { --c: var(--warning); --c-bg: var(--warning-tint); }
  .cht-nt[data-tone="danger"] { --c: var(--danger); --c-bg: var(--danger-tint); }
  .cht-nt[data-tone="success"] { --c: var(--success); --c-bg: var(--success-tint); }
  .cht-nt[data-tone="info"] { --c: var(--info); --c-bg: var(--info-tint); }
  .cht-nt[data-leave] { animation: lz-toast-out var(--dur-quick) var(--ease-out) both; }
  .cht-nt__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .cht-nt[data-busy] .cht-nt__dot { animation: lz-blink 1s infinite; }
  .cht-nt__t { flex: 1; min-width: 0; }
  .cht-nt .btn--white[disabled] { background: var(--surface); color: var(--ink-3); opacity: .7; }
  .cht-nt .ibtn { flex: none; width: 32px; height: 32px; }
  .cht-nt .ibtn img { width: 14px; height: 14px; }
</style>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const el = html => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };
  const AVATAR = '../../kit/assets/marks/mark-007.webp';
  const setTone = (node, tone) => { if (tone) node.dataset.tone = tone; else node.removeAttribute('data-tone'); };
  const setOpen = (panel, btn, on) => { panel.dataset.open = String(on); panel.inert = !on; if (btn) btn.setAttribute('aria-expanded', String(on)); };
  const copyText = async text => {
    try { await navigator.clipboard.writeText(text); return true; } catch (e) { /* 改用选中复制 */ }
    try { const t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.cssText = 'position:fixed;opacity:0;pointer-events:none'; document.body.append(t); t.select(); const ok = document.execCommand('copy'); t.remove(); return ok; } catch (e) { return false; }
  };

  /* 020 消息操作条：复制变已复制；有用与没用互斥，没用就近展开原因；重新生成后清空评价 */
  (() => {
    const r = D('AP-CHAT-020'), b = $('[data-bubble]', r), copyBtn = $('[data-cp]', r), regen = $('[data-regen]', r), up = $('[data-vote="up"]', r), down = $('[data-vote="down"]', r), panel = $('.expand', r), reasons = $$('.cht-ac__why button', r), bar = $$('.cht-ac__btn', r);
    const TEXT = [b.textContent, '三家门店 128 笔订单中有 3 笔金额不一致，差额合计 286.50 元，其中 2 笔为重复扣款。']; let v = 0, timer;
    const press = (btn, on) => btn.setAttribute('aria-pressed', String(on));
    panel.inert = true;
    copyBtn.addEventListener('click', async () => {
      const ok = await copyText(b.textContent); clearTimeout(timer);
      if (!ok) { Lz.toast('复制失败', 'danger'); return; }
      copyBtn.textContent = '已复制'; copyBtn.setAttribute('data-done', '');
      timer = setTimeout(() => { copyBtn.textContent = '复制'; copyBtn.removeAttribute('data-done'); }, 1600);
    });
    up.addEventListener('click', () => { const on = up.getAttribute('aria-pressed') !== 'true'; press(up, on); press(down, false); reasons.forEach(x => press(x, false)); setOpen(panel, down, false); if (on) Lz.toast('已记录反馈', 'success'); });
    down.addEventListener('click', () => { const on = down.getAttribute('aria-pressed') !== 'true'; press(down, on); press(up, false); if (!on) reasons.forEach(x => press(x, false)); setOpen(panel, down, on); });
    reasons.forEach(x => x.addEventListener('click', () => { reasons.forEach(y => press(y, y === x)); Lz.toast('已记录反馈', 'success'); setTimeout(() => setOpen(panel, down, false), 280); }));
    regen.addEventListener('click', async () => {
      bar.forEach(x => { x.disabled = true; }); [up, down, ...reasons].forEach(x => press(x, false)); setOpen(panel, down, false);
      regen.textContent = '生成中'; b.textContent = ''; v = (v + 1) % TEXT.length;
      await Lz.stream(b, TEXT[v], 40); regen.textContent = '重新生成'; bar.forEach(x => { x.disabled = false; });
    });
  })();

  /* 021 来源引用列表：展开看全部来源，点一条就近看摘录；点正文角标直接定位 */
  (() => {
    const r = D('AP-CHAT-021'), head = $('.cht-ref__head', r), panel = $('.expand', r), rows = $$('.cht-ref__row', r), cites = $$('.cite[aria-pressed]', r);
    const show = i => {
      rows.forEach((row, k) => { const on = k === i; row.setAttribute('aria-expanded', String(on)); if (on) row.setAttribute('aria-current', 'true'); else row.removeAttribute('aria-current'); document.getElementById(row.getAttribute('aria-controls')).hidden = !on; });
      cites.forEach((c, k) => c.setAttribute('aria-pressed', String(k === i)));
    };
    rows.forEach((row, i) => row.addEventListener('click', () => show(row.getAttribute('aria-expanded') === 'true' ? -1 : i)));
    cites.forEach((c, i) => c.addEventListener('click', () => { if (c.getAttribute('aria-pressed') === 'true') { show(-1); return; } setOpen(panel, head, true); show(i); }));
  })();

  /* 022 计划步骤卡：下一步推进进行中的步骤；第四步首次失败，可重试 */
  (() => {
    const r = D('AP-CHAT-022'), steps = $$('.cht-pl__step', r), bar = $('[data-bar] > i', r), box = $('[data-bar]', r), tag = $('[data-tag]', r), count = $('[data-num]', r), next = $('[data-next]', r);
    const INIT = ['done', 'done', 'now', 'wait', 'wait'], LABEL = { done: ['已完成', 'success'], now: ['进行中', 'action'], wait: ['待开始', ''], fail: ['失败', 'danger'] };
    let S = [...INIT], failedOnce = false;
    const paint = () => {
      steps.forEach((li, i) => {
        li.dataset.state = S[i]; const [t, tone] = LABEL[S[i]], tg = $('.tag', li), m = $('.cht-pl__meta', li);
        tg.textContent = t; setTone(tg, tone);
        m.textContent = S[i] === 'done' ? li.dataset.done : S[i] === 'now' ? li.dataset.doing : S[i] === 'fail' ? li.dataset.fail : ''; m.hidden = !m.textContent;
      });
      const n = S.filter(s => s === 'done').length, all = n === S.length, bad = S.includes('fail');
      bar.style.setProperty('--v', (n / S.length * 100) + '%'); count.textContent = n; box.setAttribute('aria-label', `计划进度 ${n} 共 ${S.length} 步`);
      tag.textContent = all ? '已完成' : bad ? '遇到问题' : '进行中'; setTone(tag, all ? 'success' : bad ? 'danger' : 'action');
      next.textContent = bad ? '重试' : '下一步'; next.disabled = all;
    };
    next.addEventListener('click', () => {
      let i = S.indexOf('now'); if (i < 0) i = S.indexOf('fail'); if (i < 0) return;
      if (i === 3 && !failedOnce) { failedOnce = true; S[i] = 'fail'; paint(); Lz.toast('通知门店失败', 'danger'); return; }
      S[i] = 'done'; if (i + 1 < S.length) S[i + 1] = 'now'; paint();
    });
    $('[data-reset]', r).addEventListener('click', () => { S = [...INIT]; failedOnce = false; paint(); });
    paint();
  })();

  /* 023 澄清问答卡：逐题单选、多选、填写，每题可跳过；提交后看汇总，可重新回答 */
  (() => {
    const r = D('AP-CHAT-023'), qs = $$('[data-q]', r), segs = $$('.cht-qa__prog i', r), pos = $('[data-pos]', r), kind = $('[data-kind]', r), skip = $('[data-skip]', r), prev = $('[data-prev]', r), next = $('[data-next]', r), body = $('[data-body]', r), sum = $('[data-sum]', r), list = $('[data-list]', r);
    const KIND = ['单选', '多选', '选填'], KEY = ['时间段', '门店', '补充'], radios = $$('[role="radio"]', qs[0]), boxes = $$('[role="checkbox"]', qs[1]), ta = $('textarea', qs[2]);
    let i = 0; const skipped = [false, false, false];
    const answer = k => k === 0 ? radios.filter(o => o.getAttribute('aria-checked') === 'true').map(o => o.textContent.trim()) : k === 1 ? boxes.filter(o => o.getAttribute('aria-checked') === 'true').map(o => o.textContent.trim()) : ta.value.trim() ? [ta.value.trim()] : [];
    const paint = () => {
      qs.forEach((q, k) => { q.hidden = k !== i; });
      segs.forEach((s, k) => { s.dataset.s = k < i ? (skipped[k] ? 'skip' : 'done') : k === i ? 'now' : ''; });
      pos.textContent = `第 ${i + 1} 题 共 3 题`; kind.textContent = KIND[i]; prev.hidden = i === 0;
      next.textContent = i === 2 ? '提交' : '下一题'; next.disabled = i < 2 && answer(i).length === 0;
    };
    const finish = () => {
      list.replaceChildren(...KEY.map((k, n) => { const a = skipped[n] ? [] : answer(n), row = el('<div><dt></dt><dd></dd></div>'); $('dt', row).textContent = k; const dd = $('dd', row); dd.textContent = a.length ? a.join('、') : (skipped[n] ? '已跳过' : '未填写'); if (!a.length) dd.setAttribute('data-skip', ''); return row; }));
      body.hidden = true; sum.hidden = false; segs.forEach((s, k) => { s.dataset.s = skipped[k] ? 'skip' : 'done'; });
    };
    const go = () => { if (i === 2) { finish(); return; } i++; paint(); };
    radios.forEach(o => o.addEventListener('click', () => { radios.forEach(x => x.setAttribute('aria-checked', String(x === o))); paint(); }));
    r.addEventListener('lz:toggle', paint);
    ta.addEventListener('input', paint);
    next.addEventListener('click', () => { skipped[i] = false; go(); });
    skip.addEventListener('click', () => {
      skipped[i] = true; if (i === 0) radios.forEach(x => x.setAttribute('aria-checked', 'false')); else if (i === 1) boxes.forEach(x => x.setAttribute('aria-checked', 'false')); else ta.value = '';
      go();
    });
    prev.addEventListener('click', () => { if (i > 0) { i--; skipped[i] = false; paint(); } });
    $('[data-redo]', r).addEventListener('click', () => { i = 0; skipped.fill(false); sum.hidden = true; body.hidden = false; paint(); });
    paint();
  })();

  /* 024 代码块：复制整段，已复制提示；超过八行先折叠，左右可滑动 */
  (() => {
    const r = D('AP-CHAT-024'), btn = $('[data-cp]', r), lines = $$('.cht-cd__ln', r), pre = $('.cht-cd__pre', r), more = $('[data-more]', r); let timer;
    btn.addEventListener('click', async () => {
      const text = lines.map(l => '  '.repeat(+l.style.getPropertyValue('--d') || 0) + l.textContent.trim()).join('\n'), ok = await copyText(text); clearTimeout(timer);
      if (!ok) { Lz.toast('复制失败', 'danger'); return; }
      btn.textContent = '已复制'; btn.setAttribute('data-done', ''); timer = setTimeout(() => { btn.textContent = '复制'; btn.removeAttribute('data-done'); }, 1600);
    });
    more.addEventListener('click', () => { const on = pre.dataset.open !== 'true'; pre.dataset.open = String(on); more.setAttribute('aria-expanded', String(on)); more.textContent = on ? '收起' : `展开全部 ${lines.length} 行`; });
  })();

  /* 025 文件树：点文件夹展开收起，点文件选中；方向键走树，右键展开，左键收起 */
  (() => {
    const r = D('AP-CHAT-025'), tree = $('[role="tree"]', r), name = $('[data-name]', r), path = $('[data-path]', r), openBtn = $('[data-openfile]', r);
    const all = () => $$('[role="treeitem"]', tree), visible = () => all().filter(x => !x.closest('[role="group"][hidden]'));
    const group = row => { const g = row.nextElementSibling; return g && g.matches('[role="group"]') ? g : null; };
    const fold = (row, on) => { const g = group(row); if (!g) return; row.setAttribute('aria-expanded', String(on)); g.hidden = !on; };
    const focusRow = row => { all().forEach(x => { x.tabIndex = x === row ? 0 : -1; }); row.focus(); };
    const parentOf = row => { const g = row.closest('[role="group"]'); return g ? g.previousElementSibling : null; };
    const pick = row => {
      all().forEach(x => { if (x.hasAttribute('aria-selected')) x.setAttribute('aria-selected', String(x === row)); });
      const trail = []; for (let p = parentOf(row); p; p = parentOf(p)) trail.unshift($('.cht-ft__name', p).textContent);
      name.textContent = $('.cht-ft__name', row).textContent; name.setAttribute('data-picked', ''); path.textContent = trail.join(' '); path.hidden = false; openBtn.disabled = false;
    };
    const act = row => { if (row.hasAttribute('aria-expanded')) fold(row, row.getAttribute('aria-expanded') !== 'true'); else pick(row); };
    tree.addEventListener('click', e => { const row = e.target.closest('[role="treeitem"]'); if (!row) return; focusRow(row); act(row); });
    tree.addEventListener('keydown', e => {
      const row = e.target.closest('[role="treeitem"]'); if (!row) return; const vis = visible(), i = vis.indexOf(row), exp = row.getAttribute('aria-expanded');
      const to = x => { if (x) { e.preventDefault(); focusRow(x); } };
      if (e.key === 'ArrowDown') to(vis[i + 1]); else if (e.key === 'ArrowUp') to(vis[i - 1]); else if (e.key === 'Home') to(vis[0]); else if (e.key === 'End') to(vis[vis.length - 1]);
      else if (e.key === 'ArrowRight') { e.preventDefault(); if (exp === 'false') fold(row, true); else if (exp === 'true') to(vis[i + 1]); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); if (exp === 'true') fold(row, false); else to(parentOf(row)); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(row); }
    });
    $$('[data-all]', r).forEach(b => b.addEventListener('click', () => all().forEach(x => { if (x.hasAttribute('aria-expanded')) fold(x, b.dataset.all === 'open'); })));
    openBtn.addEventListener('click', () => Lz.toast('已打开 ' + name.textContent));
  })();

  /* 026 检查点：恢复前居中确认，恢复后丢弃其后消息并可撤销；也可在末尾再标记检查点 */
  (() => {
    const r = D('AP-CHAT-026'), flow = $('[data-flow]', r), note = $('[data-note]', r), text = $('[data-text]', note), mark = $('[data-mark]', r); let removed = [], at = null;
    const marks = () => $$('.cht-cp__mark', flow);
    const clearCur = () => marks().forEach(m => { m.removeAttribute('data-cur'); setTone($('.tag', m), 'info'); });
    flow.addEventListener('click', async e => {
      const b = e.target.closest('[data-restore]'); if (!b) return;
      const m = b.closest('.cht-cp__mark'), after = [...flow.children].slice([...flow.children].indexOf(m) + 1), n = after.filter(x => x.classList.contains('msg')).length;
      if (!after.length) return;
      const ok = await Lz.confirm({ title: `恢复到${$('.tag', m).textContent}`, body: `此处之后的 ${n} 条消息会被丢弃`, ok: '恢复', cancel: '取消' }); if (!ok) return;
      removed = after; at = m; after.forEach(x => x.remove()); clearCur(); m.setAttribute('data-cur', ''); setTone($('.tag', m), 'action');
      text.textContent = `已丢弃 ${n} 条消息`; note.hidden = false;
    });
    $('[data-undo]', r).addEventListener('click', () => { if (!at) return; flow.append(...removed); removed = []; at = null; clearCur(); note.hidden = true; Lz.toast('已撤销恢复'); });
    mark.addEventListener('click', () => {
      const last = flow.lastElementChild; if (last && last.classList.contains('cht-cp__mark') && !last.hasAttribute('data-cur')) { Lz.toast('此处已有检查点'); return; }
      if (marks().length >= 4) { Lz.toast('最多 4 个检查点'); return; }
      note.hidden = true; removed = []; at = null; clearCur();
      flow.append(el(`<div class="cht-cp__mark cht-in" data-n="${marks().length + 1}"><span class="tag" data-tone="info">检查点 ${marks().length + 1}</span><button class="btn btn--text btn--sm" data-restore>恢复到此处</button><span class="cht-cp__cur">当前位置</span></div>`));
    });
  })();

  /* 027 模型选择条：两个菜单就近内嵌展开；轻量模型不支持思考，强度固定为关闭并置灰 */
  (() => {
    const r = D('AP-CHAT-027'), form = $('[data-form]', r), ta = $('textarea', form), send = $('[data-send]', r), panel = $('.expand', r), btns = { model: $('[data-pick="model"]', r), effort: $('[data-pick="effort"]', r) }, menus = { model: $('[data-menu="model"]', r), effort: $('[data-menu="effort"]', r) };
    const MODELS = [['花间轻量', false], ['花间一号', true], ['花间二号', true]], EFF = ['关闭', '低', '中', '高']; let m = 2, e = 2, cur = null;
    panel.inert = true;
    const mark = (menu, i) => $$('[role="option"]', menu).forEach((o, k) => o.setAttribute('aria-selected', String(k === i)));
    const paint = () => {
      $('b', btns.model).textContent = MODELS[m][0]; const think = MODELS[m][1];
      btns.effort.disabled = !think; $('b', btns.effort).textContent = think ? EFF[e] : '关闭'; mark(menus.model, m); mark(menus.effort, e);
    };
    const show = k => {
      if (k === cur || !k) { cur = null; setOpen(panel, null, false); } else { cur = k; setOpen(panel, null, true); }
      Object.keys(menus).forEach(x => { menus[x].hidden = x !== cur; btns[x].setAttribute('aria-expanded', String(x === cur)); });
    };
    Object.keys(btns).forEach(k => btns[k].addEventListener('click', () => show(k)));
    $$('[role="option"]', menus.model).forEach(o => o.addEventListener('click', () => { const was = MODELS[m][1]; m = +o.dataset.i; if (!MODELS[m][1]) e = 0; else if (!was) e = 2; paint(); show(null); btns.model.focus(); }));
    $$('[role="option"]', menus.effort).forEach(o => o.addEventListener('click', () => { e = +o.dataset.i; paint(); show(null); btns.effort.focus(); }));
    form.addEventListener('keydown', ev => { if (ev.key === 'Escape' && cur) { const k = cur; show(null); btns[k].focus(); } });
    const sync = () => { send.disabled = ta.value.trim() === ''; };
    const submit = () => { if (send.disabled) return; ta.value = ''; ta.style.height = ''; sync(); Lz.toast(`已用${MODELS[m][0]}发送`, 'success'); };
    ta.addEventListener('input', () => { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; sync(); });
    ta.addEventListener('keydown', ev => { if (ev.key === 'Enter' && !ev.shiftKey && !ev.isComposing && ev.keyCode !== 229) { ev.preventDefault(); submit(); } });
    form.addEventListener('submit', ev => { ev.preventDefault(); submit(); });
    paint(); sync();
  })();

  /* 028 子智能体：重新委派后逐步执行，可中途停止；第一次委派在第二步失败，点重试后成功 */
  (() => {
    const r = D('AP-CHAT-028'), card = $('.cht-sa', r), tag = $('[data-tag]', r), prog = $('[data-prog]', r), bar = $('.progress > i', r), now = $('[data-now]', r), res = $('[data-res]', r), meta = $('[data-meta]', r), act = $('[data-act]', r), steps = $$('.think__steps li', r), proc = $('[data-expand]', r), panel = $('.expand', r);
    const NAMES = steps.map(li => li.textContent.trim()), VIEW = { run: ['进行中', 'action'], done: ['已完成', 'success'], fail: ['失败', 'danger'], stop: ['已停止', 'warning'] };
    let runs = 0, token = 0;
    const view = st => {
      card.dataset.state = st; tag.textContent = VIEW[st][0]; setTone(tag, VIEW[st][1]); prog.hidden = st !== 'run'; res.hidden = st !== 'done' && st !== 'fail';
      act.textContent = st === 'run' ? '停止' : st === 'fail' ? '重试' : '重新委派'; act.className = 'btn btn--sm ' + (st === 'run' ? 'btn--ghost' : 'btn--secondary');
    };
    async function start() {
      const my = ++token; runs++; const failing = runs === 1, t0 = performance.now();
      view('run'); setOpen(panel, proc, true); steps.forEach(li => { li.dataset.state = ''; }); meta.textContent = '共 3 步';
      for (let k = 0; k < steps.length; k++) {
        steps[k].dataset.state = 'now'; now.textContent = NAMES[k]; bar.style.setProperty('--v', (k / steps.length * 100 + 8) + '%');
        await sleep(900); if (my !== token) return;
        if (failing && k === 1) { steps[k].dataset.state = 'fail'; res.textContent = '第 2 步调用订单查询超时，已保留前一步结果。'; meta.textContent = '已中断'; view('fail'); return; }
        steps[k].dataset.state = 'done';
      }
      res.textContent = '发现 3 笔金额不一致，差额合计 286.50 元，其中 2 笔为重复扣款。'; meta.textContent = `用时 ${Math.max(1, Math.round((performance.now() - t0) / 1000))} 秒`; view('done');
    }
    act.addEventListener('click', () => { if (card.dataset.state === 'run') { token++; meta.textContent = '已停止'; view('stop'); } else start(); });
    view('done');
  })();

  /* 029 回到最新：向上翻阅超过一屏出现按钮；翻阅时来新回复累计数量；点按钮回到底部 */
  (() => {
    const r = D('AP-CHAT-029'), view = $('.cht-bt__view', r), flow = $('.chat', view), jump = $('[data-jump]', r), badge = $('[data-n]', r), add = $('[data-reply]', r);
    const NEW = ['对账结果已回写到三家门店', '已同步 128 笔订单状态', '退款进度已更新', '库存缺口清单已生成']; let unread = 0, k = 0, ready = false;
    const gap = () => view.scrollHeight - view.scrollTop - view.clientHeight;
    const sync = () => { const far = gap() > 48; if (!far) unread = 0; jump.hidden = !far; badge.hidden = unread === 0; badge.textContent = unread + ' 条新回复'; };
    view.addEventListener('scroll', sync, { passive: true });
    jump.addEventListener('click', () => { view.scrollTo({ top: view.scrollHeight, behavior: Lz.reduce ? 'auto' : 'smooth' }); view.focus({ preventScroll: true }); });
    add.addEventListener('click', () => {
      const atEnd = gap() <= 48, m = el(`<article class="msg cht-in"><img class="msg__avatar" src="${AVATAR}" alt=""><div class="msg__body"><p class="bubble"></p></div></article>`);
      $('.bubble', m).textContent = NEW[k++ % NEW.length]; flow.append(m);
      if (atEnd) view.scrollTop = view.scrollHeight; else { unread++; sync(); }
    });
    new ResizeObserver(() => { if (!ready && view.clientHeight > 0) { ready = true; view.scrollTop = view.scrollHeight * 0.42; } sync(); }).observe(view);
  })();

  /* 030 系统通知条：额度可申请，断线可重连，逐条关闭，全部关闭显示空态 */
  (() => {
    const r = D('AP-CHAT-030'), list = $('[data-list]', r), empty = $('[data-empty]', r), INIT = list.innerHTML;
    const paint = () => { empty.hidden = list.children.length > 0; };
    const fill = (n, tone, t, m) => { n.dataset.tone = tone; $('[data-t]', n).textContent = t; $('[data-m]', n).textContent = m; };
    list.addEventListener('click', async e => {
      const n = e.target.closest('.cht-nt'); if (!n) return;
      if (e.target.closest('[data-close]')) { n.setAttribute('data-leave', ''); setTimeout(() => { n.remove(); paint(); }, Lz.reduce ? 0 : 160); return; }
      const b = e.target.closest('[data-do]'); if (!b) return;
      if (n.dataset.kind === 'quota') { fill(n, 'success', '额度申请已提交', '审核通过后自动生效'); b.remove(); return; }
      b.disabled = true; n.setAttribute('data-busy', ''); fill(n, 'warning', '正在重连', '第 1 次尝试'); await sleep(1300);
      if (!n.isConnected) return; n.removeAttribute('data-busy'); fill(n, 'success', '已恢复连接', '可继续对话'); b.remove();
    });
    $('[data-reset]', r).addEventListener('click', () => { list.innerHTML = INIT; paint(); });
    paint();
  })();
})();
</script>
