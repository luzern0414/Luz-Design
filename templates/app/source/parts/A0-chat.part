<!-- cat: CHAT | 智能体 -->
<style>
  .cht-log:empty { display: none; }
  /* 智能体组件专属样式：前缀 cht-，基础结构来自共用的对话样式 */
  .cht-wrap { display: grid; gap: var(--s-3); }
  .cht-card { display: grid; gap: var(--s-3); padding: var(--s-4); }
  .cht-chat.chat { padding: 0; gap: var(--s-4); }
  .cht-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .cht-bar--end { justify-content: flex-end; }
  .cht-acts { display: flex; align-items: center; gap: var(--s-1); }
  .cht-acts .btn--text { min-height: 32px; font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-acts .btn--text:hover { color: var(--action-press); }
  .msg__body > .cht-acts { margin-left: calc(var(--s-2) * -1); }
  .cht-user > .cht-acts { margin-right: var(--s-2); }
  .cht-user { display: grid; justify-items: end; gap: var(--s-1); max-width: 88%; }
  .cht-user .bubble { max-width: 100%; }
  .cht-user[data-editing] { width: 100%; max-width: 100%; }
  .cht-edit { display: grid; gap: var(--s-2); width: 100%; }
  .cht-edit .textarea { min-height: 72px; }
  .cht-in { animation: lz-rise var(--dur-slow) var(--ease-out) both; }
  /* 用户气泡：共用底色与舞台几乎同色，这里加深一档 */
  [data-cid^="AP-CHAT"] .msg--user .bubble { background: var(--action-edge); }
  .cht-ava { width: 36px; height: 36px; border-radius: 50%; }
  .cht-note { padding: var(--s-2) 0; font-size: var(--fs-sm); color: var(--ink-3); text-align: center; }
  [data-cid^="AP-CHAT"] .skel { background: linear-gradient(100deg, color-mix(in srgb, var(--action) 11%, var(--surface)) 30%, color-mix(in srgb, var(--action) 4%, var(--surface)) 50%, color-mix(in srgb, var(--action) 11%, var(--surface)) 70%) 0 0 / 200% 100%; animation: lz-shimmer 1.4s linear infinite; }

  /* 思考过程与工具 */
  .cht-think .think { box-shadow: var(--elev-1); }
  .cht-tools .tool { min-height: 36px; }
  .cht-tools .tool[data-state="wait"]::before { background: var(--line-strong); }
  .cht-io { margin-top: var(--s-2); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .cht-io p + p { margin-top: 2px; }
  .cht-k { margin-right: var(--s-2); font-weight: 600; color: var(--ink-3); }

  /* 审批 */
  .cht-appr .approval { box-shadow: var(--elev-1); }
  .cht-appr .btn-group { justify-content: flex-end; }
  .cht-appr__res { display: none; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .cht-appr .approval[data-state="done"] .cht-appr__res { display: flex; }
  .cht-appr .approval[data-state="done"] .btn-group { display: none; }
  .cht-appr .approval[data-state="done"] { opacity: 1; pointer-events: auto; }

  /* 任务行 */
  .cht-task { width: 100%; text-align: left; cursor: pointer; transition: background var(--dur-quick) var(--ease-out); }
  .cht-task:hover { background: var(--zone); }
  .cht-task .tag { min-width: 56px; justify-content: center; }
  .cht-task .tag[data-tone="action"] { background: var(--action-edge); }
  .cht-task__t { min-width: 0; }

  /* 产物 */
  .cht-art { grid-template-columns: auto 1fr auto; row-gap: 0; box-shadow: var(--elev-1); }
  .cht-art > .expand { grid-column: 1 / -1; }
  .cht-diff { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 44px; border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-2); }
  .cht-art > .expand > div > .cht-diff:first-child { margin-top: var(--s-3); }
  .cht-diff .price { font-size: var(--fs-md); }

  /* 引用 */
  .cht-cite-wrap .cite { background: var(--action-edge); cursor: pointer; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .cht-cite-wrap .cite[aria-pressed="true"] { background: var(--action); color: var(--surface); }
  .cht-src { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: var(--s-3); padding: var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .cht-src img { width: 36px; height: 36px; object-fit: contain; }
  .cht-src[hidden] { display: none; }

  /* 输入栏、建议、附件 */
  .cht-log { display: grid; gap: var(--s-3); min-height: 56px; align-content: end; }
  .cht-chip { display: inline-flex; align-items: center; gap: var(--s-1); max-width: 100%; min-height: 32px; padding: 0 var(--s-1) 0 var(--s-3); border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .cht-chip .ibtn { width: 28px; height: 28px; }
  .cht-chip .ibtn img { width: 14px; height: 14px; }
  .cht-files { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .cht-sug .suggest { padding-bottom: 2px; }
  .cht-sug .suggest:not([data-end]) { mask-image: linear-gradient(90deg, var(--ink) calc(100% - 32px), transparent); }
  .cht-sug .suggest button[aria-pressed="true"] { background: var(--action-tint); color: var(--action-press); border-color: var(--action-edge); font-weight: 600; }
  .cht-prompt .prompt { box-shadow: var(--elev-1); }

  /* 排队 */
  .cht-q { display: grid; gap: var(--s-2); }
  .cht-q__row { display: flex; align-items: center; gap: var(--s-3); min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); font-size: var(--fs-sm); }
  .cht-q__row span:first-child { flex: 1; min-width: 0; }

  /* 空会话 */
  .cht-empty { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-1) 0; text-align: center; }
  .cht-empty__art { position: relative; display: grid; place-items: center; width: 132px; height: 112px; }
  .cht-empty__art::before { content: ""; position: absolute; inset: 4px 10px 0; border-radius: 50%; background: radial-gradient(closest-side, var(--action-tint) 55%, transparent 100%); }
  .cht-empty__art img { position: relative; width: 88px; height: 88px; object-fit: contain; filter: drop-shadow(0 8px 10px color-mix(in srgb, var(--ink) 14%, transparent)); }
  .cht-empty .suggest { flex-wrap: wrap; justify-content: center; overflow: visible; }

  /* 失败 */
  .cht-fail { display: flex; align-items: center; gap: var(--s-2); }

  /* 历史会话 */
  .cht-hist .row { cursor: pointer; }
  .cht-hist .row .row__lead { border-radius: 50%; }
  .cht-hist .row[aria-current="true"] { background: var(--action-tint); }
  .cht-hist .row[aria-current="true"] .row__title { color: var(--action-press); }

  /* 上下文用量 */
  .cht-ctx { display: flex; height: 12px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; gap: 2px; }
  .cht-ctx i { display: block; height: 100%; width: var(--w, 0%); background: var(--c); transition: width var(--dur-slow) var(--ease-out); }
  .cht-ctx i:first-child { border-radius: var(--r-full) 0 0 var(--r-full); }
  .cht-legend { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); }
  .cht-legend div { display: grid; gap: 2px; font-size: var(--fs-sm); color: var(--ink-3); }
  .cht-legend b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cht-legend i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; background: var(--c); }
  .cht-num { display: flex; align-items: baseline; gap: var(--s-1); }
  .cht-num b { font-size: var(--fs-2xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .cht-num span { font-size: var(--fs-sm); color: var(--ink-3); }

  /* 停止钮 */
  .cht-stop[data-mode="stop"] { background: var(--ink); color: var(--bg); box-shadow: none; }
  .cht-run { display: none; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .cht-run[data-on] { display: inline-flex; }
</style>

<article class="demo" data-cid="AP-CHAT-001" data-name="用户消息气泡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">用户消息气泡</span></div>
  <p class="demo__note">适合：用户发出的提问，可复制可编辑</p>
  <div class="demo__stage">
    <div class="chat cht-chat">
      <div class="msg msg--user">
        <div class="cht-user">
          <div class="bubble" data-bubble><p>核对上周三家门店的对账差异</p></div>
          <div class="cht-edit" data-editbox hidden><textarea class="textarea" aria-label="修改消息"></textarea><div class="btn-group" style="justify-content:flex-end"><button class="btn btn--ghost btn--sm" data-cancel>取消</button><button class="btn btn--primary btn--sm" data-save>保存</button></div></div>
          <div class="cht-acts" data-acts><button class="btn btn--text btn--sm" data-copy>复制</button><button class="btn btn--text btn--sm" data-edit>编辑</button></div>
        </div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-002" data-name="智能体回答气泡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">智能体回答气泡</span></div>
  <p class="demo__note">适合：智能体的文字回答，带头像与重新生成</p>
  <div class="demo__stage">
    <div class="chat cht-chat">
      <article class="msg">
        <img class="msg__avatar" src="../../kit/assets/marks/mark-007.webp" alt="">
        <div class="msg__body">
          <p class="bubble" data-bubble>已比对三家门店 128 笔订单，发现 3 笔金额不一致，差额合计 286.50 元。</p>
          <div class="cht-acts"><button class="btn btn--text btn--sm" data-copy>复制</button><button class="btn btn--text btn--sm" data-regen>重新生成</button></div>
        </div>
      </article>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-003" data-name="思考过程折叠" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">思考过程折叠</span></div>
  <p class="demo__note">适合：展示推理步骤，进行中展开，完成后收起</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-think">
      <div class="think">
        <button class="think__head" data-expand="cht-th-1" aria-expanded="false"><span data-head>已思考 6 秒</span></button>
        <div class="expand" id="cht-th-1"><div>
          <ul class="think__steps">
            <li data-state="done"><span>读取三家门店对账单</span></li>
            <li data-state="done"><span>逐笔比对订单金额</span></li>
            <li data-state="done"><span>汇总差异并生成结果</span></li>
          </ul>
        </div></div>
      </div>
      <div class="cht-bar cht-bar--end"><button class="btn btn--secondary btn--sm" data-play>重新思考</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-004" data-name="工具调用标签" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">工具调用标签</span></div>
  <p class="demo__note">适合：显示调用了哪些工具及状态</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-tools">
      <div>
        <div class="tools">
          <button class="tool" data-state="done" aria-expanded="false" aria-controls="cht-io-1">查询订单</button>
          <button class="tool" data-state="run" aria-expanded="false" aria-controls="cht-io-2">汇总金额</button>
          <button class="tool" data-state="wait" aria-expanded="false" aria-controls="cht-io-3">导出文件</button>
        </div>
        <div class="tool__io cht-io" id="cht-io-1" hidden><p><span class="cht-k">输入</span>三家门店 近七日</p><p><span class="cht-k">输出</span><span data-out>128 笔订单</span></p></div>
        <div class="tool__io cht-io" id="cht-io-2" hidden><p><span class="cht-k">输入</span>128 笔订单</p><p><span class="cht-k">输出</span><span data-out>进行中</span></p></div>
        <div class="tool__io cht-io" id="cht-io-3" hidden><p><span class="cht-k">输入</span>对账结果</p><p><span class="cht-k">输出</span><span data-out>等待中</span></p></div>
      </div>
      <div class="cht-bar cht-bar--end"><button class="btn btn--secondary btn--sm" data-run>继续运行</button><button class="btn btn--ghost btn--sm" data-reset>重置</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-005" data-name="流式文字气泡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">流式文字气泡</span></div>
  <p class="demo__note">适合：回答逐字出现，带光标，可随时停止</p>
  <div class="demo__stage">
    <div class="cht-wrap">
      <article class="msg">
        <img class="msg__avatar" src="../../kit/assets/marks/mark-007.webp" alt="">
        <div class="msg__body"><p class="bubble" data-bubble aria-live="polite">本周共 14 笔退款申请，12 笔与支付流水一致，另 2 笔金额待确认。</p></div>
      </article>
      <div class="cht-bar"><span class="tag" data-tone="success" data-tag>已完成</span><div class="btn-group"><button class="btn btn--secondary btn--sm" data-play>播放</button><button class="btn btn--ghost btn--sm" data-stop disabled>停止</button></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-006" data-name="审批确认卡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">审批确认卡</span></div>
  <p class="demo__note">适合：执行有影响的动作前让用户批准</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-appr">
      <div class="approval">
        <p class="approval__q">确认 2 笔重复扣款的退款方式</p>
        <div class="approval__opts" role="radiogroup" aria-label="退款方式">
          <button class="opt" role="radio" aria-checked="true"><span class="check" aria-checked="true" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span>原路退回</button>
          <button class="opt" role="radio" aria-checked="false"><span class="check" aria-checked="false" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span>退回门店余额</button>
          <button class="opt" role="radio" aria-checked="false"><span class="check" aria-checked="false" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span>转人工处理</button>
        </div>
        <div class="btn-group"><button class="btn btn--ghost" data-act="reject">拒绝</button><button class="btn btn--primary" data-act="approve">批准</button></div>
        <div class="cht-appr__res"><span class="tag" data-tag>已批准</span><span data-res></span><button class="btn btn--text btn--sm" data-reset style="margin-left:auto">重置</button></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-007" data-name="任务状态行" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">任务状态行</span></div>
  <p class="demo__note">适合：智能体拆出的待办，点一行推进状态</p>
  <div class="demo__stage">
    <div class="card list">
      <button class="task cht-task" data-s="1"><img class="task__ic" src="../../kit/assets/solid/bill.webp" alt=""><div class="cht-task__t"><p class="row__title one-line">补录重复扣款</p><p class="row__meta">2 笔</p></div><span class="tag" data-tone="action">进行中</span></button>
      <button class="task cht-task" data-s="0"><img class="task__ic" src="../../kit/assets/solid/biz-store.webp" alt=""><div class="cht-task__t"><p class="row__title one-line">通知门店核对</p><p class="row__meta">3 家门店</p></div><span class="tag">待处理</span></button>
      <button class="task cht-task" data-s="2"><img class="task__ic" src="../../kit/assets/solid/order.webp" alt=""><div class="cht-task__t"><p class="row__title one-line">回写订单状态</p><p class="row__meta">128 笔</p></div><span class="tag" data-tone="success">已完成</span></button>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-008" data-name="产物文件卡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">产物文件卡</span></div>
  <p class="demo__note">适合：智能体生成的结果文件，就近展开看明细</p>
  <div class="demo__stage">
    <div class="artifact cht-art">
      <img class="task__ic" src="../../kit/assets/solid/biz-review.webp" alt="">
      <div><p class="row__title one-line">对账结果</p><p class="row__meta">3 笔差异 刚刚</p></div>
      <button class="btn btn--secondary btn--sm" data-expand="cht-art-1">打开</button>
      <div class="expand" id="cht-art-1"><div>
        <div class="cht-diff"><span>单号 10321 重复扣款</span><span class="price"><small>¥</small>128.00</span></div>
        <div class="cht-diff"><span>单号 10377 重复扣款</span><span class="price"><small>¥</small>98.50</span></div>
        <div class="cht-diff"><span>单号 10402 金额不符</span><span class="price"><small>¥</small>60.00</span></div>
      </div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-009" data-name="引用来源角标" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">引用来源角标</span></div>
  <p class="demo__note">适合：回答中的数字角标，点开就近看出处</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-cite-wrap">
      <p class="bubble">已比对三家门店 128 笔订单<button class="cite" data-tip="对账单 第 3 页" aria-label="引用 1 对账单" aria-pressed="false" data-i="0">1</button>，发现 3 笔金额不一致，其中 2 笔为重复扣款<button class="cite" data-tip="订单明细 第 12 行" aria-label="引用 2 订单明细" aria-pressed="false" data-i="1">2</button>。</p>
      <div class="cht-src" role="status" hidden><img src="../../kit/assets/solid/biz-notes.webp" alt=""><div><p class="row__title" data-name>对账单</p><p class="row__meta" data-where>第 3 页 三家门店汇总</p></div></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-010" data-name="对话输入栏" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">对话输入栏</span></div>
  <p class="demo__note">适合：多行输入，空内容不可发送，回车发送</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-prompt">
      <div class="cht-log" data-log></div>
      <form class="prompt" data-form>
        <div class="cht-files" data-files hidden></div>
        <textarea rows="1" placeholder="输入消息" aria-label="输入消息" enterkeyhint="send"></textarea>
        <div class="prompt__bar">
          <button type="button" class="ibtn" data-attach data-tip="添加附件" aria-label="添加附件"><img src="../../kit/assets/line/upload.webp" alt=""></button>
          <button type="button" class="ibtn" data-mic data-tip="语音输入" aria-label="语音输入" aria-pressed="false"><img src="../../kit/assets/line/mic.webp" alt=""></button>
          <span class="dots" data-dots hidden aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="prompt__sp"></span>
          <button type="submit" class="btn btn--primary" data-send disabled>发送</button>
        </div>
      </form>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-011" data-name="建议问法条" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">建议问法条</span></div>
  <p class="demo__note">适合：输入栏上方的一键问法，横向滑动</p>
  <div class="demo__stage">
    <div class="cht-wrap cht-sug">
      <div class="cht-log" data-log></div>
      <div class="suggest" aria-label="建议问法">
        <button aria-pressed="false" data-q="核对上周三家门店的对账差异">核对对账差异</button>
        <button aria-pressed="false" data-q="汇总本周退款金额">汇总退款金额</button>
        <button aria-pressed="false" data-q="查看库存低于安全线的商品">查看库存缺口</button>
        <button aria-pressed="false" data-q="导出对账结果文件">导出对账结果</button>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-012" data-name="排队提示条" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">排队提示条</span></div>
  <p class="demo__note">适合：智能体生成中，用户追加的问题排队等待</p>
  <div class="demo__stage">
    <div class="cht-wrap">
      <div class="cht-bar"><span class="tag" data-tone="warning" data-tag>排队 2 条</span><div class="btn-group"><button class="btn btn--secondary btn--sm" data-add>再问一条</button><button class="btn btn--ghost btn--sm" data-clear>清空</button></div></div>
      <div class="cht-q" data-list aria-label="排队中的问题">
        <div class="cht-q__row"><span class="one-line">汇总本周退款金额</span><span class="tag">第 1 位</span></div>
        <div class="cht-q__row"><span class="one-line">查看库存缺口</span><span class="tag">第 2 位</span></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-CHAT-013" data-name="空会话占位" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">空会话占位</span></div>
