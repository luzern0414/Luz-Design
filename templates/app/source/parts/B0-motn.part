<article class="demo" data-cid="AP-MOTN-014" data-name="卡片尺寸变化" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">卡片尺寸变化</span></div>
  <p class="demo__note">适合：图文卡在紧凑与大图之间切换</p>
  <div class="demo__stage">
    <div class="mot-card">
      <div class="mot-box"><article class="card mot-size" data-size><img class="mot-size__img" src="../../kit/assets/photo/scene-hero-pink.webp" alt=""><div class="mot-size__body"><div><p class="row__title">春日鲜花节</p><p class="row__meta">同城 2 小时送达</p></div><button class="btn btn--secondary btn--sm" data-flip aria-pressed="false">放大</button></div></article></div>
      <div class="mot-foot"><div class="mot-spec" data-spec="时长:--dur-slow,曲线:--ease-out"></div><button class="btn btn--secondary btn--sm" data-play>播放</button></div>
    </div>
  </div>
</article>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const tok = n => parseFloat(getComputedStyle(document.documentElement).getPropertyValue(n));
  const restart = (el, prop = 'animation') => { el.style[prop] = 'none'; void el.offsetWidth; el.style[prop] = ''; };
  const EASE = { '--ease-out': '先快后慢', '--ease-in-out': '缓入缓出', '--ease-spring': '弹性回弹' };

  /* 参数标签：时长与曲线取自令牌，换令牌后这里自动跟着变 */
  $$('[data-cid^="AP-MOTN"] [data-spec]').forEach(box => {
    box.innerHTML = box.dataset.spec.split(',').map(pair => {
      const [k, v] = pair.split(':'); let val = v;
      if (v.startsWith('--ease')) val = EASE[v];
      else if (v.startsWith('--')) { const [t, f = 1] = v.split('*'); val = `${tok(t) * f} 毫秒`; }
      return `<span class="tag">${k} ${val}</span>`;
    }).join('');
  });

  const play = {};
  const mount = (cid, fn) => { play[cid] = () => fn(D(cid)); };

  /* 001 数字滚动 */
  mount('AP-MOTN-001', root => Lz.count($('[data-n]', root), 12860, tok('--dur-slow') * 2));
  /* 002 徽标弹入：数字加一并重播弹入 */
  mount('AP-MOTN-002', root => { const b = $('.badge', root); b.textContent = (+b.textContent % 9) + 1; restart(b); });
  /* 003 展开收起：点行头 */
  mount('AP-MOTN-003', root => $('.row', root).click());
  /* 004 卡片按压：模拟一次按下 */
  mount('AP-MOTN-004', async root => { const c = $('.mot-press', root); c.classList.add('is-pressed'); await sleep(tok('--dur-quick') + 160); c.classList.remove('is-pressed'); });
  /* 005 成功勾选 */
  mount('AP-MOTN-005', root => { const r = $('.mot-ring', root); r.removeAttribute('data-play'); void r.offsetWidth; r.setAttribute('data-play', ''); });
  /* 006 输入抖动 */
  mount('AP-MOTN-006', root => { const i = $('.input', root), err = $('.field__err', root); i.value = '138001380'; i.setAttribute('aria-invalid', 'true'); err.hidden = false; i.classList.remove('shake'); void i.offsetWidth; i.classList.add('shake'); i.focus(); });
  /* 007 骨架转内容 */
  mount('AP-MOTN-007', async root => {
    const box = $('.mot-skd', root), sk = $$('[data-s="skel"]', box), ct = $$('[data-s="content"]', box);
    sk.forEach(e => { e.hidden = false; }); ct.forEach(e => { e.hidden = true; e.classList.remove('reveal'); delete e.dataset.in; });
    await sleep(1200); sk.forEach(e => { e.hidden = true; }); ct.forEach((e, i) => { e.hidden = false; e.classList.add('reveal'); e.style.setProperty('--i', i); e.dataset.in = ''; });
  });
  /* 008 流式文字 */
  mount('AP-MOTN-008', async root => { const p = $('[data-stream]', root), b = $('[data-play]', root), text = p.dataset.full || (p.dataset.full = p.textContent); p.textContent = ''; b.disabled = true; await Lz.stream(p, text, 30); b.disabled = false; });
  /* 009 悬浮说明：隐藏后再浮现 */
  mount('AP-MOTN-009', async root => { const w = $('.mot-tipwrap', root); w.removeAttribute('data-show'); await sleep(450); w.setAttribute('data-show', ''); });
  /* 010 弹性开关 */
  mount('AP-MOTN-010', root => $('.switch', root).click());
  /* 011 列表错峰入场：取消再加回入场状态，行距由错峰令牌决定 */
  mount('AP-MOTN-011', root => { const rows = $$('.row', root); rows.forEach(r => r.removeAttribute('data-in')); void root.offsetWidth; rows.forEach(r => r.setAttribute('data-in', '')); });
  /* 012 视图切换：列表与详情互换，返回键与列表行也能触发 */
  (() => {
    const root = D('AP-MOTN-012'), list = $('[data-v="list"]', root), detail = $('[data-v="detail"]', root);
    let busy = false;
    /* 两个视图高度不同时，容器取较高者，切换时舞台不跳动 */
    const views = $('.mot-views', root);
    const fit = () => { views.style.minHeight = ''; const hs = [list, detail].map(v => { const was = v.hidden; v.hidden = false; const h = v.offsetHeight; v.hidden = was; return h; }); views.style.minHeight = Math.max.apply(null, hs) + 'px'; };
    fit(); new ResizeObserver(fit).observe(root);
    const swap = async (from, to) => { if (busy) return; busy = true; from.setAttribute('data-leave', ''); await sleep(tok('--dur-quick')); from.hidden = true; from.removeAttribute('data-leave'); to.hidden = false; restart(to); to.setAttribute('data-enter', ''); await sleep(tok('--dur-base')); to.removeAttribute('data-enter'); busy = false; };
    $$('[data-go]', root).forEach(b => b.addEventListener('click', () => swap(list, detail)));
    $('[data-back]', root).addEventListener('click', () => swap(detail, list));
    play['AP-MOTN-012'] = () => (list.hidden ? swap(detail, list) : swap(list, detail));
  })();
  /* 013 标签滑动指示 */
  (() => {
    const root = D('AP-MOTN-013'), tabs = $$('[role="tab"]', root), ind = $('.mot-tabs__ind', root), pane = $('.mot-pane', root), bar = $('.mot-tabs', root); let cur = 0;
    const go = i => {
      cur = i; tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      const t = tabs[i]; ind.style.setProperty('--x', t.offsetLeft + 'px'); ind.style.setProperty('--w', t.offsetWidth + 'px');
      pane.innerHTML = `<b>${t.dataset.n}</b> 笔${t.textContent === '全部' ? '订单' : t.textContent + '订单'}`; restart(pane);
    };
    tabs.forEach((t, i) => { t.addEventListener('click', () => go(i)); t.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; const n = (i + d + tabs.length) % tabs.length; tabs[n].focus(); go(n); e.preventDefault(); }); });
    new ResizeObserver(() => go(cur)).observe(bar); go(0);
    play['AP-MOTN-013'] = () => go((cur + 1) % tabs.length);
  })();
  /* 014 卡片尺寸变化：放大按钮与播放共用同一状态 */
  (() => {
    const root = D('AP-MOTN-014'), card = $('[data-size]', root), btn = $('[data-flip]', root);
    const set = big => { card.toggleAttribute('data-big', big); btn.setAttribute('aria-pressed', String(big)); btn.textContent = big ? '缩小' : '放大'; };
    btn.addEventListener('click', () => set(!card.hasAttribute('data-big')));
    play['AP-MOTN-014'] = () => set(!card.hasAttribute('data-big'));
  })();

  document.addEventListener('click', e => {
    const t = e.target.closest('[data-cid^="AP-MOTN"] [data-toast]'); if (t) { Lz.toast(t.dataset.toast, 'success'); return; }
    const b = e.target.closest('[data-cid^="AP-MOTN"] .mot-foot [data-play]'); if (!b) return;
    const fn = play[b.closest('[data-cid]').dataset.cid]; if (fn) fn();
  });

  /* 入场：数字与成功勾选在进入视野时先播一次，其余保持终态 */
  const o = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { o.unobserve(e.target); play[e.target.dataset.cid](); } }), { threshold: .5 });
  ['AP-MOTN-001', 'AP-MOTN-005'].forEach(c => o.observe(D(c)));
})();
</script>

<article class="demo" data-cid="AP-MOTN-015" data-name="轮播滑动切换" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">轮播滑动切换</span></div>
