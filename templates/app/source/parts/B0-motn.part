        <div class="card motx-pr__body" role="status" aria-live="polite">
          <div class="motx-pr__grip"></div>
          <div class="stats">
            <div class="stat"><span class="stat__label">待付款</span><span class="stat__val"><span data-n>4</span><small>单</small></span></div>
            <div class="stat"><span class="stat__label">待发货</span><span class="stat__val"><span data-n data-live>12</span><small>单</small></span></div>
            <div class="stat"><span class="stat__label">待收货</span><span class="stat__val"><span data-n>7</span><small>单</small></span></div>
          </div>
          <div class="list">
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title one-line">红玫瑰花束</p><p class="row__meta">待发货</p></div><span class="price"><small>¥</small>199</span></div>
            <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div class="row__main"><p class="row__title one-line">粉芍药花束</p><p class="row__meta">待收货</p></div><span class="price"><small>¥</small>239</span></div>
          </div>
        </div>
      </div></div>
      <div class="mot-foot"><div class="mot-spec" data-spec="阈值:60 像素,曲线:--ease-spring"></div><button class="btn btn--secondary btn--sm" data-play>播放</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-MOTN-019" data-name="页码点切换" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">页码点切换</span></div>
  <p class="demo__note">适合：当前页圆点随轮播平滑移动</p>
  <div class="demo__stage">
    <div class="mot-card">
      <div class="mot-box"><div class="motx-pg">
        <div class="card motx-pg__view"><img src="../../kit/assets/photo/scene-hero-pink.webp" alt="" draggable="false"><div class="motx-pg__cap"><span class="row__title" data-cap>春日鲜花节</span><span class="t-sub" data-num>1 / 5</span></div></div>
        <div class="motx-pg__bar">
          <button class="ibtn" data-prev aria-label="上一张" data-tip="上一张"><img src="../../kit/assets/line/back.webp" alt=""></button>
          <div class="motx-pgd" role="tablist" aria-label="页码"><span class="motx-pgd__ind"></span>
            <button role="tab" aria-selected="true" aria-label="第 1 张"></button><button role="tab" aria-selected="false" aria-label="第 2 张"></button><button role="tab" aria-selected="false" aria-label="第 3 张"></button><button role="tab" aria-selected="false" aria-label="第 4 张"></button><button role="tab" aria-selected="false" aria-label="第 5 张"></button>
          </div>
          <button class="ibtn" data-next aria-label="下一张" data-tip="下一张"><img class="motx-flip" src="../../kit/assets/line/back.webp" alt=""></button>
        </div>
      </div></div>
      <div class="mot-foot"><div class="mot-spec" data-spec="时长:--dur-base,曲线:--ease-out"></div><button class="btn btn--secondary btn--sm" data-play>播放</button></div>
    </div>
  </div>
</article>

<style>
  /* 新增 015 至 019：前缀 motx-。时长与曲线全部取令牌变量 */
  .motx-car, .motx-pg, .motx-dk, .motx-pr, .motx-dd { width: 100%; min-width: 0; }

  /* 015 轮播滑动切换：露出左右相邻项，当前项放大，首尾循环 */
  .motx-car__vp { position: relative; overflow: hidden; border-radius: var(--r-lg); touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  .motx-car__vp[data-drag] { cursor: grabbing; }
  .motx-car__track { position: relative; display: flex; gap: var(--s-3); padding: var(--s-1) 0 var(--s-3); transition: transform var(--dur-slow) var(--ease-out); }
  .motx-car__vp[data-drag] .motx-car__track { transition: none; }
  .motx-slide { flex: 0 0 82%; overflow: hidden; opacity: .55; transform: scale(.94); transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out); }
  .motx-slide[data-cur] { opacity: 1; transform: none; }
  .motx-slide img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  .motx-slide__body { padding: var(--s-3) var(--s-4); }
  .motx-dots { display: flex; align-items: center; justify-content: center; gap: var(--s-1); margin-top: var(--s-1); }
  .motx-dots button { display: grid; place-items: center; width: 24px; height: 24px; border-radius: var(--r-full); }
  .motx-dots button::before { content: ""; width: 8px; height: 8px; border-radius: 4px; background: var(--line-strong); transition: width var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .motx-dots button[aria-selected="true"]::before { width: 20px; background: var(--action); }

  /* 016 面板锚点停靠：三个锚点，松手按位置与速度停靠到最近一档，回弹落位 */
  .motx-dk { position: relative; display: grid; grid-template-rows: minmax(0, 1fr) auto; height: 300px; overflow: hidden; border-radius: var(--r-lg); box-shadow: inset 0 0 0 1px var(--line); }
  .motx-dk__van { align-self: start; justify-self: center; width: 44px; height: 44px; margin-top: var(--s-3); object-fit: contain; }
  .motx-dk__g { position: absolute; left: 0; right: 0; bottom: var(--b, 0px); border-top: 1px dashed var(--line-strong); transition: border-color var(--dur-base) var(--ease-out); }
  .motx-dk__g i { position: absolute; right: var(--s-3); bottom: 4px; font-style: normal; font-size: var(--fs-xs); color: var(--ink-3); }
  .motx-dk__g[data-on] { border-top-color: var(--action); }
  .motx-dk__g[data-on] i { color: var(--action-press); font-weight: 600; }
  .motx-dk__panel { position: relative; z-index: 2; display: grid; grid-template-rows: auto minmax(0, 1fr); height: var(--h, 150px); overflow: hidden; border-radius: var(--r-xl) var(--r-xl) 0 0; background: var(--surface); box-shadow: var(--elev-3); transition: height var(--dur-slow) var(--ease-spring); }
  .motx-dk[data-drag] .motx-dk__panel { transition: none; }
  .motx-dk__top { padding: 0 var(--s-4) var(--s-3); touch-action: none; user-select: none; -webkit-user-select: none; cursor: grab; }
  .motx-dk[data-drag] .motx-dk__top { cursor: grabbing; }
  .motx-dk__grip { display: grid; place-items: center; width: 88px; height: 24px; margin: 0 auto; border-radius: var(--r-sm); }
  .motx-dk__grip i { display: block; width: 36px; height: 4px; border-radius: 4px; background: var(--line-strong); }
  .motx-dk__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .motx-dk__body { padding: var(--s-1) var(--s-4) 0; overflow: hidden; }
  .motx-dk__body .tl__item { align-items: start; }
  .motx-dk__body .tl__item[data-state="now"] .row__title { color: var(--action-press); }
  .motx-dk__body .tl__item:not([data-state]) .row__title { color: var(--ink-3); font-weight: 400; }

  /* 017 三点加载跳动：三个点依次起跳，错峰由令牌决定 */
  .motx-dot3 { display: inline-flex; align-items: center; gap: 5px; height: 16px; }
  .motx-dot3 i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: motx-hop calc(var(--dur-slow) * 3) var(--ease-in-out) infinite; }
  .motx-dot3 i:nth-child(2) { animation-delay: calc(var(--stagger) * 3); }
  .motx-dot3 i:nth-child(3) { animation-delay: calc(var(--stagger) * 6); }
  @keyframes motx-hop { 0%, 60%, 100% { transform: translateY(0); opacity: .4; } 30% { transform: translateY(-5px); opacity: 1; } }
  .motx-dd { overflow: hidden; }
  .motx-dd__r { display: flex; align-items: center; justify-content: center; min-height: 72px; padding: var(--s-3) var(--s-4); }
  .motx-dd__r + .motx-dd__r { border-top: 1px solid var(--line); }
  .motx-dd__bw { position: relative; display: inline-flex; align-items: center; justify-content: center; }
  .motx-dd__btn { min-width: 148px; transition: color var(--dur-quick) var(--ease-out), background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
  .motx-dd__bw .motx-dot3 { position: absolute; inset: 0; margin: auto; width: max-content; color: var(--surface); opacity: 0; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out); }
  .motx-dd__bw[data-busy] .motx-dd__btn { color: transparent; pointer-events: none; }
  .motx-dd__bw[data-busy] .motx-dot3 { opacity: 1; }
  .motx-dd__more { gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); }
  .motx-dd__more .motx-dot3 { color: var(--action); }
  .motx-dd .msg { align-items: center; width: auto; grid-template-columns: 36px auto; }
  .motx-typing { display: inline-flex; align-items: center; min-height: 40px; padding: 0 var(--s-4); border-radius: var(--r-xl) var(--r-xl) var(--r-xl) var(--r-sm); background: var(--zone); color: var(--ink-3); }

  /* 018 下拉回弹刷新：指示环随下拉填满，松手后回弹到刷新位，完成后回弹归位 */
  .motx-pr { position: relative; overflow: hidden; border-radius: var(--r-lg); touch-action: none; user-select: none; -webkit-user-select: none; cursor: grab; }
  .motx-pr[data-drag] { cursor: grabbing; }
  .motx-pr__ind { position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: center; justify-content: center; gap: var(--s-2); height: 60px; font-size: var(--fs-sm); color: var(--ink-2); opacity: var(--o, 0); }
  .motx-pr__ring { width: 26px; height: 26px; border-radius: 50%; background: conic-gradient(var(--action) calc(var(--p, 0) * 1%), var(--action-edge) 0); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), var(--ink) calc(100% - 2.5px)); mask: radial-gradient(farthest-side, transparent calc(100% - 3px), var(--ink) calc(100% - 2.5px)); transition: transform var(--dur-base) var(--ease-spring); }
  .motx-pr[data-st="ready"] .motx-pr__ring { transform: scale(1.18); }
  .motx-pr[data-st="busy"] .motx-pr__ring { animation: lz-spin .8s linear infinite; }
  .motx-pr__ok { display: none; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--success); }
  .motx-pr__ok img { width: 14px; height: 14px; filter: invert(1); }
  .motx-pr[data-st="done"] .motx-pr__ring { display: none; }
  .motx-pr[data-st="done"] .motx-pr__ok { display: grid; animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .motx-pr__body { position: relative; transform: translateY(var(--y, 0px)); transition: transform var(--dur-slow) var(--ease-spring); }
  .motx-pr[data-drag] .motx-pr__body { transition: none; }
  .motx-pr__body [data-n] { display: inline-block; }
  .motx-pr__body .list { border-top: 1px solid var(--line); }
  .motx-pr__grip { width: 36px; height: 4px; margin: var(--s-2) auto 0; border-radius: 4px; background: var(--line-strong); }

  /* 019 页码点切换：当前点先拉长再收拢，平滑移到目标位置 */
  .motx-pg { display: grid; gap: var(--s-2); }
  .motx-pg__view { overflow: hidden; }
  .motx-pg__view img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; animation: lz-fade var(--dur-base) var(--ease-out) both; }
  .motx-pg__cap { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); }
  .motx-pg__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .motx-pg__bar .ibtn[aria-disabled="true"] { opacity: .3; pointer-events: none; }
  .motx-flip { transform: scaleX(-1); }
  .motx-pgd { position: relative; display: flex; align-items: center; gap: var(--s-1); }
  .motx-pgd button { display: grid; place-items: center; width: 24px; height: 32px; }
  .motx-pgd button::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .motx-pgd__ind { position: absolute; z-index: 1; left: 0; top: 50%; width: var(--w, 8px); height: 8px; margin-top: -4px; border-radius: 4px; background: var(--action); transform: translateX(var(--x, 0px)); transition: transform var(--dur-base) var(--ease-out), width var(--dur-base) var(--ease-out); pointer-events: none; }
</style>

<script>
(function () {
  const { $, $$ } = Lz;
  const D = cid => document.querySelector(`[data-cid="${cid}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, Lz.reduce ? 0 : ms));
  const tok = n => parseFloat(getComputedStyle(document.documentElement).getPropertyValue(n));
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const restart = (el, prop = 'animation') => { el.style[prop] = 'none'; void el.offsetWidth; el.style[prop] = ''; };
  const play = {};
  const PH = '../../kit/assets/photo/';

  /* 横向拖动：以横向位移为准，竖向滚动让给页面；拖动结束后短暂标记，便于忽略随后的点击 */
  function drag(host, { move, end, guard }) {
    let id = null, x0 = 0, y0 = 0, lx = 0, lt = 0, vx = 0, on = false;
    host.addEventListener('pointerdown', e => { if (e.button > 0 || (guard && guard())) return; id = e.pointerId; x0 = lx = e.clientX; y0 = e.clientY; lt = performance.now(); vx = 0; on = false; });
    host.addEventListener('pointermove', e => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!on) { if (Math.abs(dx) < 6) return; if (Math.abs(dy) > Math.abs(dx)) { id = null; return; } on = true; host.setPointerCapture(e.pointerId); host.setAttribute('data-drag', ''); }
      const t = performance.now(); vx = .7 * vx + .3 * ((e.clientX - lx) / Math.max(1, t - lt)); lx = e.clientX; lt = t; move(dx);
    });
    const up = e => { if (e.pointerId !== id) return; id = null; if (!on) return; on = false; host.removeAttribute('data-drag'); host._dragged = true; setTimeout(() => { host._dragged = false; }, 0); end(e.clientX - x0, vx); };
    host.addEventListener('pointerup', up); host.addEventListener('pointercancel', up);
  }

  /* 015 轮播滑动切换：两端各复制两张实现无缝循环；松手按距离与速度决定去留，缓动落位 */
  (() => {
    const root = D('AP-MOTN-015'), vp = $('.motx-car__vp', root), track = $('.motx-car__track', vp), dots = $$('.motx-dots button', root);
    const src = $$('.motx-slide', track), n = src.length, K = 2;
    const mk = s => { const c = s.cloneNode(true); c.setAttribute('aria-hidden', 'true'); return c; };
    track.prepend(...src.slice(-K).map(mk)); track.append(...src.slice(0, K).map(mk));
    const all = $$('.motx-slide', track); let i = K, busy = false;
    const logical = j => (((j - K) % n) + n) % n;
    const offset = j => -all[j].offsetLeft + (vp.clientWidth - all[j].offsetWidth) / 2;
    const apply = (j, anim) => {
      if (!anim) track.style.transition = 'none';
      track.style.transform = `translateX(${offset(j)}px)`;
      const l = logical(j); all.forEach((s, k) => s.toggleAttribute('data-cur', logical(k) === l));
      dots.forEach((d, k) => { d.setAttribute('aria-selected', String(k === l)); d.tabIndex = k === l ? 0 : -1; });
      if (!anim) { void track.offsetWidth; track.style.transition = ''; }
    };
    async function go(j) {
      if (busy) return; busy = true; i = j; apply(i, true);
      await sleep(tok('--dur-slow') + 40);
      if (i < K) i += n; else if (i >= K + n) i -= n;
      apply(i, false); busy = false;
    }
    drag(vp, {
      guard: () => busy,
      move: dx => { track.style.transform = `translateX(${offset(i) + dx}px)`; },
      end: (dx, v) => { const w = all[i].offsetWidth; const d = dx < -w * .2 || v < -.4 ? 1 : dx > w * .2 || v > .4 ? -1 : 0; if (d) go(i + d); else apply(i, true); }
    });
    all.forEach((s, k) => s.addEventListener('click', () => { if (vp._dragged || k === i) return; go(k); }));
    dots.forEach((d, k) => d.addEventListener('click', () => go(K + k)));
    vp.addEventListener('keydown', e => { const d = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (d) { e.preventDefault(); go(i + d); } });
    new ResizeObserver(() => apply(i, false)).observe(vp); apply(i, false);
    play['AP-MOTN-015'] = () => go(i + 1);
  })();

  /* 016 面板锚点停靠：拖动手柄，松手后按位置与速度停靠到收起、半屏、展开；虚线标出三个锚点 */
  (() => {
    const root = D('AP-MOTN-016'), box = $('.motx-dk', root), panel = $('.motx-dk__panel', box), top = $('[data-top]', box), grip = $('[role="slider"]', box), now = $('[data-now]', box), gs = $$('.motx-dk__g', box);
    const LAB = ['收起', '半屏', '展开']; let A = [], at = 1;
    const calc = () => { const H = box.clientHeight, it = $$('.tl__item', box); A = [top.offsetHeight + 4, it[2].offsetTop, H - 64]; gs.forEach((g, k) => g.style.setProperty('--b', A[k] + 'px')); };
    const set = k => { at = clamp(k, 0, 2); panel.style.setProperty('--h', A[at] + 'px'); now.textContent = LAB[at]; grip.setAttribute('aria-valuenow', at); grip.setAttribute('aria-valuetext', LAB[at]); gs.forEach((g, j) => g.toggleAttribute('data-on', j === at)); };
    let id = null, y0 = 0, h0 = 0, ly = 0, lt = 0, vy = 0, moved = false;
    top.addEventListener('pointerdown', e => { if (e.button > 0) return; id = e.pointerId; top.setPointerCapture(id); y0 = ly = e.clientY; h0 = panel.offsetHeight; lt = performance.now(); vy = 0; moved = false; });
    top.addEventListener('pointermove', e => {
      if (e.pointerId !== id) return; const dy = e.clientY - y0;
      if (!moved) { if (Math.abs(dy) < 5) return; moved = true; box.setAttribute('data-drag', ''); document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })); }
      const t = performance.now(); vy = .7 * vy + .3 * ((e.clientY - ly) / Math.max(1, t - lt)); ly = e.clientY; lt = t;
      let h = h0 - dy; if (h < A[0]) h = A[0] - (A[0] - h) * .3; if (h > A[2]) h = A[2] + (h - A[2]) * .3; panel.style.setProperty('--h', h + 'px');
    });
    const up = e => {
      if (e.pointerId !== id) return; id = null;
      if (!moved) { set(at < 2 ? at + 1 : 0); return; }
      box.removeAttribute('data-drag'); const proj = panel.offsetHeight - vy * 160;
      set(A.reduce((b, v, k) => (Math.abs(v - proj) < Math.abs(A[b] - proj) ? k : b), 0));
    };
    top.addEventListener('pointerup', up); top.addEventListener('pointercancel', up);
    grip.addEventListener('keydown', e => { const d = { ArrowUp: 1, ArrowDown: -1 }[e.key]; if (d) { e.preventDefault(); set(at + d); } else if (e.key === 'Home') { e.preventDefault(); set(0); } else if (e.key === 'End') { e.preventDefault(); set(2); } else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(at < 2 ? at + 1 : 0); } });
    new ResizeObserver(() => { calc(); set(at); }).observe(box); calc(); set(1);
    play['AP-MOTN-016'] = () => set(at < 2 ? at + 1 : 0);
  })();

  /* 017 三点加载跳动：按钮内点后三点接管文字，列表底部与对话中常驻 */
  (() => {
    const root = D('AP-MOTN-017'), btn = $('[data-btn]', root), bw = $('[data-bw]', root); let busy = false;
    async function run() { if (busy) return; busy = true; bw.setAttribute('data-busy', ''); btn.setAttribute('aria-busy', 'true'); await sleep(1500); bw.removeAttribute('data-busy'); btn.removeAttribute('aria-busy'); busy = false; Lz.toast('订单已提交', 'success'); }
    btn.addEventListener('click', run); play['AP-MOTN-017'] = run;
  })();

  /* 018 下拉回弹刷新：阻尼下拉，超过阈值松手回弹到刷新位，完成后对勾替换指示环并回弹归位 */
  (() => {
    const root = D('AP-MOTN-018'), box = $('[data-pr]', root), body = $('.motx-pr__body', box), ring = $('.motx-pr__ring', box), lab = $('[data-lab]', box), live = $('[data-live]', box);
    const TH = 60, MAX = 104; let y0 = null, pull = 0, busy = false, n = +live.textContent;
    const setY = v => body.style.setProperty('--y', v + 'px');
    const paint = (p, s, text) => { ring.style.setProperty('--p', p); box.style.setProperty('--o', Math.min(1, p / 60)); box.dataset.st = s; lab.textContent = text; };
    async function refresh() {
      busy = true; setY(TH); paint(28, 'busy', '刷新中'); box.style.setProperty('--o', 1);
      await sleep(1100);
      n++; live.textContent = n; live.style.animation = 'none'; void live.offsetWidth; live.style.animation = 'lz-pop var(--dur-slow) var(--ease-spring) both';
      paint(100, 'done', '刷新完成'); box.style.setProperty('--o', 1); await sleep(700);
      setY(0); await sleep(tok('--dur-slow')); busy = false; paint(0, 'idle', '下拉刷新'); live.style.animation = '';
    }
    box.addEventListener('pointerdown', e => { if (busy || e.button > 0) return; y0 = e.clientY; box.setPointerCapture(e.pointerId); box.setAttribute('data-drag', ''); });
    box.addEventListener('pointermove', e => {
      if (y0 == null) return; const dy = Math.max(0, e.clientY - y0), p = dy * .55; pull = Math.min(MAX, p <= TH ? p : TH + (p - TH) * .35);
      setY(pull); paint(Math.min(100, pull / TH * 100), pull >= TH ? 'ready' : 'pull', pull >= TH ? '松开刷新' : '下拉刷新');
    });
    const end = () => { if (y0 == null) return; y0 = null; box.removeAttribute('data-drag'); if (pull >= TH) refresh(); else { setY(0); paint(0, 'idle', '下拉刷新'); } pull = 0; };
    box.addEventListener('pointerup', end); box.addEventListener('pointercancel', end);
    play['AP-MOTN-018'] = async () => { if (busy) return; setY(TH + 24); paint(100, 'ready', '松开刷新'); await sleep(520); refresh(); };
  })();

  /* 019 页码点切换：目标点先把当前点拉长，再收成圆点落位；点圆点、前后按钮或播放都能切换 */
  (() => {
    const root = D('AP-MOTN-019'), img = $('.motx-pg__view img', root), cap = $('[data-cap]', root), num = $('[data-num]', root), bar = $('.motx-pgd', root), ind = $('.motx-pgd__ind', root), dots = $$('[role="tab"]', bar), prev = $('[data-prev]', root), next = $('[data-next]', root);
    const P = [['scene-hero-pink', '春日鲜花节'], ['bouquet-rose', '玫瑰花礼'], ['bouquet-tulip', '郁金香上新'], ['bouquet-white', '白色花礼'], ['product-monstera', '龟背竹到店']], N = P.length, DOT = 8;
    let cur = 0, tick = 0;
    const pos = k => dots[k].offsetLeft + (dots[k].offsetWidth - DOT) / 2;
    const rest = k => { ind.style.setProperty('--x', pos(k) + 'px'); ind.style.setProperty('--w', DOT + 'px'); };
    function paint() {
      dots.forEach((d, k) => { d.setAttribute('aria-selected', String(k === cur)); d.tabIndex = k === cur ? 0 : -1; });
      img.src = `${PH}${P[cur][0]}.webp`; restart(img); cap.textContent = P[cur][1]; num.textContent = `${cur + 1} / ${N}`;
      prev.setAttribute('aria-disabled', String(cur === 0)); next.setAttribute('aria-disabled', String(cur === N - 1));
    }
    async function go(j) {
      j = clamp(j, 0, N - 1); if (j === cur) return; const a = pos(cur), b = pos(j), me = ++tick; cur = j; paint();
      ind.style.setProperty('--x', Math.min(a, b) + 'px'); ind.style.setProperty('--w', Math.abs(b - a) + DOT + 'px');
      await sleep(tok('--dur-base') * .5); if (me !== tick) return; rest(cur);
    }
    dots.forEach((d, k) => { d.addEventListener('click', () => go(k)); d.addEventListener('keydown', e => { const s = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (!s) return; e.preventDefault(); const t = clamp(cur + s, 0, N - 1); go(t); dots[t].focus(); }); });
    prev.addEventListener('click', () => go(cur - 1)); next.addEventListener('click', () => go(cur + 1));
    new ResizeObserver(() => rest(cur)).observe(bar); rest(cur);
    play['AP-MOTN-019'] = () => go(cur < N - 1 ? cur + 1 : 0);
  })();

  document.addEventListener('click', e => {
    const b = e.target.closest('[data-cid^="AP-MOTN"] .mot-foot [data-play]'); if (!b) return;
    const fn = play[b.closest('[data-cid]').dataset.cid]; if (fn) fn();
  });
})();
</script>

<article class="demo" data-cid="AP-MOTN-020" data-name="空间层叠" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">空间层叠</span></div>
  <div class="demo__stage">
    <div class="three-motion" data-three-motion>
      <div class="three-motion__stage" aria-hidden="true"><span class="three-motion__still"></span></div>
      <div class="three-motion__controls">
        <button class="btn btn--secondary btn--sm" type="button" data-three-play aria-label="播放空间层叠动画">播放</button>
        <span role="status"></span>
      </div>
    </div>
  </div>
</article>
