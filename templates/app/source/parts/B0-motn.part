    <div class="mot-card">
      <div class="mot-box"><div class="motx-car">
        <div class="motx-car__vp" tabindex="0" role="region" aria-roledescription="轮播" aria-label="活动轮播">
          <div class="motx-car__track">
            <div class="card motx-slide"><img src="../../kit/assets/photo/scene-hero-pink.webp" alt="" draggable="false"><div class="motx-slide__body"><p class="row__title one-line">春日鲜花节</p><p class="row__meta one-line">同城 2 小时送达</p></div></div>
            <div class="card motx-slide"><img src="../../kit/assets/photo/bouquet-tulip.webp" alt="" draggable="false"><div class="motx-slide__body"><p class="row__title one-line">郁金香上新</p><p class="row__meta one-line">限量 200 束</p></div></div>
            <div class="card motx-slide"><img src="../../kit/assets/photo/bouquet-white.webp" alt="" draggable="false"><div class="motx-slide__body"><p class="row__title one-line">白色花礼</p><p class="row__meta one-line">纪念日 婚礼布置</p></div></div>
            <div class="card motx-slide"><img src="../../kit/assets/photo/product-monstera.webp" alt="" draggable="false"><div class="motx-slide__body"><p class="row__title one-line">龟背竹到店</p><p class="row__meta one-line">耐阴好养</p></div></div>
          </div>
        </div>
        <div class="motx-dots" role="tablist" aria-label="轮播页码">
          <button role="tab" aria-selected="true" aria-label="第 1 张"></button><button role="tab" aria-selected="false" aria-label="第 2 张"></button><button role="tab" aria-selected="false" aria-label="第 3 张"></button><button role="tab" aria-selected="false" aria-label="第 4 张"></button>
        </div>
      </div></div>
      <div class="mot-foot"><div class="mot-spec" data-spec="时长:--dur-slow,曲线:--ease-out"></div><button class="btn btn--secondary btn--sm" data-play>播放</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="AP-MOTN-016" data-name="面板锚点停靠" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">面板锚点停靠</span></div>
