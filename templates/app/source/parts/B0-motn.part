<!-- cat: MOTN | 动效 -->
<style>
  /* 动效组件专属样式：前缀 mot-。时长与曲线全部取令牌变量；系统要求减少动态时由共用样式压成瞬时，只保留终态 */
  .mot-card { display: grid; gap: var(--s-3); }
  .mot-box { display: grid; place-items: center; align-content: center; min-height: 72px; }
  .mot-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .mot-spec { display: flex; flex-wrap: wrap; gap: var(--s-1); min-width: 0; }
  .mot-spec .tag { height: 24px; background: var(--action-tint); color: var(--action-press); }
  .mot-foot .btn { flex: none; }

  /* 001 数字滚动 */
  .mot-num { display: grid; justify-items: center; gap: var(--s-1); }
  .mot-big { font-size: var(--fs-3xl); }

  /* 002 徽标 */
  .mot-ico { position: relative; display: grid; place-items: center; width: 64px; height: 64px; border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-2); }
  .mot-ico img { width: 30px; height: 30px; }
  .mot-ico .badge { top: -6px; right: -6px; min-width: 20px; height: 20px; line-height: 20px; border: 2px solid var(--surface); box-sizing: content-box; animation-name: none; }
  .mot-ico .badge[data-in] { animation-name: lz-pop; }

  /* 003 展开收起 */
  .mot-ex { width: 100%; overflow: hidden; }
  .mot-ex .expand__body { display: grid; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .mot-ex .expand__body p { display: flex; justify-content: space-between; gap: var(--s-3); }
  .mot-ex .expand__body b { font-weight: 600; color: var(--ink); }

  /* 004 卡片按压 */
  .mot-press { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; column-gap: var(--s-3); width: 100%; padding: var(--s-3); text-align: left; }
  .mot-press img { width: 64px; height: 64px; border-radius: var(--r-md); object-fit: cover; }
  .mot-press.is-pressed { background-color: var(--field-active); }
  .mot-press > span { min-width: 0; }

  /* 005 成功勾选 */
  .mot-ring { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--success); }
  .mot-ring img { width: 38px; height: 38px; filter: invert(1); }
  .mot-ring[data-play] { animation: mot-ring 720ms var(--ease-out) both; }
  .mot-ring[data-play] img { animation: lz-pop var(--dur-slow) var(--ease-spring) 140ms both; }
  @keyframes mot-ring { 0% { transform: scale(.4); box-shadow: 0 0 0 0 var(--success-tint); } 60% { transform: scale(1.06); } 100% { transform: scale(1); box-shadow: 0 0 0 16px transparent; } }

  /* 006 输入抖动 */
  .mot-field { width: 100%; }

  /* 007 骨架转内容 */
  .mot-skd { display: grid; grid-template-columns: 72px 1fr; align-items: center; column-gap: var(--s-3); width: 100%; min-height: 80px; padding: var(--s-3); }
  .mot-skd__img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; }
  .mot-skd__lines { display: grid; gap: var(--s-2); }
  [data-cid^="AP-MOTN"] .skel { background: linear-gradient(100deg, color-mix(in srgb, var(--action) 11%, var(--surface)) 30%, color-mix(in srgb, var(--action) 4%, var(--surface)) 50%, color-mix(in srgb, var(--action) 11%, var(--surface)) 70%) 0 0 / 200% 100%; animation: lz-shimmer 1.4s linear infinite; }

  /* 008 流式文字 */
  .mot-stream { width: 100%; min-height: 3.2em; }

  /* 009 悬浮说明浮现：静态预览，非交互 */
  .mot-tipwrap { position: relative; display: inline-grid; padding-top: 48px; }
  .mot-tip { position: absolute; top: 0; left: 50%; padding: var(--s-2) var(--s-3); border-radius: var(--r-sm); background: var(--ink); color: var(--bg); font-size: var(--fs-sm); line-height: 1.4; white-space: nowrap; opacity: 0; transform: translateX(-50%) translateY(6px) scale(.96); transform-origin: bottom center; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  .mot-tipwrap[data-show] .mot-tip { opacity: 1; transform: translateX(-50%) none; }

  /* 010 弹性开关 */
  .mot-sw { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); width: 100%; }

  /* 011 错峰入场 */
  .mot-rows { width: 100%; overflow: hidden; }
  .mot-rows .row { min-height: 60px; }
  .mot-rows .row__lead { width: 44px; height: 44px; }
  .mot-rows .row[data-in] { animation: lz-rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }

  /* 012 视图切换 */
  .mot-views { width: 100%; }
  .mot-view { width: 100%; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  .mot-view[data-leave] { opacity: 0; transform: translateY(-6px); }
  .mot-view[data-enter] { animation: lz-view var(--dur-base) var(--ease-out) both; }
  .mot-view__card { display: grid; align-content: center; gap: var(--s-2); padding: var(--s-2) var(--s-4); }
  .mot-view__body { display: flex; align-items: center; gap: var(--s-3); }
  .mot-view__bar { display: flex; align-items: center; gap: var(--s-2); min-height: 40px; }
  .mot-view__bar h3 { font-size: var(--fs-lg); font-weight: 600; }
  .mot-view__img { flex: none; width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; }
  .mot-view .row { cursor: pointer; }

  /* 013 标签滑动指示 */
  .mot-tabs { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; width: 100%; border-bottom: 1px solid var(--line); }
  .mot-tabs button { min-height: 44px; font-size: var(--fs-sm); color: var(--ink-3); transition: color var(--dur-quick) var(--ease-out); }
  .mot-tabs button[aria-selected="true"] { color: var(--action-press); font-weight: 600; }
  .mot-tabs__ind { position: absolute; left: 0; bottom: -1px; height: 3px; width: var(--w, 0px); border-radius: 3px 3px 0 0; background: var(--action); transform: translateX(var(--x, 0px)); transition: transform var(--dur-base) var(--ease-out), width var(--dur-base) var(--ease-out); }
  .mot-pane { width: 100%; padding-top: var(--s-4); text-align: center; font-size: var(--fs-md); color: var(--ink-2); animation: lz-fade var(--dur-base) var(--ease-out) both; }
  .mot-pane b { font-size: var(--fs-xl); font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* 014 卡片尺寸变化 */
  .mot-size { width: 100%; overflow: hidden; }
  .mot-size__img { width: 100%; height: 72px; object-fit: cover; transition: height var(--dur-slow) var(--ease-out); }
  .mot-size[data-big] .mot-size__img { height: 172px; }
  .mot-size__body { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); }
</style>

<article class="demo" data-cid="AP-MOTN-001" data-name="数字滚动入场" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">数字滚动入场</span></div>
  <p class="demo__note">适合：首页指标、余额入场时从零滚到当前值</p>
  <div class="demo__stage">
    <div class="mot-card">
      <div class="mot-box"><div class="mot-num"><span class="stat__label">累计订单</span><span class="stat__val mot-big"><span data-n>12,860</span><small>单</small></span></div></div>
      <div class="mot-foot"><div class="mot-spec" data-spec="时长:--dur-slow*2,曲线:--ease-out"></div><button class="btn btn--secondary btn--sm" data-play>播放</button></div>
    </div>
  </div>
</article>

