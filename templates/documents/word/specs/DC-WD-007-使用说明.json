  "sections": [
    {
      "heading": "登录与交接班",
      "blocks": [
        {
          "sub": "登录收银台"
        },
        {
          "items": [
            "打开收银台，输入店员账号与密码。",
            "选择当前所在门店。",
            "点击“登录”进入开单页。"
          ]
        },
        {
          "sub": "交接班"
        },
        {
          "items": [
            "点击“交接班”，系统汇总本班次的订单量与收款金额。",
            "核对现金、扫码和会员储值三项收款与实际一致。",
            "确认后点击“完成交接”，接班人使用自己的账号登录。"
          ]
        },
        {
          "table": {
            "header": [
              "核对项",
              "核对内容",
              "处理方式"
            ],
            "rows": [
              [
                "现金",
                "钱箱现金与系统现金收款一致",
                "不一致时登记差额并由店长确认"
              ],
              [
                "扫码",
                "扫码收款笔数与金额与系统一致",
                "不一致时联系店长核对支付流水"
              ],
              [
                "会员储值",
                "储值扣款与会员账户变动一致",
                "不一致时暂停该会员储值消费"
              ]
            ],
            "caption": "交接班核对项"
          }
        }
      ]
    },
    {
      "heading": "开单与收款",
      "blocks": [
        {
          "sub": "到店开单"
        },
        {
          "items": [
            "在商品页选择商品，点击加入订单，可调整数量。",
            "识别会员：输入手机号或扫描会员码，系统自动带出等级与优惠券。",
            "核对订单金额，选择优惠券后点击“去收款”。"
          ]
        },
        {
          "sub": "收款方式"
        },
        {
          "table": {
            "header": [
              "收款方式",
              "适用场景",
              "到账说明"
            ],
            "rows": [
              [
                "现金",
                "到店顾客现场付款",
                "收款后立即记入当班现金"
              ],
              [
                "扫码",
                "到店顾客手机付款",
                "支付成功后订单自动变为已完成"
              ],
              [
                "会员储值",
                "已开通储值的会员",
                "从会员储值余额中扣除并累计积分"
              ]
            ],
            "caption": "收款方式"
          }
        },
        {
          "sub": "同城配送订单"
        },
        {
          "items": [
            "在订单页选择“同城配送”，填写收货地址、联系人和送达时间。",
            "收款完成后订单进入待发货，系统通知配送端生成任务。"
          ]
        }
      ]
    },
    {
      "heading": "退换货",
      "blocks": [
        {
          "sub": "办理步骤"
        },
        {
          "items": [
            "在订单页找到原订单，点击“申请售后”。",
            "选择退货或换货，填写原因并拍照留存。",
            "店长审批通过后，系统退款或生成换货订单。"
          ]
        },
        {
          "table": {
            "header": [
              "商品类型",
              "可退换条件",
              "处理方式"
            ],
            "rows": [
              [
                "鲜花",
                "送达当日花材枯萎或破损",
                "当日补送或退款"
              ],
              [
                "绿植",
                "送达三日内出现明显病害",
                "更换同类绿植或退款"
              ],
              [
                "花礼盒",
                "礼盒破损或花材与订单不符",
                "更换礼盒或退款"
              ],
              [
                "花器",
                "送达七日内的破损或质量问题",
                "更换花器或退款"
              ]
            ],
            "caption": "退换货处理规则"
          }
        }
      ]
    },
