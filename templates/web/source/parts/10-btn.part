<!-- cat: BTN | 按钮 -->
<style>
  /* 按钮类：前缀 wb-bt-，仅作用于按钮分类内的演示 */
  #cat-btn .gallery { align-items: stretch; }
  #cat-btn .demo { min-width: 0; }
  #cat-btn .badge { min-width: 18px; height: 18px; font-size: var(--fs-xs); line-height: 18px; }
  #cat-btn .btn--primary:not([disabled]):not(.is-loading), #cat-btn .btn--danger:not([disabled]):not(.is-loading) { color: var(--surface); }
  #cat-btn .btn--danger-soft:not([disabled]), #cat-btn .tag[data-tone="danger"] { color: color-mix(in srgb, var(--danger) 82%, var(--ink)); }
  #cat-btn .btn--primary .btn-count { background: var(--surface); color: var(--action-press); }
  /* 舞台高度由内容决定，只给单行按钮留一个统一的最小高度；下拉与菜单要预留的高度用 --h 写刚好够用的值 */
  #cat-btn .demo__stage { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--s-3); min-height: 80px; padding: var(--s-4) var(--s-3); }
  #cat-btn .demo__stage.is-plain { display: block; min-height: 0; padding: 0; }
  #cat-btn .btn[disabled] { box-shadow: none; }
  #cat-btn .btn--outline[disabled] { box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  #cat-btn .btn--secondary[disabled] { box-shadow: inset 0 0 0 1px var(--line); }
  #cat-btn .btn--text[disabled] { background: none; }
  #cat-btn .demo__stage.wb-bt-white { background: var(--surface); }
  #cat-btn .demo__stage.wb-bt-tall { min-height: var(--h, 200px); align-items: flex-start; }
  #cat-btn .demo__stage.wb-bt-col { flex-direction: column; align-items: stretch; justify-content: center; flex-wrap: nowrap; }

  .wb-bt-grad { background: linear-gradient(135deg, var(--action-press) 0%, var(--action) 100%); color: var(--surface); box-shadow: 0 6px 16px color-mix(in srgb, var(--action) 26%, transparent); }
  .wb-bt-grad img { filter: invert(1); }
  @media (hover: hover) { .wb-bt-grad:hover { filter: brightness(1.08); } }
  .wb-bt-band { display: flex; align-items: center; justify-content: center; min-height: 96px; background: linear-gradient(135deg, var(--action-press) 0%, var(--action) 100%); }
  .wb-bt-count-tint { background: var(--action-edge); color: var(--action-press); }
  .wb-bt-caret::after { content: ""; width: 6px; height: 6px; margin-left: 2px; border: solid currentColor; border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translateY(-2px); }
  .wb-bt-split .wb-bt-caret { padding: 0 var(--s-3); }

  /* 下拉菜单：动作列表，不记忆选中 */
  .wb-bt-menu { position: relative; display: inline-block; }
  .wb-bt-list { position: absolute; z-index: 30; top: calc(100% + 6px); left: 0; min-width: 100%; padding: var(--s-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); opacity: 0; transform: scale(.96); transform-origin: top left; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  .wb-bt-list--right { left: auto; right: 0; transform-origin: top right; }
  .wb-bt-list--up { top: auto; bottom: calc(100% + 6px); transform-origin: bottom right; }
  .wb-bt-menu[data-open="true"] .wb-bt-list { opacity: 1; transform: none; pointer-events: auto; }
  .wb-bt-item { display: block; width: 100%; min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); white-space: nowrap; }
  @media (hover: hover) { .wb-bt-item:hover { background: var(--zone); } }
  .wb-bt-item--danger { color: var(--danger); }

  /* 并列按钮组：共边的一排 */
  .wb-bt-join { display: inline-flex; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); overflow: hidden; }
  .wb-bt-join button { min-height: 40px; padding: 0 var(--s-4); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out); }
  .wb-bt-join button + button { border-left: 1px solid var(--line-strong); }
  @media (hover: hover) { .wb-bt-join button:hover { background: var(--zone); } }
  .wb-bt-join button:active { background: var(--action-tint); }

  /* 三态：并排展示默认、按下、禁用 */
  .wb-bt-states { display: grid; grid-template-columns: repeat(3, auto); gap: var(--s-4) var(--s-5); justify-items: center; }
  .wb-bt-states small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-bt-states .is-press { background: var(--action-press); transform: scale(.97); box-shadow: none; }

  /* 批量操作条 */
  .wb-bt-orders { display: grid; gap: 0; margin-bottom: var(--s-3); padding: var(--s-1) var(--s-4); }
  .wb-bt-order { display: grid; grid-template-columns: 22px 40px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 56px; }
  .wb-bt-order + .wb-bt-order { border-top: 1px solid var(--line); }
  .wb-bt-order img.thumb { width: 40px; height: 40px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-bt-order p { font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bt-order p small { display: block; font-size: var(--fs-xs); color: var(--ink-3); font-weight: 400; }
  .wb-bt-bar { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-3); border: 1px solid var(--line); }
  .wb-bt-bar__n { margin-right: auto; font-size: var(--fs-sm); font-weight: 600; white-space: nowrap; }
  .wb-bt-bar .btn[disabled] { opacity: .6; }

  /* 表格行内操作：沿用共用表格，菜单可以超出单元格；宽度不够时舞台横向滚动 */
  .wb-bt-rows { width: 100%; min-width: 600px; }
  .wb-bt-rows .table col:nth-child(1) { width: 36%; }
  .wb-bt-rows .table col:nth-child(2), .wb-bt-rows .table col:nth-child(3) { width: 16%; }
  .wb-bt-rows .table td { overflow: visible; padding-top: var(--s-2); padding-bottom: var(--s-2); }
  .wb-bt-rows .table thead th:first-child { border-top-left-radius: calc(var(--r-lg) - 1px); }
  .wb-bt-rows .table thead th:last-child { border-top-right-radius: calc(var(--r-lg) - 1px); }
  .wb-bt-prod { display: flex; align-items: center; gap: var(--s-3); text-align: left; }
  .wb-bt-prod img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; flex: none; }
  .wb-bt-prod p { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bt-prod small { display: block; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .wb-bt-acts { display: inline-flex; align-items: center; gap: var(--s-1); }

  /* 悬浮操作钮：左边是页面内容，右边一列留给悬浮钮，菜单向上展开且不盖住内容 */
  .wb-bt-zone { display: grid; grid-template-columns: minmax(0, 1fr) 88px; align-items: end; gap: var(--s-3); width: 100%; }
  .wb-bt-fab { position: relative; display: grid; justify-items: center; }
  .wb-bt-fab__menu { position: absolute; left: 0; right: 0; bottom: calc(100% + var(--s-2)); display: grid; gap: var(--s-2); justify-items: center; opacity: 0; transform: translateY(8px) scale(.96); transform-origin: bottom center; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .wb-bt-fab[data-open="true"] .wb-bt-fab__menu { opacity: 1; transform: none; pointer-events: auto; }
  .wb-bt-fab[data-open="true"] > .btn { background: var(--action-press); }

  /* 页面顶部操作区 */
  .wb-bt-head { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-6) var(--s-6) var(--s-5); background: linear-gradient(180deg, var(--action-tint) 0%, var(--bg) 100%); }
  .wb-bt-head::after { content: ""; position: absolute; inset: 0; z-index: -1; background: url(../../kit/assets/photo/pattern-petals.webp) right top / 340px; opacity: .35; -webkit-mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); pointer-events: none; }
  .wb-bt-head h1 { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); white-space: nowrap; }
  .wb-bt-head__acts { display: flex; align-items: center; gap: var(--s-2); }
  .wb-bt-head .search { width: 240px; }

  /* 表单提交区 */
  .wb-bt-form { width: 100%; min-width: 0; }
  .wb-bt-form__acts { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); padding: var(--s-4) var(--s-5); border-top: 1px solid var(--line); }
</style>

<article class="demo" data-cid="WB-BTN-001" data-name="主操作按钮" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">主操作按钮</span></div>
