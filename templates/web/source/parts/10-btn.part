<article class="demo demo--span2" data-cid="WB-BTN-033" data-name="表单提交区" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">表单提交区</span></div>
  <p class="demo__note">适合：表单底部，取消与保存相邻</p>
  <div class="demo__stage"><form class="card wb-bt-form" onsubmit="return false">
    <div class="form-grid">
      <label class="field"><span class="field__label">商品名称</span><input class="input" value="粉芍药花束" aria-label="商品名称"></label>
      <label class="field"><span class="field__label">所属分类</span><input class="input" value="鲜花" aria-label="所属分类"></label>
    </div>
    <div class="wb-bt-form__acts"><button type="button" class="btn btn--outline" data-wb-toast="已取消编辑">取消</button><button type="submit" class="btn btn--primary" data-wb-load="已保存">保存</button></div>
  </form></div>
</article>

<script>
(function () {
  const root = document.getElementById('cat-btn'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];

  /* 轻提示与确认框 */
  $$('[data-wb-toast]').forEach(b => b.addEventListener('click', () => Lz.toast(b.dataset.wbToast, 'success')));
  $$('[data-wb-confirm]').forEach(b => b.addEventListener('click', async () => {
    if (await Lz.confirm({ title: b.dataset.wbConfirm, ok: b.dataset.wbOk || '确认', tone: 'danger' })) Lz.toast(b.dataset.wbDone || '已完成', 'success');
  }));

  /* 加载中：点击后进入加载，片刻后恢复并提示 */
  $$('[data-wb-load]').forEach(b => b.addEventListener('click', e => {
    e.preventDefault(); if (b.classList.contains('is-loading')) return;
    const label = b.textContent; b.classList.add('is-loading'); b.setAttribute('aria-busy', 'true');
    setTimeout(() => { b.classList.remove('is-loading'); b.removeAttribute('aria-busy'); Lz.toast(b.dataset.wbLoad, 'success'); }, 1500);
  }));

  /* 动作菜单：点开、点外面或按 Escape 收起 */
  $$('[data-wb-menu]').forEach(m => {
    const trigger = $('[aria-haspopup]', m), set = open => { m.dataset.open = String(open); trigger.setAttribute('aria-expanded', String(open)); };
    trigger.addEventListener('click', e => { e.stopPropagation(); $$('[data-wb-menu][data-open="true"]').forEach(x => { if (x !== m) { x.dataset.open = 'false'; $('[aria-haspopup]', x).setAttribute('aria-expanded', 'false'); } }); set(m.dataset.open !== 'true'); });
    $$('.wb-bt-item', m).forEach(i => i.addEventListener('click', () => set(false)));
    m.addEventListener('keydown', e => { if (e.key === 'Escape') { set(false); trigger.focus(); } });
    document.addEventListener('click', () => set(false));
  });

  /* 切换按钮：按下与弹起交替，文字随状态变化 */
  $$('[data-wb-toggle]').forEach(b => { const [off, on] = b.dataset.wbToggle.split('|'); b.addEventListener('click', () => { const v = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(v)); b.textContent = v ? on : off; b.classList.toggle('btn--outline', !v); b.classList.toggle('btn--secondary', v); Lz.toast(v ? on : '已取消' + off, 'success'); }); });

  /* 分段按钮 */
  $$('[data-wb-seg]').forEach(g => $$('button', g).forEach(b => b.addEventListener('click', () => $$('button', g).forEach(x => x.setAttribute('aria-pressed', String(x === b))))));

  /* 悬浮操作钮：展开时收起它自己的悬浮说明，免得盖住上方的菜单 */
  $$('[data-wb-fab]').forEach(f => {
    const main = $('.btn--fab', f), name = main.dataset.tip;
    const set = open => {
      f.dataset.open = String(open); main.setAttribute('aria-expanded', String(open));
      if (open) { document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })); main.removeAttribute('data-tip'); } else main.dataset.tip = name;
    };
    main.addEventListener('click', e => { e.stopPropagation(); set(f.dataset.open !== 'true'); });
    document.addEventListener('click', e => { if (!f.contains(e.target)) set(false); });
  });

  /* 批量操作条：勾选数量驱动按钮可用 */
  const batch = $('#wb-bt-batch');
  if (batch) {
    const checks = $$('[role="checkbox"]', batch), n = $('[data-wb-n]', batch), acts = $$('[data-wb-act]', batch);
    const sync = () => { const c = checks.filter(x => x.getAttribute('aria-checked') === 'true').length; n.textContent = c; acts.forEach(a => { a.disabled = c === 0; }); };
    checks.forEach(c => c.addEventListener('lz:toggle', sync));
    acts.forEach(a => a.addEventListener('click', () => Lz.toast(a.dataset.wbAct, 'success')));
    $('[data-wb-clear]', batch).addEventListener('click', () => { checks.forEach(c => c.setAttribute('aria-checked', 'false')); sync(); });
    sync();
  }
})();
</script>

