<article class="demo" data-cid="WB-BTN-035" data-name="右键快捷菜单" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">右键快捷菜单</span></div>
  <p class="demo__note">适合：表格行与文件卡上右键弹出的就近操作菜单</p>
  <div class="demo__stage"><div class="card wb-bt-ctx" id="wb-bt-ctx">
    <div class="wb-bt-ctx__row" tabindex="0" data-name="红玫瑰花束主图"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><p class="wb-bt-ctx__t">红玫瑰花束主图</p><p class="wb-bt-ctx__m">商品图片 12 张</p></div><button class="btn btn--text btn--xs wb-bt-caret" aria-haspopup="menu" aria-expanded="false" aria-label="红玫瑰花束主图的操作">操作</button></div>
    <div class="wb-bt-ctx__row" tabindex="0" data-name="春日花展海报"><img src="../../kit/assets/photo/scene-hero-pink.webp" alt=""><div><p class="wb-bt-ctx__t">春日花展海报</p><p class="wb-bt-ctx__m">活动素材 3 个文件</p></div><button class="btn btn--text btn--xs wb-bt-caret" aria-haspopup="menu" aria-expanded="false" aria-label="春日花展海报的操作">操作</button></div>
    <div class="wb-bt-ctx__row" tabindex="0" data-name="门店价目表"><img src="../../kit/assets/solid/bill.webp" alt=""><div><p class="wb-bt-ctx__t">门店价目表</p><p class="wb-bt-ctx__m">表格 更新于 11 月 8 日</p></div><button class="btn btn--text btn--xs wb-bt-caret" aria-haspopup="menu" aria-expanded="false" aria-label="门店价目表的操作">操作</button></div>
    <div class="wb-bt-ctx__row" tabindex="0" data-name="会员服务协议"><img src="../../kit/assets/solid/biz-notes.webp" alt=""><div><p class="wb-bt-ctx__t">会员服务协议</p><p class="wb-bt-ctx__m">文档 共 2 页</p></div><button class="btn btn--text btn--xs wb-bt-caret" aria-haspopup="menu" aria-expanded="false" aria-label="会员服务协议的操作">操作</button></div>
    <div class="wb-bt-ctx__menu" role="menu" aria-label="文件操作" hidden>
      <button class="wb-bt-item" role="menuitem" data-act="open">打开</button>
      <button class="wb-bt-item" role="menuitem" data-act="rename">重命名</button>
      <button class="wb-bt-item" role="menuitem" data-act="link">复制链接</button>
      <span class="wb-bt-ctx__sep" role="separator"></span>
      <button class="wb-bt-item wb-bt-item--danger" role="menuitem" data-act="delete">删除</button>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-BTN-036" data-name="溢出工具条" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">溢出工具条</span></div>
  <p class="demo__note">适合：一排图标动作放不下时折入更多菜单</p>
  <div class="demo__stage"><div class="card wb-bt-ovf" id="wb-bt-ovf">
    <div class="wb-bt-ovf__bar" role="toolbar" aria-label="素材工具条">
      <div class="wb-bt-ovf__items">
        <button class="ibtn" aria-label="新建文档" data-tip="新建文档" data-done="已新建文档"><img src="../../kit/assets/line/file-add.webp" alt=""></button>
        <button class="ibtn" aria-label="上传素材" data-tip="上传素材" data-done="请选择素材文件"><img src="../../kit/assets/line/upload.webp" alt=""></button>
        <button class="ibtn" aria-label="预览" data-tip="预览" data-done="已打开预览"><img src="../../kit/assets/line/monitor.webp" alt=""></button>
        <button class="ibtn" aria-label="重命名" data-tip="重命名" data-done="已进入重命名"><img src="../../kit/assets/line/edit.webp" alt=""></button>
        <button class="ibtn" aria-label="归档" data-tip="归档" data-done="已归档"><img src="../../kit/assets/line/archive.webp" alt=""></button>
        <button class="ibtn" aria-label="筛选" data-tip="筛选" data-done="已打开筛选"><img src="../../kit/assets/line/filter.webp" alt=""></button>
        <button class="ibtn" aria-label="列表视图" data-tip="列表视图" data-done="已切换列表视图"><img src="../../kit/assets/line/list.webp" alt=""></button>
        <button class="ibtn" aria-label="查找" data-tip="查找" data-done="已打开查找"><img src="../../kit/assets/line/search.webp" alt=""></button>
        <button class="ibtn" aria-label="成员权限" data-tip="成员权限" data-done="已打开成员权限"><img src="../../kit/assets/line/people.webp" alt=""></button>
        <button class="ibtn" aria-label="素材设置" data-tip="素材设置" data-done="已打开素材设置"><img src="../../kit/assets/line/settings.webp" alt=""></button>
      </div>
      <div class="wb-bt-menu wb-bt-ovf__more" data-open="false" hidden><button class="btn btn--text btn--sm wb-bt-caret" aria-haspopup="menu" aria-expanded="false">更多</button><div class="wb-bt-list wb-bt-list--right" role="menu" aria-label="更多操作"></div></div>
    </div>
    <div class="wb-bt-ovf__body">
      <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div class="row__main"><p class="row__title">红玫瑰花束主图</p><p class="row__meta">商品图片 12 张</p></div><span class="tag" data-tone="success">已发布</span></div>
      <div class="row"><img class="row__lead" src="../../kit/assets/photo/product-sunflower.webp" alt=""><div class="row__main"><p class="row__title">向日葵花束主图</p><p class="row__meta">商品图片 8 张</p></div><span class="tag" data-tone="success">已发布</span></div>
      <div class="row"><img class="row__lead" src="../../kit/assets/photo/scene-hero-pink.webp" alt=""><div class="row__main"><p class="row__title">春日花展海报</p><p class="row__meta">活动素材 3 个文件</p></div><span class="tag" data-tone="warning">待审核</span></div>
      <div class="row"><img class="row__lead" src="../../kit/assets/photo/bouquet-white.webp" alt=""><div class="row__main"><p class="row__title">周期订花横幅</p><p class="row__meta">活动素材 5 个文件</p></div><span class="tag">草稿</span></div>
    </div>
  </div></div>
</article>

<style>
  /* 新增：回到顶部、右键快捷菜单、溢出工具条 */
  .wb-bt-top, .wb-bt-ctx, .wb-bt-ovf { width: 100%; min-width: 0; }
  .wb-bt-top { position: relative; overflow: hidden; }
  .wb-bt-top__scroll { height: 248px; overflow-y: auto; scrollbar-width: thin; overscroll-behavior: contain; }
  .wb-bt-top__scroll:focus-visible { outline-offset: -3px; border-radius: var(--r-lg); }
  .wb-bt-top__btn { position: absolute; right: var(--s-4); bottom: var(--s-4); width: 48px; height: 48px; padding: 3px; border-radius: 50%; background: conic-gradient(var(--action) calc(var(--p, 0) * 1%), var(--line-strong) 0); box-shadow: var(--elev-3); opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
  .wb-bt-top__btn:focus-visible { border-radius: 50%; }
  .wb-bt-top__btn[data-show="true"] { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .wb-bt-top__btn:active { transform: scale(.94); }
  @media (hover: hover) { .wb-bt-top__btn[data-show="true"]:hover .wb-bt-top__in { background: var(--action-tint); } }
  .wb-bt-top__in { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: var(--surface); transition: background var(--dur-quick) var(--ease-out); }
  .wb-bt-top__in .chev::after { margin: 4px 0 0; border-color: var(--action-press); transform: rotate(-135deg); }

  .wb-bt-ctx { position: relative; }
  .wb-bt-ctx__row { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 60px; padding: var(--s-2) var(--s-3) var(--s-2) var(--s-4); cursor: context-menu; transition: background var(--dur-quick) var(--ease-out); }
  .wb-bt-ctx__row:first-child { border-radius: calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px) 0 0; }
  .wb-bt-ctx__row:last-of-type { border-radius: 0 0 calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px); }
  .wb-bt-ctx__row + .wb-bt-ctx__row { border-top: 1px solid var(--line); }
  .wb-bt-ctx__row:focus-visible { outline-offset: -3px; }
  @media (hover: hover) { .wb-bt-ctx__row:hover { background: var(--zone); } }
  .wb-bt-ctx__row[aria-selected="true"] { background: var(--action-tint); }
  .wb-bt-ctx__row img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-bt-ctx__t { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bt-ctx__m { margin-top: 2px; font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-bt-ctx__menu { position: absolute; z-index: 40; width: 176px; padding: var(--s-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); animation: lz-toast var(--dur-quick) var(--ease-out) both; }
  .wb-bt-ctx__menu .wb-bt-item:focus-visible { outline-offset: -2px; background: var(--zone); }
  .wb-bt-ctx__sep { display: block; height: 1px; margin: var(--s-1) var(--s-2); background: var(--line); }

  .wb-bt-ovf { position: relative; }
  .wb-bt-ovf__bar { display: flex; align-items: center; gap: var(--s-1); padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--line); }
  .wb-bt-ovf__items { display: flex; align-items: center; gap: 2px; flex: 1; min-width: 0; }
  .wb-bt-ovf__items .ibtn { flex: none; }
  .wb-bt-ovf__more { flex: none; }
  .wb-bt-ovf .wb-bt-list { min-width: 168px; }
  .wb-bt-ovf__mi { display: flex; align-items: center; gap: var(--s-2); }
  .wb-bt-ovf__mi img { width: 18px; height: 18px; }
  .wb-bt-ovf__body .row:last-child { border-radius: 0 0 calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px); }
</style>

<script>
(function () {
  const root = document.getElementById('cat-btn'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];

  /* 回到顶部：滚过一屏出现，圆环显示滚动进度，点后平滑回到顶端 */
  const top = $('#wb-bt-top');
  if (top) {
    const sc = $('.wb-bt-top__scroll', top), btn = $('.wb-bt-top__btn', top);
    const sync = () => {
      const max = sc.scrollHeight - sc.clientHeight, show = sc.scrollTop > 96;
      btn.style.setProperty('--p', (max > 0 ? sc.scrollTop / max * 100 : 0).toFixed(1));
      btn.dataset.show = String(show); btn.tabIndex = show ? 0 : -1;
    };
    sc.addEventListener('scroll', sync, { passive: true });
    btn.addEventListener('click', () => { document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })); sc.scrollTo({ top: 0, behavior: Lz.reduce ? 'auto' : 'smooth' }); sc.focus({ preventScroll: true }); });
    sc.scrollTop = 136; sync();
  }

  /* 右键菜单：右键、菜单键或点“操作”都在行旁弹出，方向键选项，Esc 收起并回到原行 */
  const ctx = $('#wb-bt-ctx');
  if (ctx) {
    const rows = $$('.wb-bt-ctx__row', ctx), menu = $('.wb-bt-ctx__menu', ctx), items = $$('[role="menuitem"]', menu);
    let owner = null;
    const close = back => { menu.hidden = true; rows.forEach(r => r.removeAttribute('aria-selected')); $$('[aria-haspopup]', ctx).forEach(b => b.setAttribute('aria-expanded', 'false')); if (back && owner) owner.focus({ preventScroll: true }); owner = null; };
    const place = (row, x, y, flipY) => {
      owner = row; rows.forEach(r => r.setAttribute('aria-selected', String(r === row)));
      menu.hidden = false;
      const w = ctx.clientWidth, h = ctx.clientHeight, mw = menu.offsetWidth, mh = menu.offsetHeight;
      let left = Math.min(Math.max(8, x), w - mw - 8), top = y;
      if (top + mh > h - 8) top = Math.max(8, (flipY == null ? y : flipY) - mh);
      menu.style.left = left + 'px'; menu.style.top = Math.min(top, h - mh - 8) + 'px';
    };
    const fromTrigger = (row, b) => { const c = ctx.getBoundingClientRect(), r = b.getBoundingClientRect(); b.setAttribute('aria-expanded', 'true'); place(row, r.right - c.left - 176, r.bottom - c.top + 4, r.top - c.top - 4); };
    rows.forEach(row => {
      const trig = $('[aria-haspopup]', row);
      row.addEventListener('contextmenu', e => {
        e.preventDefault(); const c = ctx.getBoundingClientRect(), kb = e.clientX === 0 && e.clientY === 0, r = row.getBoundingClientRect();
        const x = kb ? r.left - c.left + 40 : e.clientX - c.left, y = kb ? r.bottom - c.top - 6 : e.clientY - c.top;
        place(row, x, y, y); items[0].focus({ preventScroll: true });
      });
      trig.addEventListener('click', e => { e.stopPropagation(); if (!menu.hidden && owner === row) { close(true); return; } fromTrigger(row, trig); items[0].focus({ preventScroll: true }); });
      row.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target === row) { fromTrigger(row, trig); items[0].focus({ preventScroll: true }); } });
    });
    menu.addEventListener('keydown', e => {
      const i = items.indexOf(document.activeElement), d = { ArrowDown: 1, ArrowUp: -1 }[e.key];
      if (d) { e.preventDefault(); items[(i + d + items.length) % items.length].focus(); }
      else if (e.key === 'Home') { e.preventDefault(); items[0].focus(); }
      else if (e.key === 'End') { e.preventDefault(); items[items.length - 1].focus(); }
      else if (e.key === 'Escape') { e.stopPropagation(); close(true); }
      else if (e.key === 'Tab') close(false);
    });
    items.forEach(it => it.addEventListener('click', async () => {
      const name = owner ? owner.dataset.name : '', act = it.dataset.act; close(true);
      if (act === 'delete') { if (await Lz.confirm({ title: '确认删除' + name, ok: '删除', tone: 'danger' })) Lz.toast('已删除' + name, 'success'); }
      else Lz.toast({ open: '已打开', rename: '已进入重命名 ', link: '已复制链接 ' }[act] + name, 'success');
    }));
    document.addEventListener('click', e => { if (!menu.hidden && !menu.contains(e.target)) close(false); });
    document.addEventListener('contextmenu', e => { if (!menu.hidden && !ctx.contains(e.target)) close(false); });
    requestAnimationFrame(() => { const r0 = rows[0]; fromTrigger(r0, $('[aria-haspopup]', r0)); });
  }

  /* 溢出工具条：按容器宽度决定显示几个图标，其余折进“更多”菜单 */
  const ovf = $('#wb-bt-ovf');
  if (ovf) {
    const bar = $('.wb-bt-ovf__bar', ovf), btns = $$('.wb-bt-ovf__items .ibtn', ovf), menu = $('.wb-bt-menu', ovf), trig = $('[aria-haspopup]', menu), list = $('.wb-bt-list', menu);
    const run = b => Lz.toast(b.dataset.done, 'success');
    const setOpen = o => { menu.dataset.open = String(o); trig.setAttribute('aria-expanded', String(o)); list.inert = !o; };
    btns.forEach(b => b.addEventListener('click', () => run(b)));
    const layout = () => {
      btns.forEach(b => { b.hidden = false; }); menu.hidden = false;
      const cs = getComputedStyle(bar), inner = bar.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const gap = 2, w = btns[0].offsetWidth, total = btns.length * w + (btns.length - 1) * gap;
      let n = btns.length;
      if (total > inner) n = Math.max(0, Math.floor((inner - menu.offsetWidth - 4 + gap) / (w + gap)));
      btns.forEach((b, i) => { b.hidden = i >= n; });
      menu.hidden = n >= btns.length; if (menu.hidden) setOpen(false);
      list.replaceChildren(...btns.slice(n).map(b => {
        const it = document.createElement('button'), t = document.createElement('span');
        it.className = 'wb-bt-item wb-bt-ovf__mi'; it.setAttribute('role', 'menuitem'); t.textContent = b.getAttribute('aria-label');
        it.append($('img', b).cloneNode(), t);
        it.addEventListener('click', () => { setOpen(false); trig.focus(); run(b); });
        return it;
      }));
    };
    trig.addEventListener('click', e => { e.stopPropagation(); setOpen(menu.dataset.open !== 'true'); });
    menu.addEventListener('keydown', e => {
      const its = $$('[role="menuitem"]', list), i = its.indexOf(document.activeElement), d = { ArrowDown: 1, ArrowUp: -1 }[e.key];
      if (e.key === 'Escape') { setOpen(false); trig.focus(); }
      else if (d) { e.preventDefault(); if (menu.dataset.open !== 'true') setOpen(true); its[(i + d + its.length) % its.length].focus(); }
    });
    document.addEventListener('click', e => { if (!menu.contains(e.target)) setOpen(false); });
    new ResizeObserver(layout).observe(bar); layout();
    setOpen(true);
  }
})();
</script>
