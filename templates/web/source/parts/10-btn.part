</article>

<article class="demo" data-cid="WB-BTN-023" data-name="下拉按钮" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">下拉按钮</span></div>
  <p class="demo__note">适合：收纳多个次要动作</p>
  <div class="demo__stage wb-bt-tall" style="--h: 200px"><div class="wb-bt-menu" data-wb-menu data-open="true">
    <button class="btn btn--outline wb-bt-caret" aria-haspopup="menu" aria-expanded="true">更多操作</button>
    <div class="wb-bt-list" role="menu"><button class="wb-bt-item" role="menuitem" data-wb-toast="已导出表格">导出表格</button><button class="wb-bt-item" role="menuitem" data-wb-toast="已发送到打印机">打印清单</button><button class="wb-bt-item" role="menuitem" data-wb-toast="已归档">归档订单</button></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-BTN-024" data-name="拆分按钮" data-cat="BTN">
  <div class="demo__head"><span class="demo__name">拆分按钮</span></div>
