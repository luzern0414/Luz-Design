<script>
(function () {
  const root = document.getElementById('cat-bgnd'); if (!root) return;
  const $$ = (s, r = root) => [...r.querySelectorAll(s)];
  $$('[data-wb-toast]').forEach(b => b.addEventListener('click', () => Lz.toast(b.dataset.wbToast, 'success')));
  $$('[data-wb-login]').forEach(f => f.addEventListener('submit', e => { e.preventDefault(); Lz.toast('登录成功', 'success'); }));
  $$('[data-wb-rail]').forEach(r => $$('.rail__item', r).forEach(i => i.addEventListener('click', () => $$('.rail__item', r).forEach(x => { if (x === i) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current'); }))));
})();
</script>

<article class="demo" data-cid="WB-BGND-031" data-name="页面水印" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">页面水印</span></div>
  <p class="demo__note">适合：后台敏感页叠加账号尾号水印防截图外传</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f wb-bg-f--0 bg-surface wb-bg-wm" id="wb-bg-wm" data-on="true">
    <div class="wb-bg-wm__bar">
      <h3 class="wb-bg-h">会员资料</h3>
      <div class="wb-bg-wm__ctl">
        <div class="btn-seg" role="group" aria-label="水印密度"><button aria-pressed="false" data-d="loose">疏</button><button aria-pressed="true" data-d="mid">中</button><button aria-pressed="false" data-d="dense">密</button></div>
        <span class="wb-bg-sw"><span>水印</span><button class="switch" role="switch" aria-checked="true" aria-label="页面水印"></button></span>
      </div>
    </div>
    <div class="wb-bg-wm__rows">
      <div class="wb-bg-wm__row"><img class="avatar" src="../../kit/assets/marks/mark-003.webp" alt=""><div><p class="wb-bg-ord__t">林晓</p><p class="wb-bg-ord__m">金卡会员</p></div><span class="wb-bg-wm__tel">138****6618</span><span class="price"><small>¥</small>6,280</span></div>
      <div class="wb-bg-wm__row"><img class="avatar" src="../../kit/assets/marks/mark-008.webp" alt=""><div><p class="wb-bg-ord__t">陈默</p><p class="wb-bg-ord__m">银卡会员</p></div><span class="wb-bg-wm__tel">139****2057</span><span class="price"><small>¥</small>3,460</span></div>
      <div class="wb-bg-wm__row"><img class="avatar" src="../../kit/assets/marks/mark-012.webp" alt=""><div><p class="wb-bg-ord__t">王芳</p><p class="wb-bg-ord__m">金卡会员</p></div><span class="wb-bg-wm__tel">136****8821</span><span class="price"><small>¥</small>5,910</span></div>
    </div>
