<!-- cat: BGND | 背景 -->
<style>
  /* 背景类：前缀 wb-bg-。每个演示是一块排了真实内容的小样，文字只落在高对比的底上 */
  #cat-bgnd .demo__stage { padding: 0; border: 0; background: transparent; }
  #cat-bgnd .gallery { align-items: stretch; }
  #cat-bgnd .demo { min-width: 0; }
  #cat-bgnd .badge { min-width: 18px; height: 18px; font-size: var(--fs-xs); line-height: 18px; }
  #cat-bgnd .btn--primary:not([disabled]), #cat-bgnd .btn--danger:not([disabled]) { color: var(--surface); }
  #cat-bgnd .btn--danger-soft:not([disabled]), #cat-bgnd .tag[data-tone="danger"] { color: color-mix(in srgb, var(--danger) 82%, var(--ink)); }
  .wb-bg-f { position: relative; isolation: isolate; min-height: 196px; padding: var(--s-5); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); }
  .wb-bg-f--0 { padding: 0; }
  .wb-bg-f--0 > .wb-bg-brand, .wb-bg-f--0 > .wb-bg-soft, .wb-bg-f--0 > .wb-bg-over, .wb-bg-f--0 > .wb-bg-glass, .wb-bg-f--0 > .wb-bg-scene, .wb-bg-f--0 > .wb-bg-tex { min-height: 196px; }
  .wb-bg-f--c { display: grid; place-items: center; }
  .wb-bg-f--c .empty { padding: 0; }
  .wb-bg-f--mid { display: grid; align-content: center; gap: var(--s-3); }
  .wb-bg-f--zone { padding: 0; background: var(--zone); }
  .wb-bg-body { padding: var(--s-5); }
  .wb-bg-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .wb-bg-grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .wb-bg-kpi { display: grid; gap: var(--s-1); padding: var(--s-4); }
  .wb-bg-kpi .stat__label { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-bg-num { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .wb-bg-num small { margin-left: 2px; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .wb-bg-num small:first-child { margin: 0 2px 0 0; }
  .wb-bg-h { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bg-ord { display: grid; grid-template-columns: 44px minmax(0, 1fr) 72px 64px; align-items: center; gap: var(--s-3); min-height: 64px; }
  .wb-bg-ord .price { text-align: right; }
  .wb-bg-ord .tag { justify-self: center; }
  .wb-bg-ord + .wb-bg-ord { border-top: 1px solid var(--line); }
  .wb-bg-ord img.thumb { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-bg-ord__t { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bg-ord__m { font-size: var(--fs-sm); color: var(--ink-3); }

  /* 顶栏 */
  .wb-bg-topbar { display: flex; align-items: center; gap: var(--s-3); min-height: 64px; padding: 0 var(--s-5); background: var(--surface); border-bottom: 1px solid var(--line); box-shadow: var(--elev-1); }
  .wb-bg-crumb { display: inline-flex; align-items: center; gap: var(--s-2); margin-right: auto; font-size: var(--fs-md); color: var(--ink-3); }
  .wb-bg-crumb b { font-weight: 600; color: var(--ink); }
  .wb-bg-topbar .search { width: 220px; min-height: 40px; }
  .wb-bg-who { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 600; }
  .wb-bg-who img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }

  /* 侧栏 */
  .wb-bg-side { display: grid; grid-template-columns: 88px minmax(0, 1fr); min-height: 220px; }
  .wb-bg-side .rail { position: static; height: auto; min-height: 100%; }
  .wb-bg-side .rail--mist { background: linear-gradient(180deg, var(--action-tint) 0%, var(--bg) 100%); }
  .wb-bg-side__main { display: grid; align-content: start; gap: var(--s-4); padding: var(--s-5); }
  .wb-bg-side__main h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }

  /* 页头 */
  .wb-bg-head { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-6) var(--s-6) var(--s-5); background: linear-gradient(180deg, var(--action-tint) 0%, var(--bg) 100%); }
  .wb-bg-head::after { content: ""; position: absolute; inset: 0; z-index: -1; background: url(../../kit/assets/photo/pattern-petals.webp) right top / 340px; opacity: .35; -webkit-mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); pointer-events: none; }
  .wb-bg-head h1 { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); white-space: nowrap; }
  .wb-bg-head .search { width: 240px; }
  .wb-bg-under { padding: var(--s-4) var(--s-6) var(--s-6); background: var(--bg); }

  /* 登录 */
  .wb-bg-login { display: flex; align-items: center; padding: var(--s-5) var(--s-8); }
  .wb-bg-login--c { justify-content: center; }
  .wb-bg-lcard { color: var(--ink); display: grid; gap: var(--s-4); width: 320px; padding: var(--s-6); box-shadow: var(--elev-3); }
  .wb-bg-grad { background: linear-gradient(135deg, var(--action-press) 0%, var(--action) 100%); color: var(--surface); }

  /* 卡片带底、色带 */
  .wb-bg-ocard { max-width: 420px; margin: 0 auto; overflow: hidden; }
  .wb-bg-ocard__body { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-bg-ocard__body img { width: 56px; height: 56px; border-radius: var(--r-md); object-fit: cover; }
  .wb-bg-ocard__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-5); background: var(--zone); border-top: 1px solid var(--line); }
  .wb-bg-band { border-radius: var(--r-lg); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent); display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-5); }
  .wb-bg-band p { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bg-band__sp { flex: 1; }
  .wb-bg-band .tag { flex: none; }
  .wb-bg-brand { display: grid; align-content: center; gap: var(--s-2); min-height: 168px; padding: var(--s-5); }
  .wb-bg-brand .wb-bg-big { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .wb-bg-brand .wb-bg-lab { font-size: var(--fs-md); }
  .wb-bg-brand .btn { justify-self: start; margin-top: var(--s-2); }
  .wb-bg-brand img.wb-bg-pic { position: absolute; right: var(--s-6); top: 50%; width: 148px; height: 148px; border-radius: var(--r-lg); object-fit: cover; transform: translateY(-50%) rotate(4deg); border: 3px solid color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--elev-3); }

  /* 分区底 */
  .wb-bg-zone { display: grid; gap: var(--s-3); padding: var(--s-5); }
  .wb-bg-set { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 56px; padding: 0 var(--s-5); }
  .wb-bg-set + .wb-bg-set { border-top: 1px solid var(--line); }
  .wb-bg-set span { font-size: var(--fs-md); }

  /* 纹理底上的内容卡 */
  .wb-bg-tex { display: grid; align-content: center; min-height: 176px; padding: var(--s-5); }
  .wb-bg-tex .card { max-width: 400px; width: 100%; margin: 0 auto; }
  .wb-bg-mini { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 60px; padding: var(--s-2) var(--s-4); }
  .wb-bg-mini + .wb-bg-mini { border-top: 1px solid var(--line); }
  .wb-bg-mini img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-bg-mini p { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bg-mini p small { display: block; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .wb-bg-bars { display: grid; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-bg-bar { display: grid; grid-template-columns: 48px minmax(0, 1fr) 56px; align-items: center; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); }
  .wb-bg-bar b { text-align: right; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .wb-bg-vip { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-bg-vip img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .wb-bg-vip p { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-bg-vip small { display: block; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }

  /* 图案叠加、渐变与照片 */
  .wb-bg-over { isolation: isolate; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 168px; padding: var(--s-5) var(--s-6); background: linear-gradient(135deg, var(--action-press) 0%, var(--action) 100%); color: var(--surface); }
  .wb-bg-over__txt { display: grid; gap: var(--s-2); }
  .wb-bg-over .wb-bg-big { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .wb-bg-soft { display: grid; align-content: center; gap: var(--s-4); min-height: 168px; padding: var(--s-5); }
  .wb-bg-soft h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-bg-glass { display: grid; align-content: center; justify-items: start; gap: var(--s-2); min-height: 176px; padding: var(--s-5); }
  .wb-bg-glass .wb-bg-pane { display: grid; justify-items: start; gap: var(--s-2); max-width: 340px; padding: var(--s-5); border-radius: var(--r-lg); background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--elev-2); }
  .wb-bg-glass h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-bg-scene { position: relative; display: grid; align-content: center; justify-items: start; gap: var(--s-2); min-height: 176px; padding: var(--s-5); color: var(--surface); }
  .wb-bg-scene::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--action-press) 96%, transparent) 0%, color-mix(in srgb, var(--action-press) 90%, transparent) 44%, transparent 76%); }
  .wb-bg-scene h3 { max-width: 44%; font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-bg-scene p { max-width: 44%; font-size: var(--fs-md); }
  .wb-bg-scene .btn { margin-top: var(--s-2); }

  /* 遮罩 */
  .wb-bg-scrim { position: relative; display: grid; align-content: space-between; min-height: 288px; padding: var(--s-5); background: var(--bg); }
  .wb-bg-chip { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding: var(--s-3) var(--s-4); }
  .wb-bg-chip .stat__label { font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }
  .wb-bg-chip .wb-bg-num { font-size: var(--fs-md); white-space: nowrap; }
  .wb-bg-scrim::after { content: ""; position: absolute; inset: 0; background: var(--scrim); }
  .wb-bg-box { position: absolute; z-index: 1; left: 50%; top: 50%; width: min(300px, calc(100% - var(--s-8))); padding: var(--s-5); border-radius: var(--r-xl); background: var(--surface); box-shadow: var(--elev-4); transform: translate(-50%, -50%); }

  /* 背景效果：左边是名称，右边是价格与动作，效果铺满整张卡 */
  .wb-bg-fx { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 100px; padding: var(--s-5) var(--s-6); }
  .wb-bg-fx h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-bg-fx__tail { display: flex; align-items: center; gap: var(--s-4); flex: none; }
  .wb-bg-mini--flush { padding: 0; }
</style>

<article class="demo" data-cid="WB-BGND-001" data-name="后台页底" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">后台页底</span></div>
  <p class="demo__note">适合：整个后台的最底层，米白托住白卡</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f bg-page">
    <div class="wb-bg-grid3">
      <div class="card wb-bg-kpi"><span class="stat__label">销售额</span><span class="wb-bg-num"><small>¥</small>128,640</span></div>
      <div class="card wb-bg-kpi"><span class="stat__label">订单数</span><span class="wb-bg-num">1,286<small>单</small></span></div>
      <div class="card wb-bg-kpi"><span class="stat__label">客单价</span><span class="wb-bg-num"><small>¥</small>99.6</span></div>
    </div>
    <div class="card" style="margin-top: var(--s-3)"><div class="wb-bg-mini"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><p>红玫瑰花束<small>已售 2,860 件</small></p><span class="price"><small>¥</small>199</span></div></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-BGND-002" data-name="内容区白底" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">内容区白底</span></div>
  <p class="demo__note">适合：表格、详情等需要长时间阅读的区域</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f bg-surface">
    <h3 class="wb-bg-h">最新订单</h3>
    <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div><p class="wb-bg-ord__t">粉芍药花束</p><p class="wb-bg-ord__m">林晓 建国路店</p></div><span class="price"><small>¥</small>239</span><span class="tag" data-tone="warning">待发货</span></div>
    <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-succulent.webp" alt=""><div><p class="wb-bg-ord__t">多肉组合盆</p><p class="wb-bg-ord__m">陈默 徐汇滨江店</p></div><span class="price"><small>¥</small>89</span><span class="tag" data-tone="success">已完成</span></div>
    <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-giftbox.webp" alt=""><div><p class="wb-bg-ord__t">花礼盒</p><p class="wb-bg-ord__m">王芳 浦东世纪店</p></div><span class="price"><small>¥</small>259</span><span class="tag" data-tone="info">待收货</span></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-BGND-003" data-name="顶栏白底" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">顶栏白底</span></div>
  <p class="demo__note">适合：全局顶栏，白底加发丝线与轻阴影</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f wb-bg-f--0 bg-page">
    <header class="wb-bg-topbar">
      <span class="wb-bg-crumb">商品<i class="chev"></i><b>花束</b></span>
      <label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索订单或客户" aria-label="搜索订单或客户"></label>
      <button class="ibtn" data-tip="消息" aria-label="消息"><img src="../../kit/assets/line/message.webp" alt=""><span class="badge">3</span></button>
      <span class="wb-bg-who"><img src="../../kit/assets/marks/mark-015.webp" alt="">周岚</span>
    </header>
    <div class="wb-bg-body"><div class="wb-bg-grid3"><div class="card wb-bg-kpi"><span class="stat__label">库存预警</span><span class="wb-bg-num">6<small>件</small></span></div><div class="card wb-bg-kpi"><span class="stat__label">待发货</span><span class="wb-bg-num">12<small>单</small></span></div><div class="card wb-bg-kpi"><span class="stat__label">待收货</span><span class="wb-bg-num">8<small>单</small></span></div></div></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-BGND-004" data-name="侧栏米白底" data-cat="BGND">
