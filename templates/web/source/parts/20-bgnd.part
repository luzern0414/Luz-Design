      <span class="rail__sp"></span>
      <button class="rail__item"><img src="../../kit/assets/line/settings.webp" alt=""><span>设置</span></button>
    </nav>
    <div class="wb-bg-side__main"><h3>库存概览</h3>
      <div class="wb-bg-grid2"><div class="card wb-bg-kpi"><span class="stat__label">在售商品</span><span class="wb-bg-num">128<small>款</small></span></div><div class="card wb-bg-kpi"><span class="stat__label">库存预警</span><span class="wb-bg-num">6<small>件</small></span></div></div>
      <div class="card"><div class="wb-bg-mini"><img src="../../kit/assets/photo/product-monstera.webp" alt=""><p>龟背竹盆栽<small>库存 24 件</small></p><span class="price"><small>¥</small>159</span></div><div class="wb-bg-mini"><img src="../../kit/assets/photo/product-succulent.webp" alt=""><p>多肉组合盆<small>库存 61 件</small></p><span class="price"><small>¥</small>89</span></div></div>
    </div>
  </div></div></div>
</article>

<article class="demo" data-cid="WB-BGND-006" data-name="页头花瓣底" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">页头花瓣底</span></div>
  <p class="demo__note">适合：每个页面顶部的平面区</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f wb-bg-f--0 bg-page">
    <header class="wb-bg-head"><h1>商品列表</h1><label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索商品名称" aria-label="搜索商品名称"></label></header>
    <div class="wb-bg-under"><div class="wb-bg-grid3"><div class="card wb-bg-kpi"><span class="stat__label">在售商品</span><span class="wb-bg-num">128<small>款</small></span></div><div class="card wb-bg-kpi"><span class="stat__label">待上架</span><span class="wb-bg-num">12<small>款</small></span></div><div class="card wb-bg-kpi"><span class="stat__label">已下架</span><span class="wb-bg-num">6<small>款</small></span></div></div></div>
