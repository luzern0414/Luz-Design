</article>

<article class="demo" data-cid="WB-BGND-032" data-name="滚动边缘渐隐" data-cat="BGND">
  <div class="demo__head"><span class="demo__name">滚动边缘渐隐</span></div>
  <p class="demo__note">适合：限高滚动区上下边缘渐隐提示还有内容</p>
  <div class="demo__stage is-plain"><div class="wb-bg-f wb-bg-f--0 bg-surface" id="wb-bg-fd">
    <div class="wb-bg-fd__bar"><h3 class="wb-bg-h">最新订单</h3><span class="wb-bg-sw"><span>边缘渐隐</span><button class="switch" role="switch" aria-checked="true" aria-label="边缘渐隐"></button></span></div>
    <div class="wb-bg-fd__scroll" tabindex="0" role="region" aria-label="订单列表" data-fade="true">
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><p class="wb-bg-ord__t">红玫瑰花束</p><p class="wb-bg-ord__m">林晓 建国路店</p></div><span class="price"><small>¥</small>199</span><span class="tag" data-tone="warning">待发货</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><div><p class="wb-bg-ord__t">粉芍药花束</p><p class="wb-bg-ord__m">陈默 徐汇滨江店</p></div><span class="price"><small>¥</small>239</span><span class="tag" data-tone="info">待收货</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-giftbox.webp" alt=""><div><p class="wb-bg-ord__t">花礼盒</p><p class="wb-bg-ord__m">王芳 浦东世纪店</p></div><span class="price"><small>¥</small>259</span><span class="tag" data-tone="success">已完成</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><div><p class="wb-bg-ord__t">蓝绣球盆栽</p><p class="wb-bg-ord__m">周岚 建国路店</p></div><span class="price"><small>¥</small>129</span><span class="tag" data-tone="warning">待发货</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-sunflower.webp" alt=""><div><p class="wb-bg-ord__t">向日葵花束</p><p class="wb-bg-ord__m">李强 徐汇滨江店</p></div><span class="price"><small>¥</small>159</span><span class="tag" data-tone="success">已完成</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-succulent.webp" alt=""><div><p class="wb-bg-ord__t">多肉组合盆</p><p class="wb-bg-ord__m">赵敏 浦东世纪店</p></div><span class="price"><small>¥</small>89</span><span class="tag" data-tone="info">待收货</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-monstera.webp" alt=""><div><p class="wb-bg-ord__t">龟背竹盆栽</p><p class="wb-bg-ord__m">孙悦 建国路店</p></div><span class="price"><small>¥</small>159</span><span class="tag" data-tone="success">已完成</span></div>
      <div class="wb-bg-ord"><img class="thumb" src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div><p class="wb-bg-ord__t">白郁金香</p><p class="wb-bg-ord__m">吴桐 徐汇滨江店</p></div><span class="price"><small>¥</small>179</span><span class="tag" data-tone="success">已完成</span></div>
    </div>
  </div></div>
</article>

<style>
  /* 新增：页面水印、滚动边缘渐隐 */
  @property --wb-ft { syntax: "<number>"; inherits: false; initial-value: 0; }
  @property --wb-fb { syntax: "<number>"; inherits: false; initial-value: 1; }
  .wb-bg-sw { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }

  .wb-bg-wm { position: relative; }
  .wb-bg-wm__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 60px; padding: var(--s-3) var(--s-5) var(--s-1); }
  .wb-bg-wm__ctl { display: flex; align-items: center; gap: var(--s-4); }
  .wb-bg-wm__rows { padding: 0 var(--s-5) var(--s-2); }
  .wb-bg-wm__row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 108px 72px; align-items: center; gap: var(--s-3); min-height: 62px; }
  .wb-bg-wm__row + .wb-bg-wm__row { border-top: 1px solid var(--line); }
  .wb-bg-wm__row .avatar { width: 40px; height: 40px; }
  .wb-bg-wm__row .price { text-align: right; }
  .wb-bg-wm__tel { text-align: center; font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .wb-bg-wm__layer { position: absolute; inset: 0; z-index: 2; pointer-events: none; background-repeat: repeat; transition: opacity var(--dur-base) var(--ease-out); }
  .wb-bg-wm[data-on="false"] .wb-bg-wm__layer { opacity: 0; }

  .wb-bg-fd__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 60px; padding: var(--s-3) var(--s-5) var(--s-1); }
  .wb-bg-fd__scroll { --wb-ft: 0; --wb-fb: 1; height: 200px; padding: 0 var(--s-5); overflow-y: auto; scrollbar-width: none; overscroll-behavior: contain; transition: --wb-ft var(--dur-base) var(--ease-out), --wb-fb var(--dur-base) var(--ease-out); }
  .wb-bg-fd__scroll::-webkit-scrollbar { display: none; }
  .wb-bg-fd__scroll:focus-visible { outline-offset: -3px; border-radius: var(--r-md); }
  .wb-bg-fd__scroll[data-fade="true"] { -webkit-mask-image: linear-gradient(to bottom, transparent 0, var(--ink) calc(var(--wb-ft) * 44px), var(--ink) calc(100% - var(--wb-fb) * 44px), transparent 100%); mask-image: linear-gradient(to bottom, transparent 0, var(--ink) calc(var(--wb-ft) * 44px), var(--ink) calc(100% - var(--wb-fb) * 44px), transparent 100%); }
</style>

<script>
(function () {
  const root = document.getElementById('cat-bgnd'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];

  /* 页面水印：账号尾号铺成斜向平铺图，不挡操作；疏密与开关都即时生效，换主题时重画 */
  const wm = $('#wb-bg-wm');
  if (wm) {
    const layer = $('.wb-bg-wm__layer', wm), sw = $('[role="switch"]', wm), seg = $$('.btn-seg button', wm);
    const sizes = { loose: [288, 196], mid: [220, 150], dense: [164, 112] };
    let dens = 'mid';
    const ink = () => { const p = document.createElement('i'); p.style.color = 'var(--ink)'; document.body.appendChild(p); const c = getComputedStyle(p).color; p.remove(); return c; };
    const draw = () => {
      const [tw, th] = sizes[dens], k = 2, c = document.createElement('canvas'); c.width = tw * k; c.height = th * k;
      const g = c.getContext('2d'); if (!g) return;
      g.scale(k, k); g.translate(tw / 2, th / 2); g.rotate(-22 * Math.PI / 180);
      g.fillStyle = ink(); g.globalAlpha = 0.12; g.textAlign = 'center'; g.textBaseline = 'middle';
      g.font = '600 14px ' + getComputedStyle(document.body).fontFamily;
      g.fillText('周岚 尾号 6618', 0, -10); g.fillText('建国路店', 0, 12);
      layer.style.backgroundImage = 'url(' + c.toDataURL() + ')'; layer.style.backgroundSize = tw + 'px ' + th + 'px';
    };
    seg.forEach(b => b.addEventListener('click', () => { dens = b.dataset.d; seg.forEach(x => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
    sw.addEventListener('lz:toggle', () => { wm.dataset.on = sw.getAttribute('aria-checked'); });
    document.addEventListener('lz:skin', () => requestAnimationFrame(draw));
    draw();
  }

  /* 滚动边缘渐隐：顶端不渐隐，滚下去上沿渐隐；没到底下沿渐隐，到底就消失 */
  const fd = $('#wb-bg-fd');
  if (fd) {
    const sc = $('.wb-bg-fd__scroll', fd), sw = $('[role="switch"]', fd);
    const sync = () => { sc.style.setProperty('--wb-ft', sc.scrollTop > 2 ? 1 : 0); sc.style.setProperty('--wb-fb', sc.scrollTop + sc.clientHeight < sc.scrollHeight - 2 ? 1 : 0); };
    sc.addEventListener('scroll', sync, { passive: true });
    sw.addEventListener('lz:toggle', () => { sc.dataset.fade = sw.getAttribute('aria-checked'); });
    new ResizeObserver(sync).observe(sc); sync();
  }
})();
</script>
