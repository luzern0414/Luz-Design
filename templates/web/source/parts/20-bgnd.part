      <button class="rail__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>工作台</span></button>
      <button class="rail__item"><img src="../../kit/assets/line/archive.webp" alt=""><span>订单</span></button>
      <button class="rail__item"><img src="../../kit/assets/line/list.webp" alt=""><span>商品</span></button>
      <span class="rail__sp"></span>
      <button class="rail__item"><img src="../../kit/assets/line/settings.webp" alt=""><span>设置</span></button>
    </nav>
    <div class="wb-bg-side__main"><h3>经营概览</h3>
      <div class="wb-bg-grid2"><div class="card wb-bg-kpi"><span class="stat__label">销售额</span><span class="wb-bg-num"><small>¥</small>128,640</span></div><div class="card wb-bg-kpi"><span class="stat__label">订单数</span><span class="wb-bg-num">1,286<small>单</small></span></div></div>
      <div class="card"><div class="wb-bg-mini"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><p>红玫瑰花束<small>已售 2,860 件</small></p><span class="price"><small>¥</small>199</span></div><div class="wb-bg-mini"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><p>粉芍药花束<small>已售 1,920 件</small></p><span class="price"><small>¥</small>239</span></div></div>
    </div>
  </div></div></div>
</article>

<article class="demo" data-cid="WB-BGND-005" data-name="侧栏渐变底" data-cat="BGND">
