<article class="demo demo--span2" data-cid="WB-CARD-043" data-name="轮播图展示" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">轮播图展示</span></div>
  <p class="demo__note">适合：官网与后台首页的多图自动轮播，带指示点与箭头</p>
  <div class="demo__stage"><div class="wb-cd-cr wb-cd-w wb-cd-w--lg" id="wb-cd-cr" role="region" aria-roledescription="轮播" aria-label="活动轮播" data-playing="true">
    <div class="wb-cd-cr__track" tabindex="0">
      <figure class="wb-cd-cr__slide" role="group" aria-label="第 1 张，共 3 张"><img src="../../kit/assets/photo/scene-hero-pink.webp" alt=""><figcaption class="wb-cd-cr__pane"><span class="tag" data-tone="warning">活动</span><h3>春日花展</h3><p>报名进行中</p><button class="btn btn--primary btn--sm" data-wb-toast="已打开报名">去报名</button></figcaption></figure>
      <figure class="wb-cd-cr__slide" role="group" aria-label="第 2 张，共 3 张"><img src="../../kit/assets/photo/bg-floral.webp" alt=""><figcaption class="wb-cd-cr__pane"><span class="tag" data-tone="action">订阅</span><h3>周期订花</h3><p>已开通 36 家门店</p><button class="btn btn--primary btn--sm" data-wb-toast="已打开周期订花">查看门店</button></figcaption></figure>
      <figure class="wb-cd-cr__slide" role="group" aria-label="第 3 张，共 3 张"><img src="../../kit/assets/photo/bg-green.webp" alt=""><figcaption class="wb-cd-cr__pane"><span class="tag" data-tone="success">绿植</span><h3>绿植养护月</h3><p>盆栽满 199 元减 30 元</p><button class="btn btn--primary btn--sm" data-wb-toast="已打开绿植">去选购</button></figcaption></figure>
    </div>
    <button class="ibtn ibtn--round wb-cd-cr__nav wb-cd-cr__nav--prev" aria-label="上一张" data-tip="上一张"><span class="chev"></span></button>
    <button class="ibtn ibtn--round wb-cd-cr__nav wb-cd-cr__nav--next" aria-label="下一张" data-tip="下一张"><span class="chev"></span></button>
    <div class="wb-cd-cr__bar"><button class="wb-cd-cr__play" aria-label="暂停轮播" data-tip="暂停轮播"><img src="../../kit/assets/line/pause.webp" alt=""></button><div class="wb-cd-cr__dots" role="tablist" aria-label="选择轮播图"><button class="wb-cd-cr__dot" role="tab" aria-label="第 1 张" aria-selected="true"></button><button class="wb-cd-cr__dot" role="tab" aria-label="第 2 张" aria-selected="false"></button><button class="wb-cd-cr__dot" role="tab" aria-label="第 3 张" aria-selected="false"></button></div></div>
  </div></div>
</article>

<article class="demo demo--span2" data-cid="WB-CARD-048" data-name="描述列表卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">描述列表卡</span></div>
  <p class="demo__note">适合：订单与会员详情以键值栅格展示，可设列数与边框</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--lg" id="wb-cd-ds">
    <div class="section__head"><h2>订单详情</h2></div>
    <div class="card section__body wb-cd-ds" data-bordered="false" style="--cols: 3">
      <div class="toolbar">
        <div class="seg seg--box" role="tablist" aria-label="列数"><button class="seg__item" role="tab" data-c="1" aria-selected="false">一列</button><button class="seg__item" role="tab" data-c="2" aria-selected="false">两列</button><button class="seg__item" role="tab" data-c="3" aria-selected="true">三列</button></div>
        <span class="toolbar__sp"></span>
        <span class="wb-cd-sw">边框<button class="switch" role="switch" aria-checked="false" aria-label="显示边框"></button></span>
      </div>
      <dl class="wb-cd-ds__grid">
        <div class="wb-cd-ds__i"><dt>订单号</dt><dd>0218</dd></div>
        <div class="wb-cd-ds__i"><dt>下单时间</dt><dd>11 月 8 日 15:20</dd></div>
        <div class="wb-cd-ds__i"><dt>订单状态</dt><dd><span class="tag" data-tone="warning">待发货</span></dd></div>
        <div class="wb-cd-ds__i"><dt>客户</dt><dd><span class="wb-cd-who"><img src="../../kit/assets/marks/mark-003.webp" alt="">林晓</span></dd></div>
        <div class="wb-cd-ds__i"><dt>手机号</dt><dd>138****6618</dd></div>
        <div class="wb-cd-ds__i"><dt>会员等级</dt><dd><span class="tag" data-tone="warning">金卡会员</span></dd></div>
        <div class="wb-cd-ds__i"><dt>配送门店</dt><dd>建国路店</dd></div>
        <div class="wb-cd-ds__i"><dt>配送方式</dt><dd>同城配送</dd></div>
        <div class="wb-cd-ds__i"><dt>支付方式</dt><dd>微信支付</dd></div>
        <div class="wb-cd-ds__i"><dt>商品</dt><dd>红玫瑰花束 1 束</dd></div>
        <div class="wb-cd-ds__i"><dt>优惠</dt><dd>新客立减 20 元</dd></div>
        <div class="wb-cd-ds__i"><dt>实付金额</dt><dd><span class="price"><small>¥</small>199</span></dd></div>
        <div class="wb-cd-ds__i wb-cd-ds__i--all"><dt>收货地址</dt><dd>上海市徐汇区滨江大道 288 号花园广场二十五层 2503 室</dd></div>
      </dl>
    </div>
  </div></div>
</article>

<style>
  /* 新增：图片预览、二维码、条目列表、头像堆叠、折叠面板、文本省略、视频、评论、音频、前后对比、悬停切图、轮播、描述列表 */
  .wb-cd-sw { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }
  .wb-cd-sw .switch { flex: none; }

  /* 图片预览器：缩略图列表与独立图片预览页 */
  .wb-cd-pv__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-2); padding: var(--s-3); }
  .wb-cd-pv__th { position: relative; aspect-ratio: 1; border-radius: var(--r-md); overflow: hidden; background: var(--zone); }
  .wb-cd-pv__th img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-base) var(--ease-out); }
  .wb-cd-pv__ov { position: absolute; inset: 0; display: grid; place-items: center; background: color-mix(in srgb, var(--ink) 40%, transparent); color: var(--surface); font-size: var(--fs-sm); font-weight: 600; opacity: 0; transition: opacity var(--dur-quick) var(--ease-out); }
  .wb-cd-pv__th:focus-visible { outline-offset: 2px; border-radius: var(--r-md); }
  .wb-cd-pv__th:focus-visible .wb-cd-pv__ov { opacity: 1; }
  @media (hover: hover) { .wb-cd-pv__th:hover .wb-cd-pv__ov { opacity: 1; } .wb-cd-pv__th:hover img { transform: scale(1.04); } }
  .wb-cd-pv__mask { display: block; background: white; }
  .wb-cd-pv__dlg { width: 100%; display: grid; background: white; }
  .wb-cd-pv__dlg:focus-visible { outline: none; }
  .wb-cd-pv__top { display: flex; align-items: center; gap: var(--s-3); min-height: 56px; padding: 0 var(--s-3) 0 var(--s-5); border-bottom: 1px solid var(--line); }
  .wb-cd-pv__title { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .wb-cd-pv__idx { margin-right: auto; font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wb-cd-pv__view { position: relative; height: min(360px, calc(100vh - 220px)); overflow: hidden; background: var(--zone); display: grid; place-items: center; touch-action: none; }
  .wb-cd-pv__img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; user-select: none; -webkit-user-drag: none; transition: transform var(--dur-base) var(--ease-out); cursor: default; }
  .wb-cd-pv__view[data-zoom="true"] .wb-cd-pv__img { cursor: grab; }
  .wb-cd-pv__view.is-drag .wb-cd-pv__img { transition: none; cursor: grabbing; }
  .wb-cd-pv__nav { position: absolute; top: 50%; width: 40px; height: 40px; margin-top: -20px; z-index: 1; }
  .wb-cd-pv__nav--prev { left: var(--s-3); }
  .wb-cd-pv__nav--next { right: var(--s-3); }
  .wb-cd-pv__nav--prev .chev::after { margin: 0 0 0 4px; transform: rotate(135deg); }
  .wb-cd-pv__nav--next .chev::after { margin: 0 4px 0 0; }
  .wb-cd-pv__nav[disabled], .wb-cd-pv__tools .ibtn[disabled] { opacity: .35; pointer-events: none; }
  .wb-cd-pv__tools { display: flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 60px; padding: var(--s-2) var(--s-4); border-top: 1px solid var(--line); }
  .wb-cd-pv__flip { transform: scaleX(-1); }
  .wb-cd-pv__pct { min-width: 48px; text-align: center; font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* 二维码展示卡 */
  .wb-cd-qr { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-qr__panel { display: grid; justify-items: center; gap: var(--s-3); width: 100%; }
  .wb-cd-qr__box { position: relative; display: grid; place-items: center; padding: var(--s-3); border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .wb-cd-qr__cv { display: block; width: 165px; height: 165px; transition: opacity var(--dur-base) var(--ease-out); }
  .wb-cd-qr__box[data-state="expired"] .wb-cd-qr__cv { opacity: .12; }
  .wb-cd-qr__mask { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--s-3); border-radius: inherit; font-size: var(--fs-md); font-weight: 600; }
  .wb-cd-qr__info { display: grid; justify-items: center; gap: var(--s-2); }
  .wb-cd-qr__st { display: flex; align-items: center; justify-content: center; gap: var(--s-2); }
  .wb-cd-qr__prog { width: 100%; height: 6px; }
  .wb-cd-qr__prog > i { transition: width 1s linear, background var(--dur-base) var(--ease-out); }
  .wb-cd-qr[data-low="true"] .wb-cd-qr__prog > i { background: var(--warning); }
  .wb-cd-qr .wb-cd-acts { justify-content: center; }

  /* 图文条目列表 */
  .wb-cd-il__row { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: var(--s-4); min-height: 72px; padding: var(--s-3) var(--s-4); width: 100%; text-align: left; position: relative; transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-il__row + .wb-cd-il__row::before { content: ""; position: absolute; top: 0; left: calc(var(--s-4) + 48px + var(--s-4)); right: 0; border-top: 1px solid var(--line); }
  .wb-cd-il__row--link { cursor: pointer; }
  @media (hover: hover) { .wb-cd-il__row--link:hover { background: var(--zone); } }
  .wb-cd-il__row--link:active { background: var(--zone); }
  .wb-cd-il__row[data-off] .ic { opacity: .45; filter: grayscale(1); }
  .wb-cd-il__main { display: grid; gap: 2px; min-width: 0; }
  .wb-cd-il__t { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-cd-il__d { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-il__row[data-off] .wb-cd-il__t { color: var(--ink-3); }

  /* 头像组堆叠 */
  .wb-cd-as { display: grid; gap: 0; }
  .wb-cd-as__top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-cd-as__stack { display: flex; align-items: center; padding-left: 12px; }
  .wb-cd-as__stack .avatar { width: 44px; height: 44px; margin-left: -12px; border: 2px solid var(--surface); transition: transform var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .wb-cd-as__stack .avatar:hover { transform: translateY(-3px); } }
  .wb-cd-as__stack .avatar:focus-visible { outline-offset: 1px; border-radius: 50%; transform: translateY(-3px); }
  .wb-cd-as__more { display: grid; place-items: center; width: 44px; height: 44px; margin-left: -12px; border-radius: 50%; border: 2px solid var(--surface); background: var(--action-soft); color: var(--action-press); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-as__more:focus-visible { border-radius: 50%; }
  @media (hover: hover) { .wb-cd-as__more:hover { background: var(--action-edge); } }
  .wb-cd-as__list { padding: var(--s-2) var(--s-5) var(--s-3); background: var(--zone); border-top: 1px solid var(--line); border-radius: 0 0 calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px); }
  .wb-cd-as__row { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; }
  .wb-cd-as__row + .wb-cd-as__row { border-top: 1px solid var(--line); }
  .wb-cd-as__row .avatar { width: 36px; height: 36px; background: var(--surface); }
  .wb-cd-as__row .tag { margin-left: auto; }

  /* 折叠面板组 */
  .wb-cd-ac__item + .wb-cd-ac__item { border-top: 1px solid var(--line); }
  .wb-cd-ac__h { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 64px; padding: 0 var(--s-5); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-ac__h:focus-visible { outline-offset: -3px; }
  @media (hover: hover) { .wb-cd-ac__h:not([disabled]):hover { background: var(--zone); } }
  .wb-cd-ac__t { display: grid; gap: 2px; flex: 1; min-width: 0; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-cd-ac__t small { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .wb-cd-ac__h .chev::after { transition: transform var(--dur-base) var(--ease-out); }
  .wb-cd-ac__h[disabled] { cursor: not-allowed; }
  .wb-cd-ac__h[disabled] .wb-cd-ac__t { color: var(--ink-3); }
  .wb-cd-ac__h[disabled] .chev { opacity: .4; }
  .wb-cd-ac__body { display: grid; gap: var(--s-2); padding: var(--s-1) var(--s-5) var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); line-height: var(--lh-body); }
  .wb-cd-ac__body li { position: relative; padding-left: var(--s-4); }
  .wb-cd-ac__body li::before { content: ""; position: absolute; left: 2px; top: .7em; width: 6px; height: 6px; border-radius: 50%; background: var(--action-edge); }

  /* 描述列表卡 */
  .wb-cd-ds { padding: var(--s-5); }
  .wb-cd-ds .toolbar { min-height: 0; padding: 0 0 var(--s-4); border-bottom: 1px solid var(--line); }
  .wb-cd-ds .seg--box { margin: 0; }
  .wb-cd-ds__grid { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: var(--s-4) var(--s-8); margin: var(--s-4) 0 0; font-size: var(--fs-md); }
  .wb-cd-ds__i { display: grid; grid-template-columns: 80px minmax(0, 1fr); align-items: center; gap: var(--s-3); min-height: 32px; }
  .wb-cd-ds__i--all { grid-column: 1 / -1; }
  .wb-cd-ds dt { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-ds dd { min-width: 0; }
  .wb-cd-ds .wb-cd-who { font-size: var(--fs-md); color: var(--ink); }
  .wb-cd-ds .wb-cd-who img { background: var(--zone); }
  .wb-cd-ds[data-bordered="true"] .wb-cd-ds__grid { gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .wb-cd-ds[data-bordered="true"] .wb-cd-ds__i { gap: 0; padding: 0; min-height: 48px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); grid-template-columns: 96px minmax(0, 1fr); }
  .wb-cd-ds[data-bordered="true"] dt { align-self: stretch; display: flex; align-items: center; padding: 0 var(--s-4); background: var(--zone); border-right: 1px solid var(--line); color: var(--ink-2); }
  .wb-cd-ds[data-bordered="true"] dd { padding: 0 var(--s-4); }

  /* 文本省略展开 */
  .wb-cd-el { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-el__blk { display: grid; justify-items: start; gap: var(--s-1); }
  .wb-cd-el__txt { font-size: var(--fs-md); line-height: var(--lh-body); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--n, 2); overflow: hidden; }
  .wb-cd-el__txt.is-open { display: block; -webkit-line-clamp: unset; }
  .wb-cd-tx { display: inline-flex; align-items: center; gap: 2px; min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 600; line-height: 1; color: var(--action-press); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .wb-cd-tx:hover { background: var(--zone); } }
  .wb-cd-el__tg { margin-left: calc(var(--s-2) * -1); }
  .wb-cd-el__tg .chev::after { margin: -2px 0 0 4px; transform: rotate(45deg); border-color: var(--action-press); transition: transform var(--dur-base) var(--ease-out); }
  .wb-cd-el__tg[aria-expanded="true"] .chev::after { margin-top: 3px; transform: rotate(225deg); }
  .wb-cd-el__one { width: 100%; font-size: var(--fs-md); line-height: var(--lh-body); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; border-radius: var(--r-sm); }
  .wb-cd-el__one:focus-visible { outline-offset: 2px; }

  /* 视频播放卡：无视频素材，用封面加进度模拟播放 */
  .wb-cd-vd__screen { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--zone); cursor: pointer; }
  .wb-cd-vd__poster { width: 100%; height: 100%; object-fit: cover; }
  .wb-cd-vd__big { position: absolute; left: 50%; top: 46%; display: grid; place-items: center; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: var(--surface); box-shadow: var(--elev-3); transition: transform var(--dur-quick) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .wb-cd-vd__big:focus-visible { border-radius: 50%; }
  .wb-cd-vd__big img { width: 28px; height: 28px; margin-left: 3px; }
  @media (hover: hover) { .wb-cd-vd__big:hover { transform: scale(1.06); } }
  .wb-cd-vd[data-state="playing"] .wb-cd-vd__big { opacity: 0; pointer-events: none; }
  .wb-cd-vd__ctl { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-3) var(--s-2); background: linear-gradient(to top, color-mix(in srgb, var(--ink) 70%, transparent), transparent); color: var(--surface); cursor: default; }
  .wb-cd-vd__pp { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--r-md); flex: none; }
  .wb-cd-vd__pp img { width: 22px; height: 22px; filter: invert(1); }
  @media (hover: hover) { .wb-cd-vd__pp:hover { background: color-mix(in srgb, var(--surface) 22%, transparent); } }
  .wb-cd-vd__time { font-size: var(--fs-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wb-cd-vd__time b { font-weight: 600; }
  .wb-cd-vd__bar { position: relative; flex: 1; min-width: 0; height: 20px; cursor: pointer; }
  .wb-cd-vd__bar::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 4px; margin-top: -2px; border-radius: var(--r-full); background: color-mix(in srgb, var(--surface) 38%, transparent); }
  .wb-cd-vd__bar i { position: absolute; left: 0; top: 50%; width: calc(var(--p, 0) * 1%); height: 4px; margin-top: -2px; border-radius: var(--r-full); background: var(--surface); }
  .wb-cd-vd__bar i::after { content: ""; position: absolute; right: -6px; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: var(--surface); box-shadow: var(--elev-1); }
  .wb-cd-vd__bar:focus-visible { outline-color: var(--surface); outline-offset: 0; border-radius: var(--r-sm); }
  .wb-cd-vd__rate { min-width: 52px; height: 28px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 600; color: var(--surface); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--surface) 55%, transparent); flex: none; }
  @media (hover: hover) { .wb-cd-vd__rate:hover { background: color-mix(in srgb, var(--surface) 22%, transparent); } }
  .wb-cd-vd__info { display: grid; gap: var(--s-2); padding: var(--s-4) var(--s-5) var(--s-5); }

  /* 评论回复卡 */
  .wb-cd-cm { display: grid; padding: var(--s-2) var(--s-5); }
  .wb-cd-cm__item, .wb-cd-cm__reply { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: var(--s-3); align-items: start; }
  .wb-cd-cm__item { padding: var(--s-4) 0; }
  .wb-cd-cm__item + .wb-cd-cm__item { border-top: 1px solid var(--line); }
  .wb-cd-cm__item > .avatar { width: 40px; height: 40px; }
  .wb-cd-cm__reply { grid-template-columns: 32px minmax(0, 1fr); padding-top: var(--s-3); }
  .wb-cd-cm__reply > .avatar { width: 32px; height: 32px; }
  .wb-cd-cm__main { display: grid; gap: var(--s-1); min-width: 0; }
  .wb-cd-cm__hd { display: flex; align-items: center; gap: var(--s-2); min-height: 24px; }
  .wb-cd-cm__hd .wb-cd-meta { margin-left: auto; }
  .wb-cd-cm__hd .tag + .wb-cd-meta { margin-left: auto; }
  .wb-cd-cm__txt { font-size: var(--fs-md); line-height: var(--lh-body); }
  .wb-cd-cm__acts { display: flex; align-items: center; gap: var(--s-2); margin-left: calc(var(--s-2) * -1); }
  .wb-cd-cm__like { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .wb-cd-cm__like img { width: 20px; height: 20px; opacity: .4; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
  .wb-cd-cm__like[aria-pressed="true"] { color: var(--action-press); font-weight: 600; }
  .wb-cd-cm__like[aria-pressed="true"] img { opacity: 1; transform: scale(1.12); }
  @media (hover: hover) { .wb-cd-cm__like:hover { background: var(--zone); } }
  .wb-cd-cm__replies { display: grid; margin-top: var(--s-1); }
  .wb-cd-cm__replies:empty { display: none; }
  .wb-cd-cm__more { justify-self: start; min-height: 28px; margin: var(--s-1) 0 0 calc(var(--s-2) * -1); }
  .wb-cd-cm__more .chev::after { margin: -2px 0 0 4px; transform: rotate(45deg); border-color: var(--action-press); transition: transform var(--dur-base) var(--ease-out); }
  .wb-cd-cm__more[aria-expanded="true"] .chev::after { margin-top: 3px; transform: rotate(225deg); }
  .wb-cd-cm__form { display: flex; align-items: center; gap: var(--s-2); padding-top: var(--s-3); }
  .wb-cd-cm__form .input { min-height: 40px; }
  .wb-cd-cm .expand > div { margin: 0 -2px; padding: 0 2px; }
  .wb-cd-cm .expand[data-open="true"] > div { animation: none; overflow: visible; }

  /* 音频播放条 */
  .wb-cd-au__item { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-cd-au__item + .wb-cd-au__item { border-top: 1px solid var(--line); }
  .wb-cd-au__pp { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--action); transition: background var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
  .wb-cd-au__pp:focus-visible { border-radius: 50%; }
  .wb-cd-au__pp:active { transform: scale(.94); }
  @media (hover: hover) { .wb-cd-au__pp:hover { background: var(--action-press); } }
  .wb-cd-au__pp img { width: 20px; height: 20px; filter: invert(1); }
  .wb-cd-au__item[data-state="idle"] .wb-cd-au__pp img { margin-left: 2px; }
  .wb-cd-au__mid { display: grid; gap: var(--s-2); min-width: 0; }
  .wb-cd-au__hd { display: flex; align-items: center; gap: var(--s-2); }
  .wb-cd-au__hd .wb-cd-meta b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .wb-cd-au__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--danger); flex: none; }
  .wb-cd-au__item[data-unread="false"] .wb-cd-au__dot { display: none; }
  .wb-cd-au__wave { display: flex; align-items: center; gap: 3px; height: 32px; cursor: pointer; border-radius: var(--r-sm); }
  .wb-cd-au__wave i { flex: 1; min-width: 2px; height: calc(var(--h) * 1%); min-height: 4px; border-radius: var(--r-full); background: var(--line-strong); transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-au__wave i[data-on] { background: var(--action); }
  .wb-cd-au__wave:focus-visible { outline-offset: 2px; }

  /* 前后对比滑块 */
  .wb-cd-df { position: relative; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); aspect-ratio: 4 / 3; overflow: hidden; cursor: ew-resize; touch-action: pan-y; user-select: none; background: var(--zone); }
  .wb-cd-df img { grid-area: 1 / 1; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  .wb-cd-df img.wb-cd-df__b { position: absolute; inset: 0; filter: grayscale(.85) brightness(.82) contrast(.9); clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .wb-cd-df__tag { position: absolute; top: var(--s-3); background: color-mix(in srgb, var(--surface) 92%, transparent); color: var(--ink); }
  .wb-cd-df__tag--l { left: var(--s-3); }
  .wb-cd-df__tag--r { right: var(--s-3); }
  .wb-cd-df__line { position: absolute; top: 0; bottom: 0; left: var(--p); width: 2px; margin-left: -1px; background: var(--surface); box-shadow: var(--elev-1); }
  .wb-cd-df__grip { position: absolute; left: 50%; top: 50%; display: flex; align-items: center; justify-content: center; gap: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: var(--surface); box-shadow: var(--elev-3); }
  .wb-cd-df__grip .chev::after { width: 6px; height: 6px; margin: 0; border-color: var(--action-press); }
  .wb-cd-df__grip .chev:first-child::after { transform: rotate(135deg); margin-right: -1px; }
  .wb-cd-df__grip .chev:last-child::after { margin-left: -1px; }
  .wb-cd-df:focus-visible { outline-offset: -3px; border-radius: var(--r-lg); }
  .wb-cd-df-card .wb-cd-pic__b { padding-top: var(--s-4); }

  /* 悬停切图商品卡 */
  .wb-cd-hg__media { position: relative; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); aspect-ratio: 4 / 3; overflow: hidden; background: var(--zone); touch-action: pan-y; }
  .wb-cd-hg__media img { grid-area: 1 / 1; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .wb-cd-hg__media img.is-on { opacity: 1; }
  .wb-cd-hg__media:focus-visible { outline-offset: -3px; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .wb-cd-hg__bars { position: absolute; left: var(--s-4); right: var(--s-4); bottom: var(--s-3); display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-1); }
  .wb-cd-hg__bars i { display: block; height: 4px; border-radius: var(--r-full); background: color-mix(in srgb, var(--surface) 55%, transparent); transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-hg__bars i[data-on] { background: var(--surface); }

  /* 轮播图展示 */
  .wb-cd-cr { position: relative; border-radius: var(--r-lg); overflow: hidden; background: var(--zone); box-shadow: var(--elev-1); }
  .wb-cd-cr__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .wb-cd-cr__track::-webkit-scrollbar { display: none; }
  .wb-cd-cr__track:focus-visible { outline-offset: -3px; border-radius: var(--r-lg); }
  .wb-cd-cr__track.is-drag { cursor: grabbing; user-select: none; }
  .wb-cd-cr__slide { position: relative; flex: 0 0 100%; height: 300px; margin: 0; scroll-snap-align: start; }
  .wb-cd-cr__slide img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  .wb-cd-cr__pane { position: absolute; left: calc(var(--s-3) + 44px + var(--s-4)); top: 50%; display: grid; justify-items: start; gap: var(--s-2); max-width: min(300px, calc(100% - 180px)); padding: var(--s-5); border-radius: var(--r-lg); background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: var(--elev-2); transform: translateY(-50%); }
  .wb-cd-cr__pane h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-cd-cr__pane p { font-size: var(--fs-md); color: var(--ink-2); }
  .wb-cd-cr__pane .btn { margin-top: var(--s-1); }
  .wb-cd-cr__nav { position: absolute; top: 50%; width: 44px; height: 44px; margin-top: -22px; }
  .wb-cd-cr__nav--prev { left: var(--s-3); }
  .wb-cd-cr__nav--next { right: var(--s-3); }
  .wb-cd-cr__nav--prev .chev::after { margin: 0 0 0 4px; transform: rotate(135deg); }
  .wb-cd-cr__nav--next .chev::after { margin: 0 4px 0 0; }
  .wb-cd-cr__bar { position: absolute; left: 50%; bottom: var(--s-3); display: flex; align-items: center; gap: var(--s-2); padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1); border-radius: var(--r-full); background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--elev-1); transform: translateX(-50%); }
  .wb-cd-cr__play { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; }
  .wb-cd-cr__play:focus-visible { border-radius: 50%; }
  .wb-cd-cr__play img { width: 18px; height: 18px; }
  @media (hover: hover) { .wb-cd-cr__play:hover { background: var(--zone); } }
  .wb-cd-cr__dots { display: flex; align-items: center; gap: var(--s-2); }
  .wb-cd-cr__dot { width: 8px; height: 8px; padding: 0; border-radius: var(--r-full); background: var(--line-strong); transition: width var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); position: relative; }
  .wb-cd-cr__dot::before { content: ""; position: absolute; inset: -8px -4px; }
  .wb-cd-cr__dot[aria-selected="true"] { width: 24px; background: var(--action); }
  .wb-cd-cr__dot:focus-visible { outline-offset: 3px; border-radius: var(--r-full); }
</style>

<script>
(function () {
  const root = document.getElementById('cat-card'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];
  const color = v => { const p = document.createElement('i'); p.style.color = 'var(' + v + ')'; document.body.appendChild(p); const c = getComputedStyle(p).color; p.remove(); return c; };
  const clamp = (v, a, b) => Math.min(Math.max(v, a), b);
  const mmss = s => { s = Math.max(0, Math.round(s)); return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); };
  const mss = s => Math.floor(s / 60) + ':' + String(Math.round(s) % 60).padStart(2, '0');

  /* 图片预览器：独立视图，切换、缩放、旋转、拖动查看，方向键与加减号可用，Esc 关闭并回到缩略图 */
  const pv = $('#wb-cd-pv');
  if (pv) {
    const mask = $('.wb-cd-pv__mask', pv), dlg = $('.wb-cd-pv__dlg', mask), view = $('.wb-cd-pv__view', mask), img = $('.wb-cd-pv__img', mask);
    const ths = $$('.wb-cd-pv__th', pv), title = $('.wb-cd-pv__title', mask), idx = $('.wb-cd-pv__idx', mask), pct = $('.wb-cd-pv__pct', mask);
    const Z = [0.5, 0.75, 1, 1.5, 2, 3, 4];
    let cur = 0, zi = 2, rot = 0, tx = 0, ty = 0, opener = null;

    const btn = a => $(`[data-act="${a}"]`, mask);
    const paint = () => {
      img.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot}deg) scale(${Z[zi]})`;
      pct.textContent = Math.round(Z[zi] * 100) + '%'; view.dataset.zoom = String(Z[zi] > 1);
      btn('out').disabled = zi === 0; btn('in').disabled = zi === Z.length - 1;
      btn('prev').disabled = cur === 0; btn('next').disabled = cur === ths.length - 1;
    };
    const reset = () => { zi = 2; rot = 0; tx = 0; ty = 0; paint(); };
    const show = i => { cur = clamp(i, 0, ths.length - 1); const th = ths[cur]; img.src = $('img', th).getAttribute('src'); img.alt = th.dataset.name; title.textContent = th.dataset.name; idx.textContent = (cur + 1) + ' / ' + ths.length; tx = 0; ty = 0; rot = 0; zi = 2; paint(); };
    const open = i => { opener = ths[i]; show(i); pv.querySelector(".wb-cd-pv__grid").hidden = true; mask.hidden = false; dlg.focus({ preventScroll: true }); };
    const close = () => { mask.hidden = true; pv.querySelector(".wb-cd-pv__grid").hidden = false; if (opener) opener.focus({ preventScroll: true }); };
    const zoom = d => { zi = clamp(zi + d, 0, Z.length - 1); if (Z[zi] <= 1) { tx = 0; ty = 0; } paint(); };
    ths.forEach((t, i) => t.addEventListener('click', () => open(i)));
    mask.addEventListener('click', e => {
      if (e.target === mask) { close(); return; }
      const b = e.target.closest('[data-act]'); if (!b) return;
      ({ close, prev: () => show(cur - 1), next: () => show(cur + 1), ccw: () => { rot -= 90; paint(); }, cw: () => { rot += 90; paint(); }, out: () => zoom(-1), in: () => zoom(1), reset }[b.dataset.act] || (() => {}))();
    });
    mask.addEventListener('keydown', e => {
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); return; }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
      else if (e.key === '+' || e.key === '=') zoom(1);
      else if (e.key === '-') zoom(-1);
      else if (e.key === '0') reset();

    });
    view.addEventListener('wheel', e => { e.preventDefault(); zoom(e.deltaY < 0 ? 1 : -1); }, { passive: false });
    let drag = null;
    view.addEventListener('pointerdown', e => { if (Z[zi] <= 1 || e.target.closest('button')) return; drag = { x: e.clientX, y: e.clientY, tx, ty }; view.setPointerCapture(e.pointerId); view.classList.add('is-drag'); });
    view.addEventListener('pointermove', e => { if (!drag) return; tx = drag.tx + e.clientX - drag.x; ty = drag.ty + e.clientY - drag.y; paint(); });
    const endDrag = () => { drag = null; view.classList.remove('is-drag'); };
    view.addEventListener('pointerup', endDrag); view.addEventListener('pointercancel', endDrag);
  }

  /* 二维码：收款码 60 秒有效，临近失效变色，失效后遮住并可刷新；活动码长期有效 */
  const qr = $('#wb-cd-qr');
  if (qr) {
    const MATS = [
      '/h6L/BSbEG6TvLt0riXbrakuwQrVB/qqr+AH4QCqEkCXh1K39ZU3nenCA8EqhxaKHgDF3CpFGpvjf1ZqaUFp0VymszVosFIQa2KF+ABOLH/5q2vQS+cdurL/7dCSX+6zDlMEKh/v74o7gA==',
      '/gUD/BF4kG6zXrt15sXbqBGuwUitB/qqr+AdTwC+IcvlTrE5+snUElI64E1nP/UO3DgkPKR96qBtR9KJ53ygMtKpr9bnQ/rz6aE9+4BsFF/4hWswVWkVutF/1dXR0e6zbd0ERvxv73LYAA==',
      '/uob/BKAUG6LZrt1FwXbq+AuwVdhB/qqr+AcUwCLttfNbonabPns8Ii7J101TjJIw7YczefzxTxxNi52+w6uijEPg+4Eaas0/TJM/IBjnGf7ZusQT3UUuqZvpdMJMm6KVT8Emzt/6UMfAA==',
      '/l7r/BZYEG6ZvLt0DiXbrKsuwQr1B/qqr+AB5wCqYkCWAhK34dEl/bDibMVuAgbsTjDE6srbGqnjfyKiKcDOkHyr7yWI01JgareE+ABCJH/4q2vQTucduqr/7dJS3+6+CFMEXi/v7Mo7gA=='
    ];
    const N = 29, Q = 2, K = 10, LIFE = 60;
    const bitsOf = b64 => { const bin = atob(b64), out = []; for (let i = 0; i < bin.length; i++) { const v = bin.charCodeAt(i); for (let k = 7; k >= 0; k--) out.push((v >> k) & 1); } return out; };
    const draw = (cv, m) => {
      const size = (N + Q * 2) * K; cv.width = size; cv.height = size; const g = cv.getContext('2d'); if (!g) return;
      g.fillStyle = color('--surface'); g.fillRect(0, 0, size, size); g.fillStyle = color('--ink');
      const bits = bitsOf(m); for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (bits[y * N + x]) g.fillRect((x + Q) * K, (y + Q) * K, K, K);
    };
    const pay = $('.wb-cd-qr__panel[data-key="pay"]', qr), ev = $('.wb-cd-qr__panel[data-key="event"]', qr);
    const cvPay = $('canvas', pay), cvEv = $('canvas', ev), box = $('.wb-cd-qr__box', pay), mask = $('.wb-cd-qr__mask', pay);
    const tag = $('[data-tag]', pay), leftEl = $('[data-left]', pay), bar = $('.progress', pay), fill = $('.progress > i', pay), save = $('[data-save]', pay);
    let left = LIFE, mi = 0, expired = false;
    const render = () => {
      const low = left <= 10 && !expired; qr.dataset.low = String(low);
      tag.textContent = expired ? '已失效' : low ? '即将失效' : '有效'; tag.dataset.tone = expired ? 'danger' : low ? 'warning' : 'success';
      leftEl.textContent = expired ? '已超过有效期' : '还剩 ' + left + ' 秒';
      fill.style.setProperty('--v', (left / LIFE * 100) + '%'); bar.setAttribute('aria-valuenow', String(left));
      box.dataset.state = expired ? 'expired' : 'valid'; mask.hidden = !expired; save.disabled = expired;
    };
    const refresh = () => { mi = (mi + 1) % 3; draw(cvPay, MATS[mi]); left = LIFE; expired = false; render(); Lz.toast('已刷新二维码', 'success'); };
    $$('[data-refresh]', pay).forEach(b => b.addEventListener('click', refresh));
    setInterval(() => { if (expired) return; left -= 1; if (left <= 0) { left = 0; expired = true; } render(); }, 1000);
    const redraw = () => { draw(cvPay, MATS[mi]); draw(cvEv, MATS[3]); };
    document.addEventListener('lz:skin', () => requestAnimationFrame(redraw));
    redraw(); render();
  }

  /* 图文条目列表：开关即点即存，说明跟着变 */
  const il = $('#wb-cd-il');
  if (il) { const sw = $('[role="switch"]', il), d = $('[data-d]', il); sw.addEventListener('lz:toggle', () => { const on = sw.getAttribute('aria-checked') === 'true'; d.textContent = on ? '声音与角标提醒' : '提醒已关闭'; Lz.toast(on ? '已开启新订单提醒' : '已关闭新订单提醒', 'success'); }); }

  /* 头像组堆叠：点加几人，全部成员就近展开 */
  const as = $('#wb-cd-as');
  if (as) {
    const more = $('.wb-cd-as__more', as), list = $('#wb-cd-as-list', as); list.inert = true;
    more.addEventListener('click', () => {
      const open = list.dataset.open !== 'true'; list.dataset.open = String(open); list.inert = !open;
      more.setAttribute('aria-expanded', String(open)); more.textContent = open ? '收起' : '+3';
      const t = open ? '收起成员列表' : '展开全部成员'; more.setAttribute('aria-label', t); more.dataset.tip = t;
      document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' }));
    });
  }

  /* 折叠面板组：可限制同时只展开一项 */
  const ac = $('#wb-cd-ac');
  if (ac) {
    const heads = $$('.wb-cd-ac__h', ac), sw = $('[role="switch"]', ac);
    let only = true;
    const set = (h, open) => { const p = document.getElementById(h.getAttribute('aria-controls')); h.setAttribute('aria-expanded', String(open)); p.dataset.open = String(open); p.inert = !open; };
    heads.forEach(h => { const p = document.getElementById(h.getAttribute('aria-controls')); p.inert = h.getAttribute('aria-expanded') !== 'true'; });
    heads.forEach(h => h.addEventListener('click', () => {
      const open = h.getAttribute('aria-expanded') !== 'true';
      if (open && only) heads.forEach(x => { if (x !== h) set(x, false); });
      set(h, open);
    }));
    sw.addEventListener('lz:toggle', () => { only = sw.getAttribute('aria-checked') === 'true'; if (only) { const first = heads.find(h => h.getAttribute('aria-expanded') === 'true'); heads.forEach(h => { if (h !== first) set(h, false); }); } });
  }

  /* 描述列表卡：列数与边框 */
  const dsRoot = $('#wb-cd-ds');
  if (dsRoot) {
    const ds = $('.wb-cd-ds', dsRoot), segs = $$('.seg__item', ds), sw = $('[role="switch"]', ds);
    segs.forEach(b => b.addEventListener('click', () => { ds.style.setProperty('--cols', b.dataset.c); segs.forEach(x => x.setAttribute('aria-selected', String(x === b))); }));
    sw.addEventListener('lz:toggle', () => { ds.dataset.bordered = sw.getAttribute('aria-checked'); });
  }

  /* 文本省略展开：只有真的超出行数才出现展开 */
  const el = $('#wb-cd-el');
  if (el) {
    $$('.wb-cd-el__blk', el).forEach(blk => {
      const t = $('.wb-cd-el__txt', blk), g = $('.wb-cd-el__tg', blk); if (!t) return;
      const check = () => { if (t.classList.contains('is-open')) return; g.hidden = !(t.scrollHeight > t.clientHeight + 1); };
      g.addEventListener('click', () => { const open = !t.classList.contains('is-open'); t.classList.toggle('is-open', open); g.setAttribute('aria-expanded', String(open)); g.firstChild.nodeValue = open ? '收起' : '展开'; if (!open) check(); });
      new ResizeObserver(check).observe(t); check();
    });
  }

  /* 视频播放卡：没有视频文件，用封面和进度条模拟，点画面、播放键或空格播放暂停，拖动进度条跳转 */
  const vd = $('#wb-cd-vd');
  if (vd) {
    const DUR = 200, RATES = [1, 1.5, 2];
    const screen = $('.wb-cd-vd__screen', vd), big = $('.wb-cd-vd__big', vd), pp = $('.wb-cd-vd__pp', vd), bar = $('.wb-cd-vd__bar', vd), rate = $('.wb-cd-vd__rate', vd), curEl = $('[data-cur]', vd);
    let t = 0, ri = 0, timer = 0;
    const paint = () => { bar.style.setProperty('--p', (t / DUR * 100).toFixed(2)); bar.setAttribute('aria-valuenow', String(Math.round(t))); bar.setAttribute('aria-valuetext', mmss(t)); curEl.textContent = mmss(t); };
    const state = s => {
      vd.dataset.state = s; const play = s !== 'playing';
      const label = s === 'ended' ? '重新播放' : play ? '播放' : '暂停';
      pp.setAttribute('aria-label', label); pp.dataset.tip = label; $('img', pp).src = $('img', pp).src.replace(/(play|pause)\.webp/, play ? 'play.webp' : 'pause.webp');
      big.setAttribute('aria-label', s === 'ended' ? '重新播放' : '播放视频'); big.dataset.tip = big.getAttribute('aria-label');
    };
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => { if (t >= DUR) t = 0; state('playing'); stop(); timer = setInterval(() => { t += RATES[ri] * 0.25; if (t >= DUR) { t = DUR; stop(); state('ended'); } paint(); }, 250); paint(); };
    const pause = () => { stop(); state('paused'); };
    const toggle = () => { if (vd.dataset.state === 'playing') pause(); else start(); };
    big.addEventListener('click', e => { e.stopPropagation(); toggle(); });
    pp.addEventListener('click', toggle);
    screen.addEventListener('click', e => { if (e.target.closest('.wb-cd-vd__ctl')) return; toggle(); });
    rate.addEventListener('click', () => { ri = (ri + 1) % RATES.length; rate.textContent = RATES[ri] + ' 倍'; });
    const seekAt = x => { const r = bar.getBoundingClientRect(); t = clamp((x - r.left) / r.width, 0, 1) * DUR; if (vd.dataset.state === 'ended') state('paused'); paint(); };
    let dragging = false;
    bar.addEventListener('pointerdown', e => { dragging = true; bar.setPointerCapture(e.pointerId); seekAt(e.clientX); });
    bar.addEventListener('pointermove', e => { if (dragging) seekAt(e.clientX); });
    bar.addEventListener('pointerup', () => { dragging = false; });
    bar.addEventListener('keydown', e => {
      const d = { ArrowRight: 5, ArrowLeft: -5 }[e.key];
      if (d) { e.preventDefault(); t = clamp(t + d, 0, DUR); if (vd.dataset.state === 'ended') state('paused'); paint(); }
      else if (e.key === 'Home') { e.preventDefault(); t = 0; paint(); } else if (e.key === 'End') { e.preventDefault(); t = DUR; paint(); }
      else if (e.key === ' ') { e.preventDefault(); toggle(); }
    });
    paint();
  }

  /* 评论回复卡：点赞、就近回复、发送后进入回复列表、折叠更多回复 */
  const cm = $('#wb-cd-cm');
  if (cm) {
    const reply = (who, text) => {
      const d = document.createElement('div'); d.className = 'wb-cd-cm__reply'; d.dataset.who = '周岚';
      d.innerHTML = '<img class="avatar" alt=""><div class="wb-cd-cm__main"><div class="wb-cd-cm__hd"><span class="wb-cd-name">周岚</span><span class="tag" data-tone="action">店长</span><span class="wb-cd-meta">刚刚</span></div><p class="wb-cd-cm__txt"></p><div class="wb-cd-cm__acts"><button class="wb-cd-cm__like" aria-pressed="false" aria-label="点赞"><img alt=""><span data-n>0</span></button><button class="btn btn--text btn--xs" data-reply>回复</button></div></div>';
      $('.avatar', d).src = $('.wb-cd-cm__item .wb-cd-cm__reply .avatar', cm).getAttribute('src');
      $('.wb-cd-cm__like img', d).src = $('.wb-cd-cm__like img', cm).getAttribute('src'); $('.wb-cd-cm__like img', d).dataset.ic = 'heart';
      $('.wb-cd-cm__txt', d).textContent = text; return d;
    };
    cm.addEventListener('click', e => {
      const like = e.target.closest('.wb-cd-cm__like');
      if (like) { const on = like.getAttribute('aria-pressed') !== 'true', n = $('[data-n]', like); like.setAttribute('aria-pressed', String(on)); like.setAttribute('aria-label', on ? '取消点赞' : '点赞'); n.textContent = (+n.textContent) + (on ? 1 : -1); return; }
      const rp = e.target.closest('[data-reply]');
      if (rp) {
        const item = rp.closest('.wb-cd-cm__item'), form = $('.expand[data-form]', item), input = $('.input', form), who = rp.closest('[data-who]').dataset.who;
        const open = !(form.dataset.open === 'true' && input.placeholder === '回复' + who);
        input.placeholder = '回复' + who; form.dataset.open = String(open); form.inert = !open; if (open) input.focus({ preventScroll: true }); return;
      }
      const more = e.target.closest('.wb-cd-cm__more');
      if (more) { const open = more.getAttribute('aria-expanded') !== 'true'; more.setAttribute('aria-expanded', String(open)); $$('[data-more]', more.parentElement).forEach(r => { r.hidden = !open; }); more.firstChild.nodeValue = open ? '收起回复' : '展开另外 2 条回复'; }
    });
    $$('.expand[data-form]', cm).forEach(f => {
      f.inert = true; const input = $('.input', f), send = $('.btn', f);
      input.addEventListener('input', () => { send.disabled = !input.value.trim(); });
      f.addEventListener('submit', e => {
        e.preventDefault(); const v = input.value.trim(); if (!v) return;
        const item = f.closest('.wb-cd-cm__item'), list = $('.wb-cd-cm__replies', item), more = $('.wb-cd-cm__more', list);
        const r = reply('周岚', v); if (more) { more.before(r); if (more.getAttribute('aria-expanded') !== 'true') r.hidden = false; } else list.append(r);
        input.value = ''; send.disabled = true; f.dataset.open = 'false'; f.inert = true; Lz.toast('已回复', 'success');
      });
    });
  }

  /* 音频播放条：同一时间只播一条，点波形跳转，播完回到开头，听过后红点消失 */
  const au = $('#wb-cd-au');
  if (au) {
    const items = $$('.wb-cd-au__item', au); let playing = null;
    const N = 38;
    items.forEach(it => {
      const dur = +it.dataset.dur, seed = +it.dataset.seed, wave = $('.wb-cd-au__wave', it), pp = $('.wb-cd-au__pp', it), curEl = $('[data-cur]', it);
      for (let i = 0; i < N; i++) { const b = document.createElement('i'); b.style.setProperty('--h', Math.round(28 + 62 * Math.abs(Math.sin(i * 0.55 + seed) * Math.cos(i * 0.21 + seed * 1.7)))); wave.appendChild(b); }
      const bars = $$('i', wave); let t = 0, timer = 0;
      const paint = () => { const k = Math.round(t / dur * N); bars.forEach((b, i) => { b.toggleAttribute('data-on', i < k); }); curEl.textContent = mss(t); wave.setAttribute('aria-valuenow', String(Math.round(t))); wave.setAttribute('aria-valuetext', Math.round(t) + ' 秒'); };
      const icon = on => { const im = $('img', pp); im.src = im.src.replace(/(play|pause)\.webp/, on ? 'pause.webp' : 'play.webp'); pp.dataset.tip = on ? '暂停' : '播放'; it.dataset.state = on ? 'playing' : 'idle'; };
      it._stop = () => { clearInterval(timer); timer = 0; icon(false); };
      const play = () => { if (playing && playing !== it) playing._stop(); playing = it; if (t >= dur) t = 0; it.dataset.unread = 'false'; icon(true); clearInterval(timer); timer = setInterval(() => { t += 0.25; if (t >= dur) { t = 0; it._stop(); } paint(); }, 250); };
      pp.addEventListener('click', () => { if (timer) it._stop(); else play(); });
      const seek = x => { const r = wave.getBoundingClientRect(); t = clamp((x - r.left) / r.width, 0, 1) * dur; paint(); };
      let drag = false;
      wave.addEventListener('pointerdown', e => { drag = true; wave.setPointerCapture(e.pointerId); seek(e.clientX); });
      wave.addEventListener('pointermove', e => { if (drag) seek(e.clientX); });
      wave.addEventListener('pointerup', () => { drag = false; });
      wave.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); t = clamp(t + d, 0, dur); paint(); } else if (e.key === ' ') { e.preventDefault(); pp.click(); } });
      paint(); icon(false);
    });
  }

  /* 前后对比滑块：拖动、点按或方向键移动分界线 */
  const df = $('#wb-cd-df');
  if (df) {
    const set = p => { p = clamp(p, 0, 100); df.style.setProperty('--p', p + '%'); df.setAttribute('aria-valuenow', String(Math.round(p))); df.setAttribute('aria-valuetext', p < 4 ? '只显示调色后' : p > 96 ? '只显示调色前' : '调色前占 ' + Math.round(p) + '%'); };
    const at = x => { const r = df.getBoundingClientRect(); set((x - r.left) / r.width * 100); };
    let drag = false;
    df.addEventListener('pointerdown', e => { drag = true; df.setPointerCapture(e.pointerId); at(e.clientX); });
    df.addEventListener('pointermove', e => { if (drag) at(e.clientX); });
    df.addEventListener('pointerup', () => { drag = false; });
    df.addEventListener('keydown', e => { const cur = +df.getAttribute('aria-valuenow'), d = { ArrowRight: 5, ArrowLeft: -5 }[e.key]; if (d) { e.preventDefault(); set(cur + d); } else if (e.key === 'Home') { e.preventDefault(); set(0); } else if (e.key === 'End') { e.preventDefault(); set(100); } });
  }

  /* 悬停切图商品卡：鼠标横移按位置切图，离开回到首图，键盘左右键切换 */
  const hg = $('#wb-cd-hg');
  if (hg) {
    const media = $('.wb-cd-hg__media', hg), imgs = $$('img', media), bars = $$('.wb-cd-hg__bars i', media); let k = 0;
    const show = i => { k = clamp(i, 0, imgs.length - 1); imgs.forEach((m, j) => m.classList.toggle('is-on', j === k)); bars.forEach((b, j) => b.toggleAttribute('data-on', j === k)); media.setAttribute('aria-label', '粉玫瑰花束图片 第 ' + (k + 1) + ' 张 共 ' + imgs.length + ' 张'); };
    const at = x => { const r = media.getBoundingClientRect(); show(Math.floor(clamp((x - r.left) / r.width, 0, .999) * imgs.length)); };
    media.addEventListener('pointermove', e => at(e.clientX)); media.addEventListener('pointerdown', e => at(e.clientX));
    media.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') show(0); });
    media.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); show(k + d); } });
  }

  /* 轮播图展示：自动轮播、箭头、指示点、鼠标拖动与触屏滑动；悬停或聚焦时暂停，可手动暂停 */
  const cr = $('#wb-cd-cr');
  if (cr) {
    const track = $('.wb-cd-cr__track', cr), slides = $$('.wb-cd-cr__slide', cr), dots = $$('.wb-cd-cr__dot', cr), prev = $('.wb-cd-cr__nav--prev', cr), next = $('.wb-cd-cr__nav--next', cr), play = $('.wb-cd-cr__play', cr);
    let idx = 0, playing = !Lz.reduce, hold = false, seen = true, timer = 0;
    const mark = () => { dots.forEach((d, k) => { d.setAttribute('aria-selected', String(k === idx)); d.tabIndex = k === idx ? 0 : -1; }); slides.forEach((s, k) => { s.inert = k !== idx; }); };
    const schedule = () => { clearTimeout(timer); if (playing && !hold && seen) timer = setTimeout(() => go(idx + 1), 4500); };
    const go = (i, wrap = true) => { idx = wrap ? (i + slides.length) % slides.length : clamp(i, 0, slides.length - 1); track.scrollTo({ left: idx * track.clientWidth, behavior: Lz.reduce ? 'auto' : 'smooth' }); mark(); schedule(); };
    const setPlay = on => { playing = on; cr.dataset.playing = String(on); const l = on ? '暂停轮播' : '开始轮播'; play.setAttribute('aria-label', l); play.dataset.tip = l; const im = $('img', play); im.src = im.src.replace(/(play|pause)\.webp/, on ? 'pause.webp' : 'play.webp'); schedule(); };
    prev.addEventListener('click', () => go(idx - 1)); next.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    play.addEventListener('click', () => { setPlay(!playing); document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })); });
    track.addEventListener('keydown', e => { if (e.key === 'ArrowRight') { e.preventDefault(); go(idx + 1); } else if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx - 1); } });
    let settle = 0;
    track.addEventListener('scroll', () => { clearTimeout(settle); settle = setTimeout(() => { const i = Math.round(track.scrollLeft / track.clientWidth); if (i !== idx) { idx = i; mark(); schedule(); } }, 90); }, { passive: true });
    cr.addEventListener('pointerenter', () => { hold = true; schedule(); }); cr.addEventListener('pointerleave', () => { hold = false; schedule(); });
    cr.addEventListener('focusin', () => { hold = true; schedule(); }); cr.addEventListener('focusout', () => { hold = false; schedule(); });
    let drag = null;
    track.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse' || e.target.closest('button')) return; drag = { x: e.clientX, left: track.scrollLeft }; track.style.scrollSnapType = 'none'; track.setPointerCapture(e.pointerId); track.classList.add('is-drag'); });
    track.addEventListener('pointermove', e => { if (drag) track.scrollLeft = drag.left - (e.clientX - drag.x); });
    const endDrag = e => { if (!drag) return; const dx = e.clientX - drag.x; drag = null; track.classList.remove('is-drag'); track.style.scrollSnapType = ''; go(Math.abs(dx) > 40 ? idx + (dx < 0 ? 1 : -1) : idx, false); };
    track.addEventListener('pointerup', endDrag); track.addEventListener('pointercancel', endDrag);
    new IntersectionObserver(es => { seen = es[0].isIntersecting; schedule(); }, { threshold: .3 }).observe(cr);
    new ResizeObserver(() => { track.scrollTo({ left: idx * track.clientWidth, behavior: 'auto' }); }).observe(track);
    setPlay(playing); mark();
  }
})();
</script>
