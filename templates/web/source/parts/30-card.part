    <div style="display: grid; justify-items: end; gap: var(--s-3)"><button class="ibtn" data-tip="编辑商品" aria-label="编辑商品" data-wb-toast="已进入编辑"><img src="../../kit/assets/line/edit.webp" alt=""></button><span class="wb-cd-sw"><span data-lab>已上架</span><button class="switch" role="switch" aria-checked="true" aria-label="上架状态" data-sw></button></span></div>
