<!-- cat: CARD | 卡片 -->
<style>
  /* 卡片类：前缀 wb-cd-。卡片白底；标题放卡外上方；一屏至多一块品牌主卡 */
  #cat-card .gallery { align-items: stretch; }
  #cat-card .demo { min-width: 0; }
  #cat-card .badge { min-width: 18px; height: 18px; font-size: var(--fs-xs); line-height: 18px; }
  #cat-card .btn--primary:not([disabled]), #cat-card .btn--danger:not([disabled]) { color: var(--surface); }
  #cat-card .btn--danger-soft:not([disabled]), #cat-card .tag[data-tone="danger"] { color: color-mix(in srgb, var(--danger) 82%, var(--ink)); }
  #cat-card .demo__stage { display: grid; justify-items: center; align-content: center; min-height: 0; }
  #cat-card .demo__stage.is-plain { min-height: 0; }
  #cat-card .btn[disabled] { box-shadow: none; }
  #cat-card .btn--outline[disabled] { box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .wb-cd-w { width: 100%; max-width: 360px; }
  .wb-cd-w--md { max-width: 500px; }
  .wb-cd-w--lg { max-width: none; }
  .wb-cd-label { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-val { font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .wb-cd-val small { margin-left: 2px; font-size: var(--fs-md); font-weight: 400; color: var(--ink-3); }
  .wb-cd-val small:first-child { margin: 0 2px 0 0; }
  .wb-cd-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 28px; }
  .wb-cd-top .ibtn { width: 32px; height: 32px; margin: -4px -6px -4px 0; }
  .wb-cd-top .ibtn img { width: 18px; height: 18px; }
  .wb-cd-kpi { display: grid; gap: var(--s-2); padding: var(--s-5); }
  .wb-cd-sub { display: flex; align-items: center; gap: var(--s-2); }
  .wb-cd-pad { padding: var(--s-5); }
  .wb-cd-grid { display: grid; gap: var(--s-4); }
  .wb-cd-name { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-cd-meta { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-thumb { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; flex: none; }
  .wb-cd-row { display: flex; align-items: center; gap: var(--s-3); }
  .wb-cd-sp { margin-left: auto; }
  .wb-cd-acts { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); }

  /* 迷你图 */
  .wb-cd-spark { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); align-items: end; gap: 4px; height: 56px; }
  .wb-cd-spark i { display: block; height: calc(var(--h) * 1%); border-radius: 3px 3px 0 0; background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); transition: background var(--dur-quick) var(--ease-out); }
  .wb-cd-spark i[data-top] { background: var(--action); box-shadow: none; }
  @media (hover: hover) { .wb-cd-spark i:hover { background: var(--action); } }

  /* 目标进度与占比 */
  .wb-cd-goal { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .wb-cd-goal b { font-size: var(--fs-xl); font-weight: 700; font-variant-numeric: tabular-nums; }
  .wb-cd-goal b small { margin-right: 2px; font-size: var(--fs-md); font-weight: 400; color: var(--ink-3); }
  .wb-cd-prog { height: 10px; }
  .wb-cd-donutbox { --size: 136px; position: relative; flex: none; width: var(--size); height: var(--size); }
  .wb-cd-donut { display: block; width: 100%; height: 100%; border-radius: 50%; background: conic-gradient(var(--action) 0 48%, var(--accent) 48% 75%, var(--info) 75% 94%, var(--success) 94% 100%); }
  .wb-cd-donut::after { content: ""; position: absolute; inset: 19%; border-radius: 50%; background: var(--surface); }
  .wb-cd-donutbox > div { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; text-align: center; }
  .wb-cd-donutbox b { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-cd-donutbox span { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-cd-legend { flex: 1; min-width: 0; }
  .wb-cd-legend li b { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* 图表壳 */
  .wb-cd-chart { padding: var(--s-4) var(--s-5) var(--s-5); }
  .wb-cd-chart .seg { margin-bottom: var(--s-2); }
  .wb-cd-chart .seg__item { min-height: 32px; padding: 0 var(--s-3); }
  .wb-cd-chart .bars { height: 168px; }
  .wb-cd-chart .bars__col { cursor: pointer; transition: opacity var(--dur-quick) var(--ease-out); }
  .wb-cd-chart .bars__col[aria-current="false"] .bars__bar { background: var(--action-tint); }
  .wb-cd-chart .bars__bar { width: min(34px, 72%); }

  /* 表格壳 */
  .wb-cd-table { overflow: hidden; }
  .wb-cd-table .table { min-width: 720px; }
  .wb-cd-table .table-wrap { overflow-x: auto; }
  .wb-cd-table .toolbar .seg { flex: 1; min-width: 0; padding: 2px; margin-bottom: 0; }
  .wb-cd-table .toolbar .seg__item[aria-selected="true"] { box-shadow: none; }
  .wb-cd-table .toolbar .seg__item { min-height: 32px; padding: 0 var(--s-3); }
  .wb-cd-table td.t-l .wb-cd-name { font-weight: 400; }
  .wb-cd-table .table .who { display: flex; }

  /* 列表壳与排行 */
  .wb-cd-rank { width: 24px; text-align: center; font-size: var(--fs-lg); font-weight: 700; color: var(--ink-3); font-variant-numeric: tabular-nums; flex: none; }
  .wb-cd-rank[data-top] { color: var(--accent); }
  .wb-cd-rk { display: grid; grid-template-columns: 24px 44px minmax(0, 1fr) 56px; align-items: center; gap: var(--s-3); min-height: 64px; padding: var(--s-2) var(--s-5); }
  .wb-cd-rk + .wb-cd-rk { border-top: 1px solid var(--line); }
  .wb-cd-rk img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-cd-rk b { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .wb-cd-rk .progress { height: 6px; margin-top: 6px; }

  /* 资料与会员 */
  .wb-cd-user { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-5) var(--s-5); text-align: center; }
  .wb-cd-user .avatar { width: 72px; height: 72px; box-shadow: 0 0 0 4px var(--action-tint); }
  .wb-cd-user .stats { width: 100%; margin-top: var(--s-1); border-top: 1px solid var(--line); padding-top: var(--s-3); }
  .wb-cd-user .stat { padding: var(--s-1); }
  .wb-cd-vip { position: relative; overflow: hidden; display: grid; gap: var(--s-3); padding: var(--s-5); background: linear-gradient(135deg, var(--accent-tint) 0%, var(--surface) 100%); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent); }
  .wb-cd-vip .ic { position: absolute; right: var(--s-4); top: var(--s-3); width: 72px; height: 72px; }
  .wb-cd-vip__t { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); color: var(--accent); }
  .wb-cd-vip .progress > i { background: var(--accent); }

  /* 待办、看板、方案 */
  .wb-cd-todo { display: grid; grid-template-columns: 22px minmax(0, 1fr); align-items: center; gap: var(--s-3); min-height: 48px; }
  .wb-cd-todo + .wb-cd-todo { border-top: 1px solid var(--line); }
  .wb-cd-todo span.t { font-size: var(--fs-md); transition: color var(--dur-quick) var(--ease-out); }
  .wb-cd-todo [aria-checked="true"] + span.t { color: var(--ink-3); text-decoration: line-through; }
  .wb-cd-kb { display: grid; gap: var(--s-3); padding: var(--s-4); }
  .wb-cd-kb__top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .wb-cd-kb .avatars .avatar { width: 28px; height: 28px; }
  .wb-cd-state { min-height: 28px; padding: 0 var(--s-3); border-radius: var(--r-full); font-size: var(--fs-xs); font-weight: 600; background: var(--zone); color: var(--ink-2); }
  .wb-cd-state[data-s="1"] { background: var(--info-tint); color: var(--info); }
  .wb-cd-state[data-s="2"] { background: var(--success-tint); color: var(--success); }
  .wb-cd-plan { display: grid; gap: var(--s-4); width: 100%; padding: var(--s-5); text-align: left; }
  .wb-cd-plan ul { display: grid; gap: var(--s-2); font-size: var(--fs-md); }
  .wb-cd-plan li { display: flex; align-items: center; gap: var(--s-2); }
  .wb-cd-plan li img { width: 18px; height: 18px; }
  .wb-cd-price { display: flex; align-items: baseline; gap: 4px; font-variant-numeric: tabular-nums; }
  .wb-cd-price b { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; color: var(--ink); }

  /* 通知、时间线、审批 */
  .wb-cd-notes { overflow: hidden; }
  .wb-cd-notes .seg { padding: var(--s-3) var(--s-4) var(--s-1); }
  .wb-cd-notes .seg { margin-bottom: 0; }
  .wb-cd-notes .seg__item { min-height: 32px; padding: 0 var(--s-3); }
  .wb-cd-notes .seg__item[aria-selected="true"] { box-shadow: none; }
  .wb-cd-note { min-height: 60px; }
  .wb-cd-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--danger); flex: none; transition: opacity var(--dur-quick) var(--ease-out); }
  .wb-cd-note[data-unread="false"] .wb-cd-dot { opacity: 0; }
  .wb-cd-note[data-unread="false"] .row__title { font-weight: 400; color: var(--ink-2); }
  .wb-cd-tl { padding: var(--s-5) var(--s-5) var(--s-1); }
  .wb-cd-tl .tl__item p + p { margin-top: 2px; }
  .wb-cd-appr { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-appr .kv { padding: 0; grid-template-columns: 64px minmax(0, 1fr); font-size: var(--fs-md); }
  .wb-cd-appr[data-done] { background: var(--zone); }

  /* 对象卡：商品、订单、门店、库存、活动 */
  .wb-cd-goods { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; align-items: center; gap: var(--s-4); padding: var(--s-4); }
  .wb-cd-sw { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .wb-cd-ord { display: grid; gap: 0; overflow: hidden; }
  .wb-cd-ord__h { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-ord__b { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-cd-ord__b img { width: 56px; height: 56px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-cd-ord__f { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-5); background: var(--zone); }
  .wb-cd-who { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .wb-cd-who img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .wb-cd-store { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-store__h { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); }
  .wb-cd-store__h img { width: 56px; height: 56px; object-fit: contain; }
  .wb-cd-store .stats { border-top: 1px solid var(--line); padding-top: var(--s-3); }
  .wb-cd-store .stat { padding: var(--s-1) var(--s-2); }
  .wb-cd-warn { display: grid; gap: var(--s-4); padding: var(--s-4) var(--s-5); }
  .wb-cd-warn .progress > i { background: var(--danger); }
  .wb-cd-act .card__media { aspect-ratio: 16 / 9; }
  .wb-cd-act__b { display: grid; gap: var(--s-3); padding: var(--s-4) var(--s-5) var(--s-5); }

  /* 品牌主卡、折叠、对比 */
  .wb-cd-hero { position: relative; overflow: hidden; display: grid; gap: var(--s-1); padding: var(--s-5) var(--s-6); min-height: 152px; align-content: center; }
  .wb-cd-hero .wb-cd-val { font-size: var(--fs-3xl); color: var(--ink); }
  .wb-cd-hero .wb-cd-val small, .wb-cd-hero .wb-cd-label { color: var(--ink); }
  .wb-cd-hero img.pic { position: absolute; right: var(--s-5); top: 50%; width: 112px; height: 112px; border-radius: var(--r-lg); object-fit: cover; transform: translateY(-50%) rotate(5deg); border: 3px solid var(--surface); box-shadow: var(--elev-3); }
  .wb-cd-hero .tag { justify-self: start; margin-top: var(--s-2); background: var(--surface); color: var(--action-press); }
  .wb-cd-fold { overflow: hidden; }
  .wb-cd-fold__h { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 64px; padding: 0 var(--s-5); text-align: left; }
  .wb-cd-fold__h .chev::after { transform: rotate(45deg); transition: transform var(--dur-base) var(--ease-out); }
  .wb-cd-fold__h[aria-expanded="true"] .chev::after { transform: rotate(225deg); }
  .wb-cd-fold__line { display: grid; grid-template-columns: 44px minmax(0, 1fr) 40px 64px; align-items: center; gap: var(--s-3); min-height: 56px; }
  .wb-cd-fold__line > :nth-child(n + 3) { text-align: right; }
  .wb-cd-fold__line img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-cd-vs { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-vs__h { display: grid; grid-template-columns: 1fr 72px 1fr; align-items: center; text-align: center; font-size: var(--fs-md); font-weight: 600; }
  .wb-cd-vs__r { display: grid; grid-template-columns: 1fr 72px 1fr; align-items: center; gap: var(--s-2); }
  .wb-cd-vs__r > span { text-align: center; font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-cd-vs__l, .wb-cd-vs__rt { display: grid; gap: 4px; }
  .wb-cd-vs__l { justify-items: end; }
  .wb-cd-vs__l b, .wb-cd-vs__rt b { font-size: var(--fs-md); font-weight: 700; font-variant-numeric: tabular-nums; }
  .wb-cd-vs__bar { height: 8px; width: var(--w); border-radius: var(--r-full); background: var(--action); }
  .wb-cd-vs__rt .wb-cd-vs__bar { background: var(--accent); }
  .wb-cd-vs__l .wb-cd-vs__bar { border-radius: var(--r-full); }

  /* 卡片外观变体 */
  .wb-cd-mini { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-5); }
  .wb-cd-entry { display: grid; grid-template-columns: 56px minmax(0, 1fr); align-items: center; gap: var(--s-3); width: 100%; padding: var(--s-4) var(--s-5); text-align: left; }
  .wb-cd-entry .ic { width: 56px; height: 56px; }
  .wb-cd-soft { display: grid; gap: var(--s-3); padding: var(--s-5); }
  .wb-cd-flat { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-6); padding: var(--s-2) var(--s-1); }
  .wb-cd-flat > div { display: grid; gap: 2px; }
  .wb-cd-soft .wb-cd-flat { padding: 0; }
  .wb-cd-flat--pad { padding: var(--s-4) var(--s-5); }
  .wb-cd-coupon { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .wb-cd-coupon__l { display: grid; gap: 2px; padding: var(--s-5) var(--s-5) var(--s-5) var(--s-6); }
  .wb-cd-coupon__r { display: grid; place-items: center; align-self: stretch; padding: 0 var(--s-5); border-left: 2px dashed var(--line-strong); }
  .wb-cd-coupon .price { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; }
  .wb-cd-stack { isolation: isolate; width: 100%; max-width: 360px; margin-bottom: var(--s-4); }
  .wb-cd-stack::before { left: 14px; right: 14px; bottom: -9px; height: 14px; border: 1px solid var(--line); border-top: 0; }
  .wb-cd-stack::after { content: ""; position: absolute; left: 28px; right: 28px; bottom: -17px; height: 14px; border-radius: 0 0 var(--r-lg) var(--r-lg); background: var(--surface); border: 1px solid var(--line); border-top: 0; box-shadow: var(--elev-1); z-index: -2; }
  .wb-cd-pic { position: relative; }
  .wb-cd-pic .card__media { aspect-ratio: 4 / 3; }
  .wb-cd-pic__b { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-5) var(--s-5); }
  .wb-cd-pic .card__fav .ibtn, .wb-cd-pic .card__fav { z-index: 1; }
  .wb-cd-pic .card__fav { width: 36px; height: 36px; }
  .wb-cd-pic .card__fav img { width: 22px; height: 22px; opacity: .4; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
  .wb-cd-pic .card__fav[aria-pressed="true"] img { opacity: 1; transform: scale(1.15); }

  /* 状态卡：营业、评价、配送、员工、空、骨架 */
  .wb-cd-open { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-5); }
  .wb-cd-open img { width: 56px; height: 56px; object-fit: contain; }
  .wb-cd-open[data-on="false"] img { filter: grayscale(1); opacity: .6; }
  .wb-cd-review { display: grid; gap: 0; padding: var(--s-5); }
  .wb-cd-review > * + * { margin-top: var(--s-3); }
  .wb-cd-review > .expand { margin-top: 0; }
  .wb-cd-review .expand__body { margin-top: var(--s-3); }
  .wb-cd-stars { display: inline-flex; gap: 2px; }
  .wb-cd-stars img { width: 18px; height: 18px; }
  .wb-cd-stars img.off { filter: grayscale(1); opacity: .3; }
  .wb-cd-review p.q { font-size: var(--fs-md); line-height: var(--lh-body); }
  .wb-cd-review .expand__body { display: flex; gap: var(--s-2); padding: var(--s-3); border-radius: var(--r-md); border: 0; }
  .wb-cd-review .expand__body .input { min-height: 40px; }
  .wb-cd-ship { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-cd-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-1); font-size: var(--fs-xs); color: var(--ink-3); text-align: center; }
  .wb-cd-steps li { display: grid; gap: var(--s-2); justify-items: center; }
  .wb-cd-steps li::before { content: ""; width: 100%; height: 6px; border-radius: var(--r-full); background: var(--zone); }
  .wb-cd-steps li[data-done]::before { background: var(--action); }
  .wb-cd-steps li[data-now] { color: var(--action-press); font-weight: 600; }
  .wb-cd-steps li[data-now]::before { background: linear-gradient(90deg, var(--action) 50%, var(--zone) 50%); }
  .wb-cd-staff { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-5); }
  .wb-cd-staff .avatar { width: 56px; height: 56px; }
  .wb-cd-skel { display: grid; gap: var(--s-3); padding: var(--s-5); }
  .wb-cd-skel .skel { height: 16px; }
  #cat-card .empty { padding: var(--s-6) var(--s-4); }
</style>

<article class="demo" data-cid="WB-CARD-001" data-name="数字指标卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">数字指标卡</span></div>
  <p class="demo__note">适合：概览页的核心数字，进入视野时滚动入场</p>
  <div class="demo__stage"><div class="card wb-cd-kpi wb-cd-w">
    <div class="wb-cd-top"><span class="wb-cd-label">销售额</span><button class="ibtn" data-tip="重新入场" aria-label="重新入场" data-wb-replay><img src="../../kit/assets/line/undo.webp" alt=""></button></div>
    <span class="wb-cd-val"><small>¥</small><span data-count data-to="128640">128,640</span></span>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-002" data-name="趋势指标卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">趋势指标卡</span></div>
  <p class="demo__note">适合：数字加同比环比变化</p>
  <div class="demo__stage"><div class="card wb-cd-kpi wb-cd-w">
    <span class="wb-cd-label">订单数</span>
    <span class="wb-cd-val"><span data-count data-to="1286">1,286</span><small>单</small></span>
    <div class="wb-cd-sub"><span class="tag" data-tone="success">增长 8.1%</span><span class="wb-cd-label">较上周</span></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-003" data-name="迷你图指标卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">迷你图指标卡</span></div>
  <p class="demo__note">适合：数字旁带七日走势，悬浮看当日数值</p>
  <div class="demo__stage"><div class="card wb-cd-kpi wb-cd-w">
