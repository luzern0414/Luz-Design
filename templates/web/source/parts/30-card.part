<article class="demo" data-cid="WB-CARD-040" data-name="空数据卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">空数据卡</span></div>
  <p class="demo__note">适合：列表没有内容时占住版面</p>
  <div class="demo__stage"><div class="card card--soft wb-cd-w wb-cd-w--md"><div class="empty"><img data-ic="vase" src="../../kit/assets/icons/flat/vase.webp" alt=""><span>暂无售后订单</span><button class="btn btn--outline btn--sm" data-wb-toast="已刷新">刷新</button></div></div></div>
</article>

<article class="demo" data-cid="WB-CARD-041" data-name="骨架加载卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">骨架加载卡</span></div>
  <p class="demo__note">适合：数据返回前保持卡片的空间关系</p>
  <div class="demo__stage"><div class="card wb-cd-w wb-cd-w--md" id="wb-cd-skel"><div class="wb-cd-skel" data-skel><div class="skel" style="width: 38%"></div><div class="skel" style="height: 32px; width: 62%"></div><div class="skel" style="width: 86%"></div></div><div class="wb-cd-kpi" data-real hidden><span class="wb-cd-label">销售额</span><span class="wb-cd-val"><small>¥</small>128,640</span><div class="wb-cd-sub"><span class="tag" data-tone="success">增长 12.4%</span><span class="wb-cd-label">较上周</span></div></div><div class="wb-cd-acts" style="padding: 0 var(--s-5) var(--s-4)"><button class="btn btn--text btn--sm" data-reload>重新加载</button></div></div></div>
</article>

<script>
(function () {
  const root = document.getElementById('cat-card'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];
  $$('[data-wb-toast]').forEach(b => { b.addEventListener('click', () => Lz.toast(b.dataset.wbToast, 'success')); if (b.getAttribute('role') === 'button') b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); b.click(); } }); });

  /* 数字指标：重新入场 */
  $$('[data-wb-replay]').forEach(b => b.addEventListener('click', () => { const n = $('[data-count]', b.closest('.card')); if (n) Lz.count(n); }));

  /* 折线图：周月切换，换一块画布重新接线 */
  const line = $('#wb-cd-line');
  if (line) {
    const data = {
      week: { labels: ['周一', '周二', '周三', '周四', '周五', '周六', '周日'], values: [8240, 9610, 7380, 10820, 12450, 15220, 13100] },
      month: { labels: ['第一周', '第二周', '第三周', '第四周'], values: [58320, 61480, 55960, 64210] }
    };
    const box = $('.chart', line), read = $('.chart__read', box);
    const draw = k => { const old = $('canvas', box), cv = document.createElement('canvas'); cv.setAttribute('role', 'img'); cv.setAttribute('aria-label', '销售额折线图'); old.replaceWith(cv); Lz.line(cv, { labels: data[k].labels, values: data[k].values, unit: ' 元', read }); };
    $$('.seg__item', line).forEach(b => b.addEventListener('click', () => { $$('.seg__item', line).forEach(x => x.setAttribute('aria-selected', String(x === b))); draw(b.dataset.k); }));
    draw('week');
  }

  /* 条形图：点选、悬浮、键盘都更新同区明细 */
  const bars = $('#wb-cd-bars');
  if (bars) {
    const cols = $$('.bars__col', bars), read = $('.chart__read', bars);
    const pick = c => { cols.forEach(x => x.setAttribute('aria-current', String(x === c))); read.textContent = c.dataset.l + ' 订单 ' + c.dataset.v + ' 单'; };
    cols.forEach(c => { c.addEventListener('click', () => pick(c)); c.addEventListener('pointerenter', () => pick(c)); c.addEventListener('focus', () => pick(c)); });
  }

  /* 待办清单：勾选统计 */
  const todo = $('#wb-cd-todo');
  if (todo) { const sync = () => { $('[data-n]', todo).textContent = $$('[role="checkbox"][aria-checked="true"]', todo).length; }; $$('[role="checkbox"]', todo).forEach(c => c.addEventListener('lz:toggle', sync)); }

  /* 看板工单：待处理 → 处理中 → 已完成 */
  const kb = $('#wb-cd-kb');
  if (kb) { const st = $('.wb-cd-state', kb), names = ['待处理', '处理中', '已完成']; st.addEventListener('click', () => { const n = (+st.dataset.s + 1) % 3; st.dataset.s = n; st.textContent = names[n]; Lz.toast('状态已改为' + names[n], 'success'); }); }

  /* 价格方案：点选高亮 */
  const plan = $('#wb-cd-plan');
  if (plan) { const toggle = () => { const on = plan.getAttribute('aria-pressed') !== 'true'; plan.setAttribute('aria-pressed', String(on)); const l = $('[data-label]', plan); l.textContent = on ? '已选择' : '选择套餐'; l.classList.toggle('btn--primary', on); l.classList.toggle('btn--outline', !on); }; plan.addEventListener('click', toggle); plan.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); } }); }

  /* 通知中心：点开即读，筛选未读，全部已读 */
  const notes = $('#wb-cd-notes');
  if (notes) {
    const rows = $$('.wb-cd-note', notes); let filter = 'all';
    const apply = () => rows.forEach(r => { r.hidden = filter === 'unread' && r.dataset.unread === 'false'; });
    rows.forEach(r => r.addEventListener('click', () => { r.dataset.unread = 'false'; apply(); }));
    $$('.seg__item', notes).forEach(b => b.addEventListener('click', () => { filter = b.dataset.f; $$('.seg__item', notes).forEach(x => x.setAttribute('aria-selected', String(x === b))); apply(); }));
    $('[data-readall]', notes).addEventListener('click', () => { rows.forEach(r => { r.dataset.unread = 'false'; }); apply(); Lz.toast('已全部标为已读', 'success'); });
  }

  /* 退款审批 */
  const appr = $('#wb-cd-appr');
  if (appr) {
    const st = $('[data-st]', appr), done = (text, tone) => { st.textContent = text; st.dataset.tone = tone; appr.dataset.done = ''; $$('button', appr).forEach(b => { b.disabled = true; }); };
    $('[data-yes]', appr).addEventListener('click', () => { done('已同意', 'success'); Lz.toast('已同意退款', 'success'); });
    $('[data-no]', appr).addEventListener('click', async () => { if (await Lz.confirm({ title: '确认驳回该退款申请', ok: '驳回', tone: 'danger' })) { done('已驳回', 'danger'); Lz.toast('已驳回', 'success'); } });
  }

  /* 商品上下架：行内开关 */
  const goods = $('#wb-cd-goods');
  if (goods) { const sw = $('[data-sw]', goods), lab = $('[data-lab]', goods); sw.addEventListener('lz:toggle', () => { const on = sw.getAttribute('aria-checked') === 'true'; lab.textContent = on ? '已上架' : '已下架'; Lz.toast(on ? '已上架' : '已下架', 'success'); }); }

  /* 订单发货 */
  const ord = $('#wb-cd-ord');
  if (ord) $('[data-ship]', ord).addEventListener('click', e => { const st = $('[data-st]', ord); st.textContent = '待收货'; st.dataset.tone = 'info'; e.currentTarget.disabled = true; Lz.toast('已发货', 'success'); });

  /* 库存补货 */
  const warn = $('#wb-cd-warn');
  if (warn) $('[data-fill]', warn).addEventListener('click', e => { const st = $('[data-st]', warn); st.textContent = '库存充足'; st.dataset.tone = 'success'; $('[data-left]', warn).textContent = '46'; $('[data-left]', warn).style.color = 'var(--success)'; $('[data-bar]', warn).style.setProperty('--v', '82%'); $('[data-bar]', warn).style.background = 'var(--success)'; e.currentTarget.disabled = true; Lz.toast('已加入补货单', 'success'); });

  /* 收藏 */
  $$('.card__fav').forEach(f => f.addEventListener('click', () => { const on = f.getAttribute('aria-pressed') !== 'true'; f.setAttribute('aria-pressed', String(on)); Lz.toast(on ? '已收藏' : '已取消收藏', 'success'); }));

  /* 营业状态：暂停前确认。开关在 ui.js 初始化之后再接管，避免被它先翻转 */
  document.addEventListener('DOMContentLoaded', () => setTimeout(() => {
    const open = $('#wb-cd-open'); if (!open) return;
    const sw = $('[data-wb-sw]', open), lab = $('[data-lab]', open);
    sw.setAttribute('role', 'switch'); sw.tabIndex = 0;
    const set = on => { sw.setAttribute('aria-checked', String(on)); open.dataset.on = String(on); lab.textContent = on ? '营业中 至 21:00' : '休息中'; };
    const flip = async () => { if (sw.getAttribute('aria-checked') === 'true') { if (await Lz.confirm({ title: '确认暂停营业', ok: '暂停', tone: 'danger' })) { set(false); Lz.toast('已暂停营业', 'success'); } } else { set(true); Lz.toast('已恢复营业', 'success'); } };
    sw.addEventListener('click', flip); sw.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); flip(); } });
  }, 0));

  /* 骨架加载 */
  const sk = $('#wb-cd-skel');
  if (sk) {
    const skel = $('[data-skel]', sk), real = $('[data-real]', sk), btn = $('[data-reload]', sk);
    const show = () => { skel.hidden = false; real.hidden = true; setTimeout(() => { skel.hidden = true; real.hidden = false; }, 1100); };
    btn.addEventListener('click', show); setTimeout(() => { skel.hidden = true; real.hidden = false; }, 1200);
  }
})();
</script>

<article class="demo" data-cid="WB-CARD-042" data-name="图片预览器" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">图片预览器</span></div>
  <p class="demo__note">适合：点缩略图放大查看，支持切换、缩放与旋转</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--md" id="wb-cd-pv">
    <div class="section__head"><h2>商品图片</h2></div>
    <div class="card section__body wb-cd-pv__grid">
      <button class="wb-cd-pv__th" data-name="红玫瑰花束" aria-label="预览红玫瑰花束"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><span class="wb-cd-pv__ov">预览</span></button>
      <button class="wb-cd-pv__th" data-name="向日葵花束" aria-label="预览向日葵花束"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><span class="wb-cd-pv__ov">预览</span></button>
      <button class="wb-cd-pv__th" data-name="粉芍药花束" aria-label="预览粉芍药花束"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><span class="wb-cd-pv__ov">预览</span></button>
      <button class="wb-cd-pv__th" data-name="蓝绣球盆栽" aria-label="预览蓝绣球盆栽"><img src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><span class="wb-cd-pv__ov">预览</span></button>
    </div>
    <div class="wb-cd-pv__mask" hidden>
      <div class="wb-cd-pv__dlg" role="region" aria-labelledby="wb-cd-pv-t" tabindex="-1">
        <div class="wb-cd-pv__top"><h3 class="wb-cd-pv__title" id="wb-cd-pv-t">红玫瑰花束</h3><span class="wb-cd-pv__idx" aria-live="polite">1 / 4</span><button class="ibtn" data-act="close" aria-label="关闭预览" data-tip="关闭预览"><img src="../../kit/assets/line/close.webp" alt=""></button></div>
        <div class="wb-cd-pv__view">
          <img class="wb-cd-pv__img" alt="">
          <button class="ibtn ibtn--round wb-cd-pv__nav wb-cd-pv__nav--prev" data-act="prev" aria-label="上一张" data-tip="上一张"><span class="chev"></span></button>
          <button class="ibtn ibtn--round wb-cd-pv__nav wb-cd-pv__nav--next" data-act="next" aria-label="下一张" data-tip="下一张"><span class="chev"></span></button>
        </div>
        <div class="wb-cd-pv__tools" role="toolbar" aria-label="图片操作">
          <button class="ibtn" data-act="ccw" aria-label="向左旋转" data-tip="向左旋转"><img src="../../kit/assets/line/undo.webp" alt=""></button>
          <button class="ibtn" data-act="cw" aria-label="向右旋转" data-tip="向右旋转"><img class="wb-cd-pv__flip" src="../../kit/assets/line/undo.webp" alt=""></button>
          <button class="ibtn" data-act="out" aria-label="缩小" data-tip="缩小"><img src="../../kit/assets/line/minus.webp" alt=""></button>
          <span class="wb-cd-pv__pct" aria-live="polite">100%</span>
          <button class="ibtn" data-act="in" aria-label="放大" data-tip="放大"><img src="../../kit/assets/line/add.webp" alt=""></button>
          <button class="btn btn--text btn--sm" data-act="reset">还原</button>
        </div>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-044" data-name="二维码展示卡" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">二维码展示卡</span></div>
  <p class="demo__note">适合：门店收款码与活动码，带有效期提示</p>
  <div class="demo__stage"><div class="card wb-cd-qr wb-cd-w" id="wb-cd-qr">
    <div class="seg seg--box" role="tablist" aria-label="二维码类型" data-seg="wb-cd-qr"><button class="seg__item" data-key="pay" aria-selected="true">收款码</button><button class="seg__item" data-key="event" aria-selected="false">活动码</button></div>
    <div class="wb-cd-qr__panel" data-panel="wb-cd-qr" data-key="pay">
      <div class="wb-cd-qr__box" data-state="valid"><canvas class="wb-cd-qr__cv" role="img" aria-label="建国路店收款码"></canvas><div class="wb-cd-qr__mask" hidden><span>二维码已失效</span><button class="btn btn--primary btn--sm" data-refresh>刷新二维码</button></div></div>
      <div class="wb-cd-qr__info"><p class="wb-cd-name" style="font-size: var(--fs-lg)">建国路店收款码</p><div class="wb-cd-qr__st"><span class="tag" data-tone="success" data-tag>有效</span><span class="wb-cd-meta" data-left aria-live="off">还剩 60 秒</span></div></div>
      <div class="progress wb-cd-qr__prog" role="progressbar" aria-label="剩余有效时间" aria-valuemin="0" aria-valuemax="60" aria-valuenow="60"><i style="--v: 100%"></i></div>
      <div class="wb-cd-acts"><button class="btn btn--outline btn--sm" data-refresh>刷新二维码</button><button class="btn btn--text btn--sm" data-save data-wb-toast="已保存二维码图片">保存图片</button></div>
    </div>
    <div class="wb-cd-qr__panel" data-panel="wb-cd-qr" data-key="event" hidden>
      <div class="wb-cd-qr__box"><canvas class="wb-cd-qr__cv" role="img" aria-label="春日花展报名码"></canvas></div>
      <div class="wb-cd-qr__info"><p class="wb-cd-name" style="font-size: var(--fs-lg)">春日花展报名码</p><div class="wb-cd-qr__st"><span class="tag" data-tone="success">有效</span><span class="wb-cd-meta">有效期至 12 月 31 日</span></div></div>
      <div class="wb-cd-acts"><button class="btn btn--outline btn--sm" data-wb-toast="已复制活动链接">复制链接</button><button class="btn btn--text btn--sm" data-wb-toast="已保存二维码图片">保存图片</button></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-045" data-name="图文条目列表" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">图文条目列表</span></div>
  <p class="demo__note">适合：设置项与资源清单，每行图标、标题、说明与右侧操作</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--md" id="wb-cd-il">
    <div class="section__head"><h2>店铺设置</h2></div>
    <div class="card list section__body">
      <div class="wb-cd-il__row"><img class="ic" data-ic="wallet" src="../../kit/assets/icons/flat/wallet.webp" alt=""><div class="wb-cd-il__main"><p class="wb-cd-il__t">微信支付</p><p class="wb-cd-il__d">收款账户已绑定</p></div><span class="tag" data-tone="success">已开通</span></div>
      <div class="wb-cd-il__row"><img class="ic" data-ic="scooter" src="../../kit/assets/icons/flat/scooter.webp" alt=""><div class="wb-cd-il__main"><p class="wb-cd-il__t">同城配送</p><p class="wb-cd-il__d">5 公里内 满 99 元免配送费</p></div><button class="btn btn--text btn--sm" data-wb-toast="已打开配送设置">配置</button></div>
      <button class="wb-cd-il__row wb-cd-il__row--link" data-wb-toast="已打开优惠券"><img class="ic" data-ic="coupon" src="../../kit/assets/icons/flat/coupon.webp" alt=""><span class="wb-cd-il__main"><span class="wb-cd-il__t">优惠券</span><span class="wb-cd-il__d">3 张进行中</span></span><span class="chev"></span></button>
      <div class="wb-cd-il__row"><img class="ic" data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""><div class="wb-cd-il__main"><p class="wb-cd-il__t">门店地址</p><p class="wb-cd-il__d">建国路 88 号</p></div><button class="btn btn--text btn--sm" data-wb-toast="已进入编辑">编辑</button></div>
      <div class="wb-cd-il__row"><img class="ic" data-ic="bag" src="../../kit/assets/icons/flat/bag.webp" alt=""><div class="wb-cd-il__main"><p class="wb-cd-il__t">新订单提醒</p><p class="wb-cd-il__d" data-d>声音与角标提醒</p></div><button class="switch" role="switch" aria-checked="true" aria-label="新订单提醒"></button></div>
      <div class="wb-cd-il__row" data-off><img class="ic" data-ic="giftcard" src="../../kit/assets/icons/flat/giftcard.webp" alt=""><div class="wb-cd-il__main"><p class="wb-cd-il__t">储值卡</p><p class="wb-cd-il__d">暂未开通</p></div><button class="btn btn--secondary btn--sm" disabled>开通</button></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-046" data-name="头像组堆叠" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">头像组堆叠</span></div>
  <p class="demo__note">适合：协作成员以重叠头像展示并折叠为加几人</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--md" id="wb-cd-as">
    <div class="section__head"><h2>协作成员</h2></div>
    <div class="card section__body wb-cd-as">
      <div class="wb-cd-as__top">
        <div class="wb-cd-as__stack" role="group" aria-label="协作成员">
          <img class="avatar" tabindex="0" data-tip="周岚 店长" src="../../kit/assets/marks/mark-015.webp" alt="周岚">
          <img class="avatar" tabindex="0" data-tip="林晓 花艺师" src="../../kit/assets/marks/mark-003.webp" alt="林晓">
          <img class="avatar" tabindex="0" data-tip="陈默 客服" src="../../kit/assets/marks/mark-008.webp" alt="陈默">
          <img class="avatar" tabindex="0" data-tip="王芳 收银" src="../../kit/assets/marks/mark-012.webp" alt="王芳">
          <img class="avatar" tabindex="0" data-tip="李强 配送员" src="../../kit/assets/marks/mark-009.webp" alt="李强">
          <button class="wb-cd-as__more" aria-expanded="false" aria-controls="wb-cd-as-list" aria-label="展开全部成员" data-tip="展开全部成员">+3</button>
        </div>
        <span class="wb-cd-meta">共 8 位成员</span>
      </div>
      <div class="expand" id="wb-cd-as-list"><div><div class="wb-cd-as__list">
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-015.webp" alt=""><span class="wb-cd-name">周岚</span><span class="tag" data-tone="action">店长</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-003.webp" alt=""><span class="wb-cd-name">林晓</span><span class="tag">花艺师</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-008.webp" alt=""><span class="wb-cd-name">陈默</span><span class="tag">客服</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-012.webp" alt=""><span class="wb-cd-name">王芳</span><span class="tag">收银</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-009.webp" alt=""><span class="wb-cd-name">李强</span><span class="tag">配送员</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-001.webp" alt=""><span class="wb-cd-name">赵敏</span><span class="tag">花艺师</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-005.webp" alt=""><span class="wb-cd-name">孙悦</span><span class="tag">客服</span></div>
        <div class="wb-cd-as__row"><img class="avatar" src="../../kit/assets/marks/mark-020.webp" alt=""><span class="wb-cd-name">吴桐</span><span class="tag">配送员</span></div>
      </div></div></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-047" data-name="折叠面板组" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">折叠面板组</span></div>
  <p class="demo__note">适合：设置与帮助内容分节折叠，同组可限制只开一项</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--md" id="wb-cd-ac">
    <div class="section__head"><h2>帮助中心</h2><div class="section__acts"><span class="wb-cd-sw">只展开一项<button class="switch" role="switch" aria-checked="true" aria-label="只展开一项"></button></span></div></div>
    <div class="card list section__body">
      <div class="wb-cd-ac__item">
        <button class="wb-cd-ac__h" id="wb-cd-ac-h1" aria-expanded="true" aria-controls="wb-cd-ac-p1"><span class="wb-cd-ac__t">配送范围<small>门店周边 5 公里</small></span><span class="chev"></span></button>
        <div class="expand" id="wb-cd-ac-p1" data-open="true" role="region" aria-labelledby="wb-cd-ac-h1"><div><ul class="wb-cd-ac__body"><li>同城配送范围为门店周边 5 公里</li><li>配送时段为 09:00 至 20:00</li><li>订单满 99 元免配送费</li></ul></div></div>
      </div>
      <div class="wb-cd-ac__item">
        <button class="wb-cd-ac__h" id="wb-cd-ac-h2" aria-expanded="false" aria-controls="wb-cd-ac-p2"><span class="wb-cd-ac__t">退款规则<small>发货前可直接退</small></span><span class="chev"></span></button>
        <div class="expand" id="wb-cd-ac-p2" role="region" aria-labelledby="wb-cd-ac-h2"><div><ul class="wb-cd-ac__body"><li>未发货订单可直接申请退款</li><li>已发货订单需商家审核后处理</li><li>审核通过后 3 个工作日内原路退回</li></ul></div></div>
      </div>
      <div class="wb-cd-ac__item">
        <button class="wb-cd-ac__h" id="wb-cd-ac-h3" aria-expanded="false" aria-controls="wb-cd-ac-p3"><span class="wb-cd-ac__t">会员权益<small>金卡享 9 折</small></span><span class="chev"></span></button>
        <div class="expand" id="wb-cd-ac-p3" role="region" aria-labelledby="wb-cd-ac-h3"><div><ul class="wb-cd-ac__body"><li>金卡会员消费享 9 折优惠</li><li>积分可在下单时抵扣现金</li><li>生日当月赠送一张花束券</li></ul></div></div>
      </div>
      <div class="wb-cd-ac__item">
        <button class="wb-cd-ac__h" id="wb-cd-ac-h4" aria-expanded="false" aria-controls="wb-cd-ac-p4" disabled><span class="wb-cd-ac__t">发票开具<small>暂未开通</small></span><span class="chev"></span></button>
        <div class="expand" id="wb-cd-ac-p4" role="region" aria-labelledby="wb-cd-ac-h4"><div><ul class="wb-cd-ac__body"><li>开通后可在订单详情申请电子发票</li></ul></div></div>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-CARD-049" data-name="文本省略展开" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">文本省略展开</span></div>
  <p class="demo__note">适合：长备注与描述超出行数后省略并可展开</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--md" id="wb-cd-el">
    <div class="section__head"><h2>订单备注</h2></div>
    <div class="card section__body wb-cd-el">
      <div class="wb-cd-el__blk">
        <span class="wb-cd-label">客户备注</span>
        <p class="wb-cd-el__txt" id="wb-cd-el-1" style="--n: 2">希望花束以粉白色系为主，包装使用牛皮纸加麻绳，不要放满天星。这是送给妈妈的生日礼物，请附上手写贺卡，内容写妈妈生日快乐，身体健康。配送前请提前半小时电话联系，家里白天没人，可以放在楼下门卫处。</p>
        <button class="wb-cd-tx wb-cd-el__tg" aria-expanded="false" aria-controls="wb-cd-el-1" hidden>展开<span class="chev"></span></button>
      </div>
      <div class="wb-cd-el__blk">
        <span class="wb-cd-label">商品描述</span>
        <p class="wb-cd-el__txt" id="wb-cd-el-2" style="--n: 3">精选 11 枝红玫瑰，搭配尤加利叶与小苍兰，牛皮纸手工包装。花头饱满，开放度适中，签收后剪去根部一小段，放入清水养护，每两天换一次水，可观赏 7 至 10 天。包装内附养护卡片，方便按步骤照顾花束。</p>
        <button class="wb-cd-tx wb-cd-el__tg" aria-expanded="false" aria-controls="wb-cd-el-2" hidden>展开<span class="chev"></span></button>
      </div>
      <div class="wb-cd-el__blk">
        <span class="wb-cd-label">配送备注</span>
        <p class="wb-cd-el__txt" id="wb-cd-el-3" style="--n: 2">放在前台即可</p>
        <button class="wb-cd-tx wb-cd-el__tg" aria-expanded="false" aria-controls="wb-cd-el-3" hidden>展开<span class="chev"></span></button>
      </div>
      <div class="wb-cd-el__blk">
        <span class="wb-cd-label">收货地址</span>
        <p class="wb-cd-el__one" tabindex="0" data-allow-ellipsis data-tip="上海市徐汇区滨江大道 288 号花园广场二十五层 2503 室">上海市徐汇区滨江大道 288 号花园广场二十五层 2503 室</p>
      </div>
    </div>
  </div></div>
</article>

