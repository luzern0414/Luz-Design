<article class="demo demo--span2" data-cid="WB-CARD-009" data-name="表格卡壳" data-cat="CARD">
  <div class="demo__head"><span class="demo__name">表格卡壳</span></div>
  <p class="demo__note">适合：订单等明细表，状态分段只改变下方表格</p>
  <div class="demo__stage"><div class="wb-cd-w wb-cd-w--lg">
    <div class="section__head"><h2>最近订单</h2><div class="section__acts"><button class="ibtn" data-tip="新增订单" aria-label="新增订单" data-wb-toast="已打开新增订单页"><img src="../../kit/assets/line/add.webp" alt=""></button></div></div>
    <div class="card section__body wb-cd-table">
      <div class="toolbar">
        <div class="seg" data-seg="wb-cd-orders" data-seg-for="#wb-cd-tbody" aria-label="订单状态"><button class="seg__item" data-key="all" aria-selected="true">全部</button><button class="seg__item" data-key="待发货" aria-selected="false">待发货</button><button class="seg__item" data-key="待收货" aria-selected="false">待收货</button><button class="seg__item" data-key="已完成" aria-selected="false">已完成</button></div>
        <label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索订单号" aria-label="搜索订单号"></label>
      </div>
      <div class="table-wrap"><table class="table">
        <colgroup><col style="width: 16%"><col style="width: 18%"><col style="width: 26%"><col style="width: 14%"><col style="width: 14%"><col style="width: 12%"></colgroup>
        <thead><tr><th>订单号</th><th class="t-l">客户</th><th class="t-l">商品</th><th class="t-r">金额</th><th>状态</th><th>操作</th></tr></thead>
        <tbody id="wb-cd-tbody">
          <tr data-cat="待发货"><td>0218</td><td class="t-l"><span class="who"><img src="../../kit/assets/marks/mark-003.webp" alt="">林晓</span></td><td class="t-l">红玫瑰花束</td><td class="t-r"><span class="price"><small>¥</small>199</span></td><td><span class="tag" data-tone="warning">待发货</span></td><td><button class="btn btn--text btn--xs" data-wb-toast="已打开详情">详情</button></td></tr>
          <tr data-cat="待收货"><td>0217</td><td class="t-l"><span class="who"><img src="../../kit/assets/marks/mark-008.webp" alt="">陈默</span></td><td class="t-l">粉芍药花束</td><td class="t-r"><span class="price"><small>¥</small>239</span></td><td><span class="tag" data-tone="info">待收货</span></td><td><button class="btn btn--text btn--xs" data-wb-toast="已打开详情">详情</button></td></tr>
          <tr data-cat="已完成"><td>0216</td><td class="t-l"><span class="who"><img src="../../kit/assets/marks/mark-012.webp" alt="">王芳</span></td><td class="t-l">花礼盒</td><td class="t-r"><span class="price"><small>¥</small>259</span></td><td><span class="tag" data-tone="success">已完成</span></td><td><button class="btn btn--text btn--xs" data-wb-toast="已打开详情">详情</button></td></tr>
          <tr data-cat="待发货"><td>0215</td><td class="t-l"><span class="who"><img src="../../kit/assets/marks/mark-015.webp" alt="">周岚</span></td><td class="t-l">蓝绣球盆栽</td><td class="t-r"><span class="price"><small>¥</small>129</span></td><td><span class="tag" data-tone="warning">待发货</span></td><td><button class="btn btn--text btn--xs" data-wb-toast="已打开详情">详情</button></td></tr>
        </tbody>
      </table></div>
      <div class="pager"><span class="pager__total" style="margin-right: auto">共 128 条</span><button class="seg__item" aria-current="page" style="background: var(--action-tint); color: var(--action-press); font-weight: 600">1</button><button class="seg__item">2</button><button class="seg__item">3</button></div>
    </div>
  </div></div>
</article>

