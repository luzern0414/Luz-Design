<article class="demo demo--span2" data-cid="WB-LAYT-032" data-name="大图头图区" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">大图头图区</span></div>
  <p class="demo__note">适合：官网首页的大图、标题与说明区</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--wide" id="wb-lyn-hero">
    <section class="wb-lyn-hero" data-v="l" aria-label="首页头图">
      <div class="wb-lyn-hero__sw"><div class="btn-seg" role="group" aria-label="头图版式"><button type="button" aria-pressed="true" data-v="l">左文版</button><button type="button" aria-pressed="false" data-v="c">居中版</button></div></div>
      <div class="wb-lyn-hero__in">
        <span class="tag tag--pill" data-tone="action">应季上新</span>
        <h2>鲜花直达每个家</h2>
        <p class="wb-lyn-hero__sub">三家门店同城配送 两小时送达</p>
        <div class="wb-lyn-hero__acts"><button type="button" class="btn btn--primary btn--lg" data-wb-toast="已进入商品页">选购鲜花</button><button type="button" class="btn btn--outline btn--lg" data-wb-toast="已打开门店列表">查看门店</button></div>
        <div class="wb-lyn-hero__facts"><div><b>128 款</b><small>在售花束</small></div><div><b>3 家</b><small>同城门店</small></div><div><b>2 小时</b><small>极速送达</small></div></div>
      </div>
    </section>
  </div></div>
</article>

<script>
(function () {
  const root = document.getElementById('cat-layt'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];
  const mark = n => `../../kit/assets/marks/mark-${String(n).padStart(3, '0')}.webp`;
  const photo = n => `../../kit/assets/photo/${n}.webp`;
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const PEOPLE = [['林晓', 1], ['陈默', 2], ['周岚', 3], ['吴桐', 4], ['郑一', 5], ['王宁', 6], ['赵悦', 7], ['孙洁', 9]];
  const GOODS = [['红玫瑰花束', 199, 'product-rose-red'], ['粉芍药花束', 239, 'product-peony-pink'], ['向日葵花束', 159, 'product-sunflower'], ['白郁金香', 179, 'product-tulip-white'], ['蓝绣球盆栽', 129, 'product-hydrangea-blue'], ['龟背竹盆栽', 159, 'product-monstera'], ['多肉组合盆', 89, 'product-succulent'], ['干花花瓶摆件', 129, 'product-pampas-vase'], ['花礼盒', 259, 'product-giftbox']];
  const fmt = n => n.toLocaleString('zh-CN');
  const TONE = { 待付款: 'warning', 待发货: 'action', 待收货: 'info', 已完成: 'success', 售后: 'danger' };
  const tag = s => `<span class="tag"${TONE[s] ? ` data-tone="${TONE[s]}"` : ''}>${s}</span>`;

  /* 021 流程步骤条：下一步校验当前步，出错时标红并停在原处；已完成的步可点回 */
  (() => {
    const box = $('#wb-lyn-stp'); if (!box) return;
    const steps = $$('.wb-lyn-step', box), panes = $$('.wb-lyn-pane', box), prev = $('[data-prev]', box), next = $('[data-next]', box);
    const lic = $('[data-lic]', box), licT = $('[data-lic-t]', box), openTag = $('[data-open-tag]', box);
    const HINT = { done: '已完成', current: '进行中', todo: '未开始', error: '待补充' };
    let cur = 1, bad = -1, fin = false;
    const render = () => {
      steps.forEach((s, i) => {
        const st = fin || i < cur ? 'done' : i === bad ? 'error' : i === cur ? 'current' : 'todo', b = $('button', s);
        s.dataset.state = st; b.disabled = st === 'todo'; $('.wb-lyn-step__hint', s).textContent = HINT[st];
        if (i === cur && !fin) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      });
      panes.forEach((p, i) => { p.toggleAttribute('data-off', i !== cur); p.inert = i !== cur; });
      const ok = lic.getAttribute('aria-checked') === 'true';
      licT.textContent = bad === 1 ? '请先上传营业执照' : ok ? '已上传' : '未上传'; licT.classList.toggle('field__err', bad === 1);
      openTag.textContent = fin ? '营业中' : '待开通'; openTag.dataset.tone = fin ? 'success' : 'action';
      prev.disabled = cur === 0 || fin; next.textContent = fin ? '重新开始' : cur === 3 ? '完成开通' : '下一步';
    };
    steps.forEach((s, i) => $('button', s).addEventListener('click', () => { if (fin) return; cur = i; bad = -1; render(); }));
    prev.addEventListener('click', () => { if (cur > 0) { cur--; bad = -1; render(); } });
    next.addEventListener('click', () => {
      if (fin) { fin = false; cur = 0; bad = -1; render(); return; }
      if (cur === 1 && lic.getAttribute('aria-checked') !== 'true') { bad = 1; render(); return; }
      bad = -1;
      if (cur < 3) cur++; else { fin = true; Lz.toast('门店已开通', 'success'); }
      render();
    });
    box.addEventListener('lz:toggle', () => { if (lic.getAttribute('aria-checked') === 'true') bad = -1; render(); });
    render();
  })();

  /* 022 选项卡面板：方向键与首末键切换，停用项跳过；下划线滑到当前项 */
  (() => {
    const box = $('#wb-lyn-tabs'); if (!box) return;
    const list = $('.wb-lyn-tl', box), tabs = $$('[role="tab"]', list), ink = $('.wb-lyn-ink', list), panels = $$('[role="tabpanel"]', box);
    const on = () => tabs.filter(t => !t.disabled);
    const place = () => { const t = tabs.find(x => x.getAttribute('aria-selected') === 'true'); if (t) { ink.style.setProperty('--x', t.offsetLeft + 'px'); ink.style.setProperty('--w', t.offsetWidth + 'px'); } };
    const pick = (t, focus) => {
      tabs.forEach(x => { const s = x === t; x.setAttribute('aria-selected', String(s)); x.tabIndex = s ? 0 : -1; });
      panels.forEach(p => { const s = p.id === t.getAttribute('aria-controls'); p.toggleAttribute('data-off', !s); p.inert = !s; });
      place(); if (focus) t.focus();
    };
    tabs.forEach(t => t.addEventListener('click', () => pick(t)));
    list.addEventListener('keydown', e => {
      const a = on(), i = a.indexOf(document.activeElement); if (i < 0) return;
      const n = { ArrowRight: a[(i + 1) % a.length], ArrowLeft: a[(i - 1 + a.length) % a.length], Home: a[0], End: a[a.length - 1] }[e.key];
      if (n) { e.preventDefault(); pick(n, true); }
    });
    panels.forEach((p, i) => { p.inert = i !== 0; });
    new ResizeObserver(place).observe(list); place();
  })();

  /* 025 固钉吸附：滚过顶部区后筛选条贴顶并带投影；筛选只影响下方列表 */
  (() => {
    const box = $('#wb-lyn-af'); if (!box) return;
    const sc = $('.wb-lyn-af', box), bar = $('.wb-lyn-af__bar', box), sent = $('.wb-lyn-af__sent', box), rows = $('#wb-lyn-af-rows', box);
    const ORD = [['20388', 0, '待发货'], ['20387', 1, '待发货'], ['20386', 4, '待收货'], ['20385', 8, '已完成'], ['20384', 2, '待发货'], ['20383', 5, '待收货'], ['20382', 3, '已完成'], ['20381', 7, '待发货'], ['20380', 6, '已完成'], ['20379', 0, '待收货'], ['20378', 1, '已完成'], ['20377', 8, '待发货'], ['20376', 5, '已完成'], ['20375', 4, '待收货']];
    rows.innerHTML = ORD.map(([no, g, st], i) => { const p = PEOPLE[(i * 3 + 1) % 8], it = GOODS[g]; return `<div class="row" data-cat="${st}"><img class="row__lead" src="${photo(it[2])}" alt=""><div class="row__main"><p class="row__title">${it[0]}</p><p class="row__meta">订单 ${no} ${p[0]}</p></div><div class="row__trail"><span class="price"><small>¥</small>${it[1]}</span>${tag(st)}</div></div>`; }).join('');
    const cnt = { all: ORD.length }; ORD.forEach(o => { cnt[o[2]] = (cnt[o[2]] || 0) + 1; });
    $$('.seg__item', box).forEach(b => { b.innerHTML = `${b.textContent}<small>${cnt[b.dataset.key]}</small>`; });
    const upd = () => { bar.dataset.stuck = String(sent.getBoundingClientRect().bottom <= sc.getBoundingClientRect().top + 1); };
    sc.addEventListener('scroll', upd, { passive: true }); upd();
  })();

  /* 026 无限滚动：触底自动追加；第三批首次失败，可重试；到尽头给出结束提示 */
  (() => {
    const box = $('#wb-lyn-inf'); if (!box) return;
    const sc = $('.wb-lyn-inf__scroll', box), list = $('[data-list]', box), tail = $('[data-tail]', box), num = $('[data-n]', box);
    const ACT = ['发货订单', '上架商品', '下架商品', '调整库存', '审核售后单', '修改价格', '导出订单', '新增会员'];
    const OBJ = i => (i % 8 === 6 ? '近七日报表' : i % 8 === 7 ? PEOPLE[(i * 5) % 8][0] : i % 8 === 0 || i % 8 === 4 ? '订单 ' + (20400 - i) : GOODS[(i * 4) % 9][0]);
    const ago = i => { const m = Math.round(i * i * 1.6 + i * 3); return m < 1 ? '刚刚' : m < 60 ? m + ' 分钟前' : m < 1440 ? Math.floor(m / 60) + ' 小时前' : Math.floor(m / 1440) + ' 天前'; };
    const TOTAL = 40, SIZE = 8; let loaded = 0, busy = false, failed = false, io = null;
    const state = s => {
      tail.dataset.s = s; sc.setAttribute('aria-busy', String(s === 'loading'));
      tail.innerHTML = s === 'loading' ? '<i class="wb-lyn-spin"></i><span>加载中</span>' : s === 'error' ? '<span>加载失败</span><button type="button" class="btn btn--text btn--sm" data-retry>重试</button>' : s === 'end' ? `<span>已加载全部 ${TOTAL} 条</span>` : '<button type="button" class="btn btn--text btn--sm" data-more>加载更多</button>';
    };
    const add = () => {
      const end = Math.min(TOTAL, loaded + SIZE);
      list.insertAdjacentHTML('beforeend', Array.from({ length: end - loaded }, (_, k) => { const i = loaded + k, p = PEOPLE[(i * 3) % 8]; return `<div class="wb-lyn-lg"${loaded ? ' data-new' : ''}><img class="avatar" src="${mark(p[1])}" alt=""><span><b>${p[0]}</b> ${ACT[i % 8]} ${OBJ(i)}</span><time>${ago(i)}</time></div>`; }).join(''));
      loaded = end; num.textContent = loaded;
    };
    const load = () => {
      if (busy || loaded >= TOTAL) return; busy = true; state('loading');
      setTimeout(() => {
        busy = false;
        if (loaded >= SIZE * 2 && !failed) { failed = true; state('error'); return; }
        add(); state(loaded >= TOTAL ? 'end' : 'idle'); watch();
      }, 650);
    };
    const watch = () => { if (io) io.disconnect(); if (loaded >= TOTAL) return; io = new IntersectionObserver(es => { if (es[0].isIntersecting && tail.dataset.s === 'idle') load(); }, { root: sc, rootMargin: '0px 0px 24px 0px' }); io.observe(tail); };
    tail.addEventListener('click', e => { if (e.target.closest('[data-retry], [data-more]')) load(); });
    add(); state('idle'); watch();
  })();

  /* 027 瀑布流：按类别筛选后列重新排布；点卡片选中，可清除 */
  (() => {
    const box = $('#wb-lyn-ms'); if (!box) return;
    const cards = $$('.wb-lyn-mc', box), num = $('[data-n]', box), clear = $('[data-clear]', box);
    const sync = () => { const n = cards.filter(c => c.getAttribute('aria-pressed') === 'true').length; num.textContent = n; clear.hidden = n === 0; };
    cards.forEach(c => c.addEventListener('click', () => { c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')); sync(); }));
    clear.addEventListener('click', () => { cards.forEach(c => c.setAttribute('aria-pressed', 'false')); sync(); });
  })();

  /* 028 自定义滚动区：自绘滚动条，滑块可拖动，点轨道翻一屏；方向键仍可滚动 */
  (() => {
    const box = $('#wb-lyn-sc'); if (!box) return;
    $('[data-rows]', box).innerHTML = [['红玫瑰花束', 42], ['粉芍药花束', 26], ['向日葵花束', 40], ['白郁金香', 51], ['蓝绣球盆栽', 38], ['龟背竹盆栽', 24], ['多肉组合盆', 0], ['干花花瓶摆件', 33], ['花礼盒', 36], ['白色花束', 18], ['黄郁金香束', 22], ['玫瑰花束', 15]].map(([n, s], i) => { const g = GOODS.find(x => x[0] === n) || GOODS[i % 9]; return `<button type="button" class="row" aria-selected="${i === 1}"><img class="row__lead" src="${photo(g[2])}" alt=""><div class="row__main"><p class="row__title">${n}</p></div><div class="row__trail">${s === 0 ? '<span class="tag" data-tone="warning">售罄</span>' : `库存 ${s} 件`}</div></button>`; }).join('');
    $('[data-strip]', box).innerHTML = GOODS.map(g => `<span class="wb-lyn-sc__cell"><img src="${photo(g[2])}" alt="">${g[0]}</span>`).join('');
    $$('[data-rows] .row', box).forEach(r => r.addEventListener('click', () => $$('[data-rows] .row', box).forEach(x => x.setAttribute('aria-selected', String(x === r)))));
    $$('.wb-lyn-sc', box).forEach(el => {
      const view = $('.wb-lyn-sc__view', el), bar = $('.wb-lyn-sc__bar', el), thumb = $('.wb-lyn-sc__thumb', el), x = el.dataset.axis === 'x';
      let timer, len = 0, track = 0, range = 0;
      const upd = () => {
        const size = x ? view.clientWidth : view.clientHeight, total = x ? view.scrollWidth : view.scrollHeight, pos = x ? view.scrollLeft : view.scrollTop;
        el.dataset.need = String(total > size + 1); if (total <= size + 1) return;
        track = (x ? bar.clientWidth : bar.clientHeight); len = Math.max(36, track * size / total); range = total - size;
        const off = (track - len) * (pos / range);
        if (x) { thumb.style.width = len + 'px'; thumb.style.transform = `translateX(${off}px)`; } else { thumb.style.height = len + 'px'; thumb.style.transform = `translateY(${off}px)`; }
      };
      const flash = () => { el.dataset.on = 'true'; clearTimeout(timer); timer = setTimeout(() => { el.dataset.on = 'false'; }, 900); };
      view.addEventListener('scroll', () => { upd(); flash(); }, { passive: true });
      new ResizeObserver(upd).observe(view); upd();
      thumb.addEventListener('pointerdown', e => {
        e.preventDefault(); e.stopPropagation(); thumb.setPointerCapture(e.pointerId); el.dataset.drag = 'true';
        const p0 = x ? e.clientX : e.clientY, s0 = x ? view.scrollLeft : view.scrollTop;
        const move = ev => { const d = ((x ? ev.clientX : ev.clientY) - p0) * range / Math.max(1, track - len); view[x ? 'scrollLeft' : 'scrollTop'] = s0 + d; };
        const up = () => { el.dataset.drag = 'false'; thumb.removeEventListener('pointermove', move); thumb.removeEventListener('pointerup', up); thumb.removeEventListener('pointercancel', up); };
        thumb.addEventListener('pointermove', move); thumb.addEventListener('pointerup', up); thumb.addEventListener('pointercancel', up);
      });
      bar.addEventListener('pointerdown', e => {
        if (e.target === thumb) return; const r = thumb.getBoundingClientRect(), before = x ? e.clientX < r.left : e.clientY < r.top;
        view.scrollBy({ [x ? 'left' : 'top']: (before ? -1 : 1) * (x ? view.clientWidth : view.clientHeight) * .9, behavior: 'smooth' });
      });
    });
  })();

  /* 029 虚拟滚动列表：一万条只渲染可视行加缓冲；跳转按钮直达首中末 */
  (() => {
    const box = $('#wb-lyn-vl'); if (!box) return;
    const view = $('.wb-lyn-vl__view', box), space = $('[data-space]', box), win = $('[data-win]', box), H = 48, N = 10000, BUF = 3;
    const rd = { from: $('[data-from]', box), to: $('[data-to]', box), r: $('[data-r]', box) };
    space.style.height = N * H + 'px';
    const STS = ['待付款', '待发货', '待收货', '已完成', '已完成', '已完成', '售后', '待发货', '已完成', '待收货'];
    const rec = i => { const g = GOODS[(i * 5 + 2) % 9]; return { no: 30000 - i, who: PEOPLE[(i * 3 + 1) % 8][0], item: g[0], amt: g[1] * (i % 4 === 3 ? 2 : 1), st: STS[(i * 7 + 3) % 10] }; };
    let a = -1, b = -1;
    const draw = () => {
      const vh = view.clientHeight, top = view.scrollTop, s = clamp(Math.floor(top / H) - BUF, 0, N - 1), e = clamp(Math.ceil((top + vh) / H) + BUF, 0, N);
      rd.from.textContent = fmt(clamp(Math.floor(top / H) + 1, 1, N)); rd.to.textContent = fmt(clamp(Math.ceil((top + vh) / H), 1, N));
      if (s === a && e === b) return; a = s; b = e;
      win.style.transform = `translateY(${s * H}px)`;
      win.innerHTML = Array.from({ length: e - s }, (_, k) => { const i = s + k, o = rec(i); return `<div class="wb-lyn-vl__row" role="listitem" aria-posinset="${i + 1}" aria-setsize="${N}"><span class="n">${o.no}</span><span>${o.who}</span><span>${o.item}</span><span class="r">${fmt(o.amt)}.00</span><span class="c">${tag(o.st)}</span></div>`; }).join('');
      rd.r.textContent = e - s;
    };
    view.addEventListener('scroll', () => requestAnimationFrame(draw), { passive: true });
    $$('[data-go]', box).forEach(btn => btn.addEventListener('click', () => { const k = btn.dataset.go; view.scrollTop = k === 'first' ? 0 : k === 'mid' ? (N / 2 - 1) * H : N * H; draw(); }));
    new ResizeObserver(draw).observe(view); draw();
  })();

  /* 031 间距堆叠：方向、间距、对齐都是真实 CSS 属性，读数同步 */
  (() => {
    const box = $('#wb-lyn-sp'); if (!box) return;
    const el = $('[data-box]', box), read = $('[data-read]', box), show = $('[data-gapsw]', box);
    const st = { dir: 'row', gap: '12', al: 'start' }, NAME = { row: '横排', column: '竖排', start: '起点', center: '居中', end: '终点', stretch: '拉伸' };
    const draw = () => {
      el.dataset.dir = st.dir; el.dataset.al = st.al; el.style.setProperty('--gap', st.gap + 'px');
      el.dataset.show = String(show.getAttribute('aria-checked') === 'true');
      read.textContent = `${NAME[st.dir]}，间距 ${st.gap} 像素，${NAME[st.al]}对齐`;
    };
    $$('.btn-seg button', box).forEach(b => b.addEventListener('click', () => {
      st[b.dataset.k] = b.dataset.v; $$(`[data-k="${b.dataset.k}"]`, box).forEach(x => x.setAttribute('aria-pressed', String(x === b))); draw();
    }));
    box.addEventListener('lz:toggle', draw); draw();
  })();

  /* 019 可拖拽分栏：指针拖动、方向键微调、首末键到边界、回车或双击恢复 */
  (() => {
    const box = $('#wb-lyn-spl'); if (!box) return;
    const host = $('[data-host]', box), right = $('[data-right]', box), list = $('[data-list]', box), detail = $('[data-detail]', box), sales = $('[data-sales]', box);
    const L = [['红玫瑰花束', 199, 42, '鲜花'], ['粉芍药花束', 239, 26, '鲜花'], ['向日葵花束', 159, 40, '鲜花'], ['龟背竹盆栽', 159, 24, '绿植'], ['蓝绣球盆栽', 129, 38, '绿植'], ['花礼盒', 259, 36, '礼盒']].map((r, i) => ({ n: r[0], p: r[1], s: r[2], c: r[3], img: ['product-rose-red', 'product-peony-pink', 'product-sunflower', 'product-monstera', 'product-hydrangea-blue', 'product-giftbox'][i] })).slice(0, 5);
    list.innerHTML = L.map((g, i) => `<button type="button" class="row wb-lyn-pr" aria-selected="${i === 0}" data-i="${i}"><img src="${photo(g.img)}" alt=""><div class="row__main"><p class="row__title">${g.n}</p><p class="row__meta">库存 ${g.s} 件</p></div><span class="price"><small>¥</small>${g.p}</span></button>`).join('');
    const show = i => {
      const g = L[i]; $$('.wb-lyn-pr', list).forEach((x, k) => x.setAttribute('aria-selected', String(k === i)));
      $('[data-pic]', detail).src = photo(g.img); $('[data-name]', detail).textContent = g.n; $('[data-price]', detail).innerHTML = '<small>¥</small>' + g.p; $('[data-meta]', detail).textContent = `${g.c} 库存 ${g.s} 件`;
      sales.innerHTML = [0, 1, 2].map(k => { const q = k === 1 ? 2 : 1, w = PEOPLE[(i + k * 2) % 8][0]; return `<div class="wb-lyn-sl"><span class="n">${20388 - i * 3 - k}</span><span>${w}</span><span class="q">${q} 件</span><span class="price"><small>¥</small>${fmt(g.p * q)}</span></div>`; }).join('');
    };
    list.addEventListener('click', e => { const b = e.target.closest('.wb-lyn-pr'); if (b) show(+b.dataset.i); });
    show(0);
    const bind = (sep, box2, prop, min, max, def, axis) => {
      const set = v => { v = clamp(v, min, max); box2.style.setProperty(prop, v + '%'); sep.setAttribute('aria-valuenow', String(Math.round(v))); sep.dataset.v = Math.round(v) + '%'; return v; };
      let v = def;
      sep.addEventListener('pointerdown', e => {
        e.preventDefault(); sep.setPointerCapture(e.pointerId); sep.dataset.on = 'true'; sep.focus({ preventScroll: true }); host.classList.add(axis === 'x' ? 'is-drag' : 'is-drag-y');
        const move = ev => { const r = box2.getBoundingClientRect(); v = set(axis === 'x' ? (ev.clientX - r.left - 6) / r.width * 100 : (ev.clientY - r.top - 6) / r.height * 100); };
        const up = () => { sep.dataset.on = 'false'; host.classList.remove('is-drag', 'is-drag-y'); sep.removeEventListener('pointermove', move); sep.removeEventListener('pointerup', up); sep.removeEventListener('pointercancel', up); };
        sep.addEventListener('pointermove', move); sep.addEventListener('pointerup', up); sep.addEventListener('pointercancel', up);
      });
      sep.addEventListener('keydown', e => {
        const d = axis === 'x' ? { ArrowLeft: -2, ArrowRight: 2 }[e.key] : { ArrowUp: -2, ArrowDown: 2 }[e.key];
        if (d) { e.preventDefault(); v = set(v + d); } else if (e.key === 'Home') { e.preventDefault(); v = set(min); } else if (e.key === 'End') { e.preventDefault(); v = set(max); } else if (e.key === 'Enter') { e.preventDefault(); v = set(def); }
      });
      sep.addEventListener('dblclick', () => { v = set(def); });
      set(def);
    };
    bind($('[data-axis="x"]', host), host, '--l', 22, 60, 36, 'x');
    bind($('[data-axis="y"]', right), right, '--t', 30, 70, 50, 'y');
  })();

  /* 020 栅格布局：预览宽度切换后，容器查询重新分配每块占几栏 */
  (() => {
    const box = $('#wb-lyn-gr'); if (!box) return;
    const vp = $('[data-vp]', box), rd = $('[data-rd]', box), blocks = $$('.wb-lyn-gb', vp);
    $('.wb-lyn-gr__guides', vp).innerHTML = '<i></i>'.repeat(24);
    const draw = () => {
      const w = Math.round(vp.clientWidth), lv = w >= 960 ? ['c', '宽屏'] : w >= 600 ? ['m', '中屏'] : ['s', '窄屏'];
      blocks.forEach(b => { $('[data-n]', b).textContent = `占 ${b.style.getPropertyValue('--' + lv[0]).trim()} 栏`; });
      rd.textContent = `容器 ${fmt(w)} 像素，${lv[1]}布局`;
    };
    $$('.btn-seg button', box).forEach(b => b.addEventListener('click', () => {
      $$('.btn-seg button', box).forEach(x => x.setAttribute('aria-pressed', String(x === b))); vp.style.setProperty('--vw', b.dataset.w);
    }));
    $('[data-guide]', box).addEventListener('lz:toggle', e => { vp.dataset.guide = e.target.getAttribute('aria-checked'); });
    new ResizeObserver(draw).observe(vp); draw();
  })();

  /* 023 锚点导航：点击滚到小节，滚动时高亮当前节；到底部时选中最后一节 */
  (() => {
    const box = $('#wb-lyn-an'); if (!box) return;
    const view = $('.wb-lyn-an__view', box), secs = $$('.wb-lyn-an__sec', box), links = $$('.wb-lyn-an__lnk', box);
    const rel = s => s.getBoundingClientRect().top - view.getBoundingClientRect().top; let lock = 0;
    const mark2 = i => links.forEach((l, k) => { if (k === i) l.setAttribute('aria-current', 'location'); else l.removeAttribute('aria-current'); });
    const spy = () => {
      if (Date.now() < lock) return;
      let cur = 0; secs.forEach((s, i) => { if (rel(s) <= 40) cur = i; });
      if (view.scrollTop + view.clientHeight >= view.scrollHeight - 2) cur = secs.length - 1;
      mark2(cur);
    };
    links.forEach((l, i) => l.addEventListener('click', () => { lock = Date.now() + 700; view.scrollTo({ top: view.scrollTop + rel(secs[i]) }); mark2(i); }));
    view.addEventListener('scroll', spy, { passive: true });
  })();

  /* 030 大型下拉导航：点击展开与切换，Escape 或点空白处收起 */
  (() => {
    const box = $('#wb-lyn-mm'); if (!box) return;
    const trig = $$('[data-mm]', box), panels = { shop: $('#wb-lyn-mm-shop', box), store: $('#wb-lyn-mm-store', box) };
    const set = key => {
      trig.forEach(t => t.setAttribute('aria-expanded', String(t.dataset.mm === key)));
      Object.entries(panels).forEach(([k, p]) => { p.dataset.open = String(k === key); p.inert = k !== key; });
    };
    trig.forEach(t => t.addEventListener('click', e => { e.stopPropagation(); set(t.getAttribute('aria-expanded') === 'true' ? '' : t.dataset.mm); }));
    document.addEventListener('click', e => { if (!e.target.closest('.wb-lyn-mm__panel') || e.target.closest('button')) set(''); });
    box.addEventListener('keydown', e => { if (e.key === 'Escape') { const open = trig.find(t => t.getAttribute('aria-expanded') === 'true'); set(''); if (open) open.focus(); } });
    set('shop');
  })();

  /* 032 大图头图区：左文与居中两种版式 */
  (() => {
    const box = $('#wb-lyn-hero'); if (!box) return;
    const hero = $('.wb-lyn-hero', box), btns = $$('.btn-seg button', box);
    btns.forEach(b => b.addEventListener('click', () => { hero.dataset.v = b.dataset.v; btns.forEach(x => x.setAttribute('aria-pressed', String(x === b))); }));
  })();
})();
</script>
