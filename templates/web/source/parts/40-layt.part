<article class="demo demo--span2" data-cid="WB-LAYT-020" data-name="栅格布局" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">栅格布局</span></div>
  <p class="demo__note">适合：详情与看板按二十四栏栅格对齐并随宽度换列</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--wide wb-ly-f--w" id="wb-lyn-gr">
    <div class="wb-lyn-gr__bar">
      <span>预览宽度</span>
      <div class="btn-seg" role="group" aria-label="预览宽度"><button type="button" aria-pressed="true" data-w="100%">宽屏</button><button type="button" aria-pressed="false" data-w="760px">中屏</button><button type="button" aria-pressed="false" data-w="440px">窄屏</button></div>
      <span class="wb-lyn-gr__sw">显示栏线<button type="button" class="switch" role="switch" aria-checked="false" aria-label="显示栏线" data-guide></button></span>
      <span class="sp"></span>
      <span class="wb-lyn-gr__rd" data-rd aria-live="polite"></span>
    </div>
    <div class="wb-lyn-gr__dock"><div class="wb-lyn-gr__vp" data-vp style="--vw: 100%">
      <div class="wb-lyn-gr__guides" aria-hidden="true"></div>
      <div class="wb-lyn-gr__grid">
        <div class="card wb-lyn-gb" style="--c: 24; --m: 24; --s: 24"><span class="wb-lyn-gb__n" data-n></span><h3>经营概览</h3><p class="wb-ly-meta">建国路店 近七日</p></div>
        <div class="card wb-lyn-gb" style="--c: 6; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><span class="stat__label">销售额</span><span class="wb-ly-num"><small>¥</small>128,640</span></div>
        <div class="card wb-lyn-gb" style="--c: 6; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><span class="stat__label">订单数</span><span class="wb-ly-num">1,286<small>单</small></span></div>
        <div class="card wb-lyn-gb" style="--c: 6; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><span class="stat__label">新增会员</span><span class="wb-ly-num">84<small>人</small></span></div>
        <div class="card wb-lyn-gb" style="--c: 6; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><span class="stat__label">售后单</span><span class="wb-ly-num">3<small>单</small></span></div>
        <div class="card wb-lyn-gb" style="--c: 16; --m: 24; --s: 24"><span class="wb-lyn-gb__n" data-n></span><h3>订单趋势</h3><div class="bars" role="img" aria-label="近七日订单数"><div class="bars__col"><span class="bars__bar" style="--h: 61%; --i: 0"></span>周一</div><div class="bars__col"><span class="bars__bar" style="--h: 66%; --i: 1"></span>周二</div><div class="bars__col"><span class="bars__bar" style="--h: 53%; --i: 2"></span>周三</div><div class="bars__col"><span class="bars__bar" style="--h: 72%; --i: 3"></span>周四</div><div class="bars__col"><span class="bars__bar" style="--h: 86%; --i: 4"></span>周五</div><div class="bars__col" aria-current="true"><span class="bars__bar" style="--h: 100%; --i: 5"></span>周六</div><div class="bars__col"><span class="bars__bar" style="--h: 79%; --i: 6"></span>周日</div></div></div>
        <div class="card wb-lyn-gb" style="--c: 8; --m: 12; --s: 24; grid-template-rows: auto 1fr"><span class="wb-lyn-gb__n" data-n></span><h3>品类占比</h3><div class="wb-ly-row" style="justify-content: center; align-self: center; gap: var(--s-5)"><div class="donut" style="--p1: 48%; --p2: 75%; --size: 112px"><div class="donut__center"><b class="wb-ly-name">1,286</b><span class="wb-ly-meta">总订单</span></div></div><ul class="legend"><li><i style="--c: var(--action)"></i>鲜花</li><li><i style="--c: var(--accent)"></i>绿植</li><li><i style="--c: var(--zone); box-shadow: inset 0 0 0 1px var(--line-strong)"></i>礼盒与花器</li></ul></div></div>
        <div class="card wb-lyn-gb" style="--c: 8; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><h3>热销商品</h3><div class="list"><div class="row"><img class="row__lead" src="../../kit/assets/photo/product-monstera.webp" alt=""><div class="row__main"><p class="row__title">龟背竹盆栽</p></div><div class="row__trail"><span class="price"><small>¥</small>159</span></div></div><div class="row"><img class="row__lead" src="../../kit/assets/photo/product-succulent.webp" alt=""><div class="row__main"><p class="row__title">多肉组合盆</p></div><div class="row__trail"><span class="price"><small>¥</small>89</span></div></div><div class="row"><img class="row__lead" src="../../kit/assets/photo/product-tulip-white.webp" alt=""><div class="row__main"><p class="row__title">白郁金香</p></div><div class="row__trail"><span class="price"><small>¥</small>179</span></div></div></div></div>
        <div class="card wb-lyn-gb" style="--c: 8; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><h3>待办事项</h3><div class="list"><div class="row"><div class="row__main"><p class="row__title">待发货订单</p></div><div class="row__trail"><span class="tag" data-tone="warning">2 单</span></div></div><div class="row"><div class="row__main"><p class="row__title">待收货订单</p></div><div class="row__trail"><span class="tag" data-tone="info">1 单</span></div></div><div class="row"><div class="row__main"><p class="row__title">售后处理</p></div><div class="row__trail"><span class="tag" data-tone="danger">3 单</span></div></div></div></div>
        <div class="card wb-lyn-gb" style="--c: 8; --m: 12; --s: 24"><span class="wb-lyn-gb__n" data-n></span><h3>会员动态</h3><div class="list"><div class="row"><img class="row__lead avatar" src="../../kit/assets/marks/mark-001.webp" alt=""><div class="row__main"><p class="row__title">林晓</p></div><div class="row__trail"><span class="wb-ly-meta">升级金卡</span></div></div><div class="row"><img class="row__lead avatar" src="../../kit/assets/marks/mark-002.webp" alt=""><div class="row__main"><p class="row__title">陈默</p></div><div class="row__trail"><span class="wb-ly-meta">首次下单</span></div></div><div class="row"><img class="row__lead avatar" src="../../kit/assets/marks/mark-004.webp" alt=""><div class="row__main"><p class="row__title">吴桐</p></div><div class="row__trail"><span class="wb-ly-meta">领取礼券</span></div></div></div></div>
      </div>
    </div></div>
  </div></div>
</article>

<article class="demo demo--span2" data-cid="WB-LAYT-023" data-name="锚点导航栏" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">锚点导航栏</span></div>
