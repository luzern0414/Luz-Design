      <div class="wb-lyn-af__head"><h2>订单管理</h2><span class="wb-ly-meta">建国路店</span></div>
      <div class="wb-lyn-af__sent" aria-hidden="true"></div>
      <div class="wb-lyn-af__bar" data-stuck="false">
        <div class="seg" data-seg="wb-lyn-af" data-seg-for="#wb-lyn-af-rows" aria-label="订单状态"><button type="button" class="seg__item" data-key="all" aria-selected="true">全部</button><button type="button" class="seg__item" data-key="待发货" aria-selected="false">待发货</button><button type="button" class="seg__item" data-key="待收货" aria-selected="false">待收货</button><button type="button" class="seg__item" data-key="已完成" aria-selected="false">已完成</button></div>
        <button type="button" class="btn btn--secondary btn--sm" data-wb-toast="已开始导出">导出</button>
      </div>
      <div class="list" id="wb-lyn-af-rows"></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-LAYT-031" data-name="间距堆叠容器" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">间距堆叠容器</span></div>
  <p class="demo__note">适合：按统一间距横排或竖排一组控件</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--w" id="wb-lyn-sp"><div class="wb-lyn-sp">
    <dl class="wb-lyn-sp__ctl">
      <dt>排列</dt><dd><div class="btn-seg" role="group" aria-label="排列方向"><button type="button" aria-pressed="true" data-k="dir" data-v="row">横排</button><button type="button" aria-pressed="false" data-k="dir" data-v="column">竖排</button></div></dd>
      <dt>间距</dt><dd><div class="btn-seg" role="group" aria-label="间距大小"><button type="button" aria-pressed="false" data-k="gap" data-v="8">小</button><button type="button" aria-pressed="true" data-k="gap" data-v="12">中</button><button type="button" aria-pressed="false" data-k="gap" data-v="20">大</button></div></dd>
      <dt>对齐</dt><dd><div class="btn-seg" role="group" aria-label="交叉轴对齐"><button type="button" aria-pressed="true" data-k="al" data-v="start">起点</button><button type="button" aria-pressed="false" data-k="al" data-v="center">居中</button><button type="button" aria-pressed="false" data-k="al" data-v="end">终点</button><button type="button" aria-pressed="false" data-k="al" data-v="stretch">拉伸</button></div></dd>
      <dt>显示间距</dt><dd><button type="button" class="switch" role="switch" aria-checked="false" aria-label="显示间距" data-gapsw></button></dd>
    </dl>
    <div class="wb-lyn-sp__box" data-box data-dir="row" data-al="start" data-show="false">
      <button type="button" class="btn btn--outline" data-wb-toast="已开始导出">导出订单</button>
      <button type="button" class="btn btn--secondary btn--sm" data-wb-toast="已发送到打印机">打印面单</button>
      <button type="button" class="btn btn--primary btn--lg" data-wb-toast="已批量发货">批量发货</button>
      <span class="tag" data-tone="action">已选 3 单</span>
      <button type="button" class="btn btn--ghost btn--sm" data-wb-toast="已取消订单">取消订单</button>
      <button type="button" class="btn btn--text" data-wb-toast="已清除选择">清除选择</button>
    </div>
    <p class="wb-lyn-sp__read" data-read aria-live="polite"></p>
  </div></div></div>
</article>

