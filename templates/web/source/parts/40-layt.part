    <div class="wb-lyn-an__view" tabindex="0" role="region" aria-label="门店设置">
      <section class="wb-lyn-an__sec" id="wb-lyn-an-0"><h3>基本信息</h3><div class="card"><div class="wb-lyn-an__row"><span>门店名称</span><b>建国路店</b></div><div class="wb-lyn-an__row"><span>联系电话</span><b>021 5588 0219</b></div><div class="wb-lyn-an__row"><span>门店地址</span><b>黄浦区建国东路 18 号</b></div></div></section>
      <section class="wb-lyn-an__sec" id="wb-lyn-an-1"><h3>营业设置</h3><div class="card"><div class="wb-lyn-an__row"><span>营业时间</span><b>09:00 至 21:00</b></div><div class="wb-lyn-an__row"><span>休息日</span><b>每周一</b></div><div class="wb-lyn-an__row"><span>接单状态</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="接单状态"></button></div></div></section>
      <section class="wb-lyn-an__sec" id="wb-lyn-an-2"><h3>配送设置</h3><div class="card"><div class="wb-lyn-an__row"><span>配送范围</span><b>5 公里</b></div><div class="wb-lyn-an__row"><span>起送金额</span><span class="price"><small>¥</small>59</span></div><div class="wb-lyn-an__row"><span>配送费</span><span class="price"><small>¥</small>8</span></div></div></section>
      <section class="wb-lyn-an__sec" id="wb-lyn-an-3"><h3>会员权益</h3><div class="card"><div class="wb-lyn-an__row"><span>积分比例</span><b>1 元 = 1 分</b></div><div class="wb-lyn-an__row"><span>金卡折扣</span><b>9.5 折</b></div><div class="wb-lyn-an__row"><span>生日礼券</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="生日礼券"></button></div></div></section>
      <section class="wb-lyn-an__sec" id="wb-lyn-an-4"><h3>消息通知</h3><div class="card"><div class="wb-lyn-an__row"><span>新订单提醒</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="新订单提醒"></button></div><div class="wb-lyn-an__row"><span>库存预警</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="库存预警"></button></div><div class="wb-lyn-an__row"><span>售后提醒</span><button type="button" class="switch" role="switch" aria-checked="false" aria-label="售后提醒"></button></div></div></section>
    </div>
    <nav class="wb-lyn-an__nav" aria-label="设置分区"><button type="button" class="wb-lyn-an__lnk" data-i="0" aria-current="location">基本信息</button><button type="button" class="wb-lyn-an__lnk" data-i="1">营业设置</button><button type="button" class="wb-lyn-an__lnk" data-i="2">配送设置</button><button type="button" class="wb-lyn-an__lnk" data-i="3">会员权益</button><button type="button" class="wb-lyn-an__lnk" data-i="4">消息通知</button></nav>
  </div></div></div>
</article>

