  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--wide">
    <div class="wb-ly-sub"><button class="ibtn" data-tip="返回列表" aria-label="返回列表" data-wb-toast="已返回列表"><img src="../../kit/assets/line/back.webp" alt=""></button><h1>商品信息</h1><div class="formbar"><button class="btn btn--outline btn--sm" data-wb-toast="已取消编辑">取消</button><button class="btn btn--primary btn--sm" data-wb-toast="已保存">保存</button></div></div>
    <div class="wb-ly-formp"><div class="card form-grid">
      <label class="field"><span class="field__label">商品名称</span><input class="input" value="粉芍药花束" aria-label="商品名称"></label>
      <div class="field"><span class="field__label">分类</span><div class="drop"><button class="drop__btn" aria-label="商品分类" style="min-height: 44px; width: 100%; justify-content: space-between; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong)"><b>鲜花</b></button><div class="drop__menu" role="listbox"><button class="drop__opt" role="option" aria-selected="true">鲜花</button><button class="drop__opt" role="option" aria-selected="false">绿植</button><button class="drop__opt" role="option" aria-selected="false">礼盒</button><button class="drop__opt" role="option" aria-selected="false">花器</button></div></div></div>
      <div class="field"><span class="field__label">上架状态</span><div style="display: flex; align-items: center; min-height: 44px"><button class="switch" role="switch" aria-checked="true" aria-label="上架状态"></button></div></div>
      <div class="field"><span class="field__label">库存</span><div class="wheel" data-min="0" data-max="200" data-value="26" data-unit="件" data-label="库存" data-name="stock"></div></div>
      <div class="field"><span class="field__label">售价</span><div class="wheel" data-min="0" data-max="999" data-step="1" data-value="239" data-unit="元" data-label="售价" data-name="price"></div></div>
      <div class="field"><span class="field__label">起订量</span><div class="wheel" data-min="1" data-max="20" data-value="1" data-unit="件" data-label="起订量" data-name="minqty"></div></div>
    </div></div>
  </div></div>
</article>

<script>
(function () {
  const root = document.getElementById('cat-layt'); if (!root) return;
  const $ = (s, r = root) => r.querySelector(s), $$ = (s, r = root) => [...r.querySelectorAll(s)];
  $$('[data-wb-toast]').forEach(b => b.addEventListener('click', () => Lz.toast(b.dataset.wbToast, 'success')));
  $$('[data-wb-form]').forEach(f => f.addEventListener('submit', e => { e.preventDefault(); Lz.toast(f.dataset.wbForm, 'success'); }));

  /* 侧栏：点选当前项 */
  $$('[data-wb-rail]').forEach(r => $$('.rail__item', r).forEach(i => i.addEventListener('click', () => $$('.rail__item', r).forEach(x => { if (x === i) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current'); }))));

  /* 折叠侧栏：收起后只剩图标，补上悬浮名称 */
  const fold = $('#wb-ly-fold');
  if (fold) {
    const tog = $('[data-tog]', fold), items = $$('.rail__item', fold);
    tog.addEventListener('click', () => {
      const c = fold.dataset.c !== 'true'; fold.dataset.c = String(c); tog.setAttribute('aria-expanded', String(!c)); tog.setAttribute('aria-label', c ? '展开侧栏' : '折叠侧栏'); tog.dataset.tip = c ? '展开侧栏' : '折叠侧栏';
      items.forEach(i => { if (c) i.dataset.tip = i.getAttribute('aria-label'); else delete i.dataset.tip; });
    });
  }

  /* 多标签页：切换与关闭，至少留一个 */
  const tabs = $('#wb-ly-tabs');
  if (tabs) {
    const bar = $('.wb-ly-tabs', tabs), title = $('[data-title]', tabs);
    const select = t => { $$('.wb-ly-tab', bar).forEach(x => x.setAttribute('aria-selected', String(x === t))); title.textContent = t.dataset.p; };
    bar.addEventListener('click', e => {
      const x = e.target.closest('.x'), t = e.target.closest('.wb-ly-tab'); if (!t) return;
      if (x) { e.stopPropagation(); const all = $$('.wb-ly-tab', bar); if (all.length === 1) { Lz.toast('至少保留一个页面', 'danger'); return; } const next = t.nextElementSibling || t.previousElementSibling; const was = t.getAttribute('aria-selected') === 'true'; t.remove(); if (was) select(next); return; }
      select(t);
    });
    bar.addEventListener('keydown', e => { const x = e.target.closest('.x'); if (x && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); x.click(); } });
  }

  /* 主从分栏：点左侧对象，右侧同屏更新 */
  const ms = $('#wb-ly-ms');
  if (ms) {
    const items = $$('.wb-ly-item', ms), d = $('.wb-ly-detail', ms);
    items.forEach(i => i.addEventListener('click', () => {
      items.forEach(x => x.setAttribute('aria-selected', String(x === i)));
      $('[data-pic]', d).src = '../../kit/assets/photo/' + i.dataset.img + '.webp'; $('[data-name]', d).textContent = i.dataset.n; $('[data-cat]', d).textContent = i.dataset.c; $('[data-price]', d).innerHTML = '<small>¥</small>' + i.dataset.p; $('[data-stock]', d).textContent = i.dataset.s + ' 件';
    }));
  }

  /* 三栏工作台：左筛选只影响中列表，选中订单更新右详情 */
  const tri = $('#wb-ly-tri');
  if (tri) {
    const filters = $$('.wb-ly-filter', tri), items = $$('.wb-ly-item', tri), info = $('.wb-ly-info', tri);
    const show = i => { items.forEach(x => x.setAttribute('aria-selected', String(x === i))); $('[data-mark]', info).src = '../../kit/assets/marks/' + i.dataset.mark + '.webp'; $('[data-who]', info).textContent = i.dataset.who; $('[data-no]', info).textContent = '订单 ' + i.dataset.no; $('[data-n]', info).textContent = i.dataset.n; $('[data-price]', info).innerHTML = '<small>¥</small>' + i.dataset.p; };
    items.forEach(i => i.addEventListener('click', () => show(i)));
    filters.forEach(f => f.addEventListener('click', () => {
      filters.forEach(x => x.setAttribute('aria-current', String(x === f)));
      items.forEach(i => { i.hidden = f.dataset.f !== 'all' && i.dataset.st !== f.dataset.f; });
      const first = items.find(i => !i.hidden); if (first) show(first);
    }));
  }

  /* 页面加载：骨架与已加载叠在同一格里切换，整壳高度不跳动 */
  const load = $('#wb-ly-load');
  if (load) { const skel = $('[data-skel]', load), real = $('[data-real]', load), btns = $$('[data-m]', load); btns.forEach(b => b.addEventListener('click', () => { btns.forEach(x => x.setAttribute('aria-pressed', String(x === b))); const s = b.dataset.m === 'skel'; skel.toggleAttribute('data-off', !s); real.toggleAttribute('data-off', s); skel.inert = !s; real.inert = s; })); real.inert = true; }

  /* 页脚分页：每页条数改变页数；页多时首页末页常在，中间用省略号 */
  const pg = $('#wb-ly-pg');
  if (pg) {
    const total = 128, box = $('[data-pages]', pg); let size = 20, page = 1;
    const render = () => {
      const n = Math.ceil(total / size); page = Math.min(page, n);
      const seq = n <= 7 ? Array.from({ length: n }, (_, k) => k + 1) : page <= 4 ? [1, 2, 3, 4, 5, 0, n] : page >= n - 3 ? [1, 0, n - 4, n - 3, n - 2, n - 1, n] : [1, 0, page - 1, page, page + 1, 0, n];
      box.innerHTML = `<button class="pgb wide" data-go="${page - 1}" ${page === 1 ? 'disabled' : ''}>上一页</button>` + seq.map(k => k ? `<button class="pgb" data-go="${k}" ${k === page ? 'aria-current="page"' : ''}>${k}</button>` : '<span class="pgb-gap" aria-hidden="true">…</span>').join('') + `<button class="pgb wide" data-go="${page + 1}" ${page === n ? 'disabled' : ''}>下一页</button>`;
    };
    box.addEventListener('click', e => { const b = e.target.closest('[data-go]'); if (!b || b.disabled) return; page = +b.dataset.go; render(); });
    pg.addEventListener('lz:drop', e => { size = +e.detail.value; page = 1; render(); });
    render();
  }
})();
</script>

<style>
  /* 新增布局组件：前缀 wb-lyn-。沿用 wb-ly-f 版式壳；窄组件放进 496 像素舞台，多栏版式整行宽 */

  /* 流程步骤条：圆点在上名称在下，连线跟着已完成步变色 */
  .wb-lyn-steps { display: flex; padding: var(--s-5) var(--s-4) var(--s-4); }
  .wb-lyn-step { position: relative; flex: 1 1 0; min-width: 0; display: grid; }
  .wb-lyn-step + .wb-lyn-step::before { content: ""; position: absolute; top: 14px; left: calc(-50% + 22px); right: calc(50% + 22px); height: 2px; border-radius: 1px; background: var(--line-strong); transition: background var(--dur-base) var(--ease-out); }
  .wb-lyn-step:is([data-state="done"], [data-state="current"], [data-state="error"])::before { background: var(--action); }
  .wb-lyn-step__btn { display: grid; justify-items: center; align-content: start; gap: 2px; width: 100%; padding: 0 var(--s-1) var(--s-1); border-radius: var(--r-md); text-align: center; }
  .wb-lyn-step__btn:disabled { cursor: default; }
  .wb-lyn-step__dot { position: relative; display: grid; place-items: center; width: 28px; height: 28px; margin-bottom: var(--s-1); border: 1.5px solid var(--line-strong); border-radius: 50%; background: var(--surface); color: var(--ink-3); font-size: var(--fs-sm); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .wb-lyn-step__dot img { position: absolute; width: 14px; height: 14px; filter: invert(1); opacity: 0; transform: scale(.5); transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
  .wb-lyn-step[data-state="done"] .wb-lyn-step__dot { border-color: var(--action); background: var(--action); color: transparent; }
  .wb-lyn-step[data-state="done"] .wb-lyn-step__dot img { opacity: 1; transform: none; }
  .wb-lyn-step[data-state="current"] .wb-lyn-step__dot { border-color: var(--action); color: var(--action-press); box-shadow: 0 0 0 4px var(--action-soft); }
  .wb-lyn-step[data-state="error"] .wb-lyn-step__dot { border-color: var(--danger); background: var(--danger-tint); color: var(--danger); }
  .wb-lyn-step__name { font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); color: var(--ink-3); white-space: nowrap; transition: color var(--dur-quick) var(--ease-out); }
  .wb-lyn-step__hint { font-size: var(--fs-xs); line-height: var(--lh-tight); color: var(--ink-3); white-space: nowrap; }
  .wb-lyn-step:is([data-state="done"], [data-state="current"]) .wb-lyn-step__name { color: var(--ink); }
  .wb-lyn-step[data-state="current"] .wb-lyn-step__hint { color: var(--action-press); }
  .wb-lyn-step[data-state="error"] :is(.wb-lyn-step__name, .wb-lyn-step__hint) { color: var(--danger); }
  @media (hover: hover) { .wb-lyn-step__btn:not(:disabled):hover .wb-lyn-step__name { color: var(--action-press); } }
  .wb-lyn-stp__body { padding: 0 var(--s-4) var(--s-3); }
  .wb-lyn-panes { display: grid; }
  .wb-lyn-panes > * { grid-area: 1 / 1; min-width: 0; }
  .wb-lyn-panes > [data-off] { visibility: hidden; }
  .wb-lyn-pane { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-4); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg); }
  .wb-lyn-pane h3 { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-lyn-kv { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--s-2) var(--s-4); align-items: center; font-size: var(--fs-sm); }
  .wb-lyn-kv dt { color: var(--ink-3); }
  .wb-lyn-kv dd { display: flex; align-items: center; gap: var(--s-2); min-height: 28px; min-width: 0; }
  .wb-lyn-kv .field__err { grid-column: 2; margin-top: -4px; }
  .wb-lyn-stp__foot { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); padding: 0 var(--s-4) var(--s-4); }

  /* 选项卡面板：下划线滑动，选中色跟随主色，停用项灰显 */
  .wb-lyn-tl { position: relative; display: flex; gap: var(--s-1); padding: 0 var(--s-4); box-shadow: inset 0 -1px 0 var(--line); overflow-x: auto; scrollbar-width: none; }
  .wb-lyn-tl::-webkit-scrollbar { display: none; }
  .wb-lyn-tt { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 48px; padding: 0 var(--s-3); font-size: var(--fs-md); color: var(--ink-2); white-space: nowrap; transition: color var(--dur-quick) var(--ease-out); }
  .wb-lyn-tt small { display: inline-block; min-width: 22px; height: 18px; padding: 0 6px; border-radius: var(--r-full); background: var(--zone); color: var(--ink-3); font-size: var(--fs-xs); line-height: 18px; text-align: center; font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-lyn-tt[aria-selected="true"] { color: var(--action-press); font-weight: 600; }
  .wb-lyn-tt[aria-selected="true"] small { background: var(--action-soft); color: var(--action-press); }
  .wb-lyn-tt:disabled { color: var(--ink-3); opacity: .5; cursor: not-allowed; }
  @media (hover: hover) { .wb-lyn-tt:not(:disabled):not([aria-selected="true"]):hover { color: var(--ink); } }
  .wb-lyn-ink { position: absolute; left: 0; bottom: 0; width: var(--w, 0px); height: 3px; border-radius: 3px 3px 0 0; background: var(--action); transform: translateX(var(--x, 0px)); transition: transform var(--dur-base) var(--ease-out), width var(--dur-base) var(--ease-out); pointer-events: none; }
  .wb-lyn-tp { display: grid; align-content: center; min-height: 176px; padding: var(--s-5); }
  .wb-lyn-tprod { display: grid; grid-template-columns: 104px minmax(0, 1fr) auto; gap: var(--s-4) var(--s-5); align-items: center; }
  .wb-lyn-tstat { display: grid; gap: var(--s-3); padding-left: var(--s-5); border-left: 1px solid var(--line); }
  .wb-lyn-tstat div { display: grid; gap: 2px; }
  .wb-lyn-tstat dt { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-lyn-tstat dd { font-size: var(--fs-md); font-weight: 600; font-variant-numeric: tabular-nums; }
  .wb-lyn-tprod img { width: 104px; height: 104px; border-radius: var(--r-md); object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-lyn-tprod > div { display: grid; gap: var(--s-2); justify-items: start; min-width: 0; }
  .wb-lyn-tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .wb-lyn-spec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-5); }
  .wb-lyn-spec dt { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-lyn-spec dd { margin-top: 2px; font-size: var(--fs-sm); font-weight: 600; }
  .wb-lyn-rv { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 56px; }
  .wb-lyn-rv + .wb-lyn-rv { border-top: 1px solid var(--line); }
  .wb-lyn-rv .avatar { width: 36px; height: 36px; }
  .wb-lyn-rv p { font-size: var(--fs-sm); }
  .wb-lyn-rv b { font-weight: 600; }

  /* 分割线样式组 */
  .wb-lyn-dvg { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: var(--s-4); align-items: center; padding: var(--s-5); font-size: var(--fs-sm); }
  .wb-lyn-dvg > dt { color: var(--ink-3); }
  .wb-lyn-dvg > dd { min-width: 0; }
  .wb-lyn-dvg p { line-height: var(--lh-tight); }
  .wb-lyn-hr { height: 0; margin: var(--s-3) 0; border: 0; border-top: 1px solid var(--line-strong); }
  .wb-lyn-hr--dash { border-top-style: dashed; }
  .wb-lyn-hl { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 36px; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .wb-lyn-ln { flex: 1; height: 0; border-top: 1px solid var(--line-strong); }
  .wb-lyn-hl small { font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wb-lyn-hl .chev { margin-left: calc(var(--s-1) * -1); }
  @media (hover: hover) { button.wb-lyn-hl:hover { color: var(--action-press); } }
  .wb-lyn-items { display: grid; gap: var(--s-2); padding: var(--s-1) 0 var(--s-2); }
  .wb-lyn-items li { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .wb-lyn-vrow { display: flex; align-items: center; gap: var(--s-3); white-space: nowrap; }
  .wb-lyn-vr { flex: none; width: 1px; height: 14px; background: var(--line-strong); }
  .wb-lyn-act { min-height: 32px; padding: 0 var(--s-1); border-radius: var(--r-sm); color: var(--action-press); font-size: var(--fs-sm); font-weight: 500; transition: background var(--dur-quick) var(--ease-out); }
  .wb-lyn-act--danger { color: var(--danger); }
  @media (hover: hover) { .wb-lyn-act:hover { background: var(--zone); } }
  .wb-lyn-vrow--act { gap: var(--s-2); }
  .wb-lyn-band { height: 8px; border-radius: var(--r-full); background: var(--zone); }

  /* 固钉吸附容器 */
  .wb-lyn-af { position: relative; height: 312px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-lyn-af__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-5) var(--s-5) var(--s-3); }
  .wb-lyn-af__head h2 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-lyn-af__bar { position: sticky; top: 0; z-index: 3; display: flex; align-items: center; gap: var(--s-3); padding: var(--s-2) var(--s-4); background: var(--surface); border-bottom: 1px solid transparent; transition: box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
  .wb-lyn-af__bar[data-stuck="true"] { border-bottom-color: var(--line); box-shadow: var(--elev-2); }
  .wb-lyn-af__bar .seg { flex: 1; min-width: 0; }
  .wb-lyn-af__sent { height: 1px; margin-bottom: -1px; }
  .wb-lyn-af .row { min-height: 60px; }
  .wb-lyn-af .row__lead { width: 40px; height: 40px; }

  /* 无限滚动加载 */
  .wb-lyn-inf__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--line); }
  .wb-lyn-inf__head b { font-size: var(--fs-md); font-weight: 600; }
  .wb-lyn-inf__head span { font-variant-numeric: tabular-nums; }
  .wb-lyn-inf__scroll { height: 312px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-lyn-lg { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 52px; padding: var(--s-2) var(--s-5); font-size: var(--fs-sm); }
  .wb-lyn-lg + .wb-lyn-lg { border-top: 1px solid var(--line); }
  .wb-lyn-lg .avatar { width: 36px; height: 36px; }
  .wb-lyn-lg b { font-weight: 600; }
  .wb-lyn-lg time { color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wb-lyn-lg[data-new] { animation: lz-rise var(--dur-slow) var(--ease-out) both; }
  .wb-lyn-tail { display: flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 56px; padding: var(--s-2) var(--s-5); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-spin { flex: none; width: 18px; height: 18px; border: 2px solid var(--action); border-color: var(--action) transparent var(--action) transparent; border-radius: 50%; animation: lz-spin .8s linear infinite; }
  .wb-lyn-tail .btn--text { min-height: 32px; }
  .wb-lyn-tail[data-s="error"] > span { color: var(--danger); }

  /* 瀑布流布局 */
  .wb-lyn-ms__bar { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-ms__bar .seg { flex: 1; min-width: 0; }
  .wb-lyn-ms__bar b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .wb-lyn-ms__bar .btn--text { min-height: 32px; }
  .wb-lyn-ms__grid { column-width: 132px; column-gap: var(--s-3); padding: var(--s-4); }
  .wb-lyn-mc { position: relative; display: block; width: 100%; margin: 0 0 var(--s-3); break-inside: avoid; border-radius: var(--r-md); background: var(--surface); box-shadow: 0 0 0 1px var(--line), var(--elev-1); overflow: hidden; text-align: left; transition: box-shadow var(--dur-quick) var(--ease-out); }
  .wb-lyn-mc img { width: 100%; aspect-ratio: var(--ar, 1); object-fit: cover; background: var(--zone); }
  .wb-lyn-mc__cap { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding: var(--s-2) var(--s-3); font-size: var(--fs-sm); font-weight: 600; line-height: var(--lh-tight); }
  .wb-lyn-mc__cap small { font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); white-space: nowrap; }
  .wb-lyn-mc__chk { position: absolute; top: var(--s-2); right: var(--s-2); display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: inset 0 0 0 1.5px var(--line-strong); transition: background var(--dur-quick) var(--ease-out); }
  .wb-lyn-mc__chk img { width: 14px; height: 14px; aspect-ratio: auto; background: none; filter: invert(1); opacity: 0; transform: scale(.5); transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
  .wb-lyn-mc[aria-pressed="true"] { outline: 2px solid var(--action); outline-offset: 0; }
  .wb-lyn-mc[aria-pressed="true"] .wb-lyn-mc__chk { background: var(--action); box-shadow: none; }
  .wb-lyn-mc[aria-pressed="true"] .wb-lyn-mc__chk img { opacity: 1; transform: none; }
  @media (hover: hover) { .wb-lyn-mc:hover { box-shadow: 0 0 0 1px var(--line-strong), var(--elev-2); } }

  /* 自定义滚动区：原生滚动加自绘滚动条，滑块可拖、轨道可点 */
  .wb-lyn-scs { display: grid; gap: var(--s-4); padding: var(--s-4); }
  .wb-lyn-sc { position: relative; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); overflow: hidden; }
  .wb-lyn-sc__view { overflow: auto; scrollbar-width: none; overscroll-behavior: contain; }
  .wb-lyn-sc__view::-webkit-scrollbar { display: none; }
  .wb-lyn-sc[data-axis="y"] .wb-lyn-sc__view { height: 224px; }
  .wb-lyn-sc__view:focus-visible { outline-offset: -2px; }
  .wb-lyn-sc__bar { position: absolute; border-radius: var(--r-full); opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .wb-lyn-sc[data-axis="y"] .wb-lyn-sc__bar { top: 4px; bottom: 4px; right: 3px; width: 8px; }
  .wb-lyn-sc[data-axis="x"] .wb-lyn-sc__bar { left: 4px; right: 4px; bottom: 3px; height: 8px; }
  .wb-lyn-sc[data-need="true"] .wb-lyn-sc__bar { opacity: .6; }
  .wb-lyn-sc[data-need="true"]:is(:hover, :focus-within, [data-on="true"], [data-drag="true"]) .wb-lyn-sc__bar { opacity: 1; }
  .wb-lyn-sc__thumb { position: absolute; top: 0; left: 0; border-radius: var(--r-full); background: color-mix(in srgb, var(--ink) 26%, transparent); cursor: grab; transition: background var(--dur-quick) var(--ease-out); }
  .wb-lyn-sc[data-axis="y"] .wb-lyn-sc__thumb { width: 100%; }
  .wb-lyn-sc[data-axis="x"] .wb-lyn-sc__thumb { height: 100%; }
  @media (hover: hover) { .wb-lyn-sc__thumb:hover { background: color-mix(in srgb, var(--ink) 42%, transparent); } }
  .wb-lyn-sc[data-drag="true"] .wb-lyn-sc__thumb { background: var(--action); cursor: grabbing; }
  .wb-lyn-sc .row { min-height: 52px; padding-right: var(--s-5); }
  .wb-lyn-sc .row__lead { width: 36px; height: 36px; }
  .wb-lyn-sc .row[aria-selected="true"] { background: var(--action-tint); }
  .wb-lyn-sc__strip { display: flex; gap: var(--s-3); width: max-content; padding: var(--s-3) var(--s-3) var(--s-4); }
  .wb-lyn-sc__cell { display: grid; gap: var(--s-2); justify-items: center; width: 92px; font-size: var(--fs-sm); text-align: center; }
  .wb-lyn-sc__cell img { width: 92px; height: 92px; border-radius: var(--r-md); object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-lyn-sc__cap { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-3); }

  /* 虚拟滚动列表 */
  .wb-lyn-vl__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
  .wb-lyn-vl__head b { font-size: var(--fs-md); font-weight: 600; }
  .wb-lyn-vl__head .btn--sm { min-height: 32px; }
  .wb-lyn-vl__view { position: relative; height: 288px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-lyn-vl__space { position: relative; }
  .wb-lyn-vl__win { position: absolute; left: 0; right: 0; top: 0; }
  .wb-lyn-vl__row { display: grid; grid-template-columns: 64px 56px minmax(0, 1fr) 76px 68px; align-items: center; gap: var(--s-3); height: 48px; padding: 0 var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); }
  .wb-lyn-vl__row > span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wb-lyn-vl__row .n { font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .wb-lyn-vl__row .r { text-align: right; font-variant-numeric: tabular-nums; }
  .wb-lyn-vl__row .c { text-align: center; overflow: visible; }
  .wb-lyn-vl__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 48px; padding: var(--s-2) var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-vl__foot b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* 间距堆叠容器 */
  .wb-lyn-sp { display: grid; gap: var(--s-4); padding: var(--s-5); }
  .wb-lyn-sp__ctl { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: var(--s-3) var(--s-4); align-items: center; font-size: var(--fs-sm); }
  .wb-lyn-sp__ctl dt { color: var(--ink-3); }
  .wb-lyn-sp__ctl dd { display: flex; align-items: center; min-width: 0; min-height: 40px; }
  .wb-lyn-sp__ctl .btn-seg button { min-height: 32px; padding: 0 var(--s-3); }
  .wb-lyn-sp__box { --gap: var(--s-3); display: flex; flex-flow: row wrap; align-items: flex-start; gap: var(--gap); padding: var(--s-4); border: 1px dashed var(--line-strong); border-radius: var(--r-md); transition: gap var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .wb-lyn-sp__box[data-dir="column"] { flex-direction: column; flex-wrap: nowrap; }
  .wb-lyn-sp__box[data-al="center"] { align-items: center; }
  .wb-lyn-sp__box[data-al="end"] { align-items: flex-end; }
  .wb-lyn-sp__box[data-al="stretch"] { align-items: stretch; }
  .wb-lyn-sp__box[data-show="true"] { background: var(--action-soft); border-color: var(--action-edge); }
  .wb-lyn-sp__box > .btn, .wb-lyn-sp__box > .tag { flex: none; }
  .wb-lyn-sp__box > .btn--text { background: var(--surface); }
  .wb-lyn-sp__box > .tag { height: 28px; padding: 0 var(--s-3); }
  .wb-lyn-sp__box[data-dir="column"] > .btn, .wb-lyn-sp__box[data-dir="column"] > .tag { justify-content: center; }
  .wb-lyn-sp__box[data-dir="column"][data-al="stretch"] > .tag { justify-content: center; }
  .wb-lyn-sp__read { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* 可拖拽分栏：分隔条可拖、可用方向键，双击或回车恢复 */
  .wb-lyn-spl { padding: var(--s-4); }
  .wb-lyn-spl__host { --l: 36%; display: grid; grid-template-columns: var(--l) 12px minmax(0, 1fr); height: 396px; }
  .wb-lyn-spl__host.is-drag { cursor: col-resize; user-select: none; }
  .wb-lyn-spl__host.is-drag-y { cursor: row-resize; user-select: none; }
  .wb-lyn-spl__host.is-drag *, .wb-lyn-spl__host.is-drag-y * { pointer-events: none; }
  .wb-lyn-spl__host.is-drag .wb-lyn-sep, .wb-lyn-spl__host.is-drag-y .wb-lyn-sep { pointer-events: auto; }
  .wb-lyn-col { display: grid; grid-template-rows: auto minmax(0, 1fr); min-width: 0; min-height: 0; container-type: inline-size; }
  .wb-lyn-col > .section__head { padding-left: var(--s-1); }
  .wb-lyn-col > .card { min-height: 0; overflow: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-lyn-col__r { --t: 50%; display: grid; grid-template-rows: var(--t) 12px minmax(0, 1fr); min-width: 0; min-height: 0; }
  .wb-lyn-sep { position: relative; display: grid; place-items: center; touch-action: none; cursor: col-resize; border-radius: var(--r-sm); }
  .wb-lyn-sep--y { cursor: row-resize; }
  .wb-lyn-sep::before { content: ""; position: absolute; inset: 0; margin: auto; width: 2px; height: 100%; border-radius: 1px; background: var(--action-edge); opacity: 0; transition: opacity var(--dur-quick) var(--ease-out); }
  .wb-lyn-sep--y::before { width: 100%; height: 2px; }
  .wb-lyn-sep i { position: relative; width: 4px; height: 36px; border-radius: 2px; background: var(--line-strong); transition: background var(--dur-quick) var(--ease-out), height var(--dur-base) var(--ease-out); }
  .wb-lyn-sep--y i { width: 36px; height: 4px; }
  .wb-lyn-sep::after { content: attr(data-v); position: absolute; top: 50%; left: 50%; z-index: 2; transform: translate(-50%, -150%); padding: 2px var(--s-2); border-radius: var(--r-sm); background: var(--ink); color: var(--surface); font-size: var(--fs-xs); font-variant-numeric: tabular-nums; line-height: 1.5; opacity: 0; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .wb-lyn-sep:hover::before { opacity: 1; } .wb-lyn-sep:hover i { background: var(--action); } }
  .wb-lyn-sep:is(:focus-visible, [data-on="true"])::before { opacity: 1; }
  .wb-lyn-sep:is(:focus-visible, [data-on="true"]) i { background: var(--action); height: 44px; }
  .wb-lyn-sep--y:is(:focus-visible, [data-on="true"]) i { width: 44px; height: 4px; }
  .wb-lyn-sep:is(:focus-visible, [data-on="true"])::after { opacity: 1; }
  .wb-lyn-sep:focus-visible { outline: none; }
  .wb-lyn-pr { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 56px; }
  .wb-lyn-pr img { width: 40px; height: 40px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-lyn-pr[aria-selected="true"] { background: var(--action-tint); }
  .wb-lyn-pr[aria-selected="true"]::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: var(--action); border: 0; }
  @container (max-width: 240px) { .wb-lyn-pr { grid-template-columns: 40px minmax(0, 1fr); } .wb-lyn-pr .price { display: none; } }
  .wb-lyn-dt { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: var(--s-4); align-items: center; padding: var(--s-3) var(--s-4); }
  .wb-lyn-dt img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-lyn-dt > div { display: grid; gap: var(--s-1); justify-items: start; min-width: 0; }
  .wb-lyn-dt .wb-ly-row { flex-wrap: nowrap; gap: var(--s-2); }
  .wb-lyn-sl { display: grid; grid-template-columns: 64px 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 44px; padding: 0 var(--s-4); font-size: var(--fs-sm); }
  .wb-lyn-sl + .wb-lyn-sl { border-top: 1px solid var(--line); }
  .wb-lyn-sl .n { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wb-lyn-sl .q { color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* 栅格布局：二十四栏，列数随预览容器宽度换档 */
  .wb-lyn-gr__bar { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-gr__bar .sp { flex: 1; }
  .wb-lyn-gr__bar .btn-seg button { min-height: 32px; }
  .wb-lyn-gr__sw { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--ink-2); }
  .wb-lyn-gr__rd { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wb-lyn-gr__dock { display: grid; justify-items: center; padding: var(--s-4) var(--s-5) var(--s-5); background: var(--bg); }
  .wb-lyn-gr__vp { position: relative; container-type: inline-size; width: min(var(--vw, 100%), 100%); transition: width var(--dur-slow) var(--ease-out); }
  .wb-lyn-gr__grid { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: var(--s-3); }
  .wb-lyn-gr__guides { position: absolute; inset: 0; z-index: 3; display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: var(--s-3); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
  .wb-lyn-gr__guides i { background: color-mix(in srgb, var(--action) 7%, transparent); }
  .wb-lyn-gr__vp[data-guide="true"] .wb-lyn-gr__guides { opacity: 1; }
  .wb-lyn-gb { position: relative; grid-column: span var(--s, 24); min-width: 0; display: grid; align-content: start; gap: var(--s-2); padding: var(--s-4); }
  .wb-lyn-gb__n { position: absolute; top: var(--s-3); right: var(--s-3); height: 22px; padding: 0 var(--s-2); border-radius: 7px; background: var(--zone); color: var(--ink-3); font-size: var(--fs-xs); font-weight: 600; line-height: 22px; font-variant-numeric: tabular-nums; }
  .wb-lyn-gb .stat__label { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-gb h3 { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); padding-right: 64px; }
  .wb-lyn-gb .wb-ly-row { flex-wrap: nowrap; }
  .wb-lyn-gb .bars { height: 120px; }
  .wb-lyn-gb .row { min-height: 56px; padding-left: 0; padding-right: 0; }
  .wb-lyn-gb .row + .row::before { left: 0; }
  .wb-lyn-gb .row__lead { width: 32px; height: 32px; }
  .wb-lyn-gb--c { align-content: center; justify-items: center; }
  @container (min-width: 600px) { .wb-lyn-gb { grid-column: span var(--m, 24); } }
  @container (min-width: 960px) { .wb-lyn-gb { grid-column: span var(--c, 24); } }

  /* 锚点导航栏 */
  .wb-lyn-an { display: grid; grid-template-columns: minmax(0, 760px) 168px; justify-content: center; gap: var(--s-6); padding: var(--s-5); }
  .wb-lyn-an__view { height: 380px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; scroll-behavior: smooth; padding-right: var(--s-2); }
  .wb-lyn-an__sec { display: grid; gap: var(--s-2); padding-bottom: var(--s-5); }
  .wb-lyn-an__sec:last-child { min-height: 340px; align-content: start; }
  .wb-lyn-an__sec h3 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .wb-lyn-an__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 52px; padding: var(--s-2) var(--s-5); font-size: var(--fs-sm); }
  .wb-lyn-an__row + .wb-lyn-an__row { border-top: 1px solid var(--line); }
  .wb-lyn-an__row span { color: var(--ink-2); }
  .wb-lyn-an__row b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .wb-lyn-an__nav { align-self: start; display: grid; position: relative; padding-left: var(--s-1); }
  .wb-lyn-an__nav::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; border-radius: 1px; background: var(--line); }
  .wb-lyn-an__lnk { position: relative; display: block; width: 100%; min-height: 40px; padding: 0 var(--s-3) 0 var(--s-4); text-align: left; font-size: var(--fs-sm); color: var(--ink-2); transition: color var(--dur-quick) var(--ease-out); }
  .wb-lyn-an__lnk::before { content: ""; position: absolute; left: calc(var(--s-1) * -1); top: 8px; bottom: 8px; width: 2px; border-radius: 1px; background: transparent; transition: background var(--dur-quick) var(--ease-out); }
  .wb-lyn-an__lnk[aria-current="location"] { color: var(--action-press); font-weight: 600; }
  .wb-lyn-an__lnk[aria-current="location"]::before { background: var(--action); }
  @media (hover: hover) { .wb-lyn-an__lnk:hover { color: var(--ink); } }

  /* 大型下拉导航 */
  .wb-lyn-mm { position: relative; }
  .wb-lyn-mm__nav { position: relative; z-index: 6; display: flex; align-items: center; gap: var(--s-4); min-height: 64px; padding: 0 var(--s-6); background: var(--surface); border-bottom: 1px solid var(--line); }
  .wb-lyn-mm__logo { display: grid; place-items: center; width: 40px; height: 40px; }
  .wb-lyn-mm__logo img { width: 36px; height: 36px; object-fit: contain; }
  .wb-lyn-mm__links { display: flex; align-items: center; gap: var(--s-1); }
  .wb-lyn-mm__lk { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 40px; padding: 0 var(--s-4); border-radius: var(--r-md); font-size: var(--fs-md); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-lyn-mm__lk .chev::after { margin-left: 2px; transition: transform var(--dur-base) var(--ease-out); }
  .wb-lyn-mm__lk[aria-current="page"] { color: var(--ink); font-weight: 600; }
  .wb-lyn-mm__lk[aria-expanded="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
  @media (hover: hover) { .wb-lyn-mm__lk:hover { background: var(--zone); color: var(--ink); } .wb-lyn-mm__lk[aria-expanded="true"]:hover { background: var(--action-tint); color: var(--action-press); } }
  .wb-lyn-mm__nav .sp { flex: 1; }
  .wb-lyn-mm__stage { position: relative; min-height: 420px; background: url(../../kit/assets/photo/scene-hero-pink.webp) right center / cover; }
  .wb-lyn-mm__stage::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--surface) 94%, transparent) 0%, color-mix(in srgb, var(--surface) 70%, transparent) 46%, transparent 78%); }
  .wb-lyn-mm__hero { position: relative; display: grid; align-content: center; justify-items: start; gap: var(--s-3); min-height: 420px; padding: var(--s-6); }
  .wb-lyn-mm__hero h2 { font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-lyn-mm__panel { position: absolute; z-index: 5; left: 0; right: 0; top: 64px; padding: var(--s-5) var(--s-6) var(--s-6); background: var(--surface); border-bottom: 1px solid var(--line); box-shadow: var(--elev-3); opacity: 0; transform: translateY(-6px); visibility: hidden; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
  .wb-lyn-mm__panel[data-open="true"] { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }
  .wb-lyn-mm__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.25fr); gap: var(--s-6); }
  .wb-lyn-mm__col { display: grid; align-content: start; gap: var(--s-1); }
  .wb-lyn-mm__col h3 { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-bottom: var(--s-2); padding-bottom: var(--s-2); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-3); }
  .wb-lyn-mm__lnk { display: grid; gap: 2px; padding: var(--s-2) var(--s-3); margin: 0 calc(var(--s-3) * -1); border-radius: var(--r-md); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  .wb-lyn-mm__lnk b { font-size: var(--fs-sm); font-weight: 600; }
  .wb-lyn-mm__lnk small { font-size: var(--fs-xs); color: var(--ink-3); }
  @media (hover: hover) { .wb-lyn-mm__lnk:hover { background: var(--zone); } }
  .wb-lyn-mm__feat { display: grid; grid-template-rows: auto auto; align-content: start; gap: var(--s-3); align-self: start; padding: var(--s-3); border-radius: var(--r-lg); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); text-align: left; transition: box-shadow var(--dur-quick) var(--ease-out); }
  .wb-lyn-mm__feat img { width: 100%; height: 188px; border-radius: var(--r-md); object-fit: cover; }
  .wb-lyn-mm__feat div { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-width: 0; padding: 0 var(--s-1); }
  .wb-lyn-mm__feat b { font-size: var(--fs-md); font-weight: 600; }
  @media (hover: hover) { .wb-lyn-mm__feat:hover { box-shadow: inset 0 0 0 1px var(--action); } }
  .wb-lyn-mm__store { display: grid; gap: var(--s-2); align-content: start; align-self: start; padding: var(--s-3) var(--s-4); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); text-align: left; transition: border-color var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  .wb-lyn-mm__store b { font-size: var(--fs-md); font-weight: 600; }
  .wb-lyn-mm__store span { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-mm__store .tag { justify-self: start; }
  @media (hover: hover) { .wb-lyn-mm__store:hover { border-color: var(--action-edge); box-shadow: var(--elev-1); } }

  /* 大图头图区 */
  .wb-lyn-hero { position: relative; isolation: isolate; display: grid; align-content: center; min-height: 380px; padding: var(--s-8) var(--s-12); background: url(../../kit/assets/photo/scene-hero-pink.webp) 80% center / cover; }
  .wb-lyn-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--surface) 96%, transparent) 0%, color-mix(in srgb, var(--surface) 78%, transparent) 40%, transparent 72%); transition: background var(--dur-slow) var(--ease-out); }
  .wb-lyn-hero__in { display: grid; justify-items: start; gap: var(--s-4); max-width: 520px; }
  .wb-lyn-hero h2 { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-lyn-hero__sub { font-size: var(--fs-lg); color: var(--ink-2); }
  .wb-lyn-hero__acts { display: flex; align-items: center; gap: var(--s-3); }
  .wb-lyn-hero__facts { display: flex; align-items: center; gap: var(--s-6); margin-top: var(--s-2); }
  .wb-lyn-hero__facts div { display: grid; gap: 2px; }
  .wb-lyn-hero__facts b { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .wb-lyn-hero__facts small { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-lyn-hero[data-v="c"] { justify-items: center; background: url(../../kit/assets/photo/bg-floral.webp) center / cover; }
  .wb-lyn-hero[data-v="c"]::before { background: color-mix(in srgb, var(--surface) 80%, transparent); }
  .wb-lyn-hero[data-v="c"] .wb-lyn-hero__in { justify-items: center; text-align: center; max-width: 620px; }
  .wb-lyn-hero[data-v="c"] .wb-lyn-hero__facts { justify-content: center; }
  .wb-lyn-hero__sw { position: absolute; top: var(--s-4); right: var(--s-4); }
  .wb-lyn-hero__sw .btn-seg { background: color-mix(in srgb, var(--surface) 88%, transparent); }
</style>

<article class="demo" data-cid="WB-LAYT-021" data-name="流程步骤条" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">流程步骤条</span></div>
  <p class="demo__note">适合：开通与发布等多步任务，标出当前步与已完成步</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--w" id="wb-lyn-stp">
    <ol class="wb-lyn-steps" aria-label="门店开通步骤">
      <li class="wb-lyn-step"><button type="button" class="wb-lyn-step__btn"><span class="wb-lyn-step__dot"><img src="../../kit/assets/line/check.webp" alt="">1</span><span class="wb-lyn-step__name">门店信息</span><span class="wb-lyn-step__hint">已完成</span></button></li>
      <li class="wb-lyn-step"><button type="button" class="wb-lyn-step__btn"><span class="wb-lyn-step__dot"><img src="../../kit/assets/line/check.webp" alt="">2</span><span class="wb-lyn-step__name">上传资质</span><span class="wb-lyn-step__hint">进行中</span></button></li>
      <li class="wb-lyn-step"><button type="button" class="wb-lyn-step__btn"><span class="wb-lyn-step__dot"><img src="../../kit/assets/line/check.webp" alt="">3</span><span class="wb-lyn-step__name">平台审核</span><span class="wb-lyn-step__hint">未开始</span></button></li>
      <li class="wb-lyn-step"><button type="button" class="wb-lyn-step__btn"><span class="wb-lyn-step__dot"><img src="../../kit/assets/line/check.webp" alt="">4</span><span class="wb-lyn-step__name">开通营业</span><span class="wb-lyn-step__hint">未开始</span></button></li>
    </ol>
    <div class="wb-lyn-stp__body wb-lyn-panes">
      <div class="wb-lyn-pane"><h3>门店信息</h3><dl class="wb-lyn-kv"><dt>门店名称</dt><dd>建国路店</dd><dt>联系电话</dt><dd>021 5588 0219</dd><dt>营业时间</dt><dd>09:00 至 21:00</dd></dl></div>
      <div class="wb-lyn-pane"><h3>上传资质</h3><dl class="wb-lyn-kv"><dt>营业执照</dt><dd><button type="button" class="switch" role="switch" aria-checked="false" aria-label="营业执照已上传" data-lic></button><span data-lic-t>未上传</span></dd><dt>食品许可</dt><dd><span class="tag" data-tone="success">已上传</span></dd><dt>法人证件</dt><dd><span class="tag" data-tone="success">已上传</span></dd></dl></div>
      <div class="wb-lyn-pane"><h3>平台审核</h3><dl class="wb-lyn-kv"><dt>审核状态</dt><dd><span class="tag" data-tone="warning">审核中</span></dd><dt>提交材料</dt><dd>3 项</dd><dt>预计时长</dt><dd>1 个工作日</dd></dl></div>
      <div class="wb-lyn-pane"><h3>开通营业</h3><dl class="wb-lyn-kv"><dt>门店</dt><dd>建国路店</dd><dt>营业状态</dt><dd><span class="tag" data-tone="action" data-open-tag>待开通</span></dd><dt>配送范围</dt><dd>5 公里</dd></dl></div>
    </div>
    <div class="wb-lyn-stp__foot"><button type="button" class="btn btn--ghost btn--sm" data-prev>上一步</button><button type="button" class="btn btn--primary btn--sm" data-next>下一步</button></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-LAYT-022" data-name="选项卡面板" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">选项卡面板</span></div>
  <p class="demo__note">适合：同一页内按并列类别切换内容，不跳转页面</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--w" id="wb-lyn-tabs">
    <div class="wb-lyn-tl" role="tablist" aria-label="商品信息">
      <button type="button" class="wb-lyn-tt" role="tab" id="wb-lyn-tab0" aria-controls="wb-lyn-tp0" aria-selected="true">商品详情</button>
      <button type="button" class="wb-lyn-tt" role="tab" id="wb-lyn-tab1" aria-controls="wb-lyn-tp1" aria-selected="false" tabindex="-1">规格参数</button>
      <button type="button" class="wb-lyn-tt" role="tab" id="wb-lyn-tab2" aria-controls="wb-lyn-tp2" aria-selected="false" tabindex="-1">用户评价<small>128</small></button>
      <button type="button" class="wb-lyn-tt" role="tab" aria-selected="false" disabled>配送说明</button>
      <i class="wb-lyn-ink" aria-hidden="true"></i>
    </div>
    <div class="wb-lyn-panes">
      <div class="wb-lyn-tp" role="tabpanel" id="wb-lyn-tp0" aria-labelledby="wb-lyn-tab0">
        <div class="wb-lyn-tprod"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><div><p class="wb-ly-name wb-ly-name--xl">红玫瑰花束</p><span class="price" style="font-size: var(--fs-xl)"><small>¥</small>199</span><div class="wb-lyn-tags"><span class="tag" data-tone="success">在售</span><span class="tag">鲜花</span><span class="tag" data-tone="action">极速配送</span></div></div><dl class="wb-lyn-tstat"><div><dt>库存</dt><dd>42 件</dd></div><div><dt>月销量</dt><dd>1,240 件</dd></div></dl></div>
      </div>
      <div class="wb-lyn-tp" role="tabpanel" id="wb-lyn-tp1" aria-labelledby="wb-lyn-tab1" data-off>
        <dl class="wb-lyn-spec"><div><dt>花材</dt><dd>红玫瑰 11 枝</dd></div><div><dt>配材</dt><dd>尤加利叶</dd></div><div><dt>包装</dt><dd>牛皮纸</dd></div><div><dt>花高</dt><dd>约 45 厘米</dd></div><div><dt>保鲜期</dt><dd>7 天</dd></div><div><dt>产地</dt><dd>云南</dd></div></dl>
      </div>
      <div class="wb-lyn-tp" role="tabpanel" id="wb-lyn-tp2" aria-labelledby="wb-lyn-tab2" data-off>
        <div class="wb-lyn-rv"><img class="avatar" src="../../kit/assets/marks/mark-001.webp" alt=""><p><b>林晓</b><br><span class="wb-ly-meta">花束新鲜，包装精致</span></p><span class="tag" data-tone="success">5 分</span></div>
        <div class="wb-lyn-rv"><img class="avatar" src="../../kit/assets/marks/mark-002.webp" alt=""><p><b>陈默</b><br><span class="wb-ly-meta">送达及时，花苞饱满</span></p><span class="tag" data-tone="success">5 分</span></div>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-LAYT-024" data-name="分割线样式组" data-cat="LAYT">
