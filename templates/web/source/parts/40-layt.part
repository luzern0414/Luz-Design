<!-- cat: LAYT | 布局壳 -->
<style>
  /* 布局壳类：前缀 wb-ly-。每个演示是一块用真实组件搭好的版式小样：高度由内容决定，宽度跟着整行（版式壳不低于 720 像素，更窄时舞台横向滚动），
     壳内的栅格用容器宽度切换列数，不依赖窗口宽度 */
  #cat-layt .demo { min-width: 0; }
  #cat-layt .badge { min-width: 18px; height: 18px; font-size: var(--fs-xs); line-height: 18px; }
  #cat-layt .btn--primary:not([disabled]), #cat-layt .btn--danger:not([disabled]) { color: var(--surface); }
  #cat-layt .btn--danger-soft:not([disabled]), #cat-layt .tag[data-tone="danger"] { color: color-mix(in srgb, var(--danger) 82%, var(--ink)); }
  #cat-layt .demo__stage { padding: 0; border: 0; background: transparent; }
  .wb-ly-f { position: relative; isolation: isolate; overflow: hidden; container-type: inline-size; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg); }
  .wb-ly-f--w { background: var(--surface); }
  .wb-ly-f--wide { min-width: 720px; }
  .wb-ly-app { display: grid; grid-template-columns: 88px minmax(0, 1fr); }
  .wb-ly-app .rail { position: static; height: auto; align-self: stretch; }
  .wb-ly-app--s { grid-template-columns: 72px minmax(0, 1fr); }
  .wb-ly-app--s .rail { padding-left: 0; padding-right: 0; }
  .wb-ly-app--s .rail__item { width: 60px; }
  .wb-ly-main { min-width: 0; padding: 0 var(--s-6) var(--s-6); }
  .wb-ly-main--c { padding: 0 var(--s-5) var(--s-5); }
  .wb-ly-pad { padding: var(--s-4) var(--s-5); }
  .wb-ly-stk { display: grid; gap: var(--s-3); align-content: start; }
  .wb-ly-duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--s-3); }

  /* 页头 */
  .wb-ly-head { position: relative; isolation: isolate; margin: 0 calc(var(--s-6) * -1); padding: var(--s-5) var(--s-6) var(--s-4); background: linear-gradient(180deg, var(--action-tint) 0%, var(--bg) 100%); }
  .wb-ly-main--c > .wb-ly-head { margin: 0 calc(var(--s-5) * -1) var(--s-3); padding: var(--s-4) var(--s-5); }
  .wb-ly-head::after { content: ""; position: absolute; inset: 0; z-index: -1; background: url(../../kit/assets/photo/pattern-petals.webp) right top / 340px; opacity: .35; -webkit-mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); mask-image: linear-gradient(90deg, transparent 35%, var(--ink) 100%); pointer-events: none; }
  .wb-ly-head__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 44px; }
  .wb-ly-head h1 { font-size: var(--fs-3xl); font-weight: 700; line-height: var(--lh-tight); white-space: nowrap; }
  .wb-ly-main--c > .wb-ly-head h1 { font-size: var(--fs-2xl); }
  .wb-ly-head__acts { display: flex; align-items: center; gap: var(--s-2); }
  .wb-ly-head .search { width: 240px; }
  .wb-ly-head .seg { margin-top: var(--s-3); }
  .wb-ly-head--flat { margin: 0; padding: var(--s-5) var(--s-5) var(--s-4); }

  /* 通用小块：统计卡的标签与数值不换行，列数随容器宽度切换，保证每张卡的文字有足够横向空间 */
  .wb-ly-kpi { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px var(--s-2); padding: var(--s-4); }
  .wb-ly-kpi .stat__label { grid-column: 1; font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }
  .wb-ly-kpi img { grid-column: 2; grid-row: 1 / 3; width: 36px; height: 36px; object-fit: contain; }
  .wb-ly-num { grid-column: 1; font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wb-ly-num small { margin-left: 2px; font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .wb-ly-num small:first-child { margin: 0 2px 0 0; }
  .wb-ly-name { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .wb-ly-name--xl { font-size: var(--fs-xl); }
  .wb-ly-meta { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-ly-row { display: flex; align-items: center; gap: var(--s-3); }
  .wb-ly-sp { margin-left: auto; }
  .wb-ly-f .section { margin-top: 0; }
  .wb-ly-f .row { min-height: 64px; }
  .wb-ly-f .row__lead { width: 40px; height: 40px; }
  .wb-ly-k4 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .wb-ly-m21 { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); margin-top: var(--s-5); }
  .wb-ly-m21 > .section { display: grid; grid-template-rows: auto 1fr; }
  .wb-ly-fill { display: grid; grid-auto-rows: 1fr; }
  .wb-ly-chartc { display: grid; align-content: end; padding: var(--s-4) var(--s-5) var(--s-3); }
  .wb-ly-chartc .bars { height: var(--bh, 140px); }
  @container (min-width: 960px) {
    .wb-ly-k4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .wb-ly-m21 { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }

  /* 折叠侧栏 */
  .wb-ly-fold .rail { width: 88px; transition: width var(--dur-base) var(--ease-out); }
  .wb-ly-fold { grid-template-columns: auto minmax(0, 1fr); }
  .wb-ly-fold[data-c="true"] .rail { width: 64px; }
  .wb-ly-fold[data-c="true"] .rail__item { width: 44px; min-height: 44px; justify-content: center; }
  .wb-ly-fold[data-c="true"] .rail__item span { display: none; }
  .wb-ly-fold .rail__tog { margin-bottom: var(--s-2); }
  .wb-ly-fold .rail__tog img { transition: transform var(--dur-base) var(--ease-out); }
  .wb-ly-fold .rail__tog[aria-expanded="false"] img { transform: rotate(180deg); }
  .wb-ly-tr { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); }

  /* 顶栏与面包屑 */
  .wb-ly-top { display: flex; align-items: center; gap: var(--s-3); min-height: 64px; padding: 0 var(--s-5); background: var(--surface); border-bottom: 1px solid var(--line); box-shadow: var(--elev-1); }
  .wb-ly-top .search { flex: 1 1 140px; min-width: 0; max-width: 280px; min-height: 40px; }
  .wb-ly-top .drop__btn { min-height: 40px; padding: 0 var(--s-3); background: var(--zone); white-space: nowrap; }
  .wb-ly-top .drop__btn img { width: 18px; height: 18px; }
  .wb-ly-top .ibtn { flex: none; }
  .wb-ly-user { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 600; white-space: nowrap; }
  .wb-ly-user img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .wb-ly-body { padding: var(--s-5); }
  .wb-ly-crumb { display: flex; align-items: center; gap: var(--s-2); flex-wrap: nowrap; font-size: var(--fs-md); }
  .wb-ly-crumb a { color: var(--ink-3); transition: color var(--dur-quick) var(--ease-out); cursor: pointer; }
  @media (hover: hover) { .wb-ly-crumb a:hover { color: var(--action-press); text-decoration: underline; } }
  .wb-ly-crumb [aria-current] { font-weight: 600; color: var(--ink); }
  .wb-ly-prod { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; align-items: center; gap: var(--s-4); padding: var(--s-4); }
  .wb-ly-prod img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; }
  .wb-ly-prod .price { font-size: var(--fs-xl); }

  /* 多标签页栏 */
  .wb-ly-tabs { display: flex; align-items: flex-end; gap: var(--s-1); padding: var(--s-2) var(--s-3) 0; background: var(--zone); border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .wb-ly-tabs::-webkit-scrollbar { display: none; }
  .wb-ly-tab { position: relative; flex: none; display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-2) 0 var(--s-4); border-radius: var(--r-md) var(--r-md) 0 0; font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .wb-ly-tab:hover { background: color-mix(in srgb, var(--surface) 60%, transparent); } }
  .wb-ly-tab[aria-selected="true"] { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: 0 -1px 0 var(--line), 1px 0 0 var(--line), -1px 0 0 var(--line); }
  .wb-ly-tab[aria-selected="true"]::before { content: ""; position: absolute; left: var(--s-3); right: var(--s-3); top: 0; height: 3px; border-radius: 0 0 3px 3px; background: var(--action); }
  .wb-ly-tab .x { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; }
  .wb-ly-tab .x img { width: 12px; height: 12px; opacity: .55; }
  @media (hover: hover) { .wb-ly-tab .x:hover { background: var(--zone); } .wb-ly-tab .x:hover img { opacity: 1; } }
  .wb-ly-panel { display: grid; gap: var(--s-3); padding: var(--s-5); background: var(--surface); align-content: start; }

  /* 主从与三栏：列数由容器宽度决定，两侧卡片等高，内容在卡内铺满 */
  .wb-ly-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: var(--s-4); padding: var(--s-5); }
  .wb-ly-split > .list { display: grid; grid-auto-rows: 1fr; }
  .wb-ly-item { cursor: pointer; }
  .wb-ly-item[aria-selected="true"] { background: var(--action-tint); }
  .wb-ly-item[aria-selected="true"]::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: var(--action); border: 0; }
  .wb-ly-detail { --pic: 140px; display: grid; grid-template-columns: var(--pic) minmax(0, 1fr); gap: var(--s-5); align-items: center; padding: var(--s-5); }
  .wb-ly-detail img.pic { width: var(--pic); height: var(--pic); border-radius: var(--r-lg); object-fit: cover; }
  .wb-ly-dinfo { display: grid; gap: var(--s-4); min-width: 0; }
  .wb-ly-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3) var(--s-4); }
  .wb-ly-facts dt { font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-ly-facts dd { margin-top: 2px; min-width: 0; font-size: var(--fs-md); font-weight: 600; }
  .wb-ly-tri { display: grid; grid-template-columns: minmax(0, 1fr) 300px; grid-template-areas: "f f" "l i"; gap: var(--s-4); padding: var(--s-5); }
  .wb-ly-tri > .wb-ly-fl { grid-area: f; display: flex; }
  .wb-ly-tri > [data-list] { grid-area: l; align-content: start; }
  .wb-ly-tri > .wb-ly-info { grid-area: i; }
  .wb-ly-filter { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 48px; padding: 0 var(--s-4); text-align: left; font-size: var(--fs-md); transition: background var(--dur-quick) var(--ease-out); }
  .wb-ly-filter + .wb-ly-filter { border-left: 1px solid var(--line); }
  .wb-ly-filter[aria-current="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
  .wb-ly-filter small { font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wb-ly-info { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); }
  .wb-ly-info .kv { padding: 0; grid-template-columns: 64px minmax(0, 1fr); }
  .wb-ly-info .wb-ly-row:last-child { margin-top: auto; justify-content: flex-end; }
  @container (min-width: 1000px) {
    .wb-ly-split { grid-template-columns: 360px minmax(0, 1fr); }
    .wb-ly-detail { --pic: 240px; gap: var(--s-6); }
    .wb-ly-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .wb-ly-tri { grid-template-columns: 208px minmax(0, 1fr) 320px; grid-template-areas: "f l i"; }
    .wb-ly-tri > .wb-ly-fl { display: grid; grid-auto-rows: 1fr; align-self: stretch; }
    .wb-ly-filter + .wb-ly-filter { border-left: 0; border-top: 1px solid var(--line); }
  }

  /* 页脚分页栏 */
  .wb-ly-pg { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-3) var(--s-5); border-top: 1px solid var(--line); background: var(--surface); font-size: var(--fs-sm); color: var(--ink-2); }
  .wb-ly-pg .total { margin-right: auto; white-space: nowrap; }
  .wb-ly-pg .drop__btn { white-space: nowrap; }
  .wb-ly-pg .drop__menu { top: auto; bottom: calc(100% + 4px); transform-origin: bottom left; }
  .wb-ly-pg [data-pages] { display: inline-flex; align-items: center; gap: var(--s-1); }
  .wb-ly-pg .pgb { min-width: 36px; min-height: 36px; padding: 0 var(--s-2); border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
  .wb-ly-pg .pgb[aria-current="page"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; box-shadow: inset 0 0 0 1px var(--action); }
  .wb-ly-pg .pgb:disabled { opacity: .45; pointer-events: none; }
  .wb-ly-pg .pgb.wide { padding: 0 var(--s-3); }
  .wb-ly-pg .pgb-gap { display: inline-grid; place-items: center; min-width: 24px; min-height: 36px; color: var(--ink-3); }

  /* 登录与整页状态 */
  .wb-ly-login { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); min-height: 440px; }
  .wb-ly-login__photo { background: url(../../kit/assets/photo/scene-hero-pink.webp) center / cover; }
  .wb-ly-login__form { display: grid; align-content: center; justify-items: center; padding: var(--s-8); background: var(--surface); }
  .wb-ly-login__form form { display: grid; gap: var(--s-4); width: min(380px, 100%); }
  .wb-ly-login__form h2 { font-size: var(--fs-2xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-ly-keep { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .wb-ly-state { position: relative; display: grid; align-content: center; justify-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-5); text-align: center; background: var(--surface); }
  .wb-ly-state h2 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-ly-state .big { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; color: var(--action); font-variant-numeric: tabular-nums; }
  .wb-ly-state .back { position: absolute; left: var(--s-2); top: var(--s-2); }
  .wb-ly-lock { display: grid; place-items: center; width: 96px; height: 96px; border-radius: var(--r-xl); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .wb-ly-lock img { width: 48px; height: 48px; }

  /* 详情页与表单页 */
  .wb-ly-sub { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: var(--s-2); min-height: 56px; padding: 0 var(--s-4) 0 var(--s-2); background: var(--bg); border-bottom: 1px solid var(--line); }
  .wb-ly-sub h1 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .wb-ly-dg { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); padding: var(--s-5) var(--s-6) var(--s-6); align-items: start; }
  .wb-ly-dg > div { display: grid; gap: var(--s-4); align-content: start; }
  @container (max-width: 879px) { .wb-ly-dg > div:last-child { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (min-width: 880px) { .wb-ly-dg { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); } }
  .wb-ly-lines .wb-ly-ln { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 72px; padding: var(--s-2) var(--s-5); }
  .wb-ly-lines .wb-ly-ln + .wb-ly-ln { border-top: 1px solid var(--line); }
  .wb-ly-lines img { width: 56px; height: 56px; border-radius: var(--r-sm); object-fit: cover; }
  .wb-ly-amt { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 44px; padding: 0 var(--s-5); }
  .wb-ly-amt + .wb-ly-amt { border-top: 1px solid var(--line); }
  .wb-ly-formp { max-width: 1080px; margin: 0 auto; padding: var(--s-5) var(--s-5) var(--s-6); }
  .wb-ly-formp .form-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: var(--s-5); align-items: start; }
  .wb-ly-formp .wheel .input { width: 72px; }
  .wb-ly-stack { display: grid; }
  .wb-ly-stack > * { grid-area: 1 / 1; }
  .wb-ly-stack > [data-off] { visibility: hidden; }
  .wb-ly-skel { display: grid; gap: var(--s-3); align-content: start; }
  .wb-ly-skcard { display: grid; gap: var(--s-3); align-content: center; padding: var(--s-4) var(--s-5); }
  .wb-ly-skcard .skel { height: 16px; }
  .wb-ly-dash { display: grid; gap: var(--s-5); padding: var(--s-5) var(--s-6) var(--s-6); }
  .wb-ly-dash .wb-ly-m21 { margin-top: 0; }
  .wb-ly-dash .legend { align-content: center; }
  .wb-ly-donut { display: flex; align-items: center; justify-content: center; gap: var(--s-6); padding: var(--s-4) var(--s-5); }
</style>

<article class="demo demo--span2" data-cid="WB-LAYT-001" data-name="侧栏主区版式" data-cat="LAYT">
  <div class="demo__head"><span class="demo__name">侧栏主区版式</span></div>
  <p class="demo__note">适合：整个后台的基本骨架，上图下字侧栏加主内容区</p>
  <div class="demo__stage is-plain"><div class="wb-ly-f wb-ly-f--wide"><div class="wb-ly-app">
    <nav class="rail" aria-label="主导航小样" data-wb-rail>
      <button class="rail__item" aria-current="page"><img src="../../kit/assets/line/home.webp" alt=""><span>工作台</span></button>
      <button class="rail__item"><img src="../../kit/assets/line/archive.webp" alt=""><span>订单</span></button>
      <button class="rail__item"><img src="../../kit/assets/line/list.webp" alt=""><span>商品</span></button>
      <button class="rail__item"><img src="../../kit/assets/line/people.webp" alt=""><span>会员</span></button>
      <span class="rail__sp"></span>
      <button class="rail__item"><img src="../../kit/assets/line/settings.webp" alt=""><span>设置</span></button>
    </nav>
    <div class="wb-ly-main">
      <header class="wb-ly-head"><div class="wb-ly-head__row"><h1>经营概览</h1><div class="wb-ly-head__acts"><label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索订单或客户" aria-label="搜索订单或客户"></label><button class="ibtn" data-tip="消息" aria-label="消息"><img src="../../kit/assets/line/message.webp" alt=""><span class="badge">3</span></button></div></div></header>
      <div class="wb-ly-k4" style="margin-top: var(--s-2)">
        <div class="card wb-ly-kpi"><span class="stat__label">销售额</span><span class="wb-ly-num"><small>¥</small>128,640</span><img src="../../kit/assets/solid/bill.webp" alt=""></div>
        <div class="card wb-ly-kpi"><span class="stat__label">订单数</span><span class="wb-ly-num">1,286<small>单</small></span><img src="../../kit/assets/solid/order.webp" alt=""></div>
        <div class="card wb-ly-kpi"><span class="stat__label">新增会员</span><span class="wb-ly-num">84<small>人</small></span><img src="../../kit/assets/solid/biz-customer.webp" alt=""></div>
        <div class="card wb-ly-kpi"><span class="stat__label">在营门店</span><span class="wb-ly-num">3<small>家</small></span><img src="../../kit/assets/solid/biz-store.webp" alt=""></div>
      </div>
      <div class="wb-ly-m21">
        <section class="section"><div class="section__head"><h2>销售趋势</h2></div><div class="card section__body wb-ly-chartc"><div class="bars" role="img" aria-label="近七日订单数" style="--bh: 164px"><div class="bars__col"><span class="bars__bar" style="--h: 61%; --i: 0"></span>周一</div><div class="bars__col"><span class="bars__bar" style="--h: 66%; --i: 1"></span>周二</div><div class="bars__col"><span class="bars__bar" style="--h: 53%; --i: 2"></span>周三</div><div class="bars__col"><span class="bars__bar" style="--h: 72%; --i: 3"></span>周四</div><div class="bars__col"><span class="bars__bar" style="--h: 86%; --i: 4"></span>周五</div><div class="bars__col" aria-current="true"><span class="bars__bar" style="--h: 100%; --i: 5"></span>周六</div><div class="bars__col"><span class="bars__bar" style="--h: 79%; --i: 6"></span>周日</div></div></div></section>
        <section class="section"><div class="section__head"><h2>热销商品</h2></div><div class="card list section__body wb-ly-fill">
