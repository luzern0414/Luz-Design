    <colgroup><col style="width:108px"><col style="width:48px"><col style="width:88px"><col style="width:64px"><col style="width:72px"></colgroup>
    <thead><tr><th>商品</th><th>分类</th><th>门店</th><th>库存<small>件</small></th><th>单价<small>元</small></th></tr></thead>
    <tbody>
      <tr><td class="t-l">红玫瑰花束</td><td>鲜花</td><td>建国路店</td><td class="t-n">86</td><td class="t-r">199.00</td></tr>
      <tr><td class="t-l">粉芍药花束</td><td>鲜花</td><td>徐汇滨江店</td><td class="t-n">42</td><td class="t-r">239.00</td></tr>
      <tr><td class="t-l">蓝绣球盆栽</td><td>绿植</td><td>建国路店</td><td class="t-n">38</td><td class="t-r">129.00</td></tr>
      <tr><td class="t-l">龟背竹盆栽</td><td>绿植</td><td>浦东世纪店</td><td class="t-n">27</td><td class="t-r">159.00</td></tr>
      <tr><td class="t-l">干花花瓶摆件</td><td>花器</td><td>徐汇滨江店</td><td class="t-n">33</td><td class="t-r">129.00</td></tr>
      <tr><td class="t-l">花礼盒</td><td>礼盒</td><td>建国路店</td><td class="t-n">45</td><td class="t-r">259.00</td></tr>
    </tbody>
  </table></div></div></div>
</article>

<article class="demo" data-cid="WB-TABL-003" data-name="表头排序表格" data-cat="TABL">
  <div class="demo__head"><span class="demo__name">表头排序表格</span></div>
  <p class="demo__note">适合：按销量库存单价快速排查的商品榜</p>
  <div class="demo__stage"><div class="card wb-tb"><div class="table-wrap"><table class="table" id="wb-tb-sort" style="--min:384px">
    <colgroup><col style="width:96px"><col style="width:96px"><col style="width:96px"><col style="width:96px"></colgroup>
    <thead><tr>
      <th aria-sort="none"><button type="button" class="wb-tb-sort" data-k="n">商品<i class="wb-tb-caret"></i></button></th>
      <th aria-sort="none"><button type="button" class="wb-tb-sort" data-k="s">库存<small>件</small><i class="wb-tb-caret"></i></button></th>
      <th aria-sort="descending"><button type="button" class="wb-tb-sort" data-k="q">销量<small>件</small><i class="wb-tb-caret"></i></button></th>
      <th aria-sort="none"><button type="button" class="wb-tb-sort" data-k="p">单价<small>元</small><i class="wb-tb-caret"></i></button></th>
    </tr></thead>
    <tbody></tbody>
  </table></div></div></div>
</article>

<article class="demo" data-cid="WB-TABL-004" data-name="列筛选表格" data-cat="TABL">
  <div class="demo__head"><span class="demo__name">列筛选表格</span></div>
  <p class="demo__note">适合：枚举列直接在表头选条件即时过滤</p>
  <div class="demo__stage wb-tb-vis"><div class="card wb-tb wb-tb--free" id="wb-tb-cf">
    <table class="table" style="width:100%">
      <colgroup><col style="width:108px"><col style="width:76px"><col style="width:88px"><col style="width:64px"><col style="width:76px"></colgroup>
      <thead><tr>
        <th>商品</th>
        <th><div class="drop wb-tb-fdrop" data-k="c"><button type="button" class="drop__btn" aria-label="按分类筛选"><b>分类</b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="鲜花">鲜花</button><button type="button" class="drop__opt" data-value="绿植">绿植</button><button type="button" class="drop__opt" data-value="礼盒">礼盒</button><button type="button" class="drop__opt" data-value="花器">花器</button></div></div></th>
        <th><div class="drop wb-tb-fdrop" data-k="m"><button type="button" class="drop__btn" aria-label="按门店筛选"><b>门店</b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="建国路店">建国路店</button><button type="button" class="drop__opt" data-value="徐汇滨江店">徐汇滨江店</button><button type="button" class="drop__opt" data-value="浦东世纪店">浦东世纪店</button></div></div></th>
        <th>库存<small>件</small></th>
        <th><div class="drop wb-tb-fdrop" data-k="t"><button type="button" class="drop__btn" aria-label="按状态筛选"><b>状态</b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="在售">在售</button><button type="button" class="drop__opt" data-value="售罄">售罄</button><button type="button" class="drop__opt" data-value="已下架">已下架</button></div></div></th>
      </tr></thead>
      <tbody></tbody>
    </table>
    <div class="wb-tb-foot"><span>筛选结果 <b data-n>8</b> 条</span><span class="sp"></span><button type="button" class="btn btn--text btn--sm" data-clear hidden>清除筛选</button></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-TABL-005" data-name="勾选批量表格" data-cat="TABL">
  <div class="demo__head"><span class="demo__name">勾选批量表格</span></div>
  <p class="demo__note">适合：多单一次处理的待发货队列</p>
  <div class="demo__stage"><div class="card wb-tb" id="wb-tb-bat">
    <div class="toolbar" data-bar="normal"><label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索客户或商品" aria-label="搜索客户或商品" autocomplete="off"></label><span class="toolbar__sp"></span><span class="t-sub">共 <b data-total>6</b> 单</span></div>
    <div class="wb-tb-batch" data-bar="batch" hidden><span>已选 <b data-n>0</b> 项</span><span class="sp"></span><button type="button" class="btn btn--primary btn--sm" data-act="ship">批量发货</button><button type="button" class="btn btn--secondary btn--sm" data-act="export">导出所选</button><button type="button" class="btn btn--text btn--sm" data-act="clear">取消选择</button></div>
    <div class="table-wrap"><table class="table" style="--min:420px">
      <colgroup><col style="width:44px"><col style="width:48px"><col style="width:96px"><col style="width:88px"><col style="width:72px"><col style="width:72px"></colgroup>
      <thead><tr><th class="t-c1"><span class="check" role="checkbox" aria-checked="false" aria-label="全选当前列表" data-all><img src="../../kit/assets/line/check.webp" alt=""></span></th><th>客户</th><th>商品</th><th>门店</th><th>金额<small>元</small></th><th>状态</th></tr></thead>
      <tbody></tbody>
    </table></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-TABL-006" data-name="行内展开表格" data-cat="TABL">
