    <div class="toolbar">
      <label class="search"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索客户或商品" aria-label="搜索客户或商品" autocomplete="off"></label>
      <div class="drop" data-k="m"><button type="button" class="drop__btn" aria-label="门店">门店 <b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="建国路店">建国路店</button><button type="button" class="drop__opt" data-value="徐汇滨江店">徐汇滨江店</button><button type="button" class="drop__opt" data-value="浦东世纪店">浦东世纪店</button></div></div>
      <div class="drop" data-k="t"><button type="button" class="drop__btn" aria-label="状态">状态 <b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="待付款">待付款</button><button type="button" class="drop__opt" data-value="待发货">待发货</button><button type="button" class="drop__opt" data-value="待收货">待收货</button><button type="button" class="drop__opt" data-value="已完成">已完成</button><button type="button" class="drop__opt" data-value="售后">售后</button></div></div>
      <span class="toolbar__sp"></span>
      <span class="t-sub">共 <b data-n>8</b> 单</span>
      <div class="drop wb-tb-exp" data-k="x" data-placeholder><button type="button" class="drop__btn" aria-label="导出">导出</button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="cur">当前筛选结果</button><button type="button" class="drop__opt" data-value="all">全部订单</button></div></div>
    </div>
    <div class="table-wrap"><table class="table" style="--min:456px">
      <colgroup><col style="width:64px"><col style="width:48px"><col style="width:112px"><col style="width:88px"><col style="width:72px"><col style="width:72px"></colgroup>
      <thead><tr><th>订单号</th><th>客户</th><th>商品</th><th>门店</th><th>金额<small>元</small></th><th>状态</th></tr></thead>
      <tbody></tbody>
    </table></div>
  </div></div>
</article>

