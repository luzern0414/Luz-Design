    <div class="table-wrap"><table class="table" style="--min:368px">
      <colgroup><col style="width:160px"><col style="width:64px"><col style="width:72px"><col style="width:72px"></colgroup>
      <thead><tr><th>商品</th><th>库存<small>件</small></th><th>单价<small>元</small></th><th>状态</th></tr></thead>
      <tbody>
        <tr><td class="t-l"><span class="wb-tb-obj"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><span><b>红玫瑰花束</b><small>鲜花</small></span></span></td><td class="t-n">86</td><td class="t-r">199.00</td><td><span class="tag" data-tone="success">在售</span></td></tr>
        <tr><td class="t-l"><span class="wb-tb-obj"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><span><b>白郁金香</b><small>鲜花</small></span></span></td><td class="t-n">51</td><td class="t-r">179.00</td><td><span class="tag" data-tone="success">在售</span></td></tr>
        <tr><td class="t-l"><span class="wb-tb-obj"><img src="../../kit/assets/photo/product-monstera.webp" alt=""><span><b>龟背竹盆栽</b><small>绿植</small></span></span></td><td class="t-n">27</td><td class="t-r">159.00</td><td><span class="tag" data-tone="success">在售</span></td></tr>
        <tr><td class="t-l"><span class="wb-tb-obj"><img src="../../kit/assets/photo/product-succulent.webp" alt=""><span><b>多肉组合盆</b><small>绿植</small></span></span></td><td class="t-n">0</td><td class="t-r">89.00</td><td><span class="tag" data-tone="warning">售罄</span></td></tr>
        <tr><td class="t-l"><span class="wb-tb-obj"><img src="../../kit/assets/photo/product-giftbox.webp" alt=""><span><b>花礼盒</b><small>礼盒</small></span></span></td><td class="t-n">45</td><td class="t-r">259.00</td><td><span class="tag" data-tone="success">在售</span></td></tr>
      </tbody>
    </table></div>
  </div></div>
</article>

