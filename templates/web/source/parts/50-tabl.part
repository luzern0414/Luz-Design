      <tr class="ex-row"><td class="t-n">20387</td><td>陈默</td><td class="t-l">粉芍药花束</td><td class="t-r">239.00</td><td><span class="tag" data-tone="action">待发货</span></td><td class="t-c1"><button type="button" class="ibtn chev-btn chev" data-expand="wb-tb-ex2" data-tip="展开明细" aria-label="展开订单 20387 明细"></button></td></tr>
      <tr class="ex-det"><td colspan="6"><div class="expand" id="wb-tb-ex2"><div><div class="expand__body wb-tb-det"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><dl class="wb-tb-kv"><div><dt>数量</dt><dd>1 束</dd></div><div><dt>配送</dt><dd>门店自提</dd></div><div><dt>门店</dt><dd>徐汇滨江店</dd></div><div><dt>下单</dt><dd>昨天</dd></div><div><dt>备注</dt><dd>无</dd></div><div class="wide"><dt>收货人</dt><dd>陈默</dd></div></dl><button type="button" class="btn btn--secondary btn--sm" data-toast="已打印小票">打印小票</button></div></div></div></td></tr>
      <tr class="ex-row"><td class="t-n">20386</td><td>周岚</td><td class="t-l">蓝绣球盆栽</td><td class="t-r">258.00</td><td><span class="tag" data-tone="info">待收货</span></td><td class="t-c1"><button type="button" class="ibtn chev-btn chev" data-expand="wb-tb-ex3" data-tip="展开明细" aria-label="展开订单 20386 明细"></button></td></tr>
