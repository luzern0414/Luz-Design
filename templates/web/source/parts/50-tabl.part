      <tr><th rowspan="2">门店</th><th colspan="2" class="grp edge">本周</th><th colspan="2" class="grp edge">上周</th><th rowspan="2" class="edge">环比</th></tr>
      <tr><th class="edge">销售额<small>元</small></th><th>订单<small>单</small></th><th class="edge">销售额<small>元</small></th><th>订单<small>单</small></th></tr>
    </thead>
    <tbody>
      <tr><td>建国路店</td><td class="t-r edge">42,860.00</td><td class="t-n">218</td><td class="t-r edge">39,120.00</td><td class="t-n">203</td><td class="edge"><span class="wb-tb-up">增长 9.6%</span></td></tr>
      <tr><td>徐汇滨江店</td><td class="t-r edge">31,240.00</td><td class="t-n">164</td><td class="t-r edge">34,580.00</td><td class="t-n">181</td><td class="edge"><span class="wb-tb-down">下降 9.7%</span></td></tr>
      <tr><td>浦东世纪店</td><td class="t-r edge">28,560.00</td><td class="t-n">149</td><td class="t-r edge">25,210.00</td><td class="t-n">132</td><td class="edge"><span class="wb-tb-up">增长 13.3%</span></td></tr>
