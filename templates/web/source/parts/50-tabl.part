<!-- cat: TABL | 表格 -->
<style>
  /* 表格类：前缀 wb-tb-。表头居中，短值居中，长文本左对齐并缩进，金额右对齐；后台正文 14。
     列宽用像素：各列都不小于内容宽度，容器放不下时表格容器内横向滚动，数字列不会被省略号截断 */
  .wb-tb { overflow: hidden; }
  .wb-tb--free { overflow: visible; }
  .wb-tb .table-wrap { overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-tb .table { border-collapse: separate; border-spacing: 0; font-size: var(--fs-sm); min-width: var(--min, 0); }
  .wb-tb .table thead th { height: 44px; padding: 0 var(--s-2); background: var(--zone); color: var(--ink-2); font-size: var(--fs-sm); font-weight: 600; text-align: center; white-space: nowrap; }
  .wb-tb .table thead th small { margin-left: 4px; font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); }
  .wb-tb .table td { height: var(--rh, 52px); padding: 0 var(--s-2); border-top: 1px solid var(--line); font-size: var(--fs-sm); text-align: center; vertical-align: middle; }
  .wb-tb .table tbody tr:first-child td, .wb-tb .table tbody:first-of-type tr:first-child td { border-top: 0; }
  .wb-tb .table td.t-l { text-align: left; padding-left: var(--s-4); }
  .wb-tb .table td.t-r { text-align: right; padding-right: var(--s-4); font-variant-numeric: tabular-nums; }
  .wb-tb .table td.t-n { font-variant-numeric: tabular-nums; }
  .wb-tb--dense .table thead th, .wb-tb--dense .table td { padding-left: 6px; padding-right: 6px; }
  .wb-tb--dense .table td.t-l { padding-left: var(--s-3); }
  .wb-tb--dense .table td.t-r { padding-right: var(--s-3); }
  .wb-tb .table td.ov { overflow: visible; }
  .wb-tb .table tbody tr { cursor: default; }
  .wb-tb .table tbody tr[aria-selected="true"] { background: color-mix(in srgb, var(--action) 9%, var(--surface)); }
  .wb-tb .table .none { color: var(--ink-3); }
  .wb-tb .tag[data-tone="action"] { box-shadow: inset 0 0 0 1px var(--action-edge); }
  .wb-tb--free > .table:first-child thead tr:first-child th:first-child { border-top-left-radius: calc(var(--r-lg) - 1px); }
  .wb-tb--free > .table:first-child thead tr:first-child th:last-child { border-top-right-radius: calc(var(--r-lg) - 1px); }
  .wb-tb .toolbar { min-height: 60px; padding: var(--s-3) var(--s-4); gap: var(--s-2); }
  .wb-tb .toolbar .search { width: 220px; min-height: 36px; }
  .wb-tb .toolbar .search input { height: 34px; font-size: var(--fs-sm); }
  .wb-tb .toolbar .search img { width: 18px; height: 18px; }
  .wb-tb .toolbar .drop__btn { min-height: 36px; }
  .wb-tb .toolbar .btn--sm { min-height: 36px; }
  #cat-tabl .demo__stage.wb-tb-vis { overflow: visible; }
  #cat-tabl .btn[disabled] { box-shadow: none; }
  .wb-tb-edit__row .input:focus-visible { outline: none; border-radius: var(--r-md); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 8%, transparent); }
  .wb-tb-foot { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: var(--s-2) var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-tb-foot .sp { flex: 1; }
  .wb-tb-foot b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* 对象单元：商品图与客户标识 */
  .wb-tb-obj { display: flex; align-items: center; gap: var(--s-3); width: fit-content; max-width: 100%; min-width: 0; text-align: left; }
  .wb-tb-obj img { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; flex: none; box-shadow: 0 0 0 1px var(--line); }
  .wb-tb-obj--round img { width: 40px; height: 40px; border-radius: 50%; }
  .wb-tb-obj > span { display: grid; gap: 1px; min-width: 0; }
  .wb-tb-obj b { font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; }
  .wb-tb-obj small { font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.3; }
  .wb-tb-vip { display: inline-flex; align-items: center; height: 20px; padding: 0 6px; border-radius: 6px; background: var(--accent-tint); color: var(--accent); font-size: var(--fs-xs); font-weight: 600; }
  .wb-tb-low { color: var(--warning); font-weight: 600; }
  .wb-tb-out { color: var(--danger); font-weight: 600; }
  .wb-tb-neg { color: var(--danger); }
  .wb-tb-up { color: var(--success); font-weight: 600; }
  .wb-tb-down { color: var(--danger); font-weight: 600; }

  /* 文字操作：行内直达 */
  .wb-tb-ops { display: inline-flex; align-items: center; justify-content: center; gap: 2px; }
  .wb-tb-link { min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 500; color: var(--action-press); white-space: nowrap; transition: background var(--dur-quick) var(--ease-out); }
  .wb-tb-link--danger { color: var(--danger); }
  .wb-tb-link[disabled] { color: var(--ink-3); pointer-events: none; }
  @media (hover: hover) { .wb-tb-link:hover { background: var(--zone); } }

  /* 勾选：沿用共用 check，补半选 */
  .wb-tb .check[aria-checked="mixed"] { background: var(--action); border-color: var(--action); position: relative; }
  .wb-tb .check[aria-checked="mixed"]::after { content: ""; width: 10px; height: 2px; border-radius: 1px; background: var(--surface); }
  .wb-tb .check[aria-checked="mixed"] img { display: none; }
  .wb-tb .table td.t-c1, .wb-tb .table th.t-c1 { padding: 0 0 0 var(--s-4); }
  .wb-tb .table .t-c1 .check { display: flex; }
  .wb-tb .table td .switch { display: block; margin: 0 auto; }

  /* 表头排序 */
  .wb-tb-sort { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-weight: 600; color: inherit; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-tb-sort small { margin: 0; }
  @media (hover: hover) { .wb-tb-sort:hover { background: color-mix(in srgb, var(--action) 10%, transparent); } }
  .wb-tb-caret { width: 7px; height: 7px; border: solid var(--ink-3); border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translate(-2px, -2px); opacity: .5; transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
  th[aria-sort="descending"] .wb-tb-sort, th[aria-sort="ascending"] .wb-tb-sort { color: var(--action-press); }
  th[aria-sort="descending"] .wb-tb-caret { opacity: 1; border-color: var(--action-press); }
  th[aria-sort="ascending"] .wb-tb-caret { opacity: 1; border-color: var(--action-press); transform: rotate(225deg) translate(-2px, -2px); }
  .wb-tb .table td.is-sorted { background: color-mix(in srgb, var(--action) 4%, var(--surface)); }

  /* 列筛选：表头里的下拉 */
  .wb-tb-fdrop .drop__btn { min-height: 32px; padding: 0 var(--s-2) 0 var(--s-3); background: transparent; color: var(--ink-2); font-weight: 600; }
  .wb-tb-fdrop .drop__btn b { color: inherit; }
  .wb-tb-fdrop[data-on="true"] .drop__btn { background: var(--surface); color: var(--action-press); box-shadow: inset 0 0 0 1px var(--action-edge); }
  @media (hover: hover) { .wb-tb-fdrop .drop__btn:hover { background: color-mix(in srgb, var(--action) 10%, transparent); } }
  .wb-tb-fdrop .drop__menu { left: 50%; margin-left: -64px; min-width: 128px; text-align: left; }

  /* 斑马纹与密度 */
  .wb-tb--zebra .table tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--zone) 62%, var(--surface)); }
  .wb-tb--zebra .table tbody tr:hover td { background: var(--zone); }
  .wb-tb:has(.wb-tb-obj) { --rh: 60px; }
  .wb-tb[data-density="s"] { --rh: 40px; }
  .wb-tb[data-density="l"] { --rh: 72px; }
  .wb-tb[data-density="s"] .wb-tb-obj img { width: 30px; height: 30px; border-radius: 8px; }
  .wb-tb[data-density="l"] .wb-tb-obj img { width: 52px; height: 52px; }

  /* 批量条：与工具条等高，出现时替换它 */
  .wb-tb-batch { display: flex; align-items: center; gap: var(--s-2); min-height: 60px; padding: var(--s-3) var(--s-4); background: var(--action-tint); border-bottom: 1px solid var(--action-edge); font-size: var(--fs-sm); }
  .wb-tb-batch b { font-weight: 700; color: var(--action-press); font-variant-numeric: tabular-nums; }
  .wb-tb-batch .sp { flex: 1; }
  .wb-tb-batch[hidden] { display: none; }

  /* 行内展开 */
  .wb-tb .ex-det > td { height: auto; padding: 0; border-top: 0; text-align: left; white-space: normal; }
  .wb-tb .table tbody tr.ex-det:hover { background: transparent; }
  .wb-tb .ex-row:has([aria-expanded="true"]) { background: var(--zone); }
  .wb-tb-det { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-5); }
  .wb-tb-det img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-tb-kv { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: var(--s-3) var(--s-5); min-width: 0; }
  .wb-tb-kv .wide { grid-column: 1 / -1; }
  .wb-tb-kv dt { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-tb-kv dd { margin-top: 2px; font-size: var(--fs-sm); color: var(--ink); }
  .wb-tb .chev-btn { width: 32px; height: 32px; }

  /* 固定列：滚动出现边缘阴影 */
  .wb-tb-fix .table th:first-child, .wb-tb-fix .table td:first-child { position: sticky; left: 0; z-index: 2; background: var(--surface); }
  .wb-tb-fix .table thead th:first-child { background: var(--zone); z-index: 3; }
  .wb-tb-fix .table tbody tr:hover td:first-child { background: var(--zone); }
  .wb-tb-fix[data-edge-l="true"] .table th:first-child, .wb-tb-fix[data-edge-l="true"] .table td:first-child { box-shadow: 10px 0 12px -10px color-mix(in srgb, var(--ink) 34%, transparent); }
  .wb-tb-fixr .table th:last-child, .wb-tb-fixr .table td:last-child { position: sticky; right: 0; z-index: 2; background: var(--surface); }
  .wb-tb-fixr .table thead th:last-child { background: var(--zone); z-index: 3; }
  .wb-tb-fixr .table tbody tr:hover td:last-child { background: var(--zone); }
  .wb-tb-fixr[data-edge-r="true"] .table th:last-child, .wb-tb-fixr[data-edge-r="true"] .table td:last-child { box-shadow: -10px 0 12px -10px color-mix(in srgb, var(--ink) 34%, transparent); }
  .wb-tb-fix .table td:first-child { text-align: left; padding-left: var(--s-4); }

  /* 原位编辑 */
  .wb-tb-edit { display: inline-flex; align-items: center; justify-content: flex-end; gap: var(--s-2); width: 100%; font-variant-numeric: tabular-nums; }
  .wb-tb-edit__btn { width: 28px; height: 28px; border-radius: var(--r-sm); opacity: .55; }
  .wb-tb-edit__btn img { width: 16px; height: 16px; }
  tr:hover .wb-tb-edit__btn, .wb-tb-edit__btn:focus-visible { opacity: 1; }
  .wb-tb-edit__form { display: grid; gap: 4px; justify-items: end; }
  .wb-tb-edit__row { display: inline-flex; align-items: center; gap: var(--s-2); }
  .wb-tb-edit__row .input { width: 92px; min-height: 34px; padding: 0 var(--s-2); font-size: var(--fs-sm); text-align: right; font-variant-numeric: tabular-nums; }
  .wb-tb-edit__row .btn--sm { min-height: 34px; }
  .wb-tb-edit__err { font-size: var(--fs-xs); color: var(--danger); }
  .wb-tb .table td.is-edit { height: 76px; }
  @keyframes wb-tb-flash { from { background: color-mix(in srgb, var(--success) 18%, transparent); } to { background: transparent; } }
  .wb-tb td.is-saved { animation: wb-tb-flash 1.2s var(--ease-out) both; }

  /* 分页器 */
  .wb-tb-pager { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }
  .wb-tb-pager > * { flex: none; }
  .wb-tb-pager .sp { flex: 1 1 0; min-width: 0; }
  .wb-tb--pg { min-width: 720px; }
  .wb-tb-pager .drop__menu { top: auto; bottom: calc(100% + 4px); transform-origin: bottom left; }
  .wb-tb--xp { min-width: 620px; }
  .wb-tb-pager .drop__btn { min-height: 34px; }
  .wb-tb-pages { display: inline-flex; align-items: center; gap: 4px; }
  .wb-tb-pgb { flex: none; min-width: 32px; height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); white-space: nowrap; font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .wb-tb-pgb:hover { background: var(--zone); } }
  .wb-tb-pgb[aria-current="page"] { background: var(--action); color: var(--surface); font-weight: 600; }
  .wb-tb-pgb[disabled] { color: var(--ink-3); opacity: .5; pointer-events: none; }
  .wb-tb-pgb--txt { padding: 0 var(--s-3); }
  .wb-tb-gap { min-width: 24px; text-align: center; color: var(--ink-3); }
  .wb-tb-jump { display: inline-flex; align-items: center; gap: var(--s-2); }
  .wb-tb-jump .input { width: 56px; min-height: 32px; padding: 0 var(--s-1); font-size: var(--fs-sm); text-align: center; font-variant-numeric: tabular-nums; }
  .wb-tb-scroll { max-height: 312px; overflow: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .wb-tb-scroll .table thead th { position: sticky; top: 0; z-index: 4; }
  .wb-tb-scroll[data-edge-t="true"] .table thead th { border-bottom: 1px solid var(--line-strong); }
  .wb-tb-mini { display: grid; }
  .wb-tb-mini .row { min-height: 52px; padding: var(--s-2) var(--s-4); }
  .wb-tb-mini .row__trail { align-items: flex-end; }

  /* 树形 */
  .wb-tb.wb-tb-tree .table td.t-l { padding-left: calc(var(--s-3) + var(--lvl, 0) * 18px); }
  .wb-tb-share { display: flex; align-items: center; justify-content: center; gap: var(--s-2); }
  .wb-tb-share .progress { width: 64px; height: 6px; }
  .wb-tb-slot { display: inline-block; width: 44px; }
  .wb-tb-mini .row__title { font-size: var(--fs-sm); }
  .wb-tb-mini .row__meta { font-size: var(--fs-xs); }
  .wb-tb-node { display: flex; align-items: center; gap: var(--s-2); width: fit-content; text-align: left; min-width: 0; }
  .wb-tb-tog { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-sm); flex: none; }
  .wb-tb-tog { justify-content: center; }
  .wb-tb-tog::after { margin-left: 0; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) { .wb-tb-tog:hover { background: var(--zone); } }
  .wb-tb-sp { width: 28px; flex: none; }
  .wb-tb-node img { width: 30px; height: 30px; border-radius: 8px; object-fit: cover; flex: none; box-shadow: 0 0 0 1px var(--line); }
  .wb-tb-node b { font-weight: 600; }
  .wb-tb-tree tr[data-lvl="0"] td { background: color-mix(in srgb, var(--zone) 50%, var(--surface)); }
  .wb-tb-tree tr[data-lvl="0"] td:first-child b { font-size: var(--fs-md); }
  .wb-tb-tree tr[hidden] { display: none; }

  /* 汇总行 */
  .wb-tb tfoot td { height: 56px; background: var(--zone); border-top: 1px solid var(--line-strong); font-weight: 600; font-size: var(--fs-sm); }
  .wb-tb tfoot td.t-r b { color: var(--price); font-size: var(--fs-sm); }

  /* 空与骨架 */
  .wb-tb-empty { display: grid; justify-items: center; gap: var(--s-2); padding: var(--s-8) var(--s-4); color: var(--ink-3); font-size: var(--fs-sm); }
  .wb-tb-empty img { width: 88px; height: 88px; object-fit: contain; }
  .wb-tb-empty b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
  .wb-tb-empty .btn { margin-top: var(--s-2); }
  .wb-tb .skel { height: 14px; display: block; margin: 0 auto; }
  .wb-tb .table td .skel + .skel { margin-top: 6px; }

  /* 列设置浮层 */
  .wb-tb-cols .drop__btn { width: 36px; height: 36px; padding: 0; justify-content: center; border-radius: var(--r-md); background: var(--zone); }
  .wb-tb-cols .drop__btn::after { display: none; }
  .wb-tb-cols .drop__btn img { width: 20px; height: 20px; }
  .wb-tb-cols .drop__menu { left: auto; right: 0; min-width: 200px; padding: var(--s-2); transform-origin: top right; }
  .wb-tb-cols__head { display: flex; align-items: center; justify-content: space-between; padding: var(--s-1) var(--s-2) var(--s-2); font-size: var(--fs-sm); font-weight: 600; }
  .wb-tb-cols__head button { font-size: var(--fs-sm); font-weight: 500; color: var(--action-press); }
  .wb-tb-col { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 38px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); text-align: left; cursor: pointer; }
  @media (hover: hover) { .wb-tb-col:hover { background: var(--zone); } }
  .wb-tb-col[aria-disabled="true"] { opacity: .5; }

  /* 导出按钮：看起来是次要按钮的下拉 */
  .wb-tb-exp .drop__btn { min-height: 36px; padding: 0 var(--s-4); border-radius: var(--r-md); background: var(--action-tint); color: var(--action-press); font-weight: 600; box-shadow: inset 0 0 0 1px var(--action-edge); }
  .wb-tb-exp .drop__btn::after { border-color: var(--action-press); }
  .wb-tb-exp .drop__btn.is-loading { pointer-events: none; color: transparent; position: relative; }
  .wb-tb-exp .drop__btn.is-loading::after { position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border: 2px solid var(--action); border-color: var(--action) transparent var(--action) transparent; border-radius: 50%; transform: none; animation: lz-spin .8s linear infinite; }
  .wb-tb-exp .drop__menu { left: auto; right: 0; min-width: 168px; transform-origin: top right; }
  /* 更多菜单：行内重绘也能用，自带开合 */
  .wb-tb-more { position: relative; display: inline-block; }
  .wb-tb-more__btn { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 500; color: var(--action-press); }
  .wb-tb-more__btn::after { content: ""; width: 6px; height: 6px; border: solid currentColor; border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translate(-1px, -2px); }
  @media (hover: hover) { .wb-tb-more__btn:hover { background: var(--zone); } }
  .wb-tb-more__menu { position: absolute; z-index: 30; top: calc(100% + 4px); right: 0; min-width: 132px; padding: var(--s-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); opacity: 0; transform: scale(.96); transform-origin: top right; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); text-align: left; }
  .wb-tb-more[data-open="true"] .wb-tb-more__menu { opacity: 1; transform: none; pointer-events: auto; }
  .wb-tb-more[data-up="true"] .wb-tb-more__menu { top: auto; bottom: calc(100% + 4px); transform-origin: bottom right; }
  .wb-tb-more__opt { display: block; width: 100%; min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); white-space: nowrap; }
  @media (hover: hover) { .wb-tb-more__opt:hover { background: var(--zone); } }
  .wb-tb-more__opt--danger { color: var(--danger); }

  /* 多级表头与合并 */
  .wb-tb .table thead th.grp { border-bottom: 1px solid var(--line-strong); background: color-mix(in srgb, var(--zone) 70%, var(--surface)); }
  .wb-tb .table thead tr + tr th { background: var(--zone); }
  .wb-tb .table thead th.edge, .wb-tb .table td.edge { border-left: 1px solid var(--line); }
  .wb-tb .table tbody.grp:hover td { background: var(--zone); }
  .wb-tb .table tbody.grp + tbody.grp td { border-top: 1px solid var(--line); }
  .wb-tb .table tbody.grp tr:not(:first-child) td { border-top: 1px dashed var(--line); }
  .wb-tb .table tbody.grp td.mg { border-left: 1px solid var(--line); }
  .wb-tb .table td.mg:first-child { border-left: 0; }

  /* 状态分段：六个分栏在最窄列宽里也要一行放下 */
  #wb-tb-st .toolbar .seg__item { padding: 0 var(--s-2); }
  #wb-tb-st .toolbar .seg { flex: 1; min-width: 0; }
  #cat-tabl .wb-tb-note { padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
</style>

<article class="demo" data-cid="WB-TABL-001" data-name="基础数据表格" data-cat="TABL">
  <div class="demo__head"><span class="demo__name">基础数据表格</span></div>
  <p class="demo__note">适合：订单与商品等纵向记录的常规展示</p>
  <div class="demo__stage"><div class="card wb-tb"><div class="table-wrap"><table class="table" style="--min:440px">
    <colgroup><col style="width:64px"><col style="width:48px"><col style="width:96px"><col style="width:88px"><col style="width:72px"><col style="width:72px"></colgroup>
    <thead><tr><th>订单号</th><th>客户</th><th>商品</th><th>门店</th><th>金额<small>元</small></th><th>状态</th></tr></thead>
    <tbody>
      <tr><td class="t-n">20388</td><td>林晓</td><td class="t-l">红玫瑰花束</td><td>建国路店</td><td class="t-r">199.00</td><td><span class="tag" data-tone="warning">待付款</span></td></tr>
      <tr><td class="t-n">20387</td><td>陈默</td><td class="t-l">粉芍药花束</td><td>徐汇滨江店</td><td class="t-r">239.00</td><td><span class="tag" data-tone="action">待发货</span></td></tr>
      <tr><td class="t-n">20386</td><td>周岚</td><td class="t-l">蓝绣球盆栽</td><td>浦东世纪店</td><td class="t-r">258.00</td><td><span class="tag" data-tone="info">待收货</span></td></tr>
      <tr><td class="t-n">20385</td><td>吴桐</td><td class="t-l">花礼盒</td><td>建国路店</td><td class="t-r">259.00</td><td><span class="tag" data-tone="success">已完成</span></td></tr>
      <tr><td class="t-n">20384</td><td>郑一</td><td class="t-l">向日葵花束</td><td>浦东世纪店</td><td class="t-r">159.00</td><td><span class="tag" data-tone="danger">售后</span></td></tr>
    </tbody>
  </table></div></div></div>
</article>

<article class="demo" data-cid="WB-TABL-002" data-name="斑马纹表格" data-cat="TABL">
  <div class="demo__head"><span class="demo__name">斑马纹表格</span></div>
  <p class="demo__note">适合：行数较多需要横向对读的库存清单</p>
