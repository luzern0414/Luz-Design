<article class="demo" data-cid="WB-FORM-036" data-name="穿梭框选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">穿梭框选择</span></div>
  <p class="demo__note">适合：权限与成员分配，左右两栏互相移动</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-tf">
    <div class="field"><span class="field__label" id="wb-fm-tf-l">角色权限</span>
      <div class="wb-fm-tf" role="group" aria-labelledby="wb-fm-tf-l">
        <section class="wb-fm-tf-p" data-side="l" aria-label="可选权限">
          <button type="button" class="wb-fm-tf-h" data-all aria-label="全选可选权限"><span class="check" aria-checked="false" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><b>可选权限</b><span class="wb-fm-cnt" data-c>0/0</span></button>
          <label class="wb-fm-combo-s field-shell"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索权限" aria-label="搜索可选权限" autocomplete="off"></label>
          <div class="wb-fm-tf-l" role="listbox" aria-multiselectable="true" aria-label="可选权限列表"></div>
        </section>
        <div class="wb-fm-tf-mid">
          <button type="button" class="wb-fm-tf-b wb-fm-tf-b--r" data-go="r" data-tip="添加所选权限" aria-label="添加所选权限" disabled></button>
          <button type="button" class="wb-fm-tf-b" data-go="l" data-tip="移除所选权限" aria-label="移除所选权限" disabled></button>
        </div>
        <section class="wb-fm-tf-p" data-side="r" aria-label="已授权权限">
          <button type="button" class="wb-fm-tf-h" data-all aria-label="全选已授权权限"><span class="check" aria-checked="false" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span><b>已授权</b><span class="wb-fm-cnt" data-c>0/0</span></button>
          <label class="wb-fm-combo-s field-shell"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索权限" aria-label="搜索已授权权限" autocomplete="off"></label>
          <div class="wb-fm-tf-l" role="listbox" aria-multiselectable="true" aria-label="已授权权限列表"></div>
        </section>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-037" data-name="验证码分格输入" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">验证码分格输入</span></div>
  <p class="demo__note">适合：登录与改密码时六格验证码逐格输入并自动跳格</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-otp"><div class="wb-fm-otp" data-st="idle">
    <div class="wb-fm-otp__top"><h3>验证手机号</h3><span class="t-sub">验证码已发送至尾号 8000 的手机</span></div>
    <div class="wb-fm-otp__row" role="group" aria-label="六位短信验证码">
      <input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 1 位" autocomplete="one-time-code"><input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 2 位" autocomplete="off"><input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 3 位" autocomplete="off"><input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 4 位" autocomplete="off"><input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 5 位" autocomplete="off"><input class="input wb-fm-otp__c" inputmode="numeric" maxlength="1" aria-label="验证码第 6 位" autocomplete="off">
    </div>
    <div class="wb-fm-otp__msg" role="status" aria-live="polite"></div>
    <div class="wb-fm-otp__re"><button type="button" class="btn btn--text btn--sm" data-resend disabled>60 秒后可重新获取</button></div>
  </div></div></div>
</article>

<article class="demo" data-cid="WB-FORM-038" data-name="原位编辑文本" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">原位编辑文本</span></div>
  <p class="demo__note">适合：名称与备注在阅读态与编辑态之间原位切换</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-ie">
    <div class="wb-fm-ie-row" data-f="name"><b>门店名称</b>
      <div class="wb-fm-ie-c">
        <div class="wb-fm-ie-v" data-read><span class="wb-fm-ie-t">建国路店</span><button type="button" class="ibtn wb-fm-ie-e" data-tip="编辑门店名称" aria-label="编辑门店名称"><img src="../../kit/assets/line/edit.webp" alt=""></button></div>
        <form class="wb-fm-ie-ed" data-edit hidden novalidate><input class="input" maxlength="20" aria-label="门店名称" autocomplete="off"><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="submit" class="btn btn--primary">保存</button><span class="field__err" hidden></span></form>
      </div>
    </div>
    <div class="wb-fm-ie-row" data-f="note" data-multi><b>门店备注</b>
      <div class="wb-fm-ie-c">
        <div class="wb-fm-ie-v" data-read><span class="wb-fm-ie-t" data-empty="true">暂无备注</span><button type="button" class="ibtn wb-fm-ie-e" data-tip="编辑门店备注" aria-label="编辑门店备注"><img src="../../kit/assets/line/edit.webp" alt=""></button></div>
        <form class="wb-fm-ie-ed" data-edit hidden novalidate><div class="wb-fm-ie-box"><textarea class="textarea wb-fm-ta--s" maxlength="60" aria-label="门店备注" placeholder="请输入备注内容"></textarea></div><div class="wb-fm-ie-foot"><span class="wb-fm-cnt"><b data-n>0</b>/60</span><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="submit" class="btn btn--primary">保存</button></div><span class="field__err" hidden></span></form>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-039" data-name="日期时间选择器" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">日期时间选择器</span></div>
  <p class="demo__note">适合：活动开始与结束需精确到时分的场景</p>
  <div class="demo__stage wb-fm-room"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-dt">
    <div class="field"><span class="field__label" id="wb-fm-dt-l1">活动开始</span>
      <div class="wb-fm-pick" data-open="false" data-k="s" data-init="3"><span class="wb-fm-group field-shell"><input class="input" inputmode="numeric" placeholder="请选择或输入开始时间" aria-labelledby="wb-fm-dt-l1" autocomplete="off"><button type="button" class="wb-fm-link" aria-expanded="false" aria-label="展开活动开始的月历与时间">日历</button></span><div class="wb-fm-pop wb-fm-dt-pop" role="group" aria-label="选择活动开始时间" inert></div></div>
      <span class="field__err" hidden></span>
    </div>
    <div class="field"><span class="field__label" id="wb-fm-dt-l2">活动结束</span>
      <div class="wb-fm-pick" data-open="false" data-k="e"><span class="wb-fm-group field-shell"><input class="input" inputmode="numeric" placeholder="请选择或输入结束时间" aria-labelledby="wb-fm-dt-l2" autocomplete="off"><button type="button" class="wb-fm-link" aria-expanded="false" aria-label="展开活动结束的月历与时间">日历</button></span><div class="wb-fm-pop wb-fm-dt-pop" role="group" aria-label="选择活动结束时间" inert></div></div>
      <span class="field__err" hidden></span>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-040" data-name="星级评分选择" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">星级评分选择</span></div>
  <p class="demo__note">适合：后台录入或筛选评价星级</p>
  <div class="demo__stage"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-rt">
    <div class="field"><span class="field__label" id="wb-fm-rt-l">商品评价</span>
      <div class="wb-fm-rt-line">
        <div class="wb-fm-rt" role="radiogroup" aria-labelledby="wb-fm-rt-l">
          <button type="button" class="wb-fm-rt-s" role="radio" aria-checked="false" aria-label="1 星"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""></button><button type="button" class="wb-fm-rt-s" role="radio" aria-checked="false" aria-label="2 星"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""></button><button type="button" class="wb-fm-rt-s" role="radio" aria-checked="false" aria-label="3 星"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""></button><button type="button" class="wb-fm-rt-s" role="radio" aria-checked="false" aria-label="4 星"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""></button><button type="button" class="wb-fm-rt-s" role="radio" aria-checked="false" aria-label="5 星"><img data-ic="star" src="../../kit/assets/icons/flat/star.webp" alt=""></button>
        </div>
        <span class="wb-fm-rt-w" data-w aria-live="polite">未评分</span>
        <button type="button" class="btn btn--text btn--sm" data-clear hidden>清除</button>
      </div>
    </div>
    <div class="field"><span class="field__label">门店均分</span>
      <div class="wb-fm-rt-line"><span class="wb-fm-rt-ro" data-ro="4.6" role="img" aria-label="门店均分 4.6 分，满分 5 分"></span><span class="wb-fm-rt-w">4.6 分</span></div>
    </div>
    <div class="field"><span class="field__label">已关闭评价</span>
      <div class="wb-fm-rt-line wb-fm-rt-off"><span class="wb-fm-rt-ro" data-ro="3" role="img" aria-label="已关闭评价，停在 3 星"></span><span class="wb-fm-rt-w">已关闭</span></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-041" data-name="颜色选择器" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">颜色选择器</span></div>
  <p class="demo__note">适合：后台配置品牌主色与标签色，带色板与十六进制输入</p>
  <div class="demo__stage wb-fm-room"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-cp">
    <div class="field"><span class="field__label" id="wb-fm-cp-l1">品牌主色</span>
      <div class="wb-fm-pick" data-open="false" data-tok="--action">
        <button type="button" class="wb-fm-ctl field-shell" aria-expanded="false" aria-labelledby="wb-fm-cp-l1"><span class="wb-fm-cp-lab"><span class="wb-fm-cp-sw"></span><span class="wb-fm-cp-v"></span></span></button>
        <div class="wb-fm-pop wb-fm-cp-pop" role="group" aria-label="选择品牌主色" inert>
          <div class="wb-fm-cp-sv" tabindex="0" role="slider" aria-label="饱和度与明度"><i class="wb-fm-cp-hd"></i></div>
          <div class="wb-fm-cp-hue" tabindex="0" role="slider" aria-label="色相" aria-valuemin="0" aria-valuemax="360"><i class="wb-fm-cp-hd"></i></div>
          <div class="wb-fm-cp-row"><span class="wb-fm-cp-pv"></span><div><span class="wb-fm-group field-shell"><span class="wb-fm-addon">#</span><input class="input wb-fm-cp-in" maxlength="7" placeholder="请输入色值" aria-label="十六进制色值" autocomplete="off"></span><span class="field__err" hidden>请输入 6 位十六进制色值</span></div></div>
          <div class="wb-fm-cp-sws" role="radiogroup" aria-label="常用色板"></div>
        </div>
      </div>
    </div>
    <div class="field"><span class="field__label" id="wb-fm-cp-l2">标签颜色</span>
      <div class="wb-fm-pick" data-open="false" data-tok="--info">
        <button type="button" class="wb-fm-ctl field-shell" aria-expanded="false" aria-labelledby="wb-fm-cp-l2"><span class="wb-fm-cp-lab"><span class="wb-fm-cp-sw"></span><span class="wb-fm-cp-v"></span></span></button>
        <div class="wb-fm-pop wb-fm-cp-pop" role="group" aria-label="选择标签颜色" inert>
          <div class="wb-fm-cp-sv" tabindex="0" role="slider" aria-label="饱和度与明度"><i class="wb-fm-cp-hd"></i></div>
          <div class="wb-fm-cp-hue" tabindex="0" role="slider" aria-label="色相" aria-valuemin="0" aria-valuemax="360"><i class="wb-fm-cp-hd"></i></div>
          <div class="wb-fm-cp-row"><span class="wb-fm-cp-pv"></span><div><span class="wb-fm-group field-shell"><span class="wb-fm-addon">#</span><input class="input wb-fm-cp-in" maxlength="7" placeholder="请输入色值" aria-label="十六进制色值" autocomplete="off"></span><span class="field__err" hidden>请输入 6 位十六进制色值</span></div></div>
          <div class="wb-fm-cp-sws" role="radiogroup" aria-label="常用色板"></div>
        </div>
      </div>
    </div>
    <div class="field"><span class="field__label">应用效果</span>
      <div class="wb-fm-cp-ex"><span class="btn btn--sm wb-fm-cp-b" data-on="dark">主要按钮</span><span class="tag wb-fm-cp-t" data-on="dark">新品</span><span class="tag wb-fm-cp-t" data-on="dark">热销</span></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-042" data-name="命令搜索面板" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">命令搜索面板</span></div>
  <p class="demo__note">适合：快捷键唤出全局搜索与快捷动作列表</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-cmd"><div class="wb-fm-cmd">
    <label class="wb-fm-cmd-s field-shell"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" role="combobox" aria-expanded="true" aria-controls="wb-fm-cmd-l" aria-autocomplete="list" placeholder="搜索页面与快捷动作" aria-label="搜索页面与快捷动作" autocomplete="off"></label>
    <div class="wb-fm-cmd-list" id="wb-fm-cmd-l" role="listbox" aria-label="搜索结果"></div>
    <div class="wb-fm-cmd-foot"><span>上下键选择</span><span>回车执行</span><span>退出键清空</span></div>
  </div></div></div>
</article>

<article class="demo" data-cid="WB-FORM-043" data-name="图片裁剪框" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">图片裁剪框</span></div>
  <p class="demo__note">适合：上传封面与头像后框选裁剪</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-crop">
    <div class="wb-fm-crop-wrap"><div class="wb-fm-crop-st" data-st>
      <img src="../../kit/assets/photo/bg-floral.webp" alt="待裁剪的封面图" draggable="false">
      <div class="wb-fm-crop-fr" data-fr tabindex="0" role="application" aria-label="裁剪框，方向键移动，加号减号缩放"><i data-h="nw"></i><i data-h="ne"></i><i data-h="sw"></i><i data-h="se"></i></div>
    </div></div>
    <div class="wb-fm-crop-bar">
      <div class="seg" role="radiogroup" aria-label="裁剪比例"><button type="button" class="seg__item" role="radio" aria-checked="true" data-r="1">方形</button><button type="button" class="seg__item" role="radio" aria-checked="false" data-r="1.5">横版</button><button type="button" class="seg__item" role="radio" aria-checked="false" data-r="0.75">竖版</button></div>
      <span class="wb-fm-crop-zoom"><button type="button" class="btn btn--ghost btn--sm" data-z="-1">缩小</button><button type="button" class="btn btn--ghost btn--sm" data-z="1">放大</button></span>
    </div>
    <div class="wb-fm-crop-out">
      <div class="wb-fm-crop-pv"><span class="wb-fm-crop-p" data-pv="r" role="img" aria-label="裁剪结果预览"></span><span class="wb-fm-crop-p wb-fm-crop-p--c" data-pv="c" role="img" aria-label="圆形头像预览"></span><div class="wb-fm-crop-info"><b data-size>未选区域</b><small data-state>拖动框选区域</small></div></div>
      <span class="wb-fm-tail"><button type="button" class="btn btn--ghost" data-pick>重选图片</button><button type="button" class="btn btn--primary" data-ok>确认裁剪</button></span>
    </div>
    <input type="file" accept="image/*" hidden>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-044" data-name="提及输入框" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">提及输入框</span></div>
  <p class="demo__note">适合：备注与协作评论中输入艾特选择成员</p>
  <div class="demo__stage wb-fm-room"><div class="card wb-fm-card" id="wb-fm-mn">
    <div class="field"><span class="wb-fm-lab"><span class="field__label" id="wb-fm-mn-l">协作评论</span><span class="wb-fm-cnt"><b data-n>0</b>/200</span></span>
      <div class="wb-fm-mn-box">
        <textarea class="textarea" maxlength="200" placeholder="输入内容，用 @ 提及成员" aria-labelledby="wb-fm-mn-l" aria-haspopup="listbox" aria-expanded="false" aria-controls="wb-fm-mn-p"></textarea>
        <div class="wb-fm-mn-pop" id="wb-fm-mn-p" role="listbox" aria-label="可提及的成员"></div>
      </div>
    </div>
    <div class="wb-fm-mn-foot"><div class="wb-fm-chips" aria-label="已提及成员"></div><button type="button" class="btn btn--primary" data-send disabled>发表评论</button></div>
    <div class="wb-fm-mn-feed" aria-live="polite"></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-045" data-name="自适应文本域" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">自适应文本域</span></div>
  <p class="demo__note">适合：备注框随输入行数自动增高</p>
  <div class="demo__stage"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-au">
    <label class="field"><span class="wb-fm-lab"><span class="field__label">订单备注</span><span class="wb-fm-cnt"><b data-n>0</b>/300</span></span><textarea class="textarea wb-fm-au-t" maxlength="300" placeholder="请输入备注内容" rows="2"></textarea></label>
    <label class="field"><span class="wb-fm-lab"><span class="field__label">售后说明</span><span class="wb-fm-cnt"><b data-n>0</b>/300</span></span><textarea class="textarea wb-fm-au-t" maxlength="300" placeholder="请输入售后说明" rows="2">收到的玫瑰花束有三枝花头发蔫。
已拍照留存，花头状态见附图。
希望补发三枝同色玫瑰，或按比例退还差价。
联系人为林晓，下午三点后方便接听电话。
补发请与同城配送一起送达，附上原订单号。</textarea></label>
  </div></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const pad = n => String(n).padStart(2, '0');
  const mk = n => `../../kit/assets/marks/mark-${n}.webp`;
  const CHECK = '<img src="../../kit/assets/line/check.webp" alt="">';
  const hl = (t, k) => (k ? t.replace(k, m => `<mark>${m}</mark>`) : t);
  const MEM = [['林晓', '店长', '建国路店', '003'], ['陈默', '店长', '徐汇滨江店', '015'], ['周岚', '店长', '浦东世纪店', '009'], ['吴桐', '花艺师', '建国路店', '012'],
    ['郑一', '花艺师', '徐汇滨江店', '008'], ['王宁', '花艺师', '浦东世纪店', '023'], ['赵悦', '客服', '总部', '005'], ['孙洁', '客服', '总部', '018']];
  const avatar = m => `<img class="avatar avatar--mark" src="${mk(m[3])}" alt="">`;

  /* 选择层共用：开合、点外面关闭、Escape 关闭并回到触发框、Tab 离开即关闭；与已有选择层互斥 */
  const mkpick = (pick, trigger, hooks = {}) => {
    const pop = $(':scope > .wb-fm-pop', pick);
    const open = o => {
      if (o === (pick.dataset.open === 'true')) return;
      pick.dataset.open = String(o); trigger.setAttribute('aria-expanded', String(o)); pop.inert = !o;
      if (o) {
        $$('#cat-form .wb-fm-pick[data-open="true"]').forEach(p => { if (p !== pick && p._open) p._open(false); });
        $$('#cat-form .drop[data-open="true"]').forEach(d => { d.dataset.open = 'false'; });
        if (hooks.open) hooks.open();
      } else if (hooks.close) hooks.close();
    };
    pick._open = open;
    trigger.addEventListener('click', e => { e.stopPropagation(); open(pick.dataset.open !== 'true'); });
    pop.addEventListener('click', e => e.stopPropagation());
    document.addEventListener('click', () => open(false));
    pick.addEventListener('keydown', e => { if (e.key === 'Escape' && pick.dataset.open === 'true') { e.stopPropagation(); open(false); trigger.focus(); } });
    pick.addEventListener('focusout', e => { if (e.relatedTarget && !pick.contains(e.relatedTarget)) open(false); });
    return open;
  };
  /* 重绘列表时保住键盘焦点与滚动位置：可聚焦元素带 data-fk */
  const keep = (box, fn) => {
    const a = document.activeElement, key = a && box.contains(a) ? a.dataset.fk : null, top = box.scrollTop;
    fn(); box.scrollTop = top;
    if (key) { const e = $(`[data-fk="${CSS.escape(key)}"]`, box); if (e && !e.disabled) e.focus({ preventScroll: true }); }
  };
  const field = el => el.closest('.field');
  const say = (el, msg) => { const f = field(el), g = $('.wb-fm-group, .input, .textarea', f), e = $('.field__err', f); if (g) g.setAttribute('aria-invalid', String(!!msg)); if (e) { if (msg) e.textContent = msg; e.hidden = !msg; } };

  /* 033 搜索多选面板：分组、搜索、全选本组、最多五人 */
  (() => {
    const root = $('#wb-fm-ms'), pick = $('.wb-fm-pick', root), ctl = $('.wb-fm-ctl', pick), q = $('input', pick), list = $('.wb-fm-ms-list', pick), chosen = $('.wb-fm-ms-chosen', root);
    const cnt = $('[data-n]', root), sum = $('[data-sum]', pick), MAX = 5, sel = new Set(['林晓', '吴桐']);
    const paint = () => {
      const arr = MEM.filter(m => sel.has(m[0]));
      cnt.textContent = arr.length; sum.textContent = `已选 ${arr.length} 人${arr.length >= MAX ? '，已达上限' : ''}`;
      ctl.innerHTML = arr.length ? `<span class="wb-fm-ms-sum"><span class="avatars">${arr.slice(0, 3).map(avatar).join('')}</span><span>已选 ${arr.length} 人</span></span>` : '<span class="wb-fm-ph">请选择成员</span>';
      chosen.innerHTML = arr.map(m => `<span class="wb-fm-chip wb-fm-chip--tag">${m[0]}<button type="button" class="wb-fm-x" data-n="${m[0]}" data-tip="移除${m[0]}" aria-label="移除${m[0]}"><img src="../../kit/assets/line/close.webp" alt=""></button></span>`).join('');
    };
    const draw = () => keep(list, () => {
      const k = q.value.trim(), full = sel.size >= MAX; let html = '';
      ['店长', '花艺师', '客服'].forEach(g => {
        const rows = MEM.filter(m => m[1] === g && (!k || (m[0] + m[1] + m[2]).includes(k))); if (!rows.length) return;
        const all = rows.every(m => sel.has(m[0]));
        html += `<div role="group" aria-label="${g}"><div class="wb-fm-ms-gh"><span>${g}</span><button type="button" class="wb-fm-ms-gt" data-g="${g}" data-fk="g:${g}">${all ? '取消全选' : '全选'}</button></div>` + rows.map(m => `<button type="button" class="wb-fm-ms-row" role="option" tabindex="-1" aria-selected="${sel.has(m[0])}" data-n="${m[0]}" data-fk="n:${m[0]}"${full && !sel.has(m[0]) ? ' disabled' : ''}><span class="check" aria-checked="${sel.has(m[0])}" aria-hidden="true">${CHECK}</span>${avatar(m)}<span class="wb-fm-ms-nm">${hl(m[0], k)}</span><small>${m[2]}</small></button>`).join('') + '</div>';
      });
      list.innerHTML = html || '<p class="wb-fm-none">没有匹配的成员</p>';
    });
    const open = mkpick(pick, ctl, { open: () => { q.value = ''; draw(); setTimeout(() => q.focus(), 40); } });
    list.addEventListener('click', e => {
      const r = e.target.closest('.wb-fm-ms-row'), g = e.target.closest('.wb-fm-ms-gt');
      if (r) { const n = r.dataset.n; if (sel.has(n)) sel.delete(n); else if (sel.size < MAX) sel.add(n); }
      else if (g) { const rows = MEM.filter(m => m[1] === g.dataset.g && (!q.value.trim() || (m[0] + m[1] + m[2]).includes(q.value.trim()))); if (rows.every(m => sel.has(m[0]))) rows.forEach(m => sel.delete(m[0])); else rows.forEach(m => { if (sel.size < MAX) sel.add(m[0]); }); }
      else return;
      paint(); draw();
    });
    chosen.addEventListener('click', e => { const x = e.target.closest('[data-n]'); if (x) { sel.delete(x.dataset.n); paint(); if (pick.dataset.open === 'true') draw(); } });
    q.addEventListener('input', draw);
    $('[data-clear]', pick).addEventListener('click', () => { sel.clear(); paint(); draw(); });
    $('[data-done]', pick).addEventListener('click', () => { open(false); ctl.focus(); });
    ctl.addEventListener('keydown', e => { if (e.key === 'ArrowDown' && pick.dataset.open !== 'true') { e.preventDefault(); open(true); } });
    pick.addEventListener('keydown', e => {
      if (!['ArrowDown', 'ArrowUp'].includes(e.key) || pick.dataset.open !== 'true') return;
      const rows = $$('.wb-fm-ms-row:not(:disabled)', list); if (!rows.length) return;
      if (e.target === q) { if (e.key === 'ArrowDown') { e.preventDefault(); rows[0].focus(); } return; }
      const i = rows.indexOf(document.activeElement); if (i < 0) return; e.preventDefault();
      if (e.key === 'ArrowDown') rows[Math.min(rows.length - 1, i + 1)].focus(); else if (i === 0) q.focus(); else rows[i - 1].focus();
    });
    paint(); draw();
  })();

  /* 月历：日期选择框与日期时间选择器共用 */
  const TODAY = (() => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), d.getDate()); })();
  const day0 = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
  const ymd = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const sameDay = (a, b) => !!a && !!b && ymd(a) === ymd(b);
  const parseDay = s => { const m = String(s).trim().match(/^(\d{4})[-\/.年]?(\d{1,2})[-\/.月]?(\d{1,2})日?$/); if (!m) return null; const d = new Date(+m[1], +m[2] - 1, +m[3]); return d.getMonth() === +m[2] - 1 && d.getDate() === +m[3] ? d : null; };
  const makeCal = (host, o) => {
    let view = new Date(TODAY.getFullYear(), TODAY.getMonth(), 1), sel = null, fd = null, mode = 'day';
    host.innerHTML = '<div class="wb-fm-cal__bar"><button type="button" class="wb-fm-cal__n" data-nav="-1"></button><button type="button" class="wb-fm-cal__t" aria-live="polite"></button><button type="button" class="wb-fm-cal__n wb-fm-cal__n--r" data-nav="1"></button></div><div class="wb-fm-cal__body"></div><div class="wb-fm-cal__foot"><button type="button" class="btn btn--text btn--sm" data-a="clear">清除</button><button type="button" class="btn btn--text btn--sm" data-a="now">回到当月</button></div>';
    const ttl = $('.wb-fm-cal__t', host), body = $('.wb-fm-cal__body', host), [prev, next] = $$('.wb-fm-cal__n', host);
    const draw = () => {
      const y = view.getFullYear(), m = view.getMonth(), min = o.minDay && o.minDay(), nm = mode === 'day' ? ['上一月', '下一月'] : ['上一年', '下一年'];
      ttl.textContent = mode === 'day' ? `${y} 年 ${m + 1} 月` : `${y} 年`; ttl.setAttribute('aria-label', mode === 'day' ? `${y} 年 ${m + 1} 月，切换到选月份` : `${y} 年，切换到选日期`);
      [prev, next].forEach((b, i) => { b.setAttribute('aria-label', nm[i]); b.dataset.tip = nm[i]; });
      if (mode === 'month') {
        body.innerHTML = '<div class="wb-fm-cal__m">' + Array.from({ length: 12 }, (_, i) => `<button type="button" class="wb-fm-cal__mi" data-m="${i}" aria-pressed="${i === m}">${i + 1} 月</button>`).join('') + '</div>'; return;
      }
      const first = new Date(y, m, 1), start = addDays(first, -((first.getDay() + 6) % 7));
      const inView = d => d && d.getFullYear() === y && d.getMonth() === m;
      const f = inView(fd) ? fd : inView(sel) ? sel : inView(TODAY) ? TODAY : first;
      let h = '<div class="wb-fm-cal__wk">' + [...'一二三四五六日'].map(w => `<span>${w}</span>`).join('') + '</div><div class="wb-fm-cal__g">';
      for (let i = 0; i < 42; i++) {
        const d = addDays(start, i), off = min && d < min;
        h += `<button type="button" class="wb-fm-cal__d" data-d="${ymd(d)}" aria-label="${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日" aria-pressed="${sameDay(d, sel)}" tabindex="${sameDay(d, f) ? 0 : -1}"${d.getMonth() !== m ? ' data-out="true"' : ''}${sameDay(d, TODAY) ? ' data-now="true"' : ''}${off ? ' disabled' : ''}>${d.getDate()}</button>`;
      }
      body.innerHTML = h + '</div>';
    };
    const focusDay = d => { const b = $(`[data-d="${ymd(d)}"]`, body); if (b) b.focus(); };
    host.addEventListener('click', e => {
      const n = e.target.closest('[data-nav]'), t = e.target.closest('.wb-fm-cal__t'), d = e.target.closest('.wb-fm-cal__d'), mi = e.target.closest('.wb-fm-cal__mi'), a = e.target.closest('[data-a]');
      if (n) { view = mode === 'day' ? new Date(view.getFullYear(), view.getMonth() + +n.dataset.nav, 1) : new Date(view.getFullYear() + +n.dataset.nav, view.getMonth(), 1); fd = null; draw(); }
      else if (t) { mode = mode === 'day' ? 'month' : 'day'; draw(); }
      else if (mi) { view = new Date(view.getFullYear(), +mi.dataset.m, 1); mode = 'day'; fd = null; draw(); }
      else if (d) o.onPick(parseDay(d.dataset.d));
      else if (a && a.dataset.a === 'clear') o.onPick(null);
      else if (a) { view = new Date(TODAY.getFullYear(), TODAY.getMonth(), 1); mode = 'day'; fd = null; draw(); }
    });
    body.addEventListener('keydown', e => {
      const b = e.target.closest('.wb-fm-cal__d'); if (!b) return;
      const d = parseDay(b.dataset.d), dim = (y, m) => new Date(y, m + 1, 0).getDate(); let nd = null;
      const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key];
      if (step) nd = addDays(d, step);
      else if (e.key === 'PageUp' || e.key === 'PageDown') { const s = e.key === 'PageUp' ? -1 : 1, ym = new Date(d.getFullYear(), d.getMonth() + s, 1); nd = new Date(ym.getFullYear(), ym.getMonth(), Math.min(d.getDate(), dim(ym.getFullYear(), ym.getMonth()))); }
      else if (e.key === 'Home') nd = addDays(d, -((d.getDay() + 6) % 7)); else if (e.key === 'End') nd = addDays(d, 6 - ((d.getDay() + 6) % 7));
      if (!nd) return; e.preventDefault();
      const min = o.minDay && o.minDay(); if (min && nd < min) return;
      fd = nd; view = new Date(nd.getFullYear(), nd.getMonth(), 1); draw(); focusDay(nd);
    });
    draw();
    return { set(d) { sel = d ? day0(d) : null; if (sel) { view = new Date(sel.getFullYear(), sel.getMonth(), 1); fd = sel; } mode = 'day'; draw(); }, refresh: draw, focusIn() { const b = $('.wb-fm-cal__d[tabindex="0"]', body); if (b) b.focus(); } };
  };

  /* 034 039 日期与日期时间字段：直接输入、月历选择、时分列、校验与联动 */
  const dateField = (pick, o) => {
    const input = $('input', pick), link = $('.wb-fm-link', pick), pop = $('.wb-fm-pop', pick), time = !!o.time; let val = null, cal, hc, mc;
    if (time) {
      pop.innerHTML = '<div class="wb-fm-dt-body"><div class="wb-fm-dt-cal"></div><div class="wb-fm-dt-time"><div class="wb-fm-dt-w"><div class="wb-fm-dt-th">时</div><div class="wb-fm-dt-col" role="listbox" aria-label="小时" data-k="h"></div></div><div class="wb-fm-dt-w"><div class="wb-fm-dt-th">分</div><div class="wb-fm-dt-col" role="listbox" aria-label="分钟" data-k="m"></div></div></div></div>';
      hc = $('[data-k="h"]', pop); mc = $('[data-k="m"]', pop);
      const col = (n, c) => { c.innerHTML = Array.from({ length: n }, (_, i) => `<button type="button" class="wb-fm-dt-i" role="option" data-v="${i}" aria-selected="false">${pad(i)}</button>`).join(''); };
      col(24, hc); col(60, mc);
    }
    const fmt = v => (v ? ymd(v) + (time ? ` ${pad(v.getHours())}:${pad(v.getMinutes())}` : '') : '');
    const parseVal = s => {
      if (!time) return parseDay(s);
      const m = String(s).trim().match(/^(\S+)\s+(\d{1,2})[:：时](\d{1,2})分?$/); if (!m) return null;
      const d = parseDay(m[1]); if (!d || +m[2] > 23 || +m[3] > 59) return null; d.setHours(+m[2], +m[3]); return d;
    };
    const mark = () => { if (!time) return; [[hc, val && val.getHours()], [mc, val && val.getMinutes()]].forEach(([c, v]) => { $$('.wb-fm-dt-i', c).forEach(b => b.setAttribute('aria-selected', String(v !== null && v !== undefined && +b.dataset.v === v))); }); };
    const scrollTime = () => { if (!time) return; [hc, mc].forEach(c => { const s = $('[aria-selected="true"]', c); c.scrollTop = s ? s.offsetTop - c.clientHeight / 2 + s.offsetHeight / 2 : 0; }); };
