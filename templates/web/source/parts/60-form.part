    $$('.wb-fm-pick', root).forEach((pick, idx) => {
      const ctl = $('.wb-fm-ctl', pick), svh = $('.wb-fm-cp-sv', pick), hueh = $('.wb-fm-cp-hue', pick), svc = mkCanvas(svh, 264, 152), huec = mkCanvas(hueh, 264, 14);
      const hdS = $('.wb-fm-cp-hd', svh), hdH = $('.wb-fm-cp-hd', hueh), inp = $('.wb-fm-cp-in', pick), pv = $('.wb-fm-cp-pv', pick), sws = $('.wb-fm-cp-sws', pick), sw = $('.wb-fm-cp-sw', pick), tx = $('.wb-fm-cp-v', pick);
      let H = 0, S = 1, V = 1, lastH = -1;
      const fill = (c, fn) => { const x = c.getContext('2d'), im = x.createImageData(c.width, c.height); for (let j = 0; j < c.height; j++) for (let i = 0; i < c.width; i++) { const p = fn(i / (c.width - 1), j / (c.height - 1)), k = (j * c.width + i) * 4; im.data[k] = p[0]; im.data[k + 1] = p[1]; im.data[k + 2] = p[2]; im.data[k + 3] = 255; } x.putImageData(im, 0, 0); };
      fill(huec, x => hsv2rgb(x * 360, 1, 1));
      sws.innerHTML = swatches.map(([n, h]) => `<button type="button" class="wb-fm-cp-s" role="radio" aria-checked="false" data-hex="${h}" data-tip="${n}" aria-label="选用${n}"></button>`).join('');
      $$('.wb-fm-cp-s', sws).forEach(b => b.style.setProperty('--c', '#' + b.dataset.hex));
      const paint = (fromInput) => {
        const rgb = hsv2rgb(H, S, V), hex = toHex(rgb), cs = '#' + hex;
        if (H !== lastH) { fill(svc, (x, y) => hsv2rgb(H, x, 1 - y)); lastH = H; }
        svh.style.setProperty('--c', cs); hueh.style.setProperty('--c', '#' + toHex(hsv2rgb(H, 1, 1))); pick.style.setProperty('--c', cs);
        hdS.style.left = S * 100 + '%'; hdS.style.top = (1 - V) * 100 + '%'; hdH.style.left = H / 360 * 100 + '%';
        svh.setAttribute('aria-valuetext', `饱和度 ${Math.round(S * 100)}，明度 ${Math.round(V * 100)}`); hueh.setAttribute('aria-valuenow', Math.round(H)); hueh.setAttribute('aria-valuetext', `${Math.round(H)} 度`);
        $$('.wb-fm-cp-sw, .wb-fm-cp-pv', pick).forEach(e => e.style.setProperty('--c', cs)); tx.textContent = '#' + hex;
        if (!fromInput) { inp.value = hex; say(inp, ''); }
        $$('.wb-fm-cp-s', sws).forEach(b => b.setAttribute('aria-checked', String(b.dataset.hex === hex)));
        const on = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) / 255 > 0.62 ? 'light' : 'dark';
        exs[idx].forEach(e => { e.style.setProperty('--c', cs); e.dataset.on = on; });
      };
      const setRgb = (rgb, fromInput) => { const [h, s, v] = rgb2hsv(rgb); if (s > 0.001 && v > 0.001) H = h; S = s; V = v; paint(fromInput); };
      drag(svh, (x, y) => { S = x; V = 1 - y; paint(); });
      drag(hueh, x => { H = x * 360; paint(); });
      svh.addEventListener('keydown', e => { const st = e.shiftKey ? 0.1 : 0.02, d = { ArrowLeft: [-st, 0], ArrowRight: [st, 0], ArrowUp: [0, st], ArrowDown: [0, -st] }[e.key]; if (!d) return; e.preventDefault(); S = Math.min(1, Math.max(0, S + d[0])); V = Math.min(1, Math.max(0, V + d[1])); paint(); });
      hueh.addEventListener('keydown', e => { const st = e.shiftKey ? 15 : 2, d = { ArrowLeft: -st, ArrowDown: -st, ArrowRight: st, ArrowUp: st }[e.key]; if (!d) return; e.preventDefault(); H = Math.min(360, Math.max(0, H + d)); paint(); });
      sws.addEventListener('click', e => { const b = e.target.closest('.wb-fm-cp-s'); if (b) setRgb(fromHex(b.dataset.hex)); });
      inp.addEventListener('input', () => { inp.value = inp.value.replace(/[^0-9a-fA-F#]/g, '').slice(0, 7); const rgb = fromHex(inp.value); if (rgb) { say(inp, ''); setRgb(rgb, true); } else if (inp.getAttribute('aria-invalid') === 'true') say(inp, '请输入 6 位十六进制色值'); });
      inp.addEventListener('blur', () => { const rgb = fromHex(inp.value); if (!rgb) { say(inp, inp.value ? '请输入 6 位十六进制色值' : ''); if (!inp.value) inp.value = toHex(hsv2rgb(H, S, V)); } else inp.value = toHex(rgb); });
      inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); inp.blur(); } });
      mkpick(pick, ctl);
      setRgb(tok(pick.dataset.tok));
    });
  })();

  /* 042 命令搜索面板：就近内嵌，分组、高亮、上下选择、回车执行；快捷键只作用于视野内的这一块 */
  (() => {
    const root = $('#wb-fm-cmd'), q = $('input', root), list = $('.wb-fm-cmd-list', root);
    const IT = [['页面', '工作台', 'home', '总览', '首页'], ['页面', '商品列表', 'list', '商品管理', '上架 库存'], ['页面', '订单管理', 'archive', '订单管理', '发货 物流'], ['页面', '会员中心', 'people', '会员', '客户 积分'], ['快捷动作', '新建商品', 'file-add', '商品管理', '添加 上新'], ['快捷动作', '导出订单', 'upload', '订单管理', '下载 表格'], ['快捷动作', '发放优惠券', 'message', '营销中心', '满减 券'], ['快捷动作', '暂停营业', 'pause', '门店设置', '打烊 休息']];
    let rows = [], act = 0;
    const draw = () => {
      const k = q.value.trim(); rows = IT.filter(x => !k || (x[1] + x[3] + x[4]).includes(k)); act = Math.min(act, Math.max(0, rows.length - 1)); let html = '', last = '';
      rows.forEach((x, i) => {
        if (x[0] !== last) { html += `<div class="wb-fm-cmd-gh" role="presentation">${x[0]}</div>`; last = x[0]; }
        html += `<button type="button" class="wb-fm-cmd-i" role="option" id="wb-fm-cmd-o${i}" data-i="${i}" aria-selected="${i === act}" tabindex="-1"><img src="../../kit/assets/line/${x[2]}.webp" alt=""><span>${hl(x[1], k)}</span><small>${x[3]}</small></button>`;
      });
      list.innerHTML = html || '<p class="wb-fm-none">没有匹配的页面或动作</p>'; q.setAttribute('aria-activedescendant', rows.length ? `wb-fm-cmd-o${act}` : '');
    };
    const mark = () => { $$('.wb-fm-cmd-i', list).forEach((b, i) => b.setAttribute('aria-selected', String(i === act))); q.setAttribute('aria-activedescendant', `wb-fm-cmd-o${act}`); const a = $(`#wb-fm-cmd-o${act}`, list); if (a) a.scrollIntoView({ block: 'nearest' }); };
    const run = async i => {
      const x = rows[i]; if (!x) return;
      if (x[1] === '暂停营业') { if (await Lz.confirm({ title: '暂停营业', ok: '暂停', tone: 'danger' })) Lz.toast('已暂停营业', 'success'); return; }
      Lz.toast(x[0] === '页面' ? `已打开${x[1]}` : `已执行${x[1]}`, 'success');
    };
    q.addEventListener('input', () => { act = 0; draw(); });
    q.addEventListener('keydown', e => {
      if (e.isComposing) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); if (rows.length) { act = (act + (e.key === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length; mark(); } }
      else if (e.key === 'Enter') { e.preventDefault(); run(act); }
      else if (e.key === 'Escape') { if (q.value) { q.value = ''; act = 0; draw(); } else q.blur(); }
    });
    list.addEventListener('mousemove', e => { const b = e.target.closest('.wb-fm-cmd-i'); if (b && +b.dataset.i !== act) { act = +b.dataset.i; mark(); } });
    list.addEventListener('click', e => { const b = e.target.closest('.wb-fm-cmd-i'); if (b) { act = +b.dataset.i; mark(); run(act); q.focus(); } });
    document.addEventListener('keydown', e => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { const r = root.getBoundingClientRect(); if (r.bottom > 0 && r.top < innerHeight) { e.preventDefault(); q.focus(); q.select(); } }
    });
    draw();
  })();

  /* 043 图片裁剪框：拖动与四角缩放，比例锁定，方向键与加减键微调，实时预览，可重新选图 */
  (() => {
    const root = $('#wb-fm-crop'), wrap = $('.wb-fm-crop-wrap', root), st = $('[data-st]', root), img = $('img', st), fr = $('[data-fr]', st), file = $('input[type="file"]', root);
    const pvR = $('[data-pv="r"]', root), pvC = $('[data-pv="c"]', root), size = $('[data-size]', root), state = $('[data-state]', root), seg = $$('[data-r]', root), MAXH = 340, MIN = 56;
    let SW = 0, SH = 0, R = 1, F = { x: 0, y: 0, w: 0, h: 0 }, Q = { x: 0, y: 0, w: 0 }, url = null;
    const sync = () => { Q = { x: F.x / SW, y: F.y / SH, w: F.w / SW }; };
    const place = () => { fr.style.left = Math.round(F.x) + 'px'; fr.style.top = Math.round(F.y) + 'px'; fr.style.width = Math.round(F.w) + 'px'; fr.style.height = Math.round(F.h) + 'px'; };
    const preview = () => {
      const sc = img.naturalWidth / SW, s = Math.min(F.w, F.h), set = (el, x, y, w, h, ph) => { const k = ph / h; el.style.width = w * k + 'px'; el.style.height = ph + 'px'; el.style.backgroundImage = `url("${img.currentSrc || img.src}")`; el.style.backgroundSize = `${SW * k}px ${SH * k}px`; el.style.backgroundPosition = `${-x * k}px ${-y * k}px`; };
      set(pvR, F.x, F.y, F.w, F.h, 64); set(pvC, F.x + (F.w - s) / 2, F.y + (F.h - s) / 2, s, s, 64);
      size.textContent = `${Math.round(F.w * sc)}×${Math.round(F.h * sc)} 像素`; if (state.dataset.done) { delete state.dataset.done; state.textContent = '拖动框选区域'; }
    };
    const fit = () => {
      const maxW = Math.min(SW, SH * R); F.w = Math.min(Math.max(F.w, MIN), maxW); F.h = F.w / R;
      F.x = Math.min(Math.max(F.x, 0), SW - F.w); F.y = Math.min(Math.max(F.y, 0), SH - F.h); place(); preview();
    };
    const reset = () => { const w = Math.min(SW, SH * R) * 0.72; F = { x: 0, y: 0, w, h: w / R }; F.x = (SW - F.w) / 2; F.y = (SH - F.h) / 2; place(); preview(); sync(); };
    const layout = () => {
      if (!img.naturalWidth) return; const W = wrap.clientWidth, r = img.naturalWidth / img.naturalHeight; let w = W, h = W / r; if (h > MAXH) { h = MAXH; w = h * r; }
      const ow = SW; if (ow && Math.abs(ow - w) < 0.5) return;
      SW = w; SH = h; st.style.width = w + 'px'; st.style.height = h + 'px';
      if (ow) { F = { x: Q.x * SW, y: Q.y * SH, w: Q.w * SW, h: Q.w * SW / R }; fit(); } else reset();
    };
    img.addEventListener('load', () => { SW = 0; layout(); });
    if (img.complete) layout();
    addEventListener('resize', layout);
    let drag = null;
    fr.addEventListener('pointerdown', e => {
      e.preventDefault(); fr.focus(); fr.setPointerCapture(e.pointerId); const rc = st.getBoundingClientRect(), h = e.target.closest('[data-h]');
      if (h) { const k = h.dataset.h, sx = k.includes('e') ? 1 : -1, sy = k.includes('s') ? 1 : -1; drag = { k: 'size', sx, sy, ax: sx > 0 ? F.x : F.x + F.w, ay: sy > 0 ? F.y : F.y + F.h, rc }; }
      else drag = { k: 'move', dx: e.clientX - rc.left - F.x, dy: e.clientY - rc.top - F.y, rc };
    });
    fr.addEventListener('pointermove', e => {
      if (!drag) return; const px = e.clientX - drag.rc.left, py = e.clientY - drag.rc.top;
      if (drag.k === 'move') { F.x = Math.min(Math.max(px - drag.dx, 0), SW - F.w); F.y = Math.min(Math.max(py - drag.dy, 0), SH - F.h); }
      else { const maxW = Math.min(drag.sx > 0 ? SW - drag.ax : drag.ax, (drag.sy > 0 ? SH - drag.ay : drag.ay) * R); const w = Math.min(Math.max(drag.sx * (px - drag.ax), MIN), maxW), h = w / R; F = { w, h, x: drag.sx > 0 ? drag.ax : drag.ax - w, y: drag.sy > 0 ? drag.ay : drag.ay - h }; }
      place(); preview(); sync();
    });
    ['pointerup', 'pointercancel'].forEach(t => fr.addEventListener(t, () => { drag = null; }));
    const zoom = k => { const cx = F.x + F.w / 2, cy = F.y + F.h / 2, w = Math.min(Math.max(F.w * (k > 0 ? 1.12 : 0.89), MIN), Math.min(SW, SH * R)); F = { w, h: w / R, x: cx - w / 2, y: cy - w / R / 2 }; fit(); sync(); };
    $$('[data-z]', root).forEach(b => b.addEventListener('click', () => zoom(+b.dataset.z)));
    fr.addEventListener('keydown', e => {
      const d = { ArrowLeft: [-8, 0], ArrowRight: [8, 0], ArrowUp: [0, -8], ArrowDown: [0, 8] }[e.key];
      if (d) { e.preventDefault(); F.x = Math.min(Math.max(F.x + d[0], 0), SW - F.w); F.y = Math.min(Math.max(F.y + d[1], 0), SH - F.h); place(); preview(); sync(); }
      else if (e.key === '+' || e.key === '=') { e.preventDefault(); zoom(1); } else if (e.key === '-') { e.preventDefault(); zoom(-1); }
    });
    seg.forEach(b => b.addEventListener('click', () => { seg.forEach(x => x.setAttribute('aria-checked', String(x === b))); R = +b.dataset.r; reset(); }));
    $('[data-pick]', root).addEventListener('click', () => file.click());
    file.addEventListener('change', () => {
      const f = file.files[0]; file.value = ''; if (!f) return;
      if (!f.type.startsWith('image/')) { Lz.toast('仅支持图片文件', 'danger'); return; }
      if (url) URL.revokeObjectURL(url); url = URL.createObjectURL(f); img.src = url;
    });
    $('[data-ok]', root).addEventListener('click', () => { state.dataset.done = '1'; state.textContent = '已完成裁剪'; Lz.toast(`已裁剪，${size.textContent}`, 'success'); });
  })();

  /* 044 提及输入框：输入艾特弹出成员，边输入边筛选，方向键与回车选取，已提及成员显示成标签 */
  (() => {
    const root = $('#wb-fm-mn'), box = $('.wb-fm-mn-box', root), ta = $('textarea', box), pop = $('.wb-fm-mn-pop', box), chips = $('.wb-fm-mn-foot .wb-fm-chips', root), send = $('[data-send]', root), feed = $('.wb-fm-mn-feed', root), cnt = $('[data-n]', root);
    let at = -1, rows = [], act = 0;
    const caret = pos => {
      const cs = getComputedStyle(ta), m = document.createElement('div');
      ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft', 'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth', 'boxSizing'].forEach(k => { m.style[k] = cs[k]; });
      m.style.cssText += `;position:absolute;top:0;left:0;visibility:hidden;white-space:pre-wrap;overflow-wrap:break-word;width:${ta.offsetWidth}px`;
      m.textContent = ta.value.slice(0, pos); const s = document.createElement('span'); s.textContent = '​'; m.appendChild(s); box.appendChild(m);
      const r = { x: s.offsetLeft - ta.scrollLeft, y: s.offsetTop - ta.scrollTop }; m.remove(); return r;
    };
    const close = () => { at = -1; pop.dataset.open = 'false'; ta.setAttribute('aria-expanded', 'false'); };
    const show = q => {
      rows = MEM.filter(m => !q || (m[0] + m[1]).includes(q)); act = 0;
      if (!rows.length) { close(); return; }
      pop.innerHTML = rows.map((m, i) => `<button type="button" class="wb-fm-ms-row" role="option" aria-selected="${i === act}" data-i="${i}">${avatar(m)}<span class="wb-fm-ms-nm">${hl(m[0], q)}</span><small>${m[1]}</small></button>`).join('');
      const p = caret(ta.selectionStart), lh = parseFloat(getComputedStyle(ta).lineHeight) || 22;
      pop.style.left = Math.max(0, Math.min(p.x, box.clientWidth - pop.offsetWidth)) + 'px'; pop.style.top = Math.min(p.y + lh + 6, ta.offsetHeight + 4) + 'px';
      pop.dataset.open = 'true'; ta.setAttribute('aria-expanded', 'true');
    };
    const scan = () => {
      const up = ta.value.slice(0, ta.selectionStart), m = up.match(/(?:^|\s)@([^\s@]{0,8})$/);
      if (!m) { close(); return; } at = up.length - m[1].length - 1; show(m[1]);
    };
    const mark = () => { $$('.wb-fm-ms-row', pop).forEach((b, i) => b.setAttribute('aria-selected', String(i === act))); const a = $$('.wb-fm-ms-row', pop)[act]; if (a) a.scrollIntoView({ block: 'nearest' }); };
    const pickRow = i => {
      const m = rows[i]; if (!m || at < 0) return; const end = ta.selectionStart, ins = `@${m[0]} `;
      ta.value = ta.value.slice(0, at) + ins + ta.value.slice(end); ta.selectionStart = ta.selectionEnd = at + ins.length; close(); ta.focus(); sync();
    };
    const names = () => MEM.filter(m => ta.value.includes(`@${m[0]}`)).map(m => m[0]);
    const sync = () => {
      cnt.textContent = ta.value.length; send.disabled = !ta.value.trim();
      chips.innerHTML = names().map(n => `<span class="wb-fm-chip wb-fm-chip--tag">@${n}<button type="button" class="wb-fm-x" data-n="${n}" data-tip="取消提及${n}" aria-label="取消提及${n}"><img src="../../kit/assets/line/close.webp" alt=""></button></span>`).join('');
    };
    ta.addEventListener('input', e => { if (e.isComposing) return; sync(); scan(); });
    ta.addEventListener('compositionend', () => { sync(); scan(); });
    ta.addEventListener('click', scan);
    ta.addEventListener('keyup', e => { if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) scan(); });
    ta.addEventListener('blur', () => setTimeout(close, 120));
    ta.addEventListener('keydown', e => {
      if (e.isComposing || pop.dataset.open !== 'true') return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); act = (act + (e.key === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length; mark(); }
      else if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); pickRow(act); }
      else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); }
    });
    pop.addEventListener('mousedown', e => e.preventDefault());
    pop.addEventListener('click', e => { const b = e.target.closest('.wb-fm-ms-row'); if (b) pickRow(+b.dataset.i); });
    chips.addEventListener('click', e => { const x = e.target.closest('[data-n]'); if (!x) return; ta.value = ta.value.split(`@${x.dataset.n} `).join('').split(`@${x.dataset.n}`).join(''); sync(); ta.focus(); });
    send.addEventListener('click', () => {
      const text = ta.value.trim(); if (!text) return; const nm = names().sort((a, b) => b.length - a.length);
      const p = document.createElement('p'); let rest = text;
      while (rest) {
        const hit = nm.map(n => [rest.indexOf(`@${n}`), n]).filter(x => x[0] >= 0).sort((a, b) => a[0] - b[0])[0];
        if (!hit) { p.appendChild(document.createTextNode(rest)); break; }
        if (hit[0] > 0) p.appendChild(document.createTextNode(rest.slice(0, hit[0])));
        const s = document.createElement('span'); s.className = 'wb-fm-mn-at'; s.textContent = `@${hit[1]}`; p.appendChild(s); rest = rest.slice(hit[0] + hit[1].length + 1);
      }
      const c = document.createElement('div'); c.className = 'wb-fm-mn-c'; c.innerHTML = `${avatar(MEM[3])}<div><div><b>${MEM[3][0]}</b><small>刚刚</small></div></div>`; c.lastChild.appendChild(p); feed.prepend(c);
      ta.value = ''; sync(); close(); Lz.toast('已发表', 'success');
    });
    sync();
  })();

  /* 045 自适应文本域：随内容增高，最多六行，再多则内部滚动 */
  (() => {
    const root = $('#wb-fm-au'), MAX = 6;
    const fit = t => {
      const cs = getComputedStyle(t), lh = parseFloat(cs.lineHeight), bd = t.offsetHeight - t.clientHeight, pd = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom), max = lh * MAX + pd + bd;
      t.style.height = 'auto'; const h = t.scrollHeight + bd; t.style.height = Math.min(h, max) + 'px'; t.style.overflowY = h > max + 1 ? 'auto' : 'hidden';
    };
    $$('textarea', root).forEach(t => { t.addEventListener('input', () => fit(t)); fit(t); if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => fit(t)); });
    addEventListener('resize', () => $$('textarea', root).forEach(fit));
  })();
})();
</script>
