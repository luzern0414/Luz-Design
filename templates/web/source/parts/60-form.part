  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-in">
    <div class="wb-fm-inline"><label class="field__label" for="wb-fm-in-c">优惠券码</label><input class="input" id="wb-fm-in-c" inputmode="numeric" maxlength="6" placeholder="请输入 6 位券码" autocomplete="off"><button type="button" class="btn btn--primary" data-go>核销</button><span class="field__err" hidden></span></div>
    <div class="wb-fm-result" aria-live="polite"></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-028" data-name="登录表单" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">登录表单</span></div>
  <p class="demo__note">适合：后台账号登录，错误提示贴近输入</p>
  <div class="demo__stage"><form class="card wb-fm-card wb-fm-login" id="wb-fm-lg" novalidate>
    <div class="wb-fm-login__top"><img data-ic="bouquet" src="../../kit/assets/icons/flat/bouquet.webp" alt=""><h3>账号登录</h3></div>
    <div class="wb-fm-stack">
      <div class="wb-fm-alert" role="alert" hidden>账号或密码不正确</div>
      <label class="field"><span class="field__label">手机号</span><input class="input" data-k="a" inputmode="numeric" maxlength="11" placeholder="请输入手机号" autocomplete="off"><span class="field__err" hidden>请输入 11 位手机号</span></label>
      <label class="field"><span class="field__label">密码</span><span class="wb-fm-group field-shell"><input class="input" data-k="w" type="password" placeholder="请输入密码" autocomplete="off"><button type="button" class="wb-fm-link" data-show aria-pressed="false">显示</button></span><span class="field__err" hidden>请输入密码</span></label>
      <div class="wb-fm-opts"><span class="wb-fm-ck" role="checkbox" aria-checked="true" aria-label="记住登录"><span class="check" aria-checked="true" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span>记住登录</span><button type="button" class="btn btn--text btn--sm" data-toast="已发送重置链接">忘记密码</button></div>
      <button type="submit" class="btn btn--primary btn--block btn--lg">登录</button>
    </div>
  </form></div>
</article>

<article class="demo" data-cid="WB-FORM-029" data-name="校验错误提示" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">校验错误提示</span></div>
  <p class="demo__note">适合：提交前逐项校验并汇总未通过项</p>
  <div class="demo__stage"><form class="card" id="wb-fm-vd" novalidate>
    <div class="wb-fm-card wb-fm-stack">
      <label class="field"><span class="field__label">手机号</span><input class="input" data-r="phone" inputmode="numeric" maxlength="11" placeholder="请输入手机号" autocomplete="off"><span class="field__err" hidden></span></label>
      <label class="field"><span class="field__label">折扣</span><span class="wb-fm-group field-shell"><input class="input" data-r="disc" inputmode="decimal" placeholder="请输入折扣" autocomplete="off"><span class="wb-fm-addon">折</span></span><span class="field__err" hidden></span></label>
      <label class="field"><span class="field__label">备注</span><textarea class="textarea wb-fm-ta--s" data-r="note" placeholder="请输入备注内容"></textarea><span class="field__err" hidden></span></label>
    </div>
    <div class="wb-fm-bar"><span class="wb-fm-err-sum" aria-live="polite" hidden></span><button type="button" class="btn btn--ghost" data-reset>重置</button><button type="submit" class="btn btn--primary">提交</button></div>
  </form></div>
</article>

<article class="demo" data-cid="WB-FORM-030" data-name="必填标记" data-cat="FORM">
