    </div>
    <div class="field"><span class="field__label" id="wb-fm-dp-l2">取花日期</span>
      <div class="wb-fm-pick" data-open="false" data-init="2"><span class="wb-fm-group field-shell"><input class="input" inputmode="numeric" placeholder="请选择或输入日期" aria-labelledby="wb-fm-dp-l2" autocomplete="off"><button type="button" class="wb-fm-link" aria-expanded="false" aria-label="展开取花日期的月历">日历</button></span><div class="wb-fm-pop wb-fm-dp-pop" role="group" aria-label="选择取花日期" inert></div></div>
      <span class="field__err" hidden></span>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-035" data-name="树选择器" data-cat="FORM">
