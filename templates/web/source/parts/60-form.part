</article>

<article class="demo" data-cid="WB-FORM-015" data-name="开关设置行" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">开关设置行</span></div>
  <p class="demo__note">适合：即时生效的功能开关，停业需确认</p>
  <div class="demo__stage"><div class="card wb-fm-card" id="wb-fm-sw">
    <div class="wb-fm-rows">
      <div class="wb-fm-row"><span><b>自动接单</b><small data-s>已开启</small></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="自动接单"></button></div>
      <div class="wb-fm-row"><span><b>消息提醒</b><small data-s>已关闭</small></span><button type="button" class="switch" role="switch" aria-checked="false" aria-label="消息提醒"></button></div>
      <div class="wb-fm-row"><span><b>营业状态</b><small data-s>营业中</small></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="营业状态" data-ask="暂停营业"></button></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-016" data-name="数量纵向滚轮" data-cat="FORM">
