      <div class="field"><span class="field__label">所属分类</span><div class="drop wb-fm-sel"><button type="button" class="drop__btn field-shell" aria-label="所属分类"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">鲜花</button><button type="button" class="drop__opt">绿植</button><button type="button" class="drop__opt">礼盒</button><button type="button" class="drop__opt">花器</button></div></div></div>
      <div class="field"><span class="field__label">所属门店</span><div class="drop wb-fm-sel"><button type="button" class="drop__btn field-shell" aria-label="所属门店"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">建国路店</button><button type="button" class="drop__opt">徐汇滨江店</button><button type="button" class="drop__opt">浦东世纪店</button></div></div></div>
      <label class="field"><span class="field__label wb-fm-req">商品价格</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-k="p" data-f="money" inputmode="decimal" value="199.00" autocomplete="off"><span class="wb-fm-addon">元</span></span><span class="field__err" hidden>请输入大于 0 的价格</span></label>
      <div class="field"><span class="field__label">库存数量</span><div class="wheel" data-min="0" data-max="500" data-step="1" data-value="86" data-unit="件" data-label="库存数量"></div></div>
      <div class="wb-fm-rows"><div class="wb-fm-row"><span><b>立即上架</b></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="立即上架"></button></div><div class="wb-fm-row"><span><b>同城可售</b></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="同城可售"></button></div></div>
      <label class="field wb-fm-span"><span class="wb-fm-lab"><span class="field__label">商品描述</span><span class="wb-fm-cnt"><b data-n>0</b>/200</span></span><textarea class="textarea" maxlength="200" placeholder="请输入商品描述"></textarea></label>
    </div>
    <div class="wb-fm-bar"><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="submit" class="btn btn--primary">保存</button></div>
  </form></div>
</article>

<article class="demo demo--wide" data-cid="WB-FORM-025" data-name="分组表单" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">分组表单</span></div>
  <p class="demo__note">适合：字段分块的长表单，组名在卡片外上方</p>
  <div class="demo__stage wb-fm-room--l"><form id="wb-fm-f3" novalidate>
    <section class="section wb-fm-first"><div class="section__head"><h2>基本信息</h2></div>
      <div class="card wb-fm-card section__body"><div class="wb-fm-grid3">
        <label class="field"><span class="field__label wb-fm-req">商品名称</span><input class="input" data-k="n" placeholder="请输入商品名称" autocomplete="off"><span class="field__err" hidden>请输入商品名称</span></label>
        <div class="field"><span class="field__label">所属分类</span><div class="drop wb-fm-sel" data-placeholder><button type="button" class="drop__btn field-shell" aria-label="所属分类"><b class="wb-fm-ph">请选择分类</b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt">鲜花</button><button type="button" class="drop__opt">绿植</button><button type="button" class="drop__opt">礼盒</button><button type="button" class="drop__opt">花器</button></div></div></div>
        <div class="field"><span class="field__label">所属门店</span><div class="drop wb-fm-sel"><button type="button" class="drop__btn field-shell" aria-label="所属门店"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">全部门店</button><button type="button" class="drop__opt">建国路店</button><button type="button" class="drop__opt">徐汇滨江店</button><button type="button" class="drop__opt">浦东世纪店</button></div></div></div>
      </div></div>
    </section>
    <section class="section"><div class="section__head"><h2>销售设置</h2></div>
      <div class="card wb-fm-card section__body"><div class="wb-fm-grid3">
        <label class="field"><span class="field__label wb-fm-req">销售价</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-f="money" inputmode="decimal" placeholder="0.00" autocomplete="off"><span class="wb-fm-addon">元</span></span></label>
        <label class="field"><span class="field__label">划线价</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-f="money" inputmode="decimal" placeholder="0.00" autocomplete="off"><span class="wb-fm-addon">元</span></span></label>
        <div class="field"><span class="field__label">每人限购</span><div class="drop wb-fm-sel"><button type="button" class="drop__btn field-shell" aria-label="每人限购"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">不限购</button><button type="button" class="drop__opt">1 件</button><button type="button" class="drop__opt">2 件</button><button type="button" class="drop__opt">5 件</button></div></div></div>
      </div></div>
    </section>
    <section class="section"><div class="section__head"><h2>配送设置</h2></div>
      <div class="card wb-fm-card section__body"><div class="wb-fm-grid3">
        <div class="field"><span class="field__label">配送方式</span><div class="wb-fm-chips" role="group" aria-label="配送方式"><button type="button" class="wb-fm-chip" aria-pressed="true">极速配送</button><button type="button" class="wb-fm-chip" aria-pressed="true">同城配送</button><button type="button" class="wb-fm-chip" aria-pressed="false">门店自提</button></div></div>
        <div class="field"><span class="field__label">配送范围</span><div class="drop wb-fm-sel"><button type="button" class="drop__btn field-shell" aria-label="配送范围"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">门店周边 3 公里</button><button type="button" class="drop__opt">门店周边 5 公里</button><button type="button" class="drop__opt">全城</button></div></div></div>
        <label class="field"><span class="field__label">起送价</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-f="money" inputmode="decimal" placeholder="0.00" autocomplete="off"><span class="wb-fm-addon">元</span></span></label>
      </div></div>
    </section>
    <div class="wb-fm-bar wb-fm-bar--stage"><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="submit" class="btn btn--primary">保存</button></div>
  </form></div>
</article>

<article class="demo" data-cid="WB-FORM-026" data-name="分步表单" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">分步表单</span></div>
  <p class="demo__note">适合：流程长的新增，分三步逐段确认</p>
  <div class="demo__stage wb-fm-room"><div class="card" id="wb-fm-sp"><div class="wb-fm-card">
    <div class="wb-fm-steps" aria-label="填写进度"><div class="wb-fm-step" data-state="now"><span>1</span>基本信息</div><hr><div class="wb-fm-step" data-state="todo"><span>2</span>价格库存</div><hr><div class="wb-fm-step" data-state="todo"><span>3</span>确认</div></div>
    <div class="wb-fm-pane wb-fm-stack" data-p="0">
      <label class="field"><span class="field__label wb-fm-req">商品名称</span><input class="input" data-k="n" placeholder="请输入商品名称" autocomplete="off"><span class="field__err" hidden>请输入商品名称</span></label>
      <div class="field"><span class="field__label">所属分类</span><div class="drop wb-fm-sel" data-k="c"><button type="button" class="drop__btn field-shell" aria-label="所属分类"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" aria-selected="true">鲜花</button><button type="button" class="drop__opt">绿植</button><button type="button" class="drop__opt">礼盒</button><button type="button" class="drop__opt">花器</button></div></div></div>
    </div>
    <div class="wb-fm-pane wb-fm-stack" data-p="1" hidden>
      <label class="field"><span class="field__label wb-fm-req">商品价格</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-k="p" data-f="money" inputmode="decimal" value="199.00" autocomplete="off"><span class="wb-fm-addon">元</span></span><span class="field__err" hidden>请输入大于 0 的价格</span></label>
      <div class="field"><span class="field__label">库存数量</span><div class="wheel" data-min="0" data-max="500" data-value="50" data-unit="件" data-label="库存数量"></div></div>
    </div>
    <div class="wb-fm-pane" data-p="2" hidden><dl class="wb-fm-kv"><dt>商品名称</dt><dd data-v="n"></dd><dt>所属分类</dt><dd data-v="c"></dd><dt>商品价格</dt><dd data-v="p"></dd><dt>库存数量</dt><dd data-v="s"></dd></dl></div>
    </div>
    <div class="wb-fm-bar"><button type="button" class="btn btn--ghost" data-prev disabled>上一步</button><button type="button" class="btn btn--primary" data-next>下一步</button></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-027" data-name="行内表单" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">行内表单</span></div>
