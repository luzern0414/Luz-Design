  /* 037 验证码分格输入：自动跳格、退格回退、粘贴分发、满六位自动校验 */
  (() => {
    const root = $('#wb-fm-otp'), wrap = $('.wb-fm-otp', root), cs = $$('.wb-fm-otp__c', root), msg = $('.wb-fm-otp__msg', root), re = $('[data-resend]', root), row = $('.wb-fm-otp__row', root);
    let busy = false, left = 0, timer = null;
