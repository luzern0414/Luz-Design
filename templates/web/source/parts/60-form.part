    const SW = [['主色', '--action'], ['辅色', '--accent'], ['成功', '--success'], ['警告', '--warning'], ['危险', '--danger'], ['信息', '--info'], ['价格', '--price'], ['文字', '--ink'], ['主色浅', '--action-soft'], ['辅色浅', '--accent-tint'], ['成功浅', '--success-tint'], ['警告浅', '--warning-tint'], ['危险浅', '--danger-tint'], ['信息浅', '--info-tint'], ['价格浅', '--price-tint'], ['分区', '--zone']];
