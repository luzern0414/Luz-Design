        <button type="button" class="wb-fm-rc" role="radio" aria-checked="false" tabindex="-1"><i></i><img data-ic="pin" src="../../kit/assets/icons/flat/pin.webp" alt=""><b>门店自提</b><small>到店取</small></button>
        <button type="button" class="wb-fm-rc" role="radio" aria-checked="false" tabindex="-1"><i></i><img data-ic="bag" src="../../kit/assets/icons/flat/bag.webp" alt=""><b>打包寄送</b><small>次日达</small></button>
