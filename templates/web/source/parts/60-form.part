    const S = { l: new Set(ALL.filter(x => x[0] !== '查看订单' && x[0] !== '编辑商品').map(x => x[0])), r: new Set(['查看订单', '编辑商品']) }, C = { l: new Set(), r: new Set() };
    const P = { l: $('[data-side="l"]', root), r: $('[data-side="r"]', root) }, B = { r: $('[data-go="r"]', root), l: $('[data-go="l"]', root) };
    const paint = s => {
      const p = P[s], k = $('input', p).value.trim(), items = ALL.filter(x => S[s].has(x[0]) && (!k || x[0].includes(k))), en = items.filter(x => !x[1]), c = en.filter(x => C[s].has(x[0])).length;
