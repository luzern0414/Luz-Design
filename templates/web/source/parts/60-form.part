    <label class="field"><span class="field__label">联系电话</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">86</span><input class="input" data-f="phone" inputmode="numeric" maxlength="11" placeholder="请输入 11 位手机号" autocomplete="off"></span></label>
    <label class="field"><span class="field__label">商品重量</span><span class="wb-fm-group field-shell"><input class="input" data-f="int" inputmode="numeric" maxlength="5" placeholder="请输入重量" autocomplete="off"><span class="wb-fm-addon">克</span></span></label>
  </div></div>
</article>

