<!-- cat: FORM | 表单 -->
<style>
  /* 表单类：前缀 wb-fm-。后台控件高 40，正文 14。用底色反馈，错误提示紧贴字段。 */
  #cat-form .input, #cat-form .textarea { min-height: 40px; font-size: var(--fs-sm); }
  #cat-form .textarea { min-height: 96px; }
  #cat-form .field__label { font-size: var(--fs-sm); }
  #cat-form .field__err { font-size: var(--fs-sm); line-height: 1.4; }
  #cat-form .t-sub { font-size: var(--fs-sm); }
  .wb-fm-card { padding: var(--s-5); }
  .wb-fm-stack { display: grid; gap: var(--s-4); }
  .wb-fm-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-5); align-items: start; }
  .wb-fm-grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4) var(--s-5); align-items: start; }
  .wb-fm-span { grid-column: 1 / -1; }
  .wb-fm-lab { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 22px; }
  .wb-fm-cnt { font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wb-fm-cnt[data-full="true"] { color: var(--danger); }
  #cat-form .demo__stage.wb-fm-room, #cat-form .demo__stage.wb-fm-room--l { overflow: visible; }
  #cat-form .btn[disabled] { box-shadow: none; }
  #cat-form .check[aria-checked="mixed"] { background: var(--action); border-color: var(--action); position: relative; }
  #cat-form .check[aria-checked="mixed"]::after { content: ""; width: 10px; height: 2px; border-radius: 1px; background: var(--surface); }
  #cat-form .check[aria-checked="mixed"] img { display: none; }
  /* 操作条：贴着卡片底边的通栏，上下左右内距都是 20（与卡片内距一致）；整页表单的操作条落在舞台上，四边都是 12 */
  .wb-fm-bar { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); padding: var(--s-5); border-top: 1px solid var(--line); }
  .wb-fm-bar .l { margin-right: auto; }
  .wb-fm-bar .btn { min-height: 40px; }
  .wb-fm-bar--stage { margin-top: var(--s-5); padding: var(--s-3) 0 0; }
  #cat-form .input:disabled, #cat-form .textarea:disabled { background: var(--zone); color: var(--ink-3); border-color: var(--line); cursor: not-allowed; }
  #cat-form .input.wb-fm-is-focus { background-color: var(--field-active); }
  .wb-fm-sel { width: 100%; }
  .wb-fm-sel .drop__btn { width: 100%; min-height: 40px; padding: 0 var(--s-3); justify-content: space-between; border-radius: var(--r-md); background-color: var(--field-fill); font-size: var(--fs-sm); color: var(--ink); }
  .wb-fm-sel .drop__btn b { font-weight: 400; }
  .wb-fm-sel .drop__btn b.wb-fm-ph { color: var(--ink-3); }
  .wb-fm-sel:is(:focus-within, [data-open="true"]) .drop__btn { background-color: var(--field-active); }
  .wb-fm-sel .drop__btn[aria-invalid="true"] { --field-fill: var(--danger-tint); --field-active: var(--danger-tint); }
  .wb-fm-sel .drop__btn[disabled] { background: var(--zone); color: var(--ink-3); }
  .wb-fm-sel .drop__menu { left: 0; right: 0; }
  .wb-fm-sel .drop__opt { min-height: 40px; }
  .wb-fm-crumb img { width: 22px; height: 22px; border-radius: 6px; object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-fm-strip { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
  .wb-fm-pill { display: inline-flex; align-items: center; gap: var(--s-2); height: 36px; padding: 0 var(--s-3) 0 4px; border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); }
  .wb-fm-pill img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }

  /* 控件外观：用于下拉、级联、多选等触发框 */
  .wb-fm-ctl { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); width: 100%; min-height: 40px; padding: 0 var(--s-3); border-radius: var(--r-md); font-size: var(--fs-sm); text-align: left; }
  .wb-fm-ctl::after { content: ""; flex: none; width: 7px; height: 7px; border: solid var(--ink-3); border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translate(-1px, -2px); transition: transform var(--dur-base) var(--ease-out); }
  [data-open="true"] > .wb-fm-ctl { background-color: var(--field-active); }
  [data-open="true"] > .wb-fm-ctl::after { transform: rotate(225deg) translate(-1px, -2px); }
  .wb-fm-ctl[disabled] { background: var(--zone); color: var(--ink-3); pointer-events: none; }
  .wb-fm-ph { color: var(--ink-3); }
  .wb-fm-pick { position: relative; }
  .wb-fm-pop { position: absolute; z-index: 30; top: calc(100% + 4px); left: 0; right: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); opacity: 0; transform: scale(.97); transform-origin: top center; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  [data-open="true"] > .wb-fm-pop { opacity: 1; transform: none; pointer-events: auto; }
  .wb-fm-opt { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); }
  .wb-fm-opt img { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; box-shadow: 0 0 0 1px var(--line); flex: none; }
  .wb-fm-opt > span { display: grid; min-width: 0; line-height: 1.35; }
  .wb-fm-opt small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-opt[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
  @media (hover: hover) { .wb-fm-opt:hover { background: var(--zone); } }
  .wb-fm-opt:focus-visible { outline: none; background: var(--zone); }

  /* 前后缀 */
  .wb-fm-group { display: flex; align-items: stretch; border-radius: var(--r-md); overflow: hidden; }
  #cat-form .wb-fm-group > .input, #cat-form .wb-fm-group > input { flex: 1; min-width: 0; min-height: 38px; border: 0; border-radius: 0; box-shadow: none; background: none; padding: 0 var(--s-3); }
  .wb-fm-addon { display: inline-flex; align-items: center; padding: 0 var(--s-3); background: var(--zone); color: var(--ink-2); font-size: var(--fs-sm); white-space: nowrap; }
  .wb-fm-addon:first-child { border-right: 1px solid var(--line); }
  .wb-fm-addon:last-child { border-left: 1px solid var(--line); }
  .wb-fm-group[aria-invalid="true"] { --field-fill: var(--danger-tint); --field-active: var(--danger-tint); }
  .wb-fm-group .wb-fm-x, .wb-fm-wrap .wb-fm-x { width: 28px; height: 28px; align-self: center; margin-right: var(--s-2); border-radius: 50%; flex: none; }
  .wb-fm-x img { width: 12px; height: 12px; opacity: .7; }
  .wb-fm-x[hidden] { display: none; }
  .wb-fm-link { flex: none; align-self: center; margin-right: var(--s-2); padding: 0 var(--s-2); min-height: 28px; border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--action-press); font-weight: 500; }
  @media (hover: hover) { .wb-fm-link:hover { background: var(--zone); } }
  .wb-fm-meter { display: grid; grid-template-columns: repeat(3, 1fr) auto; align-items: center; gap: 4px; margin-top: var(--s-2); }
  .wb-fm-meter i { height: 4px; border-radius: 2px; background: var(--zone); transition: background var(--dur-base) var(--ease-out); }
  .wb-fm-meter span { margin-left: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); min-width: 20px; }
  .wb-fm-meter[data-s="1"] i:nth-child(-n+1) { background: var(--danger); }
  .wb-fm-meter[data-s="2"] i:nth-child(-n+2) { background: var(--warning); }
  .wb-fm-meter[data-s="3"] i:nth-child(-n+3) { background: var(--success); }

  /* 标签：选择与输入 */
  .wb-fm-chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .wb-fm-chip { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 34px; padding: 0 var(--s-3); border-radius: var(--r-full); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-fm-chip[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action); color: var(--action-press); font-weight: 600; }
  @media (hover: hover) { .wb-fm-chip:hover { background: var(--zone); } }
  .wb-fm-chip[disabled] { opacity: .45; pointer-events: none; }
  .wb-fm-chip img { width: 14px; height: 14px; }
  .wb-fm-chip--tag { min-height: 28px; padding: 0 var(--s-1) 0 var(--s-3); background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); color: var(--action-press); font-weight: 500; }
  .wb-fm-chip--tag .wb-fm-x { width: 22px; height: 22px; margin: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; }
  .wb-fm-chip--tag .wb-fm-x img { width: 12px; height: 12px; }
  @media (hover: hover) { .wb-fm-chip--tag .wb-fm-x:hover { background: var(--action-edge); } }
  .wb-fm-tagbox { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); min-height: 40px; padding: 5px var(--s-2); border-radius: var(--r-md); cursor: text; }
  #cat-form .wb-fm-tagbox input { flex: 1; min-width: 96px; min-height: 28px; border: 0; background: none; font-size: var(--fs-sm); padding: 0 var(--s-1); }
  #cat-form .wb-fm-tagbox input:focus-visible { outline: none; box-shadow: none; }

  /* 单选与勾选 */
  .wb-fm-rds { display: grid; gap: var(--s-2); }
  .wb-fm-rd { display: flex; align-items: center; gap: var(--s-3); min-height: 44px; padding: 0 var(--s-3); border: 1px solid var(--line); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); background: var(--surface); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .wb-fm-rd > i { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--line-strong); flex: none; background: var(--surface); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  .wb-fm-rd[aria-checked="true"] { border-color: var(--action); background: var(--action-tint); }
  .wb-fm-rd[aria-checked="true"] > i { border-color: var(--action); background: var(--action); box-shadow: inset 0 0 0 4px var(--action-tint); }
  .wb-fm-rd[aria-disabled="true"] { opacity: .5; pointer-events: none; }
  .wb-fm-rd .t-sub { margin-left: auto; font-size: var(--fs-xs); }
  @media (hover: hover) { .wb-fm-rd:hover { border-color: var(--line-strong); } .wb-fm-rd[aria-checked="true"]:hover { border-color: var(--action); } }
  .wb-fm-rcs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); }
  .wb-fm-rc { position: relative; display: grid; justify-items: center; gap: 2px; padding: var(--s-3) var(--s-2); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); text-align: center; transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .wb-fm-rc img { width: 44px; height: 44px; object-fit: contain; }
  .wb-fm-rc b { font-size: var(--fs-sm); font-weight: 600; }
  .wb-fm-rc small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-rc > i { position: absolute; top: 8px; right: 8px; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--line-strong); background: var(--surface); }
  .wb-fm-rc[aria-checked="true"] { border-color: var(--action); background: var(--action-tint); }
  .wb-fm-rc[aria-checked="true"] > i { border-color: var(--action); background: var(--action); box-shadow: inset 0 0 0 3px var(--action-tint); }
  .wb-fm-rows { display: grid; }
  .wb-fm-row { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: var(--s-2) 0; font-size: var(--fs-sm); text-align: left; }
  .wb-fm-row:first-child { padding-top: 0; }
  .wb-fm-row:last-child { padding-bottom: 0; }
  .wb-fm-row:only-child { min-height: 40px; }
  .wb-fm-row + .wb-fm-row { border-top: 1px solid var(--line); }
  .wb-fm-row > span:first-child { flex: 1; min-width: 0; display: grid; }
  .wb-fm-row b { font-weight: 600; }
  .wb-fm-row small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-row[role="checkbox"] { cursor: pointer; }
  .wb-fm-row .check { order: -1; }

  /* 滚轮 */
  #cat-form .wheel { gap: var(--s-3); }
  #cat-form .wheel .input { width: 84px; }
  .wb-fm-time { display: flex; align-items: flex-start; gap: var(--s-4); }
  .wb-fm-time .wheel { gap: var(--s-2); }
  .wb-fm-time .wheel__col { width: 64px; }
  #cat-form .wb-fm-time .wheel .input { width: 52px; padding: 0 var(--s-1); }
  /* 滚轮与合计同一行并排，宽度不够时合计落到滚轮下方；合计面板上标题下数字并居中 */
  .wb-fm-split { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--s-4); }
  .wb-fm-split > .field { flex: none; align-content: start; }
  .wb-fm-sum { flex: 1 1 160px; display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: var(--s-1); min-height: 72px; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-3); text-align: center; }
  .wb-fm-sum .price { font-size: var(--fs-xl); }
  .wb-fm-sum b { font-size: var(--fs-xl); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* 搜索、筛选条 */
  #cat-form .search { min-height: 40px; }
  #cat-form .search input { height: 38px; font-size: var(--fs-sm); }
  #cat-form input[type="search"]::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
  .wb-fm-hits { display: grid; margin-top: var(--s-3); }
  .wb-fm-hit { display: flex; align-items: center; gap: var(--s-3); min-height: 48px; padding: 0 var(--s-2); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); }
  .wb-fm-hit img { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
  .wb-fm-hit small { margin-left: auto; color: var(--ink-3); font-size: var(--fs-xs); }
  @media (hover: hover) { .wb-fm-hit:hover { background: var(--zone); } }
  .wb-fm-hit mark { background: var(--action-tint); color: var(--action-press); font-weight: 600; border-radius: 3px; }
  .wb-fm-none { padding: var(--s-4) var(--s-2); text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }
  /* 单行：搜索框先收窄，实在放不下才整体换行，「共 N 件」永远不拆开 */
  .wb-fm-bandbar { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; min-width: 0; }
  .wb-fm-bandbar .search { flex: 1 1 140px; min-width: 140px; max-width: 220px; }
  .wb-fm-bandbar .drop__btn { min-height: 40px; padding: 0 var(--s-4); white-space: nowrap; }
  .wb-fm-bandbar .btn, .wb-fm-bandbar .wb-fm-found { flex: none; white-space: nowrap; }
  .wb-fm-bandbar .drop[data-on="true"] .drop__btn { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); color: var(--action-press); }
  .wb-fm-tail { display: flex; align-items: center; gap: var(--s-2); flex: none; margin-left: auto; }

  /* 搜索表单 */
  .wb-fm-sf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4) var(--s-5); }
  .wb-fm-sfmore .expand__body { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4) var(--s-5); padding: var(--s-4) 0 0; background: none; border-top: 0; }
  /* 展开区里有下拉：展开动画结束后放开裁剪，选项层才不会被展开层切掉 */
  .wb-fm-sfmore[data-open="true"] > div { animation: wb-fm-unclip 0s linear var(--dur-base) both; }
  @keyframes wb-fm-unclip { from { overflow: hidden; } to { overflow: visible; } }
  .wb-fm-range { display: flex; align-items: center; gap: var(--s-2); }
  .wb-fm-range .input { text-align: center; }
  .wb-fm-range i { width: 10px; height: 1.5px; background: var(--ink-3); flex: none; }
  .wb-fm-sfbar { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
  .wb-fm-sfbar .btn { min-height: 40px; white-space: nowrap; }
  .wb-fm-tg { display: inline-flex; align-items: center; gap: var(--s-1); flex: none; min-height: 40px; padding: 0; font-size: var(--fs-sm); font-weight: 500; color: var(--action-press); white-space: nowrap; }
  .wb-fm-tg::after { content: ""; width: 7px; height: 7px; border: solid currentColor; border-width: 0 1.6px 1.6px 0; transform: rotate(45deg) translate(-1px, -2px); transition: transform var(--dur-base) var(--ease-out); }
  .wb-fm-tg[aria-expanded="true"]::after { transform: rotate(225deg) translate(-1px, -2px); }
  .wb-fm-found { flex: none; font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }
  .wb-fm-found b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* 上传 */
  .wb-fm-ups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-3); }
  .wb-fm-up { position: relative; aspect-ratio: 1; border-radius: var(--r-md); overflow: hidden; background: var(--zone); box-shadow: 0 0 0 1px var(--line); }
  .wb-fm-up > img { width: 100%; height: 100%; object-fit: cover; }
  .wb-fm-up .tag { position: absolute; left: 6px; top: 6px; background: color-mix(in srgb, var(--surface) 92%, transparent); }
  .wb-fm-up .wb-fm-x { position: absolute; right: 6px; top: 6px; width: 26px; height: 26px; border-radius: 50%; background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: var(--elev-1); display: inline-flex; align-items: center; justify-content: center; opacity: 0; transition: opacity var(--dur-quick) var(--ease-out); }
  .wb-fm-up:hover .wb-fm-x, .wb-fm-up:focus-within .wb-fm-x { opacity: 1; }
  .wb-fm-up .wb-fm-x img { width: 14px; height: 14px; }
  .wb-fm-up[data-busy="true"]::after { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--surface) 60%, transparent); }
  .wb-fm-up .progress { position: absolute; left: 8px; right: 8px; bottom: 8px; z-index: 1; height: 6px; }
  .wb-fm-add { display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--r-md); border: 1.5px dashed var(--action-edge); background: var(--action-tint); color: var(--action-press); font-size: var(--fs-sm); text-align: center; transition: background var(--dur-quick) var(--ease-out), border-color var(--dur-quick) var(--ease-out); }
  .wb-fm-add span { display: grid; justify-items: center; gap: 4px; }
  .wb-fm-add img { width: 22px; height: 22px; }
  @media (hover: hover) { .wb-fm-add:hover { border-color: var(--action); } }
  .wb-fm-zone { display: grid; width: 100%; justify-items: center; gap: var(--s-2); padding: var(--s-6) var(--s-4); border: 1.5px dashed var(--action-edge); border-radius: var(--r-lg); background: var(--action-tint); text-align: center; font-size: var(--fs-sm); color: var(--ink-2); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .wb-fm-zone img { width: 56px; height: 56px; object-fit: contain; }
  .wb-fm-zone b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
  .wb-fm-zone[data-over="true"] { border-color: var(--action); background: color-mix(in srgb, var(--action) 8%, var(--surface)); }
  .wb-fm-files { display: grid; margin-top: var(--s-3); }
  .wb-fm-files:empty { display: none; }
  .wb-fm-file { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto auto; align-items: center; gap: 2px var(--s-3); padding: var(--s-3) 0; }
  .wb-fm-file + .wb-fm-file { border-top: 1px solid var(--line); }
  .wb-fm-file > img { width: 36px; height: 36px; grid-row: span 2; object-fit: contain; }
  .wb-fm-file b, .wb-fm-file small { grid-column: 2; min-width: 0; }
  .wb-fm-file b { font-size: var(--fs-sm); font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .wb-fm-file small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-file .progress { grid-column: 2; height: 6px; }
  .wb-fm-file .tag { grid-column: 3; grid-row: 1 / span 2; }
  .wb-fm-file .wb-fm-x { grid-column: 4; grid-row: 1 / span 2; width: 28px; height: 28px; justify-self: end; }

  /* 步骤 */
  .wb-fm-steps { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-5); }
  .wb-fm-step { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); white-space: nowrap; }
  .wb-fm-step > span:first-child { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--zone); color: var(--ink-2); font-weight: 600; font-variant-numeric: tabular-nums; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  .wb-fm-step[data-state="now"] { color: var(--ink); font-weight: 600; }
  .wb-fm-step[data-state="now"] > span:first-child { background: var(--action); color: var(--surface); }
  .wb-fm-step[data-state="done"] { color: var(--ink-2); }
  .wb-fm-step[data-state="done"] > span:first-child { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .wb-fm-step img { width: 14px; height: 14px; }
  .wb-fm-steps hr { flex: 1; min-width: 16px; height: 2px; border: 0; border-radius: 1px; background: var(--line-strong); }
  .wb-fm-steps hr[data-done="true"] { background: var(--action); }
  .wb-fm-pane[hidden] { display: none; }
  .wb-fm-kv { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--s-3) var(--s-4); font-size: var(--fs-sm); }
  .wb-fm-kv dt { color: var(--ink-3); }
  .wb-fm-kv dd { font-weight: 500; }

  /* 提示条与标记 */
  .wb-fm-alert { padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--danger-tint); color: var(--danger); font-size: var(--fs-sm); font-weight: 500; }
  .wb-fm-alert[hidden] { display: none; }
  .wb-fm-req { display: inline-flex; align-items: center; gap: 6px; }
  .wb-fm-req::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--danger); transition: background var(--dur-base) var(--ease-out); }
  .wb-fm-req[data-ok="true"]::before { background: var(--success); }
  .wb-fm-req--txt::before { display: none; }
  .wb-fm-mark { display: inline-flex; align-items: center; height: 20px; padding: 0 6px; border-radius: 6px; font-size: var(--fs-xs); font-weight: 600; background: var(--danger-tint); color: var(--danger); transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  .wb-fm-mark[data-ok="true"] { background: var(--success-tint); color: var(--success); }
  .wb-fm-mark--opt { background: var(--zone); color: var(--ink-3); }
  .wb-fm-login { max-width: 360px; margin: 0 auto; }
  .wb-fm-login__top { display: grid; justify-items: center; gap: var(--s-2); margin-bottom: var(--s-5); }
  .wb-fm-login__top img { width: 64px; height: 64px; object-fit: contain; }
  .wb-fm-login__top h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-fm-login .wb-fm-opts { display: flex; align-items: center; justify-content: space-between; }
  .wb-fm-ck { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 32px; font-size: var(--fs-sm); color: var(--ink-2); cursor: pointer; }
  .wb-fm-err-sum { margin-right: auto; font-size: var(--fs-sm); color: var(--danger); font-weight: 500; }
  .wb-fm-dirty[hidden] { display: none; }
  .wb-fm-shell { display: grid; }
  .wb-fm-hrow { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: var(--s-4); min-height: 64px; }
  .wb-fm-hrow + .wb-fm-hrow { border-top: 1px solid var(--line); }
  .wb-fm-hrow > b { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .wb-fm-hrow > div { padding: var(--s-2) 0; min-width: 0; }
  .wb-fm-hrow > .wb-fm-row { padding: 0; }
  .wb-fm-first { margin-top: 0; }
  #cat-form .textarea.wb-fm-ta--s { min-height: 72px; }
  .wb-fm-inline { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-2); }
  .wb-fm-inline > .field__label, .wb-fm-inline > .field__err { grid-column: 1 / -1; }
  .wb-fm-inline .btn { min-height: 40px; }
  .wb-fm-result:empty { display: none; }
  .wb-fm-result { display: flex; align-items: center; gap: var(--s-2); min-height: 28px; margin-top: var(--s-3); font-size: var(--fs-sm); }
  .wb-fm-pop--cas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: var(--s-1); }
  .wb-fm-cas { display: grid; align-content: start; max-height: 232px; overflow-y: auto; padding: var(--s-1); scrollbar-width: thin; }
  .wb-fm-cas + .wb-fm-cas { border-left: 1px solid var(--line); }
  .wb-fm-cas .wb-fm-opt { min-height: 40px; }
  .wb-fm-cas .wb-fm-opt[data-more="true"]::after { content: ""; margin-left: auto; width: 6px; height: 6px; border: solid var(--ink-3); border-width: 0 1.4px 1.4px 0; transform: rotate(-45deg); flex: none; }
  .wb-fm-crumb { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .wb-fm-crumb i { width: 5px; height: 5px; border: solid var(--ink-3); border-width: 0 1.4px 1.4px 0; transform: rotate(-45deg); flex: none; }
  .wb-fm-combo-s { display: flex; align-items: center; gap: var(--s-2); margin: var(--s-2); padding: 0 var(--s-3); min-height: 36px; border-radius: var(--r-sm); background: var(--zone); }
  .wb-fm-combo-s img { width: 16px; height: 16px; }
  #cat-form .wb-fm-combo-s input { flex: 1; min-width: 0; min-height: 34px; border: 0; background: none; font-size: var(--fs-sm); padding: 0; }
  #cat-form .wb-fm-combo-s input:focus-visible { outline: none; box-shadow: none; }
  .wb-fm-list { max-height: 220px; overflow-y: auto; padding: 0 var(--s-1) var(--s-1); scrollbar-width: thin; }

  /* 整行宽的表单：窗口变窄时列数逐级减少，字段不被挤成窄条 */
  @media (max-width: 880px) {
    .wb-fm-grid3, .wb-fm-sf, .wb-fm-sfmore .expand__body { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .wb-fm-grid2, .wb-fm-grid3, .wb-fm-sf, .wb-fm-sfmore .expand__body { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<article class="demo" data-cid="WB-FORM-001" data-name="基础文本框" data-cat="FORM">
