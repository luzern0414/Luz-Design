        <button type="button" class="wb-fm-rd" role="radio" aria-checked="true" tabindex="0"><i></i>极速配送<span class="t-sub">30 分钟</span></button>
        <button type="button" class="wb-fm-rd" role="radio" aria-checked="false" tabindex="-1"><i></i>同城配送<span class="t-sub">当日达</span></button>
        <button type="button" class="wb-fm-rd" role="radio" aria-checked="false" tabindex="-1"><i></i>门店自提</button>
        <button type="button" class="wb-fm-rd" role="radio" aria-checked="false" aria-disabled="true" tabindex="-1"><i></i>快递配送<span class="t-sub">暂停</span></button>
      </div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-013" data-name="单选卡片组" data-cat="FORM">
