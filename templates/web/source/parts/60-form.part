  <div class="demo__stage"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-rq">
    <label class="field"><span class="field__label"><span class="wb-fm-req" data-m>商品名称</span></span><input class="input" data-need placeholder="请输入商品名称" autocomplete="off"></label>
    <label class="field"><span class="field__label">联系电话 <span class="wb-fm-mark" data-m data-t="必填">必填</span></span><input class="input" data-need inputmode="numeric" maxlength="11" placeholder="请输入联系电话" autocomplete="off"></label>
    <label class="field"><span class="field__label">订单备注 <span class="wb-fm-mark wb-fm-mark--opt">选填</span></span><input class="input" placeholder="请输入备注内容" autocomplete="off"></label>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-031" data-name="表单提交条" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">表单提交条</span></div>
  <p class="demo__note">适合：有改动才可保存，取消与保存同排</p>
  <div class="demo__stage"><div class="card" id="wb-fm-sb">
    <div class="wb-fm-card"><label class="field"><span class="wb-fm-lab"><span class="field__label">门店公告</span><span class="wb-fm-cnt"><b data-n>0</b>/60</span></span><textarea class="textarea" maxlength="60" data-saved="周末花艺课开放预约">周末花艺课开放预约</textarea></label></div>
    <div class="wb-fm-bar"><span class="tag wb-fm-dirty l" data-tone="warning" hidden>有未保存的修改</span><button type="button" class="btn btn--ghost" data-cancel disabled>取消</button><button type="button" class="btn btn--primary" data-save disabled>保存</button></div>
  </div></div>
</article>

<article class="demo demo--span2" data-cid="WB-FORM-032" data-name="表单卡壳" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">表单卡壳</span></div>
  <p class="demo__note">适合：设置类页面，标签在左控件在右逐行排</p>
  <div class="demo__stage"><section class="section wb-fm-first" id="wb-fm-sh"><div class="section__head"><h2>门店资料</h2></div>
    <div class="card section__body">
      <div class="wb-fm-card wb-fm-shell">
        <div class="wb-fm-hrow"><b>门店名称</b><div class="field"><input class="input" data-k="n" value="建国路店" autocomplete="off"><span class="field__err" hidden>请输入门店名称</span></div></div>
        <div class="wb-fm-hrow"><b>联系电话</b><div><span class="wb-fm-group field-shell"><span class="wb-fm-addon">86</span><input class="input" data-f="phone" inputmode="numeric" maxlength="11" value="13800138000" autocomplete="off"></span></div></div>
        <div class="wb-fm-hrow"><b>起送价</b><div><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-f="money" inputmode="decimal" value="39.00" autocomplete="off"><span class="wb-fm-addon">元</span></span></div></div>
        <div class="wb-fm-hrow"><b>营业状态</b><div class="wb-fm-row"><span><b data-s>营业中</b></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="营业状态" data-ask="暂停营业"></button></div></div>
      </div>
      <div class="wb-fm-bar"><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="button" class="btn btn--primary" data-save>保存</button></div>
    </div>
  </section></div>
</article>

<script>
(function () {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const fmt = (n, d = 2) => n.toLocaleString('zh-CN', { minimumFractionDigits: d, maximumFractionDigits: d });
  const img = i => `../../kit/assets/photo/product-${i}.webp`;
  const PR = [['红玫瑰花束', '鲜花', 199, 'rose-red', '建国路店', '在售'], ['粉芍药花束', '鲜花', 239, 'peony-pink', '徐汇滨江店', '在售'], ['向日葵花束', '鲜花', 159, 'sunflower', '浦东世纪店', '售罄'],
    ['白郁金香', '鲜花', 179, 'tulip-white', '建国路店', '在售'], ['蓝绣球盆栽', '绿植', 129, 'hydrangea-blue', '徐汇滨江店', '在售'], ['龟背竹盆栽', '绿植', 159, 'monstera', '浦东世纪店', '售罄'],
    ['多肉组合盆', '绿植', 89, 'succulent', '建国路店', '在售'], ['干花花瓶摆件', '花器', 129, 'pampas-vase', '建国路店', '已下架'], ['花礼盒', '礼盒', 259, 'giftbox', '徐汇滨江店', '在售']]
    .map(([n, c, p, i, s, t]) => ({ n, c, p, i, s, t }));
  const ORD = [['20388', '林晓', '红玫瑰花束', '建国路店', 199, '待付款'], ['20387', '陈默', '粉芍药花束', '徐汇滨江店', 239, '待发货'], ['20386', '周岚', '蓝绣球盆栽', '浦东世纪店', 258, '待收货'],
    ['20385', '吴桐', '花礼盒', '建国路店', 259, '已完成'], ['20384', '郑一', '向日葵花束', '浦东世纪店', 159, '售后'], ['20383', '王宁', '龟背竹盆栽', '徐汇滨江店', 159, '已完成'],
    ['20382', '赵悦', '白郁金香', '建国路店', 358, '待发货'], ['20381', '孙洁', '干花花瓶摆件', '浦东世纪店', 129, '待付款']].map(([no, who, item, store, amt, st]) => ({ no, who, item, store, amt, st }));

  /* 校验标记：错误紧邻字段，保留输入 */
  const mark = (field, bad, msg) => {
    if (!field) return;
    const c = $('.wb-fm-group, .input, .textarea, .drop__btn', field), e = $('.field__err', field);
    if (c) c.setAttribute('aria-invalid', String(bad));
    if (e) { if (msg) e.textContent = msg; e.hidden = !bad; }
    if (bad && c) { c.classList.remove('shake'); void c.offsetWidth; c.classList.add('shake'); }
  };
  const fieldOf = el => el.closest('.field');

  /* 输入过滤：金额两位小数，电话十一位数字，整数 */
  const FILT = { money: v => { v = v.replace(/[^\d.]/g, ''); const p = v.split('.'); return p.length > 1 ? p[0] + '.' + p.slice(1).join('').slice(0, 2) : v; }, phone: v => v.replace(/\D/g, '').slice(0, 11), int: v => v.replace(/\D/g, '').slice(0, 5) };
  document.addEventListener('input', e => { const i = e.target.closest('#cat-form input[data-f]'); if (!i || e.isComposing) return; const v = FILT[i.dataset.f](i.value); if (v !== i.value) i.value = v; });
  document.addEventListener('focusout', e => { const i = e.target.closest && e.target.closest('#cat-form input[data-f="money"]'); if (i && i.value && !Number.isNaN(+i.value)) i.value = (+i.value).toFixed(2); });

  /* 计数：有 maxlength 的字段在同一个字段里显示已输入字数 */
  $$('#cat-form .field').forEach(f => {
    const c = $('.wb-fm-cnt [data-n]', f), i = $('input[maxlength], textarea[maxlength]', f); if (!c || !i) return;
    const u = () => { c.textContent = i.value.length; c.parentNode.dataset.full = String(i.value.length >= +i.maxLength); };
    i.addEventListener('input', u); u();
  });
  document.addEventListener('lz:drop', e => { const b = $('b', e.target); if (b && b.classList.contains('wb-fm-ph')) b.classList.remove('wb-fm-ph'); });
  /* 勾选行：整行是复选框，状态同步到里面的勾选图形 */
  document.addEventListener('lz:toggle', e => { const el = e.target, c = el.matches('#cat-form [role="checkbox"]') && $('.check', el); if (c) c.setAttribute('aria-checked', el.getAttribute('aria-checked')); });
  document.addEventListener('click', e => { const b = e.target.closest('#cat-form [data-toast]'); if (b) Lz.toast(b.dataset.toast, 'success'); });

  /* 开关守卫：关闭重要状态要居中确认 */
  const guard = root => {
    const g = async e => {
      const sw = e.target.closest('.switch[data-ask]'); if (!sw || sw.getAttribute('aria-checked') !== 'true') return;
      if (e.type === 'keydown' && e.key !== ' ' && e.key !== 'Enter') return;
      e.stopPropagation(); e.preventDefault();
      if (await Lz.confirm({ title: sw.dataset.ask, ok: sw.dataset.ask.slice(0, 2), tone: 'danger' })) { sw.setAttribute('aria-checked', 'false'); sw.dispatchEvent(new CustomEvent('lz:toggle', { bubbles: true })); }
    };
    root.addEventListener('click', g, true); root.addEventListener('keydown', g, true);
  };

  /* 001 基础文本框 与 002 四态 */
  (() => {
    const i = $('[data-err]', $('#wb-fm-t2')), f = fieldOf(i);
    i.addEventListener('input', () => mark(f, !i.value.trim()));
  })();
  /* 004 可清空 */
  (() => {
    const root = $('#wb-fm-t4'), i = $('input', root), x = $('.wb-fm-x', root), upd = () => { x.hidden = !i.value; };
    i.addEventListener('input', upd); i.addEventListener('keydown', e => { if (e.key === 'Escape' && i.value) { i.value = ''; upd(); } });
    x.addEventListener('click', () => { i.value = ''; upd(); i.focus(); }); upd();
  })();
  /* 005 密码：显示切换与强度 */
  (() => {
    const root = $('#wb-fm-t5'), i = $('input', root), b = $('[data-show]', root), m = $('.wb-fm-meter', root), L = ['未填', '弱', '中', '强'];
    const score = v => !v ? 0 : 1 + (v.length >= 8 && /[a-zA-Z]/.test(v) && /\d/.test(v) ? 1 : 0) + (v.length >= 12 && /[^a-zA-Z\d]/.test(v) ? 1 : 0);
    i.addEventListener('input', () => { const s = score(i.value); m.dataset.s = s; $('span', m).textContent = L[s]; });
    b.addEventListener('click', () => { const on = i.type === 'password'; i.type = on ? 'text' : 'password'; b.textContent = on ? '隐藏' : '显示'; b.setAttribute('aria-pressed', String(on)); });
  })();

  /* 开合与键盘：自制选择层共用 */
  const popup = (pick, onOpen) => {
    const ctl = $('.wb-fm-ctl', pick), pop = $('.wb-fm-pop', pick);
    const open = o => { pick.dataset.open = String(o); ctl.setAttribute('aria-expanded', String(o)); pop.inert = !o; if (o && onOpen) onOpen(); };
    ctl.addEventListener('click', e => { e.stopPropagation(); $$('#cat-form .wb-fm-pick[data-open="true"]').forEach(p => { if (p !== pick) p._open(false); }); open(pick.dataset.open !== 'true'); });
    pop.addEventListener('click', e => e.stopPropagation());
    pick.addEventListener('keydown', e => { if (e.key === 'Escape' && pick.dataset.open === 'true') { open(false); ctl.focus(); } });
    document.addEventListener('click', () => { if (pick.dataset.open === 'true') open(false); });
    pick._open = open; return { ctl, pop, open };
  };

  /* 007 下拉选择与键盘 */
  $$('#cat-form .drop').forEach(d => { const m = $('.drop__menu', d); if (!m) return; const s = () => { m.inert = d.dataset.open !== 'true'; }; new MutationObserver(s).observe(d, { attributes: true, attributeFilter: ['data-open'] }); s(); });
  document.addEventListener('keydown', e => {
    const d = e.target.closest && e.target.closest('#cat-form .drop'); if (!d || !['ArrowDown', 'ArrowUp'].includes(e.key)) return;
    const opts = $$('.drop__opt', d); if (!opts.length) return; e.preventDefault();
    if (d.dataset.open !== 'true') { $('.drop__btn', d).click(); setTimeout(() => (opts.find(o => o.getAttribute('aria-selected') === 'true') || opts[0]).focus(), 0); return; }
    const i = opts.indexOf(document.activeElement); opts[Math.max(0, Math.min(opts.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))].focus();
  });

  /* 008 可搜索下拉 */
  (() => {
    const root = $('#wb-fm-cb'), pick = $('.wb-fm-pick', root), q = $('input', root), list = $('.wb-fm-list', root); let sel = '';
    const render = () => {
      const k = q.value.trim(), r = PR.filter(p => !k || (p.n + p.c).includes(k));
      list.innerHTML = r.length ? r.map(p => `<button type="button" class="wb-fm-opt" role="option" aria-selected="${sel === p.n}" data-n="${p.n}"><img src="${img(p.i)}" alt=""><span>${p.n}<small>${p.c}</small></span></button>`).join('') : '<p class="wb-fm-none">没有匹配的商品</p>';
    };
    const { ctl, open } = popup(pick, () => { q.value = ''; render(); setTimeout(() => q.focus(), 40); });
    list.addEventListener('click', e => { const b = e.target.closest('.wb-fm-opt'); if (!b) return; sel = b.dataset.n; const p = PR.find(x => x.n === sel); ctl.innerHTML = `<span class="wb-fm-crumb"><img src="${img(p.i)}" alt="">${sel}</span>`; open(false); ctl.focus(); });
    q.addEventListener('input', render);
    root.addEventListener('keydown', e => {
      if (!['ArrowDown', 'ArrowUp'].includes(e.key)) return; const o = $$('.wb-fm-opt', list); if (!o.length) return; e.preventDefault();
      const i = o.indexOf(document.activeElement); if (e.key === 'ArrowDown') o[Math.min(o.length - 1, i + 1)].focus(); else if (i <= 0) q.focus(); else o[i - 1].focus();
    });
    render();
  })();

  /* 009 级联选择：三级逐列收窄，无下级时即完成 */
  (() => {
    const root = $('#wb-fm-cs'), pick = $('.wb-fm-pick', root), cols = $$('.wb-fm-cas', root);
    const T = { 鲜花: { 花束: ['红玫瑰花束', '粉芍药花束', '向日葵花束', '白郁金香'], 鲜切单枝: null }, 绿植: { 盆栽: ['蓝绣球盆栽', '龟背竹盆栽', '多肉组合盆'], 水培: null }, 礼盒: { 节日礼盒: ['花礼盒'], 生日礼盒: null }, 花器: { 花瓶: ['干花花瓶摆件'], 花盆: null } };
    let path = [];
    const items = l => l === 0 ? Object.keys(T) : l === 1 ? Object.keys(T[path[0]] || {}) : (T[path[0]] && T[path[0]][path[1]]) || [];
    const more = (l, v) => l === 0 || (l === 1 && Array.isArray(T[path[0]][v]));
    const draw = () => cols.forEach((c, l) => { c.innerHTML = items(l).map(v => `<button type="button" class="wb-fm-opt" role="option" data-l="${l}" data-v="${v}" aria-selected="${path[l] === v}"${more(l, v) ? ' data-more="true"' : ''}>${v}</button>`).join(''); });
    const { ctl, open } = popup(pick);
    $('.wb-fm-pop', root).addEventListener('click', e => {
      const b = e.target.closest('.wb-fm-opt'); if (!b) return; const l = +b.dataset.l, v = b.dataset.v;
      path = path.slice(0, l); path[l] = v;
      if (more(l, v)) { draw(); return; }
      draw(); ctl.innerHTML = `<span class="wb-fm-crumb">${path.join('<i></i>')}</span>`; open(false); ctl.focus();
    });
    draw();
  })();

  /* 010 多选标签：最多五个 */
  (() => {
    const root = $('#wb-fm-mc'), chips = $$('.wb-fm-chip', root), n = $('[data-n]', root), MAX = 5;
    const sync = () => { const c = chips.filter(x => x.getAttribute('aria-pressed') === 'true').length; n.textContent = c; chips.forEach(x => { x.disabled = c >= MAX && x.getAttribute('aria-pressed') !== 'true'; }); };
    chips.forEach(b => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); sync(); }));
    sync();
  })();

  /* 011 标签输入框：回车添加，退格删除末个 */
  (() => {
    const root = $('#wb-fm-ti'), box = $('.wb-fm-tagbox', root), inp = $('input', box), n = $('[data-n]', root), er = $('[data-err]', root), MAX = 6; let tags = ['玫瑰', '生日花束'];
    const draw = () => {
      $$('.wb-fm-chip', box).forEach(x => x.remove());
      tags.forEach(t => inp.insertAdjacentHTML('beforebegin', `<span class="wb-fm-chip wb-fm-chip--tag">${t}<button type="button" class="wb-fm-x" data-t="${t}" data-tip="删除${t}" aria-label="删除${t}"><img src="../../kit/assets/line/close.webp" alt=""></button></span>`));
      n.textContent = tags.length;
    };
    const say = m => { er.textContent = m || ''; er.hidden = !m; };
    const add = () => {
      const v = inp.value.replace(/[，,]/g, '').trim(); if (!v) { inp.value = ''; return; }
      if (tags.includes(v)) return say('标签已存在'); if (v.length > 10) return say('标签不超过 10 个字'); if (tags.length >= MAX) return say('最多添加 6 个标签');
      tags.push(v); inp.value = ''; say(''); draw();
    };
    inp.addEventListener('keydown', e => {
      if (e.isComposing) return;
      if (e.key === 'Enter' || e.key === ',' || e.key === '，') { e.preventDefault(); add(); }
      else if (e.key === 'Backspace' && !inp.value && tags.length) { tags.pop(); draw(); }
    });
    inp.addEventListener('input', () => say(''));
    box.addEventListener('click', e => { const x = e.target.closest('[data-t]'); if (x) { tags = tags.filter(t => t !== x.dataset.t); say(''); draw(); inp.focus(); } else inp.focus(); });
    draw();
  })();

  /* 012 013 单选：点击与方向键，单一停靠 */
  const radios = g => {
    const items = $$('[role="radio"]:not([aria-disabled="true"])', g);
    const set = o => items.forEach(p => { p.setAttribute('aria-checked', String(p === o)); p.tabIndex = p === o ? 0 : -1; });
    items.forEach((o, i) => { o.addEventListener('click', () => set(o)); o.addEventListener('keydown', e => { const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return; e.preventDefault(); const nx = items[(i + d + items.length) % items.length]; nx.focus(); set(nx); }); });
  };
  $$('#wb-fm-rd [role="radiogroup"], #wb-fm-rc [role="radiogroup"]').forEach(radios);

  /* 014 勾选组：全选与半选 */
  (() => {
    const root = $('#wb-fm-ck'), all = $('[data-all]', root), its = $$('[data-it]', root), n = $('[data-n]', root);
    document.addEventListener('lz:toggle', e => {
      if (!root.contains(e.target)) return;
      if (e.target === all) { const v = all.getAttribute('aria-checked'); its.forEach(i => { i.setAttribute('aria-checked', v); $('.check', i).setAttribute('aria-checked', v); }); }
      const c = its.filter(i => i.getAttribute('aria-checked') === 'true').length; all.setAttribute('aria-checked', c === its.length ? 'true' : c ? 'mixed' : 'false'); $('.check', all).setAttribute('aria-checked', all.getAttribute('aria-checked')); n.textContent = c;
    });
    $$('.wb-fm-row', root).forEach(r => r.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); r.click(); } }));
  })();

  /* 015 开关设置行 */
  (() => {
    const root = $('#wb-fm-sw'); guard(root);
    root.addEventListener('lz:toggle', e => { const sw = e.target.closest('.switch'); if (!sw) return; const on = sw.getAttribute('aria-checked') === 'true', t = sw.dataset.ask ? ['已暂停', '营业中'] : ['已关闭', '已开启']; $('[data-s]', sw.closest('.wb-fm-row')).textContent = on ? t[1] : t[0]; if (on && sw.dataset.ask) Lz.toast('已恢复营业', 'success'); });
    $$('[data-s]', root).forEach(s => { const sw = $('.switch', s.closest('.wb-fm-row')); if (sw.dataset.ask && sw.getAttribute('aria-checked') === 'true') s.textContent = '营业中'; });
  })();

  /* 016 017 滚轮：合计与时间随值更新 */
  (() => {
    const root = $('#wb-fm-wh'), t = $('[data-t]', root);
    const upd = v => { t.innerHTML = '<small>¥</small>' + fmt(Math.max(0, parseInt(v, 10) || 0) * 89, 0); };
    document.addEventListener('lz:wheel', e => { if (e.target.closest('#wb-fm-wh')) upd(e.detail.value); });
    document.addEventListener('input', e => { if (e.target.closest('#wb-fm-wh .input')) upd(e.target.value); });
    const tm = $('#wb-fm-tm'), out = $('[data-t]', tm), pad = n => String(Math.max(0, parseInt(n, 10) || 0)).padStart(2, '0');
    const draw = () => { const [h, m] = $$('.wheel .input', tm).map(i => i.value); out.textContent = `${pad(h)} 时 ${pad(m)} 分`; };
    document.addEventListener('lz:wheel', e => { if (e.target.closest('#wb-fm-tm')) setTimeout(draw, 0); });
    document.addEventListener('input', e => { if (e.target.closest('#wb-fm-tm .input')) draw(); });
  })();

  /* 018 实时搜索：命中词高亮 */
  (() => {
    const root = $('#wb-fm-sq'), q = $('input', root), box = $('.wb-fm-hits', root);
    const render = () => {
      const k = q.value.trim(), r = PR.filter(p => !k || (p.n + p.c).includes(k)).slice(0, 5);
      box.innerHTML = r.length ? r.map(p => `<button type="button" class="wb-fm-hit"><img src="${img(p.i)}" alt=""><span>${k ? p.n.replace(k, m => `<mark>${m}</mark>`) : p.n}</span><small>${p.c}</small></button>`).join('') : '<p class="wb-fm-none">没有匹配的商品</p>';
    };
    q.addEventListener('input', render); box.addEventListener('click', e => { const b = e.target.closest('.wb-fm-hit'); if (b) { q.value = b.textContent.replace(/鲜花|绿植|礼盒|花器$/, ''); render(); } });
    render();
  })();

  /* 019 单行筛选条：条件都收进下拉，结果同区更新 */
  (() => {
    const root = $('#wb-fm-fb'), q = $('.search input', root), n = $('[data-n]', root), clr = $('[data-clear]', root), f = { m: '', c: '', t: '' };
    const strip = document.createElement('div'); strip.className = 'wb-fm-strip'; root.appendChild(strip);
    const render = () => {
      const k = q.value.trim(), r = PR.filter(p => (!f.m || p.s === f.m) && (!f.c || p.c === f.c) && (!f.t || p.t === f.t) && (!k || (p.n + p.c).includes(k)));
      strip.innerHTML = r.length ? r.map(p => `<span class="wb-fm-pill"><img src="${img(p.i)}" alt="">${p.n}</span>`).join('') : '<p class="wb-fm-none">没有符合条件的商品</p>';
      n.textContent = r.length; clr.hidden = !(f.m || f.c || f.t || k);
    };
    root.addEventListener('lz:drop', e => { const d = e.target.closest('.drop'); f[d.dataset.k] = e.detail.value; d.dataset.on = String(!!e.detail.value); render(); });
    q.addEventListener('input', render);
    clr.addEventListener('click', () => { q.value = ''; Object.keys(f).forEach(k => { f[k] = ''; }); $$('.drop', root).forEach(d => { $('b', d).textContent = '全部'; d.dataset.on = 'false'; $$('.drop__opt', d).forEach((o, i) => o.setAttribute('aria-selected', String(i === 0))); }); render(); });
    render();
  })();

  /* 020 搜索表单：点查询才筛选，更多条件就近展开 */
  (() => {
    const root = $('#wb-fm-sf'), n = $('[data-n]', root), v = { st: '', store: '', span: '' };
    const val = k => ($(`input[data-k="${k}"]`, root) || {}).value || '';
    root.addEventListener('lz:drop', e => { const d = e.target.closest('.drop'); v[d.dataset.k] = e.detail.value; });
    const go = () => {
      const no = val('no').trim(), who = val('who').trim(), lo = parseFloat(val('min')), hi = parseFloat(val('max'));
      const r = ORD.filter(o => (!no || o.no.includes(no)) && (!who || o.who.includes(who)) && (!v.st || o.st === v.st) && (!v.store || o.store === v.store) && (Number.isNaN(lo) || o.amt >= lo) && (Number.isNaN(hi) || o.amt <= hi));
      n.textContent = r.length;
    };
    $('[data-go]', root).addEventListener('click', go);
    root.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.matches('input') && !e.isComposing) go(); });
    $('[data-reset]', root).addEventListener('click', () => { $$('input', root).forEach(i => { i.value = ''; }); Object.keys(v).forEach(k => { v[k] = ''; }); $$('.drop', root).forEach(d => { $('b', d).textContent = $('.drop__opt', d).textContent; $$('.drop__opt', d).forEach((o, i) => o.setAttribute('aria-selected', String(i === 0))); }); n.textContent = ORD.length; });
  })();

  /* 021 图片上传：真实选图，带进度，可删除，限四张 */
  (() => {
    const root = $('#wb-fm-ph'), box = $('.wb-fm-ups', root), file = $('input[type="file"]', root), cnt = $('[data-n]', root), MAX = 4;
    let items = [{ src: img('rose-red') }, { src: img('peony-pink') }, { src: img('sunflower') }];
    const draw = () => {
      box.innerHTML = items.map((it, i) => `<div class="wb-fm-up"${it.busy ? ' data-busy="true"' : ''}><img src="${it.src}" alt="">${i === 0 ? '<span class="tag" data-tone="action">主图</span>' : ''}${it.busy ? `<span class="progress" style="--v:${it.pct}%"><i></i></span>` : `<button type="button" class="ibtn wb-fm-x" data-i="${i}" data-tip="删除图片" aria-label="删除第 ${i + 1} 张图片"><img src="../../kit/assets/line/close.webp" alt=""></button>`}</div>`).join('') + (items.length < MAX ? '<button type="button" class="wb-fm-add" data-add><span><img src="../../kit/assets/line/add.webp" alt="">添加图片</span></button>' : '');
      cnt.textContent = items.length;
    };
    box.addEventListener('click', e => { if (e.target.closest('[data-add]')) file.click(); const x = e.target.closest('[data-i]'); if (x) { items.splice(+x.dataset.i, 1); draw(); } });
    file.addEventListener('change', () => {
      [...file.files].forEach(f => {
        if (!f.type.startsWith('image/')) return Lz.toast('仅支持图片文件', 'danger');
        if (items.length >= MAX) return Lz.toast('最多上传 4 张', 'danger');
        const it = { src: URL.createObjectURL(f), busy: true, pct: 0 }; items.push(it); draw();
        const t = setInterval(() => { it.pct = Math.min(100, it.pct + 14 + Math.round(Math.random() * 10)); if (it.pct >= 100) { clearInterval(t); it.busy = false; } draw(); }, 140);
      });
      file.value = '';
    });
    draw();
  })();

  /* 022 文件上传区：拖入或点选，逐个显示进度 */
  (() => {
    const root = $('#wb-fm-fl'), zone = $('.wb-fm-zone', root), file = $('input[type="file"]', root), list = $('.wb-fm-files', root); const rows = [];
    const size = b => b < 1048576 ? Math.max(1, Math.round(b / 1024)) + ' 千字节' : (b / 1048576).toFixed(1) + ' 兆';
    const draw = () => { list.innerHTML = rows.map((r, i) => `<div class="wb-fm-file"><img src="../../kit/assets/solid/solid-tasks.webp" alt=""><b>${r.name}</b>${r.pct >= 100 ? '<span class="tag" data-tone="success">已完成</span>' : ''}<small>${size(r.size)}</small>${r.pct < 100 ? `<span class="progress" style="--v:${r.pct}%"><i></i></span>` : ''}<button type="button" class="ibtn wb-fm-x" data-i="${i}" data-tip="移除文件" aria-label="移除${r.name}"><img src="../../kit/assets/line/close.webp" alt=""></button></div>`).join(''); };
    const take = fs => [...fs].forEach(f => {
      if (!/\.(csv|xlsx|xls)$/i.test(f.name)) return Lz.toast('仅支持表格文件', 'danger');
      if (f.size > 10485760) return Lz.toast('文件超过 10 兆', 'danger');
      const r = { name: f.name, size: f.size, pct: 0 }; rows.push(r); draw();
      const t = setInterval(() => { r.pct = Math.min(100, r.pct + 12 + Math.round(Math.random() * 12)); if (r.pct >= 100) { clearInterval(t); Lz.toast('上传完成', 'success'); } if (rows.includes(r)) draw(); else clearInterval(t); }, 150);
    });
    zone.addEventListener('click', () => file.click());
    file.addEventListener('change', () => { take(file.files); file.value = ''; });
    ['dragenter', 'dragover'].forEach(t => zone.addEventListener(t, e => { e.preventDefault(); zone.dataset.over = 'true'; }));
    ['dragleave', 'drop'].forEach(t => zone.addEventListener(t, e => { e.preventDefault(); zone.dataset.over = 'false'; if (t === 'drop') take(e.dataTransfer.files); }));
    list.addEventListener('click', e => { const x = e.target.closest('[data-i]'); if (x) { rows.splice(+x.dataset.i, 1); draw(); } });
  })();

  /* 表单提交：逐项校验，失败聚焦首个错误并保留输入 */
  const wire = (form, rules, done) => {
    const check = r => { const bad = !r.ok(); mark(fieldOf(r.el), bad, bad ? r.msg : undefined); return !bad; };
    rules.forEach(r => { const re = () => { if ($('[aria-invalid="true"]', fieldOf(r.el))) check(r); }; r.el.addEventListener('input', re); form.addEventListener('lz:drop', e => { if (fieldOf(r.el).contains(e.target)) re(); }); });
    form.addEventListener('submit', async e => {
      e.preventDefault(); let first = null;
      rules.forEach(r => { if (!check(r) && !first) first = r; });
      if (first) { const c = $('.input, .textarea, .drop__btn', fieldOf(first.el)); if (c) c.focus(); return; }
      const b = $('[type="submit"]', form); b.classList.add('is-loading'); await sleep(800); b.classList.remove('is-loading'); Lz.toast('已保存', 'success'); if (done) done();
    });
    const cancel = $('[data-cancel]', form);
    if (cancel) cancel.addEventListener('click', () => { form.reset(); $$('[aria-invalid="true"]', form).forEach(x => x.setAttribute('aria-invalid', 'false')); $$('.field__err', form).forEach(x => { x.hidden = true; }); Lz.toast('已取消'); });
  };
  const dropOk = d => !$('b', d).classList.contains('wb-fm-ph');
  (() => {
    const f = $('#wb-fm-f1'), c = $('.drop[data-k="c"]', f);
    wire(f, [{ el: $('[data-k="n"]', f), ok: () => !!$('[data-k="n"]', f).value.trim() }, { el: c, ok: () => dropOk(c) }, { el: $('[data-k="p"]', f), ok: () => +$('[data-k="p"]', f).value > 0 }]);
  })();
  (() => { const f = $('#wb-fm-f2'), n = $('[data-k="n"]', f), p = $('[data-k="p"]', f); wire(f, [{ el: n, ok: () => !!n.value.trim() }, { el: p, ok: () => +p.value > 0 }]); })();
  (() => { const f = $('#wb-fm-f3'), n = $('[data-k="n"]', f), p = $$('input[data-f="money"]', f)[0]; wire(f, [{ el: n, ok: () => !!n.value.trim() }, { el: p, ok: () => +p.value > 0, msg: '请输入大于 0 的价格' }]); $$('.wb-fm-chip', f).forEach(b => b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')))); })();

  /* 026 分步表单：每步校验后才能前进，完成步显示勾 */
  (() => {
    const root = $('#wb-fm-sp'), panes = $$('.wb-fm-pane', root), steps = $$('.wb-fm-step', root), bars = $$('.wb-fm-steps hr', root), prev = $('[data-prev]', root), next = $('[data-next]', root);
    let cur = 0;
    const draw = () => {
      steps.forEach((s, i) => { s.dataset.state = i < cur ? 'done' : i === cur ? 'now' : 'todo'; $('span', s).innerHTML = i < cur ? '<img src="../../kit/assets/line/check.webp" alt="已完成">' : String(i + 1); });
      bars.forEach((h, i) => { h.dataset.done = String(i < cur); });
      panes.forEach((p, i) => { p.hidden = i !== cur; }); $$('.wheel', panes[cur]).forEach(w => w._lzSync && w._lzSync());
      prev.disabled = cur === 0; next.textContent = cur === 2 ? '提交' : '下一步';
      if (cur === 2) { const g = k => ($(`[data-k="${k}"]`, root) || {}); $('[data-v="n"]', root).textContent = g('n').value; $('[data-v="c"]', root).textContent = $('.drop[data-k="c"] b', root).textContent; $('[data-v="p"]', root).textContent = '¥' + fmt(+g('p').value || 0); $('[data-v="s"]', root).textContent = $('.wheel .input', root).value + ' 件'; }
    };
    next.addEventListener('click', async () => {
      if (cur === 0) { const n = $('[data-k="n"]', root), bad = !n.value.trim(); mark(fieldOf(n), bad); if (bad) { n.focus(); return; } }
      if (cur === 1) { const p = $('[data-k="p"]', root), bad = !(+p.value > 0); mark(fieldOf(p), bad); if (bad) { p.focus(); return; } }
      if (cur === 2) { next.classList.add('is-loading'); await sleep(800); next.classList.remove('is-loading'); Lz.toast('已提交', 'success'); cur = 0; $('[data-k="n"]', root).value = ''; draw(); return; }
      cur++; draw();
    });
    prev.addEventListener('click', () => { cur = Math.max(0, cur - 1); draw(); });
    root.addEventListener('input', e => { const f = fieldOf(e.target); if (f && $('[aria-invalid="true"]', f)) mark(f, false); });
    draw();
  })();

  /* 027 行内表单：券码核销 */
  (() => {
    const root = $('#wb-fm-in'), i = $('input', root), er = $('.field__err', root), go = $('[data-go]', root), out = $('.wb-fm-result', root); let busy = false;
    const say = m => { er.textContent = m || ''; er.hidden = !m; i.setAttribute('aria-invalid', String(!!m)); };
    const run = async () => {
      if (busy) return; out.innerHTML = '';
      if (!/^\d{6}$/.test(i.value)) { say('券码为 6 位数字'); i.focus(); return; }
      say(''); busy = true; go.classList.add('is-loading'); await sleep(800); go.classList.remove('is-loading'); busy = false;
      if (i.value === '123456') say('券码已核销'); else { out.innerHTML = '<span class="tag" data-tone="success">核销成功</span><span>满 99 减 20</span>'; Lz.toast('已核销', 'success'); i.value = ''; }
    };
    go.addEventListener('click', run); i.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing) run(); }); i.addEventListener('input', () => { i.value = i.value.replace(/\D/g, ''); say(''); out.innerHTML = ''; });
  })();

  /* 028 登录表单 */
  (() => {
    const f = $('#wb-fm-lg'), a = $('[data-k="a"]', f), w = $('[data-k="w"]', f), al = $('.wb-fm-alert', f), b = $('[data-show]', f);
    a.addEventListener('input', () => { a.value = a.value.replace(/\D/g, ''); if ($('[aria-invalid="true"]', fieldOf(a))) mark(fieldOf(a), !/^1\d{10}$/.test(a.value)); al.hidden = true; });
    w.addEventListener('input', () => { if ($('[aria-invalid="true"]', fieldOf(w))) mark(fieldOf(w), !w.value); al.hidden = true; });
    b.addEventListener('click', () => { const on = w.type === 'password'; w.type = on ? 'text' : 'password'; b.textContent = on ? '隐藏' : '显示'; b.setAttribute('aria-pressed', String(on)); });
    f.addEventListener('submit', async e => {
      e.preventDefault(); al.hidden = true;
      const badA = !/^1\d{10}$/.test(a.value), badW = !w.value; mark(fieldOf(a), badA); mark(fieldOf(w), badW);
      if (badA || badW) { (badA ? a : w).focus(); return; }
      const s = $('[type="submit"]', f); s.classList.add('is-loading'); await sleep(900); s.classList.remove('is-loading');
      if (w.value === '000000') { al.hidden = false; return; } Lz.toast('登录成功', 'success');
    });
  })();

  /* 029 校验错误提示 */
  (() => {
    const f = $('#wb-fm-vd'), sum = $('.wb-fm-err-sum', f);
    const R = { phone: v => /^1\d{10}$/.test(v) ? '' : v ? '请输入 11 位手机号' : '请输入手机号', disc: v => !v ? '请输入折扣' : /^\d+(\.\d)?$/.test(v) && +v >= 1 && +v <= 9.9 ? '' : '折扣需在 1 到 9.9 之间', note: v => v.trim() ? '' : '请输入备注内容' };
    const els = $$('[data-r]', f), touched = new Set();
    const one = i => { const m = R[i.dataset.r](i.value); mark(fieldOf(i), !!m, m); return !m; };
    const total = () => { const bad = els.filter(i => R[i.dataset.r](i.value)).length; sum.hidden = !(bad && touched.size === els.length); sum.textContent = `还有 ${bad} 项未通过`; };
    els.forEach(i => { i.addEventListener('blur', () => { if (!i.value && !touched.has(i)) return; touched.add(i); one(i); total(); }); i.addEventListener('input', () => { if (touched.has(i)) { one(i); total(); } }); });
    f.addEventListener('submit', async e => {
      e.preventDefault(); els.forEach(i => touched.add(i)); const ok = els.map(one).every(Boolean); total();
      if (!ok) { els.find(i => R[i.dataset.r](i.value)).focus(); return; }
      const b = $('[type="submit"]', f); b.classList.add('is-loading'); await sleep(800); b.classList.remove('is-loading'); Lz.toast('已提交', 'success');
    });
    $('[data-reset]', f).addEventListener('click', () => { f.reset(); touched.clear(); els.forEach(i => mark(fieldOf(i), false)); sum.hidden = true; });
  })();

  /* 030 必填标记：填好后转绿 */
  (() => {
    const root = $('#wb-fm-rq');
    $$('[data-need]', root).forEach(i => { const m = $('[data-m]', fieldOf(i)); const u = () => { const ok = !!i.value.trim(); m.dataset.ok = String(ok); if (m.dataset.t) m.textContent = ok ? '已填' : m.dataset.t; }; i.addEventListener('input', u); u(); });
  })();

  /* 031 提交条：有改动才可保存 */
  (() => {
    const root = $('#wb-fm-sb'), t = $('textarea', root), tag = $('.wb-fm-dirty', root), cancel = $('[data-cancel]', root), save = $('[data-save]', root);
    const upd = () => { const d = t.value !== t.dataset.saved; tag.hidden = !d; cancel.disabled = !d; save.disabled = !d || !t.value.trim(); };
    t.addEventListener('input', upd);
    cancel.addEventListener('click', () => { t.value = t.dataset.saved; t.dispatchEvent(new Event('input')); });
    save.addEventListener('click', async () => { save.classList.add('is-loading'); await sleep(800); save.classList.remove('is-loading'); t.dataset.saved = t.value; upd(); Lz.toast('已保存', 'success'); });
    upd();
  })();

  /* 032 表单卡壳 */
  (() => {
    const root = $('#wb-fm-sh'); guard(root);
    const ins = $$('input', root), init = ins.map(i => i.value), n = $('[data-k="n"]', root), sw = $('.switch', root), st = $('[data-s]', root);
    root.addEventListener('lz:toggle', e => { const on = sw.getAttribute('aria-checked') === 'true'; st.textContent = on ? '营业中' : '已暂停'; });
    n.addEventListener('input', () => { if (n.value.trim()) mark(fieldOf(n), false); });
    $('[data-save]', root).addEventListener('click', async e => { if (!n.value.trim()) { mark(fieldOf(n), true); n.focus(); return; } const b = e.currentTarget; b.classList.add('is-loading'); await sleep(800); b.classList.remove('is-loading'); ins.forEach((i, k) => { init[k] = i.value; }); Lz.toast('已保存', 'success'); });
    $('[data-cancel]', root).addEventListener('click', () => { ins.forEach((i, k) => { i.value = init[k]; }); mark(fieldOf(n), false); Lz.toast('已取消'); });
  })();
})();
</script>

<style>
  /* 新增表单组件 033 至 045：沿用 wb-fm- 前缀，各组件再加自己的缩写（ms 多选、cal 月历、dt 日期时间、tr 树、tf 穿梭、otp 验证码、ie 原位编辑、rt 评分、cp 颜色、cmd 命令、crop 裁剪、mn 提及、au 自适应） */
  .wb-fm-pick > .wb-fm-pop.wb-fm-ms-pop { padding: 0; }
  .wb-fm-ms-sum { display: inline-flex; align-items: center; gap: var(--s-2); min-width: 0; }
  .wb-fm-ms-sum .avatars .avatar { width: 24px; height: 24px; padding: 3px; margin-left: -6px; border-width: 1px; }
  .wb-fm-ms-sum .avatars .avatar:first-child { margin-left: 0; }
  .wb-fm-ms-list { max-height: 272px; overflow-y: auto; padding: 0 var(--s-1) var(--s-1); scrollbar-width: thin; }
  .wb-fm-ms-gh { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; min-height: 32px; padding: 0 var(--s-2); background: var(--surface); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); }
  .wb-fm-ms-gt { min-height: 28px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-xs); font-weight: 500; color: var(--action-press); }
  .wb-fm-ms-row { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 44px; padding: 0 var(--s-2); border-radius: var(--r-sm); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-ms-row .avatar { width: 28px; height: 28px; padding: 3px; }
  .wb-fm-ms-nm { flex: 1; min-width: 0; }
  .wb-fm-ms-row small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-ms-row[aria-selected="true"] { background: var(--action-tint); }
  .wb-fm-ms-row:disabled { opacity: .45; pointer-events: none; }
  .wb-fm-ms-row mark, .wb-fm-tr-l mark, .wb-fm-tf-i mark, .wb-fm-cmd-i mark { background: var(--action-tint); color: var(--action-press); font-weight: 600; border-radius: 3px; }
  @media (hover: hover) { .wb-fm-ms-row:hover, .wb-fm-ms-gt:hover { background: var(--zone); } }
  .wb-fm-ms-row:focus-visible, .wb-fm-ms-gt:focus-visible { outline: none; background: var(--zone); }
  .wb-fm-ms-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 52px; padding: var(--s-2) var(--s-3); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-3); }
  .wb-fm-ms-acts { display: flex; align-items: center; gap: var(--s-2); }
  .wb-fm-ms-chosen:empty { display: none; }

  /* 月历：日期选择框与日期时间选择器共用 */
  .wb-fm-dp-pop, .wb-fm-dt-pop { right: auto; padding: var(--s-3); }
  .wb-fm-dp-pop { width: 308px; max-width: 100%; }
  .wb-fm-cal__bar { display: grid; grid-template-columns: 36px minmax(0, 1fr) 36px; align-items: center; gap: var(--s-1); margin-bottom: var(--s-2); }
  .wb-fm-cal__n { position: relative; width: 36px; height: 36px; border-radius: var(--r-sm); transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-cal__n::before { content: ""; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; border: solid var(--ink-2); border-width: 0 0 1.8px 1.8px; transform: translate(-30%, -50%) rotate(45deg); }
  .wb-fm-cal__n--r::before { transform: translate(-70%, -50%) rotate(-135deg); }
  .wb-fm-cal__t { min-height: 36px; border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 600; text-align: center; transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-cal__wk, .wb-fm-cal__g { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .wb-fm-cal__wk span { display: grid; place-items: center; height: 28px; font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-cal__g { gap: 2px; }
  .wb-fm-cal__d { display: grid; place-items: center; height: 36px; border-radius: var(--r-sm); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-fm-cal__d[data-out="true"] { color: var(--ink-3); }
  .wb-fm-cal__d[data-now="true"] { box-shadow: inset 0 0 0 1.5px var(--action); }
  .wb-fm-cal__d[aria-pressed="true"] { background: var(--action); color: var(--surface); font-weight: 600; }
  .wb-fm-cal__d:disabled { color: var(--ink-3); opacity: .4; pointer-events: none; }
  .wb-fm-cal__m { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); }
  .wb-fm-cal__mi { min-height: 52px; border-radius: var(--r-sm); font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-cal__mi[aria-pressed="true"] { background: var(--action); color: var(--surface); font-weight: 600; }
  .wb-fm-cal__foot { display: flex; align-items: center; justify-content: space-between; margin-top: var(--s-2); padding-top: var(--s-2); border-top: 1px solid var(--line); }
  @media (hover: hover) { .wb-fm-cal__n:hover, .wb-fm-cal__t:hover, .wb-fm-cal__mi:not([aria-pressed="true"]):hover, .wb-fm-cal__d:not([aria-pressed="true"]):not(:disabled):hover { background: var(--zone); } }
  .wb-fm-cal__n:focus-visible, .wb-fm-cal__t:focus-visible, .wb-fm-cal__mi:focus-visible, .wb-fm-cal__d:focus-visible { outline: 2px solid var(--ink-2); outline-offset: -2px; }
  .wb-fm-dt-pop { width: 436px; max-width: 100%; }
  .wb-fm-dt-body { display: flex; align-items: stretch; gap: var(--s-3); }
  .wb-fm-dt-cal { flex: 1; min-width: 0; }
  .wb-fm-dt-time { display: grid; grid-template-columns: repeat(2, 52px); gap: var(--s-1); padding-left: var(--s-3); border-left: 1px solid var(--line); }
  .wb-fm-dt-w { position: relative; min-height: 0; }
  .wb-fm-dt-th { display: grid; place-items: center; height: 36px; margin-bottom: var(--s-2); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); }
  .wb-fm-dt-col { position: absolute; inset: 44px 0 0 0; display: grid; align-content: start; gap: 2px; overflow-y: auto; scrollbar-width: none; }
  .wb-fm-dt-col::-webkit-scrollbar { display: none; }
  .wb-fm-dt-i { display: grid; place-items: center; min-height: 36px; border-radius: var(--r-sm); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-dt-i[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
  @media (hover: hover) { .wb-fm-dt-i:hover { background: var(--zone); } }
  .wb-fm-dt-i:focus-visible { outline: 2px solid var(--ink-2); outline-offset: -2px; }

  /* 树选择器 */
  .wb-fm-tr-list { max-height: 252px; overflow-y: auto; padding: 0 var(--s-1) var(--s-1); scrollbar-width: thin; }
  .wb-fm-tr-n { display: flex; align-items: center; gap: var(--s-1); min-height: 40px; padding: 0 var(--s-3) 0 calc(var(--s-1) + var(--lv, 0) * 22px); border-radius: var(--r-sm); font-size: var(--fs-sm); cursor: pointer; transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-tr-t { position: relative; flex: none; width: 24px; height: 24px; border-radius: 6px; }
  .wb-fm-tr-t[data-t]::before { content: ""; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; border: solid var(--ink-3); border-width: 0 1.6px 1.6px 0; transform: translate(-65%, -50%) rotate(-45deg); transition: transform var(--dur-base) var(--ease-out); }
  .wb-fm-tr-n[aria-expanded="true"] > .wb-fm-tr-t::before { transform: translate(-50%, -65%) rotate(45deg); }
  .wb-fm-tr-n > small { margin-left: auto; font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-tr-n[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; }
  .wb-fm-tr-n[aria-disabled="true"] { opacity: .5; cursor: not-allowed; }
  @media (hover: hover) { .wb-fm-tr-n:not([aria-selected="true"]):not([aria-disabled="true"]):hover { background: var(--zone); } .wb-fm-tr-t[data-t]:hover { background: var(--action-edge); } }
  .wb-fm-tr-n:focus-visible { outline: none; background: var(--zone); }
  .wb-fm-tr-n[aria-selected="true"]:focus-visible { background: var(--action-soft); }

  /* 穿梭框 */
  .wb-fm-tf { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: var(--s-3); }
  .wb-fm-tf-p { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr); min-width: 0; border: 1px solid var(--line-strong); border-radius: var(--r-md); overflow: hidden; background: var(--surface); }
  .wb-fm-tf-h { display: flex; align-items: center; gap: var(--s-2); width: 100%; min-height: 44px; padding: 0 var(--s-3); background: var(--zone); font-size: var(--fs-sm); text-align: left; }
  .wb-fm-tf-h b { font-weight: 600; }
  .wb-fm-tf-h .wb-fm-cnt { margin-left: auto; }
  .wb-fm-tf-h:disabled { cursor: default; }
  .wb-fm-tf-l { height: 248px; overflow-y: auto; padding: 0 var(--s-1) var(--s-1); scrollbar-width: thin; }
  .wb-fm-tf-i { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 40px; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-sm); text-align: left; transition: background var(--dur-quick) var(--ease-out); }
  .wb-fm-tf-i[aria-selected="true"] { background: var(--action-tint); }
  .wb-fm-tf-i:disabled { opacity: .45; pointer-events: none; }
  .wb-fm-tf-i small { margin-left: auto; font-size: var(--fs-xs); color: var(--ink-3); }
  @media (hover: hover) { .wb-fm-tf-i:not([aria-selected="true"]):hover { background: var(--zone); } }
  .wb-fm-tf-i:focus-visible, .wb-fm-tf-h:focus-visible { outline: none; background: var(--zone); }
  .wb-fm-tf-mid { display: grid; align-content: center; gap: var(--s-2); }
  .wb-fm-tf-b { position: relative; width: 36px; height: 36px; border-radius: var(--r-sm); background: var(--action); transition: background var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out); }
  .wb-fm-tf-b::before { content: ""; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; border: solid var(--surface); border-width: 0 0 2px 2px; transform: translate(-30%, -50%) rotate(45deg); }
  .wb-fm-tf-b--r::before { transform: translate(-70%, -50%) rotate(-135deg); }
  .wb-fm-tf-b:active { transform: scale(.94); }
  .wb-fm-tf-b:disabled { background: var(--zone); pointer-events: none; }
  .wb-fm-tf-b:disabled::before { border-color: var(--ink-3); opacity: .5; }
  .wb-fm-tf-b:focus-visible { outline: 2px solid var(--ink-2); outline-offset: 2px; }

  /* 验证码分格输入 */
  .wb-fm-otp { max-width: 360px; margin: 0 auto; }
  .wb-fm-otp__top { display: grid; justify-items: center; gap: var(--s-1); margin-bottom: var(--s-5); text-align: center; }
  .wb-fm-otp__top h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .wb-fm-otp__row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--s-2); }
  #cat-form .wb-fm-otp__c { min-height: 56px; padding: 0; text-align: center; font-size: var(--fs-xl); font-weight: 600; font-variant-numeric: tabular-nums; caret-color: var(--ink); transition: border-color var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  #cat-form .wb-fm-otp__c[data-v] { border-color: var(--ink-2); }
  #cat-form .wb-fm-otp[data-st="bad"] .wb-fm-otp__c { border-color: var(--danger); background: var(--danger-tint); }
  #cat-form .wb-fm-otp[data-st="ok"] .wb-fm-otp__c { border-color: var(--success); background: var(--success-tint); }
  #cat-form .wb-fm-otp__c::selection { background: color-mix(in srgb, var(--action) 16%, transparent); color: inherit; }
  #cat-form .wb-fm-otp__c:disabled { background: var(--zone); color: var(--ink-2); cursor: wait; }
  .wb-fm-otp__msg { display: flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 24px; margin-top: var(--s-3); font-size: var(--fs-sm); }
  .wb-fm-otp__msg[data-t="bad"] { color: var(--danger); font-weight: 500; }
  .wb-fm-otp__re { display: flex; justify-content: center; margin-top: var(--s-1); }

  /* 原位编辑文本 */
  .wb-fm-ie-row { display: grid; grid-template-columns: 88px minmax(0, 1fr); align-items: start; gap: var(--s-4); padding: var(--s-3) 0; }
  .wb-fm-ie-row:first-child { padding-top: 0; }
  .wb-fm-ie-row:last-child { padding-bottom: 0; }
  .wb-fm-ie-row + .wb-fm-ie-row { border-top: 1px solid var(--line); }
  .wb-fm-ie-row > b { display: flex; align-items: center; min-height: 40px; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .wb-fm-ie-c { min-width: 0; }
  .wb-fm-ie-v { display: flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-1) 0 var(--s-3); border: 1px solid transparent; border-radius: var(--r-md); font-size: var(--fs-sm); cursor: text; transition: background var(--dur-quick) var(--ease-out), border-color var(--dur-quick) var(--ease-out); }
  .wb-fm-ie-row[data-multi] .wb-fm-ie-v { align-items: flex-start; min-height: 0; padding-top: var(--s-3); padding-bottom: var(--s-3); line-height: var(--lh-body); }
  .wb-fm-ie-row[data-multi] > b { align-items: flex-start; min-height: 0; padding-top: 13px; line-height: var(--lh-body); }
  .wb-fm-ie-t { flex: 1; min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
  .wb-fm-ie-t[data-empty="true"] { color: var(--ink-3); }
  .wb-fm-ie-e { flex: none; width: 32px; height: 32px; opacity: .55; transition: opacity var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .wb-fm-ie-row[data-multi] .wb-fm-ie-e { margin-top: -8px; margin-bottom: -8px; }
  .wb-fm-ie-e img { width: 18px; height: 18px; }
  @media (hover: hover) { .wb-fm-ie-v:hover { background: var(--zone); border-color: var(--line); } .wb-fm-ie-v:hover .wb-fm-ie-e { opacity: 1; } }
  .wb-fm-ie-e:focus-visible { opacity: 1; }
  .wb-fm-ie-ed { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: start; gap: var(--s-2); }
  .wb-fm-ie-ed[hidden] { display: none; }
  .wb-fm-ie-ed .btn { min-height: 40px; }
  .wb-fm-ie-ed .field__err, .wb-fm-ie-ed .wb-fm-ie-box { grid-column: 1 / -1; }
  .wb-fm-ie-ed .wb-fm-ie-box { display: grid; gap: var(--s-2); }
  .wb-fm-ie-ed .wb-fm-ie-foot { grid-column: 1 / -1; display: flex; align-items: center; gap: var(--s-2); }
  .wb-fm-ie-ed .wb-fm-ie-foot .wb-fm-cnt { margin-right: auto; }

  /* 星级评分 */
  .wb-fm-rt-line { display: flex; align-items: center; gap: var(--s-3); min-height: 40px; }
  .wb-fm-rt { display: inline-flex; gap: var(--s-1); }
  .wb-fm-rt-s { display: grid; place-items: center; width: 32px; height: 36px; border-radius: var(--r-sm); transition: transform var(--dur-quick) var(--ease-spring); }
  .wb-fm-rt-s img { width: 28px; height: 28px; transition: opacity var(--dur-quick) var(--ease-out); }
  #cat-form .wb-fm-rt-s:not(.is-on) img { filter: grayscale(1); opacity: .3; }
  @media (hover: hover) { .wb-fm-rt-s:hover { transform: scale(1.12); } }
  .wb-fm-rt-s:active { transform: scale(.94); }
  .wb-fm-rt-s:focus-visible { outline: 2px solid var(--ink-2); outline-offset: 0; }
  .wb-fm-rt-w { min-width: 72px; font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .wb-fm-rt-line .btn { margin-left: auto; }
  .wb-fm-rt-ro { position: relative; display: inline-flex; margin-left: 2px; padding: var(--s-1) 0; }
  .wb-fm-rt-ro > span { display: inline-flex; gap: var(--s-2); }
  .wb-fm-rt-ro img { width: 28px; height: 28px; flex: none; }
  .wb-fm-rt-ro > span:first-child img { filter: grayscale(1); opacity: .3; }
  .wb-fm-rt-ro > .wb-fm-rt-fill { position: absolute; left: 0; top: var(--s-1); bottom: var(--s-1); width: var(--v); overflow: hidden; }
  .wb-fm-rt-off { opacity: .5; pointer-events: none; }
  .wb-fm-rt-off img { padding: 0; }

  /* 颜色选择器 */
  .wb-fm-cp-lab { display: inline-flex; align-items: center; gap: var(--s-3); min-width: 0; }
  .wb-fm-cp-sw { flex: none; width: 24px; height: 24px; border-radius: 8px; background: var(--c); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .wb-fm-cp-pop { right: auto; display: grid; gap: var(--s-3); width: 288px; max-width: 100%; padding: var(--s-3); }
  .wb-fm-cp-sv, .wb-fm-cp-hue { position: relative; touch-action: none; cursor: crosshair; }
  .wb-fm-cp-sv { height: 152px; border-radius: var(--r-md); }
  .wb-fm-cp-hue { height: 14px; border-radius: 7px; }
  .wb-fm-cp-sv canvas, .wb-fm-cp-hue canvas { display: block; width: 100%; height: 100%; border-radius: inherit; }
  .wb-fm-cp-hd { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; border: 2px solid var(--surface); background: var(--c); box-shadow: var(--elev-2), 0 0 0 1px var(--line-strong); pointer-events: none; }
  .wb-fm-cp-hue .wb-fm-cp-hd { top: 50%; }
  .wb-fm-cp-row { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: start; gap: var(--s-2); }
  .wb-fm-cp-pv { width: 40px; height: 40px; border-radius: var(--r-md); background: var(--c); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .wb-fm-cp-sws { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: var(--s-2) 6px; }
  .wb-fm-cp-s { position: relative; aspect-ratio: 1; border-radius: 8px; background: var(--c); box-shadow: inset 0 0 0 1px var(--line-strong); transition: transform var(--dur-quick) var(--ease-out); }
  .wb-fm-cp-s[aria-checked="true"] { box-shadow: inset 0 0 0 1px var(--line-strong), 0 0 0 2px var(--surface), 0 0 0 3.5px var(--ink-2); }
  @media (hover: hover) { .wb-fm-cp-s:hover { transform: scale(1.1); } }
  .wb-fm-cp-s:focus-visible { outline: 2px solid var(--ink-2); outline-offset: 2px; }
  .wb-fm-cp-ex { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2); }
  .wb-fm-cp-b, .wb-fm-cp-t { background: var(--c); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .wb-fm-cp-b[data-on="dark"], .wb-fm-cp-t[data-on="dark"] { color: var(--surface); }
  .wb-fm-cp-b[data-on="light"], .wb-fm-cp-t[data-on="light"] { color: var(--ink); }
  .wb-fm-cp-b { min-height: 32px; padding: 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); }
  .wb-fm-cp-t { height: 26px; padding: 0 var(--s-3); font-size: var(--fs-xs); }

  /* 命令搜索面板：就近内嵌，不做居中弹窗 */
  .wb-fm-cmd { border-radius: var(--r-md); overflow: hidden; background: var(--surface); }
  .wb-fm-cmd-s { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: 0 var(--s-4); border-bottom: 1px solid var(--line); }
  .wb-fm-cmd-s img { width: 20px; height: 20px; flex: none; }
  #cat-form .wb-fm-cmd-s input { flex: 1; min-width: 0; height: 50px; border: 0; background: none; font-size: var(--fs-sm); }
  #cat-form .wb-fm-cmd-s input:focus-visible { outline: none; box-shadow: none; }
  #cat-form .wb-fm-cmd-s input::placeholder { color: var(--ink-3); }
  .wb-fm-cmd-list { min-height: 112px; max-height: 392px; overflow-y: auto; padding: var(--s-1); scrollbar-width: thin; }
  .wb-fm-cmd-gh { padding: var(--s-2) var(--s-3) var(--s-1); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); }
  .wb-fm-cmd-i { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 40px; padding: 0 var(--s-3); border-radius: var(--r-sm); font-size: var(--fs-sm); text-align: left; }
  .wb-fm-cmd-i img { width: 20px; height: 20px; flex: none; }
  .wb-fm-cmd-i > span { flex: 1; min-width: 0; }
  .wb-fm-cmd-i small { font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-cmd-i[aria-selected="true"] { background: var(--action-tint); color: var(--action-press); }
  .wb-fm-cmd-foot { display: flex; align-items: center; gap: var(--s-4); min-height: 40px; padding: 0 var(--s-4); border-top: 1px solid var(--line); background: var(--zone); font-size: var(--fs-xs); color: var(--ink-3); }

  /* 图片裁剪框 */
  .wb-fm-crop-wrap { display: flex; justify-content: center; border-radius: var(--r-md); background: var(--zone); overflow: hidden; }
  .wb-fm-crop-st { position: relative; width: 100%; aspect-ratio: 3 / 2; touch-action: none; user-select: none; overflow: hidden; }
  .wb-fm-crop-st > img { width: 100%; height: 100%; object-fit: fill; pointer-events: none; }
  .wb-fm-crop-fr { --g: color-mix(in srgb, var(--surface) 55%, transparent); position: absolute; border: 2px solid var(--surface); box-shadow: 0 0 0 999px color-mix(in srgb, var(--ink) 46%, transparent); cursor: move; background: linear-gradient(var(--g) 0 0) 33.33% 0 / 1px 100% no-repeat, linear-gradient(var(--g) 0 0) 66.66% 0 / 1px 100% no-repeat, linear-gradient(var(--g) 0 0) 0 33.33% / 100% 1px no-repeat, linear-gradient(var(--g) 0 0) 0 66.66% / 100% 1px no-repeat; }
  .wb-fm-crop-fr:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; border-radius: 0; }
  .wb-fm-crop-fr i { position: absolute; width: 28px; height: 28px; }
  .wb-fm-crop-fr i::after { content: ""; position: absolute; inset: 6px; border-radius: 4px; background: var(--surface); box-shadow: var(--elev-1); }
  .wb-fm-crop-fr i[data-h="nw"] { left: 0; top: 0; cursor: nwse-resize; }
  .wb-fm-crop-fr i[data-h="ne"] { right: 0; top: 0; cursor: nesw-resize; }
  .wb-fm-crop-fr i[data-h="sw"] { left: 0; bottom: 0; cursor: nesw-resize; }
  .wb-fm-crop-fr i[data-h="se"] { right: 0; bottom: 0; cursor: nwse-resize; }
  .wb-fm-crop-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-4); }
  .wb-fm-crop-bar .seg__item[aria-checked="true"] { background: var(--action); color: var(--surface); font-weight: 600; }
  .wb-fm-crop-zoom { display: flex; align-items: center; gap: var(--s-2); }
  .wb-fm-crop-out { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-4); }
  .wb-fm-crop-pv { display: flex; align-items: center; gap: var(--s-3); flex: none; }
  .wb-fm-crop-p { flex: none; border-radius: var(--r-sm); background-color: var(--zone); background-repeat: no-repeat; box-shadow: 0 0 0 1px var(--line); }
  .wb-fm-crop-p--c { border-radius: 50%; }
  .wb-fm-crop-info { display: grid; gap: 2px; min-width: 0; font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wb-fm-crop-info small { font-size: var(--fs-xs); color: var(--ink-3); }

  /* 提及输入框 */
  .wb-fm-mn-box { position: relative; }
  .wb-fm-mn-box > .textarea { display: block; }
  .wb-fm-mn-pop { position: absolute; z-index: 30; width: 248px; max-width: 100%; max-height: 236px; overflow-y: auto; scrollbar-width: thin; padding: var(--s-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--elev-3); opacity: 0; transform: scale(.97); transform-origin: top left; pointer-events: none; transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  .wb-fm-mn-pop[data-open="true"] { opacity: 1; transform: none; pointer-events: auto; }
  .wb-fm-mn-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-3); }
  .wb-fm-mn-foot .wb-fm-chips { flex: 1; min-width: 0; }
  .wb-fm-mn-foot .btn { flex: none; min-height: 40px; }
  .wb-fm-mn-feed { display: grid; gap: var(--s-3); margin-top: var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .wb-fm-mn-feed:empty { display: none; }
  .wb-fm-mn-c { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: var(--s-3); align-items: start; font-size: var(--fs-sm); }
  .wb-fm-mn-c .avatar { width: 32px; height: 32px; padding: 3px; }
  .wb-fm-mn-c b { font-weight: 600; }
  .wb-fm-mn-c small { margin-left: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); }
  .wb-fm-mn-c p { margin-top: 2px; line-height: var(--lh-body); overflow-wrap: anywhere; white-space: pre-wrap; }
  .wb-fm-mn-at { color: var(--action-press); font-weight: 600; }

  /* 自适应文本域 */
  #cat-form .textarea.wb-fm-au-t { min-height: 72px; resize: none; overflow-y: hidden; transition: height var(--dur-quick) var(--ease-out), border-color var(--dur-quick) var(--ease-out); }

  .wb-fm-dp-pop,.wb-fm-dt-pop,.wb-fm-cp-pop { position: static; transform: none; box-shadow:none; }
  [data-open="false"] > :is(.wb-fm-dp-pop,.wb-fm-dt-pop,.wb-fm-cp-pop) { display:none; }
</style>

<article class="demo" data-cid="WB-FORM-033" data-name="搜索多选面板" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">搜索多选面板</span></div>
  <p class="demo__note">适合：成员与标签多选，面板内带搜索与分组</p>
  <div class="demo__stage wb-fm-room"><div class="card wb-fm-card" id="wb-fm-ms">
    <div class="field"><span class="wb-fm-lab"><span class="field__label" id="wb-fm-ms-l">协作成员</span><span class="wb-fm-cnt">已选 <b data-n>0</b>/5</span></span>
      <div class="wb-fm-pick" data-open="false">
        <button type="button" class="wb-fm-ctl field-shell" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="wb-fm-ms-l"><span class="wb-fm-ph">请选择成员</span></button>
        <div class="wb-fm-pop wb-fm-ms-pop" inert>
          <label class="wb-fm-combo-s field-shell"><img src="../../kit/assets/line/search.webp" alt=""><input type="search" placeholder="搜索成员姓名或岗位" aria-label="搜索成员姓名或岗位" autocomplete="off"></label>
          <div class="wb-fm-ms-list" role="listbox" aria-multiselectable="true" aria-labelledby="wb-fm-ms-l"></div>
          <div class="wb-fm-ms-foot"><span data-sum>已选 0 人</span><span class="wb-fm-ms-acts"><button type="button" class="btn btn--text btn--sm" data-clear>清空</button><button type="button" class="btn btn--primary btn--sm" data-done>完成</button></span></div>
        </div>
      </div>
      <div class="wb-fm-chips wb-fm-ms-chosen" aria-label="已选成员"></div>
    </div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-034" data-name="日期选择框" data-cat="FORM">
