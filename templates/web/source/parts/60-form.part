        [...ds].forEach((d, k) => set(cs[i + k], d)); state('idle'); cs[Math.min(5, i + ds.length)].focus(); if (code().length === 6) verify();
      });
    });
    const tick = () => { re.disabled = left > 0; re.textContent = left > 0 ? `${left} 秒后可重新获取` : '重新获取'; };
    const start = () => { left = 60; tick(); clearInterval(timer); timer = setInterval(() => { left -= 1; tick(); if (left <= 0) clearInterval(timer); }, 1000); };
    re.addEventListener('click', () => { cs.forEach(c => set(c, '')); state('idle'); start(); cs[0].focus(); Lz.toast('验证码已发送', 'success'); });
    state('idle'); start();
  })();

  /* 038 原位编辑文本：阅读态与编辑态同位置，回车保存、退出键取消，失败保留输入 */
  (() => {
    const root = $('#wb-fm-ie'), TAKEN = ['徐汇滨江店', '浦东世纪店'];
    $$('.wb-fm-ie-row', root).forEach(row => {
      const rd = $('[data-read]', row), ed = $('[data-edit]', row), t = $('.wb-fm-ie-t', row), inp = $('input, textarea', ed), er = $('.field__err', ed), save = $('[type="submit"]', ed), edit = $('.wb-fm-ie-e', row), n = $('[data-n]', ed);
