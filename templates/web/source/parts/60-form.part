    <label class="field"><span class="wb-fm-lab"><span class="field__label">商品名称</span><span class="wb-fm-cnt"><b data-n>0</b>/20</span></span><input class="input" maxlength="20" placeholder="请输入商品名称" autocomplete="off"></label>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-002" data-name="文本框四态" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">文本框四态</span></div>
  <p class="demo__note">适合：核对默认聚焦错误禁用四种外观</p>
  <div class="demo__stage"><div class="card wb-fm-card wb-fm-stack" id="wb-fm-t2">
    <label class="field"><span class="wb-fm-lab"><span class="field__label">商品名称</span><span class="tag">默认</span></span><input class="input" placeholder="请输入商品名称" autocomplete="off"></label>
    <label class="field"><span class="wb-fm-lab"><span class="field__label">商品名称</span><span class="tag" data-tone="action">聚焦</span></span><input class="input wb-fm-is-focus" value="红玫瑰花束" autocomplete="off"></label>
    <label class="field"><span class="wb-fm-lab"><span class="field__label">商品名称</span><span class="tag" data-tone="danger">错误</span></span><input class="input" data-err aria-invalid="true" placeholder="请输入商品名称" autocomplete="off"><span class="field__err">商品名称不能为空</span></label>
    <label class="field"><span class="wb-fm-lab"><span class="field__label">商品名称</span><span class="tag">禁用</span></span><input class="input" value="粉芍药花束" disabled></label>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-003" data-name="前后缀文本框" data-cat="FORM">
