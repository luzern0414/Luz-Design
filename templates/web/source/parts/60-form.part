      <div class="drop" data-k="m"><button type="button" class="drop__btn field-shell" aria-label="门店">门店 <b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="建国路店">建国路店</button><button type="button" class="drop__opt" data-value="徐汇滨江店">徐汇滨江店</button><button type="button" class="drop__opt" data-value="浦东世纪店">浦东世纪店</button></div></div>
      <div class="drop" data-k="c"><button type="button" class="drop__btn field-shell" aria-label="分类">分类 <b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="鲜花">鲜花</button><button type="button" class="drop__opt" data-value="绿植">绿植</button><button type="button" class="drop__opt" data-value="礼盒">礼盒</button><button type="button" class="drop__opt" data-value="花器">花器</button></div></div>
      <div class="drop" data-k="t"><button type="button" class="drop__btn field-shell" aria-label="状态">状态 <b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部</button><button type="button" class="drop__opt" data-value="在售">在售</button><button type="button" class="drop__opt" data-value="售罄">售罄</button><button type="button" class="drop__opt" data-value="已下架">已下架</button></div></div>
      <span class="wb-fm-tail"><button type="button" class="btn btn--text btn--sm" data-clear hidden>清除条件</button><span class="wb-fm-found">共 <b data-n>9</b> 件</span></span>
    </div>
  </div></div>
</article>

<article class="demo demo--span2" data-cid="WB-FORM-020" data-name="搜索表单" data-cat="FORM">
  <div class="demo__head"><span class="demo__name">搜索表单</span></div>
  <p class="demo__note">适合：条件多的订单查询，更多条件可展开</p>
  <div class="demo__stage wb-fm-room"><div class="card wb-fm-card" id="wb-fm-sf">
    <div class="wb-fm-sf">
      <label class="field"><span class="field__label">订单号</span><input class="input" data-k="no" inputmode="numeric" placeholder="请输入订单号" autocomplete="off"></label>
      <label class="field"><span class="field__label">客户</span><input class="input" data-k="who" placeholder="请输入客户姓名" autocomplete="off"></label>
      <div class="field"><span class="field__label">状态</span><div class="drop wb-fm-sel" data-k="st"><button type="button" class="drop__btn field-shell" aria-label="状态"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部状态</button><button type="button" class="drop__opt" data-value="待付款">待付款</button><button type="button" class="drop__opt" data-value="待发货">待发货</button><button type="button" class="drop__opt" data-value="待收货">待收货</button><button type="button" class="drop__opt" data-value="已完成">已完成</button><button type="button" class="drop__opt" data-value="售后">售后</button></div></div></div>
    </div>
      <div class="expand wb-fm-sfmore" id="wb-fm-sf-more"><div><div class="expand__body">
        <div class="field"><span class="field__label">门店</span><div class="drop wb-fm-sel" data-k="store"><button type="button" class="drop__btn field-shell" aria-label="门店"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部门店</button><button type="button" class="drop__opt" data-value="建国路店">建国路店</button><button type="button" class="drop__opt" data-value="徐汇滨江店">徐汇滨江店</button><button type="button" class="drop__opt" data-value="浦东世纪店">浦东世纪店</button></div></div></div>
        <div class="field"><span class="field__label">金额范围</span><div class="wb-fm-range"><input class="input" data-k="min" inputmode="numeric" placeholder="最低" aria-label="最低金额" autocomplete="off"><i></i><input class="input" data-k="max" inputmode="numeric" placeholder="最高" aria-label="最高金额" autocomplete="off"></div></div>
        <div class="field"><span class="field__label">下单时段</span><div class="drop wb-fm-sel" data-k="span"><button type="button" class="drop__btn field-shell" aria-label="下单时段"><b></b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt" data-value="" aria-selected="true">全部时段</button><button type="button" class="drop__opt" data-value="近 7 天">近 7 天</button><button type="button" class="drop__opt" data-value="近 30 天">近 30 天</button><button type="button" class="drop__opt" data-value="近 90 天">近 90 天</button></div></div></div>
      </div></div></div>
      <div class="wb-fm-sfbar"><button type="button" class="wb-fm-tg" data-expand="wb-fm-sf-more">更多条件</button><span class="wb-fm-tail"><span class="wb-fm-found" aria-live="polite">共 <b data-n>8</b> 条</span><button type="button" class="btn btn--ghost" data-reset>重置</button><button type="button" class="btn btn--primary" data-go>查询</button></span></div>
  </div></div>
</article>

<article class="demo" data-cid="WB-FORM-021" data-name="图片上传" data-cat="FORM">
