        saved = v; show(); leave(); Lz.toast('已保存', 'success');
      });
      show();
    });
  })();

  /* 040 星级评分选择：悬停预览、点选、方向键、清除；均分只读按小数画星 */
  (() => {
    const root = $('#wb-fm-rt'), g = $('.wb-fm-rt[role="radiogroup"]', root), ss = $$('.wb-fm-rt-s', g), word = $('[data-w]', root), clr = $('[data-clear]', root), W = ['很差', '较差', '一般', '满意', '惊喜'];
