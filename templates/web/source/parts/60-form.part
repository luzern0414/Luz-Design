      <label class="field"><span class="field__label wb-fm-req">商品名称</span><input class="input" data-k="n" placeholder="请输入商品名称" autocomplete="off"><span class="field__err" hidden>请输入商品名称</span></label>
      <div class="field"><span class="field__label wb-fm-req">所属分类</span><div class="drop wb-fm-sel" data-placeholder data-k="c"><button type="button" class="drop__btn field-shell" aria-label="所属分类"><b class="wb-fm-ph">请选择分类</b></button><div class="drop__menu" role="listbox"><button type="button" class="drop__opt">鲜花</button><button type="button" class="drop__opt">绿植</button><button type="button" class="drop__opt">礼盒</button><button type="button" class="drop__opt">花器</button></div></div><span class="field__err" hidden>请选择所属分类</span></div>
      <label class="field"><span class="field__label wb-fm-req">商品价格</span><span class="wb-fm-group field-shell"><span class="wb-fm-addon">¥</span><input class="input" data-k="p" data-f="money" inputmode="decimal" placeholder="0.00" autocomplete="off"><span class="wb-fm-addon">元</span></span><span class="field__err" hidden>请输入大于 0 的价格</span></label>
      <div class="wb-fm-rows"><div class="wb-fm-row"><span><b>立即上架</b></span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="立即上架"></button></div></div>
    </div>
    <div class="wb-fm-bar"><button type="button" class="btn btn--ghost" data-cancel>取消</button><button type="submit" class="btn btn--primary">保存</button></div>
  </form></div>
</article>

<article class="demo demo--span2" data-cid="WB-FORM-024" data-name="两列表单" data-cat="FORM">
