      <div class="wb-fm-rows">
        <div class="wb-fm-row" role="checkbox" aria-checked="mixed" data-all><span><b>全部门店</b></span><span class="check" aria-checked="mixed" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span></div>
        <div class="wb-fm-row" role="checkbox" aria-checked="true" data-it><span>建国路店</span><span class="check" aria-checked="true" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span></div>
        <div class="wb-fm-row" role="checkbox" aria-checked="true" data-it><span>徐汇滨江店</span><span class="check" aria-checked="true" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span></div>
        <div class="wb-fm-row" role="checkbox" aria-checked="false" data-it><span>浦东世纪店</span><span class="check" aria-checked="false" aria-hidden="true"><img src="../../kit/assets/line/check.webp" alt=""></span></div>
      </div>
