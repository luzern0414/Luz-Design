      ctx.beginPath(); v.forEach((q, i) => i ? ctx.lineTo(x(i), y(q)) : ctx.moveTo(x(i), y(q))); ctx.strokeStyle = col; ctx.lineWidth = 2.5; ctx.lineJoin = 'round'; ctx.stroke();
      ctx.setLineDash([4, 4]); ctx.strokeStyle = cssv('--line-strong'); ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x(act), pad.t); ctx.lineTo(x(act), y(0)); ctx.stroke(); ctx.setLineDash([]);
      ctx.beginPath(); ctx.arc(x(act), y(v[act]), 9, 0, 7); ctx.fillStyle = rgba(col, .18); ctx.fill();
