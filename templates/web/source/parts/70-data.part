  <div class="demo__stage">
    <div class="card dv-card dv-calw">
      <div class="dv-cal__top">
        <div class="dv-head"><span class="dv-title">门店排期<span class="dv-unit">预约 排班 活动</span></span></div>
        <div class="dv-step" role="group" aria-label="切换月份">
          <button class="ibtn" data-prev data-tip="上个月" aria-label="上个月"><img src="../../kit/assets/line/back.webp" alt=""></button>
          <span class="dv-step__l" aria-live="polite"></span>
          <button class="ibtn ibtn--next" data-next data-tip="下个月" aria-label="下个月"><img src="../../kit/assets/line/back.webp" alt=""></button>
        </div>
      </div>
      <div class="dv-lg dv-lg--o" role="group" aria-label="事项类型">
        <button class="dv-lgb" aria-pressed="true" data-t="a"><i class="dv-sw dv-sw--dot" style="--c:var(--action)"></i>预约</button>
        <button class="dv-lgb" aria-pressed="true" data-t="b"><i class="dv-sw" style="--c:var(--info)"></i>排班</button>
        <button class="dv-lgb" aria-pressed="true" data-t="c"><i class="dv-sw dv-sw--dia" style="--c:var(--accent)"></i>活动</button>
      </div>
      <div class="dv-cal">
        <div>
          <div class="dv-cal__wk" aria-hidden="true"><span>周一</span><span>周二</span><span>周三</span><span>周四</span><span>周五</span><span>周六</span><span>周日</span></div>
          <div class="dv-cal__g" role="group" aria-label="月历 方向键切换日期 翻页键切换月份" data-allow-ellipsis></div>
        </div>
        <div class="dv-cal__p" aria-live="polite"></div>
      </div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const demo = id => document.querySelector(`[data-cid="${id}"]`);
  const num = n => n.toLocaleString('zh-CN');
  const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  /* 画布取色：令牌色按百分比透明，或与表面色混合；不写死颜色 */
  const al = (n, p) => `color-mix(in srgb, ${cssv(n)} ${p}%, transparent)`;
  const tn = (n, p, b = '--surface') => `color-mix(in srgb, ${cssv(n)} ${p}%, ${cssv(b)})`;
  const pct1 = r => (Math.round(r * 1000) / 10) + '%';
  const kv = (k, v) => `<span class="dv-k">${k}</span><b>${v}</b>`;
  const font = (w = 400, s = '--fs-xs') => `${w} ${cssv(s)} ${cssv('--font')}`;
  const skinFns = []; new MutationObserver(() => skinFns.forEach(f => f())).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  const onSkin = f => skinFns.push(f);
  const sizeCanvas = (cv, draw) => { const run = () => { const w = cv.clientWidth, h = cv.clientHeight; if (!w || !h) return; const dpr = devicePixelRatio || 1; cv.width = w * dpr; cv.height = h * dpr; const ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h); draw(ctx, w, h); }; new ResizeObserver(run).observe(cv); onSkin(run); return run; };
  /* 画布的对应数据表：视觉隐藏，读屏可用 */
  const tbl = (host, cap, head, rows) => { host.innerHTML = `<table><caption>${cap}</caption><thead><tr>${head.map(h => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map(r => `<tr><th>${r[0]}</th>${r.slice(1).map(c => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`; };
  /* 指针悬停、触屏点选与方向键共用一个选中序号；at 返回命中的序号 */
  const wire = (cv, { at, n, get, set, keys = ['ArrowRight', 'ArrowLeft'], wrap = false }) => {
    cv.tabIndex = 0;
    const N = () => (typeof n === 'function' ? n() : n);
    const f = e => { const r = cv.getBoundingClientRect(); const i = at(e.clientX - r.left, e.clientY - r.top, r); if (i != null && i >= 0) set(i); };
    cv.addEventListener('pointermove', f); cv.addEventListener('pointerdown', f);
    cv.addEventListener('keydown', e => {
      const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (e.key === 'Home' || e.key === 'End') { e.preventDefault(); set(e.key === 'Home' ? 0 : N() - 1); return; }
      if (!d || !keys.includes(e.key)) return; e.preventDefault();
      const k = N(); set(wrap ? (get() + d + k) % k : Math.min(k - 1, Math.max(0, get() + d)));
    });
  };
  const nearest = (xs, x) => { let b = 0, d0 = 1e9; xs.forEach((v, i) => { const d = Math.abs(v - x); if (d < d0) { d0 = d; b = i; } }); return b; };
  const rr = (ctx, x, y, w, h, r) => { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); };
  const txt = (ctx, s, x, y, { a = 'left', b = 'alphabetic', f, c } = {}) => { if (f) ctx.font = f; if (c) ctx.fillStyle = c; ctx.textAlign = a; ctx.textBaseline = b; ctx.fillText(s, x, y); };
  const lines2 = s => (s.length > 3 ? [s.slice(0, 2), s.slice(2)] : [s]);
  /* 星期与日期 */
  const WD = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  const SKIN = () => ({ a: cssv('--action'), b: cssv('--accent'), c: cssv('--info'), ok: cssv('--success'), warn: cssv('--warning'), bad: cssv('--danger') });

  /* c023 */
  (() => {
    const root = demo('WB-DATA-023'), grid = $('.dv-cal__g', root), panel = $('.dv-cal__p', root), lab = $('.dv-step__l', root), prev = $('[data-prev]', root), next = $('[data-next]', root), lg = $$('.dv-lgb', root);
    const STORES = ['建国路店', '徐汇滨江店', '浦东世纪店'], TN = { a: '预约', b: '排班', c: '活动' };
    const EX = {
      '202610-8': [['a', '10:00', '婚礼花艺试样', '建国路店']], '202610-20': [['a', '14:00', '企业年会花艺', '徐汇滨江店']], '202610-31': [['c', '全天', '万圣主题花艺', '全部门店']],
      '202611-5': [['a', '10:30', '婚礼花艺试样', '建国路店']], '202611-9': [['a', '10:00', '场地布置勘察', '徐汇滨江店'], ['a', '12:00', '生日花束预订', '建国路店'], ['c', '18:00', '会员沙龙筹备', '建国路店']],
      '202611-11': [['c', '全天', '双十一花礼上新', '全部门店'], ['a', '10:00', '企业订花提货', '浦东世纪店']], '202611-12': [['a', '14:00', '婚礼花艺试样', '徐汇滨江店']], '202611-18': [['a', '19:00', '会员沙龙预约', '建国路店']],
      '202611-20': [['a', '10:00', '企业年会花艺', '徐汇滨江店']], '202611-25': [['a', '08:00', '婚礼现场布置', '建国路店']], '202611-26': [['c', '全天', '感恩节花束预订', '线上商城']], '202611-30': [['a', '10:00', '月末盘点预约', '浦东世纪店']],
      '202612-3': [['a', '10:30', '婚礼花艺试样', '建国路店']], '202612-24': [['c', '全天', '平安夜花礼', '全部门店']], '202612-25': [['c', '全天', '圣诞花礼', '全部门店']] };
    const evs = (y, m, d) => {
      const k = y * 100 + m; if (k < 202610 || k > 202612) return [];
      const wd = new Date(y, m - 1, d).getDay(), o = [];
      if (wd === 1) o.push(['b', '08:00', '早班 3 人', '浦东世纪店']); if (wd === 2) o.push(['a', '09:00', '企业周花配送', '浦东世纪店']); if (wd === 3) o.push(['b', '14:00', '晚班 3 人', '徐汇滨江店']); if (wd === 5) o.push(['b', '08:00', '早班 4 人', '建国路店']);
      if (wd === 6) { o.push(['c', '14:00', '周末花艺沙龙', STORES[Math.floor((d - 1) / 7) % 3]]); o.push(['b', '全天', '周末加班 6 人', '建国路店']); } if (wd === 0) o.push(['b', '全天', '周末加班 5 人', '徐汇滨江店']);
      (EX[k + '-' + d] || []).forEach(e => o.push(e));
      return o.sort((p, q) => (p[1] === '全天' ? '00' : p[1]).localeCompare(q[1] === '全天' ? '00' : q[1]));
    };
    const CUR = new Date(2026, 10, 9); let sel = new Date(2026, 10, 9), view = [2026, 11];
    const on = () => lg.filter(b => b.getAttribute('aria-pressed') === 'true').map(b => b.dataset.t);
    const vis = (y, m, d) => evs(y, m, d).filter(e => on().includes(e[0]));
    const same = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
    const render = () => {
      const [y, m] = view, first = new Date(y, m - 1, 1), off = (first.getDay() + 6) % 7, days = new Date(y, m, 0).getDate(), weeks = Math.ceil((off + days) / 7);
      lab.textContent = `${y} 年 ${m} 月`; prev.disabled = y * 100 + m <= 202609; next.disabled = y * 100 + m >= 202701;
      let h = '';
      for (let i = 0; i < weeks * 7; i++) {
        if (i && i % 7 === 0) h += `<!--w${i / 7 - 1}-->`;
        const d = new Date(y, m - 1, 1 - off + i), inM = d.getMonth() === m - 1, es = inM ? vis(y, m, d.getDate()) : [], on1 = inM && same(d, sel);
        h += `<button type="button" class="dv-cal__d" data-ts="${d.getTime()}" ${inM ? '' : 'aria-disabled="true"'} tabindex="${on1 ? 0 : -1}" aria-pressed="${on1}"${same(d, CUR) ? ' aria-current="date"' : ''} aria-label="${d.getMonth() + 1} 月 ${d.getDate()} 日 ${WD[d.getDay()]} ${es.length ? es.length + ' 项事项' : '没有事项'}"><span class="dv-cal__n">${d.getDate()}</span><span class="dv-cal__es">${es.slice(0, 2).map(e => `<span class="dv-cal__e" data-t="${e[0]}"><span class="dv-cal__t">${e[2]}</span></span>`).join('')}${es.length > 2 ? `<span class="dv-cal__more">还有 ${es.length - 2} 项</span>` : ''}</span></button>`;
      }
      h += `<!--w${weeks - 1}-->`;
      const es = sel.getMonth() === m - 1 && sel.getFullYear() === y ? vis(y, m, sel.getDate()) : [];
