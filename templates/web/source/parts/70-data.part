    let act = 6; const X0 = 60, X1 = 280, Y1 = 600, pad = { l: 40, r: 14, t: 14, b: 30 };
    a11y($('[data-a11y]', root), '售价与月销量', P.map(p => `${p[0]} 售价 ¥${p[1]}`), P.map(p => p[2]), ' 件');
    const pos = (w, h, p) => [pad.l + (w - pad.l - pad.r) * (p[1] - X0) / (X1 - X0), pad.t + (h - pad.t - pad.b) * (1 - p[2] / Y1)];
