    cv.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; e.preventDefault(); set(Math.min(count - 1, Math.max(0, get() + d))); });
  };

  /* 001 折线：Lz.line，缺口断开不补零 */
