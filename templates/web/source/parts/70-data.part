      [0, 200, 400, 600].forEach(t => { ctx.strokeStyle = t ? cssv('--line') : cssv('--line-strong'); ctx.beginPath(); ctx.moveTo(g.pad.l, g.y(t)); ctx.lineTo(w - g.pad.r, g.y(t)); ctx.stroke(); txt(ctx, String(t), g.pad.l - 8, g.y(t), { a: 'right', b: 'middle', c: cssv('--ink-3') }); });
      [44, 48, 52, 56, 60].forEach(t => { ctx.strokeStyle = cssv('--line'); ctx.beginPath(); ctx.moveTo(g.x(t), g.pad.t); ctx.lineTo(g.x(t), h - g.pad.b); ctx.stroke(); txt(ctx, t + '%', g.x(t), h - 10, { a: t === 44 ? 'left' : t === 60 ? 'right' : 'center', c: cssv('--ink-3') }); });
