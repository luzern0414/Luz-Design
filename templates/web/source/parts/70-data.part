        if (on) { ctx.fillStyle = al('--action', 8); ctx.fillRect(x - (w - g.pad.l - g.pad.r) / 6, g.pad.t, (w - g.pad.l - g.pad.r) / 3, h - g.pad.t - g.pad.b); }
        ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(x, g.y(s.max)); ctx.lineTo(x, g.y(s.q3)); ctx.moveTo(x, g.y(s.q1)); ctx.lineTo(x, g.y(s.min)); ctx.moveTo(x - g.bw / 4, g.y(s.max)); ctx.lineTo(x + g.bw / 4, g.y(s.max)); ctx.moveTo(x - g.bw / 4, g.y(s.min)); ctx.lineTo(x + g.bw / 4, g.y(s.min)); ctx.stroke();
        rr(ctx, x - g.bw / 2, g.y(s.q3), g.bw, g.y(s.q1) - g.y(s.q3), 5); ctx.fillStyle = on ? tn('--action', 46) : tn('--action', 24); ctx.fill(); ctx.lineWidth = on ? 2.5 : 2; ctx.strokeStyle = col; ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x - g.bw / 2, g.y(s.md)); ctx.lineTo(x + g.bw / 2, g.y(s.md)); ctx.lineWidth = 3; ctx.strokeStyle = cssv('--ink'); ctx.stroke();
        s.out.forEach(([v]) => { ctx.beginPath(); ctx.arc(x, g.y(v), 4.5, 0, 7); ctx.fillStyle = cssv('--surface'); ctx.fill(); ctx.lineWidth = 2; ctx.strokeStyle = S.b; ctx.stroke(); });
