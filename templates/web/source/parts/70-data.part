      ctx.font = `600 ${cssv('--fs-xs')} ${cssv('--font')}`; ctx.fillStyle = cssv('--ink'); ctx.textAlign = x > w - 90 ? 'right' : 'left'; ctx.textBaseline = 'middle'; ctx.fillText(P[act][0], x + (x > w - 90 ? -18 : 18), y);
    });
