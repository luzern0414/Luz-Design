    const geo = (w, h) => { const pad = { l: 38, r: 12, t: 14, b: 28 }, k = K[key]; return { pad, k, cx: i => pad.l + (w - pad.l - pad.r) * (i + .5) / 3, y: v => pad.t + (h - pad.t - pad.b) * (1 - v / k.hi), bw: Math.min(72, (w - pad.l - pad.r) / 3 * .48) }; };
