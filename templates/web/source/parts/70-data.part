      if (s < 60) return '刚刚'; if (s < 3600) return Math.floor(s / 60) + ' 分钟前'; if (dd === 0) return Math.floor(s / 3600) + ' 小时前';
      if (dd === 1) return `昨天 ${p2(d.getHours())}:${p2(d.getMinutes())}`; if (dd < 7) return dd + ' 天前'; return `${d.getMonth() + 1} 月 ${d.getDate()} 日`;
    };
