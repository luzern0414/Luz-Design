        txt(ctx, (b.t === 't' ? '' : b.v > 0 ? '+' : '-') + Math.abs(b.v).toFixed(1), g.cx(i), g.y(b.hi) - 6, { a: 'center', f: font(i === act ? 700 : 500), c: i === act ? cssv('--ink') : cssv('--ink-2') });
