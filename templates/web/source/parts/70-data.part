    box.addEventListener('keydown', e => {
      const dd = { ArrowRight: [1, 0], ArrowLeft: [-1, 0], ArrowDown: [0, 1], ArrowUp: [0, -1] }[e.key]; if (!dd) return; e.preventDefault();
      const w = Math.min(WEEKS - 1, Math.max(0, sel[0] + dd[0])), d = Math.min(6, Math.max(0, sel[1] + dd[1])); sel = [w, d]; paint(); at(w, d).focus();
    });
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'dv-ch') { key = e.detail.key; paint(); } });
    paint();
  })();
})();
</script>
