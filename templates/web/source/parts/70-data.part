      h: { unit: '小时', cap: '单位 小时 每人每周', hi: 60, step: 10, D: [[34, 36, 38, 38, 40, 40, 40, 42, 42, 44, 44, 45, 46, 46, 48, 24, 22, 56], [36, 38, 38, 40, 40, 40, 42, 42, 44, 44, 46, 48, 24, 50, 38], [34, 36, 38, 38, 40, 40, 40, 42, 42, 44, 44, 46, 46, 48, 22, 58]], tag: () => '' } };
    const stats = a => {
