      const q1 = q(.25), md = q(.5), q3 = q(.75), iq = q3 - q1, lo = q1 - 1.5 * iq, hi = q3 + 1.5 * iq, inn = s.filter(x => x >= lo && x <= hi);
      return { q1, md, q3, min: inn[0], max: inn[inn.length - 1], out: a.map((x, i) => [x, i]).filter(([x]) => x < lo || x > hi) };
    };
