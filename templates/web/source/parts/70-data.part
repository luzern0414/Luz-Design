    box.innerHTML = D.map(([n, t, d], i) => { const r = t ? d / t : null, st = r == null ? 'none' : r > 1 ? 'over' : r === 1 ? 'done' : 'run'; return `<button type="button" class="dv-pgr" aria-pressed="false" data-i="${i}" data-state="${st}"><span>${n}</span><span class="progress" role="progressbar" aria-label="${n}会员新增目标完成度" aria-valuemin="0" aria-valuemax="100"${r == null ? '' : ` aria-valuenow="${Math.round(r * 100)}"`}><i style="--w:${r == null ? 0 : Math.min(1, r) * 100}%"></i></span><span class="dv-pgr__v">${r == null ? '未设目标' : pct1(r)}</span></button>`; }).join('');
    const rows = $$('.dv-pgr', box), pick = i => { rows.forEach((r, k) => r.setAttribute('aria-pressed', String(k === i))); const [n, t, d] = D[i]; read.innerHTML = t ? `<span class="dv-k">${n} 已新增</span><b>${d} 人</b><span class="dv-k">目标</span><b>${t} 人</b>${d > t ? `<span class="tag" data-tone="success">超额 ${d - t} 人</span>` : d === t ? '<span class="tag" data-tone="success">已达成</span>' : `<span class="tag" data-tone="action">差 ${t - d} 人</span>`}` : `<span class="dv-k">${n} 已新增</span><b>${d} 人</b><span class="dv-k">目标</span><b>未设</b>`; };
