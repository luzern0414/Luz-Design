      read.innerHTML = kv(`${ST[act]} 中位数`, fix(s.md) + u) + kv('四分位', `${fix(s.q1)} 至 ${fix(s.q3)}${u}`) + kv('常规范围', `${s.min} 至 ${s.max}${u}`) + kv('离群点', s.out.length ? outs : '无');
    };
