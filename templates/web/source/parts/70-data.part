    const geo = (w, h) => { const pad = { l: 40, r: 30, t: 22, b: 30 }; return { pad, x: v => pad.l + (w - pad.l - pad.r) * (v - 44) / 16, y: v => pad.t + (h - pad.t - pad.b) * (1 - v / 600) }; };
