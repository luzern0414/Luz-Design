    const S = { d: { labels: ['一', '二', '三', '四', '五', '六', '日'], rl: ['周一', '周二', '周三', '周四', '周五', '周六', '周日'], v: [18640, 21230, 19480, 23860, 27910, 36520, 31240], d: '较上周 增长 12.4%', tone: 'up' }, w: { labels: ['一', '二', '三', '四'], rl: ['前三周', '前两周', '上周', '本周'], v: [142300, 158400, 169200, 178880], d: '较上月 增长 9.7%', tone: 'up' } };
