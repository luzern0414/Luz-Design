      <div class="dv-key"><span class="dv-bub__sz"><i style="width:25px;height:25px"></i>2 万元</span><span class="dv-bub__sz"><i style="width:34px;height:34px"></i>5 万元</span><span class="dv-bub__sz"><i style="width:44px;height:44px"></i>9.7 万元</span></div>
      <div class="dv-chart"><canvas class="dv-cv dv-cv--lg" role="img" aria-label="商品毛利率与月销量气泡图 横轴毛利率 纵轴月销量单位件 气泡面积表示月销售额 左右方向键切换商品"></canvas></div>
