  /* 018 周期切换条：最远只到当前周期，再往后禁用 */
  (() => {
    const root = demo('WB-DATA-018'), lbl = $('.dv-step__l', root), numEl = $('[data-num]', root), delta = $('[data-delta]', root), prev = $('[data-prev]', root), next = $('[data-next]', root);
    const G = { d: ['本日', '昨日', n => n + ' 日前', 184], w: ['本周', '上周', n => n + ' 周前', 1342], m: ['本月', '上月', n => n + ' 月前', 5420] };
    let g = 'w', back = 0;
    const SH = { d: [['早间', 5], ['上午', 15], ['午间', 27], ['下午', 20], ['晚间', 33]], w: [['周一', 142], ['周二', 168], ['周三', 151], ['周四', 203], ['周五', 236], ['周六', 258], ['周日', 184]], m: [['第1周', 24], ['第2周', 25], ['第3周', 26], ['第4周', 25]] };
    const box = $('.dv-pbars', root);
    const bars = total => { const sh = SH[g], sum = sh.reduce((a, x) => a + x[1], 0); let left = total; const vals = sh.map((x, i) => { const q = i === sh.length - 1 ? left : Math.round(total * x[1] / sum); left -= q; return q; }), mx = Math.max(...vals); box.innerHTML = sh.map((x, i) => `<span class="dv-pb"><b>${vals[i]}</b><i style="--h:${vals[i] / mx * 100}%"></i><span>${x[0]}</span></span>`).join(''); box.setAttribute('aria-label', '各时段订单量 ' + sh.map((x, i) => x[0] + ' ' + vals[i] + ' 单').join(' ')); };
    const val = () => { const base = G[g][3]; return Math.round(base * (1 - back * .07 + ((back * 7) % 5) / 100)); };
    const render = () => {
      const x = G[g]; lbl.textContent = back === 0 ? x[0] : back === 1 ? x[1] : x[2](back);
      next.disabled = back === 0; const v = val(), p = Math.round(x[3] * (1 - (back + 1) * .07 + (((back + 1) * 7) % 5) / 100)), d = (v - p) / p;
