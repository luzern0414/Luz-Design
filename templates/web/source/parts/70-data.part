      const gap = 2 * Math.PI / (cus.length + 2) * .8; for (let it = 0; it < 80; it++) for (let k = 0; k < cus.length; k++) { const nx = cus[(k + 1) % cus.length]; let d = nx.a - cus[k].a; if (k === cus.length - 1) d += 2 * Math.PI; if (d < gap) { const s = (gap - d) / 2; cus[k].a -= s * .5; nx.a += s * .5; } }
      cus.forEach(c => { pos[5 + c.i] = { a: c.a, r: 1 }; }); return pos;
    };
