    tbl($('[data-a11y]', root), '客户与渠道订单 单位 单', ['客户', ...CH], CU.map(c => [c[0], ...c[1].map(q => q || '无')]));
    /* 渠道排在内圈，客户按所连渠道的加权方向排在外圈，再按角度错开 */
    const place = () => {
