        if (i === act) return; const p = P[i]; ctx.beginPath(); ctx.arc(g.x(p.gm), g.y(p.q), rad(p), 0, 7); ctx.fillStyle = al('--action', 26); ctx.fill(); ctx.lineWidth = 1.5; ctx.strokeStyle = S.a; ctx.stroke();
      });
      const p = P[act], x = g.x(p.gm), y = g.y(p.q); ctx.beginPath(); ctx.arc(x, y, rad(p), 0, 7); ctx.fillStyle = al('--action', 78); ctx.fill(); ctx.lineWidth = 2.5; ctx.strokeStyle = cssv('--ink'); ctx.stroke();
