  /* 021 对比表迷你图：近七日走势为 DOM 柱，点行读明细 */
  (() => {
    const root = demo('WB-DATA-021'), body = $('tbody', root), read = $('.dv-read', root);
    const D = [['建国路店', 'mark-005', [48, 58, 50, 70, 80, 92, 76], 67308, 0.082], ['徐汇滨江店', 'mark-012', [47, 55, 49, 66, 76, 80, 57], 55040, -0.031], ['浦东世纪店', 'mark-018', [47, 55, 52, 67, 80, 86, 51], 56532, 0.054]];
    const days = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
    body.innerHTML = D.map(([n, mk, s, rev, d], i) => { const mx = Math.max(...s); return `<tr data-i="${i}" aria-selected="false" tabindex="0"><td class="t-l"><span class="who"><img src="../../kit/assets/marks/${mk}.webp" alt=""><span class="one-line">${n}</span></span></td><td><span class="dv-mini" role="img" aria-label="${n}近七日订单 ${s.join(' ')} 单">${s.map(q => `<i style="--h:${q / mx * 100}%"></i>`).join('')}</span></td><td class="t-r">${num(s.reduce((a, b) => a + b, 0))}</td><td class="t-r">${num(rev)}</td><td><span class="tag" data-tone="${d >= 0 ? 'success' : 'danger'}">${d >= 0 ? '增长' : '下降'} ${pct1(Math.abs(d))}</span></td></tr>`; }).join('');
    const rows = $$('tr', body), pick = i => { rows.forEach((r, k) => r.setAttribute('aria-selected', String(k === i))); const s = D[i][2], mx = Math.max(...s); read.innerHTML = `<span class="dv-k">${D[i][0]}</span><span class="dv-k">近七日最高</span><b>${days[s.indexOf(mx)]} ${mx} 单</b><span class="dv-k">近七日最低</span><b>${days[s.indexOf(Math.min(...s))]} ${Math.min(...s)} 单</b>`; };
    rows.forEach((r, i) => { r.addEventListener('click', () => pick(i)); r.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(i); } }); }); pick(0);
  })();

  /* 022 指标概览条：点选指标，同区显示口径 */
  (() => {
    const root = demo('WB-DATA-022'), box = $('.dv-sts', root), read = $('.dv-read', root);
    const D = [['营业额', '178,880', '元', '增长 12.4%', 'up', '已支付订单实付金额 不含退款'], ['订单量', '1,342', '单', '增长 8.1%', 'up', '已支付订单数 含到店自提'], ['客单价', '133', '元', '下降 1.6%', 'down', '营业额除以订单量'], ['新增会员', '342', '人', '增长 3.2%', 'up', '首次注册并完成绑定']];
    box.innerHTML = D.map((d, i) => `<button type="button" class="stat" aria-pressed="false" data-i="${i}"><span class="stat__label">${d[0]}</span><span class="stat__val">${d[1]}<small>${d[2]}</small></span><span class="stat__delta" data-tone="${d[4]}">${d[3]}</span></button>`).join('');
    const bs = $$('.stat', box), pick = i => { bs.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i))); read.innerHTML = `<span class="dv-k">${D[i][0]} 口径</span><b>${D[i][5]}</b>`; };
    bs.forEach((b, i) => b.addEventListener('click', () => pick(i))); pick(0);
  })();
})();
</script>

<style>
  /* 数据与图表新增：类名前缀 dv- 加子前缀，规则同上 */
  .dv-cv--m { height: 264px; }
  .dv-key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); }
  .dv-key > span { display: inline-flex; align-items: center; gap: var(--s-2); white-space: nowrap; }
  .dv-lg.dv-lg--o { padding: 3px; margin: -3px; }
  .dv-empty { display: grid; justify-items: center; gap: var(--s-2); padding: var(--s-6) 0; color: var(--ink-3); font-size: var(--fs-sm); }
  .dv-empty img { width: 40px; height: 40px; opacity: .55; }

  /* c023 */
  .dv-calw { container: dvcal / inline-size; }
  .dv-cal { display: grid; gap: var(--s-4); }
  @container dvcal (min-width: 1120px) { .dv-cal { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; } }
  .dv-cal__p { display: none; }
  @container dvcal (min-width: 1120px) { .dv-cal__p { display: grid; } .dv-cal__ip { display: none !important; } }
  .dv-cal__top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--s-3); }
  .dv-cal__top .dv-step__l { min-width: 128px; }
  .dv-cal__wk, .dv-cal__g { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .dv-cal__wk span { padding: var(--s-1) 0; text-align: center; font-size: var(--fs-sm); color: var(--ink-3); }
  .dv-cal__d { display: grid; grid-template-rows: auto minmax(0, 1fr); align-content: stretch; justify-items: stretch; gap: 4px; min-width: 0; min-height: 96px; padding: 6px; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); text-align: left; transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-cal__d:not([aria-disabled="true"]):hover { background: var(--zone); } }
  .dv-cal__d[aria-disabled="true"] { background: transparent; box-shadow: none; opacity: .45; cursor: default; }
  .dv-cal__d[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 2px var(--action); }
  .dv-cal__n { justify-self: start; display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 4px; border-radius: var(--r-full); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; }
  .dv-cal__d[aria-current="date"] .dv-cal__n { background: var(--action); color: var(--surface); }
  .dv-cal__es { display: grid; align-content: start; gap: 4px; min-width: 0; }
  .dv-cal__e { display: flex; align-items: center; gap: 5px; min-width: 0; height: 20px; padding: 0 6px; border-radius: 5px; background: color-mix(in srgb, var(--c) 13%, var(--surface)); font-size: var(--fs-xs); color: var(--ink); white-space: nowrap; }
  .dv-cal__e::before { content: ""; flex: none; width: 8px; height: 8px; background: var(--c); border-radius: 2px; }
  .dv-cal__e[data-t="a"] { --c: var(--action); }
  .dv-cal__e[data-t="b"] { --c: var(--info); }
  .dv-cal__e[data-t="c"] { --c: var(--accent); }
  .dv-cal__e[data-t="a"]::before { border-radius: 50%; }
  .dv-cal__e[data-t="c"]::before { transform: rotate(45deg) scale(.88); }
  .dv-cal__t { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .dv-cal__more { padding-left: 6px; font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-cal__p, .dv-cal__ip { gap: var(--s-3); align-content: start; padding: var(--s-4); border-radius: var(--r-md); background: var(--zone); }
  .dv-cal__ip { grid-column: 1 / -1; display: grid; margin: 2px 0; }
  .dv-cal__evs { display: grid; gap: var(--s-2); }
  .dv-cal__ip .dv-cal__evs { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s-2); }
  .dv-cal__ph { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--fs-md); font-weight: 700; }
  .dv-cal__ev { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 56px; padding: 0 var(--s-3); border-radius: var(--r-md); background: var(--surface); font-size: var(--fs-sm); }
  .dv-cal__ev time { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-cal__ev > span:not(.dv-cal__e) { display: grid; gap: 2px; min-width: 0; }
  .dv-cal__ev b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dv-cal__ev small { font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-cal__ev .dv-cal__e { width: auto; height: 22px; padding: 0 var(--s-2); font-weight: 600; }
  @container dvcal (max-width: 600px) { .dv-cal__d { min-height: 64px; } .dv-cal__e .dv-cal__t { display: none; } .dv-cal__d .dv-cal__e { width: 8px; padding: 0; background: none; height: 10px; } .dv-cal__more { display: none; } }

  /* c024 */
  .dv-tree { display: grid; gap: 2px; max-height: 340px; overflow-y: auto; padding: 4px; scrollbar-width: thin; }
  .dv-tree__r { display: grid; grid-template-columns: 24px 22px minmax(0, 1fr) auto; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-3) 0 calc(var(--s-1) + var(--lv, 0) * 24px); border-radius: var(--r-md); font-size: var(--fs-sm); cursor: pointer; transition: background var(--dur-quick) var(--ease-out); }
  .dv-tree__r[hidden] { display: none; }
  @media (hover: hover) { .dv-tree__r:hover { background: var(--zone); } }
  .dv-tree__r[aria-selected="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .dv-tree__tg { display: inline-flex; align-items: center; justify-content: center; height: 24px; border-radius: var(--r-sm); }
  @media (hover: hover) { .dv-tree__tg.chev:hover { background: var(--action-soft); } }
  .dv-tree__cb { cursor: pointer; }
  .dv-tree__cb[data-c="1"], .dv-tree__cb[data-c="m"] { background: var(--action); border-color: var(--action); }
  .dv-tree__cb[data-c="1"] img { opacity: 1; transform: none; }
  .dv-tree__cb[data-c="m"] img { display: none; }
  .dv-tree__cb[data-c="m"]::after { content: ""; width: 10px; height: 2px; border-radius: 1px; background: var(--surface); }
  .dv-tree__r[aria-disabled="true"] { cursor: default; color: var(--ink-3); }
  .dv-tree__r[aria-disabled="true"] .dv-tree__cb { background: var(--zone); border-color: var(--line); cursor: default; }
  .dv-tree__nm { display: flex; align-items: center; gap: var(--s-2); min-width: 0; white-space: nowrap; }
  .dv-tree__r[data-branch] .dv-tree__nm { font-weight: 600; }
  .dv-tree__n { color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* c025 */
  /* 区域分布：不引用在线底图与区划脚本，按省份方块排布，方块按数值着色 */
  .dv-map { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; width: min(100%, 480px); margin: 0 auto; }
  .dv-map__t { position: relative; aspect-ratio: 1 / 1; display: grid; place-content: center; justify-items: center; gap: 1px; min-width: 0; border-radius: var(--r-sm); background: var(--zone); color: var(--ink); font-variant-numeric: tabular-nums; transition: transform var(--dur-quick) var(--ease-out); }
  .dv-map__t[data-l="1"] { background: color-mix(in srgb, var(--action) 16%, var(--surface)); }
  .dv-map__t[data-l="2"] { background: color-mix(in srgb, var(--action) 32%, var(--surface)); }
  .dv-map__t[data-l="3"] { background: color-mix(in srgb, var(--action) 54%, var(--surface)); }
  .dv-map__t[data-l="4"] { background: var(--action); color: var(--surface); }
  .dv-map__t[data-l="5"] { background: var(--action-press); color: var(--surface); }
  .dv-map__t[data-l="0"] { background: repeating-linear-gradient(135deg, transparent 0 4px, var(--line) 4px 5px); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-3); }
  @media (hover: hover) { .dv-map__t:hover { transform: scale(1.08); z-index: 1; } }
  .dv-map__t[aria-pressed="true"] { outline: 2px solid var(--ink); outline-offset: 1px; z-index: 2; }
  .dv-map__n { font-size: var(--fs-sm); font-weight: 600; line-height: 1.1; }
  .dv-map__v { font-size: var(--fs-xs); line-height: 1.1; }
  .dv-map__dot { position: absolute; top: 3px; right: 3px; width: 8px; height: 8px; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 2px var(--ink); }
  .dv-map__t[data-l="0"] .dv-map__dot { background: var(--ink); box-shadow: 0 0 0 2px var(--surface); }
  .dv-map__lg { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-2) var(--s-3); font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-map__lg span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .dv-map__lg i { width: 14px; height: 14px; border-radius: 4px; background: var(--zone); }
  .dv-map__lg i[data-l="1"] { background: color-mix(in srgb, var(--action) 16%, var(--surface)); }
  .dv-map__lg i[data-l="2"] { background: color-mix(in srgb, var(--action) 32%, var(--surface)); }
  .dv-map__lg i[data-l="3"] { background: color-mix(in srgb, var(--action) 54%, var(--surface)); }
  .dv-map__lg i[data-l="4"] { background: var(--action); }
  .dv-map__lg i[data-l="5"] { background: var(--action-press); }
  .dv-map__lg i[data-l="0"] { background: repeating-linear-gradient(135deg, transparent 0 3px, var(--line-strong) 3px 4px); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-map__lg i.dv-map__lgdot { width: 10px; height: 10px; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 2px var(--ink); }

  /* c026 */
  .dv-sw--bar { height: 8px; width: 20px; border-radius: 4px; background: var(--action); }

  /* c027 */
  .dv-zm__ov { position: relative; height: 68px; border-radius: var(--r-md); background: var(--bg); box-shadow: inset 0 0 0 1px var(--line); touch-action: none; user-select: none; }
  .dv-zm__ov canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dv-zm__tr { position: absolute; left: 12px; right: 12px; top: 0; bottom: 0; cursor: grab; }
  .dv-zm__tr[data-drag] { cursor: grabbing; }
  .dv-zm__win { position: absolute; top: 4px; bottom: 4px; left: var(--l); width: var(--w); border-radius: 6px; background: color-mix(in srgb, var(--action) 9%, transparent); box-shadow: inset 0 0 0 2px var(--action); }
  .dv-zm__h { position: absolute; top: 50%; width: 14px; height: 36px; margin: -18px 0 0 -7px; border-radius: 7px; background: var(--action); cursor: ew-resize; }
  .dv-zm__h::after { content: ""; position: absolute; left: 50%; top: 11px; width: 2px; height: 14px; margin-left: -1px; border-radius: 1px; background: var(--surface); }
  .dv-zm__h[data-h="l"] { left: var(--l); }
  .dv-zm__h[data-h="r"] { left: calc(var(--l) + var(--w)); }
  .dv-zm__ov:focus-within .dv-zm__win { box-shadow: inset 0 0 0 2px var(--action-press); }

  /* c028 */
  .dv-sw--up { background: var(--success); }
  .dv-sw--down { background: var(--danger); }
  .dv-sw--sum { background: var(--action); }

  /* c029 */
  .dv-rt { display: grid; gap: 2px; }
  .dv-rt__row { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); min-height: 56px; padding: 0 var(--s-3); border-radius: var(--r-md); font-size: var(--fs-sm); }
  @media (hover: hover) { .dv-rt__row:hover { background: var(--zone); } }
  .dv-rt__row img { width: 36px; height: 36px; border-radius: var(--r-md); object-fit: cover; }
  .dv-rt__main { display: grid; gap: 2px; min-width: 0; }
  .dv-rt__main b { font-weight: 600; }
  .dv-rt__main small { font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-rt__main b, .dv-rt__main small { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dv-rt time { padding: 2px var(--s-2); border-radius: var(--r-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; cursor: default; transition: background var(--dur-quick) var(--ease-out); }
  .dv-rt time[data-fresh] { color: var(--action-press); font-weight: 600; }
  @media (hover: hover) { .dv-rt time:hover { background: var(--action-tint); } }
  .dv-rt__bar { display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); }

  /* c030 */
  .dv-cv--tm { height: 300px; }

  /* c031 */
  .dv-lp { display: grid; gap: 2px; }
  .dv-lp__r { display: grid; grid-template-columns: 32px minmax(0, 1fr) 132px; grid-template-areas: "ic nm act" "ic bar act" "ic msg act"; align-items: center; column-gap: var(--s-3); row-gap: 6px; padding: var(--s-3); border-radius: var(--r-md); font-size: var(--fs-sm); }
  @media (hover: hover) { .dv-lp__r:hover { background: var(--zone); } }
  .dv-lp__ic { grid-area: ic; align-self: start; display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--r-sm); background: var(--zone); }
  .dv-lp__ic img { width: 18px; height: 18px; }
  .dv-lp__nm { grid-area: nm; display: flex; align-items: center; gap: var(--s-2); min-width: 0; font-weight: 600; }
  .dv-lp__nm span:first-child { white-space: nowrap; }
  .dv-lp__bar { grid-area: bar; display: grid; grid-template-columns: minmax(0, 1fr) 44px; align-items: center; gap: var(--s-3); }
  .dv-lp__t { height: 8px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
  .dv-lp__t i { display: block; height: 100%; width: var(--w, 0%); border-radius: inherit; background: var(--action); transition: width var(--dur-base) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .dv-lp__r[data-st="pause"] .dv-lp__t i { background: var(--ink-3); }
  .dv-lp__r[data-st="ok"] .dv-lp__t i { background: var(--success); }
  .dv-lp__r[data-st="err"] .dv-lp__t i { background: var(--danger); }
  .dv-lp__r[data-st="wait"] .dv-lp__t { background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px); height: 2px; }
  .dv-lp__pc { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dv-lp__msg { grid-area: msg; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-lp__r[data-st="err"] .dv-lp__msg { color: var(--danger); }
  .dv-lp__act { grid-area: act; display: flex; align-items: center; justify-content: flex-end; gap: var(--s-2); }

  /* c032 */
  .dv-sw--dashbad { height: 0; width: 20px; border-radius: 0; background: none; border-top: 3px dashed var(--danger); }
  .dv-sw--dashok { height: 0; width: 20px; border-radius: 0; background: none; border-top: 3px dashed var(--success); }

  /* c033 */
  .dv-cv--net { height: 340px; cursor: pointer; }
  .dv-sw--sq { border-radius: 3px; }

  /* c034 */


  /* c035 */
  .dv-sym { display: grid; gap: 2px; }
  .dv-sym__h, .dv-sym__r { display: grid; grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr); align-items: center; column-gap: var(--s-2); padding: 0 var(--s-3); }
  .dv-sym__h { min-height: 32px; font-size: var(--fs-sm); font-weight: 600; }
  .dv-sym__h span { display: inline-flex; align-items: center; gap: var(--s-2); }
  .dv-sym__h span:last-child { justify-self: end; }
  .dv-sym__h small { font-size: var(--fs-xs); font-weight: 400; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-sym__r { width: 100%; min-height: 48px; border-radius: var(--r-md); text-align: center; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-sym__r:hover { background: var(--zone); } }
  .dv-sym__r[aria-pressed="true"] { background: var(--action-tint); }
  .dv-sym__c { line-height: 1.25; }
  .dv-sym__t { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .dv-sym__t--l { justify-content: flex-end; }
  .dv-sym__t i { display: block; flex: none; height: 18px; width: calc((100% - 56px) * var(--r)); min-width: 3px; transition: width var(--dur-slow) var(--ease-out); }
  .dv-sym__t--l i { border-radius: 6px 0 0 6px; background: var(--accent); }
  .dv-sym__t--r i { border-radius: 0 6px 6px 0; background: var(--action); }
  .dv-sym__t b { font-weight: 400; color: var(--ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dv-sym__r[aria-pressed="true"] .dv-sym__t b { font-weight: 700; color: var(--ink); }
  .dv-sym__ax { position: relative; height: 0; }

  /* c036 */
  .dv-cv--sun { height: 316px; cursor: pointer; }

  /* c037 */
  .dv-cv--sk { height: 340px; cursor: pointer; }

  /* c038 */
  .dv-bub__sz { display: inline-flex; align-items: center; gap: var(--s-2); }
  .dv-bub__sz i { display: inline-block; border-radius: 50%; background: color-mix(in srgb, var(--action) 30%, var(--surface)); box-shadow: inset 0 0 0 1.5px var(--action); }

  /* c039 */


  /* c040 */
  .dv-cv--org { height: 320px; cursor: pointer; }

  /* c041 */
  .dv-py { display: grid; gap: 2px; }
  .dv-pyr { display: grid; grid-template-columns: minmax(0, 1fr) 84px; align-items: center; gap: var(--s-3); width: 100%; min-height: 58px; padding: 0 var(--s-2); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-pyr:hover { background: var(--zone); } }
  .dv-pyr[aria-pressed="true"] { background: var(--action-tint); }
  .dv-pyr__z { display: flex; justify-content: center; }
  .dv-pyr__b { display: grid; place-content: center; width: var(--wb); height: 48px; background: var(--c); color: var(--tc); font-weight: 600; white-space: nowrap; clip-path: polygon(var(--cut) 0, calc(100% - var(--cut)) 0, 100% 100%, 0 100%); transition: width var(--dur-slow) var(--ease-out); }
  .dv-pyr__v { display: grid; justify-items: end; gap: 2px; font-variant-numeric: tabular-nums; }
  .dv-pyr__v b { font-weight: 600; }
  .dv-pyr__v small { font-size: var(--fs-xs); color: var(--ink-3); }

  /* c042 */


  /* c043 */
  .dv-wc { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--s-1) var(--s-3); padding: var(--s-4) var(--s-2); border-radius: var(--r-md); background: var(--bg); min-height: 200px; align-content: center; }
  .dv-wc__w { padding: 2px var(--s-2); border-radius: var(--r-md); font-size: var(--fs); font-weight: 600; line-height: 1.3; white-space: nowrap; color: var(--ink); transition: background var(--dur-quick) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
  .dv-wc__w[data-g="0"] { color: var(--action-press); }
  .dv-wc__w[data-g="1"] { color: var(--ink); }
  .dv-wc__w[data-g="2"] { color: var(--accent); }
  .dv-wc__w[data-s="neg"] { text-decoration: underline dotted 2px; text-underline-offset: 4px; color: color-mix(in srgb, var(--danger) 80%, black); }
  @media (hover: hover) { .dv-wc__w:hover { background: var(--zone); } }
  .dv-wc__w[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .dv-wc__w[hidden] { display: none; }

  /* c044 */
  .dv-bl { display: grid; gap: 2px; }
  .dv-blr { display: grid; grid-template-columns: 88px minmax(0, 1fr) 84px; align-items: center; gap: var(--s-3); width: 100%; min-height: 56px; padding: 0 var(--s-3); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  button.dv-blr { cursor: pointer; }
  @media (hover: hover) { button.dv-blr:hover { background: var(--zone); } }
  .dv-blr[aria-pressed="true"] { background: var(--action-tint); }
  .dv-blr__t { position: relative; height: 28px; border-radius: 6px; background: var(--b0); overflow: hidden; }
  .dv-blr__t > i { position: absolute; left: 0; top: 9px; height: 10px; width: var(--w); border-radius: 0 5px 5px 0; background: var(--action); transition: width var(--dur-slow) var(--ease-out); }
  .dv-blr__t > u { position: absolute; top: 5px; left: var(--tg); width: 3px; height: 18px; margin-left: -1px; border-radius: 1px; background: var(--ink); }
  .dv-blr[data-state="none"] .dv-blr__t { background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 12px); }
  .dv-blr__v { display: grid; gap: 2px; justify-items: end; font-variant-numeric: tabular-nums; }
  .dv-blr__v b { font-weight: 600; }
  .dv-blr__v small { font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-blr--ax { min-height: 20px; padding-top: 0; }
  .dv-bl__tk { position: relative; height: 20px; }
  .dv-bl__tk span { position: absolute; top: 0; transform: translateX(-50%); font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-bl__tk span:first-child { transform: none; }
  .dv-sw--tick { height: 16px; width: 3px; border-radius: 1px; background: var(--ink); }
  .dv-sw--b1 { background: var(--b1); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-sw--b2 { background: var(--b2); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-sw--b3 { background: var(--b3); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-bl, .dv-blk { --b0: transparent; --b1: color-mix(in srgb, var(--ink) 17%, var(--surface)); --b2: color-mix(in srgb, var(--ink) 10%, var(--surface)); --b3: color-mix(in srgb, var(--ink) 5%, var(--surface)); }

  /* c045 */


  /* c046 */
  .dv-ch { display: grid; grid-template-columns: 22px repeat(14, minmax(0, 1fr)); gap: 4px; width: min(100%, 620px); margin: 0 auto; }
  .dv-ch__m { grid-row: 1; align-self: end; font-size: var(--fs-xs); color: var(--ink-3); white-space: nowrap; line-height: 1; padding-bottom: 2px; }
  .dv-ch__w { grid-column: 1; align-self: center; text-align: center; font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-ch__c { aspect-ratio: 1 / 1; min-width: 0; border-radius: 6px; background: var(--zone); transition: transform var(--dur-quick) var(--ease-out); }
  .dv-ch__c[data-l="2"] { background: color-mix(in srgb, var(--action) 24%, var(--zone)); }
  .dv-ch__c[data-l="3"] { background: color-mix(in srgb, var(--action) 48%, var(--zone)); }
  .dv-ch__c[data-l="4"] { background: var(--action); }
  .dv-ch__c[data-l="5"] { background: var(--action-press); }
  .dv-ch__c[data-l="0"] { background: repeating-linear-gradient(135deg, transparent 0 4px, var(--line) 4px 5px); box-shadow: inset 0 0 0 1px var(--line); }
  @media (hover: hover) { .dv-ch__c:hover { transform: scale(1.14); position: relative; z-index: 1; } }
  .dv-ch__c[aria-pressed="true"] { outline: 2px solid var(--ink); outline-offset: 1px; position: relative; z-index: 2; }
  .dv-scale i.dv-scale__none { background: repeating-linear-gradient(135deg, transparent 0 3px, var(--line-strong) 3px 4px); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-chl { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
</style>

<article class="demo" data-cid="WB-DATA-024" data-name="树形控件" data-cat="DATA">
