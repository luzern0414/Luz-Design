<!-- cat: DATA | 数据与图表 -->
<style>
  /* 数据与图表：类名前缀 dv-。图表只用 canvas 或 DOM 与 conic-gradient；每个图保留对象、单位、口径，缺口不补零 */
  @property --dv-p { syntax: '<number>'; inherits: false; initial-value: 0; }
  .dv-card { --dv-c1: var(--action); --dv-c2: var(--accent); --dv-c3: var(--info); --dv-c4: var(--ink-3); display: grid; gap: var(--s-4); padding: var(--s-5); align-content: start; min-width: 0; }
  .dv-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--s-2) var(--s-3); min-width: 0; }
  .dv-head > .seg { flex: none; max-width: 100%; }
  .dv-title { font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); white-space: nowrap; }
  .dv-unit { margin-left: var(--s-2); font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .dv-read { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-1) var(--s-4); min-height: 44px; padding: var(--s-2) var(--s-4); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); font-weight: 500; color: var(--ink); font-variant-numeric: tabular-nums; }
  .dv-read b { font-weight: 700; }
  .dv-read .dv-k { color: var(--ink-3); font-weight: 400; }
  .dv-p { display: inline-flex; align-items: baseline; gap: var(--s-2); white-space: nowrap; }
  .dv-read img { width: 28px; height: 28px; border-radius: var(--r-sm); object-fit: cover; }
  .dv-cv { display: block; width: 100%; height: 208px; cursor: crosshair; border-radius: var(--r-sm); }
  .dv-cv--lg { height: 320px; }
  .dv-cv--md { height: 168px; }
  .dv-chart { position: relative; min-width: 0; }
  .dv-note { font-size: var(--fs-sm); color: var(--ink-3); }

  /* 图例按钮：形状加文字区分，不只靠颜色 */
  .dv-lg { display: flex; flex-wrap: nowrap; gap: var(--s-2); overflow-x: auto; scrollbar-width: none; }
  .dv-lg::-webkit-scrollbar { display: none; }
  .dv-lgb { flex: none; }
  .dv-lgb { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 36px; padding: 0 var(--s-3); border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-2); transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .dv-lgb small { font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-lgb[aria-pressed="true"] { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: inset 0 0 0 1px var(--line-strong), var(--elev-1); }
  .dv-lgb[aria-pressed="false"] { opacity: .62; }
  .dv-lgb[aria-pressed="false"] .dv-sw { background: transparent !important; box-shadow: inset 0 0 0 2px var(--c, var(--action)); }
  @media (hover: hover) { .dv-lgb:hover { background: var(--action-tint); } }
  .dv-sw { width: 12px; height: 12px; border-radius: 4px; background: var(--c, var(--action)); flex: none; }
  .dv-sw--dot { border-radius: 50%; }
  .dv-sw--dia { border-radius: 2px; transform: rotate(45deg) scale(.82); }
  .dv-sw--line { height: 0; width: 20px; border-radius: 0; background: none !important; border-top: 3px solid var(--c); }
  .dv-sw--dash { border-top-style: dashed; }
  .dv-sw--dot3 { border-top-style: dotted; }
  .dv-lgb[aria-pressed="false"] .dv-sw--line { box-shadow: none !important; opacity: .45; }

  /* 横向条形 */
  .dv-hb { display: grid; gap: var(--s-1); }
  .dv-hbar { display: grid; grid-template-columns: 104px minmax(0, 1fr) 52px; align-items: center; gap: var(--s-3); width: 100%; min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-hbar:hover { background: var(--zone); } }
  .dv-hbar[aria-pressed="true"] { background: var(--action-tint); }
  .dv-hbar__t { height: 12px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
  .dv-hbar[aria-pressed="true"] .dv-hbar__t { background: var(--surface); }
  .dv-hbar__t i { display: block; height: 100%; width: var(--w); border-radius: inherit; background: var(--action-edge); transform-origin: left; animation: dv-grow-x var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }
  .dv-hbar[aria-pressed="true"] .dv-hbar__t i { background: var(--action); }
  .dv-hbar__v { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }
  @keyframes dv-grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* 纵向柱状与分组柱状：左侧刻度，底部标签，点选同区明细 */
  .dv-plot { display: grid; grid-template-columns: 48px minmax(0, 1fr); grid-template-rows: 192px auto; column-gap: var(--s-2); }
  .dv-plot__y { position: relative; }
  .dv-plot__y span { position: absolute; right: 0; bottom: var(--p); transform: translateY(50%); font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dv-plot__area { position: relative; border-bottom: 1px solid var(--line-strong); background: repeating-linear-gradient(to top, transparent 0 calc(25% - 1px), var(--line) calc(25% - 1px) 25%); }
  .dv-cols { position: absolute; inset: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; align-items: end; gap: var(--s-1); }
  .dv-col { display: flex; align-items: flex-end; justify-content: center; gap: 4px; height: 100%; border-radius: var(--r-sm) var(--r-sm) 0 0; transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-col:hover { background: color-mix(in srgb, var(--action) 7%, transparent); } }
  .dv-col[aria-pressed="true"] { background: color-mix(in srgb, var(--action) 9%, transparent); }
  .dv-col i { display: block; width: min(34px, 56%); height: var(--h); border-radius: 6px 6px 0 0; background: var(--action-edge); transform-origin: bottom; animation: lz-grow var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }
  .dv-col[aria-pressed="true"] i { background: var(--action); }
  .dv-col--grp i { width: min(26px, 40%); }
  .dv-col--grp i[data-s="0"] { background: var(--action); }
  .dv-col--grp i[data-s="1"] { background: var(--surface); box-shadow: inset 0 0 0 2px var(--action); }
  .dv-col--grp i[hidden] { display: none; }
  .dv-plot__x { grid-column: 2; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-1); padding-top: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); text-align: center; }

  /* 堆叠条形 */
  .dv-stk { display: grid; gap: var(--s-3); }
  .dv-st { display: grid; grid-template-columns: 96px minmax(0, 1fr) 52px; align-items: center; gap: var(--s-3); font-size: var(--fs-sm); }
  .dv-st__t { display: flex; gap: 2px; height: 40px; }
  .dv-seg { display: grid; place-items: center; width: var(--w); min-width: 0; height: 100%; border-radius: var(--r-sm); font-size: var(--fs-xs); font-weight: 600; font-variant-numeric: tabular-nums; color: var(--surface); background: var(--c); overflow: hidden; white-space: nowrap; transition: width var(--dur-slow) var(--ease-out), opacity var(--dur-quick) var(--ease-out); }
  .dv-seg[data-ink="1"] { color: var(--ink); }
  .dv-seg:first-child { border-radius: var(--r-md) var(--r-sm) var(--r-sm) var(--r-md); }
  .dv-seg:last-child { border-radius: var(--r-sm) var(--r-md) var(--r-md) var(--r-sm); }
  .dv-seg[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--ink); z-index: 1; }
  .dv-seg[hidden] { display: none; }
  .dv-st__sum { text-align: right; color: var(--ink-2); font-variant-numeric: tabular-nums; }

  /* 环形与饼图 */
  .dv-dn { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--s-6); }
  .dv-ring { --size: 196px; position: relative; flex: none; width: var(--size); height: var(--size); border-radius: 50%; transition: background var(--dur-base) var(--ease-out); }
  .dv-ring::after { content: ""; position: absolute; inset: 20%; border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .dv-ring__c { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; text-align: center; gap: 2px; }
  .dv-ring__c span { font-size: var(--fs-sm); color: var(--ink-3); }
  .dv-ring__c b { font-size: var(--fs-2xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .dv-ring__c b small { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); margin-left: 2px; }
  .dv-lgrow { display: grid; gap: var(--s-1); min-width: 200px; }
  .dv-lgrow .dv-lgb { justify-content: flex-start; width: 100%; border-radius: var(--r-md); background: transparent; }
  .dv-lgrow .dv-lgb small { margin-left: auto; }
  .dv-lgrow .dv-lgb[aria-pressed="true"] { background: var(--action-tint); box-shadow: none; }
  .dv-lgrow .dv-lgb[aria-pressed="false"] { opacity: 1; }
  .dv-pie { --size: 196px; position: relative; flex: none; width: var(--size); height: var(--size); border-radius: 50%; cursor: pointer; box-shadow: var(--elev-2); transition: background var(--dur-base) var(--ease-out); }
  .dv-pie__l { position: absolute; transform: translate(-50%, -50%); font-size: var(--fs-xs); font-weight: 700; color: var(--ink); pointer-events: none; font-variant-numeric: tabular-nums; }
  .dv-pie__l[data-on="true"] { color: var(--surface); }

  /* 漏斗 */
  .dv-fn { display: grid; gap: 2px; }
  .dv-fnr { display: grid; grid-template-columns: 52px minmax(0, 1fr) 64px; align-items: center; gap: var(--s-3); width: 100%; min-height: 52px; padding: 0 var(--s-2); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-fnr:hover { background: var(--zone); } }
  .dv-fnr[aria-pressed="true"] { background: var(--action-tint); }
  .dv-fnr__t { display: flex; justify-content: center; }
  .dv-fnr__b { display: grid; place-content: center; width: var(--w); min-width: 96px; height: 44px; background: var(--c); color: var(--surface); font-weight: 700; font-variant-numeric: tabular-nums; clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, var(--cut) 100%); transition: width var(--dur-slow) var(--ease-out); }
  .dv-fnr__b[data-ink="1"] { color: var(--ink); }
  .dv-fnr__r { text-align: right; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* 热力：五级量化，深浅与文字对比同时满足 */
  .dv-heat { display: grid; grid-template-columns: 44px repeat(7, minmax(0, 1fr)); gap: 4px; align-items: center; }
  .dv-heat__l { font-size: var(--fs-xs); color: var(--ink-3); text-align: center; white-space: nowrap; }
  .dv-hc { height: 40px; border-radius: 6px; font-size: var(--fs-xs); font-weight: 500; font-variant-numeric: tabular-nums; color: var(--ink); background: var(--zone); transition: transform var(--dur-quick) var(--ease-out); }
  .dv-hc[data-l="2"] { background: color-mix(in srgb, var(--action) 24%, var(--zone)); }
  .dv-hc[data-l="3"] { background: color-mix(in srgb, var(--action) 48%, var(--zone)); }
  .dv-hc[data-l="4"] { background: var(--action); color: var(--surface); }
  .dv-hc[data-l="5"] { background: var(--action-press); color: var(--surface); }
  @media (hover: hover) { .dv-hc:hover { transform: scale(1.08); } }
  .dv-hc[aria-pressed="true"] { outline: 2px solid var(--ink); outline-offset: 1px; }
  .dv-scale { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-scale i { width: 28px; height: 10px; border-radius: 3px; background: var(--zone); }
  .dv-scale i:nth-of-type(2) { background: color-mix(in srgb, var(--action) 24%, var(--zone)); }
  .dv-scale i:nth-of-type(3) { background: color-mix(in srgb, var(--action) 48%, var(--zone)); }
  .dv-scale i:nth-of-type(4) { background: var(--action); }
  .dv-scale i:nth-of-type(5) { background: var(--action-press); }

  /* 仪表式目标进度 */
  .dv-gauge { position: relative; width: 264px; height: 148px; margin: 0 auto; }
  .dv-gauge__ring { --dv-p: 0; position: absolute; left: 0; top: 0; width: 264px; height: 264px; border-radius: 50%; clip-path: inset(0 0 132px 0); background: conic-gradient(from -90deg, var(--dv-fill, var(--action)) 0deg, var(--dv-fill, var(--action)) calc(var(--dv-p) * 180deg), var(--zone) calc(var(--dv-p) * 180deg), var(--zone) 180deg, transparent 180deg); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 28px), var(--ink) calc(100% - 27px)); mask: radial-gradient(farthest-side, transparent calc(100% - 28px), var(--ink) calc(100% - 27px)); transition: --dv-p 700ms var(--ease-out); }
  .dv-gauge[data-state="over"] { --dv-fill: var(--action-press); }
  .dv-gauge[data-state="none"] .dv-gauge__ring { background: repeating-conic-gradient(from -90deg, var(--line-strong) 0 2deg, transparent 2deg 6deg); }
  .dv-gauge__txt { position: absolute; left: 0; right: 0; bottom: 0; display: grid; justify-items: center; gap: 2px; }
  .dv-gauge__pct { font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .dv-gauge__pct small { font-size: var(--fs-md); font-weight: 400; color: var(--ink-3); margin-left: 2px; }
  .dv-gauge__txt > span:last-child { font-size: var(--fs-sm); color: var(--ink-3); }
  .dv-gauge__end { position: absolute; bottom: -22px; font-size: var(--fs-xs); color: var(--ink-3); }
  .dv-gauge__end--l { left: 8px; }
  .dv-gauge__end--r { right: 0; }
  .dv-gfoot { display: flex; align-items: center; justify-content: center; gap: var(--s-3); margin-top: var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); font-variant-numeric: tabular-nums; }

  /* 迷你趋势与指标组合 */
  .dv-kpi { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-5); align-items: center; }
  .dv-kpi__n { display: grid; gap: 2px; min-width: 112px; }
  .dv-kpi__n .stat__val { font-size: var(--fs-2xl); }
  .dv-kpi__n .stat__label { font-size: var(--fs-sm); color: var(--ink-3); }
  .dv-kpi canvas { display: block; width: 100%; height: 88px; cursor: crosshair; }
  .dv-big { display: flex; align-items: baseline; gap: var(--s-3); }
  .dv-big .stat__val { font-size: var(--fs-3xl); }
  .dv-big .stat__delta { font-size: var(--fs-sm); }

  /* 进度条组 */
  .dv-pgs { display: grid; gap: var(--s-1); }
  .dv-pgr { display: grid; grid-template-columns: 96px minmax(0, 1fr) 72px; align-items: center; gap: var(--s-3); width: 100%; min-height: 52px; padding: 0 var(--s-3); border-radius: var(--r-md); text-align: left; font-size: var(--fs-sm); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-pgr:hover { background: var(--zone); } }
  .dv-pgr[aria-pressed="true"] { background: var(--action-tint); }
  .dv-pgr .progress { height: 10px; position: relative; }
  .dv-pgr[aria-pressed="true"] .progress { background: var(--surface); }
  .dv-pgr .progress > i { width: var(--w); }
  .dv-pgr[data-state="over"] .progress > i { background: repeating-linear-gradient(135deg, var(--action-press) 0 6px, var(--action) 6px 12px); }
  .dv-pgr[data-state="done"] .progress > i { background: var(--success); }
  .dv-pgr[data-state="none"] .progress { background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px); height: 2px; }
  .dv-pgr__v { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dv-pgr[data-state="none"] .dv-pgr__v { font-weight: 400; color: var(--ink-3); }

  /* 排行条 */
  .dv-rk { display: grid; gap: var(--s-1); }
  .dv-rkr { display: grid; grid-template-columns: 28px 44px minmax(0, 1fr) 76px; align-items: center; gap: var(--s-3); min-height: 60px; padding: 0 var(--s-3); border-radius: var(--r-md); font-size: var(--fs-sm); animation: lz-rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }
  .dv-rkr__n { font-size: var(--fs-lg); font-weight: 700; text-align: center; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-rkr[data-top] .dv-rkr__n { color: var(--accent); }
  .dv-rkr img { width: 44px; height: 44px; border-radius: var(--r-md); object-fit: cover; }
  .dv-rkr__m { display: grid; gap: 6px; min-width: 0; }
  .dv-rkr__m b { font-weight: 600; font-size: var(--fs-sm); }
  .dv-rkr__t { height: 8px; border-radius: var(--r-full); background: var(--zone); overflow: hidden; }
  .dv-rkr__t i { display: block; height: 100%; width: var(--w); border-radius: inherit; background: var(--action); transform-origin: left; animation: dv-grow-x var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }
  .dv-rkr[data-top] .dv-rkr__t i { background: var(--accent); }
  .dv-rkr__v { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* 周期切换条 */
  .dv-per { display: grid; gap: var(--s-4); }
  .dv-per__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }
  .dv-step { display: inline-flex; align-items: center; gap: var(--s-1); padding: 3px; border-radius: var(--r-md); background: var(--zone); }
  .dv-step .ibtn { width: 36px; height: 36px; border-radius: 9px; }
  .dv-step .ibtn[disabled] { opacity: .35; pointer-events: none; }
  .dv-step .ibtn img { width: 18px; height: 18px; }
  .dv-step .ibtn--next img { transform: scaleX(-1); }
  .dv-step__l { min-width: 88px; text-align: center; font-size: var(--fs-md); font-weight: 600; }
  .dv-per__n { display: flex; align-items: baseline; gap: var(--s-3); }
  .dv-per__n .stat__val { font-size: var(--fs-3xl); }
  .dv-per__n .stat__delta { font-size: var(--fs-sm); }

  .dv-pbars { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; align-items: end; gap: var(--s-2); height: 112px; padding-top: var(--s-2); }
  .dv-pb { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; justify-items: center; gap: 4px; height: 100%; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dv-pb b { font-weight: 600; color: var(--ink-2); }
  .dv-pb i { align-self: end; width: min(28px, 60%); height: var(--h); min-height: 3px; border-radius: 6px 6px 0 0; background: var(--action-edge); animation: lz-grow var(--dur-slow) var(--ease-out) both; transform-origin: bottom; }
  .dv-pb:last-child i { background: var(--action); }
  .dv-pbbox { min-height: 112px; }

  /* 数字翻牌 */
  .dv-flip { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-3xl); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .dv-flip__c { position: relative; width: .74em; height: 1.34em; overflow: hidden; border-radius: 10px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong), var(--elev-1); }
  .dv-flip__c::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 1px solid var(--line-strong); pointer-events: none; }
  .dv-flip__c > div { transition: transform var(--dur-slow) var(--ease-spring); transform: translateY(calc(var(--d, 0) * -1.34em)); }
  .dv-flip__c > div span { display: grid; place-items: center; height: 1.34em; }
  .dv-flip__c[data-new] { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .dv-flip__s { color: var(--ink-3); align-self: flex-end; }
  .dv-flip__u { margin-left: var(--s-2); font-size: var(--fs-md); font-weight: 400; color: var(--ink-3); align-self: flex-end; padding-bottom: 6px; }
  .dv-flipbar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }

  /* 对比表迷你图 */
  .dv-tbl { overflow: hidden; }
  .dv-tbl .table { table-layout: fixed; }
  .dv-tbl .table th, .dv-tbl .table td { padding-left: var(--s-2); padding-right: var(--s-2); }
  .dv-tbl .table td.t-l, .dv-tbl .table th.t-l { padding-left: var(--s-4); }
  .dv-tbl .table tbody tr { cursor: pointer; }
  .dv-tbl .who { display: inline-flex; align-items: center; gap: 6px; }
  .dv-tbl .who img { width: 28px; height: 28px; border-radius: var(--r-sm); object-fit: cover; flex: none; }
  .dv-mini { display: inline-grid; grid-auto-flow: column; grid-auto-columns: 6px; align-items: end; gap: 4px; height: 32px; }
  .dv-mini i { display: block; height: var(--h); min-height: 3px; border-radius: 2px 2px 0 0; background: var(--action-edge); }
  .dv-mini i:last-child { background: var(--action); }

  /* 指标概览条 */
  .dv-sts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-2); }
  .dv-sts .stat { width: 100%; padding: var(--s-4) var(--s-2); border-radius: var(--r-md); transition: background var(--dur-quick) var(--ease-out); }
  @media (hover: hover) { .dv-sts .stat:hover { background: var(--zone); } }
  .dv-sts .stat[aria-pressed="true"] { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .dv-sts .stat__val { font-size: var(--fs-xl); white-space: nowrap; }
  .dv-stw { container: dvs / inline-size; }
  @container dvs (max-width: 520px) { .dv-sts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

