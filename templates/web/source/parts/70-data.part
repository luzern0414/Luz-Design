      { id: 'r2', n: '浦东世纪店', kids: [['销售组', 6], ['花艺组', 5], ['配送组', 5]] }, { id: 'r3', n: '总部职能', kids: [['采购组', 3], ['运营组', 4], ['财务组', 2]] }] };
    D.kids.forEach(s => { s.kids = s.kids.map((k, i) => ({ id: s.id + i, n: k[0], v: k[1] })); s.v = s.kids.reduce((a, k) => a + k.v, 0); }); D.v = D.kids.reduce((a, k) => a + k.v, 0);
    const all = []; const walk = (n, par) => { n.par = par; all.push(n); (n.kids || []).forEach(k => walk(k, n)); }; walk(D, null);
    const closed = new Set(['r2', 'r3']); let sel = 'r0', PL = [];
    tbl($('[data-a11y]', root), '组织架构 单位 人', ['单位', '人数', '上级'], all.map(n => [n.n, n.v, n.par ? n.par.n : '无']));
    const vis = () => { const o = []; const f = n => { o.push(n); if (n.kids && !closed.has(n.id)) n.kids.forEach(f); }; f(D); return o; };
    const NH = 30, PITCH = 38, WS = [108, 132, 112];
    const lay = w => {
      const rows = []; let r = 0; const place = n => { if (!n.kids || closed.has(n.id)) { n._y = r++; } else { n.kids.forEach(place); n._y = (n.kids[0]._y + n.kids[n.kids.length - 1]._y) / 2; } };
      place(D); const total = WS.reduce((a, b) => a + b, 0), gap = Math.min(72, Math.max(24, (w - 16 - total) / 2)), x0 = (w - total - gap * 2) / 2;
      const xs = [x0, x0 + WS[0] + gap, x0 + WS[0] + WS[1] + gap * 2];
      const lv = n => (n === D ? 0 : n.par === D ? 1 : 2); PL = {}; all.forEach(n => { const l = lv(n); PL[n.id] = { x: xs[l], y: 10 + n._y * PITCH, w: WS[l], h: NH, l }; });
      return r;
    };
    const resize = () => { const rows = lay(cv.clientWidth || 432); cv.style.height = (rows * PITCH + 18) + 'px'; };
    const draw = sizeCanvas(cv, (ctx, w, h) => {
      lay(w); const S = SKIN(); ctx.lineJoin = 'round';
      const walkDraw = n => { if (!n.kids || closed.has(n.id)) return; const p = PL[n.id]; n.kids.forEach(k => { const c = PL[k.id], xm = (p.x + p.w + c.x) / 2; ctx.beginPath(); ctx.moveTo(p.x + p.w, p.y + NH / 2); ctx.lineTo(xm, p.y + NH / 2); ctx.lineTo(xm, c.y + NH / 2); ctx.lineTo(c.x, c.y + NH / 2); ctx.strokeStyle = cssv('--line-strong'); ctx.lineWidth = 1.5; ctx.stroke(); walkDraw(k); }); };
      walkDraw(D);
      vis().forEach(n => {
        const p = PL[n.id], on = n.id === sel; rr(ctx, p.x, p.y, p.w, p.h, 8); ctx.fillStyle = on ? S.a : p.l === 0 ? tn('--action', 14) : cssv('--surface'); ctx.fill(); ctx.lineWidth = on ? 2 : 1.5; ctx.strokeStyle = on ? cssv('--action-press') : cssv('--line-strong'); ctx.stroke();
        const ink = on ? cssv('--surface') : cssv('--ink'); txt(ctx, n.n, p.x + 10, p.y + NH / 2, { b: 'middle', f: font(600, '--fs-sm'), c: ink }); txt(ctx, `${n.v} 人`, p.x + p.w - (n.kids ? 16 : 10), p.y + NH / 2, { a: 'right', b: 'middle', f: font(400), c: on ? cssv('--surface') : cssv('--ink-3') });
        if (n.kids) { const cx = p.x + p.w, cy = p.y + NH / 2, shut = closed.has(n.id); ctx.beginPath(); ctx.arc(cx, cy, 8, 0, 7); ctx.fillStyle = cssv('--surface'); ctx.fill(); ctx.lineWidth = 1.5; ctx.strokeStyle = cssv('--ink-3'); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - 3.5, cy); ctx.lineTo(cx + 3.5, cy); if (shut) { ctx.moveTo(cx, cy - 3.5); ctx.lineTo(cx, cy + 3.5); } ctx.strokeStyle = cssv('--ink-2'); ctx.stroke(); }
