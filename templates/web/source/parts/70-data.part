      ctx.textBaseline = 'alphabetic'; [100, 150, 200, 250].forEach(t => { const x = pad.l + (w - pad.l - pad.r) * (t - X0) / (X1 - X0); ctx.strokeStyle = cssv('--line'); ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, h - pad.b); ctx.stroke(); ctx.textAlign = 'center'; ctx.fillText(t, x, h - 10); });
