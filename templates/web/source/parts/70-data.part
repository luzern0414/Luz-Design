        if (nd.k === 'ch') { ctx.font = font(on ? 700 : 600); ctx.fillStyle = cssv('--ink'); ctx.lineWidth = 4; ctx.strokeStyle = cssv('--surface'); ctx.lineJoin = 'round'; ctx.strokeText(nd.n, p.x, p.y + r + 11); ctx.fillText(nd.n, p.x, p.y + r + 11); }
        else { ctx.font = font(on ? 700 : 400); ctx.fillStyle = cssv('--ink-2'); const lx = p.x + Math.cos(out) * (r + 22), ly = p.y + Math.sin(out) * (r + 11); ctx.fillText(nd.n, Math.min(w - 24, Math.max(24, lx)), Math.min(h - 10, Math.max(10, ly))); }
        ctx.globalAlpha = 1;
