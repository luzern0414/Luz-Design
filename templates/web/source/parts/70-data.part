    const dims = ['销量', '客单价', '复购率', '好评率', '配送时效'], names = ['建国路店', '徐汇滨江店', '浦东世纪店'];
    const V = [[88, 76, 72, 90, 84], [70, 86, 80, 84, 68], [62, 64, 58, 78, 90]], vars = ['--dv-c1', '--dv-c2', '--dv-c3'], tok = ['--action', '--accent', '--info'], dash = [[], [7, 5], [2, 5]], cls = ['', 'dv-sw--dash', 'dv-sw--dot3'];
    const on = [true, true, true]; let act = 0;
    lg.innerHTML = names.map((n, i) => `<button class="dv-lgb" aria-pressed="true" data-i="${i}"><i class="dv-sw dv-sw--line ${cls[i]}" style="--c:var(${vars[i]})"></i>${n}</button>`).join('');
