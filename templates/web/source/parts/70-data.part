    const draw = sizeCanvas(cv, (ctx, w, h) => {
      const cx = w / 2, cy = h / 2 + 6, R = Math.min(w / 2 - 70, h / 2 - 36), n = dims.length;
      const pt = (k, q) => { const a = -Math.PI / 2 + k * 2 * Math.PI / n; return [cx + R * q / 100 * Math.cos(a), cy + R * q / 100 * Math.sin(a), a]; };
      ctx.lineWidth = 1;
      [25, 50, 75, 100].forEach(l => { ctx.beginPath(); dims.forEach((_, k) => { const [x, y] = pt(k, l); k ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.closePath(); ctx.strokeStyle = l === 100 ? cssv('--line-strong') : cssv('--line'); ctx.stroke(); });
      dims.forEach((_, k) => { const [x, y] = pt(k, 100); ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, y); ctx.strokeStyle = k === act ? cssv('--ink-3') : cssv('--line'); ctx.lineWidth = k === act ? 1.5 : 1; ctx.stroke(); });
      dims.forEach((d, k) => { const [x, y, a] = pt(k, 100), c = Math.cos(a), s = Math.sin(a); ctx.textAlign = Math.abs(c) < .2 ? 'center' : c > 0 ? 'left' : 'right'; ctx.fillStyle = k === act ? cssv('--ink') : cssv('--ink-3'); ctx.font = `${k === act ? 600 : 400} ${cssv('--fs-sm')} ${cssv('--font')}`; ctx.fillText(d, x + c * 12, y + s * 14); });
      ctx.font = `${cssv('--fs-xs')} ${cssv('--font')}`; ctx.textBaseline = 'middle'; ctx.textAlign = 'center'; ctx.lineJoin = 'round';
      [50, 100].forEach(l => { const y = cy + R * l / 100 * Math.cos(Math.PI / 5) + 0; ctx.lineWidth = 4; ctx.strokeStyle = cssv('--surface'); ctx.strokeText(l, cx, y - 8); ctx.fillStyle = cssv('--ink-3'); ctx.fillText(l, cx, y - 8); });
