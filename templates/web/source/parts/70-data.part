    });
    const set = i => { act = i; const p = P[i]; read.innerHTML = `<img src="../../kit/assets/photo/${p.img}.webp" alt="">` + kv(`${p.n} 毛利率`, p.gm.toFixed(1) + '%') + kv('月销量', p.q + ' 件') + kv('月销售额', '¥' + num(p.s)); draw(); };
