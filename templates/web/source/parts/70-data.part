    const mount = () => { const old = $('canvas', root), c = old.cloneNode(); old.replaceWith(c); Lz.line(c, { labels, readLabels: rl, values: S[key], unit: ' 单', read: sink($('.dv-read', root)) }); a11y($('[data-a11y]', root), '订单量 ' + (key === 'cur' ? '本周' : '上周'), rl, S[key], ' 单'); };
