  /* c030 */
  (() => {
    const root = demo('WB-DATA-030'), cv = $('canvas', root), read = $('.dv-read', root);
    const ST = ['建国路店', '徐汇滨江店', '浦东世纪店'], CT = ['鲜花', '绿植', '礼盒', '花器'];
    const M = [[35000, 14908, 12400, 5000], [28600, 12140, 9500, 4800], [29332, 12200, 10200, 4800]];
    const TOT = M.flat().reduce((a, b) => a + b, 0);
    tbl($('[data-a11y]', root), '销售额 单位 元', ['门店', ...CT], ST.map((s, i) => [s, ...M[i].map(num)]));
    let key = 'store', act = 0;
    const model = () => {
      const g = key === 'store' ? ST.map((s, i) => ({ n: s, kids: CT.map((c, j) => ({ n: c, v: M[i][j] })) })) : CT.map((c, j) => ({ n: c, kids: ST.map((s, i) => ({ n: s, v: M[i][j] })) }));
      g.forEach(x => { x.v = x.kids.reduce((a, k) => a + k.v, 0); x.kids.sort((a, b) => b.v - a.v); }); g.sort((a, b) => b.v - a.v); return g;
    };
    const squarify = (items, X, Y, W, H) => {
      const out = [], tot = items.reduce((a, o) => a + o.v, 0); let it = items.map(o => ({ o, a: o.v / tot * W * H })), x = X, y = Y, w = W, h = H;
      const worst = (row, side) => { const s = row.reduce((a, r) => a + r.a, 0), mx = Math.max(...row.map(r => r.a)), mn = Math.min(...row.map(r => r.a)); return Math.max(side * side * mx / (s * s), s * s / (side * side * mn)); };
      while (it.length) {
        const side = Math.min(w, h); let row = [it[0]], k = 1;
        while (k < it.length && worst([...row, it[k]], side) <= worst(row, side)) row.push(it[k++]);
        const s = row.reduce((a, r) => a + r.a, 0);
        if (w >= h) { const rw = s / h; let yy = y; row.forEach(r => { const oh = r.a / rw; out.push({ o: r.o, x, y: yy, w: rw, h: oh }); yy += oh; }); x += rw; w -= rw; }
        else { const rh = s / w; let xx = x; row.forEach(r => { const ow = r.a / rh; out.push({ o: r.o, x: xx, y, w: ow, h: rh }); xx += ow; }); y += rh; h -= rh; }
        it = it.slice(k);
      }
      return out;
    };
    let leaves = [], groups = [];
    const layout = (w, h) => {
      const g = model(), top = squarify(g, 0, 0, w, h); groups = []; leaves = [];
      top.forEach((t, gi) => { const gx = t.x + 2, gy = t.y + 2, gw = t.w - 4, gh = t.h - 4, hd = gh >= 46 && gw >= 64 ? 22 : 0; groups.push({ ...t, x: gx, y: gy, w: gw, h: gh, hd, gi }); squarify(t.o.kids, gx, gy + hd, gw, gh - hd).forEach(k => leaves.push({ ...k, x: k.x + 1, y: k.y + 1, w: k.w - 2, h: k.h - 2, gi, par: t.o })); });
    };
    const draw = sizeCanvas(cv, (ctx, w, h) => {
      layout(w, h); const S = SKIN(), cols = ['--action', '--accent', '--info', '--ink-3']; ctx.font = font(600);
      groups.forEach(g => { const c = cols[g.gi % 4]; rr(ctx, g.x, g.y, g.w, g.h, 8); ctx.fillStyle = tn(c, 14); ctx.fill(); if (g.hd) txt(ctx, `${g.o.n} ${num(g.o.v)}`, g.x + 8, g.y + 12, { b: 'middle', f: font(700), c: cssv('--ink') }); });
      leaves.forEach((l, i) => {
        const c = cols[l.gi % 4], on = i === act; rr(ctx, l.x, l.y, l.w, l.h, 6); ctx.fillStyle = on ? cssv(c) : tn(c, 44); ctx.fill();
        if (on) { ctx.lineWidth = 2.5; ctx.strokeStyle = cssv('--ink'); ctx.stroke(); }
        ctx.font = font(600); if (l.w > 46 && l.h > 22 && ctx.measureText(l.o.n).width + 14 <= l.w) { const tc = on ? cssv('--surface') : cssv('--ink'), one = l.h < 40; txt(ctx, l.o.n, l.x + 7, one ? l.y + l.h / 2 : l.y + 15, { b: 'middle', f: font(600), c: tc }); if (!one && l.h > 46 && l.w > 62) txt(ctx, num(l.o.v), l.x + 7, l.y + 33, { b: 'middle', f: font(400), c: tc }); }
      });
    });
    const set = i => { act = i; const l = leaves[i]; if (!l) return; read.innerHTML = kv(`${l.par.n} ${l.o.n}`, num(l.o.v) + ' 元') + kv(`占${l.par.n}`, pct1(l.o.v / l.par.v)) + kv('占全部', pct1(l.o.v / TOT)); draw(); };
    wire(cv, { at: (x, y) => { const k = leaves.findIndex(l => x >= l.x && x <= l.x + l.w && y >= l.y && y <= l.y + l.h); return k; }, n: () => leaves.length, get: () => act, set });
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'dv-tm') { key = e.detail.key; act = 0; layout(cv.clientWidth, cv.clientHeight); set(0); } });
    layout(cv.clientWidth || 432, cv.clientHeight || 300); set(0);
  })();

  /* c031 */
  (() => {
    const root = demo('WB-DATA-031'), box = $('.dv-lp', root), read = $('.dv-read', root);
    const T0 = () => [
      { id: 'a', name: '会员名单导入', ic: 'file-add', total: 20000, unit: '行', p: 63, st: 'pause' },
      { id: 'b', name: '商品图片上传', ic: 'upload', total: 48, unit: '张', p: 100, st: 'ok' },
      { id: 'c', name: '订单明细导出', ic: 'archive', total: 8420, unit: '条', p: 41, st: 'err', msg: '导出服务无响应 已保留进度' },
      { id: 'd', name: '库存盘点单提交', ic: 'list', total: 126, unit: '项', p: 0, st: 'wait' }];
    let T = T0(), timer = null, focus = null;
    const TAG = { run: ['action', '进行中'], pause: ['', '已暂停'], ok: ['success', '已完成'], err: ['danger', '失败'], wait: ['', '等待中'] };
    const ACT = { run: [['pause', '暂停', 'ghost']], pause: [['go', '继续', 'tint']], ok: [['del', '清除', 'ghost']], err: [['go', '重试', 'tint'], ['del', '取消', 'ghost']], wait: [['go', '开始', 'tint'], ['del', '取消', 'ghost']] };
    const done = t => Math.round(t.total * t.p / 100);
    const meta = t => (t.st === 'err' ? t.msg : `已处理 ${num(done(t))} / ${num(t.total)} ${t.unit}`);
    const summary = () => {
      if (!T.length) { read.innerHTML = kv('任务', '暂无'); return; }
      const c = s => T.filter(t => t.st === s).length;
      read.innerHTML = kv('任务', T.length + ' 项') + kv('进行中', c('run') + ' 项') + kv('已完成', c('ok') + ' 项') + kv('失败', c('err') + ' 项') + kv('等待与暂停', (c('wait') + c('pause')) + ' 项');
    };
    const render = () => {
      if (!T.length) { box.innerHTML = '<div class="dv-empty"><img src="../../kit/assets/line/folder.webp" alt=""><span>没有任务</span><button class="btn btn--tint btn--sm" data-act="reload">重新载入</button></div>'; summary(); return; }
      box.innerHTML = T.map(t => `<div class="dv-lp__r" role="listitem" data-id="${t.id}" data-st="${t.st}"><span class="dv-lp__ic"><img src="../../kit/assets/line/${t.ic}.webp" alt=""></span><span class="dv-lp__nm"><span>${t.name}</span><span class="tag"${TAG[t.st][0] ? ` data-tone="${TAG[t.st][0]}"` : ''}>${TAG[t.st][1]}</span></span><span class="dv-lp__bar"><span class="dv-lp__t" role="progressbar" aria-label="${t.name}进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${t.p}"><i style="--w:${t.p}%"></i></span><span class="dv-lp__pc">${t.p}%</span></span><span class="dv-lp__msg">${meta(t)}</span><span class="dv-lp__act">${ACT[t.st].map(a => `<button class="btn btn--${a[2]} btn--sm" data-act="${a[0]}" data-id="${t.id}">${a[1]}</button>`).join('')}</span></div>`).join('');
      summary();
      if (focus) { const b = $(`[data-act][data-id="${focus}"]`, box) || $('[data-act]', box); if (b) b.focus(); focus = null; }
    };
    const tick = () => {
      const run = T.filter(t => t.st === 'run'); if (!run.length) { clearInterval(timer); timer = null; return; }
      let changed = false;
      run.forEach(t => { t.p = Math.min(100, t.p + 5); if (t.p === 100) { t.st = 'ok'; changed = true; } });
      if (changed) { render(); return; }
      run.forEach(t => { const r = $(`.dv-lp__r[data-id="${t.id}"]`, box); if (!r) return; $('.dv-lp__t i', r).style.setProperty('--w', t.p + '%'); $('.dv-lp__t', r).setAttribute('aria-valuenow', t.p); $('.dv-lp__pc', r).textContent = t.p + '%'; $('.dv-lp__msg', r).textContent = meta(t); });
    };
    box.addEventListener('click', e => {
      const b = e.target.closest('[data-act]'); if (!b) return;
