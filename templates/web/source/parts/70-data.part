    a11y($('[data-a11y]', root), '营业额 近十二周', v.map((_, i) => '第' + (i + 1) + '周'), v, ' 万元');
    const draw = sizeCanvas(cv, (ctx, w, h) => {
      const pad = { l: 28, r: 10, t: 12, b: 26 }, hi = 20, n = v.length;
      const x = i => pad.l + (w - pad.l - pad.r) * i / (n - 1), y = q => pad.t + (h - pad.t - pad.b) * (1 - q / hi);
      ctx.font = `${cssv('--fs-xs')} ${cssv('--font')}`; ctx.fillStyle = cssv('--ink-3'); ctx.strokeStyle = cssv('--line'); ctx.lineWidth = 1; ctx.textBaseline = 'middle';
      [0, 5, 10, 15, 20].forEach(t => { ctx.beginPath(); ctx.moveTo(pad.l, y(t)); ctx.lineTo(w - pad.r, y(t)); ctx.stroke(); ctx.textAlign = 'right'; ctx.fillText(t, pad.l - 8, y(t)); });
      ctx.textBaseline = 'alphabetic'; [[0, '第1周', 'left'], [5, '第6周', 'center'], [11, '第12周', 'right']].forEach(([i, t, a]) => { ctx.textAlign = a; ctx.fillText(t, x(i), h - 6); });
