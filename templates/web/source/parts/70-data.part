<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const demo = id => document.querySelector(`[data-cid="${id}"]`);
  const num = n => n.toLocaleString('zh-CN');
  const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const rgb = h => { h = h.replace('#', ''); if (h.length === 3) h = [...h].map(c => c + c).join(''); return [0, 2, 4].map(i => parseInt(h.slice(i, i + 2), 16)); };
  const mix = (a, b, p) => { const A = rgb(a), B = rgb(b); return `rgb(${A.map((x, i) => Math.round(x * p + B[i] * (1 - p))).join(',')})`; };
  const rgba = (h, a) => `rgba(${rgb(h).join(',')},${a})`;
  const skinFns = []; new MutationObserver(() => skinFns.forEach(f => f())).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  const onSkin = f => skinFns.push(f);
  const a11y = (host, cap, labels, values, unit) => { host.innerHTML = `<table><caption>${cap}</caption><thead><tr><th>项目</th><th>数值</th></tr></thead><tbody>${labels.map((l, i) => `<tr><th>${l}</th><td>${values[i] == null ? '暂无数据' : num(values[i]) + unit}</td></tr>`).join('')}</tbody></table>`; };
  const pct1 = r => (Math.round(r * 1000) / 10) + '%';
  /* 读数：标签与数值成对，换行时整对一起走；折线读数由 Lz.line 写纯文字，经 sink 转成同样的标签加数值 */
  const pairUp = el => { [...el.children].forEach(k => { const b = k.nextElementSibling; if (k.classList.contains('dv-k') && b && b.tagName === 'B') { const p = document.createElement('span'); p.className = 'dv-p'; k.before(p); p.append(k, b); } }); };
