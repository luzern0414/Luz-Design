<article class="demo" data-cid="WB-FEED-021" data-name="页内提示条" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">页内提示条</span></div>
  <p class="demo__note">适合：页面顶部的持续提醒，四种语义可关闭</p>
  <div class="demo__stage">
    <div class="card fb-card" id="fb-ban">
      <div class="fb-bans">
        <div class="fb-bw"><div><div class="fb-ban" data-tone="success" role="status"><b>成功</b><span>三家门店库存已同步</span><button type="button" class="ibtn" data-close data-tip="关闭" aria-label="关闭提示"><img src="../../kit/assets/line/close.webp" alt=""></button></div></div></div>
        <div class="fb-bw"><div><div class="fb-ban" data-tone="info" role="status"><b>通知</b><span>新版经营报表已上线</span><button type="button" class="ibtn" data-close data-tip="关闭" aria-label="关闭提示"><img src="../../kit/assets/line/close.webp" alt=""></button></div></div></div>
        <div class="fb-bw"><div><div class="fb-ban" data-tone="warning" role="alert"><b>警告</b><span>红玫瑰花束库存低于 10 件</span><button type="button" class="ibtn" data-close data-tip="关闭" aria-label="关闭提示"><img src="../../kit/assets/line/close.webp" alt=""></button></div></div></div>
        <div class="fb-bw"><div><div class="fb-ban" data-tone="danger" role="alert"><b>错误</b><span>支付渠道连接失败</span><button type="button" class="ibtn" data-close data-tip="关闭" aria-label="关闭提示"><img src="../../kit/assets/line/close.webp" alt=""></button></div></div></div>
      </div>
      <div class="fb-bar fb-bar--end"><button type="button" class="btn btn--text btn--sm" data-restore>恢复全部</button></div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const demo = id => document.querySelector(`[data-cid="${id}"]`);
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const num = n => n.toLocaleString('zh-CN');
  const A = '../../kit/assets';
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  /* 001 至 003 轻提示：样张加真实触发 */
  ['WB-FEED-001', 'WB-FEED-002', 'WB-FEED-003'].forEach(id => { const b = $('[data-fire]', demo(id)); b.addEventListener('click', () => Lz.toast(b.dataset.fire, b.dataset.tone)); });

  /* 004 删除确认：居中框、无输入，确认后行内撤销 */
  (() => {
    const box = $('#fb-del');
    box.addEventListener('click', async e => {
      const del = e.target.closest('[data-del]'), un = e.target.closest('[data-undo]');
      if (del) { const r = del.closest('.row'); const ok = await Lz.confirm({ title: '删除' + r.dataset.n, ok: '删除', cancel: '取消', tone: 'danger' }); if (ok) { r.dataset.gone = 'true'; Lz.toast('已删除', 'success'); $('[data-undo]', r).focus(); } else Lz.toast('已取消'); }
      else if (un) { const r = un.closest('.row'); r.dataset.gone = 'false'; Lz.toast('已撤销', 'success'); $('[data-del]', r).focus(); }
    });
  })();

  /* 005 发布确认：上架与下架共用主题色确认框 */
  (() => {
    const box = $('#fb-pub');
    box.addEventListener('click', async e => {
      const b = e.target.closest('[data-act]'); if (!b) return; const r = b.closest('.row'), on = r.dataset.on === 'true';
      const ok = await Lz.confirm({ title: (on ? '下架' : '上架') + r.dataset.n, ok: on ? '下架' : '上架', cancel: '取消', tone: 'primary' });
      if (!ok) return; r.dataset.on = String(!on);
      const st = $('[data-st]', r); st.textContent = on ? '已下架' : '已上架'; st.dataset.tone = on ? '' : 'success'; if (on) st.removeAttribute('data-tone');
      b.textContent = on ? '上架' : '下架'; b.className = 'btn btn--sm ' + (on ? 'btn--primary' : 'btn--ghost');
      Lz.toast(on ? '已下架' : '已上架', 'success'); b.focus();
    });
  })();

  /* 006 结果页：三态切换，处理中自动落到成功 */
  (() => {
    const card = $('#fb-res-card'), res = $('.fb-res', card); let timer = 0;
    const S = {
      ok: { t: '订单已提交', kv: [['订单号', '10382'], ['金额', '¥199.00'], ['门店', '建国路店']], b: [['查看订单', 'primary', '正在打开订单'], ['继续开单', 'ghost', '已清空开单页']] },
      fail: { t: '订单提交失败', kv: [['订单号', '未生成'], ['失败原因', '库存不足'], ['门店', '建国路店']], b: [['重新提交', 'primary', 'wait'], ['返回修改', 'ghost', '已回到开单页']] },
      wait: { t: '订单提交中', kv: [['订单号', '待生成'], ['金额', '¥199.00'], ['门店', '建国路店']], b: [['取消', 'ghost', '已取消提交']] },
    };
    const show = k => {
      clearTimeout(timer); const s = S[k]; res.dataset.state = k; $('h3', res).textContent = s.t;
      $('.fb-res__ic img', res).src = A + (k === 'fail' ? '/line/close.webp' : '/line/check.webp');
      $('dl', res).innerHTML = s.kv.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join('');
      $('.btn-group', res).innerHTML = s.b.map(([t, c, m]) => `<button type="button" class="btn btn--${c}" data-m="${m}">${t}</button>`).join('');
      res.classList.remove('is-in'); void res.offsetWidth; res.classList.add('is-in');
      $$('.seg__item', card).forEach(b => b.setAttribute('aria-selected', String(b.dataset.key === k)));
      if (k === 'wait') timer = setTimeout(() => show('ok'), 1800);
    };
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'fb-res') show(e.detail.key); });
    $('.btn-group', res).addEventListener('click', e => { const b = e.target.closest('[data-m]'); if (!b) return; if (b.dataset.m === 'wait') show('wait'); else Lz.toast(b.dataset.m, b.dataset.m.startsWith('已取消') ? 'neutral' : 'success'); });
  })();

  /* 007 卡片空态：刷新带加载态 */
  (() => { const b = $('#fb-refresh'); b.addEventListener('click', async () => { b.classList.add('is-loading'); await sleep(900); b.classList.remove('is-loading'); Lz.toast('已是最新'); }); })();

  /* 008 表格空态：已下架没有行，显示 3D 图标 */
  (() => {
    const body = $('tbody', demo('WB-FEED-008'));
    const D = [['粉芍药花束', 'product-peony-pink', 239, 24], ['白郁金香', 'product-tulip-white', 179, 52], ['龟背竹盆栽', 'product-monstera', 159, 18]];
    const render = k => { body.innerHTML = k === 'on' ? D.map(d => `<tr><td class="t-l"><span class="who"><img src="${A}/photo/${d[1]}.webp" alt="" style="border-radius:var(--r-sm)"><span class="one-line">${d[0]}</span></span></td><td class="t-r">${d[2]}</td><td class="t-r">${d[3]}</td><td><span class="tag" data-tone="success">在售</span></td></tr>`).join('') : `<tr><td class="fb-none" colspan="4"><div class="fb-empty fb-empty--sm"><img data-ic="bouquet" src="${A}/icons/${Lz.iconSet()}/bouquet.webp" alt=""><p>暂无下架商品</p></div></td></tr>`; };
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'fb-te') render(e.detail.key); });
  })();

  /* 009 无结果：实时过滤，无匹配显示空态与清空 */
  (() => {
    const q = $('#fb-q'), x = $('#fb-qx'), box = $('#fb-plist');
    const P = [['红玫瑰花束', 'product-rose-red', 199], ['粉芍药花束', 'product-peony-pink', 239], ['向日葵花束', 'product-sunflower', 159], ['白郁金香', 'product-tulip-white', 179], ['蓝绣球盆栽', 'product-hydrangea-blue', 129], ['龟背竹盆栽', 'product-monstera', 159]];
    const render = () => {
      const k = q.value.trim(); x.hidden = !k; const r = P.filter(p => p[0].includes(k));
      box.innerHTML = r.length ? r.map(p => `<div class="row"><img class="row__lead" src="${A}/photo/${p[1]}.webp" alt=""><span class="row__main"><span class="row__title">${k ? p[0].replace(k, m => `<mark>${esc(m)}</mark>`) : p[0]}</span></span><span class="row__trail"><span class="price"><small>¥</small>${p[2]}</span></span></div>`).join('') : `<div class="fb-empty fb-empty--sm" role="status"><img data-ic="vase" src="${A}/icons/${Lz.iconSet()}/vase.webp" alt=""><p>无匹配商品</p><button type="button" class="btn btn--secondary btn--sm" data-clear>清空搜索</button></div>`;
    };
    q.addEventListener('input', render); x.addEventListener('click', () => { q.value = ''; render(); q.focus(); });
    box.addEventListener('click', e => { if (e.target.closest('[data-clear]')) { q.value = ''; render(); q.focus(); } });
    render();
  })();

  /* 010 无权限：申请后按钮转为已提交 */
  (() => { const b = $('#fb-apply'); b.addEventListener('click', async () => { b.classList.add('is-loading'); await sleep(800); b.classList.remove('is-loading'); b.disabled = true; b.textContent = '已提交申请'; Lz.toast('申请已提交', 'success'); }); })();

  /* 011 加载失败重试：前两次仍失败，第三次成功 */
  (() => {
    const card = $('#fb-err'), fail = $('[data-fb="fail"]', card), ok = $('[data-fb="ok"]', card), btn = $('[data-retry]', card), tries = $('[data-tries]', card); let n = 0;
    btn.addEventListener('click', async () => {
      btn.classList.add('is-loading'); await sleep(1000); btn.classList.remove('is-loading'); n++;
      if (n < 3) { tries.textContent = `已重试 ${n} 次`; Lz.toast('仍然失败', 'danger'); }
      else { fail.hidden = true; ok.hidden = false; Lz.toast('已加载', 'success'); $('[data-reset]', card).focus(); }
    });
    $('[data-reset]', card).addEventListener('click', () => { n = 0; tries.textContent = '已重试 0 次'; ok.hidden = true; fail.hidden = false; btn.focus(); });
  })();

  /* 012 骨架卡 */
  (() => {
    const root = $('#fb-skc'), grid = $('.fb-grid3', root), btn = $('[data-reload]', root);
    const P = [['红玫瑰花束', 'product-rose-red', 199, '热卖'], ['粉芍药花束', 'product-peony-pink', 239, '新品'], ['向日葵花束', 'product-sunflower', 159, '']];
    const real = () => P.map((p, i) => `<div class="fb-pc" style="--i:${i}"><img src="${A}/photo/${p[1]}.webp" alt=""><span class="fb-pc__n">${p[0]}</span><span class="fb-pc__f"><span class="price"><small>¥</small>${p[2]}</span>${p[3] ? `<span class="tag" data-tone="${p[3] === '热卖' ? 'price' : 'action'}">${p[3]}</span>` : ''}</span></div>`).join('');
    const sk = () => [0, 1, 2].map(() => '<div class="fb-pc" aria-hidden="true"><div class="skel"></div><span class="skel" style="height:16px;width:70%"></span><span class="skel" style="height:16px;width:44%"></span></div>').join('');
    const load = async () => { grid.setAttribute('aria-busy', 'true'); grid.innerHTML = sk(); btn.disabled = true; await sleep(1400); grid.innerHTML = real(); grid.setAttribute('aria-busy', 'false'); btn.disabled = false; };
    grid.innerHTML = real(); btn.addEventListener('click', load);
    const io = new IntersectionObserver(es => { if (es[0].isIntersecting) { io.disconnect(); load(); } }, { threshold: .6 }); io.observe(grid);
  })();

  /* 013 骨架表 */
  (() => {
    const root = $('#fb-skt'), body = $('tbody', root), tb = $('table', root), btn = $('[data-reload]', root);
    const R = [['10382', '林晓', '199.00', '待发货', 'action'], ['10517', '陈默', '239.00', '待收货', 'info'], ['10890', '周岚', '159.00', '已完成', 'success'], ['10921', '吴桐', '179.00', '待付款', 'warning']];
    const real = () => R.map(r => `<tr><td>${r[0]}</td><td class="t-l">${r[1]}</td><td class="t-r">${r[2]}</td><td><span class="tag" data-tone="${r[4]}">${r[3]}</span></td></tr>`).join('');
    const sk = () => R.map(() => '<tr aria-hidden="true"><td><span class="skel" style="width:60%"></span></td><td><span class="skel" style="width:46%;margin-left:var(--s-5)"></span></td><td><span class="skel" style="width:50%;margin-left:auto"></span></td><td><span class="skel" style="width:56px;height:22px;border-radius:7px"></span></td></tr>').join('');
    const load = async () => { tb.setAttribute('aria-busy', 'true'); body.innerHTML = sk(); btn.disabled = true; await sleep(1400); body.innerHTML = real(); tb.setAttribute('aria-busy', 'false'); btn.disabled = false; };
    body.innerHTML = real(); btn.addEventListener('click', load);
  })();

  /* 014 加载中遮罩：数值在遮罩下更新 */
  (() => {
    const root = $('#fb-busy'), btn = $('[data-go]', demo('WB-FEED-014')); let k = 0;
    const V = [['178,880', '1,342', '342'], ['179,260', '1,347', '344'], ['180,114', '1,355', '347']];
    btn.addEventListener('click', async () => { root.dataset.busy = 'true'; btn.disabled = true; await sleep(1300); k = (k + 1) % V.length; $$('[data-v]', root).forEach(b => { b.textContent = V[k][+b.dataset.v]; }); root.dataset.busy = 'false'; btn.disabled = false; Lz.toast('已刷新', 'success'); });
  })();

  /* 015 上传进度：两个文件各自推进，可取消 */
  (() => {
    const root = $('#fb-up'), ups = $$('.fb-up', root), go = $('[data-go]', root), stop = $('[data-stop]', root);
    const TOT = [18, 326], UN = ['张', '条']; let t = null;
    const set = (u, i, n) => { u.v = n; u.querySelector('.progress > i').style.setProperty('--v', n + '%'); u.querySelector('.progress').setAttribute('aria-valuenow', n); $('[data-pct]', u).textContent = n + '%'; $('[data-sz]', u).textContent = `${Math.round(TOT[i] * n / 100)} / ${TOT[i]} ${UN[i]}`; };
    const state = (u, s, txt, tone) => { u.dataset.state = s; const g = $('[data-s]', u); g.textContent = txt; if (tone) g.dataset.tone = tone; else g.removeAttribute('data-tone'); };
    const end = () => { clearInterval(t); t = null; go.disabled = false; stop.disabled = true; };
    ups.forEach((u, i) => { set(u, i, 0); });
    go.addEventListener('click', () => { ups.forEach((u, i) => { set(u, i, 0); u.speed = 3 + i * 4; state(u, 'run', '上传中', 'action'); }); go.disabled = true; stop.disabled = false;
      t = setInterval(() => { ups.forEach((u, i) => { if (u.v >= 100) return; const n = Math.min(100, u.v + u.speed + (u.v % 3)); set(u, i, n); if (n >= 100) state(u, 'done', '已完成', 'success'); }); if (ups.every(u => u.v >= 100)) { end(); go.textContent = '重新上传'; Lz.toast('上传完成', 'success'); } }, 120); });
    stop.addEventListener('click', () => { end(); ups.forEach((u, i) => { if (u.v < 100) state(u, 'stop', '已取消'); }); Lz.toast('已取消上传'); });
  })();

  /* 016 行内保存：保存中禁用开关，第三项首次失败后回滚并可重试 */
  (() => {
    const box = $('#fb-save');
    const run = async (row, sw, on) => {
      const sv = $('.fb-saving', row), rt = $('[data-retry]', row), meta = $('[data-meta]', row);
      sv.hidden = false; rt.hidden = true; sw.setAttribute('aria-disabled', 'true'); meta.textContent = on ? '正在上架' : '正在下架'; meta.removeAttribute('data-tone');
      await sleep(900); sv.hidden = true; sw.removeAttribute('aria-disabled');
      if (row.dataset.fail === '1') { row.dataset.fail = '0'; sw.setAttribute('aria-checked', String(!on)); meta.textContent = '保存失败'; meta.dataset.tone = 'danger'; rt.hidden = false; row.dataset.want = String(on); Lz.toast('保存失败', 'danger'); return; }
      meta.textContent = on ? '已上架' : '已下架'; Lz.toast('已保存', 'success');
    };
    document.addEventListener('lz:toggle', e => { const sw = e.target.closest && e.target.closest('#fb-save [role="switch"]'); if (!sw) return; run(sw.closest('.fb-save'), sw, sw.getAttribute('aria-checked') === 'true'); });
    box.addEventListener('click', e => { const r = e.target.closest('[data-retry]'); if (!r) return; const row = r.closest('.fb-save'), sw = $('[role="switch"]', row), on = row.dataset.want === 'true'; sw.setAttribute('aria-checked', String(on)); run(row, sw, on); });
  })();

  /* 017 订单状态：按业务动词推进，售后为终态 */
  (() => {
    const box = $('#fb-ord');
    const ST = [['待付款', 'warning', '确认收款', 'primary'], ['待发货', 'action', '发货', 'primary'], ['待收货', 'info', '确认送达', 'primary'], ['已完成', 'success', '申请售后', 'ghost'], ['售后', 'danger', '', '']];
    const O = [['10382', '林晓', 'mark-001', 199, 1], ['10517', '陈默', 'mark-002', 239, 2], ['10921', '周岚', 'mark-003', 159, 0]];
    const paint = row => { const s = ST[+row.dataset.st], tag = $('.tag', row), b = $('.btn', row); tag.textContent = s[0]; tag.dataset.tone = s[1]; b.hidden = !s[2]; if (s[2]) { b.textContent = s[2]; b.className = 'btn btn--sm btn--' + s[3]; } };
    box.innerHTML = O.map(o => `<div class="fb-ord" tabindex="-1" data-st="${o[4]}"><img src="${A}/marks/${o[2]}.webp" alt=""><span class="fb-ord__m"><span class="row__title" style="display:block">订单 ${o[0]}</span><span class="row__meta" style="display:block">${o[1]} <span class="price" style="font-weight:400"><small>¥</small>${o[3]}</span></span></span><span class="tag"></span><button type="button" class="btn btn--sm"></button></div>`).join('');
    $$('.fb-ord', box).forEach(paint);
    box.addEventListener('click', e => { const b = e.target.closest('.btn'); if (!b) return; const r = b.closest('.fb-ord'), n = +r.dataset.st; r.dataset.st = Math.min(4, n + 1); paint(r); Lz.toast(n === 3 ? '已申请售后' : '状态已更新', 'success'); (b.hidden ? r : b).focus({ preventScroll: true }); });
  })();

  /* 018 红点角标：圆点、数字、九十九加、文字 */
  (() => {
    const root = $('#fb-ibs'), S = { msg: 3, ord: 'dot', cus: 128, set: '新' };
    const paint = (el, v) => { const b = $('.fb-bdg', el); if (v === 0 || v === '') { b.hidden = true; return; } b.hidden = false; if (v === 'dot') { b.setAttribute('data-dot', ''); b.textContent = ''; } else { b.removeAttribute('data-dot'); b.textContent = typeof v === 'number' && v > 99 ? '99+' : v; } };
    const pop = el => { const b = $('.fb-bdg', el); b.classList.remove('is-pop'); void b.offsetWidth; b.classList.add('is-pop'); };
    $$('.fb-ib', root).forEach(el => { paint(el, S[el.dataset.k]); el.addEventListener('click', () => { S[el.dataset.k] = 0; paint(el, 0); }); });
    $('[data-add]', root).addEventListener('click', () => { const el = $('[data-k="msg"]', root); S.msg = (typeof S.msg === 'number' ? S.msg : 0) + 1; paint(el, S.msg); pop(el); });
    $('[data-clear]', root).addEventListener('click', () => { $$('.fb-ib', root).forEach(el => { S[el.dataset.k] = 0; paint(el, 0); }); });
  })();

  /* 019 通知中心：面板内逐条已读，Escape 与点外部关闭并回到触发器 */
  (() => {
    const root = $('#fb-nc'), panel = $('#fb-nc-panel'), trig = $('[data-trigger]', root), list = $('.fb-nc__list', root), badge = $('[data-n]', root); let filter = 'all';
    const N = [['solid/biz-store', '新订单待发货', '建国路店 刚刚', true], ['solid/bill', '本周报表已生成', '昨天', true], ['solid/biz-review', '收到一条售后申请', '徐汇滨江店 昨天', true], ['solid/solid-tasks', '红玫瑰花束库存不足', '浦东世纪店 昨天', false]];
    const unread = () => N.filter(n => n[3]).length;
    const render = () => {
      const rows = N.map((n, i) => ({ n, i })).filter(x => filter === 'all' || x.n[3]);
      list.innerHTML = rows.length ? rows.map(({ n, i }) => `<button type="button" class="row fb-nc__row" data-i="${i}" data-unread="${n[3]}"><img class="row__lead" src="${A}/${n[0]}.webp" alt=""><span class="row__main"><span class="row__title">${n[1]}</span><span class="row__meta">${n[2]}</span></span><span class="row__trail"><i class="fb-dot"></i></span></button>`).join('') : '<p class="fb-nc__none">没有未读通知</p>';
      const u = unread(); badge.hidden = !u; badge.textContent = u; trig.setAttribute('aria-label', u ? `通知 ${u} 条未读` : '通知');
      $('[data-all]', root).disabled = !u;
    };
    let touched = false;
    const open = o => { panel.hidden = !o; root.dataset.open = String(o); trig.setAttribute('aria-expanded', String(o)); if (o) { panel.style.animation = 'none'; void panel.offsetWidth; panel.style.animation = ''; } };
    trig.addEventListener('click', e => { e.stopPropagation(); touched = true; open(panel.hidden); });
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'fb-nc') { filter = e.detail.key; render(); } });
    list.addEventListener('click', e => { const r = e.target.closest('.fb-nc__row'); if (!r) return; N[+r.dataset.i][3] = false; render(); });
    $('[data-all]', root).addEventListener('click', () => { N.forEach(n => { n[3] = false; }); render(); Lz.toast('已全部标为已读', 'success'); });
    document.addEventListener('click', e => { if (touched && !panel.hidden && !root.contains(e.target)) open(false); });
    root.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) { open(false); trig.focus(); } });
    render();
  })();

  /* 021 页内提示条：逐条关闭，恢复全部 */
  (() => {
    const root = $('#fb-ban');
    root.addEventListener('click', e => { const c = e.target.closest('[data-close]'); if (c) { c.closest('.fb-bw').dataset.gone = ''; $('[data-restore]', root).focus(); } if (e.target.closest('[data-restore]')) $$('.fb-bw', root).forEach(b => b.removeAttribute('data-gone')); });
  })();
})();
</script>

<style>
  /* 反馈与状态（补充）：居中详情 fb-dg、气泡卡片 fb-pp、可关闭标签 fb-ct、通知卡 fb-nt、计数徽标 fb-cn、状态徽章 fb-ls、公告横幅 fb-bn、悬停预览 fb-hc */

  /* 居中详情弹层：只读内容，关闭靠文字按钮、遮罩与 Esc */
  .fb-dgl .row { min-height: 64px; }
  .fb-dgl .avatar { width: 40px; height: 40px; }
  .fb-dg-mask { position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; padding: var(--s-6); background: var(--scrim); overscroll-behavior: contain; animation: lz-fade var(--dur-base) var(--ease-out) both; }
  .fb-dg { width: min(640px, 100%); max-height: 100%; overflow: auto; background: var(--surface); border-radius: var(--r-xl); box-shadow: var(--elev-4); color: var(--ink); animation: lz-dialog var(--dur-base) var(--ease-out) both; }
  .fb-dg:focus-visible { outline-offset: -3px; }
  .fb-dg__head { display: flex; align-items: center; gap: var(--s-3); min-height: 64px; padding: 0 var(--s-6); border-bottom: 1px solid var(--line); }
  .fb-dg__head h2 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .fb-dg__pos { margin-left: auto; font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .fb-dg__body { display: grid; grid-template-columns: 176px minmax(0, 1fr); gap: var(--s-5); padding: var(--s-5) var(--s-6); }
  .fb-dg__img { width: 176px; height: 176px; border-radius: var(--r-md); object-fit: cover; background: var(--zone); }
  .fb-dg__kv { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-3) var(--s-5); align-content: center; font-size: var(--fs-sm); }
  .fb-dg__kv dt { color: var(--ink-3); white-space: nowrap; }
  .fb-dg__kv dd { margin: 0; min-width: 0; font-weight: 600; }
  .fb-dg__rows { grid-column: 1 / -1; display: grid; border-top: 1px solid var(--line); }
  .fb-dg__ln { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 48px; font-size: var(--fs-sm); }
  .fb-dg__ln + .fb-dg__ln { border-top: 1px solid var(--line); }
  .fb-dg__it { display: flex; align-items: center; gap: var(--s-3); min-width: 0; font-size: var(--fs-md); font-weight: 600; }
  .fb-dg__it img { width: 36px; height: 36px; border-radius: var(--r-sm); object-fit: cover; flex: none; }
  .fb-dg__it small { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-3); }
  .fb-dg__ln--sum { font-size: var(--fs-md); font-weight: 600; }
  .fb-dg__ln--sum .price { font-size: var(--fs-xl); }
  .fb-dg__foot { display: flex; justify-content: flex-end; padding: var(--s-3) var(--s-6); border-top: 1px solid var(--line); }
  @media (max-width: 560px) { .fb-dg-mask { padding: var(--s-3); } .fb-dg__body { grid-template-columns: minmax(0, 1fr); } .fb-dg__img { width: 100%; height: 160px; } .fb-dg__head, .fb-dg__body, .fb-dg__foot { padding-left: var(--s-4); padding-right: var(--s-4); } }

  /* 弹出气泡卡片：点芯片在它左侧弹出，上下位置夹在卡片内，箭头指向芯片 */
  .fb-pp-box { position: relative; min-height: 196px; }
  .fb-pp-box .row__lead { width: 40px; height: 40px; border-radius: var(--r-sm); }
  .fb-pp-chip { display: inline-flex; align-items: center; gap: var(--s-1); height: 32px; padding: 0 var(--s-2) 0 var(--s-3); border-radius: var(--r-full); background: var(--zone); color: var(--ink-2); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; transition: background var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out); }
  .fb-pp-chip[data-tone="success"] { background: var(--success-tint); color: var(--success); }
  .fb-pp-chip[data-tone="warning"] { background: var(--warning-tint); color: var(--warning); }
  .fb-pp-chip[data-tone="danger"] { background: var(--danger-tint); color: color-mix(in srgb, var(--danger) 80%, black); }
  .fb-pp-chip .chev::after { border-color: currentColor; }
  @media (hover: hover) { .fb-pp-chip:hover { box-shadow: inset 0 0 0 1px currentColor; } }
  .fb-pp-chip[aria-expanded="true"] { box-shadow: inset 0 0 0 1.5px currentColor; }
  .fb-pp, .fb-hc { position: absolute; z-index: 6; display: grid; gap: var(--s-2); width: 268px; padding: var(--s-4); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-3); animation: lz-toast var(--dur-quick) var(--ease-out) both; }
  .fb-pp::after, .fb-hc::after { content: ""; position: absolute; top: var(--ay, 24px); width: 12px; height: 12px; background: var(--surface); border: solid var(--line); }
  .fb-pp::after { right: -7px; border-width: 1px 1px 0 0; transform: rotate(45deg); }
  .fb-hc::after { transform: rotate(45deg); }
  .fb-pp__t { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .fb-pp__p { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.55; }
  .fb-pp__f { display: flex; justify-content: flex-end; gap: var(--s-2); margin-top: var(--s-1); }

  /* 可关闭标签组 */
  .fb-ct { gap: var(--s-5); }
  .fb-ct-group { display: grid; gap: var(--s-3); }
  .fb-ct-sep { height: 1px; background: var(--line); }
  .fb-ct-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 32px; }
  .fb-ct-lab { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); }
  .fb-ct-ttl { display: inline-flex; align-items: center; gap: var(--s-2); }
  .fb-ct-n { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .fb-ct-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); min-height: 32px; }
  .fb-ct-row[data-fit] { flex-wrap: nowrap; overflow: hidden; }
  .fb-ct__chip { flex: none; display: inline-flex; align-items: center; gap: var(--s-1); height: 32px; padding: 0 var(--s-1) 0 var(--s-3); border-radius: var(--r-full); background: var(--zone); font-size: var(--fs-sm); color: var(--ink-3); transition: opacity var(--dur-quick) var(--ease-out), transform var(--dur-quick) var(--ease-out); }
  .fb-ct__chip b { font-weight: 600; color: var(--ink); }
  .fb-ct__chip[data-tone="action"] { background: var(--action-soft); color: var(--action-press); }
  .fb-ct__chip[data-tone="success"] { background: var(--success-tint); color: var(--success); }
  .fb-ct__chip[data-tone="warning"] { background: var(--warning-tint); color: var(--warning); }
  .fb-ct__chip[data-tone] b { color: inherit; }
  .fb-ct__chip[data-fixed] { padding-right: var(--s-3); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--ink-2); }
  .fb-ct__chip[data-fixed] small { font-size: var(--fs-sm); color: var(--ink-3); }
  .fb-ct__chip[data-leave] { opacity: 0; transform: scale(.88); }
  .fb-ct__x { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; transition: background var(--dur-quick) var(--ease-out); }
  .fb-ct__x img { width: 12px; height: 12px; }
  @media (hover: hover) { .fb-ct__x:hover { background: color-mix(in srgb, var(--ink) 12%, transparent); } }
  .fb-ct__more { flex: none; display: inline-flex; align-items: center; height: 32px; padding: 0 var(--s-3); border-radius: var(--r-full); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  @media (hover: hover) { .fb-ct__more:hover { background: var(--zone); } }
  .fb-ct-none { font-size: var(--fs-sm); color: var(--ink-3); }

  /* 通知提醒卡：右上角堆叠，不抢焦点 */
  .fb-nt-stack { display: grid; gap: var(--s-3); align-content: start; min-height: 244px; }
  .fb-nt-stack[data-empty] { align-content: center; }
  .fb-nt { position: relative; display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; column-gap: var(--s-3); padding: var(--s-4); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-2); animation: lz-toast var(--dur-base) var(--ease-out) both; }
  .fb-nt::before { content: ""; position: absolute; left: 0; top: var(--s-4); bottom: var(--s-4); width: 3px; border-radius: 0 3px 3px 0; background: var(--c, var(--action)); }
  .fb-nt[data-tone="warning"] { --c: var(--warning); }
  .fb-nt[data-tone="danger"] { --c: var(--danger); }
  .fb-nt__ic { width: 36px; height: 36px; object-fit: contain; }
  .fb-nt__t { min-height: 36px; display: flex; align-items: center; font-size: var(--fs-md); font-weight: 600; line-height: var(--lh-tight); }
  .fb-nt__p { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.55; }
  .fb-nt__f { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-3); }
  .fb-nt .ibtn { width: 36px; height: 36px; margin: 0 calc(var(--s-2) * -1) 0 0; }
  .fb-nt .ibtn img { width: 14px; height: 14px; }
  .fb-nt-stack .fb-empty { align-self: center; }

  /* 数量计数徽标：跟在导航文字后面，零值默认隐藏，超过九十九显示 99+ */
  .fb-cn-menu { display: grid; gap: var(--s-1); }
  .fb-cn-item { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 44px; padding: 0 var(--s-3); border-radius: var(--r-md); font-size: var(--fs-md); color: var(--ink-2); text-align: left; transition: background var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out); }
  .fb-cn-item img { width: 20px; height: 20px; flex: none; }
  .fb-cn-item > span:first-of-type { flex: 1; min-width: 0; }
  @media (hover: hover) { .fb-cn-item:hover { background: var(--zone); } }
  .fb-cn-item[aria-current="true"] { background: var(--action-tint); color: var(--action-press); font-weight: 600; box-shadow: inset 0 0 0 1px var(--action-edge); }
  .fb-cn { display: inline-grid; place-items: center; min-width: 28px; height: 24px; padding: 0 var(--s-2); border-radius: var(--r-full); background: color-mix(in srgb, var(--ink) 8%, var(--surface)); color: var(--ink-2); font-size: var(--fs-sm); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .fb-cn[data-tone="action"] { background: var(--action); color: var(--surface); }
  .fb-cn[data-tone="danger"] { background: var(--danger); color: var(--surface); }
  .fb-cn[data-tone="warning"] { background: var(--warning); color: var(--surface); }
  .fb-cn.is-pop { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .fb-cn-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }
  .fb-cn-zero { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }

  /* 状态徽章标签：浅色与实色两种，状态按流转规则才可改 */
  .fb-ls { display: inline-flex; align-items: center; gap: var(--s-1); height: 28px; padding: 0 var(--s-3); border-radius: var(--r-sm); background: var(--ls-t); color: var(--ls-c); font-size: var(--fs-sm); font-weight: 600; line-height: 1; white-space: nowrap; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  button.fb-ls { padding-right: var(--s-2); cursor: pointer; }
  .fb-ls .chev::after { border-color: currentColor; }
  .fb-ls[data-s="wait"], .fb-ls[data-to="wait"] { --ls-c: var(--ink-2); --ls-t: color-mix(in srgb, var(--ink) 8%, var(--surface)); --ls-b: var(--ink-2); }
  .fb-ls[data-s="run"], .fb-ls[data-to="run"] { --ls-c: var(--info); --ls-t: var(--info-tint); --ls-b: var(--info); }
  .fb-ls[data-s="appr"], .fb-ls[data-to="appr"] { --ls-c: var(--warning); --ls-t: var(--warning-tint); --ls-b: var(--warning); }
  .fb-ls[data-s="ok"], .fb-ls[data-to="ok"] { --ls-c: var(--success); --ls-t: var(--success-tint); --ls-b: var(--success); }
  .fb-ls[data-s="no"], .fb-ls[data-to="no"] { --ls-c: color-mix(in srgb, var(--danger) 80%, black); --ls-t: var(--danger-tint); --ls-b: var(--danger); }
  [data-solid="true"] .fb-ls { background: var(--ls-b); color: var(--surface); }
  @media (hover: hover) { button.fb-ls:hover { box-shadow: inset 0 0 0 1px currentColor; } }
  .fb-ls-list { display: grid; }
  .fb-ls-item + .fb-ls-item { border-top: 1px solid var(--line); }
  .fb-ls-item .row { min-height: 56px; padding: var(--s-2) 0; }
  .fb-ls-item .row__title, .fb-ls-item .row__meta { display: block; }
  .fb-ls-item .row__trail { flex-direction: row; align-items: center; }
  .fb-ls-opts { display: flex; align-items: center; gap: var(--s-2); margin: 0 calc(var(--s-5) * -1); padding-left: var(--s-5); padding-right: var(--s-5); }
  .fb-ls-to { font-size: var(--fs-sm); color: var(--ink-3); }
  .fb-ls-opts .btn { margin-left: auto; }

  /* 页顶公告横幅：占满页面顶部，实色标签加正文，详情就近展开 */
  .fb-bn { display: flex; align-items: center; gap: var(--s-3); min-height: 56px; padding: var(--s-2) var(--s-2) var(--s-2) var(--s-5); background: var(--bg-t); border-bottom: 1px solid color-mix(in srgb, var(--c) 26%, transparent); font-size: var(--fs-sm); }
  .fb-bn b { display: inline-flex; align-items: center; flex: none; height: 24px; padding: 0 var(--s-2); border-radius: var(--r-sm); background: var(--c); color: var(--surface); font-weight: 600; line-height: 1; }
  .fb-bn span { flex: 1; min-width: 0; color: var(--ink); }
  .fb-bn .ibtn { width: 36px; height: 36px; flex: none; }
  .fb-bn .ibtn img { width: 16px; height: 16px; }
  .fb-bn[data-tone="warning"] { --c: var(--warning); --bg-t: var(--warning-tint); }
  .fb-bn[data-tone="danger"] { --c: var(--danger); --bg-t: var(--danger-tint); }
  .fb-bn[data-tone="info"] { --c: var(--info); --bg-t: var(--info-tint); }
  .fb-bn-kv { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-2) var(--s-5); font-size: var(--fs-sm); }
  .fb-bn-kv dt { color: var(--ink-3); white-space: nowrap; }
  .fb-bn-kv dd { margin: 0; font-weight: 600; }
  .fb-bn-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-4) var(--s-5); }
  .fb-bn-foot .seg { padding: 0; }

  /* 悬停预览卡 */
  .fb-hc-box { position: relative; min-height: 196px; }
  .fb-hc-box .table td { height: 56px; padding-left: var(--s-2); padding-right: var(--s-2); }
  .fb-hc-box .table th { padding-left: var(--s-2); padding-right: var(--s-2); }
  .fb-hc-t { font-weight: 600; text-decoration: underline dotted var(--ink-3); text-decoration-thickness: 1.5px; text-underline-offset: 5px; cursor: pointer; }
  .fb-hc-t[aria-expanded="true"] { color: var(--action-press); }
  .fb-hc { width: 272px; gap: var(--s-3); }
  .fb-hc[data-side="right"]::after { left: -7px; border-width: 0 0 1px 1px; }
  .fb-hc[data-side="left"]::after { right: -7px; border-width: 1px 1px 0 0; }
  .fb-hc__head { display: flex; align-items: center; gap: var(--s-3); }
  .fb-hc__head img { width: 44px; height: 44px; border-radius: var(--r-sm); object-fit: cover; flex: none; background: var(--zone); }
  .fb-hc__head img.is-round { border-radius: 50%; object-fit: contain; padding: 4px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .fb-hc__nm { flex: 1; min-width: 0; display: grid; }
  .fb-hc__nm b { font-size: var(--fs-md); line-height: var(--lh-tight); }
  .fb-hc__nm span { font-size: var(--fs-sm); color: var(--ink-3); }
  .fb-hc__st { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .fb-hc__st > div { display: grid; gap: 2px; justify-items: center; text-align: center; }
  .fb-hc__st > div + div { border-left: 1px solid var(--line); }
  .fb-hc__st span { font-size: var(--fs-sm); color: var(--ink-3); }
  .fb-hc__st b { font-size: var(--fs-md); font-variant-numeric: tabular-nums; }
</style>

