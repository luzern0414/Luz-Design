<!-- cat: FEED | 反馈与状态 -->
<style>
  /* 反馈与状态：类名前缀 fb-。通知用轻提示，警告确认用居中框，结果紧邻被操作的对象 */
  .fb-card { display: grid; gap: var(--s-4); padding: var(--s-5); align-content: start; min-width: 0; }
  .fb-card--flush { padding: 0; gap: 0; overflow: hidden; }
  .fb-bar { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
  .fb-bar--end { justify-content: flex-end; }
  .fb-bar--between { justify-content: space-between; }
  .fb-bar--center { justify-content: center; }
  /* 示例卡片是舞台上唯一的一层白卡：卡里的列表、进度行不再自带边框与圆角，行首与卡的内容边对齐 */
  .fb-card .card.list { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .fb-card .card.list .row, .fb-card .card.list .fb-ord, .fb-card .card.list .fb-kv { padding-left: 0; padding-right: 0; }
  .fb-card .card.list .row + .row::before { left: 0; }
  .fb-card--bare { padding: 0; gap: var(--s-3); background: none; border: 0; box-shadow: none; }
  .fb-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 36px; }
  .fb-spin { display: inline-block; flex: none; width: 24px; height: 24px; border: 3px solid var(--action-edge); border-top-color: var(--action); border-radius: 50%; animation: lz-spin .8s linear infinite; }
  .fb-spin--sm { width: 16px; height: 16px; border-width: 2px; }
  .fb-dots { display: inline-flex; gap: 3px; }

  /* 轻提示样张 */
  .fb-sample { display: flex; align-items: center; justify-content: center; min-height: 64px; border-radius: var(--r-md); background: var(--zone); }
  .fb-sample .toast { animation: none; }

  /* 列表行与确认 */
  .fb-rows { overflow: hidden; }
  .fb-rows .row__lead { width: 48px; height: 48px; }
  .fb-rows .row__title, .fb-rows .row__meta { display: block; }
  .fb-rows .row__trail { flex-direction: row; align-items: center; gap: var(--s-2); }
  .fb-gone { display: none; align-items: center; gap: var(--s-2); }
  .fb-rows [data-gone="true"] .fb-gone { display: inline-flex; }
  .fb-rows [data-gone="true"] [data-del], .fb-rows [data-gone="true"] .row__lead, .fb-rows [data-gone="true"] .row__main { opacity: .42; }
  .fb-rows [data-gone="true"] [data-del] { display: none; }

  /* 结果页 */
  .fb-res { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-2) var(--s-4); text-align: center; }
  #fb-res-card .seg { justify-content: center; }
  .fb-res__ic { display: grid; place-items: center; width: 80px; height: 80px; border-radius: 50%; background: var(--success); }
  .fb-res__ic img { width: 40px; height: 40px; filter: invert(1); }
  .fb-res[data-state="fail"] .fb-res__ic { background: var(--danger); }
  .fb-res[data-state="wait"] .fb-res__ic { background: var(--action-tint); box-shadow: inset 0 0 0 1px var(--action-edge); }
  .fb-res[data-state="wait"] .fb-res__ic img { display: none; }
  .fb-res[data-state="wait"] .fb-spin { width: 36px; height: 36px; border-width: 4px; }
  .fb-res:not([data-state="wait"]) .fb-spin { display: none; }
  .fb-res.is-in .fb-res__ic { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .fb-res h3 { font-size: var(--fs-xl); font-weight: 700; line-height: var(--lh-tight); }
  .fb-res__kv { display: grid; grid-template-columns: auto auto; gap: var(--s-2) var(--s-6); padding: var(--s-3) var(--s-5); border-radius: var(--r-md); background: var(--zone); font-size: var(--fs-sm); text-align: left; }
  .fb-res__kv dt { color: var(--ink-3); }
  .fb-res__kv dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* 空态 */
  .fb-empty { display: grid; justify-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-4); text-align: center; }
  .fb-card > .fb-empty { padding: var(--s-1) var(--s-4); }
  .fb-empty img { width: 112px; height: 112px; object-fit: contain; filter: drop-shadow(0 10px 14px color-mix(in srgb, var(--action) 18%, transparent)); }
  .fb-empty--sm img { width: 80px; height: 80px; }
  .fb-empty p { font-size: var(--fs-md); font-weight: 600; color: var(--ink-2); }
  .fb-empty .tag { margin-top: calc(var(--s-1) * -1); }
  .fb-tabs { padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
  .fb-tbl .table { table-layout: fixed; }
  .fb-tbl .table .who { display: flex; }
  .fb-tbl .table tbody tr { cursor: default; }
  .fb-tbl .table td.fb-none { padding: 0; white-space: normal; }
  .fb-srch { display: grid; gap: var(--s-3); }
  .fb-srch .search { width: 100%; }
  .fb-srch input[type="search"]::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
  .fb-srch .search .ibtn { width: 28px; height: 28px; }
  .fb-srch .search .ibtn img { width: 14px; height: 14px; }
  .fb-plist { overflow: hidden; }
  .fb-plist .row { min-height: 52px; padding-top: var(--s-2); padding-bottom: var(--s-2); }
  .fb-plist .row__lead { width: 36px; height: 36px; border-radius: var(--r-sm); }
  .fb-plist mark { background: var(--action-tint); color: var(--action-press); font-weight: 600; }

  /* 骨架与加载 */
  .fb-grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .fb-pc { display: grid; gap: var(--s-2); padding: var(--s-2) var(--s-2) var(--s-3); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); animation: lz-rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * var(--stagger)); }
  .fb-pc img, .fb-pc .skel { width: 100%; aspect-ratio: 1 / 1; border-radius: var(--r-sm); object-fit: cover; }
  .fb-pc__n { font-size: var(--fs-sm); font-weight: 600; padding: 0 var(--s-1); }
  .fb-pc__f { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--s-1); }
  .fb-tbl .skel { height: 16px; display: block; margin: 0 auto; }
  .fb-busy { position: relative; }
  .fb-busy__body { display: grid; }
  .fb-busy__veil { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; gap: var(--s-2); border-radius: inherit; background: color-mix(in srgb, var(--surface) 80%, transparent); font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out); }
  .fb-busy[data-busy="true"] .fb-busy__veil { opacity: 1; pointer-events: auto; }
  .fb-busy .fb-spin { width: 32px; height: 32px; }
  .fb-kv { display: flex; align-items: center; justify-content: space-between; min-height: 52px; padding: 0 var(--s-4); }
  .fb-kv + .fb-kv { border-top: 1px solid var(--line); }
  .fb-kv b { font-size: var(--fs-lg); font-variant-numeric: tabular-nums; }

  /* 进度 */
  .fb-ups { display: grid; }
  .fb-ups .fb-up + .fb-up { position: relative; margin-top: var(--s-4); padding-top: var(--s-4); }
  .fb-ups .fb-up + .fb-up::before { content: ""; position: absolute; left: 0; right: 0; top: 0; border-top: 1px solid var(--line); }
  .fb-up { display: grid; gap: var(--s-2); }
  .fb-up__top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .fb-up__name { display: flex; align-items: center; gap: var(--s-3); min-width: 0; }
  .fb-up__name img { width: 32px; height: 32px; object-fit: contain; flex: none; }
  .fb-up__bot { display: flex; justify-content: space-between; font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .fb-up[data-state="done"] .progress > i { background: var(--success); }
  .fb-up[data-state="stop"] .progress > i { background: var(--ink-3); }

  /* 行内保存 */
  .fb-saving { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-3); }
  .fb-sv-err { font-size: var(--fs-sm); color: var(--danger); }
  .fb-save .switch[aria-disabled="true"] { opacity: .5; pointer-events: none; }
  .fb-save .row__meta[data-tone="danger"] { color: var(--danger); }

  /* 订单状态 */
  .fb-legend { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .fb-ord { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto auto; align-items: center; gap: var(--s-3); min-height: 60px; padding: var(--s-2) var(--s-4); }
  .fb-ord + .fb-ord { border-top: 1px solid var(--line); }
  .fb-ord img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .fb-ord__m { min-width: 0; }
  .fb-ord .tag { min-width: 56px; justify-content: center; }
  #fb-pub .row__trail .tag { min-width: 56px; justify-content: center; }
  .fb-ord .btn { min-width: 76px; }
  .fb-ord .tag { transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }

  /* 红点角标 */
  .fb-ibs { display: flex; align-items: center; justify-content: center; gap: var(--s-5); flex-wrap: wrap; }
  .fb-ib { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); transition: transform var(--dur-instant) var(--ease-out), background var(--dur-quick) var(--ease-out); }
  .fb-ib img { width: 24px; height: 24px; }
  .fb-ib:active { transform: scale(.94); }
  @media (hover: hover) { .fb-ib:hover { background: var(--zone); } }
  .fb-bdg { position: absolute; top: -6px; right: -6px; display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: var(--r-full); background: var(--danger); color: var(--surface); font-size: var(--fs-xs); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; box-shadow: 0 0 0 2px var(--surface); }
  .fb-bdg[data-dot] { top: -3px; right: -3px; min-width: 12px; width: 12px; height: 12px; padding: 0; font-size: 0; }
  .fb-bdg[data-tone="accent"] { background: var(--accent); }
  .fb-bdg.is-pop { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .fb-bdg[hidden] { display: none; }

  /* 通知中心 */
  .fb-nc { position: relative; width: 100%; max-width: 480px; margin: 0 auto; min-height: 48px; transition: min-height var(--dur-base) var(--ease-out); }
  .fb-nc[data-open="true"] { min-height: 404px; }
  .fb-nc__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .fb-nc__t { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-tight); }
  .fb-nc__panel { position: absolute; z-index: 5; right: 0; top: 60px; width: 100%; box-shadow: var(--elev-3); overflow: hidden; transform-origin: top right; animation: lz-toast var(--dur-base) var(--ease-out) both; }
  .fb-nc__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--line); }
  .fb-nc__head .seg { padding: 0; margin: 0; }
  .fb-nc__row { align-items: flex-start; }
  .fb-nc__row .row__lead { width: 40px; height: 40px; object-fit: contain; }
  .fb-nc__row .row__title, .fb-nc__row .row__meta { display: block; }
  .fb-nc__row .row__trail { align-self: center; }
  .fb-nc__row .fb-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--action); }
  .fb-nc__row[data-unread="false"] .fb-dot { background: transparent; }
  .fb-nc__row[data-unread="false"] .row__title { font-weight: 400; color: var(--ink-2); }
  .fb-nc__list { max-height: 292px; overflow-y: auto; }
  .fb-nc__none { padding: var(--s-6); text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }

  /* 悬浮说明 */
  .fb-tips { display: grid; grid-template-columns: repeat(6, auto); justify-content: center; gap: var(--s-3); }
  .fb-tips .ibtn { width: 48px; height: 48px; border-radius: var(--r-md); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .fb-tips .ibtn img { width: 24px; height: 24px; }
  .fb-def { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-md); font-weight: 600; text-decoration: underline dotted var(--ink-3); text-underline-offset: 5px; cursor: help; }
  .fb-defrow { display: flex; align-items: center; justify-content: center; gap: var(--s-8); flex-wrap: wrap; }
  .fb-defrow b { font-size: var(--fs-xl); font-variant-numeric: tabular-nums; margin-left: var(--s-2); }

  /* 页内提示条 */
  .fb-bans { display: grid; }
  .fb-bw { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .fb-bw > div { overflow: hidden; min-height: 0; }
  .fb-bw[data-gone] { grid-template-rows: 0fr; opacity: 0; }
  .fb-ban { margin-bottom: var(--s-2); display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4); border-radius: var(--r-md); border-left: 4px solid var(--c); background: var(--bg-t); font-size: var(--fs-sm); }
  .fb-ban b { flex: none; color: var(--c); font-weight: 700; }
  .fb-ban span { flex: 1; min-width: 0; color: var(--ink); }
  .fb-bw:last-child .fb-ban { margin-bottom: 0; }
  .fb-ban .ibtn { width: 36px; height: 36px; flex: none; }
  .fb-ban .ibtn img { width: 16px; height: 16px; }
  .fb-ban[data-tone="success"] { --c: var(--success); --bg-t: var(--success-tint); }
  .fb-ban[data-tone="warning"] { --c: var(--warning); --bg-t: var(--warning-tint); }
  .fb-ban[data-tone="danger"] { --c: var(--danger); --bg-t: var(--danger-tint); }
  .fb-ban[data-tone="info"] { --c: var(--info); --bg-t: var(--info-tint); }
  @media (max-width: 560px) { .fb-grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fb-tips { grid-template-columns: repeat(3, auto); } }
</style>

<article class="demo" data-cid="WB-FEED-001" data-name="成功轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">成功轻提示</span></div>
  <p class="demo__note">适合：保存或发货完成后的即时回执</p>
  <div class="demo__stage">
    <div class="card fb-card">
      <div class="fb-sample"><div class="toast" data-tone="success">订单已发货</div></div>
      <div class="fb-bar fb-bar--center"><button type="button" class="btn btn--primary btn--sm" data-fire="订单已发货" data-tone="success">发货</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-002" data-name="失败轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">失败轻提示</span></div>
  <p class="demo__note">适合：操作失败后的简短状态，原因留在字段旁</p>
  <div class="demo__stage">
    <div class="card fb-card">
      <div class="fb-sample"><div class="toast" data-tone="danger">保存失败</div></div>
      <div class="fb-bar fb-bar--center"><button type="button" class="btn btn--outline btn--sm" data-fire="保存失败" data-tone="danger">保存</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-003" data-name="普通轻提示" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">普通轻提示</span></div>
  <p class="demo__note">适合：复制、切换等无结果好坏的中性回执</p>
  <div class="demo__stage">
    <div class="card fb-card">
      <div class="fb-sample"><div class="toast">已复制订单号</div></div>
      <div class="fb-bar fb-bar--center"><button type="button" class="btn btn--secondary btn--sm" data-fire="已复制订单号" data-tone="neutral">复制订单号</button></div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-004" data-name="删除确认框" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">删除确认框</span></div>
  <p class="demo__note">适合：不可逆操作前的居中确认，删除后可撤销</p>
  <div class="demo__stage">
    <div class="card fb-card fb-card--flush">
      <div class="list fb-rows" id="fb-del">
        <div class="row" data-n="红玫瑰花束" data-gone="false"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><span class="row__main"><span class="row__title">红玫瑰花束</span><span class="row__meta">在售 库存 36 件</span></span><span class="row__trail"><button type="button" class="btn btn--danger-soft btn--sm" data-del>删除</button><span class="fb-gone"><span class="tag">已删除</span><button type="button" class="btn btn--secondary btn--sm" data-undo>撤销</button></span></span></div>
        <div class="row" data-n="白郁金香" data-gone="false"><img class="row__lead" src="../../kit/assets/photo/product-tulip-white.webp" alt=""><span class="row__main"><span class="row__title">白郁金香</span><span class="row__meta">在售 库存 52 件</span></span><span class="row__trail"><button type="button" class="btn btn--danger-soft btn--sm" data-del>删除</button><span class="fb-gone"><span class="tag">已删除</span><button type="button" class="btn btn--secondary btn--sm" data-undo>撤销</button></span></span></div>
        <div class="row" data-n="龟背竹盆栽" data-gone="false"><img class="row__lead" src="../../kit/assets/photo/product-monstera.webp" alt=""><span class="row__main"><span class="row__title">龟背竹盆栽</span><span class="row__meta">在售 库存 18 件</span></span><span class="row__trail"><button type="button" class="btn btn--danger-soft btn--sm" data-del>删除</button><span class="fb-gone"><span class="tag">已删除</span><button type="button" class="btn btn--secondary btn--sm" data-undo>撤销</button></span></span></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-005" data-name="发布确认框" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">发布确认框</span></div>
  <p class="demo__note">适合：上架下架等有影响但可恢复的操作</p>
  <div class="demo__stage">
    <div class="card fb-card fb-card--flush">
      <div class="list fb-rows" id="fb-pub">
        <div class="row" data-n="粉芍药花束" data-on="false"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><span class="row__main"><span class="row__title">粉芍药花束</span><span class="row__meta">¥239 库存 24 件</span></span><span class="row__trail"><span class="tag" data-st>草稿</span><button type="button" class="btn btn--primary btn--sm" data-act>上架</button></span></div>
        <div class="row" data-n="向日葵花束" data-on="true"><img class="row__lead" src="../../kit/assets/photo/product-sunflower.webp" alt=""><span class="row__main"><span class="row__title">向日葵花束</span><span class="row__meta">¥159 库存 40 件</span></span><span class="row__trail"><span class="tag" data-tone="success" data-st>已上架</span><button type="button" class="btn btn--ghost btn--sm" data-act>下架</button></span></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-006" data-name="操作结果页" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">操作结果页</span></div>
  <p class="demo__note">适合：提交后的独立结果页，成功失败处理中三态</p>
  <div class="demo__stage">
    <div class="card fb-card" id="fb-res-card">
      <div class="seg" data-seg="fb-res" aria-label="结果状态"><button class="seg__item" data-key="ok" aria-selected="true">成功</button><button class="seg__item" data-key="fail">失败</button><button class="seg__item" data-key="wait">处理中</button></div>
      <div class="fb-res" data-state="ok" role="status" aria-live="polite">
        <span class="fb-res__ic"><img src="../../kit/assets/line/check.webp" alt=""><span class="fb-spin"></span></span>
        <h3></h3>
        <dl class="fb-res__kv"></dl>
        <div class="btn-group"></div>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-007" data-name="卡片空态" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">卡片空态</span></div>
  <p class="demo__note">适合：整块内容暂无数据，只留一个刷新动作</p>
  <div class="demo__stage">
    <div class="card fb-card">
      <div class="fb-empty">
        <img data-ic="cart" src="../../kit/assets/icons/flat/cart.webp" alt="">
        <p>暂无订单</p>
        <button type="button" class="btn btn--secondary btn--sm" id="fb-refresh">刷新</button>
      </div>
    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-008" data-name="表格空态" data-cat="FEED">
