    </div>
  </div>
</article>

<article class="demo" data-cid="WB-FEED-029" data-name="悬停预览卡" data-cat="FEED">
  <div class="demo__head"><span class="demo__name">悬停预览卡</span></div>
  <p class="demo__note">适合：鼠标停在名称上预览关联对象摘要</p>
  <div class="demo__stage">
    <div class="card fb-card fb-card--flush fb-hc-box" id="fb-hc-box">
      <div class="table-wrap"><table class="table table--static">
        <colgroup><col style="width:20%"><col style="width:20%"><col style="width:28%"><col style="width:32%"></colgroup>
        <thead><tr><th>订单</th><th>客户</th><th>商品</th><th>门店</th></tr></thead>
        <tbody>
          <tr><td>10382</td><td><button type="button" class="fb-hc-t" data-k="cus" data-v="林晓" aria-expanded="false">林晓</button></td><td><button type="button" class="fb-hc-t" data-k="sku" data-v="红玫瑰花束" aria-expanded="false">红玫瑰花束</button></td><td><button type="button" class="fb-hc-t" data-k="store" data-v="建国路店" aria-expanded="false">建国路店</button></td></tr>
          <tr><td>10517</td><td><button type="button" class="fb-hc-t" data-k="cus" data-v="陈默" aria-expanded="false">陈默</button></td><td><button type="button" class="fb-hc-t" data-k="sku" data-v="粉芍药花束" aria-expanded="false">粉芍药花束</button></td><td><button type="button" class="fb-hc-t" data-k="store" data-v="徐汇滨江店" aria-expanded="false">徐汇滨江店</button></td></tr>
          <tr><td>10921</td><td><button type="button" class="fb-hc-t" data-k="cus" data-v="周岚" aria-expanded="false">周岚</button></td><td><button type="button" class="fb-hc-t" data-k="sku" data-v="向日葵花束" aria-expanded="false">向日葵花束</button></td><td><button type="button" class="fb-hc-t" data-k="store" data-v="浦东世纪店" aria-expanded="false">浦东世纪店</button></td></tr>
        </tbody>
      </table></div>
      <div class="fb-hc" id="fb-hc" role="group" aria-label="对象摘要" hidden></div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const A = '../../kit/assets';
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const money = n => n.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const price = n => `<span class="price"><small>¥</small>${money(n)}</span>`;
  const mk = html => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };

  /* 022 居中详情：遮罩加居中浮层，打开时挪到页面最外层并让页面其余部分不可操作；Tab 在层内循环，Esc、遮罩、关闭按钮都能关，焦点回到被点的行 */
  (() => {
    const mask = $('#fb-dg-mask'), dlg = $('#fb-dg'), list = $('#fb-dg-list'), home = mask.parentElement;
    const O = [
      { id: '10382', who: '林晓', store: '建国路店', st: ['待发货', 'action'], way: '同城配送', pay: '微信支付', addr: '建国路 88 号 3 栋 502', items: [['红玫瑰花束', 'product-rose-red', 1, 199]], fee: 0 },
      { id: '10517', who: '陈默', store: '徐汇滨江店', st: ['待收货', 'info'], way: '门店自提', pay: '微信支付', addr: '徐汇滨江店前台', items: [['粉芍药花束', 'product-peony-pink', 1, 239]], fee: 0 },
      { id: '10921', who: '周岚', store: '浦东世纪店', st: ['待付款', 'warning'], way: '同城配送', pay: '待支付', addr: '世纪大道 1200 号 1 单元 1801', items: [['向日葵花束', 'product-sunflower', 1, 159]], fee: 0 },
    ];
    let cur = 0, opener = null, locked = [], htmlOv = '';
    const paint = () => {
      const o = O[cur], sum = o.items.reduce((s, it) => s + it[2] * it[3], 0) + o.fee;
      $('#fb-dg-t').textContent = '订单 ' + o.id;
      const st = $('[data-st]', dlg); st.textContent = o.st[0]; st.dataset.tone = o.st[1];
      $('[data-pos]', dlg).textContent = `第 ${cur + 1} 单 共 ${O.length} 单`;
      $('[data-img]', dlg).src = `${A}/photo/${o.items[0][1]}.webp`;
      $('.fb-dg__kv', dlg).innerHTML = [['客户', o.who], ['门店', o.store], ['配送', o.way], ['地址', o.addr], ['支付', o.pay]].map(([a, b]) => `<dt>${a}</dt><dd>${esc(b)}</dd>`).join('');
      $('.fb-dg__rows', dlg).innerHTML = o.items.map(it => `<div class="fb-dg__ln"><span class="fb-dg__it"><img src="${A}/photo/${it[1]}.webp" alt=""><span>${it[0]} <small>${it[2]} 件</small></span></span>${price(it[2] * it[3])}</div>`).join('')
        + `<div class="fb-dg__ln"><span>配送费</span>${price(o.fee)}</div><div class="fb-dg__ln fb-dg__ln--sum"><span>实付</span>${price(sum)}</div>`;
      $('[data-prev]', dlg).disabled = cur === 0; $('[data-next]', dlg).disabled = cur === O.length - 1;
    };
    const open = row => {
      opener = row; cur = +row.dataset.i; paint();
      document.body.appendChild(mask); mask.hidden = false;
      locked = [...document.body.children].filter(e => e !== mask && !e.inert && !e.matches('script, style, .toast-host, .tip')); locked.forEach(e => { e.inert = true; });
      htmlOv = document.documentElement.style.overflow; document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', keys, true);
      $('[data-close]', dlg).focus();
    };
    const close = () => {
      if (mask.hidden) return;
      document.removeEventListener('keydown', keys, true);
      mask.hidden = true; home.appendChild(mask);
      locked.forEach(e => { e.inert = false; }); locked = []; document.documentElement.style.overflow = htmlOv;
      if (opener) opener.focus({ preventScroll: true });
    };
    const keys = e => {
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); return; }
      if (e.key !== 'Tab') return;
      const f = $$('button:not(:disabled), [href], [tabindex]:not([tabindex="-1"])', dlg).filter(x => x.getClientRects().length);
      if (!f.length) { e.preventDefault(); dlg.focus(); return; }
      const first = f[0], last = f[f.length - 1], at = document.activeElement;
      if (!dlg.contains(at)) { e.preventDefault(); (e.shiftKey ? last : first).focus(); }
      else if (e.shiftKey && (at === first || at === dlg)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && at === last) { e.preventDefault(); first.focus(); }
    };
    list.addEventListener('click', e => { const r = e.target.closest('[data-i]'); if (r) open(r); });
    const go = d => { cur += d; paint(); const b = $(d > 0 ? '[data-next]' : '[data-prev]', dlg); if (b.disabled) $('[data-close]', dlg).focus(); };
    $('[data-prev]', dlg).addEventListener('click', () => go(-1)); $('[data-next]', dlg).addEventListener('click', () => go(1));
    $('[data-close]', dlg).addEventListener('click', close);
    mask.addEventListener('click', e => { if (e.target === mask) close(); });
    paint();
  })();

  /* 023 气泡卡片：点芯片在其左侧弹出，位置夹在卡片内；Esc、点外面、焦点离开都关闭 */
  (() => {
    const box = $('#fb-pp-box'), pop = $('#fb-pp'); let cur = null; const made = {};
    const D = [
      { n: '蓝绣球盆栽', t: '库存偏低', tone: 'warning', p: '低于预警线 10 件，建国路店 5 件，徐汇滨江店 3 件', a: ['去补货', '稍后'] },
      { n: '白郁金香', t: '库存充足', tone: 'success', p: '高于预警线 10 件，近 7 日日均售出 6 件', a: ['查看流水'] },
      { n: '花礼盒', t: '已售罄', tone: 'danger', p: '库存 0 件，前台已自动下架', a: ['去补货', '稍后'] },
    ];
    const fill = k => {
      const d = D[k], ok = made[k];
      pop.innerHTML = `<div class="fb-pp__t"><span>${d.n}</span><span class="tag" data-tone="${ok ? 'action' : d.tone}">${ok ? '补货中' : d.t}</span></div><p class="fb-pp__p">${ok ? '补货单已创建，到货后库存自动更新' : d.p}</p><div class="fb-pp__f">${d.a.map((a, i) => `<button type="button" class="btn btn--sm ${i ? 'btn--ghost' : (a === '去补货' ? 'btn--primary' : 'btn--secondary')}" data-a="${a}"${ok && a === '去补货' ? ' disabled' : ''}>${ok && a === '去补货' ? '已创建补货单' : a}</button>`).join('')}</div>`;
    };
    const place = chip => {
      const b = box.getBoundingClientRect(), c = chip.getBoundingClientRect(), h = pop.offsetHeight, cy = c.top + c.height / 2 - b.top;
      const top = Math.min(Math.max(cy - 34, 8), Math.max(8, b.height - h - 8));
      pop.style.top = top + 'px'; pop.style.right = (b.right - c.left + 10) + 'px'; pop.style.setProperty('--ay', Math.min(Math.max(cy - top - 5, 14), Math.max(14, h - 26)) + 'px');
    };
    const close = back => { if (!cur) return; const c = cur; cur = null; pop.hidden = true; c.setAttribute('aria-expanded', 'false'); if (back) c.focus({ preventScroll: true }); };
    const open = chip => { if (cur) close(); cur = chip; chip.setAttribute('aria-expanded', 'true'); fill(+chip.closest('[data-k]').dataset.k); pop.hidden = false; place(chip); const f = $('button', pop); if (f) f.focus({ preventScroll: true }); };
    box.addEventListener('click', e => { const c = e.target.closest('.fb-pp-chip'); if (c) { e.stopPropagation(); c === cur ? close(true) : open(c); return; }
      const a = e.target.closest('[data-a]'); if (!a) return; const k = +cur.closest('[data-k]').dataset.k;
      if (a.dataset.a === '去补货') { made[k] = true; Lz.toast('已创建补货单', 'success'); close(true); } else close(true); });
    document.addEventListener('click', e => { if (cur && !pop.contains(e.target)) close(false); });
    box.addEventListener('keydown', e => { if (e.key === 'Escape' && cur) { e.stopPropagation(); close(true); } });
    box.addEventListener('focusout', e => { if (cur && !box.contains(e.relatedTarget)) close(false); });
    addEventListener('resize', () => close(false));
  })();

  /* 024 可关闭标签：移除带离场动效，清空后给恢复入口；一行放不下的折成「更多」，点开才换行显示全部 */
  (() => {
    const root = $('#fb-ct'), live = $('[data-live]', root);
    const G = {
      cond: { all: [['门店', '建国路店'], ['品类', '花束'], ['状态', '在售'], ['库存', '低于 10 件'], ['价格', '100 至 300 元']], init: null, open: false, folded: false, none: '未设置筛选条件', reset: ['清除全部', '恢复条件'] },
      cat: { all: [['花束', 'action'], ['盆栽', 'success'], ['礼盒', 'warning']], init: null, open: false, folded: false, fixed: '在售商品' },
    };
    Object.values(G).forEach(g => { g.init = g.all.slice(); });
    const chip = (k, c, i) => k === 'cond'
      ? `<span class="fb-ct__chip" data-i="${i}">${c[0]} <b>${c[1]}</b><button type="button" class="fb-ct__x" data-rm aria-label="移除 ${c[0]} ${c[1]}" data-tip="移除"><img src="${A}/line/close.webp" alt=""></button></span>`
      : `<span class="fb-ct__chip" data-tone="${c[1]}" data-i="${i}"><b>${c[0]}</b><button type="button" class="fb-ct__x" data-rm aria-label="移除 ${c[0]}" data-tip="移除"><img src="${A}/line/close.webp" alt=""></button></span>`;
    const draw = (k, row, count) => {
      const g = G[k], hide = g.all.length - count;
      row.innerHTML = (k === 'cat' ? `<span class="fb-ct__chip" data-fixed>${g.fixed}<small>固定</small></span>` : '')
        + g.all.slice(0, count).map((c, i) => chip(k, c, i)).join('')
        + (hide > 0 ? `<button type="button" class="fb-ct__more" data-more aria-expanded="false">更多 ${hide}</button>` : (g.open && g.folded ? '<button type="button" class="fb-ct__more" data-more aria-expanded="true">收起</button>' : ''))
        + (k === 'cond' && !g.all.length ? `<span class="fb-ct-none">${g.none}</span>` : '');
    };
    const paint = (k, focusIdx) => {
      const g = G[k], box = $(`[data-g="${k}"]`, root), row = $('[data-row]', box), rs = $('[data-reset]', box);
      let count = g.all.length;
      if (g.open) { row.removeAttribute('data-fit'); draw(k, row, count); }
      else { row.dataset.fit = ''; for (;;) { draw(k, row, count); if (count <= 1 || row.scrollWidth <= row.clientWidth + 1) break; count--; } g.folded = count < g.all.length; }
      $('[data-n]', box).textContent = g.all.length ? g.all.length + ' 项' : '';
      if (k === 'cond') { rs.textContent = g.all.length ? g.reset[0] : g.reset[1]; } else { rs.hidden = g.all.length === g.init.length; }
      if (focusIdx != null) { const t = $$('[data-rm]', row)[focusIdx] || $$('[data-rm]', row).pop() || rs; if (t && !t.hidden) t.focus(); }
    };
    root.addEventListener('click', async e => {
      const box = e.target.closest('[data-g]'); if (!box) return; const k = box.dataset.g, g = G[k];
      const rm = e.target.closest('[data-rm]');
      if (rm) { const c = rm.closest('.fb-ct__chip'), i = +c.dataset.i, name = g.all[i][0]; c.dataset.leave = ''; rm.disabled = true; await sleep(160); g.all.splice(i, 1); live.textContent = '已移除 ' + name; paint(k, i); return; }
      if (e.target.closest('[data-more]')) { g.open = !g.open; paint(k); const m = $('[data-more]', box); if (m) m.focus(); return; }
      if (e.target.closest('[data-reset]')) {
        if (k === 'cond' && g.all.length) { g.all = []; live.textContent = '已清除全部筛选条件'; paint(k); $('[data-reset]', box).focus(); }
        else { g.all = g.init.slice(); live.textContent = '已恢复'; paint(k, 0); }
      }
    });
    paint('cond'); paint('cat');
    let w0 = root.clientWidth; new ResizeObserver(() => { if (root.clientWidth !== w0) { w0 = root.clientWidth; paint('cond'); paint('cat'); } }).observe(root);
  })();

  /* 025 通知卡：新通知排在最上，最多三条，不抢焦点；动作与关闭都就地处理 */
  (() => {
    const root = $('#fb-nt'), stack = $('.fb-nt-stack', root), clear = $('[data-clear]', root);
    const K = {
      order: { tone: 'action', ic: 'biz-store', t: '新订单 10382', p: '林晓下单红玫瑰花束 ¥199.00 待发货', a: ['查看订单', '稍后'] },
      stock: { tone: 'warning', ic: 'solid-tasks', t: '蓝绣球盆栽库存偏低', p: '全店仅剩 8 件，低于预警线 10 件', a: ['去补货', '忽略'] },
      pay: { tone: 'danger', ic: 'biz-system', t: '支付渠道连接失败', p: '微信支付连续 3 次超时，线上收款受影响', a: ['查看详情', '忽略'] },
    };
    const sync = () => { const n = $$('.fb-nt', stack).length; stack.toggleAttribute('data-empty', !n); clear.disabled = !n; if (!n && !$('.fb-empty', stack)) stack.appendChild(mk(`<div class="fb-empty fb-empty--sm"><img data-ic="bag" src="${A}/icons/${Lz.iconSet()}/bag.webp" alt=""><p>暂无通知</p></div>`)); if (n) { const e = $('.fb-empty', stack); if (e) e.remove(); } };
    const add = k => {
      const d = K[k]; const el = mk(`<div class="fb-nt" data-tone="${d.tone}" role="${d.tone === 'danger' ? 'alert' : 'status'}"><img class="fb-nt__ic" src="${A}/solid/${d.ic}.webp" alt=""><div><p class="fb-nt__t">${d.t}</p><p class="fb-nt__p">${d.p}</p><div class="fb-nt__f"><button type="button" class="btn btn--primary btn--sm" data-go>${d.a[0]}</button><button type="button" class="btn btn--text btn--sm" data-x>${d.a[1]}</button></div></div><button type="button" class="ibtn" data-x data-tip="关闭" aria-label="关闭通知"><img src="${A}/line/close.webp" alt=""></button></div>`);
      el.dataset.act = d.a[0];
      const e0 = $('.fb-empty', stack); if (e0) e0.remove();
      stack.prepend(el); $$('.fb-nt', stack).slice(3).forEach(x => x.remove()); sync();
    };
    root.addEventListener('click', e => {
      const k = e.target.closest('[data-k]'); if (k) { add(k.dataset.k); return; }
      if (e.target.closest('[data-clear]')) { $$('.fb-nt', stack).forEach(x => x.remove()); sync(); return; }
      const n = e.target.closest('.fb-nt'); if (!n) return;
      if (e.target.closest('[data-go]')) { Lz.toast(n.dataset.act === '查看订单' ? '正在打开订单' : n.dataset.act === '去补货' ? '已创建补货单' : '正在打开详情', 'neutral'); }
      if (e.target.closest('[data-x]') || e.target.closest('[data-go]')) { n.remove(); sync(); }
    });
    add('stock'); add('order');
  })();

  /* 026 计数徽标：新增、处理、清零，零值可显示，九十九以上显示 99+ */
  (() => {
    const root = $('#fb-cn'), menu = $('.fb-cn-menu', root), live = $('[data-live]', root);
    const M = [{ n: '订单', ic: 'archive', v: 12, tone: 'action' }, { n: '售后', ic: 'support', v: 3, tone: 'danger' }, { n: '库存预警', ic: 'shield', v: 0, tone: 'warning' }, { n: '客户留言', ic: 'message', v: 128, tone: 'neutral' }];
    let cur = 0, zero = false;
    const label = v => (v > 99 ? '99+' : String(v));
    menu.innerHTML = M.map((m, i) => `<button type="button" class="fb-cn-item" data-i="${i}" aria-current="${i === cur}"><img src="${A}/line/${m.ic}.webp" alt=""><span>${m.n}</span></button>`).join('');
    const upd = (i, pop) => {
      const m = M[i], el = $(`[data-i="${i}"]`, menu); let c = $('.fb-cn', el);
      if (!(m.v > 0 || zero)) { if (c) c.remove(); return; }
      if (!c) { c = document.createElement('span'); c.className = 'fb-cn'; el.appendChild(c); }
      c.dataset.tone = m.v ? m.tone : 'neutral'; c.textContent = label(m.v); el.setAttribute('aria-label', `${m.n} 共 ${m.v} 条`);
      if (pop) { c.classList.remove('is-pop'); void c.offsetWidth; c.classList.add('is-pop'); }
    };
    const btns = () => { const m = M[cur]; $('[data-sub]', root).disabled = !m.v; $('[data-zero]', root).disabled = !m.v; };
    const all = () => M.forEach((_, i) => upd(i)); all(); btns();
    menu.addEventListener('click', e => { const b = e.target.closest('.fb-cn-item'); if (!b) return; cur = +b.dataset.i; $$('.fb-cn-item', menu).forEach((x, i) => x.setAttribute('aria-current', String(i === cur))); btns(); });
    const set = fn => { fn(M[cur]); upd(cur, true); btns(); live.textContent = `${M[cur].n} ${M[cur].v} 条`; };
    $('[data-add]', root).addEventListener('click', () => set(m => { m.v++; }));
    $('[data-sub]', root).addEventListener('click', () => set(m => { m.v = Math.max(0, m.v - 1); }));
    $('[data-zero]', root).addEventListener('click', () => set(m => { m.v = 0; }));
    root.addEventListener('lz:toggle', e => { zero = $('[role="switch"]', root).getAttribute('aria-checked') === 'true'; all(); });
  })();

  /* 027 状态徽章：浅色与实色切换；点徽章就近展开可流转的状态，终态只读 */
  (() => {
    const root = $('#fb-ls'), list = $('.fb-ls-list', root);
    const ST = { wait: '待处理', run: '处理中', appr: '待审批', ok: '已通过', no: '已驳回' };
    const NEXT = { wait: ['run'], run: ['appr'], appr: ['ok', 'no'], no: ['wait'], ok: [] };
    const T = [['红玫瑰花束到货延迟', '工单 2041 吴桐', 'run'], ['白郁金香调价申请', '审批 3306 陈默', 'appr'], ['多肉组合盆破损', '工单 2042 周岚', 'wait'], ['满减活动延期', '审批 3304 吴桐', 'no'], ['花礼盒下架申请', '审批 3305 林晓', 'ok']];
    const badge = (s, i) => NEXT[s].length ? `<button type="button" class="fb-ls" data-s="${s}" aria-expanded="false" aria-controls="fb-ls-p${i}" aria-label="更改状态 当前${ST[s]}">${ST[s]}<span class="chev" aria-hidden="true"></span></button>` : `<span class="fb-ls" data-s="${s}">${ST[s]}</span>`;
    const opts = s => NEXT[s].map(n => `<button type="button" class="fb-ls" data-to="${n}">${ST[n]}</button>`).join('');
    const row = (t, i) => `<div class="fb-ls-item" data-i="${i}" data-s="${t[2]}"><div class="row"><span class="row__main"><span class="row__title">${t[0]}</span><span class="row__meta">${t[1]}</span></span><span class="row__trail">${badge(t[2], i)}</span></div>${NEXT[t[2]].length ? `<div class="expand" id="fb-ls-p${i}" data-open="false" inert><div><div class="expand__body fb-ls-opts"><span class="fb-ls-to">改为</span>${opts(t[2])}<button type="button" class="btn btn--text btn--sm" data-cancel>取消</button></div></div></div>` : ''}</div>`;
    list.innerHTML = T.map(row).join('');
    const setOpen = (item, o) => { const p = $('.expand', item), b = $('button.fb-ls[data-s]', item); if (!p) return; p.dataset.open = String(o); p.inert = !o; if (b) b.setAttribute('aria-expanded', String(o)); };
    list.addEventListener('click', e => {
      const item = e.target.closest('.fb-ls-item'); if (!item) return; const i = +item.dataset.i;
      const b = e.target.closest('button.fb-ls[data-s]');
      if (b) { const o = $('.expand', item).dataset.open !== 'true'; $$('.fb-ls-item', list).forEach(x => setOpen(x, false)); setOpen(item, o); return; }
      if (e.target.closest('[data-cancel]')) { setOpen(item, false); $('button.fb-ls[data-s]', item).focus(); return; }
      const to = e.target.closest('[data-to]');
      if (to) { T[i][2] = to.dataset.to; const nu = mk(row(T[i], i)); item.replaceWith(nu); Lz.toast('状态已更新为' + ST[T[i][2]], 'success'); const f = $('button.fb-ls[data-s]', nu); if (f) f.focus({ preventScroll: true }); }
    });
    list.addEventListener('keydown', e => { if (e.key === 'Escape') { const item = e.target.closest('.fb-ls-item'); if (item && $('.expand', item) && $('.expand', item).dataset.open === 'true') { setOpen(item, false); $('button.fb-ls[data-s]', item).focus(); } } });
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'fb-ls') root.dataset.solid = String(e.detail.key === 'solid'); });
  })();

  /* 028 公告横幅：三类公告切换，详情就近展开，关闭后收起并给恢复入口 */
  (() => {
    const root = $('#fb-bn'), wrap = $('[data-wrap]', root), ban = $('.fb-bn', root), more = $('[data-more]', root), p = $('#fb-bn-p'), kv = $('dl', p), rs = $('[data-restore]', root);
    const N = {
      ops: { tone: 'warning', tag: '维护', msg: '支付系统周六 02:00 至 04:00 升级维护，线上收款暂停', link: '查看影响', kv: [['影响范围', '小程序下单、网页收款'], ['维护时段', '周六 02:00 至 04:00'], ['不受影响', '门店扫码收银']] },
      fault: { tone: 'danger', tag: '故障', msg: '微信支付通道异常，建国路店线上订单暂不能支付', link: '查看进度', kv: [['影响范围', '建国路店线上支付'], ['当前进度', '通道方已确认，正在恢复'], ['不受影响', '其他门店与线下收银']] },
      news: { tone: 'info', tag: '上线', msg: '会员积分抵扣已上线，订单页可直接使用', link: '查看规则', kv: [['抵扣比例', '100 积分抵 1 元'], ['使用门槛', '订单满 50 元'], ['适用范围', '全部门店线上订单']] },
    };
    const setOpen = o => { p.dataset.open = String(o); p.inert = !o; more.setAttribute('aria-expanded', String(o)); };
    const show = k => { const n = N[k]; ban.dataset.tone = n.tone; ban.setAttribute('role', n.tone === 'danger' ? 'alert' : 'status'); $('[data-tag]', ban).textContent = n.tag; $('[data-msg]', ban).textContent = n.msg; more.textContent = n.link; kv.innerHTML = n.kv.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join(''); setOpen(false); wrap.removeAttribute('data-gone'); wrap.inert = false; rs.hidden = true; };
    more.addEventListener('click', () => setOpen(p.dataset.open !== 'true'));
    $('[data-close]', root).addEventListener('click', () => { wrap.dataset.gone = ''; wrap.inert = true; rs.hidden = false; rs.focus(); });
    rs.addEventListener('click', () => { wrap.removeAttribute('data-gone'); wrap.inert = false; rs.hidden = true; more.focus(); });
    document.addEventListener('lz:seg', e => { if (e.detail.group === 'fb-bn') show(e.detail.key); });
    show('ops');
  })();

  /* 029 悬停预览：悬停稍停、键盘聚焦或点按都出卡，鼠标可移入卡里，Esc 关闭；右侧放不下就放左侧 */
  (() => {
    const box = $('#fb-hc-box'), card = $('#fb-hc'); let cur = null, t1 = 0, t2 = 0;
    const CUS = { 林晓: ['mark-001', '金卡会员', '常客', 'action', 12, '3,680', '1,260'], 陈默: ['mark-002', '银卡会员', '新客', 'info', 3, '1,046', '420'], 周岚: ['mark-003', '金卡会员', '常客', 'action', 8, '2,415', '880'] };
    const SKU = { 红玫瑰花束: ['product-rose-red', 199, 36, 58, '98%'], 粉芍药花束: ['product-peony-pink', 239, 24, 31, '97%'], 向日葵花束: ['product-sunflower', 159, 40, 44, '99%'] };
    const STO = { 建国路店: [412, '56,320', 6], 徐汇滨江店: [536, '71,640', 7], 浦东世纪店: [394, '50,920', 5] };
    const st3 = a => `<div class="fb-hc__st">${a.map(([k, v]) => `<div><span>${k}</span><b>${v}</b></div>`).join('')}</div>`;
    const D = {
      cus: n => { const c = CUS[n]; return `<div class="fb-hc__head"><img class="is-round" src="${A}/marks/${c[0]}.webp" alt=""><span class="fb-hc__nm"><b>${n}</b><span>${c[1]}</span></span><span class="tag" data-tone="${c[3]}">${c[2]}</span></div>${st3([['订单', c[4] + ' 单'], ['累计消费', '¥' + c[5]], ['积分', c[6]]])}`; },
      sku: n => { const c = SKU[n]; return `<div class="fb-hc__head"><img src="${A}/photo/${c[0]}.webp" alt=""><span class="fb-hc__nm"><b>${n}</b><span class="price"><small>¥</small>${c[1]}</span></span><span class="tag" data-tone="success">在售</span></div>${st3([['库存', c[2] + ' 件'], ['本周售出', c[3] + ' 件'], ['好评率', c[4]]])}`; },
      store: n => { const c = STO[n]; return `<div class="fb-hc__head"><img class="is-round" src="${A}/solid/biz-store.webp" alt=""><span class="fb-hc__nm"><b>${n}</b><span>09:00 至 21:00</span></span><span class="tag" data-tone="success">营业中</span></div>${st3([['本周订单', c[0] + ' 单'], ['本周营业额', '¥' + c[1]], ['店员', c[2] + ' 人']])}`; },
    };
    const place = el => {
      const b = box.getBoundingClientRect(), c = el.getBoundingClientRect(), w = card.offsetWidth, h = card.offsetHeight, cy = c.top + c.height / 2 - b.top;
      const roomR = b.right - c.right - 22, roomL = c.left - b.left - 22, side = roomR >= w || roomR >= roomL ? 'right' : 'left';
      const left = side === 'right' ? c.right - b.left + 14 : c.left - b.left - 14 - w;
      const top = Math.min(Math.max(cy - 34, 8), Math.max(8, b.height - h - 8));
      card.dataset.side = side; card.style.left = Math.max(8, left) + 'px'; card.style.top = top + 'px';
      card.style.setProperty('--ay', Math.min(Math.max(cy - top - 5, 14), Math.max(14, h - 26)) + 'px');
    };
    const close = () => { clearTimeout(t1); if (!cur) return; cur.setAttribute('aria-expanded', 'false'); cur.removeAttribute('aria-describedby'); cur = null; card.hidden = true; };
    const open = el => { clearTimeout(t2); if (cur === el) return; if (cur) close(); cur = el; card.innerHTML = D[el.dataset.k](el.dataset.v); card.hidden = false; place(el); el.setAttribute('aria-expanded', 'true'); el.setAttribute('aria-describedby', 'fb-hc'); };
    $$('.fb-hc-t', box).forEach(el => {
      el.addEventListener('pointerenter', e => { if (e.pointerType !== 'mouse') return; clearTimeout(t2); t1 = setTimeout(() => open(el), 140); });
      el.addEventListener('pointerleave', e => { if (e.pointerType !== 'mouse') return; clearTimeout(t1); t2 = setTimeout(close, 160); });
      el.addEventListener('focus', () => { if (el.matches(':focus-visible')) open(el); });
      el.addEventListener('blur', e => { if (!card.contains(e.relatedTarget)) close(); });
      el.addEventListener('pointerdown', e => { el._pt = e.pointerType; });
      el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') el._pt = 'key'; });
      el.addEventListener('click', () => { if (cur === el) { if (el._pt !== 'mouse') close(); } else open(el); });
    });
    card.addEventListener('pointerenter', () => clearTimeout(t2));
    card.addEventListener('pointerleave', () => { t2 = setTimeout(close, 160); });
    box.addEventListener('keydown', e => { if (e.key === 'Escape' && cur) { const c = cur; close(); c.focus({ preventScroll: true }); } });
    document.addEventListener('click', e => { if (cur && !box.contains(e.target)) close(); });
    addEventListener('resize', close);
  })();
})();
</script>
