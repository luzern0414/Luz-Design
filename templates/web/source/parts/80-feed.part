        <div class="fb-bn" data-tone="warning" role="status"><b data-tag>维护</b><span data-msg></span><button type="button" class="btn btn--text btn--sm" data-more aria-expanded="false" aria-controls="fb-bn-p"></button><button type="button" class="ibtn" data-close data-tip="关闭" aria-label="关闭公告"><img src="../../kit/assets/line/close.webp" alt=""></button></div>
        <div class="expand" id="fb-bn-p" data-open="false" inert><div><dl class="fb-bn-kv expand__body"></dl></div></div>
      </div></div>
