  <div class="demo__stage">
    <div class="card ag-pl" id="ag-pl" data-run="false">
      <div class="ag-pl__top"><span class="ag-pl__t">对账计划</span><span class="tag" data-tone="action" data-st>进行中</span><span class="ag-pl__n" data-n></span></div>
      <div class="progress" role="progressbar" aria-label="计划完成进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i></i></div>
