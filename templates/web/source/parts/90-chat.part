                  <div class="ag-sr__item"><button type="button" class="row ag-sr__row" aria-expanded="false" aria-controls="ag-sr-e3"><span class="cite">3</span><span class="row__main"><span class="row__title">人工备注</span><span class="row__meta">差异核实记录</span></span><span class="row__trail"><span class="tag" data-tone="warning">备注</span><span class="chev" aria-hidden="true"></span></span></button><div class="expand" id="ag-sr-e3" data-open="false" inert><div><div class="expand__body"><p class="row__meta">摘录</p><p class="ag-sr__q">订单 10890 银行退回 ¥70.00，待财务核实</p></div></div></div></div>
                </div>
