</article>

<article class="demo" data-cid="WB-CHAT-022" data-name="文件树结构卡" data-cat="CHAT">
  <div class="demo__head"><span class="demo__name">文件树结构卡</span></div>
  <p class="demo__note">适合：展示智能体生成的目录与文件树</p>
  <div class="demo__stage">
    <div class="card ag-card" id="ag-ft">
      <div class="ag-ft__top"><span class="ag-ft__t">生成的文件<span class="tag" data-tone="action" data-cnt></span></span><button type="button" class="btn btn--text btn--sm" data-all>全部收起</button></div>
      <div class="ag-ft" role="tree" aria-label="生成的文件"></div>
      <div class="ag-ft__foot" role="status" aria-live="polite" data-foot></div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const A = '../../kit/assets';
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const mk = html => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };
  const setOpen = (btn, panel, open) => { panel.dataset.open = String(open); panel.inert = !open; btn.setAttribute('aria-expanded', String(open)); };
  const copy = async txt => {
    try { await navigator.clipboard.writeText(txt); return true; } catch (e) { /* 退回到选中复制 */ }
    try { const ta = document.createElement('textarea'); ta.value = txt; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-999px;top:0;opacity:0'; document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); ta.remove(); return ok; } catch (e) { return false; }
  };
  const flash = (btn, txt, ms = 1600) => { const old = btn.dataset.old || btn.textContent; btn.dataset.old = old; btn.textContent = txt; btn.setAttribute('data-done', ''); clearTimeout(btn._t); btn._t = setTimeout(() => { btn.textContent = old; btn.removeAttribute('data-done'); }, ms); };

  /* 018 消息操作条：复制回执、重新生成出新版本、反馈二选一、版本前后切换 */
  (() => {
    const root = $('#ag-ba'), b = $('[data-b]', root), bar = $('.ag-ba', root), ver = $('[data-ver]', root), vn = $('[data-vn]', root);
    const V = [
      ['本周线上订单共 1,342 单，营业额 ¥178,880，客单价 ¥133。', '周六单量最高，为 258 单，占全周 19.2%。'],
    ];
    const POOL = [
      ['本周营业额 ¥178,880，较上周增长 12.4%。', '线上订单 1,342 单，客单价 ¥133。'],
      ['线上订单共 1,342 单，周六最高，为 258 单。', '营业额 ¥178,880，客单价 ¥133。'],
    ];
    let cur = 0, busy = false;
    const show = i => { cur = i; b.innerHTML = V[i].map(t => `<p>${t}</p>`).join(''); const n = V.length; ver.hidden = n < 2; vn.textContent = `${i + 1} / ${n}`; $('[data-v="-1"]', ver).disabled = i === 0; $('[data-v="1"]', ver).disabled = i === n - 1; };
    const fresh = () => { $$('[aria-pressed]', bar).forEach(x => x.setAttribute('aria-pressed', 'false')); };
    show(0);
    bar.addEventListener('click', async e => {
      const x = e.target.closest('button'); if (!x || busy) return;
      if (x.dataset.a === 'copy') { const ok = await copy($$('p', b).map(p => p.textContent).join('\n')); flash(x, ok ? '已复制' : '复制失败'); return; }
      if (x.dataset.a === 'up' || x.dataset.a === 'down') { const on = x.getAttribute('aria-pressed') !== 'true'; $$('[aria-pressed]', bar).forEach(y => y.setAttribute('aria-pressed', 'false')); x.setAttribute('aria-pressed', String(on)); if (on) Lz.toast('已记录反馈', 'success'); return; }
      if (x.dataset.a === 'regen') {
        busy = true; $$('button', bar).forEach(y => { y.disabled = true; }); fresh();
        const next = POOL[(V.length - 1) % POOL.length]; b.innerHTML = '<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>'; await sleep(700); b.textContent = '';
        for (const t of next) { const p = document.createElement('p'); b.appendChild(p); await Lz.stream(p, t, 40); }
        V.push(next); show(V.length - 1); busy = false; $$('button', bar).forEach(y => { y.disabled = false; }); show(cur);
        if (V.length >= 3) $('[data-a="regen"]', bar).disabled = true;
        $('[data-v="-1"]', ver).focus(); return;
      }
      if (x.dataset.v) { show(cur + +x.dataset.v); fresh(); }
    });
    bar.addEventListener('keydown', e => {
      const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return;
      const list = $$('button:not(:disabled)', bar), i = list.indexOf(document.activeElement); if (i < 0) return; e.preventDefault(); list[(i + d + list.length) % list.length].focus();
    });
  })();

  /* 019 代码块：中文键值，缩进与行号，复制给回执，超过六行折叠 */
  (() => {
    const root = $('#ag-cb'), head = $('[data-head]', root), more = $('[data-more]', root), p = $('#ag-cb-p'), tg = $('.ag-cb__t', root), tt = $('[data-tt]', root), cb = $('[data-cp]', root);
    const L = [[0, '预警线', '10 件'], [0, '检查频率', '每 30 分钟'], [0, '检查范围', ''], [1, '', '- 建国路店'], [1, '', '- 徐汇滨江店'], [1, '', '- 浦东世纪店'], [0, '通知方式', '站内通知、短信'], [0, '免打扰时段', '22:00 至 07:00'], [0, '售罄处理', '自动下架']];
    const ln = l => `<li class="ag-cb__ln"><span style="--d:${l[0]}">${l[1] ? `<span class="ag-cb__k">${l[1]}</span><span class="ag-cb__p">：</span>` : ''}<span class="ag-cb__v">${l[2]}</span></span></li>`;
    head.innerHTML = L.slice(0, 6).map(ln).join(''); more.innerHTML = L.slice(6).map(ln).join('');
    tg.addEventListener('click', () => { const o = p.dataset.open !== 'true'; setOpen(tg, p, o); tt.textContent = o ? '收起' : `展开全部 ${L.length} 行`; });
    cb.addEventListener('click', async () => { const txt = L.map(l => '  '.repeat(l[0]) + (l[1] ? l[1] + '：' : '') + l[2]).join('\n'); const ok = await copy(txt); flash(cb, ok ? '已复制' : '复制失败'); if (ok) Lz.toast('配置已复制', 'success'); });
  })();

  /* 020 来源引用：头部开合整张列表，来源行单开摘录 */
  (() => {
    const root = $('#ag-sr'), head = $('.ag-sr__head', root), p = $('#ag-sr-p'), rows = $$('.ag-sr__row', root);
    head.addEventListener('click', () => { const o = p.dataset.open !== 'true'; setOpen(head, p, o); if (!o) rows.forEach(r => setOpen(r, $('#' + r.getAttribute('aria-controls')), false)); });
    rows.forEach(r => r.addEventListener('click', () => { const o = r.getAttribute('aria-expanded') !== 'true'; rows.forEach(x => setOpen(x, $('#' + x.getAttribute('aria-controls')), x === r && o)); }));
  })();

  /* 021 计划步骤：进行中的步骤按进度推进，可暂停继续，重新计划回到初始 */
  (() => {
    const root = $('#ag-pl'), ol = $('.ag-pl__steps', root), st = $('[data-st]', root), n = $('[data-n]', root), prog = $('.progress', root), go = $('[data-go]', root), reset = $('[data-reset]', root);
    const S = [
      { t: '确定对账范围', w: '本周线上订单', d: '本周线上订单', max: 1, p: 1 },
      { t: '读取订单与支付流水', w: '订单系统与支付平台', d: '订单 1,342 单 流水 1,339 笔', max: 1, p: 1 },
      { t: '逐笔比对金额', w: '按订单号逐笔比对', d: '已比对 1,342 单', max: 1342, p: 612, run: p => `已比对 ${p.toLocaleString('zh-CN')} / 1,342 单`, inc: 90 },
      { t: '标出差异订单', w: '金额不一致的订单', d: '共标出 3 笔 合计 ¥417.00', max: 3, p: 0, run: p => `已标出 ${p} 笔`, inc: 1 },
      { t: '生成对账结果', w: '表格含差异原因', d: '已生成 1 张表格', max: 4, p: 0, run: p => '正在生成', inc: 1 },
    ];
    const init = S.map(s => s.p); let timer = 0, running = false;
    const cur = () => S.findIndex(s => s.p < s.max);
    ol.innerHTML = S.map((s, i) => `<li class="ag-pl__s"><span class="ag-pl__m"><img src="${A}/line/check.webp" alt=""><span class="ag-pl__no">${i + 1}</span></span><div class="ag-pl__b"><p class="row__title">${s.t}</p><p class="row__meta"></p></div><span class="tag"></span></li>`).join('');
    const lis = $$('.ag-pl__s', ol);
    const paint = () => {
      const c = cur(), done = S.filter(s => s.p >= s.max).length, all = c < 0;
      lis.forEach((li, i) => { const s = S[i], state = s.p >= s.max ? 'done' : i === c ? 'now' : 'wait'; const tag = $('.tag', li);
        li.dataset.state = state; $('.row__meta', li).textContent = state === 'done' ? s.d : state === 'now' ? s.run(s.p) : s.w;
        tag.textContent = state === 'done' ? '已完成' : state === 'now' ? (running ? '进行中' : '已暂停') : '待执行';
        const tone = state === 'done' ? 'success' : state === 'now' ? (running ? 'action' : 'warning') : ''; if (tone) tag.dataset.tone = tone; else tag.removeAttribute('data-tone'); });
      root.dataset.run = String(running); n.textContent = `已完成 ${done} 项 共 ${S.length} 项`;
      const v = Math.round(done / S.length * 100); $('i', prog).style.setProperty('--v', v + '%'); prog.setAttribute('aria-valuenow', v);
      st.textContent = all ? '已完成' : running ? '进行中' : '已暂停'; st.dataset.tone = all ? 'success' : running ? 'action' : 'warning';
      go.textContent = all ? '已完成' : running ? '暂停' : (done > 2 || S[2].p > init[2] ? '继续执行' : '开始执行'); go.disabled = all; go.className = 'btn btn--sm ' + (running ? 'btn--ghost' : 'btn--primary');
    };
    const stop = () => { clearInterval(timer); timer = 0; running = false; };
    const start = () => { if (timer || cur() < 0) return; running = true; timer = setInterval(() => { const c = cur(); if (c < 0) { stop(); paint(); return; } const s = S[c]; s.p = Math.min(s.max, s.p + s.inc || 1); if (cur() < 0) stop(); paint(); }, 320); paint(); };
    go.addEventListener('click', () => { running ? (stop(), paint()) : start(); });
    reset.addEventListener('click', () => { stop(); S.forEach((s, i) => { s.p = init[i]; }); paint(); });
    paint();
    const io = new IntersectionObserver(es => { if (es[0].isIntersecting) { io.disconnect(); if (!Lz.reduce) start(); } }, { threshold: .6 }); io.observe(root);
  })();

  /* 022 文件树：树形键盘操作，文件夹开合，选中文件在底部给出路径 */
  (() => {
    const root = $('#ag-ft'), tree = $('.ag-ft', root), foot = $('[data-foot]', root), all = $('[data-all]', root), cnt = $('[data-cnt]', root);
    const T = [
      { n: '本周对账', d: 0, f: true, open: true },
      { n: '订单', d: 1, f: true, open: true },
      { n: '线上订单明细', d: 2, ic: 'solid/bill', m: '表格 1,342 行' },
      { n: '退款订单明细', d: 2, ic: 'solid/bill', m: '表格 23 行' },
      { n: '流水', d: 1, f: true, open: false },
      { n: '微信流水', d: 2, ic: 'solid/bill', m: '表格 1,087 行' },
      { n: '银行流水', d: 2, ic: 'solid/bill', m: '表格 252 行' },
      { n: '对账汇总', d: 1, ic: 'solid/biz-notes', m: '报告 3 页', nw: true },
      { n: '差异明细', d: 1, ic: 'solid/bill', m: '表格 3 行', nw: true },
      { n: '差异分布', d: 1, ic: 'solid/layout', m: '图表 1 张', nw: true },
    ];
    let sel = -1, focus = 0;
    const parent = i => { for (let k = i - 1; k >= 0; k--) if (T[k].d < T[i].d) return k; return -1; };
    const vis = i => { for (let k = parent(i); k >= 0; k = parent(k)) if (!T[k].open) return false; return true; };
    const path = i => { const a = []; for (let k = i; k >= 0; k = parent(k)) a.unshift(T[k].n); return a.join(' / '); };
    const files = T.filter(t => !t.f).length;
    cnt.textContent = `${files} 个文件`;
    const paint = () => {
      tree.innerHTML = T.map((t, i) => !vis(i) ? '' :
        `<button type="button" class="ag-ft__i" role="treeitem" aria-level="${t.d + 1}" ${t.f ? `aria-expanded="${t.open}"` : ''} aria-selected="${i === sel}" data-i="${i}" tabindex="${i === focus ? 0 : -1}" style="--d:${t.d}">${t.f ? '<span class="chev" aria-hidden="true"></span>' : '<span class="ag-ft__sp"></span>'}<img src="${A}/${t.f ? 'line/folder' : t.ic}.webp" alt=""><span class="ag-ft__n">${t.n}</span>${t.nw ? '<span class="tag" data-tone="action">新</span>' : ''}${t.m ? `<span class="ag-ft__m">${t.m}</span>` : ''}</button>`).join('');
      const open = T.some(t => t.f && t.open); all.textContent = open ? '全部收起' : '全部展开';
      foot.innerHTML = sel < 0 ? '选择文件查看路径' : `已选 <b>${path(sel)}</b>`;
    };
    const go = i => { focus = i; paint(); const el = $(`[data-i="${i}"]`, tree); if (el) el.focus(); };
    const visible = () => T.map((_, i) => i).filter(vis);
    tree.addEventListener('click', e => { const b = e.target.closest('.ag-ft__i'); if (!b) return; const i = +b.dataset.i; focus = i; if (T[i].f) T[i].open = !T[i].open; else sel = i; go(i); });
    tree.addEventListener('keydown', e => {
      const b = e.target.closest('.ag-ft__i'); if (!b) return; const i = +b.dataset.i, v = visible(), k = v.indexOf(i), t = T[i];
      if (e.key === 'ArrowDown') { e.preventDefault(); go(v[Math.min(v.length - 1, k + 1)]); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); go(v[Math.max(0, k - 1)]); }
      else if (e.key === 'Home') { e.preventDefault(); go(v[0]); }
      else if (e.key === 'End') { e.preventDefault(); go(v[v.length - 1]); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); if (t.f && !t.open) { t.open = true; go(i); } else if (t.f) go(i + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); if (t.f && t.open) { t.open = false; go(i); } else if (parent(i) >= 0) go(parent(i)); }
    });
    all.addEventListener('click', () => { const open = T.some(t => t.f && t.open); T.forEach(t => { if (t.f) t.open = !open; }); if (!vis(focus)) focus = 0; paint(); });
    paint();
  })();
})();
</script>
