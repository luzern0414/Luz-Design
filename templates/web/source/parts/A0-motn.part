</article>

<article class="demo" data-cid="WB-MOTN-012" data-name="视图切换" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">视图切换</span></div>
  <p class="demo__note">适合：列表进详情的横向推入，返回在左上并回到原处</p>
  <div class="demo__stage">
    <div class="mo-card">
      <div class="mo-view"><div class="mo-vw" id="mo-vw">
        <div class="mo-pane" data-pane="list" data-pos="on">
          <button type="button" class="row" data-pick="1"><img class="row__lead" src="../../kit/assets/photo/product-rose-red.webp" alt=""><span class="row__main"><span class="row__title">红玫瑰花束</span><span class="row__meta">库存 36 件</span></span><span class="row__trail chev"></span></button>
          <button type="button" class="row" data-pick="2"><img class="row__lead" src="../../kit/assets/photo/product-peony-pink.webp" alt=""><span class="row__main"><span class="row__title">粉芍药花束</span><span class="row__meta">库存 24 件</span></span><span class="row__trail chev"></span></button>
          <button type="button" class="row" data-pick="3"><img class="row__lead" src="../../kit/assets/photo/product-sunflower.webp" alt=""><span class="row__main"><span class="row__title">向日葵花束</span><span class="row__meta">库存 40 件</span></span><span class="row__trail chev"></span></button>
        </div>
        <div class="mo-pane" data-pane="detail" data-pos="right" inert>
          <div class="mo-bar2"><button type="button" class="ibtn" data-ret data-tip="返回" aria-label="返回"><img src="../../kit/assets/line/back.webp" alt=""></button><h3 data-t></h3></div>
          <div class="mo-det"><img data-img src="../../kit/assets/photo/product-rose-red.webp" alt=""><dl><dt>售价</dt><dd data-p></dd><dt>库存</dt><dd data-s></dd><dt>状态</dt><dd>在售</dd></dl></div>
        </div>
      </div></div>
      <div class="mo-bar"><button type="button" class="btn btn--secondary btn--sm" data-mo="v">播放</button></div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const rerun = (el, cls) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };
  const once = (el, fn) => { const io = new IntersectionObserver(es => { if (es[0].isIntersecting) { io.disconnect(); fn(); } }, { threshold: .6 }); io.observe(el); };
  const plays = {};

  /* 001 数字滚动 */
  plays.n = () => Lz.count($('#mo-n'), 178880, 1100);

  /* 002 徽标弹入：数字加一并重播弹入 */
  (() => { const b = $('#mo-ib .mo-bdg'); let n = 3; plays.b = () => { b.textContent = ++n; rerun(b, 'is-pop'); }; })();

  /* 003 展开收起：点按钮可手动开合，播放时自动展开一次再收起 */
  (() => {
    const btn = $('#mo-acc-b'), p = $('#mo-acc-p');
    const set = o => { p.dataset.open = String(o); p.inert = !o; btn.setAttribute('aria-expanded', String(o)); };
    btn.addEventListener('click', () => set(p.dataset.open !== 'true'));
    plays.a = async () => { if (p.dataset.open !== 'true') { set(true); await sleep(900); } set(false); await sleep(900); set(true); };
  })();

  /* 004 标签滑动：底块平移并变宽，方向键切换 */
  (() => {
    const s = $('#mo-sl'), tabs = $$('.mo-slider__tab', s), pill = $('.mo-slider__pill', s); let cur = 0;
    const go = (i, instant) => { cur = i; tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; }); if (instant) pill.style.transition = 'none'; pill.style.width = tabs[i].offsetWidth + 'px'; pill.style.transform = `translateX(${tabs[i].offsetLeft}px)`; if (instant) { void pill.offsetWidth; pill.style.transition = ''; } };
    tabs.forEach((t, i) => { t.addEventListener('click', () => go(i)); t.addEventListener('keydown', e => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (!d) return; e.preventDefault(); const n = (i + d + tabs.length) % tabs.length; tabs[n].focus(); go(n); }); });
    plays.s = async () => { go(0); for (const i of [1, 2, 0]) { await sleep(700); go(i); } };
    new ResizeObserver(() => go(cur, true)).observe(s); go(0, true);
  })();

  /* 005 卡片尺寸：点击切换，播放时放大再还原 */
  (() => {
    const m = $('#mo-mp'); m.addEventListener('click', () => { m.dataset.size = m.dataset.size === 's' ? 'l' : 's'; });
    plays.m = async () => { const to = m.dataset.size === 's' ? 'l' : 's'; m.dataset.size = to; await sleep(1500); m.dataset.size = to === 'l' ? 's' : 'l'; };
  })();

  /* 006 成功勾选 */
  plays.o = () => rerun($('#mo-ok'), 'is-in');

  /* 007 输入抖动：回车校验，播放时示范一次失败 */
  (() => {
    const inp = $('#mo-in'), err = $('#mo-er');
    const bad = () => { inp.setAttribute('aria-invalid', 'true'); inp.setAttribute('aria-describedby', 'mo-er'); err.dataset.show = 'true'; rerun(inp, 'shake'); };
    const ok = () => { inp.removeAttribute('aria-invalid'); err.dataset.show = 'false'; };
    const valid = () => inp.value.trim().length > 0;
    inp.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing) (valid() ? ok : bad)(); });
    inp.addEventListener('input', () => { if (valid()) ok(); });
    plays.i = async () => { inp.value = ''; bad(); await sleep(1600); inp.value = '红玫瑰花束'; ok(); };
  })();

  /* 008 骨架转内容 */
  plays.k = async () => { const s = $('#mo-sw'); s.dataset.state = 'load'; await sleep(1200); s.dataset.state = 'done'; };

  /* 009 流式文字：等待点后逐字输出 */
  (() => {
    const live = $('#mo-st .mo-st__live'), text = live.textContent; let busy = false;
    plays.t = async () => { if (busy) return; busy = true; live.innerHTML = '<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>'; await sleep(700); live.textContent = ''; await Lz.stream(live, text, 60); busy = false; };
  })();

  /* 010 悬停抬升：播放时持续抬升再落下，真实悬停同样触发 */
  plays.l = async () => { const c = $('#mo-lf'); c.classList.add('is-on'); await sleep(1400); c.classList.remove('is-on'); };

  /* 011 列表错峰入场 */
  plays.g = () => { const l = $('#mo-sg'); l.classList.remove('is-in', 'is-done'); void l.offsetWidth; l.classList.add('is-in'); setTimeout(() => l.classList.add('is-done'), 1200); };

  /* 012 视图切换：列表左移出、详情右移入，返回按钮在左上并回到触发行 */
  (() => {
    const vw = $('#mo-vw'), list = $('[data-pane="list"]', vw), det = $('[data-pane="detail"]', vw), back = $('[data-ret]', vw);
    const D = { 1: ['红玫瑰花束', '¥199', '36 件', 'product-rose-red'], 2: ['粉芍药花束', '¥239', '24 件', 'product-peony-pink'], 3: ['向日葵花束', '¥159', '40 件', 'product-sunflower'] }; let last = null;
    const open = k => { const d = D[k]; last = $(`[data-pick="${k}"]`, vw); $('[data-t]', det).textContent = d[0]; $('[data-p]', det).textContent = d[1]; $('[data-s]', det).textContent = d[2]; $('[data-img]', det).src = `../../kit/assets/photo/${d[3]}.webp`; list.dataset.pos = 'left'; list.inert = true; det.dataset.pos = 'on'; det.inert = false; setTimeout(() => back.focus({ preventScroll: true }), 30); };
    const close = () => { det.dataset.pos = 'right'; det.inert = true; list.dataset.pos = 'on'; list.inert = false; if (last) setTimeout(() => last.focus({ preventScroll: true }), 30); };
    list.addEventListener('click', e => { const r = e.target.closest('[data-pick]'); if (r) open(r.dataset.pick); });
    back.addEventListener('click', close);
    vw.addEventListener('keydown', e => { if (e.key === 'Escape' && det.dataset.pos === 'on') close(); });
    plays.v = async () => { if (det.dataset.pos === 'on') { close(); await sleep(600); } open('2'); await sleep(1500); close(); };
  })();

  $$('[data-mo]').forEach(b => { if (plays[b.dataset.mo] && b.closest('[data-cat="MOTN"]')) b.addEventListener('click', () => plays[b.dataset.mo]()); });
  [['#mo-n', 'n'], ['#mo-ib', 'b'], ['#mo-ok', 'o'], ['#mo-sw', 'k'], ['#mo-st', 't'], ['#mo-sg', 'g']].forEach(([s, k]) => once($(s), plays[k]));
})();
</script>

<style>
  /* 轮播滑动切换：类名前缀 mo-cr。当前张最大，两侧依次缩小淡出，循环切换；宽度够才露出第二张 */
  .mo-cr { container-type: inline-size; }
  .mo-cr__track { --w: clamp(232px, calc((50cqw - 14px) / 1.38), 296px); display: grid; place-items: center; padding: var(--s-4) 0; overflow: hidden; touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  .mo-cr__track:focus-visible { outline-offset: -2px; }
  .mo-cr__track[data-drag] { cursor: grabbing; }
  .mo-cr__s { --x: 0px; --sc: 1; --op: 1; grid-area: 1 / 1; width: var(--w); margin: 0; display: grid; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); overflow: hidden; transform: translateX(calc(var(--x) + var(--dx, 0px))) scale(var(--sc)); opacity: var(--op); z-index: var(--z, 1); transition: transform calc(var(--dur-slow) * 1.5) var(--ease-out), opacity calc(var(--dur-slow) * 1.5) var(--ease-out), visibility 0s linear var(--vd, 0s), box-shadow var(--dur-base) var(--ease-out); }
  .mo-cr__track[data-drag] .mo-cr__s, .mo-cr__s.is-jump { transition: none; }
  .mo-cr__s[data-o="0"] { --z: 4; box-shadow: var(--elev-2); }
  .mo-cr__s[data-o="1"], .mo-cr__s[data-o="-1"] { --sc: .88; --op: .82; --z: 3; cursor: pointer; }
  .mo-cr__s[data-o="2"], .mo-cr__s[data-o="-2"] { --sc: .76; --op: .56; --z: 2; cursor: pointer; }
  .mo-cr__s[data-o="3"], .mo-cr__s[data-o="-3"] { --sc: .64; --op: 0; --z: 1; --vd: calc(var(--dur-slow) * 1.5); visibility: hidden; pointer-events: none; }
  .mo-cr__s[data-o="1"] { --x: calc(var(--w) * .94 + 14px); }
  .mo-cr__s[data-o="-1"] { --x: calc((var(--w) * .94 + 14px) * -1); }
  .mo-cr__s[data-o="2"] { --x: calc(var(--w) * 1.76 + 28px); }
  .mo-cr__s[data-o="-2"] { --x: calc((var(--w) * 1.76 + 28px) * -1); }
  .mo-cr__s[data-o="3"] { --x: calc(var(--w) * 2.46 + 42px); }
  .mo-cr__s[data-o="-3"] { --x: calc((var(--w) * 2.46 + 42px) * -1); }
  @container (max-width: 1329px) { .mo-cr__s[data-o="2"], .mo-cr__s[data-o="-2"] { --op: 0; --vd: calc(var(--dur-slow) * 1.5); visibility: hidden; pointer-events: none; } }
  .mo-cr__s img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--zone); -webkit-user-drag: none; }
  .mo-cr__s figcaption { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 52px; padding: 0 var(--s-4); font-size: var(--fs-md); }
  .mo-cr__s figcaption b { font-weight: 600; white-space: nowrap; }
  .mo-cr__s figcaption .tag { margin-right: auto; }
  .mo-cr__dots { display: inline-flex; align-items: center; }
  .mo-cr__dot { display: grid; place-items: center; width: 24px; height: 32px; }
  .mo-cr__dot::before { content: ""; width: 8px; height: 8px; border-radius: var(--r-full); background: var(--line-strong); transition: width var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .mo-cr__dot[aria-current="true"]::before { width: 20px; background: var(--action); }
  .mo-cr__nav .chev { transform: rotate(0deg); }
  .mo-cr__nav[data-d="-1"] .chev { transform: rotate(180deg); }
</style>

<article class="demo demo--span2" data-cid="WB-MOTN-013" data-name="轮播滑动切换" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">轮播滑动切换</span></div>
  <p class="demo__note">适合：轮播图的滑动缓动切换与循环</p>
  <div class="demo__stage">
    <div class="mo-card">
      <div class="mo-cr" id="mo-cr" role="region" aria-roledescription="轮播" aria-label="本周主推商品">
        <div class="mo-cr__track" tabindex="0" aria-live="polite">
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-rose-red.webp" alt=""><figcaption><b>红玫瑰花束</b><span class="tag" data-tone="price">热卖</span><span class="price"><small>¥</small>199</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-peony-pink.webp" alt=""><figcaption><b>粉芍药花束</b><span class="tag" data-tone="action">新品</span><span class="price"><small>¥</small>239</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-sunflower.webp" alt=""><figcaption><b>向日葵花束</b><span class="price"><small>¥</small>159</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-tulip-white.webp" alt=""><figcaption><b>白郁金香</b><span class="price"><small>¥</small>179</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-hydrangea-blue.webp" alt=""><figcaption><b>蓝绣球盆栽</b><span class="price"><small>¥</small>129</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-monstera.webp" alt=""><figcaption><b>龟背竹盆栽</b><span class="price"><small>¥</small>159</span></figcaption></figure>
          <figure class="mo-cr__s"><img src="../../kit/assets/photo/product-giftbox.webp" alt=""><figcaption><b>花礼盒</b><span class="tag" data-tone="action">新品</span><span class="price"><small>¥</small>259</span></figcaption></figure>
        </div>
      </div>
      <div class="mo-bar">
        <button type="button" class="ibtn mo-cr__nav" data-d="-1" data-tip="上一张" aria-label="上一张"><span class="chev" aria-hidden="true"></span></button>
        <div class="mo-cr__dots" data-dots></div>
        <button type="button" class="ibtn mo-cr__nav" data-d="1" data-tip="下一张" aria-label="下一张"><span class="chev" aria-hidden="true"></span></button>
        <button type="button" class="btn btn--secondary btn--sm" data-cr-play>播放</button>
      </div>
    </div>
  </div>
</article>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const root = $('#mo-cr'), track = $('.mo-cr__track', root), slides = $$('.mo-cr__s', root), n = slides.length, card = root.parentElement;
  const dotBox = $('[data-dots]', card), play = $('[data-cr-play]', card), navs = $$('.mo-cr__nav', card);
  const half = Math.floor(n / 2); let cur = 0, timer = 0, laps = 0, limit = 0, held = false, moved = false;
  const NAMES = slides.map(s => $('b', s).textContent);
  dotBox.innerHTML = NAMES.map((t, i) => `<button type="button" class="mo-cr__dot" data-i="${i}" data-tip="第 ${i + 1} 张" aria-label="第 ${i + 1} 张 ${t}"></button>`).join('');
  const dots = $$('.mo-cr__dot', dotBox);
  const off = i => ((i - cur + n + half) % n + n) % n - half;
  const go = (k, instant) => {
    cur = ((k % n) + n) % n;
    slides.forEach((s, i) => {
      const o = off(i), prev = s.dataset.o === undefined ? o : +s.dataset.o, jump = Math.abs(o - prev) > half;
      if (jump || instant) { s.classList.add('is-jump'); }
      s.dataset.o = String(o); s.setAttribute('aria-hidden', String(o !== 0)); s.setAttribute('role', 'group'); s.setAttribute('aria-roledescription', '幻灯片'); s.setAttribute('aria-label', `第 ${i + 1} 张 共 ${n} 张`);
      if (jump || instant) { void s.offsetWidth; s.classList.remove('is-jump'); }
    });
    dots.forEach((d, i) => d.setAttribute('aria-current', String(i === cur)));
  };
  const setPlay = on => { play.textContent = on ? '暂停' : '播放'; track.setAttribute('aria-live', on ? 'off' : 'polite'); };
  const stop = () => { clearInterval(timer); timer = 0; setPlay(false); };
  const start = max => { stop(); laps = 0; limit = max; setPlay(true); timer = setInterval(() => { if (held) return; go(cur + 1); if (++laps >= limit) stop(); }, 2400); };
  go(0, true);

  navs.forEach(b => b.addEventListener('click', () => { stop(); go(cur + +b.dataset.d); }));
  dotBox.addEventListener('click', e => { const d = e.target.closest('.mo-cr__dot'); if (d) { stop(); go(+d.dataset.i); } });
  play.addEventListener('click', () => { timer ? stop() : start(n); });
  track.addEventListener('keydown', e => { const k = { ArrowLeft: -1, ArrowRight: 1 }[e.key]; if (k) { e.preventDefault(); stop(); go(cur + k); } else if (e.key === 'Home') { e.preventDefault(); stop(); go(0); } else if (e.key === 'End') { e.preventDefault(); stop(); go(n - 1); } });
  slides.forEach(s => s.addEventListener('click', () => { if (moved) return; const o = +s.dataset.o; if (o && Math.abs(o) <= half - 1) { stop(); go(cur + o); } }));

  track.addEventListener('dragstart', e => e.preventDefault());
  /* 拖动：跟手平移，松手超过五十像素切到前一张或后一张，否则弹回 */
  let sx = 0, dx = 0, drag = false;
  track.addEventListener('pointerdown', e => { if (e.button) return; drag = true; moved = false; sx = e.clientX; dx = 0; });
  track.addEventListener('pointermove', e => { if (!drag) return; dx = e.clientX - sx; if (Math.abs(dx) > 6) { if (!moved) track.setPointerCapture(e.pointerId); moved = true; track.dataset.drag = ''; track.style.setProperty('--dx', dx + 'px'); } });
  const end = () => { if (!drag) return; drag = false; delete track.dataset.drag; track.style.removeProperty('--dx'); if (Math.abs(dx) > 50) { stop(); go(cur + (dx < 0 ? 1 : -1)); } dx = 0; setTimeout(() => { moved = false; }, 0); };
  track.addEventListener('pointerup', end); track.addEventListener('pointercancel', end);
  root.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') held = true; }); root.addEventListener('pointerleave', () => { held = false; });
  root.addEventListener('focusin', () => { held = true; }); root.addEventListener('focusout', () => { held = false; });

  const io = new IntersectionObserver(es => { if (es[0].isIntersecting) { io.disconnect(); if (!Lz.reduce) start(3); } }, { threshold: .6 }); io.observe(root);
})();
</script>
