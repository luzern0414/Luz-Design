<!-- cat: MOTN | 动效 -->
<style>
  /* 动效：类名前缀 mo-。时长与曲线取 tokens 变量；每个演示带播放按钮，首次进入视野自动播一次；系统要求减少动态时直接显示最终状态 */
  .mo-card { display: grid; gap: var(--s-1); align-content: start; min-width: 0; }
  /* 舞台本身已是底框，预览直接放在上面；只有动画会改变高度的演示才预留高度，其余由内容撑开 */
  .mo-view { display: grid; place-items: center; padding: var(--s-4); }
  .mo-view--wide { place-items: center stretch; }
  .mo-bar { display: flex; align-items: center; justify-content: center; gap: var(--s-2); }

  /* 数字滚动 */
  .mo-big { font-size: var(--fs-3xl); font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .mo-big small { margin-right: 2px; font-size: var(--fs-lg); font-weight: 600; color: var(--ink-3); }
  .mo-sub { display: block; margin-top: var(--s-1); font-size: var(--fs-sm); color: var(--ink-3); text-align: center; }

  /* 徽标弹入 */
  .mo-view--ring { padding: var(--s-6); }
  .mo-ib { position: relative; display: grid; place-items: center; width: 72px; height: 72px; border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); }
  .mo-ib img { width: 36px; height: 36px; }
  .mo-bdg { position: absolute; top: -8px; right: -8px; display: grid; place-items: center; min-width: 24px; height: 24px; padding: 0 6px; border-radius: var(--r-full); background: var(--danger); color: var(--surface); font-size: var(--fs-xs); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; box-shadow: 0 0 0 3px var(--bg); }
  .mo-bdg.is-pop { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }

  /* 展开收起 */
  .mo-view--hold { align-content: start; min-height: 177px; }
  .mo-acc { width: 100%; overflow: hidden; }
  .mo-acc .row__title, .mo-acc .row__meta { display: block; }

  /* 标签滑动 */
  .mo-slider { position: relative; display: inline-flex; padding: 4px; border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .mo-slider__tab { position: relative; z-index: 1; min-height: 40px; padding: 0 var(--s-5); border-radius: var(--r-md); font-size: var(--fs-sm); color: var(--ink-2); transition: color var(--dur-base) var(--ease-out); }
  .mo-slider__tab[aria-selected="true"] { color: var(--surface); font-weight: 600; }
  .mo-slider__pill { position: absolute; top: 4px; bottom: 4px; left: 0; width: 0; border-radius: var(--r-md); background: var(--action); box-shadow: 0 4px 12px color-mix(in srgb, var(--action) 28%, transparent); transition: transform var(--dur-base) var(--ease-spring), width var(--dur-base) var(--ease-out); }

  /* 卡片尺寸 */
  .mo-view--morph { min-height: 280px; }
  .mo-morph { display: flex; flex-direction: column; width: 200px; height: 228px; padding: var(--s-2); gap: var(--s-2); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); text-align: left; overflow: hidden; transition: width var(--dur-slow) var(--ease-out), height var(--dur-slow) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .mo-morph[data-size="l"] { width: min(100%, 340px); height: 248px; box-shadow: var(--elev-3); }
  .mo-morph img { flex: 1; min-height: 0; width: 100%; border-radius: var(--r-md); object-fit: cover; }
  .mo-morph__t { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); padding: 0 var(--s-1); font-size: var(--fs-sm); font-weight: 600; }

  /* 成功勾选 */
  .mo-ok { position: relative; display: grid; place-items: center; width: 88px; height: 88px; border-radius: 50%; background: var(--success); }
  .mo-ok img { width: 44px; height: 44px; filter: invert(1); }
  .mo-ok.is-in { animation: lz-pop var(--dur-slow) var(--ease-spring) both; }
  .mo-ok.is-in img { animation: lz-pop var(--dur-slow) var(--ease-spring) var(--dur-quick) both; }
  .mo-ok.is-in::after { content: ""; position: absolute; inset: 0; border: 3px solid var(--success); border-radius: 50%; animation: mo-ring calc(var(--dur-slow) * 2) var(--ease-out) both; }
  @keyframes mo-ring { from { transform: scale(1); opacity: .7; } to { transform: scale(1.7); opacity: 0; } }

  /* 输入抖动 */
  .mo-field { width: min(100%, 320px); }
  .mo-field .field__err { visibility: hidden; }
  .mo-field .field__err[data-show="true"] { visibility: visible; }

  /* 骨架转内容 */
  .mo-swap { display: grid; width: min(100%, 360px); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); }
  .mo-swap__sk, .mo-swap__ct { grid-area: 1 / 1; display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3); transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out); }
  .mo-swap__ct { opacity: 0; transform: translateY(6px); }
  .mo-swap[data-state="done"] .mo-swap__sk { opacity: 0; }
  .mo-swap[data-state="done"] .mo-swap__ct { opacity: 1; transform: none; }
  .mo-swap__ct img { width: 72px; height: 72px; border-radius: var(--r-md); object-fit: cover; }
  .mo-swap__ln { display: grid; gap: var(--s-2); flex: 1; min-width: 0; }
  .mo-swap__sk .skel:first-child { flex: none; }

  /* 流式文字 */
  .mo-st { display: grid; width: 100%; padding: var(--s-4); border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); }
  .mo-st > * { grid-area: 1 / 1; }
  .mo-st__ghost { visibility: hidden; }
  .mo-st__live.is-streaming::after { content: ""; display: inline-block; width: 2px; height: 1.1em; margin-left: 2px; vertical-align: text-bottom; background: var(--action); animation: lz-blink 1s steps(2) infinite; }

  /* 悬停抬升 */
  .mo-lift { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--s-4); align-items: center; width: min(100%, 360px); padding: var(--s-3); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--elev-1); transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); cursor: pointer; text-align: left; }
  .mo-lift img { width: 88px; height: 88px; border-radius: var(--r-md); object-fit: cover; }
  .mo-lift__t { display: grid; gap: var(--s-1); }
  .mo-lift__t b { font-size: var(--fs-md); }
  @media (hover: hover) { .mo-lift:hover { transform: translateY(-4px); box-shadow: var(--elev-3); } }
  .mo-lift.is-on { transform: translateY(-4px); box-shadow: var(--elev-3); }

  /* 错峰入场 */
  .mo-stag { width: 100%; background: var(--surface); border-radius: var(--r-md); overflow: hidden; }
  .mo-stag .row { min-height: 52px; padding-top: var(--s-2); padding-bottom: var(--s-2); }
  .mo-stag .row__lead { width: 36px; height: 36px; border-radius: var(--r-sm); }
  .mo-stag .row__title, .mo-stag .row__meta { display: block; }
  .mo-stag .row { opacity: 0; }
  .mo-stag.is-in .row { animation: lz-rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * 70ms); }
  .mo-stag.is-done .row { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .mo-stag .row { opacity: 1; } }

  /* 视图切换 */
  .mo-vw { display: grid; width: 100%; overflow: hidden; border-radius: var(--r-md); background: var(--surface); box-shadow: var(--elev-1); }
  .mo-pane { grid-area: 1 / 1; display: grid; align-content: start; background: var(--surface); transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out), visibility 0s linear var(--dur-slow); }
  .mo-pane[data-pane="detail"] { grid-template-rows: auto 1fr; align-content: stretch; }
  .mo-pane[data-pos="right"] { transform: translateX(28%); opacity: 0; visibility: hidden; }
  .mo-pane[data-pos="left"] { transform: translateX(-16%); opacity: 0; visibility: hidden; }
  .mo-pane[data-pos="on"] { transform: none; opacity: 1; visibility: visible; transition-delay: 0s; }
  .mo-pane .row { min-height: 60px; }
  .mo-pane .row__lead { width: 40px; height: 40px; border-radius: var(--r-sm); }
  .mo-pane .row__title, .mo-pane .row__meta { display: block; }
  .mo-bar2 { display: flex; align-items: center; gap: var(--s-2); min-height: 52px; padding: 0 var(--s-2); border-bottom: 1px solid var(--line); }
  .mo-bar2 h3 { font-size: var(--fs-md); font-weight: 600; }
  .mo-det { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--s-4); align-items: center; padding: var(--s-4); }
  .mo-det img { width: 88px; height: 88px; border-radius: var(--r-md); object-fit: cover; }
  .mo-det dl { display: grid; grid-template-columns: auto 1fr; gap: var(--s-1) var(--s-4); font-size: var(--fs-sm); }
  .mo-det dt { color: var(--ink-3); }
  .mo-det dd { margin: 0; font-weight: 600; }
</style>

<article class="demo" data-cid="WB-MOTN-001" data-name="数字滚动入场" data-cat="MOTN">
  <div class="demo__head"><span class="demo__name">数字滚动入场</span></div>
